# ============================================
# REQUIRED - Database
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/ai_twin_db"
ADMIN_ANALYTICS_DB_URL="abc-def-ghi-jkl-mnop-qrs-tuvw-xyz

# ============================================
# REQUIRED - Security Secrets (Production)
# ============================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-this"
SESSION_SECRET="your-super-secret-session-key-min-32-chars-change-this"
ID_TOKEN_SECRET="your-super-secret-id-tokenization-key-min-32-chars-change-this"

# ============================================
# REQUIRED - AI/LLM APIs (At least one required)
# ============================================
GROQ_API_KEY="gsk_your-groq-api-key-here"
GROQ_API_KEY_ANONYMOUS="abc-def"
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ============================================
# ⚠️ NEW - Must set these:
# ============================================
FRONTEND_URL=https://your-railway-domain.railway.app  # Or your custom domain
SUPPORT_EMAIL=support@yourdomain.com  # Where contact form emails go (optional, defaults to MAIL_FROM)

# ============================================
# REQUIRED - Email/SMTP (Production)
# ============================================
MAIL_FROM="noreply@yourdomain.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ============================================
# REQUIRED - Google OAuth (if using)
# ============================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://yourdomain.com/auth/google/callback"

# ============================================
# OPTIONAL - App Configuration
# ============================================
NODE_ENV="development"
APP_ENV="local"
PORT="3000"

# ============================================
# OPTIONAL - Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="2000"

# ============================================
# OPTIONAL - OTP Settings
# ============================================
OTP_EXPIRY_MINUTES="10"
OTP_CODE_LENGTH="6"

# ============================================
# OPTIONAL - Development/Testing
# ============================================
FORCE_INSECURE_COOKIES="false"






