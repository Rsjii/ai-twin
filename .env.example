# ============================================
# AI Twin - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control

# ============================================
# Application Environment
# ============================================
# Options: 'local' | 'staging' | 'prod'
APP_ENV=local
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/ai_twin

# ============================================
# Security Secrets (REQUIRED IN PRODUCTION)
# ============================================
# Generate strong random secrets: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production

# ============================================
# AI API Keys
# ============================================
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Email Configuration (REQUIRED IN PRODUCTION)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
MAIL_FROM=noreply@yourdomain.com

# ============================================
# Google OAuth (Optional)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# ============================================
# OTP Configuration
# ============================================
OTP_EXPIRY_MINUTES=10
OTP_CODE_LENGTH=6

# ============================================
# Development/Testing Flags
# ============================================
FORCE_INSECURE_COOKIES=false
