  <!-- Manual Training Interface -->
<div class="bg-white rounded-lg shadow-md p-6 mb-8 section">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Manual Training</h3>
    <div class="mb-4">
      <p class="text-sm text-gray-600">Add custom training examples to improve your twin's responses</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 form-grid">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2 form-label">User Utterance</label>
        <textarea id="userUtterance" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 form-input" placeholder="What the user might say..."></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2 form-label">Ideal Reply</label>
        <textarea id="idealReply" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 form-input" placeholder="How your twin should respond..."></textarea>
      </div>
    </div>
    <div class="mt-4 flex space-x-2 btn-group">
      <button id="addTrainingExample" class="bg-purple-600 text-white py-2 px-4 rounded hover:bg-purple-700 transition-colors btn touch-target">
