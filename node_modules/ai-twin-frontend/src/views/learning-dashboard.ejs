let selectedMessages = [];
let selectedChatId = null;

// Load available chats for selection
async function loadChatSelection() {
  try {
    const response = await fetch(`/api/twin/${twinId}/chat-history?limit=50`);
    const data = await response.json();
    
    if (data.success) {
      const chatSelect = document.getElementById('chatSelection');
      chatSelect.innerHTML = '<option value="">Choose a chat...</option>';
      
      data.chats.forEach(chat => {
        const option = document.createElement('option');
        option.value = chat.id;
        option.textContent = `Chat ${chat.id.slice(-6)} (${chat.messageCount} messages)`;
        chatSelect.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error loading chat selection:', error);
  }
}

// Load messages for selected chat
async function loadChatMessages(chatId) {
  try {
    const response = await fetch(`/api/twin/${twinId}/chat/${chatId}/messages`);
    const data = await response.json();
    
    if (data.success) {
      displayChatMessages(data.messages);
      document.getElementById('messageSelection').classList.remove('hidden');
    }
  } catch (error) {
    console.error('Error loading chat messages:', error);
  }
}

// Display chat messages
function displayChatMessages(messages) {
  const container = document.getElementById('messageList');
  container.innerHTML = '';
  
  messages.forEach(message => {
    const messageElement = document.createElement('div');
    messageElement.className = 'border rounded-lg p-3 hover:bg-gray-50 cursor-pointer transition-colors';
    messageElement.dataset.messageId = message.id;
    messageElement.innerHTML = `
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <div class="flex items-center space-x-2 mb-1">
            <span class="px-2 py-1 text-xs rounded-full ${message.sender === 'user' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}">${message.sender}</span>
            <span class="text-xs text-gray-500">${new Date(message.createdAt).toLocaleString()}</span>
          </div>
          <p class="text-sm text-gray-900">${message.content}</p>
        </div>
        <input type="checkbox" class="message-checkbox" data-message-id="${message.id}">
      </div>
    `;
    
    // Add click handler
    messageElement.addEventListener('click', function(e) {
      if (e.target.type !== 'checkbox') {
        const checkbox = messageElement.querySelector('.message-checkbox');
        checkbox.checked = !checkbox.checked;
        toggleMessageSelection(message.id, checkbox.checked);
      }
    });
    
    container.appendChild(messageElement);
  });
}

// Toggle message selection
function toggleMessageSelection(messageId, isSelected) {
  if (isSelected) {
    if (!selectedMessages.includes(messageId)) {
      selectedMessages.push(messageId);
    }
  } else {
    selectedMessages = selectedMessages.filter(id => id !== messageId);
  }
  
  updateBulkTrainingActions();
}

// Update bulk training actions visibility
function updateBulkTrainingActions() {
  const bulkActions = document.getElementById('bulkTrainingActions');
  if (selectedMessages.length > 0) {
    bulkActions.classList.remove('hidden');
  } else {
    bulkActions.classList.add('hidden');
  }
}

// Convert selected messages to training examples
async function convertSelectedToTraining() {
  if (selectedMessages.length === 0) {
    alert('Please select at least one message');
    return;
  }
  
  try {
    const response = await fetch(`/api/twin/${twinId}/convert-messages-to-training`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({
        messageIds: selectedMessages,
        trainingType: 'chat_conversion'
      })
    });
    
    const data = await response.json();
    if (data.success) {
      alert(`Successfully converted ${selectedMessages.length} messages to training examples!`);
      selectedMessages = [];
      updateBulkTrainingActions();
      loadStyleAnchors();
      loadTrainingEffectiveness();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (error) {
    console.error('Error converting messages:', error);
    alert('Error converting messages to training examples');
  }
}

// Load training effectiveness score
async function loadTrainingEffectiveness() {
  try {
    const response = await fetch(`/api/twin/${twinId}/training/effectiveness`);
    const data = await response.json();
    
    if (data.success) {
      updateEffectivenessDisplay(data.effectiveness);
      updateTrainingRecommendations(data.recommendations);
      updateTrainingAchievements(data.achievements);
      updateTrainingGoals(data.goals);
    }
  } catch (error) {
    console.error('Error loading training effectiveness:', error);
  }
}

// Update effectiveness display
function updateEffectivenessDisplay(effectiveness) {
  const scoreElement = document.getElementById('effectivenessScore');
  const barElement = document.getElementById('effectivenessBar');
  
  scoreElement.textContent = effectiveness.score + '%';
  barElement.style.width = effectiveness.score + '%';
  
  // Update color based on score
  if (effectiveness.score >= 80) {
    barElement.className = 'bg-green-600 h-2 rounded-full transition-all duration-300';
    scoreElement.className = 'text-lg font-bold text-green-600';
  } else if (effectiveness.score >= 60) {
    barElement.className = 'bg-yellow-600 h-2 rounded-full transition-all duration-300';
    scoreElement.className = 'text-lg font-bold text-yellow-600';
  } else {
    barElement.className = 'bg-red-600 h-2 rounded-full transition-all duration-300';
    scoreElement.className = 'text-lg font-bold text-red-600';
  }
}

// Update training recommendations
function updateTrainingRecommendations(recommendations) {
  const container = document.getElementById('trainingRecommendations');
  container.innerHTML = '';
  
  recommendations.forEach(rec => {
    const recElement = document.createElement('div');
    recElement.className = `p-3 ${rec.type === 'tip' ? 'bg-blue-50 border border-blue-200' : 'bg-yellow-50 border border-yellow-200'} rounded-lg`;
    recElement.innerHTML = `<p class="text-sm ${rec.type === 'tip' ? 'text-blue-800' : 'text-yellow-800'}">${rec.icon} ${rec.message}</p>`;
    container.appendChild(recElement);
  });
}

// Update training achievements
function updateTrainingAchievements(achievements) {
  const container = document.getElementById('trainingAchievements');
  container.innerHTML = '';
  
  achievements.forEach(achievement => {
    const achievementElement = document.createElement('div');
    achievementElement.className = `p-3 ${achievement.unlocked ? 'bg-green-50 border border-green-200' : 'bg-gray-50 border border-gray-200'} rounded-lg text-center`;
    achievementElement.innerHTML = `
      <div class="text-2xl mb-1">${achievement.icon}</div>
      <p class="text-xs ${achievement.unlocked ? 'text-green-800' : 'text-gray-800'}">${achievement.name}</p>
      <p class="text-xs ${achievement.unlocked ? 'text-green-600' : 'text-gray-600'}">${achievement.description}</p>
    `;
    container.appendChild(achievementElement);
  });
}

// Update training goals
function updateTrainingGoals(goals) {
  const container = document.querySelector('#trainingValidation .space-y-3');
  container.innerHTML = '';
  
  goals.forEach(goal => {
    const goalElement = document.createElement('div');
    goalElement.className = 'flex justify-between items-center';
    goalElement.innerHTML = `
      <span class="text-sm text-gray-700">${goal.name}</span>
      <div class="flex items-center space-x-2">
        <div class="w-24 bg-gray-200 rounded-full h-2">
          <div class="${goal.color} h-2 rounded-full" style="width: ${goal.progress}%"></div>
        </div>
        <span class="text-xs text-gray-600">${goal.current}/${goal.target}</span>
      </div>
    `;
    container.appendChild(goalElement);
  });
}

// Event listeners for Phase 2D
document.addEventListener('DOMContentLoaded', function() {
  // Load chat selection
  loadChatSelection();
  
  // Chat selection change
  document.getElementById('chatSelection').addEventListener('change', function(e) {
    selectedChatId = e.target.value;
    if (selectedChatId) {
      loadChatMessages(selectedChatId);
    } else {
      document.getElementById('messageSelection').classList.add('hidden');
      document.getElementById('bulkTrainingActions').classList.add('hidden');
    }
  });
  
  // Select all messages
  document.getElementById('selectAllMessages').addEventListener('click', function() {
    const checkboxes = document.querySelectorAll('.message-checkbox');
    checkboxes.forEach(checkbox => {
      checkbox.checked = true;
      toggleMessageSelection(checkbox.dataset.messageId, true);
    });
  });
  
  // Clear selection
  document.getElementById('clearSelection').addEventListener('click', function() {
    const checkboxes = document.querySelectorAll('.message-checkbox');
    checkboxes.forEach(checkbox => {
      checkbox.checked = false;
    });
    selectedMessages = [];
    updateBulkTrainingActions();
  });
  
  // Convert selected to training
  document.getElementById('convertSelectedToTraining').addEventListener('click', convertSelectedToTraining);
  
  // Preview training examples
  document.getElementById('previewTrainingExamples').addEventListener('click', function() {
    if (selectedMessages.length === 0) {
      alert('Please select at least one message');
      return;
    }
    alert(`Preview: ${selectedMessages.length} messages selected for training conversion`);
  });
  
  // Load training effectiveness
  loadTrainingEffectiveness();
});

// Data synchronization functionality
let dataSyncInterval = null;
let lastSyncTime = null;

// Initialize data synchronization
function initializeDataSync() {
  // Sync data every 30 seconds
  dataSyncInterval = setInterval(syncAllData, 30000);
  
  // Sync on page visibility change
  document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
      syncAllData();
    }
  });
  
  // Sync on window focus
  window.addEventListener('focus', syncAllData);
}

// Sync all dashboard data
async function syncAllData() {
  try {
    console.log('🔄 Syncing all dashboard data...');
    
    // Sync learning data
    await loadLearningData();
    
    // Sync chat history
    await loadChatHistory();
    
    // Sync memories
    await loadMemories();
    
    // Sync style anchors
    await loadStyleAnchors();
    
    // Sync training effectiveness
    await loadTrainingEffectiveness();
    
    lastSyncTime = new Date();
    console.log('✅ Data sync completed at:', lastSyncTime);
    
    // Update sync indicator
    updateSyncIndicator(true);
  } catch (error) {
    console.error('❌ Data sync error:', error);
    updateSyncIndicator(false);
  }
}

// Update sync indicator
function updateSyncIndicator(success) {
  const indicator = document.getElementById('syncIndicator');
  if (indicator) {
    if (success) {
      indicator.className = 'w-3 h-3 bg-green-500 rounded-full animate-pulse';
      indicator.title = `Last sync: ${lastSyncTime ? lastSyncTime.toLocaleTimeString() : 'Never'}`;
    } else {
      indicator.className = 'w-3 h-3 bg-red-500 rounded-full';
      indicator.title = 'Sync failed - Click to retry';
    }
  }
}

// Manual sync trigger
function triggerManualSync() {
  syncAllData();
}

// Add sync indicator to header
function addSyncIndicator() {
  const header = document.querySelector('h1');
  if (header && !document.getElementById('syncIndicator')) {
    const syncContainer = document.createElement('div');
    syncContainer.className = 'flex items-center space-x-2 mt-2';
    syncContainer.innerHTML = `
      <div id="syncIndicator" class="w-3 h-3 bg-gray-400 rounded-full" title="Sync status"></div>
      <span class="text-sm text-gray-600">Auto-sync enabled</span>
      <button onclick="triggerManualSync()" class="text-xs text-blue-600 hover:text-blue-800 underline">
        Sync Now
      </button>
    `;
    header.parentNode.appendChild(syncContainer);
  }
}

// Enhanced error handling with retry
function handleApiError(error, retryFunction, maxRetries = 3) {
  console.error('API Error:', error);
  
  if (maxRetries > 0) {
    console.log(`Retrying in 2 seconds... (${maxRetries} attempts left)`);
    setTimeout(() => {
      retryFunction();
    }, 2000);
  } else {
    console.error('Max retries exceeded');
    showErrorNotification('Failed to load data. Please refresh the page.');
  }
}

// Show error notification
function showErrorNotification(message) {
  const notification = document.createElement('div');
  notification.className = 'fixed top-4 right-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg z-50';
  notification.innerHTML = `
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>${message}</span>
      <button onclick="this.parentElement.parentElement.remove()" class="ml-4 text-red-500 hover:text-red-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  `;
  document.body.appendChild(notification);
  
  // Auto-remove after 5 seconds
  setTimeout(() => {
    if (notification.parentNode) {
      notification.remove();
    }
  }, 5000);
}

