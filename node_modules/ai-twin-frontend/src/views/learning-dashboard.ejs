        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  `;
  document.body.appendChild(notification);
  
  // Auto-remove after 3 seconds
  setTimeout(() => {
    if (notification.parentNode) {
      notification.remove();
    }
  }, 3000);
}

// Initialize Phase 2E functionality
document.addEventListener('DOMContentLoaded', function() {
  // Add sync indicator
  addSyncIndicator();
  
  // Initialize data synchronization
  initializeDataSync();
  
  // Add loading states to all data loading functions
  addLoadingStates();
});

// Add loading states to existing functions
function addLoadingStates() {
  // Override existing functions to add loading states
  const originalLoadLearningData = loadLearningData;
  loadLearningData = async function() {
    showLoadingState('learningProgress');
    try {
      await originalLoadLearningData();
    } catch (error) {
      handleApiError(error, loadLearningData);
    } finally {
      hideLoadingState('learningProgress');
    }
  };
  
  const originalLoadChatHistory = loadChatHistory;
  loadChatHistory = async function() {
    showLoadingState('chatHistory');
    try {
      await originalLoadChatHistory();
    } catch (error) {
      handleApiError(error, loadChatHistory);
    } finally {
      hideLoadingState('chatHistory');
    }
  };
  
  const originalLoadMemories = loadMemories;
  loadMemories = async function() {
    showLoadingState('memoryList');
    try {
      await originalLoadMemories();
    } catch (error) {
      handleApiError(error, loadMemories);
    } finally {
      hideLoadingState('memoryList');
    }
  };
  
  const originalLoadStyleAnchors = loadStyleAnchors;
  loadStyleAnchors = async function() {
    showLoadingState('styleAnchorsList');
    try {
      await originalLoadStyleAnchors();
    } catch (error) {
      handleApiError(error, loadStyleAnchors);
    } finally {
      hideLoadingState('styleAnchorsList');
    }
  };
}

// Show loading state
function showLoadingState(elementId) {
  const element = document.getElementById(elementId);
  if (element) {
    element.classList.add('opacity-50', 'pointer-events-none');
  }
}

// Hide loading state
function hideLoadingState(elementId) {
  const element = document.getElementById(elementId);
  if (element) {
    element.classList.remove('opacity-50', 'pointer-events-none');
  }
}

// Phase 2F: Advanced Features JavaScript

// Training Templates
const trainingTemplates = {
  casual: {
    userUtterance: "Hey, how are you doing today?",
    idealReply: "Hey! I'm doing great, thanks for asking! 😊 How about you? What's been going on?"
  },
  professional: {
    userUtterance: "Can you help me with this project?",
    idealReply: "I'd be happy to assist you with your project. Could you provide more details about what specific help you need?"
  },
  supportive: {
    userUtterance: "I'm feeling stressed about work",
    idealReply: "I understand that work stress can be really overwhelming. You're doing your best, and it's okay to take breaks when you need them. What's been the most challenging part lately?"
  }
};

// Load training template
function loadTemplate(templateType) {
  const template = trainingTemplates[templateType];
  if (template) {
    document.getElementById('templateUserUtterance').textContent = template.userUtterance;
    document.getElementById('templateIdealReply').textContent = template.idealReply;
    document.getElementById('templatePreview').classList.remove('hidden');
  }
}

// Use template
function useTemplate() {
  const userUtterance = document.getElementById('templateUserUtterance').textContent;
  const idealReply = document.getElementById('templateIdealReply').textContent;
  
  document.getElementById('userUtterance').value = userUtterance;
  document.getElementById('idealReply').value = idealReply;
  
  document.getElementById('templatePreview').classList.add('hidden');
  showSuccessNotification('Template applied successfully!');
}

// Close template
function closeTemplate() {
  document.getElementById('templatePreview').classList.add('hidden');
}

// Learning Milestones
let learningGoals = [];

// Load learning milestones
async function loadLearningMilestones() {
  try {
    const response = await fetch(`/api/twin/${twinId}/milestones`);
    const data = await response.json();
    
    if (data.success) {
      updateMilestonesDisplay(data.milestones);
      updateGoalsDisplay(data.goals);
    }
  } catch (error) {
    console.error('Error loading milestones:', error);
  }
}

// Update milestones display
function updateMilestonesDisplay(milestones) {
  const currentContainer = document.getElementById('currentMilestones');
  const upcomingContainer = document.getElementById('upcomingMilestones');
  
  currentContainer.innerHTML = '';
  upcomingContainer.innerHTML = '';
  
  milestones.forEach(milestone => {
    const milestoneElement = document.createElement('div');
    milestoneElement.className = `flex items-center justify-between p-3 ${milestone.completed ? 'bg-green-50 border border-green-200' : 'bg-gray-50 border border-gray-200'} rounded-lg`;
    
    milestoneElement.innerHTML = `
      <div class="flex items-center space-x-3">
        <div class="text-2xl">${milestone.icon}</div>
        <div>
          <p class="text-sm font-medium ${milestone.completed ? 'text-green-800' : 'text-gray-800'}">${milestone.name}</p>
          <p class="text-xs ${milestone.completed ? 'text-green-600' : 'text-gray-600'}">${milestone.description}</p>
        </div>
      </div>
      <div class="text-right">
        <p class="text-sm font-bold ${milestone.completed ? 'text-green-800' : 'text-gray-800'}">${milestone.progress}%</p>
        <div class="w-16 ${milestone.completed ? 'bg-green-200' : 'bg-gray-200'} rounded-full h-2">
          <div class="${milestone.completed ? 'bg-green-600' : 'bg-gray-600'} h-2 rounded-full" style="width: ${milestone.progress}%"></div>
        </div>
      </div>
    `;
    
    if (milestone.completed) {
      currentContainer.appendChild(milestoneElement);
    } else {
      upcomingContainer.appendChild(milestoneElement);
    }
  });
}

// Update goals display
function updateGoalsDisplay(goals) {
  learningGoals = goals;
}

// Set learning goal
async function setLearningGoal() {
  const goalType = document.getElementById('goalType').value;
  const target = parseInt(document.getElementById('goalTarget').value);
  
  if (!target || target < 1) {
    alert('Please enter a valid target number');
    return;
  }
  
  try {
    const response = await fetch(`/api/twin/${twinId}/goals`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({
        type: goalType,
        target: target
      })
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification('Learning goal set successfully!');
      document.getElementById('goalTarget').value = '';
      loadLearningMilestones();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (error) {
    console.error('Error setting goal:', error);
    alert('Error setting learning goal');
  }
}

// Performance Optimization
let performanceMetrics = {
  responseTime: 0,
  accuracyScore: 0,
  learningRate: 0,
  userSatisfaction: 0
};

// Load performance metrics
async function loadPerformanceMetrics() {
  try {
    const response = await fetch(`/api/twin/${twinId}/performance`);
    const data = await response.json();
    
    if (data.success) {
      performanceMetrics = data.metrics;
      updatePerformanceDisplay();
      updateOptimizationRecommendations(data.recommendations);
    }
  } catch (error) {
    console.error('Error loading performance metrics:', error);
  }
}

// Update performance display
function updatePerformanceDisplay() {
  document.getElementById('responseTime').textContent = performanceMetrics.responseTime + 'ms';
  document.getElementById('accuracyScore').textContent = performanceMetrics.accuracyScore + '%';
  document.getElementById('learningRate').textContent = performanceMetrics.learningRate + '%';
  document.getElementById('userSatisfaction').textContent = performanceMetrics.userSatisfaction + '%';
}

// Update optimization recommendations
function updateOptimizationRecommendations(recommendations) {
  const container = document.getElementById('optimizationRecommendations');
  container.innerHTML = '';
  
  recommendations.forEach(rec => {
    const recElement = document.createElement('div');
    recElement.className = `p-3 ${rec.type === 'warning' ? 'bg-yellow-50 border border-yellow-200' : 'bg-blue-50 border border-blue-200'} rounded-lg`;
    recElement.innerHTML = `
      <div class="flex items-start space-x-3">
        <div class="${rec.type === 'warning' ? 'text-yellow-600' : 'text-blue-600'} mt-1">${rec.icon}</div>
        <div>
          <p class="text-sm font-medium ${rec.type === 'warning' ? 'text-yellow-800' : 'text-blue-800'}">${rec.title}</p>
          <p class="text-xs ${rec.type === 'warning' ? 'text-yellow-700' : 'text-blue-700'}">${rec.description}</p>
        </div>
      </div>
    `;
    container.appendChild(recElement);
  });
}

// Optimize memories
async function optimizeMemories() {
  try {
    const response = await fetch(`/api/twin/${twinId}/optimize/memories`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification(`Optimized ${data.optimized} memories successfully!`);
      loadMemories();
      loadPerformanceMetrics();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (error) {
    console.error('Error optimizing memories:', error);
    alert('Error optimizing memories');
  }
}

// Analyze performance
async function analyzePerformance() {
  try {
    const response = await fetch(`/api/twin/${twinId}/analyze/performance`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification('Performance analysis completed!');
      loadPerformanceMetrics();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (error) {
    console.error('Error analyzing performance:', error);
    alert('Error analyzing performance');
  }
}

// Export analytics
async function exportAnalytics() {
  try {
    const response = await fetch(`/api/twin/${twinId}/export/analytics`);
    const data = await response.json();
    
    if (data.success) {
      // Create download link
      const blob = new Blob([JSON.stringify(data.analytics, null, 2)], { type: 'application/json' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `twin-${twinId}-analytics.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
      
      showSuccessNotification('Analytics exported successfully!');
    } else {
      alert('Error: ' + data.error);
    }
  } catch (error) {
    console.error('Error exporting analytics:', error);
    alert('Error exporting analytics');
  }
}

// Reset performance metrics
async function resetPerformanceMetrics() {
  if (confirm('Are you sure you want to reset all performance metrics? This action cannot be undone.')) {
    try {
      const response = await fetch(`/api/twin/${twinId}/reset/performance`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        }
      });
      
      const data = await response.json();
      if (data.success) {
        showSuccessNotification('Performance metrics reset successfully!');
        loadPerformanceMetrics();
      } else {
        alert('Error: ' + data.error);
      }
    } catch (error) {
      console.error('Error resetting performance:', error);
      alert('Error resetting performance metrics');
    }
  }
}

// Regenerate system prompt
async function regenerateSystemPrompt() {
  try {
    const response = await fetch(`/api/twin/${twinId}/regenerate-prompt`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification('System prompt regenerated successfully!');
    } else {
      alert('Error: ' + data.error);
    }
  } catch (error) {
    console.error('Error regenerating system prompt:', error);
    alert('Error regenerating system prompt');
  }
}

// Add event listener for regenerate prompt button
document.getElementById('regeneratePrompt').addEventListener('click', regenerateSystemPrompt);

// Initialize Phase 2F functionality
document.addEventListener('DOMContentLoaded', function() {
  // Load advanced features
  loadLearningMilestones();
  loadPerformanceMetrics();
  
  // Template events
  document.getElementById('useTemplate').addEventListener('click', useTemplate);
  document.getElementById('closeTemplate').addEventListener('click', closeTemplate);
  
  // Goal setting events
  document.getElementById('setGoal').addEventListener('click', setLearningGoal);
  
  // Performance events
  document.getElementById('optimizeMemories').addEventListener('click', optimizeMemories);
  document.getElementById('analyzePerformance').addEventListener('click', analyzePerformance);
  document.getElementById('exportAnalytics').addEventListener('click', exportAnalytics);
  document.getElementById('resetPerformance').addEventListener('click', resetPerformanceMetrics);
});

// Global functions for template loading
window.loadTemplate = loadTemplate;


