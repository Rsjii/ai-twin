    <script>
        const twinId = '<%= twinId %>';
        const csrfToken = '<%= csrfToken %>';
        
        let currentChatOffset = 0;
        let currentMemoryOffset = 0;
        let currentAnchorOffset = 0;
        const pageSize = 10;
    
        // Load learning data
        async function loadLearningData() {
            try {
                const response = await fetch(`/api/twin/${twinId}/learning-data`);
                const data = await response.json();
                
                if (data.success) {
                    updateLearningProgress(data.learning);
                }
            } catch (error) {
                console.error('Error loading learning data:', error);
            }
        }
    
        // Update learning progress display
        function updateLearningProgress(learning) {
            document.getElementById('totalInteractions').textContent = learning.totalInteractions || 0;
            document.getElementById('learningScore').textContent = (learning.learningScore || 0) + '%';
            document.getElementById('styleAccuracy').textContent = (learning.styleAccuracy || 0) + '%';
            
            const eventsContainer = document.getElementById('learningEvents');
            if (learning.events && learning.events.length > 0) {
                eventsContainer.innerHTML = learning.events.map(event => `
                    <div class="flex items-center space-x-3 p-2 bg-gray-50 rounded">
                        <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                        <div class="flex-1">
                            <p class="text-sm text-gray-900">${event.description}</p>
                            <p class="text-xs text-gray-500">${new Date(event.timestamp).toLocaleString()}</p>
                        </div>
                    </div>
                `).join('');
            } else {
                eventsContainer.innerHTML = '<p class="text-gray-500 text-sm">No recent learning events</p>';
            }
        }
    
        // Load chat history
        async function loadChatHistory() {
            try {
                const response = await fetch(`/api/twin/${twinId}/chat-history?limit=${pageSize}&offset=${currentChatOffset}`);
                const data = await response.json();
                
                if (data.success) {
                    displayChatHistory(data.chats);
                }
