</main>

<script>
    const MAX_RECENT_CHATS = 1;
    // Set CSRF token from server
    window.csrfToken = '<%= csrfToken %>';
    console.log('✅ CSRF Token set:', window.csrfToken);
    
    async function startNewChat() {        
        try {
            // Redirect to enhanced chat
            window.location.href = '/chat-enhanced';
        } catch (error) {
            console.error('Start chat error:', error);
            alert('Network error. Please try again.');
        }
    }
    // ===== DISCOVER SECTION FUNCTIONS =====
    
    // Load trending twins for Discover section
    async function loadTrendingTwins() {
        try {
            const response = await fetch('/api/discover/trending?limit=8&offset=0');
            const data = await response.json();
            
            if (data.success && data.twins && data.twins.length > 0) {
                renderTrendingCarousel(data.twins);
            } else {
                // Show empty state
                const container = document.getElementById('trendingCards');
                if (container) {
                    container.innerHTML = `
                        <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl p-6 border border-amber-200/50 text-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-amber-100 to-orange-100 rounded-full flex items-center justify-center mx-auto mb-3">
                                <span class="text-2xl">🌟</span>
                            </div>
                            <p class="text-gray-600 text-sm">No trending twins available right now.</p>
                            <p class="text-gray-500 text-xs mt-1">Check back later for exciting discoveries!</p>
                        </div>
                    `;
                }
            }
        } catch (error) {
            console.error('Error loading trending twins:', error);
            const container = document.getElementById('trendingCards');
            if (container) {
                container.innerHTML = `
                    <div class="bg-red-50 rounded-xl p-6 border border-red-200/50 text-center">
                        <div class="w-12 h-12 bg-gradient-to-r from-red-100 to-pink-100 rounded-full flex items-center justify-center mx-auto mb-3">
                            <span class="text-2xl">⚠️</span>
                        </div>
                        <p class="text-red-600 text-sm">Failed to load trending twins</p>
                        <p class="text-red-500 text-xs mt-1">Please refresh the page</p>
                    </div>
                `;
            }
        }
    }
    
    // Render trending carousel
    function renderTrendingCarousel(twins) {
        const container = document.getElementById('trendingCards');
        if (!container) return;
        
        container.innerHTML = '';
        twins.forEach(twin => {
            const card = createTwinCard(twin);
            container.appendChild(card);
        });
    }
    
    // Create twin card HTML element
    function createTwinCard(twin) {
        const card = document.createElement('div');
        card.className = 'twin-card-discover min-w-[280px] bg-white/90 backdrop-blur-sm rounded-xl shadow-md p-6 border border-white/30 hover:shadow-xl hover:scale-[1.02] transition-all duration-300 cursor-pointer flex-shrink-0';
        card.setAttribute('data-twin-id', twin.id);
        
        // Avatar
        const avatarInitial = (twin.publicHandle || 'T').charAt(0).toUpperCase();
        
        card.innerHTML = `
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-gradient-to-r from-primary to-accent rounded-full flex items-center justify-center text-white font-bold shadow-lg mr-3">
                    ${twin.profileImage ? `<img src="${twin.profileImage}" alt="${twin.publicHandle}" class="w-12 h-12 rounded-full object-cover">` : avatarInitial}
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2">
                        <h4 class="font-semibold text-gray-900">@${twin.publicHandle || 'twin'}</h4>
                        ${twin.verified ? '<span class="text-primary text-xs">✓</span>' : ''}
                    </div>
                    <p class="text-xs text-gray-500">${twin.userName || twin.userHandle || 'AI Twin'}</p>
                </div>
            </div>
            
            <p class="text-sm text-gray-600 mb-4 line-clamp-2">${twin.bio || 'No bio available'}</p>
            
            <div class="flex items-center gap-4 mb-4 text-xs text-gray-500">
                <span>❤️ ${twin.likeCount || 0}</span>
                <span>💬 ${twin.chatCount || 0}</span>
                <span>👥 ${twin.followCount || 0}</span>
            </div>
            
            <button onclick="window.location.href='/@${twin.publicHandle || 'twin'}'" class="w-full px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg hover:shadow-lg transition-all font-medium text-sm">
                💬 Chat Now
            </button>
        `;
        
        // Click on card also navigates
        card.addEventListener('click', function(e) {
            if (e.target.tagName !== 'BUTTON') {
                window.location.href = '/@' + (twin.publicHandle || 'twin');
            }
        });
        
        return card;
    }
    
// Load public chat interactions (twins user chatted with)
async function loadPublicChatInteractions() {
    try {
        console.log('🔍 Loading public chat interactions...');
        const response = await fetch('/api/public-chat/user/my-chats', {
            credentials: 'include',
            headers: {
                'X-CSRF-Token': '<%= csrfToken %>'
            }
        });
        
        console.log('📡 Response status:', response.status);
        
        if (!response.ok) {
            if (response.status === 401) {
                console.log('⚠️ User not authenticated');
                renderRecentInteractions([]);
                return;
            }
            throw new Error('Failed to fetch public chats');
        }

        const data = await response.json();
        console.log('📦 Response data:', data);
        
        if (!data.success || !data.chats || data.chats.length === 0) {
            console.log('⚠️ No chats found in response');
            renderRecentInteractions([]);
            return;
        }
        
        console.log('✅ Found', data.chats.length, 'chats');
        
        // API returns: { success: true, chats: [{ twin, latestChat, lastMessage }], total }
        // Already sorted by lastActivity DESC
        const twinChats = data.chats.slice(0, MAX_RECENT_CHATS); // Show top MAX_RECENT_CHATS most recent
        
        renderRecentInteractions(twinChats);
    } catch (error) {
        console.error('❌ Error loading public chat interactions:', error);
        // Don't hide section, show error message instead
        const container = document.getElementById('recentInteractions');
        if (container) {
            container.innerHTML = `
                <div class="bg-red-50 rounded-xl p-6 border border-red-200 text-center">
                    <p class="text-red-600 text-sm mb-2">Unable to load recent chats</p>
                    <button onclick="loadPublicChatInteractions()" class="text-xs text-red-500 hover:text-red-700 underline">
                        Try Again
                    </button>
                </div>
            `;
        }
    }
}    

// Render recent interactions with twin cards
function renderRecentInteractions(chats) {
    const container = document.getElementById('recentInteractions');
    if (!container) return;
    
    container.innerHTML = '';
    
    if (!chats || chats.length === 0) {
        container.innerHTML = `
            <div class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-xl p-8 border border-primary/10 text-center">
                <div class="w-16 h-16 bg-gradient-to-r from-primary/20 to-accent/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">No Recent Chats Yet</h3>
                <p class="text-gray-600 text-sm mb-4">Start exploring twins and begin conversations!</p>
                <a href="/discover" class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg hover:shadow-lg transition-all font-medium text-sm">
                    <span>🔍 Discover Twins</span>
                </a>
            </div>
        `;
        return;
    }
    
    chats.forEach(({ twin, latestChat, lastMessage }) => {
        const card = document.createElement('div');
        card.className = 'bg-white/80 backdrop-blur-sm rounded-xl p-4 border border-white/40 hover:bg-white hover:shadow-lg transition-all duration-300 group';
        
        // Calculate time ago from lastActivity or lastMessage
        const timeSource = lastMessage?.createdAt || latestChat?.lastActivity || latestChat?.createdAt;
        const timeAgo = timeSource ? formatTimeAgo(new Date(timeSource)) : 'Recently';
        
        // Avatar initial
        const avatarInitial = (twin.publicHandle || 'T').charAt(0).toUpperCase();
        
        // Last message preview (truncate to 50 chars)
        const lastMessagePreview = lastMessage?.content 
            ? (lastMessage.content.length > 50 ? lastMessage.content.substring(0, 50) + '...' : lastMessage.content)
            : 'Continue conversation...';
        
        card.innerHTML = `
            <div class="flex items-center gap-4 mb-3">
                <div class="relative flex-shrink-0">
                    <div class="w-14 h-14 bg-gradient-to-r from-primary to-accent rounded-full flex items-center justify-center text-white font-bold shadow-lg group-hover:scale-110 transition-transform">
                        ${twin.profileImage ? `<img src="${twin.profileImage}" alt="${twin.publicHandle}" class="w-14 h-14 rounded-full object-cover">` : avatarInitial}
                    </div>
                    <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-green-500 rounded-full border-2 border-white"></div>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                        <h4 class="font-semibold text-gray-900 text-sm truncate">@${twin.publicHandle || 'twin'}</h4>
                        ${twin.verified ? '<span class="text-xs text-primary">✓</span>' : ''}
                    </div>
                    <p class="text-xs text-gray-500 line-clamp-1">${twin.bio || 'No bio'}</p>
                    <p class="text-xs text-gray-400 mt-1">${timeAgo}</p>
                </div>
            </div>
            
            ${latestChat ? `
                <div class="mb-3 p-2 bg-gray-50/50 rounded-lg">
                    <div class="flex items-center justify-between mb-1">
                        <p class="text-xs font-medium text-gray-700">${latestChat.title || 'Chat'}</p>
                        ${latestChat.messageCount > 0 ? `<span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full">${latestChat.messageCount} msgs</span>` : ''}
                    </div>
                    <p class="text-xs text-gray-500 line-clamp-1">${lastMessagePreview}</p>
                </div>
            ` : ''}
            
           <button data-twin-id="${twin.id}"
                        class="continue-chat-btn w-full px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg hover:shadow-lg transition-all font-medium text-sm">
                    💬 Continue Chat
                </button>
            
        `;
                        
        // Add click listener to button after innerHTML
        const button = card.querySelector('.continue-chat-btn');
        if (button) {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                window.location.href = `/public-twin/chat/${twin.id}`;
            });
        }
        
        container.appendChild(card);
    });
}


    // Format time ago helper
    function formatTimeAgo(date) {
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);
        
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return `${diffMins}m ago`;
        if (diffHours < 24) return `${diffHours}h ago`;
        if (diffDays < 7) return `${diffDays}d ago`;
        return date.toLocaleDateString();
    }
    
    // Load discover section on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTrendingTwins();
        loadPublicChatInteractions();
    });
    
    
    async function loadTwins() {
        try {
            const response = await fetch('/api/twin', {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            });
            
            const result = await response.json();
            
            if (response.ok) {
                const twinsList = document.getElementById('twinsList');
                if (result.twins.length === 0) {
                    twinsList.innerHTML = '<p class="text-gray-500">No twins created yet.</p>';
                } else {
                    twinsList.innerHTML = result.twins.map(twin => 
                        '<div class="border rounded-lg p-3">' +
                        '<p class="font-medium">Twin #' + twin.id.slice(-6) + '</p>' +
                        '<p class="text-sm text-gray-600">Created: ' + new Date(twin.createdAt).toLocaleDateString() + '</p>' +
                        '</div>'
                    ).join('');
                }
            }
        } catch (error) {
            console.error('Load twins error:', error);
        }
    }
    
