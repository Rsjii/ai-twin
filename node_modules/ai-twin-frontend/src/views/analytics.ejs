<%
const twinIdValue = typeof userTwinId !== 'undefined' && userTwinId ? userTwinId : '';
%>
<%- include('layout', { 
    title: title, 
    user: user, 
    csrfToken: csrfToken, 
    body: include('partials/analytics-body')
}) %>

<script>
    // Set twinId from server-side variable (outside template string, so EJS works)
    window.twinIdValue = '<%- twinIdValue %>';
    
    // Simplified loading state functions
    function showLoading(section) {
        const loadingEl = document.getElementById(`${section}LoadingState`);
        const containerEl = document.getElementById(`${section}Container`) || document.getElementById(section);
        const emptyEl = document.getElementById(`${section}EmptyState`);
        const errorEl = document.getElementById(`${section}ErrorState`);
        
        if (loadingEl) loadingEl.classList.remove('hidden');
        if (containerEl) containerEl.classList.add('hidden');
        if (emptyEl) emptyEl.classList.add('hidden');
        if (errorEl) errorEl.classList.add('hidden');
    }
    
    function hideLoading(section) {
        const loadingEl = document.getElementById(`${section}LoadingState`);
        if (loadingEl) loadingEl.classList.add('hidden');
    }
    
    function showEmpty(section) {
        const emptyEl = document.getElementById(`${section}EmptyState`);
        const containerEl = document.getElementById(`${section}Container`) || document.getElementById(section);
        const loadingEl = document.getElementById(`${section}LoadingState`);
        
        if (emptyEl) emptyEl.classList.remove('hidden');
        if (containerEl) containerEl.classList.add('hidden');
        if (loadingEl) loadingEl.classList.add('hidden');
    }
    
    function showError(section) {
        const errorEl = document.getElementById(`${section}ErrorState`);
        const containerEl = document.getElementById(`${section}Container`) || document.getElementById(section);
        const loadingEl = document.getElementById(`${section}LoadingState`);
        
        if (errorEl) errorEl.classList.remove('hidden');
        if (containerEl) containerEl.classList.add('hidden');
        if (loadingEl) loadingEl.classList.add('hidden');
    }
    
    // Legacy function names for compatibility
    function showOverviewLoading() { showLoading('overview'); }
    function hideOverviewLoading() { hideLoading('overview'); }
    function showOverviewEmpty() { showEmpty('overview'); }
    function showOverviewError() { showError('overview'); }
    function hideOverviewError() { document.getElementById('overviewErrorState')?.classList.add('hidden'); }
    
    function showChartLoading() { showLoading('chart'); }
    function hideChartLoading() { hideLoading('chart'); }
    function showChartEmpty() { showEmpty('chart'); }
    function showChartError() { showError('chart'); }
    
    function showTopContentLoading() { showLoading('topContent'); }
    function hideTopContentLoading() { hideLoading('topContent'); }
    function showTopContentEmpty() { showEmpty('topContent'); }
    function showTopContentError() { showError('topContent'); }
    
    function showRecentActivityLoading() { showLoading('recentActivity'); }
    function hideRecentActivityLoading() { hideLoading('recentActivity'); }
    function showRecentActivityEmpty() { showEmpty('recentActivity'); }
    function showRecentActivityError() { showError('recentActivity'); }
    
    // Debug function to check user data
    async function debugUserData() {
        try {
            const response = await fetch('/api/metrics/debug');
            const data = await response.json();
            
            if (data.success) {
                alert('Debug Info:\\nUser: ' + (data.user?.email || 'No user') + '\\nTwins: ' + (data.counts?.twins || 0) + '\\nChats: ' + (data.counts?.chats || 0) + '\\nEvents: ' + (data.counts?.events || 0));
            } else {
                alert('Debug failed: ' + data.error);
            }
        } catch (error) {
            alert('Debug error: ' + error.message);
        }
    }
    
    // Create sample data function
    async function createSampleData() {
        try {
            const response = await fetch('/api/metrics/create-sample', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });
            const data = await response.json();
            
            if (data.success) {
                alert('Sample data created successfully! Refreshing analytics...');
                loadAnalytics();
            } else {
                alert('Failed to create sample data: ' + data.error);
            }
        } catch (error) {
            alert('Error creating sample data: ' + error.message);
        }
    }
    
    // Load analytics data
    async function loadAnalytics() {
        showOverviewLoading();
        showChartLoading();
        showTopContentLoading();
        showRecentActivityLoading();
        hideOverviewError();
        
        // Cache DOM elements (FAST - single query batch)
        const elements = {
            totalViews: document.getElementById('totalViews'),
            totalLikes: document.getElementById('totalLikes'),
            totalFollowers: document.getElementById('totalFollowers'),
            totalChats: document.getElementById('totalChats'),
            positiveFeedback: document.getElementById('positiveFeedback'),
            negativeFeedback: document.getElementById('negativeFeedback'),
            satisfactionScore: document.getElementById('satisfactionScore'),
            overviewContainer: document.getElementById('overviewContainer'),
            topContent: document.getElementById('topContent'),
            recentActivity: document.getElementById('recentActivity'),
            chartContainer: document.getElementById('chartContainer')
        };
        
        try {
            // Load user analytics and feedback analytics in parallel (FAST)
            const [response, feedbackResponse] = await Promise.all([
                fetch('/api/metrics/user'),
                fetch('/api/analytics/feedback')
            ]);
            
            // Parse JSON in parallel (FAST)
            const [data, feedbackData] = await Promise.all([
                response.json(),
                feedbackResponse.json()
            ]);
            
            // Update overview cards
            if (data.success && data.analytics) {
                hideOverviewLoading();
                elements.overviewContainer?.classList.remove('hidden');
                
                const views = Number.isInteger(data.analytics.totalViews) ? data.analytics.totalViews : 0;
                const likes = Number.isInteger(data.analytics.totalLikes) ? data.analytics.totalLikes : 0;
                const followers = Number.isInteger(data.analytics.totalFollowers) ? data.analytics.totalFollowers : 0;
                const chats = Number.isInteger(data.analytics.totalChats) ? data.analytics.totalChats : 0;
                
                // Batch DOM updates (FAST)
                if (elements.totalViews) elements.totalViews.textContent = views;
                if (elements.totalLikes) elements.totalLikes.textContent = likes;
                if (elements.totalFollowers) elements.totalFollowers.textContent = followers;
                if (elements.totalChats) elements.totalChats.textContent = chats;
                
                // Check if all are zero
                if (views === 0 && likes === 0 && followers === 0 && chats === 0) {
                    showOverviewEmpty();
                }
            } else {
                showOverviewError();
            }
            
            // Update feedback analytics
            if (feedbackData.success && feedbackData.analytics) {
                const pos = Number.isInteger(feedbackData.analytics.positiveFeedback) 
                    ? feedbackData.analytics.positiveFeedback : 0;
                const neg = Number.isInteger(feedbackData.analytics.negativeFeedback) 
                    ? feedbackData.analytics.negativeFeedback : 0;
                const score = Number.isFinite(feedbackData.analytics.satisfactionScore) 
                    ? Math.round(feedbackData.analytics.satisfactionScore) : 0;
                
                if (elements.positiveFeedback) elements.positiveFeedback.textContent = pos;
                if (elements.negativeFeedback) elements.negativeFeedback.textContent = neg;
                if (elements.satisfactionScore) elements.satisfactionScore.textContent = score + '%';
            } else {
                if (elements.positiveFeedback) elements.positiveFeedback.textContent = '0';
                if (elements.negativeFeedback) elements.negativeFeedback.textContent = '0';
                if (elements.satisfactionScore) elements.satisfactionScore.textContent = '0%';
            }
            
            // Update chart
            hideChartLoading();
            if (elements.chartContainer) {
                elements.chartContainer.classList.remove('hidden');
            }
            
            // Update top content (FAST - DocumentFragment)
            hideTopContentLoading();
            if (elements.topContent) {
                elements.topContent.classList.remove('hidden');
                if (data.analytics?.topContent && data.analytics.topContent.length > 0) {
                    const fragment = document.createDocumentFragment();
                    data.analytics.topContent.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'p-3 bg-gray-50 dark:bg-gray-700 rounded-lg';
                        div.innerHTML = `<p class="text-sm font-medium text-gray-900 dark:text-white">${item.title || 'Content'}</p><p class="text-xs text-gray-500 dark:text-gray-400">${item.views || 0} views</p>`;
                        fragment.appendChild(div);
                    });
                    elements.topContent.innerHTML = '';
                    elements.topContent.appendChild(fragment);
                } else {
                    showTopContentEmpty();
                }
            }
            
            // Update recent activity (FAST - DocumentFragment)
            hideRecentActivityLoading();
            if (elements.recentActivity) {
                elements.recentActivity.classList.remove('hidden');
                if (data.analytics?.recentActivity && Array.isArray(data.analytics.recentActivity) && data.analytics.recentActivity.length > 0) {
                    const fragment = document.createDocumentFragment();
                    data.analytics.recentActivity.forEach(activity => {
                        if (!activity || !activity.description) return;
                        const timestamp = activity.timestamp ? TimeUtils.formatTimeWithContext(activity.timestamp) : 'Unknown time';
                        const div = document.createElement('div');
                        div.className = 'flex items-center space-x-3';
                        div.innerHTML = `<div class="w-2 h-2 bg-blue-500 rounded-full"></div><div class="flex-1"><p class="text-sm text-gray-900 dark:text-white">${activity.description}</p><p class="text-xs text-gray-500 dark:text-gray-400">${timestamp}</p></div>`;
                        fragment.appendChild(div);
                    });
                    elements.recentActivity.innerHTML = '';
                    elements.recentActivity.appendChild(fragment);
                } else {
                    showRecentActivityEmpty();
                }
            }
            
        } catch (error) {
            showOverviewError();
            showChartError();
            showTopContentError();
            showRecentActivityError();
        }
    }            
    
    // Load analytics on page load and add click handlers
    document.addEventListener('DOMContentLoaded', () => {
        loadAnalytics();
        
        // Get twinId from global variable (set by script tag outside template string)
        const twinIdValue = window.twinIdValue || '';
        
        // Set data attributes on cards and add click handlers
        const cards = [
            { element: document.getElementById('totalLikes')?.closest('[class*="bg-white"]'), type: 'likers' },
            { element: document.getElementById('totalFollowers')?.closest('[class*="bg-white"]'), type: 'followers' },
            { element: document.getElementById('totalChats')?.closest('[class*="bg-white"]'), type: 'chatters' }
        ];
        
        cards.forEach(card => {
            if (card.element) {
                card.element.classList.add('cursor-pointer', 'hover:shadow-xl', 'transition-all');
                card.element.setAttribute('data-twin-id', twinIdValue);
                card.element.setAttribute('data-list-type', card.type);
                
                // Direct redirect to analytics/details (NO popup)
                card.element.addEventListener('click', function() {
                    const twinId = this.getAttribute('data-twin-id');
                    const listType = this.getAttribute('data-list-type');
                    if (twinId && listType) {
                        // Direct redirect to details page (use string concatenation instead of template literal)
                        window.location.href = '/analytics/details?type=' + listType + '&twinId=' + twinId;
                    }                            
                });                    
            }
        });
    });
</script>

<!-- Social List Modal -->
<%- include('shared/social-list-modal') %>