        async function addPhrase() {
            const phraseEl = document.getElementById('newPhrase');
            if (!phraseEl) {
                console.error('newPhrase element not found');
                alert('Form element not found');
                return;
            }
            
            const phraseText = phraseEl.value.trim();
            if (!phraseText || phraseText.length === 0) {
                alert('Please enter a phrase');
                return;
            }

            // Check if phrase already exists
            const existingPhrase = allAnchors.find(a => {
                const anchorPhrase = a.phrase || '';
                return anchorPhrase.trim().toLowerCase() === phraseText.toLowerCase();
            });
            
            if (existingPhrase) {
                alert('This phrase already exists. Please try a different phrase.');
                return;
            }

            try {
                // For phrases, we only send type and phrase (same as style-customize.ejs)
                // Backend will handle setting userUtterance to NULL to avoid constraint violation
                const response = await fetch(`/api/twin/${twinId}/style-anchors`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': window.csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        type: 'phrase',
                        phrase: phraseText,
                        tags: [] // Match style-customize.ejs pattern
                    })
                });

                const data = await response.json();
                if (data.success) {
                    phraseEl.value = '';
                    loadMemoryData();
                    alert('Phrase added successfully!');
                } else {
                    const errorMsg = data.error || data.message || 'Failed to add phrase';
                    console.error('Backend error response:', data);
                    
                    // Check for duplicate key constraint error (PostgreSQL error code 23505)
                    if (errorMsg.includes('duplicate') || errorMsg.includes('constraint') || 
                        (data.details && data.details.code === '23505') ||
                        (data.details && data.details.constraint === 'style_anchors_twin_id_user_utterance_key')) {
                        alert('Error: Cannot add phrase due to database constraint. There may be an existing phrase with empty user_utterance. Please delete existing phrases first or contact support.');
                    } else {
                        alert('Error: ' + errorMsg);
                    }
                }
            } catch (error) {
                console.error('Error adding phrase:', error);
                const errorMsg = error.message || 'Unknown error';
                
                // Check if it's a duplicate key error
                if (errorMsg.includes('duplicate') || errorMsg.includes('constraint') || errorMsg.includes('23505')) {
                    alert('Error: Database constraint violation. There may be an existing phrase with empty user_utterance. Please try deleting existing phrases first or contact support.');
                } else {
                    alert('Error adding phrase: ' + errorMsg);
                }
            }
        }

        async function addInteraction() {
