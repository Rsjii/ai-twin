<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Memory Management - AI Twin</title>
    <link rel="stylesheet" href="/css/output.css">
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- IMMEDIATE Auth Check -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <div class="min-h-screen">
        <!--Header-->
        <%- include('header') %>        

        <!-- Page Title Section -->
        <div class="bg-gradient-to-r from-primary/10 via-accent/10 to-purple-500/10 dark:from-primary/20 dark:via-accent/20 dark:to-purple-500/20 border-b border-white/20 dark:border-gray-700">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Memory Management</h1>
                        <p class="text-gray-600 dark:text-gray-400">Manage and organize your AI twin's memories</p>
                    </div>
                    <button id="ingestBtn" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-medium shadow-md hover:scale-105 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Ingest Memory">
                        <span class="flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Ingest Memory
                        </span>
                    </button>
                </div>
            </div>
        </div>        

        <!-- Main Content -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Enhanced Memory Statistics -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4 mb-6 sm:mb-8">
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Total</h3>
                    <p class="text-xl sm:text-2xl font-bold text-blue-600 dark:text-blue-400" id="totalMemories">-</p>
                </div>
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Facts</h3>
                    <p class="text-xl sm:text-2xl font-bold text-green-600 dark:text-green-400" id="factsCount">-</p>
                </div>
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Preferences</h3>
                    <p class="text-xl sm:text-2xl font-bold text-yellow-600 dark:text-yellow-400" id="preferencesCount">-</p>
                </div>
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Interests</h3>
                    <p class="text-xl sm:text-2xl font-bold text-orange-600 dark:text-orange-400" id="interestsCount">-</p>
                </div>
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Relationships</h3>
                    <p class="text-xl sm:text-2xl font-bold text-pink-600 dark:text-pink-400" id="relationshipsCount">-</p>
                </div>
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Phrases</h3>
                    <p class="text-xl sm:text-2xl font-bold text-purple-600 dark:text-purple-400" id="phrasesCount">-</p>
                </div>
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-3 sm:p-4 border border-white/20 dark:border-gray-700">
                    <h3 class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Interactions</h3>
                    <p class="text-xl sm:text-2xl font-bold text-indigo-600 dark:text-indigo-400" id="interactionsCount">-</p>
                </div>
            </div>

            <!-- Memory Categories Section -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 mb-8">
                <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-lg font-medium text-gray-900 dark:text-white">Memory Categories</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Manage all types of memories</p>
                </div>

                <!-- Category Tabs -->
                <div class="px-6 pt-4">
                    <div class="flex space-x-2 border-b border-gray-200 dark:border-gray-700 overflow-x-auto scrollbar-hide snap-x snap-mandatory scroll-smooth">
                        <button data-category="fact" id="tab-fact" class="memory-category-tab px-4 py-2 font-medium text-blue-600 dark:text-blue-400 border-b-2 border-blue-600 dark:border-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Facts category">
                            Facts
                        </button>
                        <button data-category="preference" id="tab-preference" class="memory-category-tab px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Preferences category">
                            Preferences
                        </button>
                        <button data-category="interest" id="tab-interest" class="memory-category-tab px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Interests category">
                            Interests
                        </button>
                        <button data-category="relationship" id="tab-relationship" class="memory-category-tab px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Relationships category">
                            Relationships
                        </button>
                        <button data-category="context" id="tab-context" class="memory-category-tab px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Context category">
                            Context
                        </button>
                    </div>
                </div>

                <!-- Search Box -->
                <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
                    <input type="text" id="memorySearch" placeholder="Search memories..." 
                           class="w-full px-4 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base min-h-[44px]" aria-label="Search memories">
                </div>

                <!-- Memory List -->
                <div id="memoryList" class="p-4 sm:p-6 min-h-[300px]">
                    <!-- Loading State -->
                    <div id="memoryLoadingState" class="hidden">
                        <%- include('components/loading-skeleton', { type: 'list', count: 3 }) %>
                    </div>
                    
                    <!-- Empty State - MOVED INSIDE -->
                    <div id="memoryEmptyState" class="hidden">
                        <%- include('components/empty-state', { 
                            icon: '🧠',
                            title: 'No memories found',
                            description: 'Start adding memories to help your AI twin remember important information.',
                            compact: true
                        }) %>
                    </div>
                    
                    <!-- Error State - MOVED INSIDE -->
                    <div id="memoryErrorState" class="hidden">
                        <%- include('components/error-state', { 
                            title: 'Failed to load memories',
                            message: 'We encountered an error while loading memories. Please try again.'
                        }) %>
                    </div>
                </div>

                <!-- Add Memory Form -->
                <div class="px-6 pb-6 border-t border-gray-200 dark:border-gray-700 pt-4">
                    <div class="flex space-x-4">
                        <input type="text" id="newMemory" placeholder="Add new memory..." 
                               class="flex-1 px-3 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base min-h-[44px]" aria-label="Add new memory">
                               <button id="addMemoryBtn" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Add Memory">                            
                            Add Memory
                        </button>
                    </div>
                </div>
            </div>

            <!-- Style Anchors Section -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700">
                <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
                    <h2 class="text-lg font-medium text-gray-900 dark:text-white">Style Anchors</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Manage phrases and interaction patterns</p>
                </div>

                <!-- Style Anchor Tabs -->
                <div class="px-6 pt-4">
                    <div class="flex space-x-2 border-b border-gray-200 dark:border-gray-700 overflow-x-auto scrollbar-hide snap-x snap-mandatory scroll-smooth">
                        <button data-anchor-type="phrase" id="tab-phrase" class="style-anchor-tab px-4 py-2 font-medium text-blue-600 dark:text-blue-400 border-b-2 border-blue-600 dark:border-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Phrases">
                            Phrases
                        </button>
                        <button data-anchor-type="interaction" id="tab-interaction" class="style-anchor-tab px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Interactions">
                            Interactions
                        </button>
                    </div>
                </div>

                <!-- Search Box -->
                <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
                    <input type="text" id="anchorSearch" placeholder="Search style anchors..." 
                           class="w-full px-4 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base min-h-[44px]" aria-label="Search style anchors">
                </div>

                <!-- Style Anchor List -->
                <div id="styleAnchorList" class="p-4 sm:p-6 min-h-[300px]">
                    <!-- Loading State -->
                    <div id="anchorLoadingState" class="hidden">
                        <%- include('components/loading-skeleton', { type: 'list', count: 3 }) %>
                    </div>
                    
                    <!-- Empty State - MOVED INSIDE -->
                    <div id="anchorEmptyState" class="hidden">
                        <%- include('components/empty-state', { 
                            icon: '🎯',
                            title: 'No style anchors found',
                            description: 'Add phrases and interactions to customize your AI twin\'s communication style.',
                            compact: true
                        }) %>
                    </div>
                    
                    <!-- Error State - MOVED INSIDE -->
                    <div id="anchorErrorState" class="hidden">
                        <%- include('components/error-state', { 
                            title: 'Failed to load style anchors',
                            message: 'We encountered an error while loading style anchors. Please try again.'
                        }) %>
                    </div>
                </div>

                <!-- Add Style Anchor Form -->
                <div id="addPhraseForm" class="px-6 pb-6 border-t border-gray-200 pt-4">
                    <div class="flex space-x-4">
                        <input type="text" id="newPhrase" placeholder="Add new phrase..." 
                               class="flex-1 px-3 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base min-h-[44px]" aria-label="Add new phrase">
                               <button id="addPhraseBtn" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Add Phrase">                            
                            Add Phrase
                        </button>
                    </div>
                </div>

                <!-- Add Interaction Form (hidden by default) -->
                <div id="addInteractionForm" class="px-6 pb-6 border-t border-gray-200 pt-4" style="display: none;">
                    <div class="space-y-3">
                        <input type="text" id="newUserUtterance" placeholder="User utterance..." 
                               class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base min-h-[44px]" aria-label="User utterance">
                        <textarea id="newIdealReply" placeholder="Ideal reply..." rows="2"
                                  class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base" aria-label="Ideal reply"></textarea>
                                  <button id="addInteractionBtn" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Add Interaction">                            
                            Add Interaction
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced Ingest Modal -->
    <div id="ingestModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-xl shadow-2xl dark:shadow-gray-900 max-w-2xl w-full border border-white/20 dark:border-gray-700">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white">Ingest Memory</h3>
                    <button onclick="hideIngestModal()" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                
                <form id="ingestForm" class="p-4 sm:p-6">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Memory Type
                        </label>
                        <select id="memoryType" name="memoryType" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md dark:shadow-gray-900 text-gray-900 dark:text-white" required>
                            <option value="longterm">MemoryLongTerm (Facts, Preferences, etc.)</option>
                            <option value="style_anchor">StyleAnchor (Phrases, Interactions)</option>
                        </select>
                    </div>

                    <!-- Category Selector (for MemoryLongTerm) -->
                    <div id="categorySelector" class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Category
                        </label>
                        <select id="memoryCategory" name="memoryCategory" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md dark:shadow-gray-900 text-gray-900 dark:text-white" required>
                            <option value="fact">Fact</option>
                            <option value="preference">Preference</option>
                            <option value="interest">Interest</option>
                            <option value="relationship">Relationship</option>
                            <option value="context">Context</option>
                        </select>
                    </div>

                    <!-- Type Selector (for StyleAnchor) -->
                    <div id="typeSelector" class="mb-4" style="display: none;">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Type
                        </label>
                        <select id="anchorType" name="anchorType" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md dark:shadow-gray-900 text-gray-900 dark:text-white" required>
                            <option value="phrase">Phrase</option>
                            <option value="interaction">Interaction</option>
                        </select>
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Text to Analyze
                        </label>
                        <textarea 
                            id="memoryText" 
                            name="text"
                            rows="6"
                            class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md dark:shadow-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                            placeholder="Paste your text samples here..."
                            required
                        ></textarea>
                    </div>
                    
                    <div class="flex justify-end space-x-3">
                        <button type="button" onclick="hideIngestModal()" class="px-4 py-2 text-gray-700 dark:text-gray-300 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm rounded-xl hover:bg-white dark:hover:bg-gray-700 border border-white/20 dark:border-gray-600 transition-all font-medium shadow-md dark:shadow-gray-900">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                            Extract Memories
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const twinId = '<%= twinId %>';
        let currentMemoryCategory = 'fact';
        let currentAnchorType = 'phrase';
        let allMemories = [];
        let allAnchors = [];

        // Load memory data
        async function loadMemoryData() {
            // Show loading states
const memoryLoading = document.getElementById('memoryLoadingState');
const anchorLoading = document.getElementById('anchorLoadingState');
if (memoryLoading) memoryLoading.classList.remove('hidden');
if (anchorLoading) anchorLoading.classList.remove('hidden');

// Hide empty and error states
const memoryEmpty = document.getElementById('memoryEmptyState');
const memoryError = document.getElementById('memoryErrorState');
const anchorEmpty = document.getElementById('anchorEmptyState');
const anchorError = document.getElementById('anchorErrorState');
if (memoryEmpty) memoryEmpty.classList.add('hidden');
if (memoryError) memoryError.classList.add('hidden');
if (anchorEmpty) anchorEmpty.classList.add('hidden');
if (anchorError) anchorError.classList.add('hidden');
            try {
                // Load all memories and anchors
                const [longTermMemories, styleAnchors] = await Promise.all([
                    fetch(`/api/twin/${twinId}/long-term-memory?limit=1000`, {credentials: 'include'}),
                    fetch(`/api/twin/${twinId}/style-anchors?limit=1000`, {credentials: 'include'})
                ]);
                
                const longTermData = await longTermMemories.json();
                const anchorsData = await styleAnchors.json();
                
                allMemories = longTermData.memories || [];
                allAnchors = anchorsData.anchors || [];

                // Hide loading states
                if (memoryLoading) memoryLoading.classList.add('hidden');
                if (anchorLoading) anchorLoading.classList.add('hidden');

                if(allMemories.length === 0 && allAnchors.length === 0) {
                    // Show empty states
                    if (memoryEmpty) memoryEmpty.classList.remove('hidden');
                    if (anchorEmpty) anchorEmpty.classList.remove('hidden');
                }

                // Calculate stats
                const stats = {
                    total: allMemories.length + allAnchors.length,
                    fact: allMemories.filter(m => m.category === 'fact').length,
                    preference: allMemories.filter(m => m.category === 'preference').length,
                    interest: allMemories.filter(m => m.category === 'interest').length,
                    relationship: allMemories.filter(m => m.category === 'relationship').length,
                    context: allMemories.filter(m => m.category === 'context').length,
                    phrase: allAnchors.filter(a => {
                        const anchorType = a.type || '';
                        const hasPhrase = a.phrase && a.phrase.trim().length > 0;
                        return anchorType === 'phrase' || hasPhrase;
                    }).length,
                    interaction: allAnchors.filter(a => {
                        const anchorType = a.type || '';
                        const userUtterance = a.user_utterance || a.userUtterance || '';
                        const idealReply = a.ideal_reply || a.idealReply || '';
                        return anchorType === 'interaction' || (userUtterance.trim().length > 0 && idealReply.trim().length > 0);
                    }).length
                };

                // Update UI
                document.getElementById('totalMemories').textContent = stats.total;
                document.getElementById('factsCount').textContent = stats.fact;
                document.getElementById('preferencesCount').textContent = stats.preference;
                document.getElementById('interestsCount').textContent = stats.interest;
                document.getElementById('relationshipsCount').textContent = stats.relationship;
                document.getElementById('phrasesCount').textContent = stats.phrase;
                document.getElementById('interactionsCount').textContent = stats.interaction;

                // Load initial category
                loadMemoryCategory(currentMemoryCategory);
                loadStyleAnchors(currentAnchorType);
            } catch (error) {
                console.error('Error loading memory data:', error);

                 // Hide loading, show error
                 if (memoryLoading) memoryLoading.classList.add('hidden');
                 if (anchorLoading) anchorLoading.classList.add('hidden');
                 if (memoryError) memoryError.classList.remove('hidden');
                 if (anchorError) anchorError.classList.remove('hidden');
            }
        }

        function loadMemoryCategory(category) {
            currentMemoryCategory = category;
            const filtered = allMemories.filter(m => m.category === category);
            displayMemories(filtered);
        }

        function loadStyleAnchors(type) {
            currentAnchorType = type;
            let filtered;
            if (type === 'phrase') {
                filtered = allAnchors.filter(a => {
                    const anchorType = a.type || '';
                    const hasPhrase = a.phrase && a.phrase.trim().length > 0;
                    return anchorType === 'phrase' || hasPhrase;
                });
            } else {
                filtered = allAnchors.filter(a => {
                    const anchorType = a.type || '';
                    const userUtterance = a.user_utterance || a.userUtterance || '';
                    const idealReply = a.ideal_reply || a.idealReply || '';
                    return anchorType === 'interaction' || (userUtterance.trim().length > 0 && idealReply.trim().length > 0);
                });
            }
            displayStyleAnchors(filtered, type);
        }

        function displayMemories(memories) {
