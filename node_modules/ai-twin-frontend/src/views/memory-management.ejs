            // Ingest modal type change
            document.getElementById('memoryType')?.addEventListener('change', function() {
                if (this.value === 'longterm') {
                    document.getElementById('categorySelector').style.display = 'block';
                    document.getElementById('typeSelector').style.display = 'none';
                } else {
                    document.getElementById('categorySelector').style.display = 'none';
                    document.getElementById('typeSelector').style.display = 'block';
                }
            });

            // Ingest form submission
            document.getElementById('ingestForm')?.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const memoryType = document.getElementById('memoryType').value;
                const memoryText = document.getElementById('memoryText').value.trim();
                
                if (!memoryText) {
                    alert('Please enter memory text');
                    return;
                }
                
                try {
                    let response;
                    
                    if (memoryType === 'longterm') {
                        const category = document.getElementById('memoryCategory').value;
                        response = await fetch(`/api/twin/${twinId}/long-term-memory`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': window.csrfToken
                            },
                            credentials: 'include',
                            body: JSON.stringify({
                                value: memoryText,
                                category: category
                            })
                        });
                    } else {
                        const anchorType = document.getElementById('anchorType').value;
                        if (anchorType === 'phrase') {
                            response = await fetch(`/api/twin/${twinId}/style-anchors`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-Token': window.csrfToken
                                },
                                credentials: 'include',
                                body: JSON.stringify({
                                    type: 'phrase',
                                    phrase: memoryText
                                })
                            });
                        } else {
                            // For interaction, split by newline or use first line as utterance, rest as reply
                            const lines = memoryText.split('\n').filter(l => l.trim());
                            const userUtterance = lines[0] || '';
                            const idealReply = lines.slice(1).join('\n') || lines[0] || '';
                            
                            response = await fetch(`/api/twin/${twinId}/style-anchors`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-Token': window.csrfToken
                                },
                                credentials: 'include',
                                body: JSON.stringify({
                                    type: 'interaction',
                                    userUtterance: userUtterance,
                                    idealReply: idealReply
                                })
                            });
                        }
                    }
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        alert('Memory added successfully!');
                        hideIngestModal();
                        loadMemoryData();
                    } else {
                        alert('Error: ' + (result.error || 'Failed to add memory'));
                    }
                } catch (error) {
                    console.error('Error ingesting memory:', error);
                    alert('Error ingesting memory');
                }
            });
        });

        // Make functions globally accessible
        window.addMemory = addMemory;
        window.addPhrase = addPhrase;
        window.addInteraction = addInteraction;
        window.editMemory = editMemory;
        window.deleteMemory = deleteMemory;
        window.editPhrase = editPhrase;
        window.editInteraction = editInteraction;
        window.deleteAnchor = deleteAnchor;
        window.showIngestModal = showIngestModal;
        window.hideIngestModal = hideIngestModal;
    </script>

    <!--Footer-->
    <%- include('footer/footer-conditional-private') %>
</body>
</html>