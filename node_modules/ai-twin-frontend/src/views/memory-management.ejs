                } else {
                    const errorMsg = data.error || data.message || 'Failed to add interaction';
                    console.error('Backend error response:', data);
                    
                    // Check for duplicate key constraint error (PostgreSQL error code 23505)
                    if (errorMsg.includes('duplicate') || errorMsg.includes('constraint') || 
                        (data.details && data.details.code === '23505') ||
                        (data.details && data.details.constraint === 'style_anchors_twin_id_user_utterance_key')) {
                        alert('Error: An interaction with this user utterance already exists. Please try a different user utterance.');
                    } else {
