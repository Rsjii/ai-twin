<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AI Edit - AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- Beautiful Header with Navigation -->
    <nav class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl sticky top-0 z-50 border-b border-white/20 dark:border-gray-700 shadow-lg dark:shadow-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Left: Logo & Navigation -->
                <div class="flex items-center space-x-6">
                    <a href="/dashboard" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </a>
                    <nav class="hidden md:flex items-center space-x-6">
                        <a href="/dashboard" class="text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium px-3 py-2 rounded-lg hover:bg-white/50 dark:hover:bg-gray-800/50">Dashboard</a>
                        <a href="/discover" class="text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium px-3 py-2 rounded-lg hover:bg-white/50 dark:hover:bg-gray-800/50">Discover</a>
                        <a href="/twin/manage" class="text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium px-3 py-2 rounded-lg hover:bg-white/50 dark:hover:bg-gray-800/50">My Twin</a>
                    </nav>
                </div>
                
                <!-- Right: User Menu -->
                <div class="flex items-center space-x-4">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="relative" id="userDropdown" data-open="false">
                            <button id="dropdownButton" class="flex items-center space-x-3 px-4 py-2 rounded-xl bg-white/80 dark:bg-gray-800/80 hover:bg-white dark:hover:bg-gray-700 transition-all duration-300 shadow-lg dark:shadow-gray-900 hover:shadow-xl border border-white/20 dark:border-gray-700 group">
                                <% if (user.profileImage) { %>
                                    <img src="<%= user.profileImage %>" alt="Profile" class="w-10 h-10 rounded-full object-cover shadow-lg">
                                <% } else { %>
                                    <div class="w-10 h-10 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg">
                                        <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div class="hidden sm:block text-left">
                                    <div class="text-sm font-semibold text-gray-900 dark:text-white"><%= user.handle || user.email %></div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400"><%= user.email %></div>
                                </div>
                                <svg id="arrowIcon" class="w-4 h-4 text-gray-400 dark:text-gray-500 transition-transform duration-200 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            
                            <div id="dropdownMenu" class="absolute right-0 mt-3 w-72 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 py-3 z-50 hidden transition-all duration-200 opacity-0 scale-95">
                                <div class="px-6 py-4 border-b border-gray-100/50 dark:border-gray-700/50">
                                    <div class="flex items-center space-x-4">
                                        <% if (user.profileImage) { %>
                                            <img src="<%= user.profileImage %>" alt="Profile" class="w-14 h-14 rounded-2xl object-cover shadow-lg">
                                        <% } else { %>
                                            <div class="w-14 h-14 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-2xl flex items-center justify-center text-white text-xl font-bold shadow-lg">
                                                <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-lg font-semibold text-gray-900 dark:text-white truncate"><%= user.name || user.handle || 'User' %></p>
                                            <p class="text-sm text-gray-500 dark:text-gray-400 truncate"><%= user.email %></p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="py-2">
                                    <a href="/profile" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        Profile Settings
                                    </a>
                                    <a href="/discover" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                        Discover Twins
                                    </a>
                                    <% if (typeof hasTwins !== 'undefined' && hasTwins && typeof twinId !== 'undefined' && twinId) { %>
                                        <a href="/twin/manage" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                            <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                            </svg>
                                            My Twin
                                        </a>
                                    <% } %>
                                    <a href="/analytics" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                        </svg>
                                        Analytics
                                    </a>
                                    <a href="/profile?tab=settings" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                        Settings
                                    </a>
                                </div>
                                
                                <div class="border-t border-gray-100/50 dark:border-gray-700/50 pt-2">
                                    <button onclick="logout()" class="flex items-center w-full px-6 py-3 text-red-600 dark:text-red-400 hover:bg-red-50/80 dark:hover:bg-red-900/20 transition-colors">
                                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                        </svg>
                                        Sign Out
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        <!-- Page Title Section -->
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">AI Edit</h1>
            <p class="text-gray-600 dark:text-gray-300">Edit your AI twin's personality, prompts, and memory like GPT custom instructions</p>
        </div>

        <!-- Navigation Breadcrumbs -->
<div class="mb-6">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/dashboard" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/my-twins" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">My Twins</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/twin/<%= twinId %>/learning-dashboard" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">Learning Dashboard</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-gray-900 dark:text-white font-medium">AI Edit</span>
        </li>
      </ol>
    </nav>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 dark:border-gray-700 shadow-md dark:shadow-gray-900">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="/twin/<%= twinId %>/learning-dashboard" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Learning Dashboard
        </a>
        <a href="/twin/<%= twinId %>/style-customize" class="bg-gradient-to-r from-accent to-purple-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
          Style Customize
        </a>
      </div>
      <div class="text-sm text-gray-600 dark:text-gray-300">
        <span class="font-medium">Twin ID:</span> <%= twinId %>
      </div>
    </div>
  </div>

        <!-- Recent Memories Preview (Read-Only) -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-6 mb-8 border border-white/20 dark:border-gray-700">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold dark:text-white">Recent Memories</h2>
                <a href="/twin/<%= twinId %>/memory-management" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium">
                    Manage All Memories →
                </a>
            </div>
            <div id="recentMemoriesPreview" class="space-y-2 max-h-[200px] overflow-y-auto">
                <p class="text-gray-500 dark:text-gray-400 text-sm">Loading recent memories...</p>
            </div>
        </div>

        <!-- Enhanced Personality & Persona -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-6 mb-8 border border-white/20 dark:border-gray-700">
            <h2 class="text-xl font-semibold mb-4 dark:text-white">Personality & Persona</h2>
            
            <!-- Basic Information -->
            <div class="mb-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700 dark:text-gray-300">Basic Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Full Name</label>
                    <input type="text" id="fullName" placeholder="Your full name" 
                           class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                </div>
                <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Username</label>
                        <input type="text" id="username" placeholder="Your username" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2 md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Bio</label>
                    <textarea id="bio" placeholder="Tell us about yourself" rows="3"
                              class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"></textarea>
                </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Primary Use Case</label>
                        <input type="text" id="primaryUseCase" placeholder="What will you use this AI twin for?" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                </div>
            </div>
            
            <!-- Communication Style -->
            <div class="mb-6 border-t dark:border-gray-700 pt-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700 dark:text-gray-300">Communication Style</h3>
                
                <!-- Tone Sliders -->
                <div class="mb-4">
                    <h4 class="text-sm font-medium mb-3 text-gray-600 dark:text-gray-400">Tone Preferences</h4>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Formal ↔ Casual: <span id="formalCasual-value">50</span>
                            </label>
                            <input type="range" id="formalCasual" min="0" max="100" value="50" 
                                   class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Serious ↔ Playful: <span id="seriousPlayful-value">50</span>
                            </label>
                            <input type="range" id="seriousPlayful" min="0" max="100" value="50" 
                                   class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Direct ↔ Diplomatic: <span id="directDiplomatic-value">50</span>
                            </label>
                            <input type="range" id="directDiplomatic" min="0" max="100" value="50" 
                                   class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                        </div>
                    </div>
                </div>
                
                <!-- Language Preferences -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Greeting Style</label>
                        <input type="text" id="greetingStyle" placeholder="e.g., Hey, Hi, Hello" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Closing Style</label>
                        <input type="text" id="closingStyle" placeholder="e.g., Thanks, Cheers, Best" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Emoji Usage</label>
                        <select id="emojiUsage" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white">
                            <option value="none">None</option>
                            <option value="minimal">Minimal</option>
                            <option value="moderate" selected>Moderate</option>
                            <option value="frequent">Frequent</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Response Length</label>
                        <select id="responseLength" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white">
                            <option value="brief">Brief</option>
                            <option value="detailed" selected>Detailed</option>
                            <option value="comprehensive">Comprehensive</option>
                        </select>
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Common Phrases</label>
                        <textarea id="commonPhrases" placeholder="Phrases you commonly use..." rows="2"
                                  class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Context -->
            <div class="mb-6 border-t dark:border-gray-700 pt-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700 dark:text-gray-300">Context & Interests</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2 md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Interests (comma-separated)</label>
                    <input type="text" id="interests" placeholder="technology, music, travel" 
                           class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Target Audience</label>
                        <input type="text" id="targetAudience" placeholder="Who are you communicating with?" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Topics to Avoid</label>
                        <input type="text" id="topicsToAvoid" placeholder="Topics you prefer not to discuss" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between items-center">
            <button id="previewChangesBtn" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                Preview Changes
            </button>
            <div class="space-x-4">
                <button id="resetChangesBtn" class="bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 px-6 py-2 rounded-xl hover:bg-white dark:hover:bg-gray-700 border border-white/20 dark:border-gray-600 transition-all font-medium shadow-md">
                    Reset
                </button>
                <button id="saveChangesBtn" class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                    Save Changes
                </button>
            </div>
        </div>
    </div>

    <script>
    let currentTwinData = null;
    const twinId = '<%= twinId %>';

    // Load twin data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTwinData();
        setupEventListeners();
        
        // Setup tone slider listeners
        ['formalCasual', 'seriousPlayful', 'directDiplomatic'].forEach(id => {
            const slider = document.getElementById(id);
            if (slider) {
                slider.addEventListener('input', function() {
                    document.getElementById(`${id}-value`).textContent = this.value;
                });
            }
        });
    });

    function setupEventListeners() {
        // Setup Action Buttons
        const previewBtn = document.getElementById('previewChangesBtn');
        if (previewBtn) {
            previewBtn.addEventListener('click', function(e) {
                e.preventDefault();
                previewChanges();
            });
        }

        const resetBtn = document.getElementById('resetChangesBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function(e) {
                e.preventDefault();
                resetChanges();
            });
        }

        const saveBtn = document.getElementById('saveChangesBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', function(e) {
                e.preventDefault();
                saveChanges();
            });
        }
    }

    async function loadTwinData() {
        try {
            const response = await fetch(`/api/twin/${twinId}/edit-data`);
            const data = await response.json();
            
            if (data.success) {
                currentTwinData = data.twin;
                populateForm(data.twin);
            }
        } catch (error) {
            console.error('Error loading twin data:', error);
        }
    }

    function populateForm(twin) {        
        const pd = twin.personaData || {};
        
        // Basic Info - Support both old structure (basicInfo) and new structure (direct fields)
        const basicInfo = pd.basicInfo || {};
        if (document.getElementById('fullName')) document.getElementById('fullName').value = basicInfo.fullName || pd.name || '';
        if (document.getElementById('bio')) document.getElementById('bio').value = basicInfo.bio || pd.bio || '';
        if (document.getElementById('username')) document.getElementById('username').value = basicInfo.username || pd.username || '';
        if (document.getElementById('primaryUseCase')) document.getElementById('primaryUseCase').value = basicInfo.primaryUseCase || pd.primaryUseCase || '';
        
        // Context - Interests
        const interests = pd.context?.interests || pd.interests || [];
        if (document.getElementById('interests')) document.getElementById('interests').value = Array.isArray(interests) ? interests.join(', ') : '';
        
        // Context - Target Audience & Topics to Avoid
        if (document.getElementById('targetAudience')) document.getElementById('targetAudience').value = pd.context?.targetAudience || '';
        if (document.getElementById('topicsToAvoid')) document.getElementById('topicsToAvoid').value = pd.context?.topicsToAvoid || '';
        
        // Communication Style - Tone
        const tone = pd.communicationStyle?.tone || {};
        if (document.getElementById('formalCasual')) {
            document.getElementById('formalCasual').value = tone.formalCasual || 50;
            document.getElementById('formalCasual-value').textContent = tone.formalCasual || 50;
        }
        if (document.getElementById('seriousPlayful')) {
            document.getElementById('seriousPlayful').value = tone.seriousPlayful || 50;
            document.getElementById('seriousPlayful-value').textContent = tone.seriousPlayful || 50;
        }
        if (document.getElementById('directDiplomatic')) {
            document.getElementById('directDiplomatic').value = tone.directDiplomatic || 50;
            document.getElementById('directDiplomatic-value').textContent = tone.directDiplomatic || 50;
        }
        
        // Communication Style - Language
        const language = pd.communicationStyle?.language || {};
        if (document.getElementById('greetingStyle')) document.getElementById('greetingStyle').value = language.greetingStyle || '';
        if (document.getElementById('closingStyle')) document.getElementById('closingStyle').value = language.closingStyle || '';
        if (document.getElementById('emojiUsage')) document.getElementById('emojiUsage').value = language.emojiUsage || 'moderate';
        if (document.getElementById('responseLength')) document.getElementById('responseLength').value = language.responseLength || 'detailed';
        if (document.getElementById('commonPhrases')) document.getElementById('commonPhrases').value = language.commonPhrases || '';
        
        // Load recent memories preview
        loadRecentMemoriesPreview();
    }


    function updateToneDisplays() {
        const formalCasual = document.getElementById('formalCasual');
        const seriousPlayful = document.getElementById('seriousPlayful');
        const directDiplomatic = document.getElementById('directDiplomatic');
        
        if (formalCasual) document.getElementById('formalCasual-value').textContent = formalCasual.value;
        if (seriousPlayful) document.getElementById('seriousPlayful-value').textContent = seriousPlayful.value;
        if (directDiplomatic) document.getElementById('directDiplomatic-value').textContent = directDiplomatic.value;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function escapeForAttribute(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    // Load recent memories preview (read-only, all categories mixed)
    async function loadRecentMemoriesPreview() {
        try {
            const response = await fetch(`/api/twin/${twinId}/long-term-memory?limit=5`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            const previewEl = document.getElementById('recentMemoriesPreview');
            if (!previewEl) return;
            
            if (data.success && data.memories && data.memories.length > 0) {
                const memoriesHTML = data.memories.map(memory => {
                    const safeValue = escapeHtml(memory.value || memory.text || '');
                    const category = memory.category || 'fact';
                    const date = memory.createdAt ? new Date(memory.createdAt).toLocaleDateString() : '';
                    
                    return `
                        <div class="flex items-start p-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg text-sm">
                            <div class="flex-1">
                                <p class="text-gray-900 dark:text-white">${safeValue}</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">${category} • ${date}</p>
                            </div>
                        </div>
                    `;
                }).join('');
                previewEl.innerHTML = memoriesHTML;
            } else {
                previewEl.innerHTML = '<p class="text-gray-500 text-sm text-center py-2">No memories yet</p>';
            }
        } catch (error) {
            console.error('Error loading recent memories:', error);
            const previewEl = document.getElementById('recentMemoriesPreview');
            if (previewEl) {
                previewEl.innerHTML = '<p class="text-red-500 text-sm text-center py-2">Error loading memories</p>';
            }
        }
    }

async function saveChanges() {
    const updates = {
        personaData: {
            basicInfo: {
                    fullName: document.getElementById('fullName')?.value || '',
                    bio: document.getElementById('bio')?.value || '',
                    username: document.getElementById('username')?.value || '',
                    primaryUseCase: document.getElementById('primaryUseCase')?.value || ''
                },
                communicationStyle: {
                    tone: {
                        formalCasual: parseInt(document.getElementById('formalCasual')?.value || 50),
                        seriousPlayful: parseInt(document.getElementById('seriousPlayful')?.value || 50),
                        directDiplomatic: parseInt(document.getElementById('directDiplomatic')?.value || 50)
                    },
                    language: {
                        greetingStyle: document.getElementById('greetingStyle')?.value || '',
                        closingStyle: document.getElementById('closingStyle')?.value || '',
                        emojiUsage: document.getElementById('emojiUsage')?.value || 'moderate',
                        responseLength: document.getElementById('responseLength')?.value || 'detailed',
                        commonPhrases: document.getElementById('commonPhrases')?.value || ''
                    }
                },
                context: {
                    interests: (document.getElementById('interests')?.value || '').split(',').map(i => i.trim()).filter(i => i),
                    targetAudience: document.getElementById('targetAudience')?.value || '',
                    topicsToAvoid: document.getElementById('topicsToAvoid')?.value || ''
                }
        }
    };
    
    try {
        const response = await fetch(`/api/twin/${twinId}/update-persona`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
                credentials: 'include',
            body: JSON.stringify(updates)
        });
        
        const data = await response.json();
        if (data.success) {
            alert('Changes saved successfully!');
            loadTwinData();
        } else {
            alert('Error: ' + (data.error || 'Failed to save changes'));
        }
    } catch (error) {
        console.error('Error saving changes:', error);
            alert('Error saving changes: ' + error.message);
    }
}
    
    function resetChanges() {
        if (currentTwinData) {
            populateForm(currentTwinData);
        } else {
            alert('No data loaded. Please refresh the page.');
        }
    }

    function previewChanges() {
    if (!currentTwinData) {
            alert('Please wait for data to load first');
        return;
    }
        
        const pd = currentTwinData.personaData || {};
        const basicInfo = pd.basicInfo || {};
        const tone = pd.communicationStyle?.tone || {};
        const language = pd.communicationStyle?.language || {};
    
    const current = {
            fullName: basicInfo.fullName || pd.name || '',
            username: basicInfo.username || pd.username || '',
            bio: basicInfo.bio || pd.bio || '',
            primaryUseCase: basicInfo.primaryUseCase || pd.primaryUseCase || '',
            formalCasual: tone.formalCasual || 50,
            seriousPlayful: tone.seriousPlayful || 50,
            directDiplomatic: tone.directDiplomatic || 50,
            greetingStyle: language.greetingStyle || '',
            closingStyle: language.closingStyle || '',
            emojiUsage: language.emojiUsage || 'moderate',
            responseLength: language.responseLength || 'detailed',
            commonPhrases: language.commonPhrases || '',
            interests: (pd.context?.interests || pd.interests || []).join(', '),
            targetAudience: pd.context?.targetAudience || '',
            topicsToAvoid: pd.context?.topicsToAvoid || ''
    };
    
    const updated = {
            fullName: document.getElementById('fullName')?.value || '',
            username: document.getElementById('username')?.value || '',
            bio: document.getElementById('bio')?.value || '',
            primaryUseCase: document.getElementById('primaryUseCase')?.value || '',
            formalCasual: parseInt(document.getElementById('formalCasual')?.value || 50),
            seriousPlayful: parseInt(document.getElementById('seriousPlayful')?.value || 50),
            directDiplomatic: parseInt(document.getElementById('directDiplomatic')?.value || 50),
            greetingStyle: document.getElementById('greetingStyle')?.value || '',
            closingStyle: document.getElementById('closingStyle')?.value || '',
            emojiUsage: document.getElementById('emojiUsage')?.value || 'moderate',
            responseLength: document.getElementById('responseLength')?.value || 'detailed',
            commonPhrases: document.getElementById('commonPhrases')?.value || '',
            interests: document.getElementById('interests')?.value || '',
            targetAudience: document.getElementById('targetAudience')?.value || '',
            topicsToAvoid: document.getElementById('topicsToAvoid')?.value || ''
    };
    
    let changes = [];
        Object.keys(current).forEach(key => {
            if (String(current[key]) !== String(updated[key])) {
                changes.push(`${key}: "${current[key]}" → "${updated[key]}"`);
            }
        });
    
    if (changes.length === 0) {
        alert('No changes detected');
    } else {
        alert('Preview Changes:\n\n' + changes.join('\n'));
    }
}

    // Make functions globally accessible
    window.saveChanges = saveChanges;
    window.resetChanges = resetChanges;
    window.previewChanges = previewChanges;

    </script>

<script>
    // Dropdown functionality
    document.addEventListener('DOMContentLoaded', function() {
        const dropdown = document.getElementById('userDropdown');
        const button = document.getElementById('dropdownButton');
        const menu = document.getElementById('dropdownMenu');
        const arrow = document.getElementById('arrowIcon');
        
        if (button && menu) {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = dropdown.getAttribute('data-open') === 'true';
                if (isOpen) {
                    menu.classList.add('hidden');
                    menu.classList.remove('opacity-100', 'scale-100');
                    menu.classList.add('opacity-0', 'scale-95');
                    arrow.style.transform = 'rotate(0deg)';
                    dropdown.setAttribute('data-open', 'false');
                } else {
                    menu.classList.remove('hidden');
                    menu.classList.remove('opacity-0', 'scale-95');
                    menu.classList.add('opacity-100', 'scale-100');
                    arrow.style.transform = 'rotate(180deg)';
                    dropdown.setAttribute('data-open', 'true');
                }
            });
            
            document.addEventListener('click', function(e) {
                if (!dropdown.contains(e.target)) {
                    menu.classList.add('hidden');
                    menu.classList.remove('opacity-100', 'scale-100');
                    menu.classList.add('opacity-0', 'scale-95');
                    arrow.style.transform = 'rotate(0deg)';
                    dropdown.setAttribute('data-open', 'false');
                }
            });
        }
    });
    
    // Logout function
    function logout() {
        if (confirm('Are you sure you want to sign out?')) {
            window.location.href = '/api/auth/logout';
        }
    }
</script>

</body>
</html>