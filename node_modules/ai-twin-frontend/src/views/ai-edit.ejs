<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AI Edit - AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 min-h-screen font-inter">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">AI Edit</h1>
            <p class="text-gray-600">Edit your AI twin's personality, prompts, and memory like GPT custom instructions</p>
        </div>

        <!-- Navigation Breadcrumbs -->
<div class="mb-6">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/dashboard" class="text-gray-500 hover:text-gray-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/my-twins" class="text-gray-500 hover:text-gray-700 transition-colors">My Twins</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/twin/<%= twinId %>/learning-dashboard" class="text-gray-500 hover:text-gray-700 transition-colors">Learning Dashboard</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-gray-900 font-medium">AI Edit</span>
        </li>
      </ol>
    </nav>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 shadow-md">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="/twin/<%= twinId %>/learning-dashboard" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Learning Dashboard
        </a>
        <a href="/twin/<%= twinId %>/style-customize" class="bg-gradient-to-r from-accent to-purple-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
          Style Customize
        </a>
      </div>
      <div class="text-sm text-gray-600">
        <span class="font-medium">Twin ID:</span> <%= twinId %>
      </div>
    </div>
  </div>

        <!-- System Prompt Section -->
        <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 mb-8 border border-white/20">
            <h2 class="text-xl font-semibold mb-4">System Prompt</h2>
            <textarea id="systemPrompt" placeholder="Enter your custom system prompt..." rows="6"
                      class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md"></textarea>
        </div>

        <!-- Memory Section -->
        <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 mb-8 border border-white/20">
            <h2 class="text-xl font-semibold mb-4">Memory & Facts</h2>
            <div id="memoryList" class="space-y-3 mb-4">
                <!-- Memory items will be loaded here -->
            </div>
            <div class="flex space-x-4">
                <input type="text" id="newMemory" placeholder="Add new memory..." 
                       class="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                <button onclick="addMemory()" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600">
                    Add Memory
                </button>
            </div>
        </div>

        <!-- Personality Traits -->
        <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 mb-8 border border-white/20">
            <h2 class="text-xl font-semibold mb-4">Personality Traits</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Full Name</label>
                    <input type="text" id="fullName" placeholder="Your full name" 
                           class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                </div>
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Bio</label>
                    <textarea id="bio" placeholder="Tell us about yourself" rows="3"
                              class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md"></textarea>
                </div>
                <div class="space-y-2 md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700">Interests (comma-separated)</label>
                    <input type="text" id="interests" placeholder="technology, music, travel" 
                           class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between items-center">
            <button onclick="previewChanges()" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                Preview Changes
            </button>
            <div class="space-x-4">
                <button onclick="resetChanges()" class="bg-white/80 backdrop-blur-sm text-gray-700 px-6 py-2 rounded-xl hover:bg-white border border-white/20 transition-all font-medium shadow-md">
                    Reset
                </button>
                <button onclick="saveChanges()" class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                    Save Changes
                </button>
            </div>
        </div>
    </div>

    <script>
    let currentTwinData = null;
    const twinId = '<%= twinId %>';

    // Load twin data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTwinData();
    });

    async function loadTwinData() {
        try {
            const response = await fetch(`/api/twin/${twinId}/edit-data`);
            const data = await response.json();
            
            if (data.success) {
                currentTwinData = data.twin;
                populateForm(data.twin);
            }
        } catch (error) {
            console.error('Error loading twin data:', error);
        }
    }

    function populateForm(twin) {
        // Populate system prompt
        document.getElementById('systemPrompt').value = twin.systemPrompt || '';
        
        // Populate persona data
        if (twin.personaData?.basicInfo) {
            document.getElementById('fullName').value = twin.personaData.basicInfo.fullName || '';
            document.getElementById('bio').value = twin.personaData.basicInfo.bio || '';
        }
        if (twin.personaData?.interests) {
            document.getElementById('interests').value = twin.personaData.interests.join(', ');
        }
        
        // Load memories (if any)
        loadMemories();
    }

    function loadMemories() {
        // TODO: Load memories from backend
        document.getElementById('memoryList').innerHTML = '<p class="text-gray-500">No memories yet</p>';
    }

    function addMemory() {
        const memory = document.getElementById('newMemory').value.trim();
        if (!memory) return;
        
        // TODO: Add memory to backend
        console.log('Adding memory:', memory);
        document.getElementById('newMemory').value = '';
    }

    async function saveChanges() {
        const updates = {
            systemPrompt: document.getElementById('systemPrompt').value,
            personaData: {
                basicInfo: {
                    fullName: document.getElementById('fullName').value,
                    bio: document.getElementById('bio').value
                },
                interests: document.getElementById('interests').value.split(',').map(i => i.trim()).filter(i => i)
            }
        };
        
        try {
            await fetch(`/api/twin/${twinId}/update-ai`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.csrfToken
                },
                body: JSON.stringify(updates)
            });
            
            alert('Changes saved successfully!');
            loadTwinData();
        } catch (error) {
            console.error('Error saving changes:', error);
            alert('Error saving changes');
        }
    }

    function resetChanges() {
        if (currentTwinData) {
            populateForm(currentTwinData);
        }
    }

    function previewChanges() {
        // TODO: Implement preview functionality
        alert('Preview functionality coming soon!');
    }
    </script>
</body>
</html>