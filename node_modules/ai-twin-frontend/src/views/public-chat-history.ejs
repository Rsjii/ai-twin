<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= typeof title !== 'undefined' ? title : 'Your Chat History - AI Twin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <style>
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 min-h-screen font-inter">
    <!-- Navigation -->
    <nav class="bg-white/80 backdrop-blur-xl sticky top-0 z-50 border-b border-white/20 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex items-center space-x-6">
                    <a href="/dashboard" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </a>
                    <nav class="hidden md:flex items-center space-x-6">
                        <a href="/dashboard" class="text-gray-700 hover:text-primary transition-colors font-medium px-3 py-2 rounded-lg hover:bg-white/50">Dashboard</a>
                        <a href="/discover" class="text-gray-700 hover:text-primary transition-colors font-medium px-3 py-2 rounded-lg hover:bg-white/50">Discover</a>
                        <a href="/chat-enhanced" class="text-gray-700 hover:text-primary transition-colors font-medium px-3 py-2 rounded-lg hover:bg-white/50">Chat</a>
                        <a href="/public-chat/history" class="text-primary bg-white/50 px-3 py-2 rounded-lg font-medium">My Chats</a>
                    </nav>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">Your Chat History</h1>
                    <p class="text-gray-600">All the AI twins you've chatted with</p>
                </div>
                <div class="flex gap-3">
                    <a href="/discover" class="hidden md:flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-xl rounded-xl border border-white/20 hover:shadow-lg transition-all">
                        <span>🔍</span>
                        <span class="font-medium text-gray-700">Discover More</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8" id="statsCards">
            <!-- Stats will be populated by JS -->
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="text-center py-12">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4"></div>
            <p class="text-gray-600">Loading your chat history...</p>
        </div>

        <!-- Empty State (hidden by default) -->
        <div id="emptyState" class="hidden text-center py-16">
            <div class="bg-white/80 backdrop-blur-xl rounded-2xl p-12 border border-white/20 shadow-xl max-w-md mx-auto">
                <div class="w-20 h-20 bg-gradient-to-r from-primary/20 to-accent/20 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">No Chats Yet</h3>
                <p class="text-gray-600 mb-6">Start exploring AI twins and begin conversations to see them here!</p>
                <a href="/discover" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-medium">
                    <span>🔍</span>
                    <span>Discover Twins</span>
                </a>
            </div>
        </div>

        <!-- Twin Cards Grid -->
        <div id="twinsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 hidden">
            <!-- Twin cards will be populated here by JS -->
        </div>
    </div>

    <script>
        // Set CSRF token from server
        window.csrfToken = '<%= csrfToken || "" %>';

        // Load chat history on page load
        async function loadChatHistory() {
            const loadingState = document.getElementById('loadingState');
            const emptyState = document.getElementById('emptyState');
            const twinsGrid = document.getElementById('twinsGrid');
            const statsCards = document.getElementById('statsCards');

            try {
                // Show loading
                loadingState.classList.remove('hidden');
                emptyState.classList.add('hidden');
                twinsGrid.classList.add('hidden');

                const response = await fetch('/api/public-chat/user/my-chats', {
                    credentials: 'include',
                    headers: {
                        'X-CSRF-Token': window.csrfToken
                    }
                });

                if (!response.ok) {
                    if (response.status === 401) {
                        // User not authenticated - show empty state
                        loadingState.classList.add('hidden');
                        emptyState.classList.remove('hidden');
                        statsCards.innerHTML = '';
                        return;
                    }
                    throw new Error('Failed to fetch chat history');
                }

                const data = await response.json();

                // Hide loading
                loadingState.classList.add('hidden');

                if (!data.success || !data.chats || data.chats.length === 0) {
                    // Show empty state
                    emptyState.classList.remove('hidden');
                    statsCards.innerHTML = '';
                    return;
                }

                // Calculate stats
                const totalTwins = data.chats.length;
                let totalChats = 0;
                let totalMessages = 0;

                // Count total chats and messages per twin
                // Note: API returns latest chat per twin, so we'll need to fetch detailed count
                // For now, we'll use messageCount from latest chat as estimate
                data.chats.forEach(({ latestChat }) => {
                    if (latestChat) {
                        totalChats++; // At least 1 chat per twin
                        totalMessages += latestChat.messageCount || 0;
                    }
                });

                // Render stats
                renderStats(totalTwins, totalChats, totalMessages);

                // Render twin cards
                renderTwinCards(data.chats);

                // Show grid
                emptyState.classList.add('hidden');
                twinsGrid.classList.remove('hidden');

            } catch (error) {
                console.error('Error loading chat history:', error);
                loadingState.classList.add('hidden');
                emptyState.classList.remove('hidden');
                statsCards.innerHTML = '';
            }
        }

        // Render stats cards
        function renderStats(totalTwins, totalChats, totalMessages) {
            const statsCards = document.getElementById('statsCards');
            statsCards.innerHTML = `
                <div class="bg-white/80 backdrop-blur-xl rounded-xl p-6 border border-white/20 shadow-lg">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-gradient-to-r from-primary/20 to-accent/20 rounded-lg flex items-center justify-center">
                            <span class="text-2xl">💬</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Total Twins</p>
                            <p class="text-2xl font-bold text-gray-900">${totalTwins}</p>
                        </div>
                    </div>
                </div>
                <div class="bg-white/80 backdrop-blur-xl rounded-xl p-6 border border-white/20 shadow-lg">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-gradient-to-r from-green-500/20 to-emerald-500/20 rounded-lg flex items-center justify-center">
                            <span class="text-2xl">📊</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Total Messages</p>
                            <p class="text-2xl font-bold text-gray-900">${totalMessages}</p>
                        </div>
                    </div>
                </div>
            `;
        }

        // Render twin cards
        function renderTwinCards(chats) {
            const twinsGrid = document.getElementById('twinsGrid');
            twinsGrid.innerHTML = '';

            chats.forEach(({ twin, latestChat, lastMessage }) => {
                const card = document.createElement('div');
                card.className = 'bg-white/80 backdrop-blur-xl rounded-xl p-6 border border-white/20 shadow-lg hover:shadow-xl transition-all duration-300 group';
                card.setAttribute('data-twin-id', twin.id);

                // Avatar initial
                const avatarInitial = (twin.publicHandle || 'T').charAt(0).toUpperCase();


                // Last message preview
                const lastMessagePreview = lastMessage?.content 
                    ? (lastMessage.content.length > 60 ? lastMessage.content.substring(0, 60) + '...' : lastMessage.content)
                    : 'Continue conversation...';

                card.innerHTML = `
                    <div class="flex items-center gap-4 mb-4">
                        <div class="relative flex-shrink-0">
                            <div class="w-16 h-16 bg-gradient-to-r from-primary to-accent rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg group-hover:scale-110 transition-transform">
                                ${twin.profileImage ? `<img src="${twin.profileImage}" alt="${twin.publicHandle}" class="w-16 h-16 rounded-full object-cover">` : avatarInitial}
                            </div>
                            <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 rounded-full border-2 border-white flex items-center justify-center">
                                <span class="text-xs text-white font-bold">${latestChat?.messageCount || 0}</span>
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-semibold text-gray-900 text-lg truncate">@${twin.publicHandle || 'twin'}</h3>
                                ${twin.verified ? '<span class="text-sm text-primary">✓</span>' : ''}
                            </div>
                            <p class="text-sm text-gray-500 line-clamp-1">${twin.bio || 'No bio available'}</p>
                        </div>
                    </div>
                    
                    ${latestChat ? `
                        <div class="mb-4 p-3 bg-gray-50/50 rounded-lg border border-gray-100">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-xs font-medium text-gray-700">Latest Chat</p>
                                <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">${latestChat.messageCount || 0} msgs</span>
                            </div>
                            <p class="text-sm text-gray-600 line-clamp-2">${lastMessagePreview}</p>
                        </div>
                    ` : ''}
                    
                    <button data-twin-id="${twin.id}"
                            class="continue-chat-btn w-full px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg hover:shadow-lg transition-all font-medium text-sm">
                        💬 Continue Chat
                    </button>
                `;

                // Add click listener to button after innerHTML
                const button = card.querySelector('.continue-chat-btn');
                if (button) {
                    button.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        window.location.href = `/public-twin/chat/${twin.id}`;
                    });
                }

                twinsGrid.appendChild(card);
            });
        }


        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadChatHistory();
        });
    </script>
</body>
</html>