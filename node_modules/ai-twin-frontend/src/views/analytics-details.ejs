<%
// Get server-side values BEFORE template string to avoid EJS parsing issues
const analyticsTypeValue = typeof type !== 'undefined' ? type : '';
const analyticsPageValue = typeof pagination !== 'undefined' && pagination.page ? pagination.page : 1;
const analyticsDataLength = typeof data !== 'undefined' && Array.isArray(data) ? data.length : 0;
const analyticsTotal = typeof pagination !== 'undefined' && pagination.total ? pagination.total : 0;
const analyticsLimit = typeof pagination !== 'undefined' && pagination.limit ? pagination.limit : 50;
%>

<%- include('layout', { 
    title: title, 
    user: user, 
    csrfToken: csrfToken, 
    body: include('partials/analytics-details-body', {
        analyticsTypeValue: analyticsTypeValue,
        analyticsPageValue: analyticsPageValue,
        analyticsDataLength: analyticsDataLength,
        analyticsTotal: analyticsTotal,
        analyticsLimit: analyticsLimit,
        data: data,
        pagination: pagination
    })    
}) %>

<!-- Hidden element to store server-side data (OUTSIDE template string) -->
<div id="analytics-data" data-type="<%= analyticsTypeValue %>" data-page="<%= analyticsPageValue %>" style="display: none;"></div>

<script>
    // Get data from hidden element
    const analyticsDataEl = document.getElementById('analytics-data');
    const analyticsTypeValue = analyticsDataEl ? analyticsDataEl.getAttribute('data-type') : '';
    const analyticsPageValue = analyticsDataEl ? parseInt(analyticsDataEl.getAttribute('data-page')) || 1 : 1;
    
    const urlParams = new URLSearchParams(window.location.search);
    const type = urlParams.get('type') || analyticsTypeValue;
    const twinId = urlParams.get('twinId') || '';
    let currentPage = analyticsPageValue;
    let currentSearch = urlParams.get('search') || '';
    
    function formatTime(date) {
        if (!date) return 'N/A';
        if (window.TimeUtils) {
            return window.TimeUtils.formatTimeWithContext(date);
        }
        const d = new Date(date);
        const diff = Date.now() - d.getTime();
        if (diff < 60000) return 'Just now';
        if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
        if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
        if (diff < 604800000) return Math.floor(diff / 86400000) + 'd ago';
        return window.TimeUtils ? window.TimeUtils.formatDateOnly(date) : d.toLocaleDateString();
    }
    // Change page
    function changePage(page) {
        if (page < 1) return;
        currentPage = page;
        loadData();
    }

    // Perform search
    function performSearch() {
        const searchInput = document.getElementById('searchInput');
        currentSearch = searchInput.value.trim();
        currentPage = 1;
        loadData();
    }

    // Clear search
    function clearSearch() {
        document.getElementById('searchInput').value = '';
        currentSearch = '';
        currentPage = 1;
        loadData();
    }

    // Load data
    async function loadData() {
        try {
            const params = new URLSearchParams({
                type: type,
                page: currentPage,
                limit: 50,
                search: currentSearch
            });
            
            if (twinId) {
                params.append('twinId', twinId);
            }

            // Update URL without reload
            window.history.pushState({}, '', '/analytics/details?' + params.toString());

            const response = await fetch('/analytics/details?' + params.toString(), {
                credentials: 'include'
            });

            if (response.ok) {
                // Reload page to show new data (server-side rendered)
                window.location.href = '/analytics/details?' + params.toString();
            } else {
                console.error('Failed to load data');
                alert('Failed to load data. Please try again.');
            }
        } catch (error) {
            console.error('Error loading data:', error);
            alert('Network error. Please try again.');
        }
    }

    // ✅ View user profile function
    function viewUserProfile(handleOrId) {
        if (!handleOrId) {
            alert('User information not available');
            return;
        }
        
        // If it's a handle (doesn't start with user_ or usr_), navigate directly
        if (handleOrId && !handleOrId.startsWith('user_') && !handleOrId.startsWith('usr_')) {
            window.location.href = `/user/${handleOrId}`;
        } else {
            // If it's an ID, we need to get handle first
            alert('Unable to view profile. User handle not available.');
        }
    }

    // Add event listeners for buttons
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const clearBtn = document.getElementById('clearBtn');
        
        if (searchInput) {
            searchInput.value = currentSearch;
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    performSearch();
                }
            });
        }
        
        if (searchBtn) {
            searchBtn.addEventListener('click', performSearch);
        }
        
        if (clearBtn) {
            clearBtn.addEventListener('click', clearSearch);
        }
        
        // Add event listeners for pagination buttons
        const paginationButtons = document.querySelectorAll('[data-page]');
        paginationButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                const page = parseInt(this.getAttribute('data-page'));
                if (!isNaN(page) && page > 0) {
                    changePage(page);
                }
            });
        });
        
        // ✅ FIX: Event delegation for user profile clicks
        const dataList = document.getElementById('dataList');
        if (dataList) {
            dataList.addEventListener('click', function(e) {
                // Find the closest user profile item
                const userItem = e.target.closest('.user-profile-item');
                if (userItem) {
                    const handle = userItem.getAttribute('data-user-handle');
                    if (handle) {
                        viewUserProfile(handle);
                    }
                }
            });
        }
    });
</script>