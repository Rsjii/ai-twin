<!-- Pagination Container -->
<div id="<%= containerId %>" class="<%= typeof className !== 'undefined' ? className : 'mt-8' %>"></div>

<!-- Pagination Script -->
<script src="/utils/pagination.js"></script>
<script>
    (function() {
        const paginationVarName = '<%= containerId %>Pagination';
        const loadFunctionName = '<%= loadFunction %>';
        const scrollToTop = <%= typeof scrollToTop !== 'undefined' ? scrollToTop : true %>;
        const containerId = '<%= containerId %>';
        
        if (!window.paginationInstances) {
            window.paginationInstances = {};
        }
        
        function waitForPagination(callback) {
            if (typeof Pagination !== 'undefined') {
                callback();
            } else {
                setTimeout(() => waitForPagination(callback), 100);
            }
        }
        
        window['init' + containerId.charAt(0).toUpperCase() + containerId.slice(1) + 'Pagination'] = function(paginationData) {
            waitForPagination(() => {
                const container = document.getElementById(containerId);
                if (!container || !paginationData?.pagination) {
                    return;
                }
                
                const pagination = window.paginationInstances[paginationVarName];
                
                if (!pagination) {
                    window.paginationInstances[paginationVarName] = new Pagination({
                        container: container,
                        currentPage: paginationData.pagination.currentPage || 1,
                        totalPages: paginationData.pagination.totalPages || 1,
                        totalItems: paginationData.pagination.totalItems || 0,
                        itemsPerPage: paginationData.pagination.itemsPerPage || 10,
                        onPageChange: (page) => {
                            if (typeof window[loadFunctionName] === 'function') {
                                window[loadFunctionName](page);
                            }
                            if (scrollToTop) {
                                window.scrollTo({ top: 0, behavior: 'smooth' });
                            }
                        }
                    });
                    window.paginationInstances[paginationVarName].render();
                } else {
                    pagination.update({
                        currentPage: paginationData.pagination.currentPage || 1,
                        totalPages: paginationData.pagination.totalPages || 1,
                        totalItems: paginationData.pagination.totalItems || 0
                    });
                }
            });
        };
        
        window['destroy' + containerId.charAt(0).toUpperCase() + containerId.slice(1) + 'Pagination'] = function() {
            const pagination = window.paginationInstances[paginationVarName];
            if (pagination) {
                pagination.destroy();
                delete window.paginationInstances[paginationVarName];
            }
        };
    })();
</script>
