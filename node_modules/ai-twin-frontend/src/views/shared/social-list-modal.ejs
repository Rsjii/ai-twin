<!-- Social List Modal -->
<div id="socialListModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" id="socialListModalBackdrop"></div>
        
        <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 id="socialListModalTitle" class="text-lg font-semibold text-gray-900 dark:text-white"></h3>
                    <button id="closeSocialListModal" class="text-gray-400 hover:text-gray-500 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <div id="socialListContent" class="max-h-96 overflow-y-auto">
                    <!-- List will be populated here -->
                </div>
                <!-- View Details Button (only for analytics page) -->
                <div id="viewDetailsBtnContainer" class="hidden mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <button id="viewDetailsBtn" class="w-full bg-primary text-white px-4 py-2 rounded-lg hover:bg-secondary transition-colors">
                        View Full Details →
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Ensure function is available globally - define it immediately
    (function() {
        'use strict';
        
        // Format date helper
        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            const now = new Date();
            const diff = now - date;
            
            if (diff < 60000) return 'Just now';
            if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
            if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
            return date.toLocaleDateString();
        }
        
        // Main function - make it global immediately
        window.showSocialList = async function(twinId, type, showDetailsBtn = false) {
            console.log('showSocialList called:', twinId, type, showDetailsBtn); // Debug
            
            const modal = document.getElementById('socialListModal');
            const title = document.getElementById('socialListModalTitle');
            const content = document.getElementById('socialListContent');
            const detailsBtnContainer = document.getElementById('viewDetailsBtnContainer');
            
            if (!modal || !title || !content) {
                console.error('Modal elements not found', { modal, title, content });
                alert('Modal not found. Please refresh the page.');
                return;
            }
            
            if (!twinId) {
                alert('Twin ID not available');
                return;
            }
            
            // Show/hide details button based on page
            if (showDetailsBtn && detailsBtnContainer) {
                detailsBtnContainer.classList.remove('hidden');
                const viewDetailsBtn = document.getElementById('viewDetailsBtn');
                if (viewDetailsBtn) {
                    viewDetailsBtn.onclick = () => {
                        // ✅ Simple: Always redirect to analytics page first
                        // User can then click on the card to see details
                        window.location.href = `/analytics`;
                    };
                }
            } else if (detailsBtnContainer) {
                detailsBtnContainer.classList.add('hidden');
            }
            
            // Set title
            const titles = {
                'likers': 'Users who liked this twin',
                'followers': 'Users following this twin',
                'chatters': 'Users who chatted with this twin'
            };
            title.textContent = titles[type] || type;
            
            // Show loading
            content.innerHTML = '<div class="text-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto"></div><p class="mt-2 text-gray-500">Loading...</p></div>';
            modal.classList.remove('hidden');
            
            try {
                const endpoint = `/api/social/twin/${twinId}/${type}`;
                console.log('Fetching from:', endpoint); // Debug
                const response = await fetch(endpoint, { 
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                
                const result = await response.json();
                console.log('Response:', result); // Debug
                
                if (result.success || result[type] || result.chatters) {
                    const list = result[type] || result.chatters || [];
                    
                    if (list.length === 0) {
                        content.innerHTML = `<p class="text-center text-gray-500 dark:text-gray-400 py-8">No ${type} yet</p>`;
                    } else {
                        content.innerHTML = list.map(user => {
                            const date = user.likedAt || user.followedAt || user.lastChatAt;
                            return `
                                <div class="flex items-center py-3 border-b border-gray-200 dark:border-gray-700 last:border-0">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold mr-3 overflow-hidden">
                                        ${user.profileImage ? 
                                            `<img src="${user.profileImage}" alt="${user.name || ''}" class="w-full h-full rounded-full object-cover">` :
                                            `<span>${(user.name || user.handle || 'U').charAt(0).toUpperCase()}</span>`
                                        }
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-medium text-gray-900 dark:text-white">${user.name || 'Anonymous'}</p>
                                        ${user.handle ? `<p class="text-sm text-gray-500 dark:text-gray-400">@${user.handle}</p>` : ''}
                                    </div>
                                    ${date ? `<p class="text-xs text-gray-400 dark:text-gray-500">${formatDate(date)}</p>` : ''}
                                </div>
                            `;
                        }).join('');
                    }
                } else {
                    content.innerHTML = `<p class="text-center text-red-500 py-8">Error: ${result.error || 'Failed to load'}</p>`;
                }
            } catch (error) {
                console.error('Error loading social list:', error);
                content.innerHTML = `<p class="text-center text-red-500 py-8">Error: ${error.message || 'Network error'}</p>`;
            }
        };
        
    })();
    
    // Make function available globally for inline onclick handlers
    if (typeof window.showSocialList === 'function') {
        var showSocialList = window.showSocialList;
    }
    
    // Close modal function - make it reusable
    function closeSocialListModal() {
        const modal = document.getElementById('socialListModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    }
    
    // Setup close handlers using event delegation (works even if modal is added dynamically)
    function setupModalHandlers() {
        // Close button handler
        const closeBtn = document.getElementById('closeSocialListModal');
        if (closeBtn) {
            closeBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeSocialListModal();
            });
        }
        
        // Backdrop click handler
        const backdrop = document.getElementById('socialListModalBackdrop');
        if (backdrop) {
            backdrop.addEventListener('click', function(e) {
                if (e.target === backdrop) {
                    closeSocialListModal();
                }
            });
        }
        
        // ESC key handler
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('socialListModal');
                if (modal && !modal.classList.contains('hidden')) {
                    closeSocialListModal();
                }
            }
        });
    }   
    
    // Setup handlers when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupModalHandlers);
    } else {
        setupModalHandlers();
    }
</script>