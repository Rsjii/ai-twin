                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Agreeableness Questions -->
                                    <div class="border-l-4 border-purple-500 pl-4">
                                        <h4 class="font-medium text-gray-800 mb-3">Agreeableness</h4>
                                        <div class="space-y-4">
