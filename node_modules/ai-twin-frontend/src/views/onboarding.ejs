<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Your AI Twin - Onboarding</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444',
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .step-active {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
        }
        .step-completed {
            background: #10b981;
            color: white;
        }
        .step-pending {
            background: #e5e7eb;
            color: #6b7280;
        }
        .personality-chart {
            max-width: 300px;
            margin: 0 auto;
        }
        .tone-slider {
            -webkit-appearance: none;
            appearance: none;
            height: 8px;
            border-radius: 5px;
            background: #e5e7eb;
            outline: none;
        }
        .tone-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #6366f1;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(99, 102, 241, 0.3);
        }
        .tone-slider::-moz-range-thumb {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #6366f1;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 8px rgba(99, 102, 241, 0.3);
        }
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen font-inter">
    <!-- Header -->
    <header class="bg-white/80 backdrop-blur-xl border-b border-white/20 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <a href="/" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" stroke="currentColor" fill="none">
                                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </a>
                </div>
                
                <!-- Progress Indicator -->
                <div class="hidden md:flex items-center space-x-2">
                    <span class="text-sm text-gray-600">Step <span id="currentStepNumber">1</span> of 7</span>
                    <div class="w-32 h-2 bg-gray-200 rounded-full overflow-hidden">
                        <div id="progressBar" class="h-full bg-gradient-to-r from-primary to-accent transition-all duration-500" style="width: 14.28%"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="px-4 py-8 sm:px-0">
        <div class="max-w-4xl mx-auto">
            <!-- Progress Steps -->
            <div class="mb-8">
                <div class="flex items-center justify-center space-x-2 md:space-x-4 overflow-x-auto pb-4">
                    <div class="flex items-center space-x-2">
                        <div id="step1" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-active">1</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Basic Info</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step2" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">2</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Personality</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step3" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">3</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Tone</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step4" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">4</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Language</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step5" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">5</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Context</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step6" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">6</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Samples</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step7" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">7</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Preview</span>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 p-8">
                <form id="onboardingForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <!-- Step 1: Basic Information -->
                    <div id="step1-content" class="step-content fade-in">
                        <div class="mb-8">
                            <h1 class="text-3xl font-bold text-gray-900 mb-2">Let's Get Started!</h1>
                            <p class="text-gray-600">Tell us a bit about yourself to create your perfect AI twin.</p>
                        </div>

                        <div class="space-y-6">
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Full Name *</label>
                                    <input type="text" id="fullName" name="fullName" required
                                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                           placeholder="Enter your full name">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Username *</label>
                                    <input type="text" id="username" name="username" required
                                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                           placeholder="Choose a unique username">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Short Bio *</label>
                                <textarea id="bio" name="bio" required rows="3"
                                          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                          placeholder="Tell us about yourself in 50-150 characters"></textarea>
                                <p class="text-sm text-gray-500 mt-1"><span id="bioCount">0</span>/150 characters</p>
                            </div>

                            <div class="grid md:grid-cols-3 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Age Range *</label>
                                    <select id="ageRange" name="ageRange" required
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200">
                                        <option value="">Select age range</option>
                                        <option value="18-25">18-25</option>
                                        <option value="26-35">26-35</option>
                                        <option value="36-45">36-45</option>
                                        <option value="46-55">46-55</option>
                                        <option value="55+">55+</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Profession *</label>
                                    <select id="profession" name="profession" required
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200">
                                        <option value="">Select profession</option>
                                        <option value="Technology">Technology</option>
                                        <option value="Healthcare">Healthcare</option>
                                        <option value="Education">Education</option>
                                        <option value="Business">Business</option>
                                        <option value="Finance">Finance</option>
                                        <option value="Creative">Creative</option>
                                        <option value="Marketing">Marketing</option>
                                        <option value="Sales">Sales</option>
                                        <option value="Student">Student</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Location *</label>
                                    <select id="location" name="location" required
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200">
                                        <option value="">Select location</option>
                                        <option value="North America">North America</option>
                                        <option value="Europe">Europe</option>
                                        <option value="Asia">Asia</option>
                                        <option value="South America">South America</option>
                                        <option value="Africa">Africa</option>
                                        <option value="Oceania">Oceania</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Personality Assessment -->
                    <div id="step2-content" class="step-content hidden">
                        <div class="mb-8">
                            <h1 class="text-3xl font-bold text-gray-900 mb-2">Personality Assessment</h1>
                            <p class="text-gray-600">Help us understand your personality through these questions.</p>
                        </div>

                        <div class="space-y-8">
                            <!-- OCEAN Questions -->
                            <div class="bg-gray-50 rounded-xl p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Personality Traits</h3>
                                <div class="space-y-6">
                                    <!-- Openness Questions -->
                                    <div class="border-l-4 border-blue-500 pl-4">
                                        <h4 class="font-medium text-gray-800 mb-3">Openness to Experience</h4>
                                        <div class="space-y-4">
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I enjoy trying new foods and cuisines from different cultures</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness1" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness1" value="2" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness1" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness1" value="4" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness1" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I often daydream and imagine creative scenarios</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness2" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness2" value="2" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness2" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness2" value="4" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness2" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I prefer traditional methods over new, experimental approaches</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness3" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness3" value="4" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness3" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness3" value="2" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="openness3" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Conscientiousness Questions -->
                                    <div class="border-l-4 border-green-500 pl-4">
                                        <h4 class="font-medium text-gray-800 mb-3">Conscientiousness</h4>
                                        <div class="space-y-4">
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I always plan my day and stick to my schedule</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness1" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness1" value="2" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness1" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness1" value="4" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness1" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I often leave tasks until the last minute</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness2" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness2" value="4" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness2" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness2" value="2" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness2" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I pay attention to details and rarely make careless mistakes</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness3" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness2" value="2" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness3" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness3" value="4" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="conscientiousness3" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Extraversion Questions -->
                                    <div class="border-l-4 border-yellow-500 pl-4">
                                        <h4 class="font-medium text-gray-800 mb-3">Extraversion</h4>
                                        <div class="space-y-4">
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I feel energized after spending time with large groups of people</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion1" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion1" value="2" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion1" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion1" value="4" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion1" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I prefer quiet evenings at home over going to parties</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion2" value="5" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion2" value="4" class="mr-2">
                                                        <span class="text-sm">Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion2" value="3" class="mr-2">
                                                        <span class="text-sm">Neutral</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion2" value="2" class="mr-2">
                                                        <span class="text-sm">Agree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion2" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Agree</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="question-group">
                                                <p class="text-sm text-gray-700 mb-2">I enjoy being the center of attention in social situations</p>
                                                <div class="flex space-x-4">
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion3" value="1" class="mr-2">
                                                        <span class="text-sm">Strongly Disagree</span>
                                                    </label>
                                                    <label class="flex items-center">
                                                        <input type="radio" name="extraversion3" value="2" class="mr-2">
