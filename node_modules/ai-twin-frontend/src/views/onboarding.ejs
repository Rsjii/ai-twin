    <script>
        // Global variables
        let currentStep = 1;
        const totalSteps = 7;
        let onboardingData = {};
        let personalityChart = null;

        // Initialize the onboarding flow
        document.addEventListener('DOMContentLoaded', function() {
            initializeOnboarding();
            setupEventListeners();
            updateProgress();
        });

        function initializeOnboarding() {
            // Show first step
            showStep(1);
            
            // Initialize bio character counter
            const bioTextarea = document.getElementById('bio');
            const bioCount = document.getElementById('bioCount');
            
            bioTextarea.addEventListener('input', function() {
                bioCount.textContent = this.value.length;
            });

            // Initialize tone sliders
            initializeToneSliders();
        }

        function setupEventListeners() {
            // Navigation buttons
            document.getElementById('nextBtn').addEventListener('click', nextStep);
            document.getElementById('prevBtn').addEventListener('click', prevStep);

            // Form submission
            document.getElementById('onboardingForm').addEventListener('submit', handleFormSubmission);

            // Sample category selection
            document.querySelectorAll('input[name="sampleCategories"]').forEach(checkbox => {
                checkbox.addEventListener('change', handleSampleCategoryChange);
            });

            // Add sample button
            document.getElementById('addSampleBtn').addEventListener('click', addSampleInput);

            // Skip samples button
            document.getElementById('skipSamplesBtn').addEventListener('click', skipSamples);

            // Regenerate response button
            document.getElementById('regenerateResponseBtn').addEventListener('click', regenerateSampleResponse);

            // Edit settings button
            document.getElementById('editSettingsBtn').addEventListener('click', editSettings);
        }

        function initializeToneSliders() {
            const sliders = [
                'formalCasual', 'seriousPlayful', 'directDiplomatic',
                'enthusiasticReserved', 'technicalSimple', 'warmProfessional'
            ];

            sliders.forEach(sliderId => {
                const slider = document.getElementById(sliderId);
                const valueSpan = document.getElementById(sliderId.replace(/([A-Z])/g, '$1').toLowerCase() + 'Value');
                
                slider.addEventListener('input', function() {
                    valueSpan.textContent = this.value;
                });
            });
        }

        function showStep(step) {
            // Hide all step contents
            document.querySelectorAll('.step-content').forEach(content => {
                content.classList.add('hidden');
            });

            // Show current step content
            document.getElementById(`step${step}-content`).classList.remove('hidden');
            document.getElementById(`step${step}-content`).classList.add('fade-in');

            // Update step indicators
            for (let i = 1; i <= totalSteps; i++) {
                const stepElement = document.getElementById(`step${i}`);
                if (i < step) {
                    stepElement.className = 'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-completed';
                } else if (i === step) {
                    stepElement.className = 'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-active';
                } else {
                    stepElement.className = 'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending';
                }
            }

            // Update navigation buttons
            updateNavigationButtons(step);
        }

        function updateNavigationButtons(step) {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            // Show/hide previous button
            if (step > 1) {
                prevBtn.classList.remove('hidden');
            } else {
                prevBtn.classList.add('hidden');
            }

            // Update next button text
            if (step === totalSteps) {
                nextBtn.textContent = 'Create My AI Twin';
                nextBtn.type = 'submit';
            } else {
                nextBtn.textContent = 'Next →';
                nextBtn.type = 'button';
            }
        }

        function updateProgress() {
            const progress = (currentStep / totalSteps) * 100;
            document.getElementById('progressBar').style.width = `${progress}%`;
            document.getElementById('currentStepNumber').textContent = currentStep;
        }

        function nextStep() {
            if (validateCurrentStep()) {
                saveCurrentStepData();
                
                if (currentStep < totalSteps) {
                    currentStep++;
                    showStep(currentStep);
                    updateProgress();
                    
                    // Special handling for step 7 (preview)
                    if (currentStep === 7) {
                        generatePreview();
                    }
                }
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                showStep(currentStep);
                updateProgress();
            }
        }

        function validateCurrentStep() {
            switch (currentStep) {
                case 1:
                    return validateBasicInfo();
                case 2:
                    return validatePersonalityAssessment();
                case 3:
                    return validateTonePreferences();
                case 4:
                    return validateLanguagePreferences();
                case 5:
                    return validateContextInfo();
                case 6:
                    return true; // Optional step
                case 7:
                    return true; // Preview step
                default:
                    return true;
            }
        }

        function validateBasicInfo() {
            const requiredFields = ['fullName', 'username', 'bio', 'ageRange', 'profession', 'location'];
            let isValid = true;

            requiredFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (!field.value.trim()) {
                    field.classList.add('border-red-500');
                    isValid = false;
                } else {
                    field.classList.remove('border-red-500');
                }
            });

            // Validate bio length
            const bio = document.getElementById('bio');
            if (bio.value.length < 50 || bio.value.length > 150) {
                bio.classList.add('border-red-500');
                isValid = false;
            }

            if (!isValid) {
                showMessage('Please fill in all required fields correctly.', 'error');
            }

            return isValid;
        }

        function validatePersonalityAssessment() {
            const requiredQuestions = [
                'openness1', 'openness2', 'openness3',
                'conscientiousness1', 'conscientiousness2', 'conscientiousness3',
                'extraversion1', 'extraversion2', 'extraversion3',
                'agreeableness1', 'agreeableness2', 'agreeableness3',
                'neuroticism1', 'neuroticism2', 'neuroticism3',
                'formality', 'casual', 'humor', 'directness'
            ];

            let isValid = true;
            requiredQuestions.forEach(questionName => {
                if (!document.querySelector(`input[name="${questionName}"]:checked`)) {
                    isValid = false;
                }
            });

            if (!isValid) {
                showMessage('Please answer all personality questions.', 'error');
            }

            return isValid;
        }

        function validateTonePreferences() {
            // Tone sliders are always valid (have default values)
            return true;
        }

        function validateLanguagePreferences() {
            const requiredFields = ['greetingStyle', 'closingStyle', 'punctuationStyle', 'vocabularyLevel'];
            let isValid = true;

            console.log('Validating language preferences...');

            // Check select fields
            requiredFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                console.log(`Field ${fieldId}:`, field ? field.value : 'NOT FOUND');
                if (!field || !field.value) {
                    if (field) field.classList.add('border-red-500');
                    isValid = false;
                } else {
                    field.classList.remove('border-red-500');
                }
            });

            // Check slangUsage radio buttons
            const slangUsageSelected = document.querySelector('input[name="slangUsage"]:checked');
            console.log('Slang usage selected:', slangUsageSelected ? slangUsageSelected.value : 'NONE');
            if (!slangUsageSelected) {
                isValid = false;
                showMessage('Please select your slang usage preference.', 'error');
            }

            console.log('Language validation result:', isValid);

            if (!isValid) {
                showMessage('Please select all language preferences.', 'error');
            }

            return isValid;
        }

        function validateContextInfo() {
            const interests = document.querySelectorAll('input[name="interests"]:checked');
            const primaryUseCase = document.getElementById('primaryUseCase');
            const targetAudience = document.getElementById('targetAudience');

            let isValid = true;

            if (interests.length < 3) {
                showMessage('Please select at least 3 interests.', 'error');
                isValid = false;
            }

            if (!primaryUseCase.value || !targetAudience.value) {
                showMessage('Please select your primary use case and target audience.', 'error');
                isValid = false;
            }

            return isValid;
        }

        function saveCurrentStepData() {
            switch (currentStep) {
                case 1:
                    saveBasicInfo();
                    break;
                case 2:
                    savePersonalityData();
                    break;
                case 3:
                    saveToneData();
                    break;
                case 4:
                    saveLanguageData();
                    break;
                case 5:
                    saveContextData();
                    break;
                case 6:
                    saveSampleData();
                    break;
            }
        }

        function saveBasicInfo() {
            onboardingData.basicInfo = {
                fullName: document.getElementById('fullName').value,
                username: document.getElementById('username').value,
                bio: document.getElementById('bio').value,
                ageRange: document.getElementById('ageRange').value,
                profession: document.getElementById('profession').value,
                location: document.getElementById('location').value
            };
        }

        function savePersonalityData() {
            console.log('Saving personality data...');
            
            // OCEAN scores
            const oceanScores = {
                openness: calculateOCEANScore(['openness1', 'openness2', 'openness3']),
                conscientiousness: calculateOCEANScore(['conscientiousness1', 'conscientiousness2', 'conscientiousness3']),
                extraversion: calculateOCEANScore(['extraversion1', 'extraversion2', 'extraversion3']),
                agreeableness: calculateOCEANScore(['agreeableness1', 'agreeableness2', 'agreeableness3']),
                neuroticism: calculateOCEANScore(['neuroticism1', 'neuroticism2', 'neuroticism3'])
            };

            // Communication style scores
            const communicationStyle = {
                formality: parseInt(document.querySelector('input[name="formality"]:checked')?.value || 3),
                casual: parseInt(document.querySelector('input[name="casual"]:checked')?.value || 3),
                humor: parseInt(document.querySelector('input[name="humor"]:checked')?.value || 3),
                directness: parseInt(document.querySelector('input[name="directness"]:checked')?.value || 3)
            };

            console.log('OCEAN scores:', oceanScores);
            console.log('Communication style:', communicationStyle);

            onboardingData.personality = {
                ocean: oceanScores,
                communicationStyle: communicationStyle
            };
            
            console.log('Saved personality data:', onboardingData.personality);
        }

        function calculateOCEANScore(questionNames) {
            let total = 0;
            let count = 0;
            
            console.log(`Calculating OCEAN score for: ${questionNames.join(', ')}`);
            
            questionNames.forEach(questionName => {
                const selected = document.querySelector(`input[name="${questionName}"]:checked`);
                console.log(`${questionName}:`, selected ? selected.value : 'NOT SELECTED');
                if (selected) {
                    total += parseInt(selected.value);
                    count++;
                }
            });
            
            const score = count > 0 ? total / count : 3; // Default to neutral if no answers
            console.log(`Final score: ${score} (total: ${total}, count: ${count})`);
            return score;
        }

        function saveToneData() {
            const toneSliders = [
                'formalCasual', 'seriousPlayful', 'directDiplomatic',
                'enthusiasticReserved', 'technicalSimple', 'warmProfessional'
            ];

            const tone = {};
            toneSliders.forEach(sliderId => {
                const slider = document.getElementById(sliderId);
                tone[sliderId] = parseInt(slider.value);
            });

            // Communication scenarios
            const scenarios = {
                greetingStyle: document.querySelector('input[name="greetingStyle"]:checked')?.value,
                badNewsStyle: document.querySelector('input[name="badNewsStyle"]:checked')?.value,
                excitementStyle: document.querySelector('input[name="excitementStyle"]:checked')?.value
            };

            onboardingData.tone = {
                sliders: tone,
                scenarios: scenarios
            };
        }

        function saveLanguageData() {
            onboardingData.language = {
                greetingStyle: document.getElementById('greetingStyle').value,
                closingStyle: document.getElementById('closingStyle').value,
                punctuationStyle: document.getElementById('punctuationStyle').value,
                vocabularyLevel: document.getElementById('vocabularyLevel').value,
                slangUsage: document.querySelector('input[name="slangUsage"]:checked')?.value
            };
        }

        function saveContextData() {
            const interests = Array.from(document.querySelectorAll('input[name="interests"]:checked'))
                .map(checkbox => checkbox.value);

            onboardingData.context = {
                interests: interests,
                primaryUseCase: document.getElementById('primaryUseCase').value,
                targetAudience: document.getElementById('targetAudience').value
            };
        }

        function saveSampleData() {
            const selectedCategories = Array.from(document.querySelectorAll('input[name="sampleCategories"]:checked'))
                .map(checkbox => checkbox.value);

            const samples = [];
            document.querySelectorAll('.sample-input').forEach(input => {
                if (input.value.trim()) {
                    samples.push({
                        category: input.dataset.category,
                        content: input.value.trim()
                    });
                }
            });

            onboardingData.samples = {
                categories: selectedCategories,
                content: samples
            };
        }

        function handleSampleCategoryChange() {
            const selectedCategories = Array.from(document.querySelectorAll('input[name="sampleCategories"]:checked'))
                .map(checkbox => checkbox.value);

            const sampleCollection = document.getElementById('sampleCollection');
            const sampleInputs = document.getElementById('sampleInputs');

            if (selectedCategories.length > 0) {
                sampleCollection.classList.remove('hidden');
                generateSampleInputs(selectedCategories);
            } else {
                sampleCollection.classList.add('hidden');
            }
        }

        function generateSampleInputs(categories) {
            const sampleInputs = document.getElementById('sampleInputs');
            sampleInputs.innerHTML = '';

            categories.forEach(category => {
                const categoryDiv = document.createElement('div');
                categoryDiv.className = 'space-y-2';
                
                const label = document.createElement('label');
                label.className = 'block text-sm font-medium text-gray-700';
                label.textContent = getCategoryLabel(category);
                
                const textarea = document.createElement('textarea');
                textarea.className = 'sample-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent';
                textarea.rows = 3;
                textarea.placeholder = `Enter your ${getCategoryLabel(category).toLowerCase()} sample...`;
                textarea.dataset.category = category;
                
                categoryDiv.appendChild(label);
                categoryDiv.appendChild(textarea);
                sampleInputs.appendChild(categoryDiv);
            });
        }

        function getCategoryLabel(category) {
            const labels = {
                'social-media': 'Social Media Posts',
                'emails': 'Email Communications',
                'messages': 'Text Messages',
                'professional': 'Professional Writing',
                'creative': 'Creative Writing'
            };
            return labels[category] || category;
        }

        function addSampleInput() {
            const selectedCategories = Array.from(document.querySelectorAll('input[name="sampleCategories"]:checked'))
                .map(checkbox => checkbox.value);

            if (selectedCategories.length === 0) {
                showMessage('Please select at least one category first.', 'error');
                return;
            }

            // Add another input for the first selected category
            const firstCategory = selectedCategories[0];
            const sampleInputs = document.getElementById('sampleInputs');
            
            const categoryDiv = document.createElement('div');
            categoryDiv.className = 'space-y-2';
            
            const label = document.createElement('label');
            label.className = 'block text-sm font-medium text-gray-700';
            label.textContent = getCategoryLabel(firstCategory) + ' (Additional)';
            
            const textarea = document.createElement('textarea');
            textarea.className = 'sample-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent';
            textarea.rows = 3;
            textarea.placeholder = `Enter another ${getCategoryLabel(firstCategory).toLowerCase()} sample...`;
            textarea.dataset.category = firstCategory;
            
            categoryDiv.appendChild(label);
            categoryDiv.appendChild(textarea);
            sampleInputs.appendChild(categoryDiv);
        }

        function skipSamples() {
            onboardingData.samples = {
                categories: [],
                content: []
            };
            nextStep();
        }

        function generatePreview() {
            console.log('Generating preview...');
            console.log('onboardingData:', onboardingData);
            
            // Generate personality chart
            generatePersonalityChart();
            
            // Generate communication summary
            generateCommunicationSummary();
            
            // Generate sample response
            generateSampleResponse();
        }

        function generatePersonalityChart() {
            const ctx = document.getElementById('personalityChart').getContext('2d');
            
            if (personalityChart) {
                personalityChart.destroy();
            }

            const oceanData = onboardingData.personality?.ocean || {};
            console.log('Personality data for chart:', oceanData);
            const data = {
                labels: ['Openness', 'Conscientiousness', 'Extraversion', 'Agreeableness', 'Neuroticism'],
                datasets: [{
                    label: 'Personality Traits',
                    data: [
                        oceanData.openness || 3,
                        oceanData.conscientiousness || 3,
                        oceanData.extraversion || 3,
                        oceanData.agreeableness || 3,
                        oceanData.neuroticism || 3
                    ],
                    backgroundColor: [
                        'rgba(99, 102, 241, 0.2)',
                        'rgba(16, 185, 129, 0.2)',
                        'rgba(245, 158, 11, 0.2)',
                        'rgba(139, 92, 246, 0.2)',
                        'rgba(239, 68, 68, 0.2)'
                    ],
                    borderColor: [
                        'rgba(99, 102, 241, 1)',
                        'rgba(16, 185, 129, 1)',
                        'rgba(245, 158, 11, 1)',
                        'rgba(139, 92, 246, 1)',
                        'rgba(239, 68, 68, 1)'
                    ],
                    borderWidth: 2
                }]
            };

            personalityChart = new Chart(ctx, {
                type: 'radar',
                data: data,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            beginAtZero: true,
                            max: 5,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });

            // Generate personality traits display
            generatePersonalityTraits(oceanData);
        }

        function generatePersonalityTraits(oceanData) {
            const traitsDiv = document.getElementById('personalityTraits');
            const traits = [
                { name: 'Openness', value: oceanData.openness || 3, color: 'bg-blue-500' },
                { name: 'Conscientiousness', value: oceanData.conscientiousness || 3, color: 'bg-green-500' },
                { name: 'Extraversion', value: oceanData.extraversion || 3, color: 'bg-yellow-500' },
                { name: 'Agreeableness', value: oceanData.agreeableness || 3, color: 'bg-purple-500' },
                { name: 'Neuroticism', value: oceanData.neuroticism || 3, color: 'bg-red-500' }
            ];

            let traitsHTML = '';
            traits.forEach(trait => {
                const percentage = (trait.value / 5) * 100;
                traitsHTML += `
                    <div class="text-center">
                        <div class="text-sm font-medium text-gray-700 mb-1">${trait.name}</div>
                        <div class="w-full bg-gray-200 rounded-full h-2 mb-1">
                            <div class="${trait.color} h-2 rounded-full transition-all duration-500" style="width: ${percentage}%"></div>
                        </div>
                        <div class="text-xs text-gray-500">${trait.value.toFixed(1)}/5</div>
                    </div>
                `;
            });

            traitsDiv.innerHTML = traitsHTML;
        }

        function generateCommunicationSummary() {
            const summaryDiv = document.getElementById('communicationSummary');
            const tone = onboardingData.tone?.sliders || {};
            const language = onboardingData.language || {};

            let summaryHTML = '';

            // Tone summary
            if (tone.formalCasual !== undefined) {
                const formality = tone.formalCasual > 50 ? 'Formal' : 'Casual';
                summaryHTML += `<div class="flex justify-between items-center p-2 bg-white rounded-lg">
                    <span class="text-sm font-medium">Communication Style:</span>
                    <span class="text-sm text-primary">${formality}</span>
                </div>`;
            }

            // Language preferences
            if (language.vocabularyLevel) {
                summaryHTML += `<div class="flex justify-between items-center p-2 bg-white rounded-lg">
                    <span class="text-sm font-medium">Vocabulary Level:</span>
                    <span class="text-sm text-primary">${language.vocabularyLevel}</span>
                </div>`;
            }

            if (language.slangUsage) {
                summaryHTML += `<div class="flex justify-between items-center p-2 bg-white rounded-lg">
                    <span class="text-sm font-medium">Slang Usage:</span>
                    <span class="text-sm text-primary">${language.slangUsage}</span>
                </div>`;
            }

            summaryDiv.innerHTML = summaryHTML;
        }

        function generateSampleResponse() {
            const sampleResponseDiv = document.getElementById('sampleResponse');
            sampleResponseDiv.textContent = 'Generating sample response...';

            // Simulate API call to generate sample response
            setTimeout(() => {
                const responses = [
                    "Hey there! I'm doing great, thanks for asking! How about you?",
                    "Hello! I'm doing well, thank you. How are you doing today?",
                    "Hi! I'm fantastic, thanks! What's new with you?",
                    "Hey! I'm doing awesome! How's your day going?",
                    "Hello there! I'm doing wonderful, thank you. How are you?"
                ];
                
                const randomResponse = responses[Math.floor(Math.random() * responses.length)];
                sampleResponseDiv.textContent = randomResponse;
            }, 1500);
        }

        function regenerateSampleResponse() {
            generateSampleResponse();
        }

        function editSettings() {
            // Go back to step 1 to edit settings
            currentStep = 1;
            showStep(currentStep);
            updateProgress();
        }

        function handleFormSubmission(e) {
            e.preventDefault();
            
            if (currentStep === totalSteps) {
                createAITwin();
            }
        }

        function createAITwin() {
            const createBtn = document.getElementById('createTwinBtn');
            const originalText = createBtn.textContent;
            
            createBtn.textContent = 'Creating Your AI Twin...';
            createBtn.disabled = true;

            // Prepare data for API
            const twinData = {
                ...onboardingData,
                onboardingCompleted: true,
                completedAt: new Date().toISOString()
            };

            fetch('/api/onboarding/create-enhanced-twin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
                },
                credentials: 'include',
                body: JSON.stringify(twinData)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showMessage('Your AI Twin has been created successfully!', 'success');
                    setTimeout(() => {
                        window.location.href = '/dashboard';
                    }, 2000);
                } else {
                    showMessage(result.error || 'Failed to create AI Twin', 'error');
                }
            })
            .catch(error => {
                console.error('Error creating twin:', error);
                showMessage('Network error. Please try again.', 'error');
            })
            .finally(() => {
                createBtn.textContent = originalText;
                createBtn.disabled = false;
            });
        }

        function showMessage(message, type = 'info') {
            // Create message element
            const messageDiv = document.createElement('div');
            messageDiv.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            messageDiv.textContent = message;

            document.body.appendChild(messageDiv);

            // Remove message after 5 seconds
            setTimeout(() => {
                messageDiv.remove();
            }, 5000);
        }
    </script>
</body>
</html>