<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Discover AI Twins - Twinverse</title>
    <link rel="stylesheet" href="/css/output.css">
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
        <style>
            .gradient-text {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            
            /* ✅ PHASE 1: Enhanced Discover Page Styles */
            .twin-card {
                min-height: 320px;
                display: flex;
                flex-direction: column;
                background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.85) 100%);
                border: 1px solid rgba(99, 102, 241, 0.1);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            
            .dark .twin-card {
                background: linear-gradient(135deg, rgba(31, 41, 55, 0.95) 0%, rgba(17, 24, 39, 0.85) 100%);
                border-color: rgba(99, 102, 241, 0.2);
            }
            
            .twin-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.2), 0 10px 10px -5px rgba(99, 102, 241, 0.1);
                border-color: rgba(99, 102, 241, 0.3);
            }
            
            .twin-card .p-6 {
                flex: 1;
                display: flex;
                flex-direction: column;
            }
            
            .twin-card .twin-bio {
                flex: 1;
                min-height: 40px;
            }
            
            /* Hide scrollbar for filter tabs */
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }

            /* Screen reader only class */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}

.sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
}
        </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">    
    <!--Header-->
    <%- include('header') %>

<!-- Main Content -->
<main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <header class="mb-6 sm:mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Discover AI Twins</h1>
                <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">Explore trending, popular, and recommended AI twins from the community</p>
            </div>
            <a href="/public-chat/history" 
               class="flex items-center justify-center gap-2 px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl border border-white/20 dark:border-gray-700 hover:shadow-lg transition-all w-full sm:w-auto"
               aria-label="View my chat history">
                <span>💬</span>
                <span class="font-medium text-gray-700 dark:text-gray-300">My Chats</span>
            </a>
        </div>
    </header>

    <!-- Status announcements for screen readers -->
    <div aria-live="polite" aria-atomic="true" class="sr-only" id="status-announcement"></div>

    <!-- Search Section -->
    <section aria-label="Search twins" class="mb-6 sm:mb-8">
        <div class="max-w-2xl mx-auto">
            <div class="relative">
                <input 
                    type="text" 
                    id="searchInput"
                    placeholder="Search twins..." 
                    class="w-full px-4 py-3 pl-12 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl border border-white/20 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-lg text-base text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                    style="font-size: 16px;"
                    aria-label="Search for AI twins"
                >
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Filter Section -->
    <nav aria-label="Filter options" class="mb-6 sm:mb-8">
        <div class="relative">
            <!-- Mobile: Scrollable container with snap -->
            <div class="flex items-center gap-2 sm:gap-3 bg-gradient-to-r from-indigo-50/80 via-purple-50/80 to-pink-50/80 dark:from-gray-800/80 dark:via-gray-800/80 dark:to-gray-800/80 backdrop-blur-xl p-2 sm:p-3 rounded-2xl max-w-4xl mx-auto border border-indigo-200/30 dark:border-gray-700/50 shadow-lg overflow-x-auto scrollbar-hide snap-x snap-mandatory scroll-smooth">
                    <button class="filter-tab active bg-gradient-to-r from-amber-500 to-orange-500 text-white px-5 sm:px-6 py-3 sm:py-2.5 rounded-xl font-semibold text-sm sm:text-base shadow-lg transform transition-all duration-200 border-2 border-amber-400/50 whitespace-nowrap snap-start min-w-[120px] sm:min-w-auto touch-manipulation" data-filter="trending">                    
                        <span class="mr-1.5">🔥</span>Trending
                    </button>
                    <button class="filter-tab bg-white/90 dark:bg-gray-700/90 text-gray-700 dark:text-gray-300 px-5 sm:px-6 py-3 sm:py-2.5 rounded-xl font-semibold text-sm sm:text-base shadow-sm transform transition-all duration-200 border-2 border-transparent whitespace-nowrap snap-start min-w-[120px] sm:min-w-auto touch-manipulation hover:bg-gradient-to-r hover:from-blue-500 hover:to-cyan-500 hover:text-white dark:hover:from-blue-600 dark:hover:to-cyan-600 hover:border-blue-400/50" data-filter="recent">                    
                        <span class="mr-1.5">🆕</span>Recent
                    </button>
                    <button class="filter-tab bg-white/90 dark:bg-gray-700/90 text-gray-700 dark:text-gray-300 px-5 sm:px-6 py-3 sm:py-2.5 rounded-xl font-semibold text-sm sm:text-base shadow-sm transform transition-all duration-200 border-2 border-transparent whitespace-nowrap snap-start min-w-[120px] sm:min-w-auto touch-manipulation hover:bg-gradient-to-r hover:from-yellow-500 hover:to-amber-500 hover:text-white dark:hover:from-yellow-600 dark:hover:to-amber-600 hover:border-yellow-400/50" data-filter="popular">                    
                        <span class="mr-1.5">⭐</span>Popular
                    </button>
                    <button class="filter-tab bg-white/90 dark:bg-gray-700/90 text-gray-700 dark:text-gray-300 px-5 sm:px-6 py-3 sm:py-2.5 rounded-xl font-semibold text-sm sm:text-base shadow-sm transform transition-all duration-200 border-2 border-transparent whitespace-nowrap snap-start min-w-[120px] sm:min-w-auto touch-manipulation hover:bg-gradient-to-r hover:from-pink-500 hover:to-rose-500 hover:text-white dark:hover:from-pink-600 dark:hover:to-rose-600 hover:border-pink-400/50" data-filter="most-liked">                    
                        <span class="mr-1.5">❤️</span>Most Liked
                    </button>
                    <button class="filter-tab bg-white/90 dark:bg-gray-700/90 text-gray-700 dark:text-gray-300 px-5 sm:px-6 py-3 sm:py-2.5 rounded-xl font-semibold text-sm sm:text-base shadow-sm transform transition-all duration-200 border-2 border-transparent whitespace-nowrap snap-start min-w-[120px] sm:min-w-auto touch-manipulation hover:bg-gradient-to-r hover:from-indigo-500 hover:to-purple-500 hover:text-white dark:hover:from-indigo-600 dark:hover:to-purple-600 hover:border-indigo-400/50" data-filter="most-followed">                    
                        <span class="mr-1.5">👥</span>Most Followed
                    </button>                
            </div>
        </div>
    </nav>

    <!-- Twins Grid Section -->
    <section aria-label="AI twins list">
        <!-- Loading State -->
        <div id="loadingState" class="hidden">
            <%- include('components/loading-skeleton', { type: 'twin-card', count: 8 }) %>
        </div>

        <!-- Twins Grid -->
        <div id="twinsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 hidden items-stretch">            
            <!-- Twin cards will be populated here -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden">
            <%- include('components/empty-state', { 
                icon: '🤖',
                title: 'No twins found',
                description: 'Try adjusting your search or filters to find more AI twins.',
                actionText: 'Clear Filters',
                actionOnClick: 'clearFilters()'
            }) %>
        </div>

        <!-- Error State -->
        <div id="errorState" class="hidden">
            <%- include('components/error-state', { 
                title: 'Failed to load twins',
                message: 'We encountered an error while loading twins. Please try again.'
            }) %>
        </div>

        <!-- Load More Button -->
        <div id="loadMoreContainer" class="text-center mt-8 hidden">
            <button id="loadMoreBtn" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all font-medium shadow-md" aria-label="Load more twins">
                Load More
            </button>
        </div>
    </section>
</main>    

    <!-- Twin Card Template -->
    <template id="twinCardTemplate">
        <div class="twin-card bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 hover:shadow-2xl dark:hover:shadow-gray-800 transition-all duration-300 cursor-pointer">            
            <div class="p-6 flex flex-col h-full">                
                <!-- Twin Header -->
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg">                        
                        <span class="twin-initial">A</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white truncate">
                            @<span class="twin-handle">handle</span>
                        </h3>
                        <p class="text-sm text-gray-600 dark:text-gray-300 truncate">
                            by <span class="creator-name">Creator</span>
                        </p>
                    </div>
                    <div class="twin-verified hidden">
                        <svg class="w-5 h-5 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>

                <!-- Twin Bio -->
                <p class="text-gray-700 dark:text-gray-300 text-sm mb-4 line-clamp-2 twin-bio">
                    Bio content here...
                </p>

                <!-- Sample Reply -->
                <div class="twin-sample-reply hidden bg-gray-50 dark:bg-gray-700/50 rounded-lg p-3 mb-4">
                    <p class="text-sm text-gray-600 dark:text-gray-300 italic">
                        "<span class="sample-text">Sample reply...</span>"
                    </p>
                </div>

                <div class="flex justify-between text-sm text-gray-600 dark:text-gray-300 mb-4">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 text-red-500 dark:text-red-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg> 
                        <span class="like-count">0</span>
                    </span>
                    <span class="flex items-center">
                        <svg class="w-4 h-4 text-blue-500 dark:text-blue-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg> 
                        <span class="follow-count">0</span>
                    </span>
                    <span class="flex items-center">
                        <svg class="w-4 h-4 text-green-500 dark:text-green-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg> 
                        <span class="chat-count">0</span>
                    </span>
                </div>

                <!-- Actions - Enhanced Mobile Touch Targets -->
                <div class="flex items-center justify-between gap-2 sm:gap-3 w-full">
                    <button class="twin-chat-btn flex-1 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white py-3 sm:py-2.5 px-4 sm:px-4 rounded-xl hover:from-indigo-700 hover:via-purple-700 hover:to-pink-700 hover:shadow-xl transition-all text-sm sm:text-xs font-semibold shadow-md transform hover:scale-105 whitespace-nowrap min-h-[48px] sm:min-h-[44px] touch-manipulation" aria-label="Start chat">
                        <svg class="w-4 h-4 sm:w-3.5 sm:h-3.5 mr-1.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>Chat
                    </button>                    
                    <button class="twin-like-btn bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 text-gray-700 dark:text-gray-300 py-3 sm:py-2.5 px-3 sm:px-3 rounded-lg hover:from-red-50 hover:to-red-100 dark:hover:from-red-900/30 dark:hover:to-red-800/30 hover:text-red-600 dark:hover:text-red-400 transition-all duration-200 shadow-sm flex-shrink-0 min-w-[48px] sm:min-w-[44px] min-h-[48px] sm:min-h-[44px] touch-manipulation" aria-label="Like this twin">
                        <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                    </button>
                    <button class="twin-follow-btn bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 text-gray-700 dark:text-gray-300 py-3 sm:py-2.5 px-3 sm:px-3 rounded-lg hover:from-blue-50 hover:to-blue-100 dark:hover:from-blue-900/30 dark:hover:to-blue-800/30 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200 shadow-sm flex-shrink-0 min-w-[48px] sm:min-w-[44px] min-h-[48px] sm:min-h-[44px] touch-manipulation" aria-label="Follow this twin">
                        <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
                    </button>
                    <button class="twin-share-btn bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 text-gray-700 dark:text-gray-300 py-3 sm:py-2.5 px-3 sm:px-3 rounded-lg hover:from-green-50 hover:to-green-100 dark:hover:from-green-900/30 dark:hover:to-green-800/30 hover:text-green-600 dark:hover:text-green-400 transition-all duration-200 shadow-sm flex-shrink-0 min-w-[48px] sm:min-w-[44px] min-h-[48px] sm:min-h-[44px] touch-manipulation" aria-label="Share this twin profile">
                        <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path></svg>
                    </button>                    
                </div>                                            
            </div>
        </div>
    </template>

    <script>
        let currentFilter = 'trending';
        let currentPage = 0;
        let isLoading = false;
        let hasMore = true;

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadTwins();
            setupEventListeners();
        });

        function setupEventListeners() {
            // Filter tabs
            document.querySelectorAll('.filter-tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    const filter = this.dataset.filter;
                    setActiveFilter(filter);
                    currentPage = 0;
                    hasMore = true;
                    loadTwins();
                });
            });

            // Search input
            let searchTimeout;
            document.getElementById('searchInput').addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentPage = 0;
                    hasMore = true;
                    loadTwins();
                }, 500);
            });

            // Load more button
            document.getElementById('loadMoreBtn').addEventListener('click', loadMore);
        }

        function setActiveFilter(filter) {
            currentFilter = filter;
            document.querySelectorAll('.filter-tab').forEach(tab => {
                // Remove all active states and hover classes
                tab.classList.remove('active', 'bg-gradient-to-r', 'from-amber-500', 'to-orange-500', 'text-white', 'border-amber-400/50', 'shadow-lg');
                tab.classList.remove('hover:bg-gradient-to-r', 'hover:from-blue-500', 'hover:to-cyan-500', 'hover:text-white', 'hover:border-blue-400/50');
                tab.classList.remove('hover:from-yellow-500', 'hover:to-amber-500', 'hover:border-yellow-400/50');
                tab.classList.remove('hover:from-pink-500', 'hover:to-rose-500', 'hover:border-pink-400/50');
                tab.classList.remove('hover:from-indigo-500', 'hover:to-purple-500', 'hover:border-indigo-400/50');
                
                // Add default inactive state
                tab.classList.add('bg-white/90', 'dark:bg-gray-700/90', 'text-gray-700', 'dark:text-gray-300', 'border-transparent');
                
                // Re-add hover classes based on filter type
                const filterType = tab.dataset.filter;
                if (filterType === 'trending') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-amber-500', 'hover:to-orange-500', 'hover:text-white', 'dark:hover:from-amber-600', 'dark:hover:to-orange-600', 'hover:border-amber-400/50', 'hover:scale-105');
                } else if (filterType === 'recent') {                    
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-blue-500', 'hover:to-cyan-500', 'hover:text-white', 'dark:hover:from-blue-600', 'dark:hover:to-cyan-600', 'hover:border-blue-400/50');
                } else if (filterType === 'popular') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-yellow-500', 'hover:to-amber-500', 'hover:text-white', 'dark:hover:from-yellow-600', 'dark:hover:to-amber-600', 'hover:border-yellow-400/50');
                } else if (filterType === 'most-liked') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-pink-500', 'hover:to-rose-500', 'hover:text-white', 'dark:hover:from-pink-600', 'dark:hover:to-rose-600', 'hover:border-pink-400/50');
                } else if (filterType === 'most-followed') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-indigo-500', 'hover:to-purple-500', 'hover:text-white', 'dark:hover:from-indigo-600', 'dark:hover:to-purple-600', 'hover:border-indigo-400/50');
                }
            });
            
            const activeTab = document.querySelector(`[data-filter="${filter}"]`);
            // Remove all inactive classes
            activeTab.classList.remove('bg-white/90', 'dark:bg-gray-700/90', 'text-gray-700', 'dark:text-gray-300', 'border-transparent');
            // Remove all hover classes
            activeTab.classList.remove('hover:bg-gradient-to-r', 'hover:from-blue-500', 'hover:to-cyan-500', 'hover:text-white', 'hover:border-blue-400/50');
            activeTab.classList.remove('hover:from-yellow-500', 'hover:to-amber-500', 'hover:border-yellow-400/50');
            activeTab.classList.remove('hover:from-pink-500', 'hover:to-rose-500', 'hover:border-pink-400/50');
            activeTab.classList.remove('hover:from-indigo-500', 'hover:to-purple-500', 'hover:border-indigo-400/50');
            activeTab.classList.remove('hover:scale-105');
            
            // Add active state
            activeTab.classList.add('active', 'bg-gradient-to-r', 'from-amber-500', 'to-orange-500', 'text-white', 'border-amber-400/50', 'shadow-lg');
        }        

        async function loadTwins() {
    if (isLoading) return;
    
    isLoading = true;
    showLoading();
    hideError(); // ✅ ADD THIS LINE - Hide any previous errors

    try {
        const searchQuery = document.getElementById('searchInput').value.trim();
        let url = `/api/discover/${currentFilter}?limit=12&offset=${currentPage * 12}`;
        
        // ✅ Add timeframe parameter for trending
        if (currentFilter === 'trending') {
            url += '&timeframe=all';
        }
        
        if (searchQuery) {
            url = `/api/discover/search?query=${encodeURIComponent(searchQuery)}&limit=12&offset=${currentPage * 12}`;
        }

        const response = await fetch(url);
        const data = await response.json();

        if (data.success) {
            if (currentPage === 0) {
                clearTwinsGrid();
            }
            
            if (data.twins.length === 0) {
                showEmptyState();
            } else {
                hideEmptyState();
                hideError(); // ✅ ADD THIS - Hide error if data loads successfully
                data.twins.forEach(twin => addTwinCard(twin));

                  // ✅ ADD: Announce to screen readers
        const statusEl = document.getElementById('status-announcement');
        if (statusEl) {
            statusEl.textContent = `Loaded ${data.twins.length} ${data.twins.length === 1 ? 'twin' : 'twins'}`;
        }
                
                if (data.twins.length < 12) {
                    hasMore = false;
                    hideLoadMore();
                } else {
                    showLoadMore();
                }
            }
        } else {
            showError(data.error || 'Failed to load twins');
        }
    } catch (error) {
        console.error('Error loading twins:', error);
        showError('Failed to load twins');
    } finally {
        isLoading = false;
        hideLoading();
    }
}        
       

        async function loadMore() {
            if (!hasMore || isLoading) return;
            
            currentPage++;
            await loadTwins();
        }

        function addTwinCard(twin) {
    const template = document.getElementById('twinCardTemplate');
    const clone = template.content.cloneNode(true);
    
    // Update twin data
    clone.querySelector('.twin-handle').textContent = twin.publicHandle;
    clone.querySelector('.creator-name').textContent = twin.userName || twin.userHandle;
    clone.querySelector('.twin-bio').textContent = twin.bio || 'No bio available';
    clone.querySelector('.like-count').textContent = twin.likeCount || 0;
    clone.querySelector('.follow-count').textContent = twin.followCount || 0;
    clone.querySelector('.chat-count').textContent = twin.chatCount || 0;
    
    // ✅ ADD: Get buttons and update ARIA labels
    const chatBtn = clone.querySelector('.twin-chat-btn');
    const likeBtn = clone.querySelector('.twin-like-btn');
    const followBtn = clone.querySelector('.twin-follow-btn');
    const shareBtn = clone.querySelector('.twin-share-btn');
    
    // ✅ ADD: Set ARIA labels with actual twin handle
    chatBtn.setAttribute('aria-label', `Start chat with @${twin.publicHandle}`);
    likeBtn.setAttribute('aria-label', `Like @${twin.publicHandle}`);
    followBtn.setAttribute('aria-label', `Follow @${twin.publicHandle}`);
    shareBtn.setAttribute('aria-label', `Share @${twin.publicHandle} profile`);
    
    // Show verified badge if applicable
    if (twin.verified) {
        clone.querySelector('.twin-verified').classList.remove('hidden');
    }
    
    // Show sample reply if available
    if (twin.sampleReply) {
        clone.querySelector('.twin-sample-reply').classList.remove('hidden');
        clone.querySelector('.sample-text').textContent = twin.sampleReply;
    }
    
    // Set initial letter for avatar
    const initial = twin.publicHandle.charAt(0).toUpperCase();
    clone.querySelector('.twin-initial').textContent = initial;
    
    // ✅ FIX: Set initial button states AFTER buttons are defined
    if (twin.hasLiked) {
        likeBtn.classList.add('bg-red-100', 'text-red-600', 'dark:bg-red-900/30', 'dark:text-red-400');
        likeBtn.innerHTML = '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>';
    }
    
    if (twin.hasFollowed) {
        followBtn.classList.add('bg-blue-100', 'text-blue-600', 'dark:bg-blue-900/30', 'dark:text-blue-400');
        followBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
    }
    
    // Add event listeners for buttons
    chatBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        e.preventDefault();
        
        const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
        
        if (isLoggedIn) {
            try {
                const response = await fetch(`/api/public-twin/check-owner/${twin.id}`, {
                    credentials: 'include'
                });
                
                if (!response.ok) {
                    throw new Error('Failed to check twin owner');
                }
                
                const data = await response.json();
                
                if (data.isOwner) {
                    window.location.replace(`/chat-enhanced?twinId=${twin.id}&message=${encodeURIComponent('You cannot chat with your own twin in public chat. Use Enhanced Chat instead.')}`);
                    return;
                }
            } catch (error) {
                console.error('Error checking own twin:', error);
            }
        }
        
        window.location.href = `/public-twin/chat/${twin.id}`;
    });
    
    // Card click → navigate to profile
    const card = clone.querySelector('.twin-card');
    card.addEventListener('click', (e) => {
        if (e.target.closest('button') || e.target.closest('a')) {
            return;
        }
        window.location.href = `/@${twin.publicHandle}`;
    });
    
    likeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleLike(twin.id, likeBtn);
    });
    
    followBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFollow(twin.id, followBtn);
    });
    
    shareBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        shareTwinFromDiscover(twin.id, twin.publicHandle);
    });
    
    document.getElementById('twinsGrid').appendChild(clone);
}

        async function toggleLike(twinId, button) {
            try {
                const response = await fetch('/api/social/toggle-like', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ twinId })
                });

                const data = await response.json();
                
                if (data.success) {
                    // Update button state
                    if (data.action === 'liked') {
                        button.classList.add('bg-red-100', 'text-red-600');
                        button.innerHTML = '<svg class="w-4 h-4" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>';
                        
                        // ✅ Show notification message
                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`❤️ You liked @${twinHandle}`, 'success');
                    } else {
                        button.classList.remove('bg-red-100', 'text-red-600');
                        button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>';
                        
                        // ✅ Show notification message
                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`💔 You unliked @${twinHandle}`, 'info');
                    }
                    
                    // Update like count in the card
                    const card = button.closest('.twin-card');
                    const likeCount = card.querySelector('.like-count');
                    likeCount.textContent = data.likeCount;
                } else {
                    if (data.error === 'Authentication required') {
                        alert('Please log in to like this twin!');
                    } else {
                        alert('Error: ' + data.error);
                    }
                }
            } catch (error) {
                console.error('Error toggling like:', error);
                alert('Please log in to like this twin!');
            }
        }

        async function toggleFollow(twinId, button) {
            try {
                const response = await fetch('/api/social/toggle-follow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ twinId })
                });

                const data = await response.json();
                
                if (data.success) {
                    // Update button state
                    if (data.action === 'followed') {
                        button.classList.add('bg-blue-100', 'text-blue-600');
                        button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
                        
                        // ✅ Show notification message
                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`👥 You are now following @${twinHandle}`, 'success');
                    } else {
                        button.classList.remove('bg-blue-100', 'text-blue-600');
                        button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>';
                        
                        // ✅ Show notification message
                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`👋 You unfollowed @${twinHandle}`, 'info');
                    }
                    
                    // Update follow count in the card
