<!-- AFTER: -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Discover AI Twins</h1>
            <p class="text-gray-600 dark:text-gray-300">Explore trending, popular, and recommended AI twins from the community</p>
        </div>
        <a href="/public-chat/history" 
           class="hidden md:flex items-center gap-2 px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl border border-white/20 dark:border-gray-700 hover:shadow-lg transition-all">
            <span>💬</span>
            <span class="font-medium text-gray-700 dark:text-gray-300">My Chats</span>
        </a>
    </div>
</div>        

        <!-- Search Bar -->
        <div class="mb-8">
            <div class="max-w-2xl mx-auto">
                <div class="relative">
                    <input 
                        type="text" 
                        id="searchInput"
                        placeholder="Search twins by handle, bio, or creator..." 
                        class="w-full px-4 py-3 pl-12 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl border border-white/20 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-lg text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                    >
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="mb-8">
            <div class="flex space-x-1 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm p-1 rounded-xl max-w-2xl mx-auto border border-white/20 dark:border-gray-700 shadow-md">
                <button class="filter-tab active bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl border border-white/20 dark:border-gray-700 px-4 py-2 rounded-lg font-medium text-primary dark:text-blue-400 shadow-sm" data-filter="trending">🔥 Trending</button>
                <button class="filter-tab bg-transparent hover:bg-white/50 dark:hover:bg-gray-700/50 border border-transparent px-4 py-2 rounded-lg font-medium text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-all" data-filter="recent">🆕 Recent</button>
                <button class="filter-tab bg-transparent hover:bg-white/50 dark:hover:bg-gray-700/50 border border-transparent px-4 py-2 rounded-lg font-medium text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-all" data-filter="popular">⭐ Popular</button>
                <button class="filter-tab bg-transparent hover:bg-white/50 dark:hover:bg-gray-700/50 border border-transparent px-4 py-2 rounded-lg font-medium text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-all" data-filter="most-liked">❤️ Most Liked</button>
