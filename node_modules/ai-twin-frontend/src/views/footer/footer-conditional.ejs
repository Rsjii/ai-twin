<!-- Reusable Footer Component - For Public/Private Pages -->
<% 
  try {
    // ✅ ENHANCED: More robust authentication check
    const isAuthenticated = typeof user !== 'undefined' && 
                            user !== null && 
                            typeof user === 'object' &&
                            user.id !== undefined && 
                            user.id !== null &&
                            user.email !== undefined &&
                            user.email !== null;
    
    // ✅ ENHANCED: Safe hasTwins check (default to false if undefined)
    const userHasTwin = typeof hasTwins !== 'undefined' ? hasTwins === true : false;
    
    if (!isAuthenticated) {
%>
    <%- include('footer-non-logged') %>
<% 
    } else if (isAuthenticated && !userHasTwin) {
%>
    <%- include('footer-logged-no-twin') %>
<% 
    } else {
%>
    <%- include('footer-logged-with-twin') %>
<% 
    }
  } catch (err) {
    // Fallback to non-logged footer if any error
%>
    <%- include('footer-non-logged') %>
<% 
  }
%>