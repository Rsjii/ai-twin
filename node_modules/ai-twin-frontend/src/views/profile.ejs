<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444',
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen font-inter">
    <!-- Header -->
    <header class="bg-white/80 backdrop-blur-xl border-b border-white/20 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <a href="/" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" stroke="currentColor" fill="none">
                                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </a>
                </div>
                
                <!-- Navigation -->
                <nav class="hidden md:flex space-x-8">
                    <a href="/dashboard" class="text-gray-600 hover:text-primary transition-colors font-medium">Dashboard</a>
                    <a href="/profile" class="text-primary font-semibold">Profile</a>
                    <% if (!hasTwins) { %>
                        <a href="/onboarding" class="text-gray-600 hover:text-primary transition-colors font-medium">Create Twin</a>
                    <% } %>
                </nav>

                <!-- User Menu -->
                <div class="flex items-center space-x-4">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <!-- Modern User Dropdown -->
                        <div class="relative" id="userDropdown" data-open="false">
                            <button id="dropdownButton" class="flex items-center space-x-3 px-4 py-2 rounded-xl bg-white/80 hover:bg-white transition-all duration-300 shadow-lg hover:shadow-xl border border-white/20 group">
                                <% if (user.profileImage) { %>
                                    <img src="<%= user.profileImage %>" alt="Profile" class="w-10 h-10 rounded-full object-cover shadow-lg">
                                <% } else { %>
                                    <div class="w-10 h-10 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg">
                                        <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div class="hidden sm:block text-left">
                                    <div class="text-sm font-semibold text-gray-900"><%= user.handle || user.email %></div>
                                    <div class="text-xs text-gray-500"><%= user.email %></div>
                                </div>
                                <div class="ml-2">
                                    <svg id="arrowIcon" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </button>
                            
                            <!-- Dropdown Menu -->
                            <div id="dropdownMenu" class="absolute right-0 mt-3 w-72 bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 py-3 z-50 hidden transition-all duration-200 opacity-0 scale-95">
                                
                                <!-- User Info Header -->
                                <div class="px-6 py-4 border-b border-gray-100/50">
                                    <div class="flex items-center space-x-4">
                                        <% if (user.profileImage) { %>
                                            <img src="<%= user.profileImage %>" alt="Profile" class="w-14 h-14 rounded-2xl object-cover shadow-lg">
                                        <% } else { %>
                                            <div class="w-14 h-14 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-2xl flex items-center justify-center text-white text-xl font-bold shadow-lg">
                                                <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-lg font-semibold text-gray-900 truncate"><%= user.name || user.handle || 'User' %></p>
                                            <p class="text-sm text-gray-500 truncate"><%= user.email %></p>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Menu Items -->
                                <div class="py-2">
                                    <a href="/profile" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        Profile Settings
                                    </a>
                                    <a href="/dashboard" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
                                        </svg>
                                        Dashboard
                                    </a>
                                    <% if (!hasTwins) { %>
                                        <a href="/onboarding" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                            <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                            </svg>
                                            Create Twin
                                        </a>
                                    <% } %>                                    
                                </div>
                                
                                <!-- Logout -->
                                <div class="border-t border-gray-100/50 pt-2">
                                    <button onclick="logout()" class="flex items-center w-full px-6 py-3 text-red-600 hover:bg-red-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                        </svg>
                                        Sign Out
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <div class="px-4 py-8 sm:px-0">
        <div class="max-w-6xl mx-auto">
            <div class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 p-8">
                <div class="mb-8">
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">Profile Settings</h1>
                    <p class="text-gray-600">Manage your account, twin, and preferences</p>
                </div>
                
                <!-- Tab Navigation -->
                <div class="border-b border-gray-200 mb-8">
                    <nav class="flex space-x-8" aria-label="Tabs">
                        <button 
                            onclick="switchTab('profile')"
                            id="tab-profile"
                            class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors <%= activeTab === 'profile' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700' %>"
                        >
                            <span class="flex items-center space-x-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                <span>Profile Settings</span>
                            </span>
                        </button>
                        <% if (hasTwins && twin) { %>
                            <button 
                                onclick="switchTab('twin')"
                                id="tab-twin"
                                class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors <%= activeTab === 'twin' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700' %>"
                            >
                                <span class="flex items-center space-x-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                    </svg>
                                    <span>My Twin</span>
                                </span>
                            </button>
                        <% } %>
                        <button 
                            onclick="switchTab('settings')"
                            id="tab-settings"
                            class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors <%= activeTab === 'settings' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700' %>"
                        >
                            <span class="flex items-center space-x-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span>Settings</span>
                            </span>
                        </button>
                    </nav>                    
                </div>
                
                <!-- Tab Content: Profile Settings -->
                <div id="content-profile" class="tab-content <%= activeTab === 'profile' ? '' : 'hidden' %>">
                    <form id="profileForm">
                        <!-- Edit Profile Button -->
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h2 class="text-xl font-semibold text-gray-900">Profile Information</h2>
                                <p class="text-gray-600 text-sm">Update your personal details</p>
                            </div>
                            <button 
                                type="button"
                                id="editProfileBtn"
                                onclick="toggleEditMode()"
                                class="bg-gradient-to-r from-primary to-accent text-white py-2 px-6 rounded-xl hover:from-secondary hover:to-primary transition-all duration-300 font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
                            >
                                <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                Edit Profile
                            </button>
                        </div>
                        
                            <!-- Profile Image Section -->                        
                        <div class="mb-8 p-6 bg-gradient-to-r from-blue-50 to-purple-50 rounded-2xl border border-blue-100">
                            <h2 class="text-xl font-semibold text-gray-800 mb-6 flex items-center">
                                <svg class="w-6 h-6 mr-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                Profile Picture
                            </h2>
                            <div class="flex items-center space-x-8">
                                <div class="flex-shrink-0">
                                    <% if (user.profileImage) { %>
                                        <img src="<%= user.profileImage %>" alt="Profile" class="w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white">
                                    <% } else { %>
                                        <div class="w-24 h-24 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-2xl flex items-center justify-center text-white text-3xl font-bold shadow-xl border-4 border-white">
                                            <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="flex-1">
                                    <label class="block text-sm font-medium text-gray-700 mb-3">Upload New Image</label>
                                    <div class="relative">
                                        <input 
                                            type="file" 
                                            id="profileImageFile" 
                                            name="profileImageFile" 
                                            accept="image/*" 
                                            readonly
                                            class="w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl bg-white/50 backdrop-blur-sm focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                        >
                                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                            <div class="text-center">
                                                <svg class="w-8 h-8 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                                </svg>
                                                <p class="text-sm text-gray-500">Click to upload</p>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-2">JPG, PNG, GIF, WebP - Max 5MB</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Personal Information -->
                        <div class="mb-8 p-6 bg-white/60 backdrop-blur-sm rounded-2xl border border-gray-100">
                            <h2 class="text-xl font-semibold text-gray-800 mb-6 flex items-center">
                                <svg class="w-6 h-6 mr-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Personal Information
                            </h2>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Full Name</label>
                                    <input 
                                        type="text" 
                                        id="name" 
                                        name="name" 
                                        value="<%= user.name || '' %>" 
                                        readonly
                                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-white/50 backdrop-blur-sm focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                    >
                                </div>
                                
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Handle</label>
                                    <input 
                                        type="text" 
                                        id="handle" 
                                        name="handle"
                                        value="<%= user.handle || '' %>" 
                                        readonly
                                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-white/50 backdrop-blur-sm focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                    >
                                </div>
                                
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Email Address</label>
                                    <input 
                                        type="email" 
                                        id="email" 
                                        name="email" 
                                        value="<%= user.email || '' %>" 
                                        readonly
                                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-100 text-gray-500"
                                    >
                                </div>
                                
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Date of Birth</label>
                                    <input 
                                        type="date" 
                                        id="dob" 
                                        name="dob"
                                        value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>" 
                                        readonly
                                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-white/50 backdrop-blur-sm focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
                                    >
                                </div>
                            </div>
                            
                            <div class="mt-6 space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Bio</label>
                                <textarea 
                                    id="bio" 
                                    name="bio" 
                                    rows="4" 
                                    readonly
                                    class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-white/50 backdrop-blur-sm focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 resize-none"
                                    placeholder="Tell us about yourself..."><%= user.bio || '' %></textarea>
                            </div>
                        </div>
                        
                        <div class="flex justify-end space-x-4">
                            <button 
                                type="button"
                                id="cancelBtn" 
                                onclick="cancelEdit()"
                                class="px-8 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 transition-all duration-300 font-semibold hidden transform hover:-translate-y-0.5"
                            >
                                Cancel
                            </button>
                            <button 
                                type="submit"
                                id="saveBtn" 
                                class="bg-gradient-to-r from-primary to-accent text-white py-3 px-8 rounded-xl hover:from-secondary hover:to-primary transition-all duration-300 font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 hidden"
                            >
                                <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
                
                <!-- Tab Content: My Twin -->
                <% if (hasTwins && twin) { %>
                    <div id="content-twin" class="tab-content <%= activeTab === 'twin' ? '' : 'hidden' %>">
                        <div class="space-y-6">
                            <!-- Twin Preview Card -->
                            <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-xl p-6 border border-blue-100">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center space-x-4">
                                        <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg">
                                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3 class="text-xl font-bold text-gray-900">Your AI Twin</h3>
                                            <p class="text-gray-600"><%= twin.isPublic ? '@' + (twin.publicHandle || 'twin') : 'Private Twin' %></p>
                                        </div>
                                    </div>
                                    <div>
                                        <% if (twin.isPublic) { %>
                                            <span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-semibold rounded-full">Public</span>
                                        <% } else { %>
                                            <span class="px-3 py-1 bg-gray-100 text-gray-800 text-sm font-semibold rounded-full">Private</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Twin Management Links -->
                            <div class="grid md:grid-cols-3 gap-6">
                                <a href="/twin/<%= twin.id %>/ai-edit" class="bg-white rounded-xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-all group">
                                    <div class="flex items-center space-x-4">
                                        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold text-gray-900">Edit Style</h4>
                                            <p class="text-sm text-gray-600">Customize personality</p>
                                        </div>
                                    </div>
                                </a>
                                
                                <a href="/twin/<%= twin.id %>/style-customize" class="bg-white rounded-xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-all group">
                                    <div class="flex items-center space-x-4">
                                        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
