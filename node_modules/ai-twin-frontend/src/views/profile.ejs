            allowFollows: document.getElementById('allowFollows')?.checked ?? true,
            allowShares: document.getElementById('allowShares')?.checked ?? true,
        };

        // Check if settings changed
        function hasSettingsChanged() {
            const current = {
                showChatHistory: document.getElementById('showChatHistory')?.checked ?? true,
                requireLogin: document.getElementById('requireLogin')?.checked ?? false,
                blockNonLoggedUsers: document.getElementById('blockNonLoggedUsers')?.checked ?? false,
                allowLikes: document.getElementById('allowLikes')?.checked ?? true,
                allowFollows: document.getElementById('allowFollows')?.checked ?? true,
                allowShares: document.getElementById('allowShares')?.checked ?? true,
            };
            
            return (
                current.showChatHistory !== originalSettings.showChatHistory ||
                current.requireLogin !== originalSettings.requireLogin ||
                current.blockNonLoggedUsers !== originalSettings.blockNonLoggedUsers ||
                current.allowLikes !== originalSettings.allowLikes ||
                current.allowFollows !== originalSettings.allowFollows ||
                current.allowShares !== originalSettings.allowShares
            );
        }

        // Update button style based on changes
        function updateSaveButtonStyle() {
            const btn = document.getElementById('savePrivacySettingsBtn');
            if (!btn) return;
            
            if (hasSettingsChanged()) {
                btn.classList.remove('bg-gray-400', 'cursor-not-allowed');
                btn.classList.add('bg-gradient-to-r', 'from-primary', 'to-accent', 'cursor-pointer', 'hover:shadow-lg');
                btn.disabled = false;
            } else {
                btn.classList.remove('bg-gradient-to-r', 'from-primary', 'to-accent', 'hover:shadow-lg', 'cursor-pointer');
                btn.classList.add('bg-gray-400', 'cursor-not-allowed');
                btn.disabled = true;
            }
        }

        // Add listeners to all privacy toggles
        document.querySelectorAll('.privacy-toggle').forEach(toggle => {
            toggle.addEventListener('change', updateSaveButtonStyle);
        });

        // Initialize button state on page load
        updateSaveButtonStyle();
                
        async function savePrivacySettings() {
            <% if (!hasTwins || !twin) { %>
                showNotification('No twin found', 'error');
                return;
            <% } %>
            
            const settings = {
                showChatHistory: document.getElementById('showChatHistory')?.checked ?? true,
                requireLogin: document.getElementById('requireLogin')?.checked ?? false,
                blockNonLoggedUsers: document.getElementById('blockNonLoggedUsers')?.checked ?? false,
                allowLikes: document.getElementById('allowLikes')?.checked ?? true,
                allowFollows: document.getElementById('allowFollows')?.checked ?? true,
                allowShares: document.getElementById('allowShares')?.checked ?? true,
            };
            
            try {
                const response = await fetch('/api/privacy/settings', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    credentials: 'include',
                    body: JSON.stringify({ 
                        twinId: '<%= twin?.id || '' %>',
                        settings: settings
                    })
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    showNotification('Privacy settings updated!', 'success');
                    // Update original settings after successful save
                    originalSettings = { ...settings };
                    updateSaveButtonStyle();
                } else {
                    showNotification(result.error || 'Failed to update settings', 'error');
                }
            } catch (error) {
                console.error('Privacy settings error:', error);
                showNotification('Network error. Please try again.', 'error');
            }
        }

        // Load blocked users
        async function loadBlockedUsers() {
            <% if (!hasTwins || !twin) { %>
                return;
            <% } %>
            
            try {
                const response = await fetch(`/api/privacy/settings/<%= twin?.id || '' %>`, {
                    credentials: 'include'
                });
                
                const result = await response.json();
                
                if (response.ok && result.settings && result.settings.blockedUsers) {
                    const blockedUsersList = document.getElementById('blockedUsersList');
                    const blockedUsers = result.settings.blockedUsers;
                    
                    if (blockedUsers.length === 0) {
                        blockedUsersList.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400">No blocked users</p>';
                    } else {
                        blockedUsersList.innerHTML = blockedUsers.map(user => `
                            <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900 dark:text-white">${user.name || user.handle || 'Unknown'}</span>
                                    <span class="text-sm text-gray-500 dark:text-gray-400 ml-2">@${user.handle}</span>
                                </div>
                                <button data-unblock-user="${user.id}" class="unblock-user-btn text-sm bg-gray-500 text-white px-3 py-1 rounded hover:bg-gray-600">
                                    Unblock
                                </button>
                            </div>
                        `).join('');
                        
                        // Add event listeners to unblock buttons
                        document.querySelectorAll('.unblock-user-btn').forEach(btn => {
                            btn.addEventListener('click', function() {
                                const userId = this.getAttribute('data-unblock-user');
                                if (userId) {
                                    unblockUser(userId);
                                }
                            });
                        });
                    }
                }
            } catch (error) {
                console.error('Error loading blocked users:', error);
            }
        }
        
        async function blockUser(userHandle) {
            <% if (!hasTwins || !twin) { %>
                showNotification('No twin found', 'error');
                return;
            <% } %>
            
            if (!userHandle || !userHandle.trim()) {
                showNotification('Please enter a user handle', 'error');
                return;
            }
            
            try {
                const csrfToken = '<%= csrfToken %>' || document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                
                if (!csrfToken) {
                    showNotification('CSRF token missing. Please refresh the page.', 'error');
                    return;
                }
                
                const response = await fetch('/api/privacy/block', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        twinId: '<%= twin?.id || '' %>',
                        userHandle: userHandle.trim()
                    })
                });
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
                    throw new Error(errorData.error || `HTTP ${response.status}`);
                }
                
                const result = await response.json();
                
                if (result.success) {
                    showNotification('User blocked successfully', 'success');
                    loadBlockedUsers();
                    // Clear input
                    const blockInput = document.getElementById('blockUserInput');
                    if (blockInput) blockInput.value = '';
                } else {
                    showNotification(result.error || 'Failed to block user', 'error');
                }
            } catch (error) {
                console.error('Block user error:', error);
                if (error.message.includes('Failed to fetch') || error.message.includes('ERR_CONNECTION_REFUSED')) {
                    showNotification('Cannot connect to server. Please check if the server is running.', 'error');
                } else {
                    showNotification(error.message || 'Network error. Please try again.', 'error');
                }
            }
        }
        
        async function unblockUser(userId) {
            <% if (!hasTwins || !twin) { %>
                showNotification('No twin found', 'error');
                return;
            <% } %>
            
            if (!userId) {
                showNotification('User ID is required', 'error');
                return;
            }
            
            try {
                // Ensure CSRF token is available
                const csrfToken = '<%= csrfToken %>' || document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                
                if (!csrfToken) {
                    showNotification('CSRF token missing. Please refresh the page.', 'error');
                    return;
                }
                
                const response = await fetch('/api/privacy/unblock', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        twinId: '<%= twin?.id || '' %>',
                        userId: userId
                    })
                });
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
                    throw new Error(errorData.error || `HTTP ${response.status}`);
                }
                
                const result = await response.json();
                
                if (result.success) {
                    showNotification('User unblocked successfully', 'success');
                    loadBlockedUsers();
                } else {
                    showNotification(result.error || 'Failed to unblock user', 'error');
                }
            } catch (error) {
                console.error('Unblock user error:', error);
                if (error.message.includes('Failed to fetch') || error.message.includes('ERR_CONNECTION_REFUSED')) {
                    showNotification('Cannot connect to server. Please check if the server is running.', 'error');
                } else {
                    showNotification(error.message || 'Network error. Please try again.', 'error');
                }
            }
        }
        
        function toggleThemeInSettings() {
            const html = document.documentElement;
            const isDark = html.classList.contains('dark');
            const newTheme = isDark ? 'light' : 'dark';
            
            localStorage.setItem('theme', newTheme);
            
            if (newTheme === 'dark') {
                html.classList.add('dark');
                const themeIconSun = document.getElementById('themeIconSun');
                const themeIconMoon = document.getElementById('themeIconMoon');
                if (themeIconSun) themeIconSun.classList.remove('hidden');
                if (themeIconMoon) themeIconMoon.classList.add('hidden');
            } else {
                html.classList.remove('dark');
                const themeIconSun = document.getElementById('themeIconSun');
                const themeIconMoon = document.getElementById('themeIconMoon');
                if (themeIconSun) themeIconSun.classList.add('hidden');
                if (themeIconMoon) themeIconMoon.classList.remove('hidden');
            }
            
            // Trigger theme change event for header
            window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: newTheme } }));
        }
    
        function showNotification(message, type = 'success') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-xl shadow-2xl z-50 transform transition-all duration-300 ${
                type === 'success' 
                    ? 'bg-gradient-to-r from-green-500 to-emerald-500 text-white' 
                    : type === 'error'
                    ? 'bg-gradient-to-r from-red-500 to-pink-500 text-white'
                    : 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white'
            }`;
            
            notification.innerHTML = `
                <div class="flex items-center space-x-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        ${type === 'success' 
                            ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>'
                            : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>'
                        }
                    </svg>
                    <span class="font-semibold">${message}</span>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.transform = 'translateX(0)';
            }, 100);
            
            setTimeout(() => {
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        document.body.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }
    </script>

    <!--Footer-->
    <%- include('footer/footer-conditional-private') %>
</body>
</html>