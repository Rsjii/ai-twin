<%- include('layout', { title: 'Error - AI Twin', body: `
<div class="px-4 py-6 sm:px-0 mobile-p-4">
    <div class="max-w-md mx-auto text-center">
        <div class="text-6xl mb-6 mobile-text-5xl">⚠️</div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4 text-center">Error</h1>
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-6 mobile-text-lg mobile-text-center">
            <%= message || 'An error occurred' %>
        </h2>
        <% if (typeof errorCode !== 'undefined' && errorCode) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Error Code: <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded"><%= errorCode %></code>
        </p>
        <% } %>
        <div class="space-y-4 mobile-gap-2">
            <a href="/" class="block bg-primary text-white px-6 py-3 rounded-lg hover:bg-secondary transition-colors font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base text-center">
                Go Home
            </a>
            <a href="/dashboard" class="block bg-gray-500 text-white px-6 py-3 rounded-lg hover:bg-gray-600 transition-colors font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base text-center">
                Dashboard
            </a>
        </div>
    </div>
</div>
` }) %>