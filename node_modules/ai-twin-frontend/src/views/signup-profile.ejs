<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .primary { color: #3B82F6; }
        .bg-primary { background-color: #3B82F6; }
        .hover\:bg-secondary:hover { background-color: #1D4ED8; }
        .focus\:ring-primary:focus { --tw-ring-color: #3B82F6; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="px-4 py-6 sm:px-0">
        <div class="max-w-md mx-auto">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900 p-4 sm:p-6 lg:p-8">
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">Complete Profile</h1>
                <p class="text-gray-600 dark:text-gray-300 text-center mb-6">
                    Please complete your profile information
                </p>
                
                <form id="profileForm">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" id="profileEmail" name="email" readonly class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 dark:text-white text-base min-h-[44px]" aria-label="Email">
                    </div>
                    
                    <div class="mb-4">
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Full Name *</label>
                        <input type="text" id="name" name="name" placeholder="Enter your full name" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]" required aria-label="Full Name">
                    </div>
                    
                    <div class="mb-4">
                        <label for="handle" class="block text-sm font-medium text-gray-700 mb-2">Username *</label>
                        <input type="text" id="handle" name="handle" placeholder="Choose a username" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]" required aria-label="Username">
                    </div>                    
                    
                    <div class="mb-4">
                        <label for="dob" class="block text-sm font-medium text-gray-700 mb-2">Date of Birth</label>
                        <input type="date" id="dob" name="dob" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]" aria-label="Date of Birth">
                    </div>
                    
                    <div class="mb-4">
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Phone Number (Optional)</label>
                        <input type="tel" id="phone" name="phone" placeholder="Enter your phone number" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]" aria-label="Phone Number">
                    </div>
                    
                    <div class="mb-4">
                        <label for="bio" class="block text-sm font-medium text-gray-700 mb-2">Bio (Optional)</label>
                        <textarea id="bio" name="bio" rows="3" placeholder="Tell us about yourself..." class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent resize-none text-base" aria-label="Bio"></textarea>
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Profile Image (Optional)</label>
                        <input type="file" id="profileImageFile" name="profileImageFile" accept="image/*" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        <p class="text-xs text-gray-500 mt-1">Select an image file (JPG, PNG, GIF, WebP - Max 5MB)</p>
                    </div>
                    
                    <button type="submit" class="w-full bg-primary text-white py-3 px-6 rounded-lg hover:bg-secondary transition-colors font-semibold mb-4 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Complete Profile">Complete Profile</button>
                    
                    <div class="text-center">
                        <a href="/auth" class="text-sm text-gray-600 hover:text-primary">← Back to Login/Signup</a>
                    </div>
                    
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
            </div>
        </div>
    </div>

    <script>
        window.csrfToken = '<%= csrfToken %>';
        
        document.addEventListener('DOMContentLoaded', function() {
            // Get email from URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const email = urlParams.get('email');
            
            if (email) {
                document.getElementById('profileEmail').value = decodeURIComponent(email);
            }
            
            // Form submission
            document.getElementById('profileForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const formData = new FormData(e.target);
                
                // Handle profile image
                const profileImageFile = formData.get('profileImageFile');
                let finalProfileImage = null;
                
                if (profileImageFile && profileImageFile.size > 0) {
                    try {
                        // Upload file first
                        const uploadFormData = new FormData();
                        uploadFormData.append('profileImage', profileImageFile);
                        
                        const uploadResponse = await fetch('/api/profile/upload', {
                            method: 'POST',
                            body: uploadFormData
                        });
                        
                        if (uploadResponse.ok) {
                            const uploadResult = await uploadResponse.json();
                            finalProfileImage = uploadResult.imageUrl;
                        } else {
                            throw new Error('File upload failed');
                        }
                    } catch (error) {
                        console.error('File upload error:', error);
                        alert('Failed to upload image. Please try again.');
                        return;
                    }
                }
                
                const data = {
                    email: formData.get('email'),
                    name: formData.get('name'),
                    handle: formData.get('handle'),
                    dob: formData.get('dob'),
                    phone: formData.get('phone'),
                    bio: formData.get('bio'),
                    profileImage: finalProfileImage
                };
                
                try {
                    const response = await fetch('/api/auth/signup/profile', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': window.csrfToken
                        },
                        body: JSON.stringify(data)
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        // Store JWT token
                        if (result.token) {
                            localStorage.setItem('jwtToken', result.token);
                            localStorage.setItem('user', JSON.stringify(result.user));
                        }
                        
                        alert('Profile completed successfully!');
                        window.location.href = result.redirect || '/dashboard';
                    } else {
                        alert(result.error || 'Failed to complete profile');
                    }
                } catch (error) {
                    console.error('Profile completion error:', error);
                    alert('Network error. Please try again.');
                }
            });
        });
    </script>
</body>
</html>