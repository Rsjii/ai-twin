<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My AI Twins - AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <div class="px-4 py-6 sm:px-0">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-3xl font-bold text-gray-900 mb-8">My AI Twins</h1>
            
            <% if (twins.length === 0) { %>
                <div class="bg-white rounded-lg shadow p-6 text-center">
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">No Twins Created Yet</h3>
                    <p class="text-gray-600 mb-4">You haven't created any AI twins yet.</p>
                    <a href="/twin/create" class="inline-block bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-blue-600 transition-colors font-semibold">
                        Create Your First Twin
                    </a>
                </div>
            <% } else { %>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% twins.forEach(twin => { %>
                        <div class="bg-white rounded-lg shadow p-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-2">Twin #<%= twin.id.slice(-6) %></h3>
                            <p class="text-sm text-gray-600 mb-4">Created: <%= new Date(twin.createdAt).toLocaleDateString() %></p>
                            
                            <% if (twin.sampleReply) { %>
                                <div class="mb-4">
                                    <h4 class="text-sm font-medium text-gray-700 mb-2">Sample Reply:</h4>
                                    <p class="text-sm text-gray-600 bg-gray-50 p-3 rounded"><%= twin.sampleReply %></p>
                                </div>
                            <% } %>
                            
                            <div class="flex space-x-2">
                                <a href="/chat/<%= twin.id %>" class="flex-1 bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-blue-600 transition-colors text-center text-sm">
                                    Chat
                                </a>
                                <button onclick="deleteTwin('<%= twin.id %>')" class="flex-1 bg-red-500 text-white py-2 px-4 rounded-md hover:bg-red-600 transition-colors text-sm">
                                    Delete
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
            
            <div class="mt-8 text-center">
                <a href="/dashboard" class="text-blue-500 hover:text-blue-600 font-medium">← Back to Dashboard</a>
            </div>
        </div>
    </div>

    <script>
    async function deleteTwin(twinId) {
        if (!confirm('Are you sure you want to delete this twin?')) {
            return;
        }
        
        try {
            const response = await fetch(`/api/twin/${twinId}`, {
                method: 'DELETE',
                credentials: 'include',
                headers: {
                    'X-CSRF-Token': window.csrfToken
                }
            });
            
            if (response.ok) {
                location.reload();
            } else {
                alert('Failed to delete twin');
            }
        } catch (error) {
            console.error('Delete twin error:', error);
            alert('Error deleting twin');
        }
    }
    </script>
</body>
</html>
