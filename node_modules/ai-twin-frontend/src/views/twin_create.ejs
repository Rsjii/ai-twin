<%- include('layout', { title: 'Create Twin - AI Twin', body: `
<div class="px-4 py-6 sm:px-0">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Create Your AI Twin</h1>
        
        <div class="bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-6">Upload Text Samples</h2>
            <p class="text-gray-600 mb-6">
                Paste 3-5 text samples (messages, posts, comments) that represent your communication style. 
                Minimum 100 characters, maximum 3000 characters.
            </p>
            
            <form id="twinForm">
                <div class="mb-6">
                    <label for="samples" class="block text-sm font-medium text-gray-700 mb-2">
                        Text Samples
                    </label>
                    <textarea 
                        id="samples" 
                        name="samples" 
                        rows="10"
                        placeholder="Paste your text samples here... (messages, posts, comments, etc.)"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent resize-none"
                        required
                    ></textarea>
                    <div class="mt-2 text-sm text-gray-500">
                        <span id="charCount">0</span> / 3000 characters
                    </div>
                </div>
                
                <button 
                    type="submit"
                    id="submitBtn"
                    class="w-full bg-primary text-white py-3 px-6 rounded-lg hover:bg-secondary transition-colors font-semibold disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    Create AI Twin
                </button>
                
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            </form>
        </div>
        
        <div id="result" class="mt-8 hidden">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-6">Your AI Twin</h2>
                <div id="twinResult"></div>
            </div>
        </div>
    </div>
</div>

<script>
// Character counter
document.getElementById('samples').addEventListener('input', (e) => {
    const count = e.target.value.length;
    document.getElementById('charCount').textContent = count;
    
    if (count < 100) {
        document.getElementById('charCount').className = 'text-red-500';
    } else if (count > 3000) {
        document.getElementById('charCount').className = 'text-red-500';
    } else {
        document.getElementById('charCount').className = 'text-green-500';
    }
});

document.getElementById('twinForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const samples = formData.get('samples');
    
    if (samples.length < 100) {
        showFlashMessage('Please provide at least 100 characters of text samples.', 'error');
        return;
    }
    
    if (samples.length > 3000) {
        showFlashMessage('Text samples are too long. Maximum 3000 characters allowed.', 'error');
        return;
    }
    
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating Twin...';
    
    try {
        const response = await fetch('/api/twin/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
            body: JSON.stringify({ samples })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            showFlashMessage('AI Twin created successfully!', 'success');
            
            // Show result
            const resultDiv = document.getElementById('result');
            const twinResultDiv = document.getElementById('twinResult');
            
            twinResultDiv.innerHTML = `
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Style Analysis</h3>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <p><strong>Tone:</strong> ${result.twin.styleVector.tone}</p>
                        <p><strong>Emoji Usage:</strong> ${Math.round(result.twin.styleVector.emoji_usage * 100)}%</p>
                        <p><strong>Hinglish Ratio:</strong> ${Math.round(result.twin.styleVector.hinglish_ratio * 100)}%</p>
                        <p><strong>Sentence Length:</strong> ${result.twin.styleVector.sentence_length}</p>
                        <p><strong>Signature Patterns:</strong> ${result.twin.styleVector.signature_patterns.join(', ')}</p>
                    </div>
                </div>
                
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Sample Reply</h3>
                    <div class="bg-blue-50 rounded-lg p-4">
                        <p class="text-gray-800">${result.twin.sampleReply}</p>
                    </div>
                </div>
                
                <div class="flex space-x-4">
                    <button onclick="startChatWithTwin('${result.twin.id}')" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition-colors">
                        Start Chat
                    </button>
                    <a href="/dashboard" class="bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                        Back to Dashboard
                    </a>
                </div>
            `;
            
            resultDiv.classList.remove('hidden');
            resultDiv.scrollIntoView({ behavior: 'smooth' });
            
        } else {
            showFlashMessage(result.error || 'Failed to create AI Twin', 'error');
        }
    } catch (error) {
        console.error('Create twin error:', error);
        showFlashMessage('Network error. Please try again.', 'error');
    } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create AI Twin';
    }
});

async function startChatWithTwin(twinId) {
    try {
        const response = await fetch('/api/chat/start', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
            body: JSON.stringify({ twinId })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            window.location.href = result.redirect;
        } else {
            showFlashMessage(result.error || 'Failed to start chat', 'error');
        }
    } catch (error) {
        console.error('Start chat error:', error);
        showFlashMessage('Network error. Please try again.', 'error');
    }
}
</script>
` }) %>
