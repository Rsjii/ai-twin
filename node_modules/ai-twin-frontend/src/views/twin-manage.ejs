<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444',
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- IMMEDIATE Auth Check -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <!-- Header -->
    <%- include('header') %>    

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">My Twin Management</h1>
            <p class="text-gray-600 dark:text-gray-300">Manage your AI twin's settings, training, and analytics</p>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Chats</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalChats %></p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Views</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalViews %></p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Likes</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalLikes %></p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Followers</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalFollowers %></p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Twin Info Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-8 mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Twin Information</h2>
                <div class="flex space-x-3">
                    <a href="/twin/<%= twinId %>/ai-edit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                        AI Edit
                    </a>
                    <a href="/twin/<%= twinId %>/style-customize" class="px-4 py-2 bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                        Style Customize
                    </a>
                    <a href="/twin/<%= twinId %>/learning-dashboard" class="px-4 py-2 bg-accent text-white rounded-lg hover:bg-purple-600 transition-colors">
                        Learning Dashboard
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Created</p>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">
                        <%= new Date(twin.createdAt || twin.created_at).toLocaleDateString() %>
                    </p>
                </div>
                <% if (publicTwin) { %>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Public Handle</p>
                        <div class="flex items-center space-x-2">
                            <input type="text" readonly value="/@<%= publicTwin.handle %>" id="publicLinkInput" class="flex-1 px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                            <button id="copyPublicLinkBtn" onclick="copyPublicLink()" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                                Copy
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Training Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Memory Chunks</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.memoryChunks %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Style Corrections</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.styleCorrections %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Learning Goals</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.learningGoals %></p>
            </div>
        </div>

        <!-- Recent Chats -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Recent Chats</h2>
            <% if (recentChats && recentChats.length > 0) { %>
                <div class="space-y-4">
                    <% recentChats.forEach(chat => { %>
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-white"><%= chat.title || 'Untitled Chat' %></p>
                                <p class="text-sm text-gray-600 dark:text-gray-300">
                                    <%= chat.message_count || 0 %> messages • 
                                    <%= new Date(chat.createdAt || chat.created_at).toLocaleDateString() %>
                                </p>
                            </div>
                            <a href="/chat-enhanced?chatId=<%= chat.id %>" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                                Open
                            </a>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-gray-600 dark:text-gray-300">No recent chats</p>
            <% } %>
        </div>
    </main>

    <script>
        // Copy Public Link function
        window.copyPublicLink = function() {
            try {
                const input = document.getElementById('publicLinkInput');
                if (!input) {
                    console.error('Input element not found');
                    return;
                }
                
                const url = window.location.origin + input.value;
                console.log('Copying URL:', url);
                
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(() => {
                        alert('Public link copied to clipboard!');
                    }).catch(err => {
                        console.error('Copy failed:', err);
                        alert('Failed to copy link');
                    });
                } else {
                    // Fallback for older browsers
                    input.select();
                    document.execCommand('copy');
                    alert('Public link copied to clipboard!');
                }
            } catch (error) {
                console.error('Error copying link:', error);
                alert('Failed to copy link');
            }
        };

        // Logout function
        function logout() {
            if (confirm('Are you sure you want to sign out?')) {
                window.location.href = '/api/auth/logout';
            }
        }
    </script>
    <!--Footer-->
    <%- include('footer') %>
</body>
</html>