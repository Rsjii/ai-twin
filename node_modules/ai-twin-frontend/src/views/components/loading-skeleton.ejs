<!-- Skeleton Loader Component -->
<div class="skeleton-container">
    <% if (type === 'card') { %>
        <div class="skeleton skeleton-card mb-4"></div>
    <% } else if (type === 'stats') { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
            <% for (let i = 0; i < (count || 3); i++) { %>
                <div class="bg-white dark:bg-gray-800 rounded-xl p-4 sm:p-6 border border-gray-100 dark:border-gray-700">
                    <div class="skeleton skeleton-text w-24 mb-2"></div>
                    <div class="skeleton skeleton-title mb-4"></div>
                    <div class="skeleton skeleton-text w-16"></div>
                </div>
            <% } %>
        </div>
    <% } else if (type === 'twin-card') { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
            <% for (let i = 0; i < (count || 4); i++) { %>
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="skeleton skeleton-avatar"></div>
                        <div class="flex-1">
                            <div class="skeleton skeleton-text w-24 mb-2"></div>
                            <div class="skeleton skeleton-text w-32"></div>
                        </div>
                    </div>
                    <div class="skeleton skeleton-text mb-2"></div>
                    <div class="skeleton skeleton-text mb-2"></div>
                    <div class="skeleton skeleton-text w-3/4"></div>
                </div>
            <% } %>
        </div>
    <% } else if (type === 'list') { %>
        <div class="space-y-4">
            <% for (let i = 0; i < (count || 5); i++) { %>
                <div class="flex items-center space-x-4 p-4 bg-white dark:bg-gray-800 rounded-lg">
                    <div class="skeleton skeleton-avatar"></div>
                    <div class="flex-1">
                        <div class="skeleton skeleton-text w-32 mb-2"></div>
                        <div class="skeleton skeleton-text w-24"></div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } else if (type === 'chart') { %>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-4 sm:p-6 border border-gray-100 dark:border-gray-700">
            <div class="skeleton skeleton-text w-40 mb-4"></div>
            <div class="skeleton skeleton-card" style="height: 300px;"></div>
        </div>
    <% } else { %>
        <!-- Default skeleton -->
        <div class="skeleton skeleton-text"></div>
    <% } %>
</div>