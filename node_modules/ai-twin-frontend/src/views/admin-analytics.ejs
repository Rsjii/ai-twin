                let response;
                if (timePeriod === 'all') {
                    // Load all-time detailed data
                    response = await fetch(`/api/admin/analytics/detailed/${type}`);
                } else {
                    // Load time-based detailed data
                    response = await fetch(`/api/admin/analytics/time/${timePeriod}`);
                }
                
                const data = await response.json();
                console.log(`Detailed ${type} data for ${timePeriod}:`, data);
                
                if (data.success) {
                    const content = document.getElementById('detailedModalContent');
                    if (timePeriod === 'all') {
                        content.innerHTML = generateDetailedContent(type, data.data);
                    } else {
                        // For time-based data, show summary and breakdown
                        content.innerHTML = generateTimeBasedDetailedContent(type, data.data, timePeriod);
                    }
                } else {
                    document.getElementById('detailedModalContent').innerHTML = '<p class="text-red-600">Error: ' + data.error + '</p>';
                }
            } catch (error) {
                console.error('Detailed data error:', error);
                document.getElementById('detailedModalContent').innerHTML = '<p class="text-red-600">Error loading detailed data: ' + error.message + '</p>';
            }
        }
        
