        // Global state for current time period
        let currentTimePeriod = 'today';
        let currentAnalyticsData = null;

        // Time-based analytics loading
        async function loadTimeBasedAnalytics(period) {
            try {
                console.log(`Loading ${period} analytics...`);
                
                // Update active button
                document.querySelectorAll('.time-filter-btn').forEach(btn => {
                    btn.classList.remove('bg-blue-600', 'text-white');
                    btn.classList.add('bg-gray-100', 'text-gray-700');
                });
                
                // Find the clicked button and update its style
                const buttons = document.querySelectorAll('.time-filter-btn');
                buttons.forEach(btn => {
                    if (btn.textContent.trim().toLowerCase().includes(period.toLowerCase()) || 
                        (period === 'today' && btn.textContent.trim().toLowerCase().includes('today')) ||
                        (period === 'week' && btn.textContent.trim().toLowerCase().includes('7 days')) ||
                        (period === 'month' && btn.textContent.trim().toLowerCase().includes('monthly')) ||
                        (period === 'all' && btn.textContent.trim().toLowerCase().includes('all time'))) {
                        btn.classList.remove('bg-gray-100', 'text-gray-700');
                        btn.classList.add('bg-blue-600', 'text-white');
                    }
                });
                
                currentTimePeriod = period;
                
                let response;
                if (period === 'all') {
                    // Load all-time data
                    response = await fetch('/api/admin/analytics/dashboard');
                } else {
                    // Load time-based data
                    response = await fetch(`/api/admin/analytics/time/${period}`);
                }
                
                const data = await response.json();
                console.log(`${period} analytics data:`, data);
                
                if (data.success) {
                    currentAnalyticsData = data.data || data.metrics;
                    
                    if (period === 'all') {
                        // Update with all-time data
                        document.getElementById('totalUsers').textContent = data.metrics.lifetime.users;
                        document.getElementById('totalTwins').textContent = data.metrics.lifetime.twins;
                        document.getElementById('totalChats').textContent = data.metrics.lifetime.chats;
                        document.getElementById('totalMessages').textContent = data.metrics.lifetime.messages;
                    } else {
                        // Update with time-based data
                        document.getElementById('totalUsers').textContent = data.data.summary.users;
                        document.getElementById('totalTwins').textContent = data.data.summary.twins;
                        document.getElementById('totalChats').textContent = data.data.summary.chats;
                        document.getElementById('totalMessages').textContent = data.data.summary.messages;
                    }
                    
                    // Update charts with new data
                    if (period !== 'all') {
                        createTimeBasedChart(data.data.breakdown, period);
                    }
                    
                    // Show success message
                    showNotification(`Loaded ${period} analytics successfully!`, 'success');
                } else {
                    showNotification(`Error loading ${period} analytics: ${data.error}`, 'error');
                }
            } catch (error) {
                console.error('Time-based analytics error:', error);
                showNotification(`Error loading ${period} analytics: ${error.message}`, 'error');
            }
        }
        
