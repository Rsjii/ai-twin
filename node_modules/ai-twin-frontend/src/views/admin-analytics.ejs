                            <div>
                                <p class="text-sm text-gray-600">Active</p>
                                <p class="font-medium">${userData.user.active ? 'Yes' : 'No'}</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- User Stats -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-blue-50 p-4 rounded-lg text-center">
                            <p class="text-2xl font-bold text-blue-600">${userData.stats.twins}</p>
                            <p class="text-sm text-blue-800">Twins</p>
                        </div>
                        <div class="bg-green-50 p-4 rounded-lg text-center">
                            <p class="text-2xl font-bold text-green-600">${userData.stats.chats}</p>
                            <p class="text-sm text-green-800">Chats</p>
                        </div>
                        <div class="bg-purple-50 p-4 rounded-lg text-center">
                            <p class="text-2xl font-bold text-purple-600">${userData.stats.messages}</p>
                            <p class="text-sm text-purple-800">Messages</p>
                        </div>
                        <div class="bg-orange-50 p-4 rounded-lg text-center">
                            <p class="text-2xl font-bold text-orange-600">${userData.stats.events}</p>
                            <p class="text-sm text-orange-800">Events</p>
                        </div>
                    </div>
                    
                    <!-- Recent Activity -->
                    <div class="bg-white border rounded-lg p-4">
                        <h4 class="font-semibold mb-3">Recent Activity</h4>
                        <div class="space-y-2 max-h-48 overflow-y-auto">
                            ${userData.events.slice(0, 10).map(event => `
                                <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
                                    <div>
                                        <p class="text-sm font-medium">${event.type}</p>
                                        <p class="text-xs text-gray-600">${new Date(event.createdAt).toLocaleString()}</p>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    
                    <!-- Action Buttons -->
                    <div class="flex space-x-4">
                        <button onclick="removeUser('${userData.user.id}')" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                            Remove User
                        </button>
                        <button onclick="closeUserModal()" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                            Close
                        </button>
                    </div>
                </div>
            `;
        }
        
        // Remove user
        async function removeUser(userId) {
            if (confirm('Are you sure you want to remove this user? This action cannot be undone.')) {
                try {
                    const response = await fetch(`/api/admin/analytics/user/${userId}`, {
                        method: 'DELETE'
                    });
                    const data = await response.json();
                    
                    if (data.success) {
                        alert('User removed successfully');
                        loadAdminAnalytics(); // Refresh data
                        closeUserModal();
                    } else {
                        alert('Error removing user: ' + data.error);
                    }
                } catch (error) {
                    console.error('Remove user error:', error);
                    alert('Error removing user');
                }
            }
        }
        
        // Modal functions
        function closeUserModal() {
            document.getElementById('userModal').classList.add('hidden');
        }
        
        function closeDetailedModal() {
            document.getElementById('detailedModal').classList.add('hidden');
        }
        
        // Close modals when clicking outside
        document.addEventListener('click', (e) => {
            if (e.target.id === 'userModal') closeUserModal();
            if (e.target.id === 'detailedModal') closeDetailedModal();
        });
        
        // Load users list
        async function loadUsersList(search = '') {
            try {
                console.log('Loading users list...');
                const url = search ? `/api/admin/analytics/users?search=${encodeURIComponent(search)}` : '/api/admin/analytics/users';
                const response = await fetch(url);
                const data = await response.json();
                
                console.log('Users list data:', data);
                
                if (data.success) {
                    const usersList = document.getElementById('usersList');
                    if (data.data.users && data.data.users.length > 0) {
                        usersList.innerHTML = data.data.users.map(user => `
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer" onclick="viewUserDetails('${user.id}')">
                                <div class="flex items-center space-x-4">
                                    <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold">
                                        ${(user.handle || user.email).charAt(0).toUpperCase()}
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900">${user.handle || 'No handle'}</p>
                                        <p class="text-sm text-gray-600">${user.email}</p>
                                        <p class="text-xs text-gray-500">Joined: ${new Date(user.createdAt).toLocaleDateString()}</p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <div class="text-center">
                                        <p class="text-sm font-medium text-gray-900">${user.twinCount || 0}</p>
                                        <p class="text-xs text-gray-500">Twins</p>
                                    </div>
                                    <div class="text-center">
                                        <p class="text-sm font-medium text-gray-900">${user.chatCount || 0}</p>
                                        <p class="text-xs text-gray-500">Chats</p>
                                    </div>
                                    <div class="text-center">
                                        <p class="text-sm font-medium text-gray-900">${user.eventCount || 0}</p>
                                        <p class="text-xs text-gray-500">Events</p>
                                    </div>
                                    <div class="flex space-x-2">
                                        <button onclick="event.stopPropagation(); viewUserDetails('${user.id}')" class="px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200">
                                            View
                                        </button>
                                        <button onclick="event.stopPropagation(); removeUser('${user.id}')" class="px-3 py-1 bg-red-100 text-red-700 rounded text-sm hover:bg-red-200">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        usersList.innerHTML = '<p class="text-gray-500 text-center py-8">No users found</p>';
                    }
                } else {
                    document.getElementById('usersList').innerHTML = '<p class="text-red-600">Error loading users: ' + data.error + '</p>';
                }
            } catch (error) {
                console.error('Load users error:', error);
                document.getElementById('usersList').innerHTML = '<p class="text-red-600">Error loading users: ' + error.message + '</p>';
            }
        }
        
        // Search users
        function searchUsers() {
            const searchInput = document.getElementById('userSearchInput');
            const searchTerm = searchInput.value.trim();
            console.log('Searching users:', searchTerm);
            loadUsersList(searchTerm);
        }
        
        // Add search functionality
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('userSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', debounce(searchUsers, 300));
            }
        });
        
        // Debounce function for search
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }
        
        // Notification function
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg transition-all duration-300 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                type === 'warning' ? 'bg-yellow-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        // Test click functionality
        function testClickFunctionality() {
            console.log('=== TESTING CLICK FUNCTIONALITY ===');
            console.log('showDetailedView function exists:', typeof showDetailedView);
            console.log('Testing showDetailedView with users...');
            showDetailedView('users');
        }

        // Alternative click handler using event delegation
        document.addEventListener('click', (e) => {
            if (e.target.closest('.metric-card')) {
                const card = e.target.closest('.metric-card');
                const type = card.getAttribute('data-type');
                if (type) {
                    console.log(`=== ALTERNATIVE CLICK HANDLER TRIGGERED FOR ${type.toUpperCase()} ===`);
                    showDetailedView(type);
                }
            }
        });

        // Load analytics on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadAdminAnalytics();
            loadUsersList();
            
            // Test click functionality after 2 seconds
            setTimeout(() => {
                console.log('=== ADMIN ANALYTICS DASHBOARD LOADED ===');
                console.log('Click functionality test available - call testClickFunctionality() in console');
                console.log('Alternative click handler also available via event delegation');
            }, 2000);
        });
    </script>
</body>
</html>
