            console.log(`=== CLICKING DETAILED VIEW FOR ${type.toUpperCase()} ===`);
            console.log(`Opening detailed page for ${type}`);
            console.log(`URL: /admin/analytics/page/${type}`);
            
            // Open detailed page in new window/tab
            const newWindow = window.open(`/admin/analytics/page/${type}`, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
            
