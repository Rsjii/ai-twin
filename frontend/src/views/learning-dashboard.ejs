    milestoneElement.className = `flex items-center justify-between p-3 ${milestone.completed ? 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800' : 'bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700'} rounded-lg`;

milestoneElement.innerHTML = `
  <div class="flex items-center space-x-3">
    <div class="text-2xl">${milestone.icon}</div>
    <div>
      <p class="text-sm font-medium ${milestone.completed ? 'text-green-800 dark:text-green-300' : 'text-gray-800 dark:text-gray-300'}">${milestone.name}</p>
      <p class="text-xs ${milestone.completed ? 'text-green-600 dark:text-green-400' : 'text-gray-600 dark:text-gray-400'}">${milestone.description}</p>
    </div>
  </div>      
      <div class="text-right">
        <p class="text-sm font-bold ${milestone.completed ? 'text-green-800' : 'text-gray-800'}">${milestone.progress}%</p>
        <div class="w-16 ${milestone.completed ? 'bg-green-200' : 'bg-gray-200'} rounded-full h-2">
          <div class="${milestone.completed ? 'bg-green-600' : 'bg-gray-600'} h-2 rounded-full" style="width: ${milestone.progress}%"></div>
        </div>
      </div>
    `;
    
    if (milestone.completed) {
      currentContainer.appendChild(milestoneElement);
    } else {
      upcomingContainer.appendChild(milestoneElement);
    }
  });
}

// Update goals display
function updateGoalsDisplay(goals) {
  learningGoals = goals;
}

// Set learning goal
async function setLearningGoal() {
  const goalType = document.getElementById('goalType').value;
  const target = parseInt(document.getElementById('goalTarget').value);
  
  if (!target || target < 1) {
    showNotification('Please enter a valid target number', 'error');
    return;
  }
  
  try {
    const response = await fetch(`/api/twin/${twinToken}/goals`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({
        type: goalType,
        target: target
      })
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification('Learning goal set successfully!');
      document.getElementById('goalTarget').value = '';
      loadLearningMilestones();
    } else {
      showNotification('Error: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('Error setting goal:', error);
    showNotification('Error setting learning goal', 'error');
  }
}

// Performance Optimization
let performanceMetrics = {
  responseTime: 0,
  accuracyScore: 0,
  learningRate: 0,
  userSatisfaction: 0
};

// Load performance metrics
async function loadPerformanceMetrics() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/performance`);
    const data = await response.json();
    
    if (data.success) {
      performanceMetrics = data.metrics;
      updatePerformanceDisplay();
      updateOptimizationRecommendations(data.recommendations);
    }
  } catch (error) {
    console.error('Error loading performance metrics:', error);
  }
}

// Update performance display
function updatePerformanceDisplay() {
  document.getElementById('responseTime').textContent = performanceMetrics.responseTime + 'ms';
  document.getElementById('accuracyScore').textContent = performanceMetrics.accuracyScore + '%';
  document.getElementById('learningRate').textContent = performanceMetrics.learningRate + '%';
  document.getElementById('userSatisfaction').textContent = performanceMetrics.userSatisfaction + '%';
}

// Update optimization recommendations
function updateOptimizationRecommendations(recommendations) {
  const container = document.getElementById('optimizationRecommendations');
  container.innerHTML = '';
  
  recommendations.forEach(rec => {
    const recElement = document.createElement('div');
    recElement.className = `p-3 ${rec.type === 'warning' ? 'bg-yellow-50 border border-yellow-200' : 'bg-blue-50 border border-blue-200'} rounded-lg`;
    recElement.innerHTML = `
      <div class="flex items-start space-x-3">
        <div class="${rec.type === 'warning' ? 'text-yellow-600' : 'text-blue-600'} mt-1">${rec.icon}</div>
        <div>
          <p class="text-sm font-medium ${rec.type === 'warning' ? 'text-yellow-800' : 'text-blue-800'}">${rec.title}</p>
          <p class="text-xs ${rec.type === 'warning' ? 'text-yellow-700' : 'text-blue-700'}">${rec.description}</p>
        </div>
      </div>
    `;
    container.appendChild(recElement);
  });
}

// Optimize memories
async function optimizeMemories() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/optimize/memories`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification(`Optimized ${data.optimized} memories successfully!`);
      loadPerformanceMetrics();
    } else {
      showNotification('Error: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('Error optimizing memories:', error);
    showNotification('Error optimizing memories', 'error');
  }
}

// Analyze performance
async function analyzePerformance() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/analyze/performance`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification('Performance analysis completed!');
      loadPerformanceMetrics();
    } else {
      showNotification('Error: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('Error analyzing performance:', error);
    showNotification('Error analyzing performance', 'error');
  }
}

// Export analytics
async function exportAnalytics() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/export/analytics`);
    const data = await response.json();
    
    if (data.success) {
      // Create download link
      const blob = new Blob([JSON.stringify(data.analytics, null, 2)], { type: 'application/json' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `twin-${twinToken}-analytics.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
      
      showSuccessNotification('Analytics exported successfully!');
    } else {
      showNotification('Error: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('Error exporting analytics:', error);
    showNotification('Error exporting analytics', 'error');
  }
}

// Reset performance metrics
async function resetPerformanceMetrics() {
  const confirmed = await window.ModalHelpers.confirm({
    title: 'Reset Performance Metrics?',
    message: 'Are you sure you want to reset all performance metrics? This action cannot be undone.',
    confirmLabel: 'Reset',
    cancelLabel: 'Cancel',
    type: 'danger'
  });
  if (confirmed) {
    try {
      const response = await fetch(`/api/twin/${twinToken}/reset/performance`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        }
      });
      
      const data = await response.json();
      if (data.success) {
        showSuccessNotification('Performance metrics reset successfully!');
        loadPerformanceMetrics();
      } else {
        showNotification('Error: ' + data.error, 'error');
      }
    } catch (error) {
      console.error('Error resetting performance:', error);
      showNotification('Error resetting performance metrics', 'error');
    }
  }
}

// Regenerate system prompt
async function regenerateSystemPrompt() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/regenerate-prompt`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSuccessNotification('System prompt regenerated successfully!');
    } else {
      showNotification('Error: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('Error regenerating system prompt:', error);
    showNotification('Error regenerating system prompt', 'error');
  }
}

// Add event listener for regenerate prompt button
document.getElementById('regeneratePrompt').addEventListener('click', regenerateSystemPrompt);

// Initialize Phase 2F functionality
document.addEventListener('DOMContentLoaded', function() {
  // Load advanced features
  loadLearningMilestones();
  loadPerformanceMetrics();
  
  // Template events
  document.getElementById('useTemplate').addEventListener('click', useTemplate);
  document.getElementById('closeTemplate').addEventListener('click', closeTemplate);
  
  // Goal setting events
  document.getElementById('setGoal').addEventListener('click', setLearningGoal);
  
  // Performance events
  document.getElementById('optimizeMemories').addEventListener('click', optimizeMemories);
  document.getElementById('analyzePerformance').addEventListener('click', analyzePerformance);
  document.getElementById('exportAnalytics').addEventListener('click', exportAnalytics);
  document.getElementById('resetPerformance').addEventListener('click', resetPerformanceMetrics);
});

// Global functions for template loading
window.loadTemplate = loadTemplate;
window.triggerManualSync = triggerManualSync;

// Load learning settings (autoLearning + learningSensitivity) from backend
async function loadLearningSettings() {
  try {
    if (!twinToken) return;

    const response = await fetch(`/api/twin/${twinToken}/learning-settings`, {
      method: 'GET',
      credentials: 'include',
    });
    const data = await response.json();

    if (data.success && data.settings) {
      const { autoLearning, learningSensitivity } = data.settings;
      const autoEl = document.getElementById('autoLearning');
      const sensEl = document.getElementById('learningSensitivity');

      if (autoEl) {
        autoEl.value = autoLearning ? 'enabled' : 'disabled';
      }
      if (sensEl && learningSensitivity) {
        sensEl.value = learningSensitivity;
      }
    }
  } catch (error) {
    console.error('Error loading learning settings:', error);
  }
}
