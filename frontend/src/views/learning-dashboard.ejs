    </div>

    <script>
        // ✅ SECURITY: Use tokenized twinToken instead of raw twinToken
        const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : "" %>';
        const csrfToken = '<%= csrfToken %>';
        
        let currentChatOffset = 0;
        let currentMemoryOffset = 0;
        let currentAnchorOffset = 0;
        const pageSize = 10;
    
        // Load learning data
        async function loadLearningData() {
            console.log('[LEARNING] ========== START loadLearningData ==========');
            console.log('[LEARNING] Twin ID:', twinToken);
            
            // Show loading for learning events
            const eventsLoading = document.getElementById('learningEventsLoadingState');
            const eventsEmpty = document.getElementById('learningEventsEmptyState');
            const eventsError = document.getElementById('learningEventsErrorState');
            const eventsContainer = document.getElementById('learningEvents');
            
            console.log('[LEARNING] DOM Elements check:', {
                eventsLoading: !!eventsLoading,
                eventsEmpty: !!eventsEmpty,
                eventsError: !!eventsError,
                eventsContainer: !!eventsContainer
            });
            
            if (eventsLoading) eventsLoading.classList.remove('hidden');
            if (eventsEmpty) eventsEmpty.classList.add('hidden');
            if (eventsError) eventsError.classList.add('hidden');
            
            try {
                console.log('[LEARNING] Fetching from:', `/api/twin/${twinToken}/learning-data`);
                const response = await fetch(`/api/twin/${twinToken}/learning-data`, {
                    method: 'GET',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                console.log('[LEARNING] Response status:', {
                    status: response.status,
                    statusText: response.statusText,
                    ok: response.ok,
                    headers: Object.fromEntries(response.headers.entries())
                });
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('[LEARNING] ❌ API error:', {
                        status: response.status,
                        statusText: response.statusText,
                        errorText: errorText
                    });
                    throw new Error(`Learning data API failed: ${response.status}`);
                }
                
                const data = await response.json();
                console.log('[LEARNING] Full response data:', JSON.stringify(data, null, 2));
                console.log('[LEARNING] Response structure check:', {
                    hasSuccess: 'success' in data,
                    successValue: data.success,
                    hasLearning: 'learning' in data,
                    learningKeys: data.learning ? Object.keys(data.learning) : null,
                    totalInteractions: data.learning?.totalInteractions,
                    learningScore: data.learning?.learningScore,
                    styleAccuracy: data.learning?.styleAccuracy,
                    hasEvents: Array.isArray(data.learning?.events),
                    eventsLength: data.learning?.events?.length || 0
                });
                
                if (data.success) {
                    console.log('[LEARNING] ✅ Success=true, processing data...');
                    // Hide loading
                    if (eventsLoading) eventsLoading.classList.add('hidden');
                    if (eventsError) eventsError.classList.add('hidden');
                    
                    // ✅ FIX: Check if learning data exists
                    if (!data.learning) {
                        console.warn('[LEARNING] ⚠️ No learning data in response, using defaults');
                        data.learning = {
                            totalInteractions: 0,
                            learningScore: 0,
                            styleAccuracy: 0,
                            events: []
                        };
                    }
                    
                    console.log('[LEARNING] Calling updateLearningProgress with:', data.learning);
                    updateLearningProgress(data.learning);
                    
                    // Show empty if no events
                    if (!data.learning.events || data.learning.events.length === 0) {
                        console.log('[LEARNING] ⚠️ No events found, showing empty state');
                        if (eventsEmpty) eventsEmpty.classList.remove('hidden');
                    } else {
                        console.log('[LEARNING] ✅ Events found:', data.learning.events.length);
                        if (eventsEmpty) eventsEmpty.classList.add('hidden');
                    }
                    console.log('[LEARNING] ========== END loadLearningData (SUCCESS) ==========');
                } else {
                    console.error('[LEARNING] ❌ Success=false in response');
                    // Hide loading, show error
                    if (eventsLoading) eventsLoading.classList.add('hidden');
                    if (eventsEmpty) eventsEmpty.classList.add('hidden');
                    if (eventsError) eventsError.classList.remove('hidden');
                }
            } catch (error) {
                console.error('[LEARNING] ========== ERROR in loadLearningData ==========');
                console.error('[LEARNING] Error object:', error);
                console.error('[LEARNING] Error message:', error.message);
                console.error('[LEARNING] Error stack:', error.stack);
                // Hide loading, show error
                if (eventsLoading) eventsLoading.classList.add('hidden');
                if (eventsEmpty) eventsEmpty.classList.add('hidden');
                if (eventsError) eventsError.classList.remove('hidden');
                console.log('[LEARNING] ========== END loadLearningData (ERROR) ==========');
            }
        }
    
        // Chart instance
        let styleChart = null;
        
        function initializeChart(learningData) {
    console.log('[LEARNING_CHART] ========== START initializeChart ==========');
    console.log('[LEARNING_CHART] Input data:', learningData);
    
    try {
        // Wait for Chart.js
        if (typeof Chart === 'undefined') {
            console.warn('[LEARNING_CHART] ⚠️ Chart.js not loaded yet, retrying...');
            setTimeout(() => initializeChart(learningData), 100);
            return;
        }
        console.log('[LEARNING_CHART] ✅ Chart.js is loaded');

        const canvas = document.getElementById('styleChart');
        if (!canvas) {
            console.error('[LEARNING_CHART] ❌ styleChart canvas not found');
            return;
        }
        console.log('[LEARNING_CHART] ✅ Canvas element found');
        
        const ctx = canvas.getContext('2d');
        if (!ctx) {
            console.error('[LEARNING_CHART] ❌ Could not get canvas context');
            return;
        }
        console.log('[LEARNING_CHART] ✅ Canvas context obtained');
        
        // Destroy existing chart if it exists
        if (styleChart) {
            console.log('[LEARNING_CHART] Destroying existing chart instance');
            styleChart.destroy();
            styleChart = null;
        }
        
        // Validate learningData
        if (!learningData) {
            console.warn('[LEARNING_CHART] ⚠️ No learning data available for chart');
            return;
        }
        
        const learningScore = Number(learningData.learningScore) || 0;
        const styleAccuracy = Number(learningData.styleAccuracy) || 0;
        
        console.log('[LEARNING_CHART] Processed values:', {
            learningScore,
            styleAccuracy,
            learningScoreType: typeof learningScore,
            styleAccuracyType: typeof styleAccuracy
        });
        
        // Create new chart
        const chartData = {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
            datasets: [{
                label: 'Learning Score',
                data: [
                    Math.max(0, learningScore - 20),
                    Math.max(0, learningScore - 10),
                    learningScore,
                    Math.min(100, learningScore + 5)
                ],
                borderColor: 'rgb(99, 102, 241)',
                backgroundColor: 'rgba(99, 102, 241, 0.1)',
                tension: 0.4,
                fill: true
            }, {
                label: 'Style Accuracy',
                data: [
                    Math.max(0, styleAccuracy - 15),
                    Math.max(0, styleAccuracy - 5),
                    styleAccuracy,
                    Math.min(100, styleAccuracy + 3)
                ],
                borderColor: 'rgb(139, 92, 246)',
                backgroundColor: 'rgba(139, 92, 246, 0.1)',
                tension: 0.4,
                fill: true
            }]
        };
        
        console.log('[LEARNING_CHART] Chart data prepared:', {
            labels: chartData.labels,
            datasetsCount: chartData.datasets.length,
            learningScoreData: chartData.datasets[0].data,
            styleAccuracyData: chartData.datasets[1].data
        });
        
        console.log('[LEARNING_CHART] Creating Chart.js instance...');
        styleChart = new Chart(ctx, {
            type: 'line',
            data: chartData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                }
            }
        });
        console.log('[LEARNING_CHART] ✅ Chart created successfully');
        console.log('[LEARNING_CHART] ========== END initializeChart (SUCCESS) ==========');
    } catch (error) {
        console.error('[LEARNING_CHART] ========== ERROR in initializeChart ==========');
        console.error('[LEARNING_CHART] Error object:', error);
        console.error('[LEARNING_CHART] Error message:', error.message);
        console.error('[LEARNING_CHART] Error stack:', error.stack);
        console.log('[LEARNING_CHART] ========== END initializeChart (ERROR) ==========');
    }
}

// Update learning progress display
function updateLearningProgress(learning) {
    console.log('[LEARNING_PROGRESS] ========== START updateLearningProgress ==========');
    console.log('[LEARNING_PROGRESS] Input data:', learning);
    
    if (!learning) {
        console.warn('[LEARNING_PROGRESS] ⚠️ No learning data provided');
        return;
    }
    
    const totalInteractionsEl = document.getElementById('totalInteractions');
    const learningScoreEl = document.getElementById('learningScore');
    const styleAccuracyEl = document.getElementById('styleAccuracy');
    
    console.log('[LEARNING_PROGRESS] DOM Elements check:', {
        totalInteractions: !!totalInteractionsEl,
        learningScore: !!learningScoreEl,
        styleAccuracy: !!styleAccuracyEl
    });
    
    // ✅ FIX: Use safe navigation
    const totalInteractions = learning.totalInteractions || 0;
    const learningScore = learning.learningScore || 0;
    const styleAccuracy = learning.styleAccuracy || 0;
    
    console.log('[LEARNING_PROGRESS] Values to set:', {
        totalInteractions,
        learningScore,
        styleAccuracy
    });
    
    if (totalInteractionsEl) totalInteractionsEl.textContent = totalInteractions;
    if (learningScoreEl) learningScoreEl.textContent = learningScore + '%';
    if (styleAccuracyEl) styleAccuracyEl.textContent = styleAccuracy + '%';
    
    console.log('[LEARNING_PROGRESS] ✅ Progress values updated');
    
    // ✅ Initialize chart AFTER DOM is ready and data is available
    // Wait a bit to ensure Chart.js is loaded
    console.log('[LEARNING_PROGRESS] Scheduling chart initialization in 300ms...');
    setTimeout(() => {
        console.log('[LEARNING_PROGRESS] Calling initializeChart...');
        initializeChart(learning);
    }, 300);
    
    const eventsContainer = document.getElementById('learningEvents');
    const eventsLoading = document.getElementById('learningEventsLoadingState');
    const eventsEmpty = document.getElementById('learningEventsEmptyState');
    const eventsError = document.getElementById('learningEventsErrorState');
    
    // Hide all states first
    if (eventsLoading) eventsLoading.classList.add('hidden');
    if (eventsError) eventsError.classList.add('hidden');           
            
            if (learning.events && learning.events.length > 0) {
                // Hide empty state, show events
                if (eventsEmpty) eventsEmpty.classList.add('hidden');
                // Clear container but keep state divs
                const existingContent = eventsContainer.querySelectorAll(':not(#learningEventsLoadingState):not(#learningEventsEmptyState):not(#learningEventsErrorState)');
                existingContent.forEach(el => el.remove());
                
                // Add events
                learning.events.forEach(event => {
                    const eventDiv = document.createElement('div');
                    eventDiv.className = 'flex items-center space-x-3 p-2 bg-gray-50 dark:bg-gray-700 rounded';
                    eventDiv.innerHTML = `
                        <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                        <div class="flex-1">
                            <p class="text-sm text-gray-900 dark:text-white">${event.description || 'Learning event'}</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 timestamp-display" data-timestamp="${event.timestamp}" data-format="context"></p>                            
                        </div>
                    `;
                    eventsContainer.appendChild(eventDiv);
                });
                
                // ✅ Format timestamps client-side after rendering
                if (window.TimeUtils) {
                    setTimeout(() => {
                        eventsContainer.querySelectorAll('.timestamp-display').forEach(el => {
                            const timestamp = el.dataset.timestamp;
                            const format = el.dataset.format || 'context';
                            if (timestamp) {
                                try {
                                    let displayTime, fullTime;
                                    if (format === 'context') {
                                        displayTime = window.TimeUtils.formatTimeWithContext(timestamp);
                                        fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                    } else {
                                        displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                        fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                    }
                                    el.textContent = displayTime;
                                    el.title = fullTime;
                                } catch (e) {
                                    console.error('Error formatting timestamp:', e);
                                }
                            }
                        });
                    }, 100);
                }
            } else {
                // ✅ Show empty state and a clear message when there is no data
                if (eventsEmpty) eventsEmpty.classList.remove('hidden');
                const existingContent = eventsContainer.querySelectorAll(':not(#learningEventsLoadingState):not(#learningEventsEmptyState):not(#learningEventsErrorState)');
                existingContent.forEach(el => el.remove());

                // Optional: if literally zero interactions, replace the chart with a message
                if (!learning.totalInteractions || learning.totalInteractions === 0) {
                    const chartCanvas = document.getElementById('styleChart');
                    if (chartCanvas && chartCanvas.parentElement && !chartCanvas.parentElement.querySelector('.no-data-label')) {
                        const wrapper = chartCanvas.parentElement;
                        const p = document.createElement('p');
                        p.className = 'no-data-label mt-8 text-sm text-gray-500 dark:text-gray-400 text-center';
                        p.textContent = 'No learning data yet. Chat with your twin to see learning progress here.';
                        wrapper.innerHTML = '';
                        wrapper.appendChild(p);
                    }
                }
            }
        }
    
        // Load chat history
        async function loadChatHistory() {
            // Show loading, hide empty/error
            const loadingState = document.getElementById('chatHistoryLoadingState');
            const emptyState = document.getElementById('chatHistoryEmptyState');
            const errorState = document.getElementById('chatHistoryErrorState');
            const container = document.getElementById('chatHistoryList');
            
            if (loadingState) loadingState.classList.remove('hidden');
            if (emptyState) emptyState.classList.add('hidden');
            if (errorState) errorState.classList.add('hidden');
            
            try {
                const response = await fetch(`/api/twin/${twinToken}/chat-history?limit=${pageSize}&offset=${currentChatOffset}`);
                const data = await response.json();
                
                if (data.success) {
                    // Hide loading
                    if (loadingState) loadingState.classList.add('hidden');
                    if (errorState) errorState.classList.add('hidden');
                    
                    // Show empty state if no chats
                    if (data.chats && data.chats.length === 0 && currentChatOffset === 0) {
                        if (emptyState) emptyState.classList.remove('hidden');
                    } else {
                        if (emptyState) emptyState.classList.add('hidden');
                        displayChatHistory(data.chats);
                    }
                } else {
                    // Hide loading, show error
                    if (loadingState) loadingState.classList.add('hidden');
                    if (emptyState) emptyState.classList.add('hidden');
                    if (errorState) errorState.classList.remove('hidden');
                }
            } catch (error) {
                console.error('Error loading chat history:', error);
                // Hide loading, show error
                if (loadingState) loadingState.classList.add('hidden');
                if (emptyState) emptyState.classList.add('hidden');
                if (errorState) errorState.classList.remove('hidden');
            }
        }
    
        // Display chat history
        function displayChatHistory(chats) {
            const container = document.getElementById('chatHistoryList');
            const loadingState = document.getElementById('chatHistoryLoadingState');
            const emptyState = document.getElementById('chatHistoryEmptyState');
            const errorState = document.getElementById('chatHistoryErrorState');
            
            // Hide all states
            if (loadingState) loadingState.classList.add('hidden');
            if (errorState) errorState.classList.add('hidden');
            
            if (chats.length === 0 && currentChatOffset === 0) {
                if (emptyState) emptyState.classList.remove('hidden');
                // Clear any existing content but keep the state divs
                const existingContent = container.querySelectorAll(':not(#chatHistoryLoadingState):not(#chatHistoryEmptyState):not(#chatHistoryErrorState)');
                existingContent.forEach(el => el.remove());
            } else {
                // ✅ Format timestamps client-side after rendering
                if (window.TimeUtils) {
                    container.querySelectorAll('.timestamp-display').forEach(el => {
                        const timestamp = el.dataset.timestamp;
                        const format = el.dataset.format || 'date';
                        if (timestamp) {
                            try {
                                let displayTime, fullTime;
                                if (format === 'date') {
                                    displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                } else {
                                    displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                }
                                el.textContent = displayTime;
                                el.title = fullTime;
                            } catch (e) {
                                console.error('Error formatting timestamp:', e);
                            }
                        }
                    });
                }
                return;
            }
            
            // Hide empty state if we have chats
            if (emptyState) emptyState.classList.add('hidden');
            
            if (currentChatOffset === 0) {
                // Clear existing chat items but keep state divs
                const existingChats = container.querySelectorAll('.border.dark\\:border-gray-700');
                existingChats.forEach(el => el.remove());
            }
            
            chats.forEach(chat => {
                const chatElement = document.createElement('div');
                chatElement.className = 'border dark:border-gray-700 rounded-lg p-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 cursor-pointer transition-colors';
                chatElement.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <p class="text-sm font-medium text-gray-900 dark:text-white">Chat ${chat.id.slice(-6)}</p>
                            <p class="text-xs text-gray-500">${chat.messageCount} messages</p>
                            <p class="text-xs text-gray-400 timestamp-display" data-timestamp="${chat.createdAt}" data-format="date"></p>                   
                        </div>
                        <button class="text-blue-600 hover:text-blue-800 text-sm" onclick="convertChatToTraining('${chat.id}')">
                            Convert to Training
                        </button>
                    </div>
                `;
                container.appendChild(chatElement);
            });
            
            // ✅ Format timestamps client-side after rendering
            if (window.TimeUtils) {
                container.querySelectorAll('.timestamp-display').forEach(el => {
                    const timestamp = el.dataset.timestamp;
                    const format = el.dataset.format || 'date';
                    if (timestamp) {
                        try {
                            let displayTime, fullTime;
                            if (format === 'date') {
                                displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                            } else {
                                displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                            }
                            el.textContent = displayTime;
                            el.title = fullTime;
                        } catch (e) {
                            console.error('Error formatting timestamp:', e);
                        }
                    }
                });
            }
        }
    
        
        // Convert chat to training
        async function convertChatToTraining(chatId) {
            try {
                const response = await fetch(`/api/twin/${twinToken}/convert-to-training`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        chatId: chatId,
                        idealReply: 'Converted from chat message'
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    showNotification('Chat converted to training example successfully!', 'success');
                } else {
                    showNotification('Error: ' + data.error, 'error');
                }
            } catch (error) {
                console.error('Error converting chat:', error);
                showNotification('Error converting chat to training example', 'error');
            }
        }
    
        // Add training example
        async function addTrainingExample() {
            const userUtterance = document.getElementById('userUtterance').value.trim();
            const idealReply = document.getElementById('idealReply').value.trim();
            
            if (!userUtterance || !idealReply) {
                showNotification('Please fill in both fields', 'error');
                return;
            }
            
            try {
                const response = await fetch(`/api/twin/${twinToken}/manual-training`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        userMessage: userUtterance,
                        idealReply: idealReply,
                        trainingType: 'manual'
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    showNotification('Training example added successfully!', 'success');
                    document.getElementById('userUtterance').value = '';
                    document.getElementById('idealReply').value = '';
                } else {
                    showNotification('Error: ' + data.error, 'error');
                }
            } catch (error) {
                console.error('Error adding training example:', error);
                showNotification('Error adding training example', 'error');
            }
        }
    
    
        // Save learning settings
        async function saveLearningSettings() {
            try {
                const autoLearningEl = document.getElementById('autoLearning');
                const autoLearning = autoLearningEl ? (autoLearningEl.value === 'enabled') : false;
                const learningSensitivity = document.getElementById('learningSensitivity')?.value || 'medium';
                
                const response = await fetch(`/api/twin/${twinToken}/learning-settings`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        autoLearning: autoLearning,
                        learningSensitivity: learningSensitivity
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    showNotification('Learning settings saved successfully!', 'success');
                } else {
