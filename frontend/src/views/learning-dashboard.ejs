      handleApiError(error, loadLearningData);
    } finally {
      hideLoadingState('learningProgress');
    }
  };
  
  const originalLoadChatHistory = loadChatHistory;
  loadChatHistory = async function() {
    showLoadingState('chatHistory');
    try {
      await originalLoadChatHistory();
    } catch (error) {
      handleApiError(error, loadChatHistory);
    } finally {
      hideLoadingState('chatHistory');
    }
  };
  
  const originalLoadMemories = loadMemories;
  loadMemories = async function() {
    showLoadingState('memoryList');
    try {
      await originalLoadMemories();
    } catch (error) {
      handleApiError(error, loadMemories);
    } finally {
      hideLoadingState('memoryList');
    }
  };
  
  const originalLoadStyleAnchors = loadStyleAnchors;
  loadStyleAnchors = async function() {
    showLoadingState('styleAnchorsList');
    try {
      await originalLoadStyleAnchors();
    } catch (error) {
      handleApiError(error, loadStyleAnchors);
    } finally {
      hideLoadingState('styleAnchorsList');
    }
  };
}

