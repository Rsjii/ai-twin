// Load available chats for selection
async function loadChatSelection() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/chat-history?limit=50`);
    const data = await response.json();
    
    if (data.success) {
      const chatSelect = document.getElementById('chatSelection');
      chatSelect.innerHTML = '<option value="">Choose a chat...</option>';
      
      data.chats.forEach(chat => {
        const option = document.createElement('option');
        option.value = chat.id;
        option.textContent = `Chat ${chat.id.slice(-6)} (${chat.messageCount} messages)`;
        chatSelect.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error loading chat selection:', error);
  }
}

// Load messages for selected chat
async function loadChatMessages(chatId) {
  try {
    const response = await fetch(`/api/twin/${twinToken}/chat/${chatId}/messages`);
    const data = await response.json();
    
    if (data.success) {
      displayChatMessages(data.messages);
      document.getElementById('messageSelection').classList.remove('hidden');
    }
  } catch (error) {
    console.error('Error loading chat messages:', error);
  }
}

// Display chat messages
function displayChatMessages(messages) {
  const container = document.getElementById('messageList');
  container.innerHTML = '';
  
  messages.forEach(message => {
    const messageElement = document.createElement('div');
    messageElement.className = 'border rounded-lg p-3 hover:bg-gray-50 cursor-pointer transition-colors';
    messageElement.dataset.messageId = message.id;
    messageElement.innerHTML = `
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <div class="flex items-center space-x-2 mb-1">
            <span class="px-2 py-1 text-xs rounded-full ${message.sender === 'user' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}">${message.sender}</span>
            <span class="text-xs text-gray-500 timestamp-display" data-timestamp="${message.createdAt}" data-format="context"></span>          
          </div>
          <p class="text-sm text-gray-900">${message.content}</p>
        </div>
        <input type="checkbox" class="message-checkbox" data-message-id="${message.id}">
      </div>
    `;
    
    // Add click handler
    messageElement.addEventListener('click', function(e) {
      if (e.target.type !== 'checkbox') {
        const checkbox = messageElement.querySelector('.message-checkbox');
        checkbox.checked = !checkbox.checked;
        toggleMessageSelection(message.id, checkbox.checked);
      }
    });
    
    container.appendChild(messageElement);
  });
  
  // ✅ Format timestamps client-side after rendering
  if (window.TimeUtils) {
    container.querySelectorAll('.timestamp-display').forEach(el => {
      const timestamp = el.dataset.timestamp;
      const format = el.dataset.format || 'context';
      if (timestamp) {
        try {
          let displayTime, fullTime;
          if (format === 'context') {
            displayTime = window.TimeUtils.formatTimeWithContext(timestamp);
            fullTime = window.TimeUtils.formatFullDateTime(timestamp);
          } else {
            displayTime = window.TimeUtils.formatSmartTime(timestamp);
            fullTime = window.TimeUtils.formatFullDateTime(timestamp);
          }
          el.textContent = displayTime;
          el.title = fullTime;
        } catch (e) {
          console.error('Error formatting timestamp:', e);
        }
      }
    });
  }
}

// Toggle message selection
function toggleMessageSelection(messageId, isSelected) {
  if (isSelected) {
    if (!selectedMessages.includes(messageId)) {
      selectedMessages.push(messageId);
    }
  } else {
    selectedMessages = selectedMessages.filter(id => id !== messageId);
  }
  
  updateBulkTrainingActions();
}

// Update bulk training actions visibility
function updateBulkTrainingActions() {
  const bulkActions = document.getElementById('bulkTrainingActions');
  if (selectedMessages.length > 0) {
    bulkActions.classList.remove('hidden');
  } else {
    bulkActions.classList.add('hidden');
  }
}

// Convert selected messages to training examples
async function convertSelectedToTraining() {
  if (selectedMessages.length === 0) {
    showNotification('Please select at least one message', 'error');
    return;
  }
  
  try {
    const response = await fetch(`/api/twin/${twinToken}/convert-messages-to-training`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({
        messageIds: selectedMessages,
        trainingType: 'chat_conversion'
      })
    });
    
    const data = await response.json();
    if (data.success) {
      showNotification(`Successfully converted ${selectedMessages.length} messages to training examples!`, 'success');
      selectedMessages = [];
      updateBulkTrainingActions();
      loadTrainingEffectiveness();
    } else {
      showNotification('Error: ' + data.error, 'error');
    }
  } catch (error) {
    console.error('Error converting messages:', error);
    showNotification('Error converting messages to training examples', 'error');
  }
}

// Load training effectiveness score
async function loadTrainingEffectiveness() {
  try {
    const response = await fetch(`/api/twin/${twinToken}/training/effectiveness`);
    const data = await response.json();
    
    if (data.success) {
      updateEffectivenessDisplay(data.effectiveness);
      updateTrainingRecommendations(data.recommendations);
      updateTrainingAchievements(data.achievements);
      updateTrainingGoals(data.goals);
    }
  } catch (error) {
    console.error('Error loading training effectiveness:', error);
  }
}

// Update effectiveness display
function updateEffectivenessDisplay(effectiveness) {
  const scoreElement = document.getElementById('effectivenessScore');
  const barElement = document.getElementById('effectivenessBar');
  
  scoreElement.textContent = effectiveness.score + '%';
  barElement.style.width = effectiveness.score + '%';
  
  // Update color based on score
  if (effectiveness.score >= 80) {
    barElement.className = 'bg-green-600 h-2 rounded-full transition-all duration-300';
    scoreElement.className = 'text-lg font-bold text-green-600';
  } else if (effectiveness.score >= 60) {
    barElement.className = 'bg-yellow-600 h-2 rounded-full transition-all duration-300';
    scoreElement.className = 'text-lg font-bold text-yellow-600';
  } else {
    barElement.className = 'bg-red-600 h-2 rounded-full transition-all duration-300';
    scoreElement.className = 'text-lg font-bold text-red-600';
  }
}

