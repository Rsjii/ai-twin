// Sync all dashboard data
async function syncAllData() {
  try {
    console.log('🔄 Syncing all dashboard data...');
    
    // Sync learning data
    await loadLearningData();
    
    // Sync chat history
    await loadChatHistory();
    
    // Sync training effectiveness
    await loadTrainingEffectiveness();
    
    lastSyncTime = new Date();
    console.log('✅ Data sync completed at:', lastSyncTime);
    
