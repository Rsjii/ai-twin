// Update sync indicator
function updateSyncIndicator(success) {
  const indicator = document.getElementById('syncIndicator');
  if (indicator) {
    if (success) {
      indicator.className = 'w-3 h-3 bg-green-500 rounded-full animate-pulse';
      if (lastSyncTime && window.TimeUtils) {
        indicator.title = `Last sync: ${window.TimeUtils.formatFullDateTime(lastSyncTime)}`;
      } else {
        indicator.title = 'Last sync: Never';
      }
    } else {
      indicator.className = 'w-3 h-3 bg-red-500 rounded-full';
      indicator.title = 'Sync failed - Click to retry';
    }
  }
}

