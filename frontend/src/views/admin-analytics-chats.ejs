<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .chat-card { transition: all 0.3s ease; }
        .chat-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/analytics" class="text-xl font-bold text-gray-900">← Back to Analytics</a>
                    <span class="ml-4 px-3 py-1 bg-purple-100 text-purple-800 text-sm font-medium rounded-full">Chats</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <img src="<%= user.profileImage || '/uploads/profiles/default.jpg' %>" alt="Profile" class="w-8 h-8 rounded-full">
                        <span class="text-sm font-medium text-gray-700"><%= user.handle || user.email %></span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Chats Analytics</h1>
            <p class="text-gray-600 dark:text-gray-300 mt-2">Detailed chats analytics and management</p>
        </div>

        <!-- Summary Cards -->
        <div id="summaryCards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-purple-100 rounded-lg">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Chats</p>
                        <p class="text-2xl font-bold text-gray-900" id="totalChats">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-blue-100 rounded-lg">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">New Today</p>
                        <p class="text-2xl font-bold text-gray-900" id="newToday">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-green-100 rounded-lg">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">New This Week</p>
                        <p class="text-2xl font-bold text-gray-900" id="newThisWeek">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-orange-100 rounded-lg">
                        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Avg Messages</p>
                        <p class="text-2xl font-bold text-gray-900" id="avgMessages">-</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search and Filters -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <input type="text" id="searchInput" placeholder="Search chats by user email or handle..." 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                    </div>
                    <div class="flex gap-2">
                        <input type="text" id="twinHandle" placeholder="Twin Handle" 
                               class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                        <input type="date" id="fromDate" placeholder="From Date" 
                               class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                        <input type="date" id="toDate" placeholder="To Date" 
                               class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                    </div>
                </div>
                <div class="flex flex-col md:flex-row gap-4">
                    <select id="sortBy" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                        <option value="createdAt">Sort by Date</option>
                        <option value="messageCount">Sort by Messages</option>
                        <option value="lastMessageAt">Sort by Last Message</option>
                    </select>
                    <select id="sortOrder" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                        <option value="DESC">Newest First</option>
                        <option value="ASC">Oldest First</option>
                    </select>
                    <button id="applyFiltersBtn" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">Apply Filters</button>
                    <button id="clearFiltersBtn" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Clear</button>
                </div>
            </div>
        </div>

        <!-- Chats List -->
        <div class="bg-white rounded-lg shadow-sm">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900">Chats List</h3>
            </div>
            <div id="chatsList" class="divide-y divide-gray-200">
                <div class="p-4 sm:p-6 lg:p-8 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
                    <p class="text-gray-600 mt-4">Loading chats...</p>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-8 flex justify-center">
            <!-- Pagination will be loaded here -->
        </div>
    </div>

    <script>
        let currentPage = 1;
        let currentSearch = '';
        let currentSortBy = 'createdAt';
        let currentSortOrder = 'DESC';
        let currentFromDate = '';
        let currentToDate = '';
        let currentTwinHandle = '';

        // Load chats data
        async function loadChatsData() {
            try {
                const params = new URLSearchParams({
                    page: currentPage,
                    limit: 10,
                    search: currentSearch,
                    sortBy: currentSortBy,
                    sortOrder: currentSortOrder,
                    fromDate: currentFromDate,
                    toDate: currentToDate,
                    twinHandle: currentTwinHandle
                });

                const response = await fetch(`/api/admin/analytics/page/chats?${params}`);
                const data = await response.json();

                if (data.success) {
                    // Update summary cards
                    document.getElementById('totalChats').textContent = data.data.summary.totalChats;
                    document.getElementById('newToday').textContent = data.data.summary.newToday;
                    document.getElementById('newThisWeek').textContent = data.data.summary.newThisWeek;
                    document.getElementById('avgMessages').textContent = Math.round(data.data.summary.avgMessagesPerChat || 0);

                    // Update chats list
                    updateChatsList(data.data.chats);
                    
                    // Update pagination
                    updatePagination(data.data.pagination);
                } else {
                    showError('Failed to load chats data: ' + data.error);
                }
            } catch (error) {
                showError('Error loading chats data');
            }
        }

        // Update chats list
        function updateChatsList(chats) {
            const chatsList = document.getElementById('chatsList');
            
            if (chats && chats.length > 0) {
                chatsList.innerHTML = chats.map(chat => `
                    <div class="chat-card p-6 hover:bg-gray-50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                    ${(chat.userHandle || chat.userEmail || 'C').charAt(0).toUpperCase()}
                                </div>
                                <div>
                                    <h4 class="text-lg font-semibold text-gray-900">Chat #${(chat.publicId || '').slice(0, 16) || 'N/A'}</h4>
                                    <p class="text-sm text-gray-600">User: ${chat.userHandle || chat.userEmail}</p>
                                    <p class="text-sm text-gray-600">Twin: ${chat.twinName || chat.twinHandle || 'No Twin'}</p>
                                    <p class="text-xs text-gray-500 timestamp-display" data-timestamp="${chat.createdAt}" data-format="date" data-prefix="Started: "></p>
                                    ${chat.lastMessageAt ? `<p class="text-xs text-gray-500 timestamp-display" data-timestamp="${chat.lastMessageAt}" data-format="smart" data-prefix="Last Message: "></p>` : ''}
                                </div>
                            </div>
                            <div class="flex items-center space-x-6">
                                <div class="text-center">
                                    <p class="text-lg font-bold text-purple-600">${chat.messageCount || 0}</p>
                                    <p class="text-xs text-gray-500">Messages</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-lg font-bold text-blue-600">${(chat.publicId || '').slice(0, 16) || 'N/A'}</p>
                                    <p class="text-xs text-gray-500">Chat ID</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-lg font-bold text-green-600">${(chat.publicTwinId || '').slice(0, 16) || 'N/A'}</p>
                                    <p class="text-xs text-gray-500">Twin ID</p>
                                </div>
                                <div class="flex space-x-2">
                                    <button class="view-chat-btn px-3 py-1 bg-purple-100 text-purple-700 rounded text-sm hover:bg-purple-200" data-chat-id="${chat.publicId || chat.id}">
                                        View Chat
                                    </button>
                                    <button class="view-user-btn px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200" data-user-id="${chat.publicUserId || chat.userId}">
                                        View User
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');
                
                // ✅ Format timestamps client-side after rendering
                if (window.TimeUtils) {
                    chatsList.querySelectorAll('.timestamp-display').forEach(el => {
                        const timestamp = el.dataset.timestamp;
                        const format = el.dataset.format || 'date';
                        const prefix = el.dataset.prefix || '';
                        if (timestamp) {
                            try {
                                let displayTime, fullTime;
                                if (format === 'date') {
                                    displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                } else if (format === 'smart') {
                                    displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                } else {
                                    displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                }
                                el.textContent = prefix + displayTime;
                                el.title = fullTime;
                            } catch (e) {
                                // Silently handle timestamp formatting errors
                            }
                        }
                    });
                }
            } else {
                chatsList.innerHTML = '<div class="p-4 sm:p-6 lg:p-8 text-center text-gray-500 dark:text-gray-400">No chats found</div>';
            }
        }

        // Update pagination
        function updatePagination(pagination) {
            const paginationDiv = document.getElementById('pagination');
            const { currentPage, totalPages, totalItems } = pagination;
            
            let paginationHTML = '<div class="flex items-center space-x-2">';
            
            // Previous button
            if (currentPage > 1) {
                paginationHTML += `<button class="page-btn px-3 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" data-page="${currentPage - 1}">Previous</button>`;
            }
            
            // Page numbers
            for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
                paginationHTML += `<button class="page-btn px-3 py-2 ${i === currentPage ? 'bg-purple-600 text-white' : 'bg-white border border-gray-300 hover:bg-gray-50'} rounded-lg" data-page="${i}">${i}</button>`;
            }
            
            // Next button
            if (currentPage < totalPages) {
                paginationHTML += `<button class="page-btn px-3 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" data-page="${currentPage + 1}">Next</button>`;
            }
            
            paginationHTML += '</div>';
            paginationHTML += `<div class="ml-4 text-sm text-gray-600">Showing ${((currentPage - 1) * 10) + 1}-${Math.min(currentPage * 10, totalItems)} of ${totalItems} chats</div>`;
            
            paginationDiv.innerHTML = paginationHTML;
        }

        // Change page
        function changePage(page) {
            currentPage = page;
            loadChatsData();
        }

        // Search chats
        function searchChats() {
            currentSearch = document.getElementById('searchInput').value;
            currentPage = 1;
            loadChatsData();
        }

        // View chat details
        async function viewChatDetails(chatId) {
            try {
                // For admin, we need to get messages directly from database
                // Since chat endpoints require user ownership, we'll create an admin endpoint or use direct query
                const response = await fetch(`/api/admin/analytics/chat/${chatId}/messages`);
                if (!response.ok) {
                    // Fallback: try regular endpoint (may fail if not owner)
                    const fallbackResponse = await fetch(`/api/chat/${chatId}/messages`);
                    if (!fallbackResponse.ok) {
                        throw new Error('Chat not found or access denied');
                    }
                    const data = await fallbackResponse.json();
                    displayChatWindow(chatId, data.messages || data.chat?.messages || []);
                } else {
                    const data = await response.json();
                    displayChatWindow(chatId, data.messages || []);
                }
            } catch (error) {
                alert('Error loading chat details: ' + (error.message || 'Unknown error'));
            }
        }

        function displayChatWindow(chatId, messages) {
            const chatWindow = window.open('', '_blank', 'width=1000,height=700,scrollbars=yes,resizable=yes');
            chatWindow.document.write(`
                <html>
                <head>
                    <title>Chat Details - ${chatId}</title>
                    <style>
                        body { font-family: Arial, sans-serif; padding: 20px; }
                        .chat-container { max-height: 500px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; margin: 10px 0; }
                        .message { margin: 10px 0; padding: 10px; border-radius: 5px; }
                        .user-message { background-color: #e3f2fd; margin-left: 20px; }
                        .twin-message { background-color: #f3e5f5; margin-right: 20px; }
                    </style>
                </head>
                <body>
                    <h2>Chat Details</h2>
                    <p>Chat ID: ${chatId}</p>
                    <div class="chat-container">
                        ${messages && messages.length > 0 ? 
                            messages.map(msg => `
                                <div class="message ${msg.sender === 'human' ? 'user-message' : 'twin-message'}">
                                    <strong>${msg.sender === 'human' ? 'User' : 'Twin'}:</strong> ${msg.content}
                                    <br><small>${new Date(msg.createdAt).toLocaleString()}</small>
                                    ${msg.approved !== undefined ? `<br><small>Status: ${msg.approved ? 'Approved' : 'Pending'}</small>` : ''}
                                </div>
                            `).join('') : 
                            '<p>No messages found</p>'
                        }
                    </div>
                </body>
                </html>
            `);
        }

        // View user profile
        async function viewUserProfile(userId) {
            try {
                const response = await fetch(`/api/admin/analytics/user/${userId}/detailed`);
                const data = await response.json();
                
                if (data.success) {
                    // Open user details in new window
                    const userWindow = window.open('', '_blank', 'width=800,height=600,scrollbars=yes,resizable=yes');
                    userWindow.document.write(`
                        <html>
                        <head><title>User Profile</title></head>
                        <body style="font-family: Arial, sans-serif; padding: 20px;">
                            <h2>User Profile</h2>
                            <pre>${JSON.stringify(data.data, null, 2)}</pre>
                        </body>
                        </html>
                    `);
                }
            } catch (error) {
                alert('Error loading user profile');
            }
        }

        // Show error
        function showError(message) {
            const chatsList = document.getElementById('chatsList');
            chatsList.innerHTML = `<div class="p-4 sm:p-6 lg:p-8 text-center text-red-600 dark:text-red-400">${message}</div>`;
        }

        // Apply filters
        function applyFilters() {
            currentSearch = document.getElementById('searchInput').value;
            currentTwinHandle = document.getElementById('twinHandle').value;
            currentFromDate = document.getElementById('fromDate').value;
            currentToDate = document.getElementById('toDate').value;
            currentPage = 1;
            loadChatsData();
        }

        // Clear filters
        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('twinHandle').value = '';
            document.getElementById('fromDate').value = '';
            document.getElementById('toDate').value = '';
            currentSearch = '';
            currentTwinHandle = '';
            currentFromDate = '';
            currentToDate = '';
            currentPage = 1;
            loadChatsData();
        }

        // Event listeners
        document.getElementById('searchInput').addEventListener('input', debounce(searchChats, 300));
        document.getElementById('sortBy').addEventListener('change', (e) => {
            currentSortBy = e.target.value;
            loadChatsData();
        });
        document.getElementById('sortOrder').addEventListener('change', (e) => {
            currentSortOrder = e.target.value;
            loadChatsData();
        });
        document.getElementById('searchInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') applyFilters();
        });

        // Debounce function
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Load data on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadChatsData();
        });

        // Event delegation for dynamically added buttons
        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('page-btn')) {
                const page = parseInt(e.target.dataset.page);
                if (page) changePage(page);
            }
            if (e.target.classList.contains('view-chat-btn')) {
                const chatId = e.target.dataset.chatId;
                if (chatId) viewChatDetails(chatId);
            }
            if (e.target.classList.contains('view-user-btn')) {
                const userId = e.target.dataset.userId;
                if (userId) viewUserProfile(userId);
            }
        });

        document.getElementById('applyFiltersBtn').addEventListener('click', applyFilters);
        document.getElementById('clearFiltersBtn').addEventListener('click', clearFilters);
    </script>
</body>
</html>
