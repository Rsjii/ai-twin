        // ✅ Notification function for like/follow messages
        function showNotification(message, type = 'success') {
            // Remove existing notification if any
            const existing = document.getElementById('twin-notification');
            if (existing) {
                existing.remove();
            }
            
            // Create notification element
            const notification = document.createElement('div');
            notification.id = 'twin-notification';
    
    // ✅ FIX ISSUE 2: Add error type styling
    let bgClass = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
    let icon = '✅';
    
    if (type === 'error') {
        bgClass = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
        icon = '❌';
    } else if (type === 'info') {
        bgClass = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
        icon = 'ℹ️';
    }
    
    notification.className = `fixed top-20 right-4 z-50 px-6 py-4 rounded-xl shadow-2xl transition-all duration-300 transform translate-x-0 ${bgClass}`;
    
            notification.innerHTML = `
                <div class="flex items-center gap-3">
                    <span class="text-xl">${icon}</span>
                    <span class="font-semibold">${message}</span>
                </div>
            `;
            
            // Add to body
            document.body.appendChild(notification);
            
            // Animate in
            setTimeout(() => {
                notification.style.opacity = '1';
                notification.style.transform = 'translateX(0)';
            }, 10);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        // ✅ FIX: Share functionality for discover page - use same share screen as chat message
async function shareTwinFromDiscover(twinToken, handle) {
    try {
        // ✅ FIX: Check allowShares BEFORE showing prompt
        // handle can be userHandle or publicHandle (userHandle preferred)
        const response = await fetch(`/api/share/content/${handle}?platform=copy`, {
            credentials: 'include'
        });
        
        const data = await response.json();
        
        if (!data.success) {
            if (data.errorCode === 'SHARES_DISABLED') {
                showNotification('Shares are disabled for this twin. You cannot share this profile.', 'info');
                return;
            }
            showNotification('Error: ' + (data.error || 'Failed to check share availability'), 'error');
            return;
        }
        
        // ✅ FIX: Use navigator.share API like chat message share (same screen)
        const shareUrl = `${window.location.origin}/@${handle}`;
        const shareText = `Check out this twin @${handle}! Chat with it and see how it responds. ${shareUrl}`;
        
        if (navigator.share) {
            // Use native share dialog (same as chat message share)
            navigator.share({
                title: `Twin: @${handle}`,
                text: shareText,
                url: shareUrl
            }).then(() => {
                // Track share event
                trackShareEvent(twinToken, 'native_share');
            }).catch((err) => {
                // User cancelled or error - fallback to copy link
                if (err.name !== 'AbortError') {
                    // Only show error if it's not user cancellation
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(shareUrl).catch(() => {
                            // Silent fail
                        });
                    }
                }
            });
        } else {
            // Fallback: copy link to clipboard
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(shareUrl);
                trackShareEvent(twinToken, 'copy');
            } else {
                showNotification('Share feature not available on this device', 'error');
            }
        }
        
    } catch (error) {
        ErrorLogger.error('Share error', error, {});
        showNotification('Failed to share. Please try again.', 'error');
    }
}

        async function trackShareEvent(twinToken, platform) {
            try {
                await fetch('/api/share/track-click', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        shareId: twinToken,
                        platform: platform,
                        referrer: document.referrer
                    })
                });
            } catch (error) {
                ErrorLogger.error('Track share event error', error, {});
            }
        }    
