    <script>
        let currentFilter = 'trending';
        let currentPage = 1;
        let isLoading = false;
        let hasMore = true;

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadTwins(1, false);
            setupEventListeners();
            setupInfiniteScroll();
        });

        function setupEventListeners() {
            // Filter tabs
            document.querySelectorAll('.filter-tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    const filter = this.dataset.filter;
                    setActiveFilter(filter);
                    currentPage = 1;
                    hasMore = true;
                    loadTwins(1,false);
                });
            });

            // Search input
            let searchTimeout;
            document.getElementById('searchInput').addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentPage = 1;
                    hasMore = true;
                    loadTwins(1,false);
                }, 500);
            });
        }

        function setActiveFilter(filter) {
            currentFilter = filter;
            document.querySelectorAll('.filter-tab').forEach(tab => {
                // Remove all active states and hover classes
                tab.classList.remove('active', 'bg-gradient-to-r', 'from-amber-500', 'to-orange-500', 'text-white', 'border-amber-400/50', 'shadow-lg');
                tab.classList.remove('hover:bg-gradient-to-r', 'hover:from-blue-500', 'hover:to-cyan-500', 'hover:text-white', 'hover:border-blue-400/50');
                tab.classList.remove('hover:from-yellow-500', 'hover:to-amber-500', 'hover:border-yellow-400/50');
                tab.classList.remove('hover:from-pink-500', 'hover:to-rose-500', 'hover:border-pink-400/50');
                tab.classList.remove('hover:from-indigo-500', 'hover:to-purple-500', 'hover:border-indigo-400/50');
                
                // Add default inactive state
                tab.classList.add('bg-white/90', 'dark:bg-gray-700/90', 'text-gray-700', 'dark:text-gray-300', 'border-transparent');
                
                // Re-add hover classes based on filter type
                const filterType = tab.dataset.filter;
                if (filterType === 'trending') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-amber-500', 'hover:to-orange-500', 'hover:text-white', 'dark:hover:from-amber-600', 'dark:hover:to-orange-600', 'hover:border-amber-400/50', 'hover:scale-105');
                } else if (filterType === 'recent') {                    
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-blue-500', 'hover:to-cyan-500', 'hover:text-white', 'dark:hover:from-blue-600', 'dark:hover:to-cyan-600', 'hover:border-blue-400/50');
                } else if (filterType === 'popular') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-yellow-500', 'hover:to-amber-500', 'hover:text-white', 'dark:hover:from-yellow-600', 'dark:hover:to-amber-600', 'hover:border-yellow-400/50');
                } else if (filterType === 'most-liked') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-pink-500', 'hover:to-rose-500', 'hover:text-white', 'dark:hover:from-pink-600', 'dark:hover:to-rose-600', 'hover:border-pink-400/50');
                } else if (filterType === 'most-followed') {
                    tab.classList.add('hover:bg-gradient-to-r', 'hover:from-indigo-500', 'hover:to-purple-500', 'hover:text-white', 'dark:hover:from-indigo-600', 'dark:hover:to-purple-600', 'hover:border-indigo-400/50');
                }
            });
            
            const activeTab = document.querySelector(`[data-filter="${filter}"]`);
            // Remove all inactive classes
            activeTab.classList.remove('bg-white/90', 'dark:bg-gray-700/90', 'text-gray-700', 'dark:text-gray-300', 'border-transparent');
            // Remove all hover classes
            activeTab.classList.remove('hover:bg-gradient-to-r', 'hover:from-blue-500', 'hover:to-cyan-500', 'hover:text-white', 'hover:border-blue-400/50');
            activeTab.classList.remove('hover:from-yellow-500', 'hover:to-amber-500', 'hover:border-yellow-400/50');
            activeTab.classList.remove('hover:from-pink-500', 'hover:to-rose-500', 'hover:border-pink-400/50');
            activeTab.classList.remove('hover:from-indigo-500', 'hover:to-purple-500', 'hover:border-indigo-400/50');
            activeTab.classList.remove('hover:scale-105');
            
            // Add active state
            activeTab.classList.add('active', 'bg-gradient-to-r', 'from-amber-500', 'to-orange-500', 'text-white', 'border-amber-400/50', 'shadow-lg');
        }        

        async function loadTwins(page = currentPage, append = false) {
            if (isLoading || !hasMore) return;
            
            isLoading = true;
            currentPage = page;
            
            if (!append) {
                showLoading();
                clearTwinsGrid();
            } else {
                showLoadMoreSpinner();
            }
            
            hideError();

            try {
                const searchQuery = document.getElementById('searchInput').value.trim();
                const limit = 20;
                const offset = (page - 1) * limit;
                
                let url = `/api/discover/${currentFilter}?limit=${limit}&offset=${offset}`;
                
                if (currentFilter === 'trending') {
                    url += '&timeframe=all';
                }
                
                if (searchQuery) {
                    url = `/api/discover/search?query=${encodeURIComponent(searchQuery)}&limit=${limit}&offset=${offset}`;
                }

                // ✅ Log fetch attempt
                console.log('[DISCOVER_FETCH]', {
                    url,
                    currentFilter,
                    limit,
                    offset,
                    searchQuery: searchQuery || null,
                });

                const response = await fetch(url, {
                    cache: 'no-store',
                    headers: { 'Cache-Control': 'no-cache' },
                });

                // ✅ Log response status
                console.log('[DISCOVER_FETCH_RESPONSE]', {
                    url,
                    status: response.status,
                    ok: response.ok,
                    statusText: response.statusText,
                });

                if (response.status === 304) {
                    console.warn('[DISCOVER] Got 304 - using cached data');
                    // Try to use cached data or show error
                    return;
                }

                const data = await response.json().catch(err => {
                    console.error('[DISCOVER] Failed to parse JSON:', err);
                    showError('Failed to load twins. Please refresh.');
                    return { success: false, twins: [] };
                });

                if (data.success) {
                    if (data.twins.length === 0) {
                        if (!append) {
                            showEmptyState();
                        }
                        hasMore = false;
                        showNoMoreTwins();
                    } else {
                        if (!append) {
                            hideEmptyState();
                        }
                        hideError();
                        data.twins.forEach(twin => addTwinCard(twin));
                        
                        // Check if more pages exist
                        hasMore = data.twins.length === limit;
                        currentPage = page;
                        
                        // Update load more UI
                        if (hasMore) {
                            hideLoadMoreUI();
                        } else {
                            showNoMoreTwins();
                        }
                    }
                } else {
                    showError(data.error || 'Failed to load twins');
                    hasMore = false;
                }
            } catch (error) {
                console.error('Error loading twins:', error);
                showError('Failed to load twins');
                hasMore = false;
            } finally {
                isLoading = false;
                if (!append) {
                    hideLoading();
                } else {
                    hideLoadMoreSpinner();
                }
            }
        }

// Infinite Scroll Functions
function loadMoreTwins() {
    if (!isLoading && hasMore) {
        loadTwins(currentPage + 1, true);
    }
}

function showLoadMoreSpinner() {
    document.getElementById('loadMoreSpinner').classList.remove('hidden');
    document.getElementById('loadMoreButton').classList.add('hidden');
    document.getElementById('noMoreTwins').classList.add('hidden');
}

function hideLoadMoreSpinner() {
    document.getElementById('loadMoreSpinner').classList.add('hidden');
}

function hideLoadMoreUI() {
    document.getElementById('loadMoreSpinner').classList.add('hidden');
    document.getElementById('loadMoreButton').classList.remove('hidden');
    document.getElementById('noMoreTwins').classList.add('hidden');
}

function showNoMoreTwins() {
    document.getElementById('loadMoreSpinner').classList.add('hidden');
    document.getElementById('loadMoreButton').classList.add('hidden');
    document.getElementById('noMoreTwins').classList.remove('hidden');
}

// Intersection Observer for auto-load
function setupInfiniteScroll() {
    const sentinel = document.getElementById('loadMoreSentinel');
    if (!sentinel) return;

    const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting && hasMore && !isLoading) {
            loadMoreTwins();
        }
    }, { 
        rootMargin: '200px' // Start loading 200px before reaching bottom
    });

    observer.observe(sentinel);
}

