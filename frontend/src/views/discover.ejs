                        // ✅ FIX: Update tooltip to show "Liked" state - SET DIRECTLY ON BUTTON
                        button.setAttribute('title', 'Liked - Click to unlike');
                        button.setAttribute('data-tooltip', 'Liked - Click to unlike');                        

                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`❤️ You liked @${twinHandle}`, 'success');
                    } else {
                        button.classList.remove('bg-red-600', 'text-white', 'dark:bg-red-500', 'shadow-md');
                        button.classList.add('bg-gradient-to-r', 'from-gray-100', 'to-gray-200', 'dark:from-gray-700', 'dark:to-gray-600', 'text-gray-700', 'dark:text-gray-300');
                        button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>';                        

                        // ✅ FIX: Update tooltip to show "Not liked" state - SET DIRECTLY ON BUTTON
                        button.setAttribute('title', 'Not liked - Click to like');
                        button.setAttribute('data-tooltip', 'Not liked - Click to like');                        

                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`💔 You unliked @${twinHandle}`, 'info');
                    }
                    
            // Update like count
                    const card = button.closest('.twin-card');
                    const likeCount = card.querySelector('.like-count');
                    likeCount.textContent = data.likeCount;
                } else {
                    if (data.error === 'Authentication required') {
                showNotification('Please log in to like this twin!', 'error');
                    } else {
                showNotification('Error: ' + data.error, 'error');
                    }
                }
            } catch (error) {
                ErrorLogger.error('Error toggling like', error, {});
        showNotification('Please log in to like this twin!', 'error');
            }
        }

        async function toggleFollow(twinToken, button) {
    // ✅ FIX ISSUE 2: Check if button is disabled before making request
    if (button.disabled || button.classList.contains('cursor-not-allowed')) {
        return;
    }
    
            try {
                const response = await fetch('/api/social/toggle-follow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    credentials: 'include',
                    body: JSON.stringify({ twinToken })
                });

                const data = await response.json();
                
      // ✅ FIX ISSUE 2: Handle 401 (not logged in) error gracefully
      if (response.status === 401) {
            showNotification('Please log in to follow this twin!', 'error');
            button.disabled = true;
            button.classList.add('opacity-50', 'cursor-not-allowed');
            button.setAttribute('title', 'You cannot follow this twin, you are logged out');
            button.setAttribute('data-disabled-reason', 'not_logged_in');
            return;
        }
        
      // ✅ FIX ISSUE 2: Handle 403 error gracefully
      if (response.status === 403) {
            if (data.errorCode === 'FOLLOWS_DISABLED') {
                button.disabled = true;
                button.classList.add('opacity-50', 'cursor-not-allowed');
                showNotification('Following is disabled for this twin', 'info');
            } else if (data.errorCode === 'OWN_TWIN_INTERACTION') {
                // ✅ FIX: Own twin check
                showNotification('You cannot follow your own twin', 'error');
            } else if (data.errorCode === 'USER_BLOCKED') {
                showNotification('You are blocked from interacting with this twin', 'error');
            } else {
                showNotification(data.error || 'Unable to follow this twin', 'error');
            }
            return;
        }        
                
                if (data.success) {
                    // Update button state
                    if (data.action === 'followed') {
                        button.classList.remove('bg-gradient-to-r', 'from-gray-100', 'to-gray-200', 'dark:from-gray-700', 'dark:to-gray-600', 'text-gray-700', 'dark:text-gray-300');
                        button.classList.add('bg-blue-600', 'text-white', 'dark:bg-blue-500', 'shadow-md');
                        button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';                        

                        // ✅ FIX: Update tooltip to show "Following" state - SET DIRECTLY ON BUTTON
                        button.setAttribute('title', 'Following - Click to unfollow');
                        button.setAttribute('data-tooltip', 'Following - Click to unfollow');                        

                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`👥 You are now following @${twinHandle}`, 'success');
                    } else {
                        button.classList.remove('bg-blue-600', 'text-white', 'dark:bg-blue-500', 'shadow-md');
                        button.classList.add('bg-gradient-to-r', 'from-gray-100', 'to-gray-200', 'dark:from-gray-700', 'dark:to-gray-600', 'text-gray-700', 'dark:text-gray-300');
                        button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>';                        

                        // ✅ FIX: Update tooltip to show "Not following" state - SET DIRECTLY ON BUTTON
                        button.setAttribute('title', 'Not following - Click to follow');
                        button.setAttribute('data-tooltip', 'Not following - Click to follow');                        

                        const card = button.closest('.twin-card');
                        const twinHandle = card.querySelector('.twin-handle').textContent;
                        showNotification(`👋 You unfollowed @${twinHandle}`, 'info');
                    }
                    
            // Update follow count
                    const card = button.closest('.twin-card');
                    const followCount = card.querySelector('.follow-count');
                    followCount.textContent = data.followCount;
                } else {
                    if (data.error === 'Authentication required') {
                showNotification('Please log in to follow this twin!', 'error');
                    } else {
                showNotification('Error: ' + data.error, 'error');
                    }
                }
            } catch (error) {
                ErrorLogger.error('Error toggling follow', error, {});
        showNotification('Please log in to follow this twin!', 'error');
            }
        }

