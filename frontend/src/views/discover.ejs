<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Discover AI Twins - Twinverse</title>
    <link rel="stylesheet" href="/css/output.css">
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
        <style>
            .gradient-text {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            
            /* ✅ PHASE 1: Enhanced Discover Page Styles */
            .twin-card {
                min-height: 320px;
                display: flex;
                flex-direction: column;
                background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.85) 100%);
                border: 1px solid rgba(99, 102, 241, 0.1);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            
            .dark .twin-card {
                background: linear-gradient(135deg, rgba(31, 41, 55, 0.95) 0%, rgba(17, 24, 39, 0.85) 100%);
                border-color: rgba(99, 102, 241, 0.2);
            }
            
            .twin-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.2), 0 10px 10px -5px rgba(99, 102, 241, 0.1);
                border-color: rgba(99, 102, 241, 0.3);
            }
            
            .twin-card .p-6 {
                flex: 1;
                display: flex;
                flex-direction: column;
            }
            
            .twin-card .twin-bio {
                flex: 1;
                min-height: 40px;
            }
            
            /* Hide scrollbar for filter tabs */
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }

            /* Screen reader only class */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}

.sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
}
        </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">    
    <!--Header-->
    <%- include('header') %>

<!-- Main Content -->
<main id="main-content" class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8 py-6 sm:py-8">
    <!-- Header -->
    <header class="mb-6 sm:mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Discover AI Twins</h1>
                <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">Explore trending, popular, and recommended AI twins from the community</p>
            </div>
            <% 
              // Robust authentication check
              const isAuthenticated = typeof user !== 'undefined' && 
                                      user !== null && 
                                      typeof user === 'object' &&
                                      user.id !== undefined && 
                                      user.id !== null;
            %>
            <% if (isAuthenticated) { %>
            <a href="/public-chat/history" 
               class="flex items-center justify-center gap-2 px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl border border-white/20 dark:border-gray-700 hover:shadow-lg transition-all w-full sm:w-auto"
               aria-label="View my chat history">
                <span>💬</span>
                <span class="font-medium text-gray-700 dark:text-gray-300">My Chats</span>
            </a>
            <% } %>            
        </div>
    </header>

    <!-- Status announcements for screen readers -->
    <div aria-live="polite" aria-atomic="true" class="sr-only" id="status-announcement"></div>

    <!-- Search Section -->
    <section aria-label="Search twins" class="mb-6 sm:mb-8">
