<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Discover Twins - Selflyx</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/errorHandler.js"></script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
        <style>
            .gradient-text {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            
            /* ✅ PHASE 1: Enhanced Discover Page Styles */
            .twin-card {
                min-height: 320px;
                display: flex;
                flex-direction: column;
                background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.85) 100%);
                border: 1px solid rgba(99, 102, 241, 0.1);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            
            .dark .twin-card {
                background: linear-gradient(135deg, rgba(31, 41, 55, 0.95) 0%, rgba(17, 24, 39, 0.85) 100%);
                border-color: rgba(99, 102, 241, 0.2);
            }
            
            .twin-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.2), 0 10px 10px -5px rgba(99, 102, 241, 0.1);
                border-color: rgba(99, 102, 241, 0.3);
            }
            
            .twin-card .p-6 {
                flex: 1;
                display: flex;
                flex-direction: column;
            }
            
            .twin-card .twin-bio {
                overflow: hidden !important;
                text-overflow: ellipsis;
                white-space: nowrap;
                word-break: break-word;
                overflow-wrap: break-word;
                /* ✅ FIX: Single line with ellipsis */
            }
            
            /* ✅ Sample reply box - fixed height for consistent card sizing */
            .twin-sample-reply {
                min-height: 70px;
                max-height: 70px;
                display: flex;
                align-items: flex-start;
                overflow: hidden;
            }
            
            .twin-sample-reply p {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                text-overflow: ellipsis;
                line-height: 1.5;
                /* Remove max-height constraint - let line-clamp handle truncation */
                word-wrap: break-word;
                word-break: break-word;
            }
            
            /* Ensure text doesn't overflow - show ellipsis after 2 lines */
            .twin-sample-reply .sample-text {
                display: inline;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            
            /* Hide scrollbar for filter tabs */
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
            
            /* ✅ Desktop: Center tabs container */
            @media (min-width: 768px) {
                .filter-tabs-container {
                    justify-content: center !important;
                }
            }
            
            /* Gap between tabs and first twin - all screen sizes */
            #twinsGridSection {
                margin-top: 1.5rem;
            }
            
            /* Desktop: More gap between tabs and twins */
            @media (min-width: 641px) {
                #twinsGridSection {
                    margin-top: 2rem;
                }
            }
            
            /* Mobile-only changes for discover page */
            @media (max-width: 640px) {
                /* Reduce twin card width and add margins */
                #twinsGrid {
                    margin-left: 1rem;
                    margin-right: 1rem;
                    gap: 1rem;
                }
                
                /* Reduce individual twin card width on mobile */
                #twinsGrid .twin-card {
                    max-width: calc(100% - 0.5rem);
                }
            }

            /* Screen reader only class */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}

.sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
}
        </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">    
    <!--Header-->
    <%- include('header') %>

<!-- Main Content -->
