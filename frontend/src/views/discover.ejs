        // ✅ Notification function for like/follow messages
        function showNotification(message, type = 'success') {
            // Remove existing notification if any
            const existing = document.getElementById('twin-notification');
            if (existing) {
                existing.remove();
            }
            
            // Create notification element
            const notification = document.createElement('div');
            notification.id = 'twin-notification';
    
    // ✅ FIX ISSUE 2: Add error type styling
    let bgClass = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
    let icon = '✅';
    
    if (type === 'error') {
        bgClass = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
        icon = '❌';
    } else if (type === 'info') {
        bgClass = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
        icon = 'ℹ️';
    }
    
    notification.className = `fixed top-20 right-4 z-50 px-6 py-4 rounded-xl shadow-2xl transition-all duration-300 transform translate-x-0 ${bgClass}`;
    
            notification.innerHTML = `
                <div class="flex items-center gap-3">
                    <span class="text-xl">${icon}</span>
                    <span class="font-semibold">${message}</span>
                </div>
            `;
            
            // Add to body
            document.body.appendChild(notification);
            
            // Animate in
            setTimeout(() => {
                notification.style.opacity = '1';
                notification.style.transform = 'translateX(0)';
            }, 10);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        // Share functionality for discover page
async function shareTwinFromDiscover(twinToken, publicHandle) {
    try {
        // ✅ FIX: Check allowShares BEFORE showing prompt
        const response = await fetch(`/api/share/content/${publicHandle}?platform=copy`, {
            credentials: 'include'
        });
        
        const data = await response.json();
        
        if (!data.success) {
            if (data.errorCode === 'SHARES_DISABLED') {
                alert('Shares are disabled for this twin. You cannot share this profile.');
                return;
            }
            alert('Error: ' + (data.error || 'Failed to check share availability'));
            return;
        }
        
        // Now show share options (only if shares are allowed)
        const shareUrl = `${window.location.origin}/@${publicHandle}`;
        
        const platform = prompt('Choose platform to share:\n1. Twitter\n2. Facebook\n3. LinkedIn\n4. WhatsApp\n5. Telegram\n6. Copy Link\n\nEnter number (1-6):');
        
        if (!platform) return;
        
        const platforms = {
            '1': 'twitter',
            '2': 'facebook', 
            '3': 'linkedin',
            '4': 'whatsapp',
            '5': 'telegram',
            '6': 'copy'
        };
        
        const selectedPlatform = platforms[platform];
        if (!selectedPlatform) {
            alert('Invalid selection');
            return;
        }
        
        if (selectedPlatform === 'copy') {
            await navigator.clipboard.writeText(shareUrl);
            alert('Link copied to clipboard!');
        } else {
            // Get share content for specific platform
            const platformResponse = await fetch(`/api/share/content/${publicHandle}?platform=${selectedPlatform}`, {
                credentials: 'include'
            });
            const platformData = await platformResponse.json();
            
            if (platformData.success) {
                const content = platformData.content;
                let shareWindow = '';
                
                switch (selectedPlatform) {
                    case 'twitter':
                        shareWindow = `https://twitter.com/intent/tweet?text=${encodeURIComponent(content.text)}&url=${encodeURIComponent(shareUrl)}`;
                        break;
                    case 'facebook':
                        shareWindow = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}&quote=${encodeURIComponent(content.description)}`;
                        break;
                    case 'linkedin':
                        shareWindow = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(content.title)}&summary=${encodeURIComponent(content.summary)}`;
                        break;
                    case 'whatsapp':
                        shareWindow = `https://wa.me/?text=${encodeURIComponent(content.text)}`;
                        break;
                    case 'telegram':
                        shareWindow = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(content.text)}`;
                        break;
                }
                
                if (shareWindow) {
                    window.open(shareWindow, '_blank', 'width=600,height=400');
                }
            } else {
                if (platformData.errorCode === 'SHARES_DISABLED') {
                    alert('Shares are disabled for this twin. You cannot share this profile.');
                } else {
                    alert('Error: ' + (platformData.error || 'Failed to share'));
                }
            }
        }
        
        // Track share event
        trackShareEvent(twinToken, selectedPlatform);
        
    } catch (error) {
        console.error('Share error:', error);
        alert('Failed to share. Please try again.');
    }
}

        async function trackShareEvent(twinToken, platform) {
            try {
                await fetch('/api/share/track-click', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        shareId: twinToken,
                        platform: platform,
                        referrer: document.referrer
                    })
                });
            } catch (error) {
                console.error('Track share event error:', error);
            }
        }    
