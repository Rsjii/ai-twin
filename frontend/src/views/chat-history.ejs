<%- include('layout', { title: 'Chat History - AI Twin', body: `
<div class="px-4 py-6 sm:px-0 mobile-p-4">
    <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center mb-6 mobile-flex-col mobile-gap-2">
            <h1 class="text-3xl font-bold text-gray-900 mobile-text-2xl mobile-text-center">Chat History</h1>
            <a href="/dashboard" class="text-primary hover:text-secondary flex items-center mobile-text-sm touch-target">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Dashboard
            </a>
        </div>
        
        <div class="grid lg:grid-cols-3 gap-6 mobile-grid-cols-1 mobile-gap-4">
            <!-- Chat History Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-lg p-6 mobile-card mobile-p-4">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-semibold text-gray-800 mobile-text-lg">Previous Chats</h2>
                        <span id="totalChats" class="text-sm text-gray-500 mobile-text-xs">0 chats</span>
                    </div>
                    
                    <div id="chatHistoryList" class="space-y-3 max-h-96 overflow-y-auto">
                        <div class="text-center py-8">
                            <div class="w-16 h-16 bg-gradient-to-r from-primary/10 to-accent/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8 text-primary animate-bounce-gentle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                </svg>
                            </div>
                            <p class="text-gray-500">Loading chat history...</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Chat Display Area -->
            <div class="lg:col-span-2">
                <div id="chatDisplayArea" class="bg-white rounded-lg shadow-lg">
                    <!-- Welcome State -->
                    <div id="welcomeState" class="p-8 text-center">
                        <div class="w-20 h-20 bg-gradient-to-r from-primary/20 to-accent/20 rounded-2xl flex items-center justify-center mx-auto mb-6">
                            <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-800 mb-4">Select a Chat to Continue</h3>
                        <p class="text-gray-600 mb-6">Choose from your previous conversations or start a new chat with your AI twin</p>
                        <button onclick="startNewChat()" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-lg hover:shadow-lg transition-all duration-300 font-semibold">
                            Start New Chat
                        </button>
                    </div>
                    
                    <!-- Chat Messages Display -->
                    <div id="chatMessagesDisplay" class="hidden">
                        <div class="border-b p-4">
                            <div class="flex items-center justify-between">
                                <h4 id="chatTitle" class="text-lg font-semibold text-gray-800">Chat Details</h4>
                                <button onclick="closeChatDisplay()" class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                            <p id="chatInfo" class="text-sm text-gray-500 mt-1"></p>
                        </div>
                        
                        <div id="chatMessagesContainer" class="h-96 overflow-y-auto p-6">
                            <div id="chatMessagesList" class="space-y-4">
                                <!-- Messages will be loaded here -->
                            </div>
                        </div>
                        
                        <div class="border-t p-4">
                            <div class="flex space-x-3">
                                <button onclick="continueChat()" class="flex-1 bg-primary text-white py-2 px-4 rounded-lg hover:bg-secondary transition-colors font-semibold">
                                    Continue This Chat
                                </button>
                                <button onclick="startNewChat()" class="flex-1 bg-gray-500 text-white py-2 px-4 rounded-lg hover:bg-gray-600 transition-colors font-semibold">
                                    Start New Chat
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentSelectedChat = null;
let allChats = [];

// Load chat history on page load
document.addEventListener('DOMContentLoaded', () => {
    loadChatHistory();
});

async function loadChatHistory() {
    try {
        const response = await fetch('/api/chat/history', {
            headers: {
                'X-CSRF-Token': window.csrfToken
            }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            allChats = result.chats;
            displayChatHistory(result.chats);
            document.getElementById('totalChats').textContent = \`\${result.totalChats} chats\`;
        } else {
            showError('Failed to load chat history');
        }
    } catch (error) {
        console.error('Load chat history error:', error);
        showError('Network error. Please try again.');
    }
}

function displayChatHistory(chats) {
    const chatHistoryList = document.getElementById('chatHistoryList');
    
    if (chats.length === 0) {
        chatHistoryList.innerHTML = \`
            <div class="text-center py-8">
                <div class="w-16 h-16 bg-gradient-to-r from-primary/10 to-accent/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
                <p class="text-gray-500 mb-4">No previous chats found</p>
                <button onclick="startNewChat()" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-secondary transition-colors">
                    Start Your First Chat
                </button>
            </div>
        \`;
        return;
    }
    
    chatHistoryList.innerHTML = chats.map(chat => \`
        <div class="chat-item p-4 rounded-lg border hover:bg-gray-50 cursor-pointer transition-colors" onclick="selectChat('\${chat.id}')">
            <div class="flex items-start justify-between mb-2">
                <h4 class="font-semibold text-gray-800">Chat #\${chat.id.slice(-6)}</h4>
                <span class="text-xs text-gray-500">\${chat.messageCount} messages</span>
            </div>
            
            <div class="text-sm text-gray-600 mb-2">
                <p class="truncate">\${chat.lastMessage ? chat.lastMessage.content : 'No messages yet'}</p>
            </div>
        </div>
    \`).join('');
}

function selectChat(chatId) {
    const chat = allChats.find(c => c.id === chatId);
    if (!chat) return;
    
    currentSelectedChat = chat;
    
    // Update UI
    document.getElementById('welcomeState').classList.add('hidden');
    document.getElementById('chatMessagesDisplay').classList.remove('hidden');
    
    // Update chat details
    document.getElementById('chatTitle').textContent = \`Chat #\${chat.id.slice(-6)}\`;
    document.getElementById('chatInfo').textContent = \`\${chat.messageCount} messages\`;
    
    // Display messages
    displayChatMessages(chat.messages);
}

function displayChatMessages(messages) {
    const messagesList = document.getElementById('chatMessagesList');
    
    if (messages.length === 0) {
        messagesList.innerHTML = '<p class="text-gray-500 text-center">No messages in this chat</p>';
        return;
    }
    
    messagesList.innerHTML = messages.map(msg => \`
        <div class="flex \${msg.sender === 'human' ? 'justify-end' : 'justify-start'}">
            <div class="max-w-xs lg:max-w-md px-4 py-2 rounded-lg \${msg.sender === 'human' ? 'bg-primary text-white' : 'bg-gray-200 text-gray-800'}">
                <p class="text-sm">\${msg.content}</p>
                \${msg.sender === 'twin' ? '<p class="text-xs mt-1 opacity-75">AI-generated</p>' : ''}
            </div>
        </div>
    \`).join('');
    
    // Scroll to bottom
    const container = document.getElementById('chatMessagesContainer');
    container.scrollTop = container.scrollHeight;
}

function closeChatDisplay() {
    document.getElementById('welcomeState').classList.remove('hidden');
    document.getElementById('chatMessagesDisplay').classList.add('hidden');
    currentSelectedChat = null;
}

function continueChat() {
    if (currentSelectedChat) {
        window.location.href = \`/chat/\${currentSelectedChat.id}\`;
    }
}

async function startNewChat() {
    try {
        const response = await fetch('/api/chat/start', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
            body: JSON.stringify({ twinId: 'latest' })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            window.location.href = result.redirect;
        } else {
            showError(result.error || 'Failed to start chat');
        }
    } catch (error) {
        console.error('Start chat error:', error);
        showError('Network error. Please try again.');
    }
}

function showError(message) {
    // Simple error display - you can enhance this with a proper notification system
    alert(message);
}
</script>
` }) %>
