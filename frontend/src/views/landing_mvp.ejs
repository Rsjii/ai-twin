<script>
    // True Circular Carousel - No visible duplicates, seamless loop
    (function() {
        var carousel = document.getElementById('twins-carousel');
        var container = document.getElementById('twins-container');
        var noTwinsMessage = document.getElementById('no-twins-message');
        var prevBtn = document.getElementById('carousel-prev');
        var nextBtn = document.getElementById('carousel-next');
        var twins = <%- twinsJson %>;
        
        // Max 5 twins limit
        var MAX_TWINS = 5;
        if (twins && twins.length > MAX_TWINS) {
            twins = twins.slice(0, MAX_TWINS);
        }
        
        if (!container || !carousel) {
            return;
        }
        
        // If no twins, show fallback message
        if (!twins || twins.length === 0) {
            container.style.display = 'none';
            if (noTwinsMessage) {
                noTwinsMessage.classList.remove('hidden');
            }
            return;
        }
        
        // Hide fallback message
        if (noTwinsMessage) {
            noTwinsMessage.classList.add('hidden');
        }
        
        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            if (!text) return '';
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }
        
        // Create card HTML
        function createCardHtml(twin) {
            var displayName = twin.userName || twin.userHandle || 'Anonymous';
            var displayHandle = twin.userHandle || twin.publicHandle || '';
            var profileUrl = displayHandle ? '/@' + displayHandle : '/auth';
            
            // Option chosen (best UX):
            // - Chat button => Public Chat (if token exists)
            // - Card click  => Profile
            var publicTwinId = twin.publicId || '';
            var chatUrl = publicTwinId ? ('/public-twin/chat/' + publicTwinId) : profileUrl;
            
            // Avatar
            var avatarHtml = '';
            if (twin.profileImage) {
                avatarHtml = '<img src="' + escapeHtml(twin.profileImage) + '" alt="' + escapeHtml(displayName) + '" class="w-16 h-16 rounded-2xl object-cover ring-2 ring-gray-100 dark:ring-gray-700 shadow-lg hover:scale-105 transition-transform">';
            } else {
                var initial = displayName.charAt(0).toUpperCase();
                avatarHtml = '<div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 via-purple-500 to-indigo-600 flex items-center justify-center text-white font-bold text-2xl ring-2 ring-gray-100 dark:ring-gray-700 shadow-lg hover:scale-105 transition-transform">' + initial + '</div>';
            }
            
            // Message preview - always show, even if empty (for consistent card height)
            var previewText = '';
            if (twin.bio && twin.bio.length > 0) {
                previewText = twin.bio;
            } else if (twin.sampleReply && twin.sampleReply.length > 0) {
                previewText = twin.sampleReply;
            }
            
            var messagePreview = '<div class="mt-4 bg-blue-50 dark:bg-gray-700/50 rounded-lg p-4 border border-blue-100 dark:border-gray-600 message-preview-fixed flex items-center">' +
                '<p class="text-gray-700 dark:text-gray-300 text-sm sm:text-base leading-relaxed line-clamp-2 w-full">' + 
                (previewText ? escapeHtml(previewText) : '<span class="text-gray-400 dark:text-gray-500">No preview available</span>') +
                '</p>' +
                '</div>';
            
            // Chat button
            var chatButton = '<div class="mt-6">' +
                '<a href="' + escapeHtml(chatUrl) + '" class="block w-full text-center bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-500 dark:to-indigo-500 text-white font-semibold py-3 px-6 rounded-lg hover:from-blue-700 hover:to-indigo-700 dark:hover:from-blue-600 dark:hover:to-indigo-600 transition-all transform hover:scale-[1.02] active:scale-[0.98] shadow-lg hover:shadow-xl text-base js-chat-btn">Chat</a>' +
                '</div>';
            
            return '<div class="twin-carousel-card cursor-pointer bg-white dark:bg-gray-800 rounded-2xl p-6 border-2 border-gray-100 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-500/50 shadow-lg dark:shadow-gray-900/50 hover:shadow-2xl dark:hover:shadow-blue-900/20 transition-all duration-300 transform hover:-translate-y-1 flex flex-col h-full" data-profile-url="' + escapeHtml(profileUrl) + '">' +
                '<div class="flex items-start gap-4 mb-4">' +
                avatarHtml +
                '<div class="flex-1 min-w-0 pt-1 overflow-hidden">' +
                '<h3 class="font-bold text-xl text-gray-900 dark:text-white truncate mb-1" title="' + escapeHtml(displayName) + '">' + escapeHtml(displayName) + '</h3>' +
                (displayHandle ? '<p class="text-sm text-gray-500 dark:text-gray-400 truncate" title="@' + escapeHtml(displayHandle) + '">@' + escapeHtml(displayHandle) + '</p>' : '') +
                '</div>' +
                '</div>' +
                messagePreview +
                chatButton +
                '</div>';
        }
        
        // Render cards with duplicates for seamless circular scroll
        // We use bigger DUP_COUNT so user never physically hits the ends (kills iOS/Chrome edge bounce)
        var DUP_COUNT = 3; // 3 on each side = extremely stable (no shake)
        var isSnapping = false;
        var snapTimer = null;

        function renderCards() {
            container.innerHTML = '';
            if (twins.length === 0) return;

            if (twins.length > 1) {
                // Prepend last DUP_COUNT in order
                for (var k = DUP_COUNT; k > 0; k--) {
                    var idx = (twins.length - k + twins.length) % twins.length;
                    var dupLeft = document.createElement('div');
                    dupLeft.innerHTML = createCardHtml(twins[idx]);
                    container.appendChild(dupLeft.firstElementChild);
                }
            }

            // Real cards
            for (var i = 0; i < twins.length; i++) {
                var card = document.createElement('div');
                card.innerHTML = createCardHtml(twins[i]);
                container.appendChild(card.firstElementChild);
            }

            if (twins.length > 1) {
                // Append first DUP_COUNT
                for (var j = 0; j < DUP_COUNT; j++) {
                    var idx2 = j % twins.length;
                    var dupRight = document.createElement('div');
                    dupRight.innerHTML = createCardHtml(twins[idx2]);
                    container.appendChild(dupRight.firstElementChild);
                }
            }
        }

        // Initialize
        renderCards();

        // Carousel state
        var currentIndex = 0; // 0..totalRealCards-1
        var isScrolling = false; // programmatic scroll (buttons / snap)
        var isJumping = false;   // instant normalize jump
        var cardWidth = 0;
        var totalRealCards = twins.length;
        // Interaction flags (used by desktop drag + auto-scroll coordination)
        var isUserInteracting = false;
        var isDragging = false;
        var interactionTimer = null;
        var lastDragAt = 0; // Track drag end time to prevent accidental clicks

        // Get card width including gap
        function updateCardWidth() {
            if (container.children.length === 0) {
                cardWidth = 0;
                return;
            }
            var firstRealCardIndex = twins.length > 1 ? DUP_COUNT : 0;
            var firstCard = container.children[firstRealCardIndex];
            if (!firstCard) {
                cardWidth = 0;
                return;
            }
            var style = window.getComputedStyle(container);
            var gap = parseInt(style.gap) || 24;
            cardWidth = firstCard.offsetWidth + gap;
        }

        // Scroll to real card index (0..totalRealCards-1)
        function scrollToIndex(realIndex, smooth) {
            if (container.children.length === 0) return;

            updateCardWidth();
            if (!cardWidth) return;

            currentIndex = realIndex;

            var domIndex = twins.length > 1 ? realIndex + DUP_COUNT : realIndex;
            var target = domIndex * cardWidth;

            isScrolling = true;
            isSnapping = true;

            carousel.scrollTo({
                left: target,
                behavior: smooth ? 'smooth' : 'auto'
            });

            setTimeout(function() {
                isScrolling = false;
                isSnapping = false;
            }, smooth ? 350 : 50);
        }

        // 핵심: normalize by cycle width (NO rounding, NO snap during momentum)
        function normalizeInfinite() {
            if (isJumping || isSnapping || twins.length <= 1) return;

            updateCardWidth();
            if (!cardWidth) return;

            var cycleWidth = totalRealCards * cardWidth;
            var min = DUP_COUNT * cardWidth;       // start of real range
            var max = min + cycleWidth;            // start of right-duplicate range
            var sl = carousel.scrollLeft;

            // If we're in left duplicates, jump forward by one cycle (same visual card continues)
            if (sl < min) {
                isJumping = true;
                carousel.scrollLeft = sl + cycleWidth;
                isJumping = false;
                return;
            }

            // If we're in right duplicates, jump back by one cycle
            if (sl >= max) {
                isJumping = true;
                carousel.scrollLeft = sl - cycleWidth;
                isJumping = false;
                return;
            }
        }

        // ================= AUTO SCROLL (ambient) =================
        var prefersReducedMotion = false;
        try {
            prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}

        var autoEnabled = !prefersReducedMotion;
        var autoSpeedPxPerSec = 55; // visible slow drift (try 40–80)
        var autoRaf = null;
        var autoPausedUntil = 0;

        function pauseAutoScrollFor(ms) {
            autoPausedUntil = Date.now() + ms;
        }

        function startAutoScroll() {
            if (!autoEnabled || twins.length <= 1) return;
            if (autoRaf) return;

            var lastT = 0;
            function tick(t) {
                autoRaf = requestAnimationFrame(tick);

                if (!carousel || !container) return;
                if (Date.now() < autoPausedUntil) return;
                if (isJumping || isSnapping || isScrolling || isDragging || isUserInteracting) return;

                updateCardWidth();
                if (!cardWidth) return;

                var dt = lastT ? (t - lastT) : 16;
                lastT = t;

                carousel.scrollLeft += (autoSpeedPxPerSec * (dt / 1000));
                normalizeInfinite();
            }

            autoRaf = requestAnimationFrame(tick);
        }

        function stopAutoScroll() {
            if (!autoRaf) return;
            cancelAnimationFrame(autoRaf);
            autoRaf = null;
        }

        // Any direct interaction pauses auto for a bit (mobile + desktop)
        carousel.addEventListener('pointerdown', function() {
            pauseAutoScrollFor(700);
        }, { passive: true });
        carousel.addEventListener('touchstart', function() {
            pauseAutoScrollFor(700);
        }, { passive: true });
        // =========================================================

        // Snap ONLY when user stops scrolling (debounced) - prevents micro shake completely
        function snapToNearestOnEnd() {
            if (twins.length <= 1) return;

            updateCardWidth();
            if (!cardWidth) return;

            var min = DUP_COUNT * cardWidth;
            var sl = carousel.scrollLeft;

            // First normalize to ensure sl is inside real range
            var cycleWidth = totalRealCards * cardWidth;
            while (sl < min) sl += cycleWidth;
            while (sl >= min + cycleWidth) sl -= cycleWidth;

            var raw = (sl - min) / cardWidth;
            var nearest = Math.round(raw);

            if (nearest < 0) nearest = 0;
            if (nearest >= totalRealCards) nearest = totalRealCards - 1;

            currentIndex = nearest;
            scrollToIndex(currentIndex, true);
        }

        // Scroll listener: normalize immediately, snap after user stops
        carousel.addEventListener('scroll', function() {
            if (twins.length <= 1) return;

            // Keep the illusion infinite during the scroll (no edge hit)
            normalizeInfinite();

            // If auto-scroll is running (and not paused), never schedule snap from its own movement.
            if (autoRaf && Date.now() >= autoPausedUntil) {
                return;
            }

            // Debounced snap (no native snap at all)
            if (snapTimer) clearTimeout(snapTimer);
            snapTimer = setTimeout(function() {
                if (!isJumping && !isScrolling && !isDragging && !isUserInteracting) {
                    // one more normalize for safety then snap
                    normalizeInfinite();
                    snapToNearestOnEnd();
                }
            }, 120);
        }, { passive: true });

        // Desktop-only: wheel + drag behavior (fix vertical scroll stuck + click not working)
        if (window.matchMedia && window.matchMedia('(min-width: 769px)').matches) {
            function markInteracting() {
                isUserInteracting = true;
                pauseAutoScrollFor(700);
                if (interactionTimer) clearTimeout(interactionTimer);
                interactionTimer = setTimeout(function() {
                    isUserInteracting = false;
                }, 160);
            }

            // ✅ FIX: Don't hijack normal vertical wheel.
            // Only scroll carousel horizontally when user indicates horizontal intent:
            // - trackpad horizontal deltaX, OR shift+wheel
            carousel.addEventListener('wheel', function(e) {
                var horizontalIntent = !!e.shiftKey || (Math.abs(e.deltaX) > Math.abs(e.deltaY));

                // allow normal page vertical scrolling
                if (!horizontalIntent) return;

                e.preventDefault();
                markInteracting();

                var delta = (Math.abs(e.deltaX) > 0) ? e.deltaX : e.deltaY; // shift+wheel uses deltaY
                carousel.scrollLeft += delta;
                normalizeInfinite();
            }, { passive: false });

            // ✅ FIX: Drag should start only after threshold (so clicks work)
            var isPointerDown = false;
            var didDrag = false;
            var startY = 0;
            var DRAG_THRESHOLD = 6;
            var startX = 0;
            var startLeft = 0;

            carousel.addEventListener('pointerdown', function(e) {
                if (e.pointerType === 'touch') return;
                if (e.button != null && e.button !== 0) return; // only left-click

                isPointerDown = true;
                didDrag = false;
                isDragging = false;

                startX = e.clientX;
                startY = e.clientY;
                startLeft = carousel.scrollLeft;

                markInteracting();
            }, { passive: true });

            carousel.addEventListener('pointermove', function(e) {
                if (!isPointerDown) return;

                var dx = e.clientX - startX;
                var dy = e.clientY - startY;

                // require horizontal intent + threshold
                if (!didDrag) {
                    if (Math.abs(dx) < DRAG_THRESHOLD) return;
                    if (Math.abs(dy) > Math.abs(dx)) return; // user is scrolling vertically

                    didDrag = true;
                    isDragging = true;
                    try { carousel.setPointerCapture(e.pointerId); } catch (_e) {}
                }

                e.preventDefault();
                markInteracting();

                carousel.scrollLeft = startLeft - dx;
                normalizeInfinite();
            }, { passive: false });

            function endPointer() {
                if (!isPointerDown) return;
                isPointerDown = false;

                if (didDrag) {
                    lastDragAt = Date.now();
                    // let existing snap debounce run
                    if (snapTimer) clearTimeout(snapTimer);
                    snapTimer = setTimeout(function() {
                        normalizeInfinite();
                        snapToNearestOnEnd();
                    }, 120);
                }

                didDrag = false;
                isDragging = false;
            }

            carousel.addEventListener('pointerup', endPointer, { passive: true });
            carousel.addEventListener('pointercancel', endPointer, { passive: true });
            carousel.addEventListener('pointerleave', endPointer, { passive: true });
        }

        // ✅ Card click => twin profile (works on all devices, but never when user dragged, and never override Chat button)
        carousel.addEventListener('click', function(e) {
            // Prevent click if user just finished dragging
            if (Date.now() - lastDragAt < 250) {
                e.preventDefault();
                e.stopPropagation();
                return;
            }

            // Don't interfere with Chat button or any other links
            var a = e.target && e.target.closest ? e.target.closest('a') : null;
            if (a) return; // Chat button (or any link) handles itself

            // Find the card and navigate to twin profile
            var card = e.target && e.target.closest ? e.target.closest('.twin-carousel-card') : null;
            if (card && card.dataset && card.dataset.profileUrl) {
                window.location.href = card.dataset.profileUrl;
            }
        }, true);

        // Navigation buttons
        if (prevBtn && twins.length > 1) {
            prevBtn.addEventListener('click', function() {
                var nextIndex = (currentIndex - 1 + totalRealCards) % totalRealCards;
                scrollToIndex(nextIndex, true);
            });
        }

        if (nextBtn && twins.length > 1) {
            nextBtn.addEventListener('click', function() {
                var nextIndex = (currentIndex + 1) % totalRealCards;
                scrollToIndex(nextIndex, true);
            });
        }

        // Initialize position - start inside the real range (far from edges)
        setTimeout(function() {
            if (twins.length > 0) {
                updateCardWidth();
                if (twins.length > 1) {
                    carousel.scrollLeft = DUP_COUNT * cardWidth;
                } else {
                    carousel.scrollLeft = 0;
                }
                startAutoScroll();
            }
        }, 50);

        // Handle window resize
        var resizeTimeout;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function() {
                if (twins.length > 0) {
                    updateCardWidth();
                    // keep current card centered after resize
                    scrollToIndex(currentIndex, false);
                }
            }, 200);
        });
    })();
</script>