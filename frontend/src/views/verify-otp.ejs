<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        .primary { color: #3B82F6; }
        .bg-primary { background-color: #3B82F6; }
        .hover\:bg-secondary:hover { background-color: #1D4ED8; }
        .focus\:ring-primary:focus { --tw-ring-color: #3B82F6; }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen">
    <div class="px-4 py-6 sm:px-0">
        <div class="max-w-md mx-auto">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900 p-4 sm:p-6 lg:p-8">
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">Verify OTP</h1>
                <p class="text-gray-600 dark:text-gray-300 text-center mb-6">
                    Enter the 6-digit code sent to your email
                </p>
                
                <form id="otpForm">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email</label>
                        <input type="email" id="otpEmail" name="email" readonly class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 dark:text-white text-base min-h-[44px]" aria-label="Email">
                    </div>
                    
                    <div class="mb-4">
                        <label for="otpCode" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Verification Code</label>
                        <input type="text" id="otpCode" name="code" placeholder="Enter 6-digit code" maxlength="6" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-center text-lg tracking-widest text-base min-h-[44px]" required aria-label="Verification Code">
                    </div>
                    
                    <button type="submit" class="w-full bg-primary text-white py-2.5 sm:py-3 px-4 sm:px-6 rounded-lg hover:bg-secondary transition-colors font-semibold mb-4 min-h-[44px] touch-manipulation text-base" aria-label="Verify & Continue">Verify & Continue</button>
                    
                    <!-- ✅ ADD: Resend OTP Button (Visible by default with timer) -->
                    <div class="text-center mb-4">
                        <button type="button" id="resendOtpBtn" class="text-sm text-primary hover:text-secondary font-medium disabled:text-gray-400 disabled:cursor-not-allowed" aria-label="Resend OTP">
                            Didn't receive code?
                        </button>
                        <span id="resendTimer" class="text-sm text-gray-500 ml-2"></span>
                    </div>
                    
                    <div class="text-center">
                        <a href="/auth" class="text-sm text-gray-600 dark:text-gray-400 hover:text-primary">← Back to Login/Signup</a>
                    </div>
                    
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
            </div>
        </div>
    </div>

    <script>
        window.csrfToken = '<%= csrfToken %>';
        
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const email = urlParams.get('email');
            const type = urlParams.get('type');
            
            if (email) {
                document.getElementById('otpEmail').value = decodeURIComponent(email);
            }
            
            // ✅ ADD: Start timer immediately when page loads (30 seconds cooldown)
            startResendTimer(30);
            
            // Auto-format OTP input
            document.getElementById('otpCode').addEventListener('input', (e) => {
                e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6);
            });
            
            // Form submission
            document.getElementById('otpForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const formData = new FormData(e.target);
                const data = {
                    email: formData.get('email'),
                    code: formData.get('code')
                };
                
                try {
                    let endpoint = '';
                    let redirectUrl = '';
                    
                    if (type === 'signup') {
                        endpoint = '/api/auth/signup/verify';
                        redirectUrl = '/signup/profile?email=' + encodeURIComponent(data.email);
                    } else if (type === 'forgot') {
                        endpoint = '/api/auth/forgot-password/verify';
                        redirectUrl = '/reset-password?email=' + encodeURIComponent(data.email);
                    } else if (type === 'login') {
                        endpoint = '/api/auth/login/verify';
                        redirectUrl = '/dashboard';
                    }
                    
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': window.csrfToken
                        },
                        body: JSON.stringify(data)
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        showNotification('OTP verified successfully!', 'success');
                        setTimeout(() => {
                            window.location.replace(redirectUrl);
                        }, 1000);
                    } else {
                        // ✅ HANDLE OTP_EXPIRED and OTP_ALREADY_USED specially
                        if (result.errorCode === 'OTP_EXPIRED' || result.errorCode === 'OTP_ALREADY_USED') {
                            showNotification(result.error || 'OTP expired. Please resend.', 'error');
                        // Resend button already visible, just ensure it's enabled if timer expired
                        const resendBtn = document.getElementById('resendOtpBtn');
                        if (resendBtn && !resendBtn.disabled) {
                            // Timer might have expired, button should be clickable
                        }
                        } else {
                            showNotification(result.error || 'Invalid OTP', 'error');
                        }
                    }
                } catch (error) {
                    console.error('OTP verification error:', error);
                    showNotification('Network error. Please try again.', 'error');
                }
            });
            
            // ✅ ADD: Resend OTP Handler
            const resendBtn = document.getElementById('resendOtpBtn');
            if (resendBtn) {
                resendBtn.addEventListener('click', async () => {
                    const email = document.getElementById('otpEmail').value;
                    const timerSpan = document.getElementById('resendTimer');
                    
                    if (!email) {
                        showNotification('Email not found. Please go back and try again.', 'error');
                        return;
                    }
                    
                    // Disable button
                    resendBtn.disabled = true;
                    const originalHTML = resendBtn.innerHTML;
                    resendBtn.innerHTML = 'Sending...';
                    
                    try {
                        // ✅ UPDATE: Use dedicated resend endpoint
                        const response = await fetch('/api/auth/resend-otp', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': window.csrfToken
                            },
                            body: JSON.stringify({ 
                                email: email,
                                type: type  // 'signup', 'forgot', or 'login'
                            })
                        });
                        
                        const result = await response.json();
                        
                        if (response.ok) {
                            showNotification('New OTP sent to your email!', 'success');
                            // ✅ UPDATE: Show "Sent!" before starting timer
                            resendBtn.innerHTML = '✓ Sent!';
                            resendBtn.disabled = true;
    
                             // Wait a moment to show "Sent!" then start timer
                            setTimeout(() => {
                                // ✅ RESTART timer after successful resend (30 seconds)
                                startResendTimer(30);
                            }, 1000); // 1 second delay to show "Sent!"                            
                        } else {
                            // ✅ HANDLE rate limiting errors
                            if (response.status === 429) {
                                const retryAfter = response.headers.get('Retry-After') || '10 minutes';
                                showNotification(`Too many requests. Please wait ${retryAfter} before trying again.`, 'error');
                            } else {
                                showNotification(result.error || 'Failed to resend OTP', 'error');
                            }
                            resendBtn.disabled = false;
                            resendBtn.innerHTML = originalHTML;
                        }
                    } catch (error) {
                        console.error('Resend OTP error:', error);
                        showNotification('Network error. Please try again.', 'error');
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = originalHTML;
                    }
                });
            }
            
            // ✅ UPDATE: Countdown Timer Function (improved)
            function startResendTimer(seconds) {
                const resendBtn = document.getElementById('resendOtpBtn');
                const timerSpan = document.getElementById('resendTimer');
                
                if (!resendBtn || !timerSpan) return;
                
                // Clear any existing timer
                if (window.resendTimerInterval) {
                    clearInterval(window.resendTimerInterval);
                }
                
                resendBtn.disabled = true;
                resendBtn.classList.remove('hidden');
                timerSpan.classList.remove('hidden');
                
                let remaining = seconds;
                timerSpan.textContent = `Resend in ${remaining}s`;
                
                window.resendTimerInterval = setInterval(() => {
                    remaining--;
                    if (remaining > 0) {
                        timerSpan.textContent = `Resend in ${remaining}s`;
                    } else {
                        clearInterval(window.resendTimerInterval);
                        timerSpan.classList.add('hidden');
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = 'Didn\'t receive code?';
                    }
                }, 1000);
            }
        });
    </script>
    <%- include('partials/modal-helpers') %>
    <!-- ✅ Global Toast / Notification System (for standalone page) -->
    <script>
        (function () {
            window.UI = window.UI || {};
            if (window.UI.showToast) return; // don't override if layout already defined

            window.UI.showToast = function (message, type = 'success', opts = {}) {
                const duration = typeof opts.duration === 'number' ? opts.duration : 3000;
                const existing = document.getElementById('global-toast');
                if (existing && existing.parentNode) existing.parentNode.removeChild(existing);

                const el = document.createElement('div');
                el.id = 'global-toast';
                el.className =
                    'fixed top-4 right-4 z-50 max-w-sm w-[90vw] sm:w-auto px-4 py-3 sm:px-6 sm:py-4 ' +
                    'rounded-xl shadow-2xl transition-all duration-300 transform opacity-0 translate-y-2';

                let bgClasses, icon;
                if (type === 'success') {
                    bgClasses = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
                    icon = '✅';
                } else if (type === 'error') {
                    bgClasses = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
                    icon = '❌';
                } else {
                    bgClasses = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
                    icon = 'ℹ️';
                }

                el.className += ' ' + bgClasses;
                el.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="text-xl">${icon}</span>
                        <div class="flex flex-col text-left">
                            <span class="font-semibold">${message}</span>
                        </div>
                    </div>
                `;

                document.body.appendChild(el);

                requestAnimationFrame(() => {
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                });

                setTimeout(() => {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(-8px)';
                    setTimeout(() => {
                        if (el.parentNode) el.parentNode.removeChild(el);
                    }, 300);
                }, duration);
            };
        })();
    </script>
    
    <script>
        // ✅ Unified notification wrapper for verify-otp
        function showNotification(message, type = 'success') {
            if (window.UI && typeof window.UI.showToast === 'function') {
                window.UI.showToast(message, type);
            }
        }
    </script>
</body>
</html>