<%- include('layout', { title: `Profile - ${handle}`, body: `
<div class="px-4 py-6 sm:px-0">
    <div class="max-w-4xl mx-auto">
        <div id="profileContainer">
            <div class="text-center">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto"></div>
                <p class="mt-2 text-gray-600 dark:text-gray-300">Loading profile...</p>
            </div>
        </div>
    </div>
</div>

<script>
const handle = '<%= handle %>';
const token = '<%= token %>';

document.addEventListener('DOMContentLoaded', () => {
    loadPublicProfile();
});

async function loadPublicProfile() {
    try {
        const response = await fetch(`/api/profile/p/${handle}?t=${token}`, {
            headers: {
                'X-CSRF-Token': window.csrfToken
            }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            displayProfile(result);
        } else {
            showError(result.error || 'Failed to load profile');
        }
    } catch (error) {
        showError('Network error. Please try again.');
    }
}

function displayProfile(data) {
    const container = document.getElementById('profileContainer');
    
    container.innerHTML = `
        <div class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 rounded-3xl shadow-xl dark:shadow-gray-900 p-4 sm:p-6 lg:p-8 border border-gray-100 dark:border-gray-700">
            <div class="text-center mb-6 sm:mb-8">
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">@${data.user.handle}</h1>
                <p class="text-gray-600 dark:text-gray-300">Twin Profile</p>
                <div class="mt-4 inline-block bg-white/80 dark:bg-gray-800/80 text-blue-800 dark:text-blue-200 px-3 py-1 rounded-full text-xs sm:text-sm font-medium border border-blue-200/60 dark:border-blue-700/60">
                    Style analysis
                </div>
            </div>            
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Style Analysis</h2>
                    <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
                        <div class="space-y-3">
                            <div>
                                <span class="font-medium text-gray-700 dark:text-gray-200">Tone:</span>
                                <span class="ml-2 capitalize dark:text-gray-300">${data.twin.styleVector.tone}</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700 dark:text-gray-200">Emoji Usage:</span>
                                <span class="ml-2 dark:text-gray-300">${Math.round(data.twin.styleVector.emoji_usage * 100)}%</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700 dark:text-gray-200">Hinglish Ratio:</span>
                                <span class="ml-2 dark:text-gray-300">${Math.round(data.twin.styleVector.hinglish_ratio * 100)}%</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700 dark:text-gray-200">Sentence Length:</span>
                                <span class="ml-2 capitalize dark:text-gray-300">${data.twin.styleVector.sentence_length}</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700 dark:text-gray-200">Signature Patterns:</span>
                                <div class="mt-1">
                                    ${data.twin.styleVector.signature_patterns.map(pattern => 
                                        `<span class="inline-block bg-blue-200 dark:bg-blue-900/40 text-blue-800 dark:text-blue-200 px-2 py-1 rounded text-sm mr-1 mb-1">${pattern}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div>
                    <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Sample Reply</h2>
                    <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6">
                        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 border-l-4 border-blue-500 dark:border-blue-400">
                            <p class="text-gray-800 dark:text-gray-200 italic">"${data.twin.sampleReply}"</p>
                        </div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mt-2 text-center">Response written in user's style</p>
                    </div>
                </div>
            </div>
            
            <div class="mt-8 text-center">
                <button onclick="copyProfileLink()" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-secondary transition-colors font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Copy Profile Link">
                    Copy Profile Link
                </button>
            </div>
            
            <div class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
                <p>This profile was created using twin technology</p>
                <p>All content is written in your style</p>
            </div>
        </div>
    `;
}

function showError(message) {
    const container = document.getElementById('profileContainer');
    container.innerHTML = `
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900 p-4 sm:p-6 lg:p-8 text-center">
            <div class="text-red-500 dark:text-red-400 text-6xl mb-4">⚠️</div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Profile Not Available</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6">${message}</p>
            <a href="/" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-secondary transition-colors font-semibold">
                Go Home
            </a>
        </div>
    `;
}

function copyProfileLink() {
    const url = window.location.href;
    navigator.clipboard.writeText(url).then(() => {
        showFlashMessage('Profile link copied to clipboard!', 'success');
    }).catch(() => {
        showFlashMessage('Failed to copy link', 'error');
    });
}
</script>
` }) %>
