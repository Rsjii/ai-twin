<%- include('layout', { title: `Profile - ${handle}`, body: `
<div class="px-4 py-6 sm:px-0">
    <div class="max-w-4xl mx-auto">
        <div id="profileContainer">
            <div class="text-center">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto"></div>
                <p class="mt-2 text-gray-600">Loading profile...</p>
            </div>
        </div>
    </div>
</div>

<script>
const handle = '<%= handle %>';
const token = '<%= token %>';

document.addEventListener('DOMContentLoaded', () => {
    loadPublicProfile();
});

async function loadPublicProfile() {
    try {
        const response = await fetch(`/api/profile/p/${handle}?t=${token}`, {
            headers: {
                'X-CSRF-Token': window.csrfToken
            }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            displayProfile(result);
        } else {
            showError(result.error || 'Failed to load profile');
        }
    } catch (error) {
        console.error('Load profile error:', error);
        showError('Network error. Please try again.');
    }
}

function displayProfile(data) {
    const container = document.getElementById('profileContainer');
    
    container.innerHTML = `
        <div class="bg-white rounded-lg shadow-lg p-8">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">@${data.user.handle}</h1>
                <p class="text-gray-600">AI Twin Profile</p>
                <div class="mt-4 inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                    AI-generated • Private Alpha
                </div>
            </div>
            
            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Style Analysis</h2>
                    <div class="bg-gray-50 rounded-lg p-6">
                        <div class="space-y-3">
                            <div>
                                <span class="font-medium text-gray-700">Tone:</span>
                                <span class="ml-2 capitalize">${data.twin.styleVector.tone}</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">Emoji Usage:</span>
                                <span class="ml-2">${Math.round(data.twin.styleVector.emoji_usage * 100)}%</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">Hinglish Ratio:</span>
                                <span class="ml-2">${Math.round(data.twin.styleVector.hinglish_ratio * 100)}%</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">Sentence Length:</span>
                                <span class="ml-2 capitalize">${data.twin.styleVector.sentence_length}</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">Signature Patterns:</span>
                                <div class="mt-1">
                                    ${data.twin.styleVector.signature_patterns.map(pattern => 
                                        `<span class="inline-block bg-blue-200 text-blue-800 px-2 py-1 rounded text-sm mr-1 mb-1">${pattern}</span>`
                                    ).join('')}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div>
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Sample Reply</h2>
                    <div class="bg-blue-50 rounded-lg p-6">
                        <div class="bg-white rounded-lg p-4 border-l-4 border-blue-500">
                            <p class="text-gray-800 italic">"${data.twin.sampleReply}"</p>
                        </div>
                        <p class="text-sm text-gray-600 mt-2 text-center">AI-generated response in user's style</p>
                    </div>
                </div>
            </div>
            
            <div class="mt-8 text-center">
                <button onclick="copyProfileLink()" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-secondary transition-colors font-semibold">
                    Copy Profile Link
                </button>
            </div>
            
            <div class="mt-6 text-center text-sm text-gray-500">
                <p>This profile was created using AI Twin technology</p>
                <p>All content is AI-generated and clearly labeled</p>
            </div>
        </div>
    `;
}

function showError(message) {
    const container = document.getElementById('profileContainer');
    container.innerHTML = `
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
            <div class="text-red-500 text-6xl mb-4">⚠️</div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Profile Not Available</h2>
            <p class="text-gray-600 mb-6">${message}</p>
            <a href="/" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-secondary transition-colors font-semibold">
                Go Home
            </a>
        </div>
    `;
}

function copyProfileLink() {
    const url = window.location.href;
    navigator.clipboard.writeText(url).then(() => {
        showFlashMessage('Profile link copied to clipboard!', 'success');
    }).catch(() => {
        showFlashMessage('Failed to copy link', 'error');
    });
}
</script>
` }) %>
