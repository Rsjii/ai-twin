            desktopQuickActionsDropdown.classList.remove('hidden');
        }
    });
}

// Quick Actions buttons (desktop dropdown only)
['learningBtn', 'analyticsBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (el) {
        el.addEventListener('click', () => {
            if (id === 'learningBtn') {
                window.location.href = '/twin-settings';
