        function copyResponse(responseId) {
            const responseElement = document.getElementById(responseId);
            if (responseElement) {
                // ✅ FIX: Get only the main content, not the timestamp
                // Find the message text element (p tag with message content)
                const messageText = responseElement.querySelector('p.text-sm');
                let text = messageText ? messageText.textContent : '';
                
                // ✅ FIX: Remove any timestamp patterns (time formats and "ago" patterns)
                text = text.replace(/\d{1,2}:\d{2}:\d{2} [AP]M/g, '').trim();
                text = text.replace(/\d+\s*(min|mins|minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years)\s*ago/gi, '').trim();
                text = text.replace(/Just now/gi, '').trim();
                
                if (!text) {
                    // Fallback: get all text and remove timestamp elements
                    text = responseElement.textContent || '';
                    // Remove timestamp patterns
                    text = text.replace(/\d{1,2}:\d{2}:\d{2} [AP]M/g, '').trim();
                    text = text.replace(/\d+\s*(min|mins|minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years)\s*ago/gi, '').trim();
                    text = text.replace(/Just now/gi, '').trim();
                }
                
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(() => {
                        showNotification('Response copied to clipboard! 📋', 'success');
                    }).catch(() => {
                        fallbackCopyTextToClipboard(text);
                    });
                } else {
                    fallbackCopyTextToClipboard(text);
                }
            } else {
                showNotification('Could not find response to copy', 'error');
            }
        }

        function shareResponse(responseId) {
            const responseElement = document.getElementById(responseId);
            if (responseElement) {
                // ✅ FIX: Get only the message text from <p class="text-sm"> element
                // The timestamp is in a separate div, so p.text-sm should only have message
                const messageTextEl = responseElement.querySelector('p.text-sm');
                let text = '';
                
                if (messageTextEl) {
                    text = messageTextEl.textContent || messageTextEl.innerText || '';
                } else {
                    // Fallback: find message content div and get first p tag
                    const contentDiv = responseElement.querySelector('.bg-white.border, .message-content, .response-content, [class*="max-w"]');
                    if (contentDiv) {
                        const firstP = contentDiv.querySelector('p');
                        text = firstP ? (firstP.textContent || firstP.innerText || '') : '';
                    }
                }
                
                // ✅ FIX: Remove all timestamp patterns including "ago" text
                text = text.trim();
                text = text.replace(/\d{1,2}:\d{2}:\d{2} [AP]M/g, '').trim();
                text = text.replace(/\d+\s*(min|mins|minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years)\s*ago/gi, '').trim();
                text = text.replace(/Just now/gi, '').trim();
                
                if (!text) {
                    showNotification('Could not find message to share', 'error');
                    return;
                }
                
                // ✅ FIX: Use public profile link instead of chat link
                const userHandle = '<%= typeof user !== "undefined" && user && user.handle ? user.handle : "" %>';
                const profileUrl = userHandle ? `${window.location.origin}/@${userHandle}` : window.location.href;
                const shareText = `💬 Check out this amazing response from my Twin!\n\n"${text}"\n\n✨ Chat with this Twin: ${profileUrl}`;
                
                if (navigator.share) {
                    navigator.share({
                        title: 'Twin Response',
                        text: shareText
                    }).catch(() => {
                        // Fallback: copy message + link to clipboard
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(shareText).catch(() => {
                                fallbackShare(shareText);
                            });
                        } else {
                            fallbackShare(shareText);
                        }
                    });
                } else {
                    // Fallback: copy message + link to clipboard
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(shareText).catch(() => {
                            fallbackShare(shareText);
                        });
                    } else {
                        fallbackShare(shareText);
                    }
                }
            } else {
                showNotification('Could not find response to share', 'error');
            }
        }

        function disableFeedbackButtons(responseId, feedbackType) {
    const feedbackSection = document.getElementById(`feedbackSection_${responseId}`);
    if (feedbackSection) {
        // Remove the buttons
        feedbackSection.innerHTML = '';
        
        // Add feedback status display
        const statusDiv = document.createElement('div');
        statusDiv.className = 'flex items-center space-x-1 text-xs';
        
        if (feedbackType === 'positive') {
            statusDiv.innerHTML = `
                <span class="text-green-600 font-medium">👍 Feedback: Good</span>
            `;
        } else {
            statusDiv.innerHTML = `
                <span class="text-red-600 font-medium">👎 Feedback: Needs Improvement</span>
            `;
        }
        
        feedbackSection.appendChild(statusDiv);
    }
}

async function regenerateResponse(responseId) {
    try {
        showNotification('Regenerating response... 🔄', 'info');
        
        // Find the response element and its position
        const responseElement = document.getElementById(responseId);
        if (!responseElement) {
            showNotification('Response not found', 'error');
            return;
        }
        
        // FIXED: Get the database message ID from the response element
        const dbMessageId = responseElement.dataset.dbMessageId || responseId;
        
        // Get all messages to find the user message before this response
        const messages = Array.from(document.querySelectorAll('[id^="msg_"]'));
        const responseIndex = messages.findIndex(msg => msg.id === responseId);
        
        if (responseIndex === -1) {
            showNotification('Could not find response in chat', 'error');
            return;
        }
        
        // Find the user message before this suggested reply
        let lastUserMessage = null;
        let userMessageId = null;
        
        for (let i = responseIndex - 1; i >= 0; i--) {
            const msg = messages[i];
            const userMsgElement = msg.querySelector('.bg-blue-600, .bg-blue-500');
            if (userMsgElement) {
                lastUserMessage = userMsgElement.textContent.trim();
                userMessageId = msg.id;
                break;
            }
        }
        
        if (!lastUserMessage) {
            showNotification('Could not find original message to regenerate', 'error');
            return;
        }
        
        // ✅ STEP 1: Delete the response element itself AND all messages after it (from DOM)
        // This matches backend behavior - backend deletes the suggested reply and all subsequent messages
        responseElement.remove(); // Remove the response being regenerated
        
        // Remove all messages after the response
        for (let i = responseIndex + 1; i < messages.length; i++) {
            messages[i].remove();
        }
        
        // ✅ Refresh sidebar to update message counts after deletion
        if (currentChatId && typeof loadChatHistory === 'function') {
            loadChatHistory(false).catch(err => ErrorLogger.error('Sidebar refresh failed', err, {}));
        }
        
        // ✅ STEP 2: Regenerate the response (backend will handle deletion from database)
        const response = await fetch(`/api/enhanced-chat/${currentChatId}/enhanced-reply`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            body: JSON.stringify({
                message: lastUserMessage,
                strictStyle: false,
                regenerate: true, // Backend will delete old suggested reply and all messages after it
                regenerateMessageId: dbMessageId // ✅ Pass the database message ID to backend
            })
        });
        
        const data = await response.json();
        
        if (data.success && data.response) {
            // ✅ Refresh sidebar to update message counts after regeneration
            if (currentChatId && typeof loadChatHistory === 'function') {
                loadChatHistory(false).catch(err => ErrorLogger.error('Sidebar refresh failed', err, {}));
            }
            
            // ✅ STEP 3: Create NEW response element (don't update old one, it's already deleted)
            // Find the user message element to insert after
            const userMessageElement = document.getElementById(userMessageId);
            if (userMessageElement) {
                // Create new suggested reply element
                const newResponseId = data.messageId || `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                const newResponseDiv = document.createElement('div');
                newResponseDiv.id = newResponseId;
                newResponseDiv.dataset.dbMessageId = data.messageId || newResponseId;
                newResponseDiv.className = 'flex flex-col justify-start items-start';
                
                const messageWrapper = document.createElement('div');
                messageWrapper.className = 'flex justify-start';
                
                const messageContent = document.createElement('div');
                messageContent.className = 'max-w-xs sm:max-w-md lg:max-w-lg px-4 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-200';
                messageContent.innerHTML = `<p class="text-sm text-gray-800 dark:text-gray-100">${data.response}</p>`;                

                // Add timestamp
                if (window.TimeUtils) {
                    const timestampEl = document.createElement('div');
                    timestampEl.className = 'text-xs text-gray-500 dark:text-gray-400 mt-1';
                    const timestamp = data.timestamp || new Date().toISOString();
                    timestampEl.textContent = formatRelativeLabel(timestamp);
                    timestampEl.title = window.TimeUtils.formatFullDateTime(timestamp);
                    messageContent.appendChild(timestampEl);
                }
                
                // Create actions container
                const actionsContainer = document.createElement('div');
                actionsContainer.id = `actions_${newResponseId}`;
                actionsContainer.className = 'mt-2';
                
                messageWrapper.appendChild(messageContent);
                newResponseDiv.appendChild(messageWrapper);
                newResponseDiv.appendChild(actionsContainer);
                
                // Insert after user message
                userMessageElement.parentNode.insertBefore(newResponseDiv, userMessageElement.nextSibling);
                
                // Add response actions buttons
                setTimeout(() => {
                    addResponseActionsButton(newResponseId);
                }, 200);
                
                // Scroll to bottom
                const messagesContainer = document.getElementById('chatMessages');
                if (messagesContainer) {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }
            } else {
                // Fallback: use displayWithTypingEffect if user message not found
                displayWithTypingEffect('ai', data.response, {
                    intent: data.intent,
                    criticScore: data.criticScore,
                    latency: data.latency,
                    timestamp: data.timestamp || new Date().toISOString()
                }, (messageId) => {
                    // Update dataset with database ID
                    const msgElement = document.getElementById(messageId);
                    if (msgElement && data.messageId) {
                        msgElement.dataset.dbMessageId = data.messageId;
                    }
                    // Add actions
                    setTimeout(() => {
                        addResponseActionsButton(messageId);
                    }, 200);
                });
            }
            
            showNotification('Response regenerated! 🔄', 'success');
        } else {
            showNotification('Failed to regenerate response', 'error');
        }
    } catch (error) {
        ErrorLogger.error('Regenerate error', error, {});
        showNotification('Error regenerating response', 'error');
    }
}

        // ✅ Helper: Lock enhanced chat when quota exceeded
        function lockEnhancedChatForQuota(errorCode, retryAfter) {
            let msg = '';
            if (errorCode === 'QUOTA_EXCEEDED') {
                msg = 'Daily limit reached.';
                if (retryAfter) {
                    // retryAfter is now formatted as "7h" or "45m" from backend
                    msg += ` Please retry after ${retryAfter}`;
                }
            } else {
                msg = errorCode || 'Limit reached.';
            }

            // Disable input + button
            const messageInput = document.getElementById('messageInput');
            const sendBtn = document.getElementById('sendMessageBtn');
            if (messageInput) {
                messageInput.disabled = true;
                messageInput.style.opacity = '0.6';
                messageInput.style.cursor = 'not-allowed';
            }
            if (sendBtn) {
                sendBtn.disabled = true;
                sendBtn.style.opacity = '0.6';
                sendBtn.style.cursor = 'not-allowed';
            }

            // Show a clear toast/banner
            if (typeof showNotification === 'function') {
                showNotification(msg, 'error');
            } else if (window.UI?.showToast) {
                window.UI.showToast(msg, 'error');
            } else {
                alert(msg);
            }
        }

        // Helper functions
        function fallbackCopyTextToClipboard(text) {
            // ✅ FIX: Remove timestamp patterns including "ago" text
            let cleanText = text.replace(/\d{1,2}:\d{2}:\d{2} [AP]M/g, '').trim();
            cleanText = cleanText.replace(/\d+\s*(min|mins|minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years)\s*ago/gi, '').trim();
            cleanText = cleanText.replace(/Just now/gi, '').trim();
            
            const textArea = document.createElement("textarea");
            textArea.value = cleanText;
            textArea.style.position = "fixed";
            textArea.style.left = "-999999px";
            textArea.style.top = "-999999px";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            
            try {
                document.execCommand('copy');
                showNotification('Response copied to clipboard! 📋', 'success');
            } catch (err) {
                showNotification('Could not copy to clipboard', 'error');
            }
            
            document.body.removeChild(textArea);
        }
        
        function fallbackShare(text) {
            // ✅ FIX: Remove timestamp patterns including "ago" text
            let cleanText = text.replace(/\d{1,2}:\d{2}:\d{2} [AP]M/g, '').trim();
            cleanText = cleanText.replace(/\d+\s*(min|mins|minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years)\s*ago/gi, '').trim();
            cleanText = cleanText.replace(/Just now/gi, '').trim();
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(cleanText);
            } else {
                showNotification('Share feature not available on this device', 'error');
            }
        }        

        // Global submitFeedback function
        async function submitFeedback(responseId, rating, suggestion, tonePreference) {
            try {
                await fetch(`/api/enhanced-chat/${currentChatId}/feedback`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    body: JSON.stringify({
                        responseId,
                        rating,
                        suggestion,
                        tonePreference
                    })
                });
            } catch (error) {
                ErrorLogger.error('Error submitting feedback', error, {});
            }
        }

        // ✅ Global Toast / Notification System (for standalone page)
        (function () {
            window.UI = window.UI || {};
            if (window.UI.showToast) return; // don't override if layout already defined

            window.UI.showToast = function (message, type = 'success', opts = {}) {
                const duration = typeof opts.duration === 'number' ? opts.duration : 3000;
                const existing = document.getElementById('global-toast');
                if (existing && existing.parentNode) existing.parentNode.removeChild(existing);

                const el = document.createElement('div');
                el.id = 'global-toast';
                el.className =
                    'fixed top-4 right-4 z-50 max-w-sm w-[90vw] sm:w-auto px-4 py-3 sm:px-6 sm:py-4 ' +
                    'rounded-xl shadow-2xl transition-all duration-300 transform opacity-0 translate-y-2';

                let bgClasses, icon;
                if (type === 'success') {
                    bgClasses = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
                    icon = '✅';
                } else if (type === 'error') {
                    bgClasses = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
                    icon = '❌';
                } else {
                    bgClasses = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
                    icon = 'ℹ️';
                }

                el.className += ' ' + bgClasses;
                el.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="text-xl">${icon}</span>
                        <div class="flex flex-col text-left">
                            <span class="font-semibold">${message}</span>
                        </div>
                    </div>
                `;

                document.body.appendChild(el);

                requestAnimationFrame(() => {
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                });

                setTimeout(() => {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(-8px)';
                    setTimeout(() => {
                        if (el.parentNode) el.parentNode.removeChild(el);
                    }, 300);
                }, duration);
            };
        })();

        // ✅ Unified notification wrapper for chat-enhanced
        function showNotification(message, type = 'info') {
            if (window.UI && typeof window.UI.showToast === 'function') {
                window.UI.showToast(message, type);
            }
        }

