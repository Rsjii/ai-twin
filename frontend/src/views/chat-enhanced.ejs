<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Chat - Selflyx</title>
    <link rel="stylesheet" href="/css/output.css?v=<%= Date.now() %>">    
    <script src="/utils/timeUtils.js?v=<%= new Date().getTime() %>"></script>
    <script src="/utils/errorHandler.js"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <%
    // Feature flags (if not already defined in layout)
    var FEATURE_FLAGS = (typeof FEATURE_FLAGS !== 'undefined') ? FEATURE_FLAGS : {
        advancedLearningUI: false,
        memoryUI: false,
        styleAnchorsUI: false,
        chatFeedbackUI: false,
        advancedPublicAnalyticsUI: false
      };
    %>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 h-screen overflow-hidden flex flex-col font-inter">    
    <!-- IMMEDIATE Auth Check - runs before page renders -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <!--Header-->
    <%- include('header') %>
    
    <!-- ✅ PHASE 2: Message Banner (for redirect messages) -->
    <div id="redirectMessageBanner" class="hidden fixed top-16 left-0 right-0 z-50 bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-lg">
        <div class="container mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <p id="redirectMessageText" class="font-semibold text-sm md:text-base"></p>
                </div>
                <button id="closeMessageBanner" class="text-white hover:text-gray-200 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>    

    <div class="flex w-full flex-1 min-h-0 overflow-hidden">        
<!-- Mobile Chat Sidebar -->
<div id="mobile-chat-sidebar" class="fixed top-16 bottom-0 left-0 w-72 bg-white dark:bg-gray-800 shadow-xl z-40 transform -translate-x-full transition-transform duration-200 ease-out lg:hidden flex flex-col min-h-0">   
    <!-- ⬇️ TOP SECTION: New Chat + Search + Quick Actions (FIXED) -->
    <div class="p-3 sm:p-4 space-y-2 flex-shrink-0">
        <!-- New Chat -->
        <button id="mobile-new-chat-btn" class="w-full bg-gradient-to-r from-primary to-accent text-white py-2 px-3 rounded-lg transition-all duration-200 hover:shadow-md font-medium text-sm min-h-[40px] touch-manipulation">
            <div class="flex items-center space-x-2">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
                <span>New Chat</span>
            </div>
        </button>

        <!-- Search Chats (mobile) -->
        <div>
            <div class="relative">
                <span class="pointer-events-none absolute pl-3 inset-y-0 left-2.5 flex items-center text-gray-400 dark:text-gray-500 text-xs">
                    🔍
                </span>
                <input
                    id="enhancedChatSearchMobile"
                    type="text"
                    placeholder="Search chats"
                    class="w-full pl-12 pr-3 py-2 text-xs rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"                
                />
            </div>
        </div>
                
        <!-- Mobile Quick Actions (collapsible, default closed) -->
        <div class="lg:hidden border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900/40">
            <button
                id="mobileQuickActionsToggle"
                type="button"
                class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-200 bg-transparent hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors min-h-[40px]"
            >
                <span class="flex items-center gap-2">
                    <span>⚡</span>
                    <span>Quick Actions</span>
                </span>
                <svg id="mobileQuickActionsIcon" class="w-3 h-3 text-gray-500 dark:text-gray-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>
            <div id="mobileQuickActionsContent" class="hidden border-t border-gray-200 dark:border-gray-700">
                <div class="px-2 py-2 space-y-1">
                    <button
                        id="learningBtnMobile"
                        type="button"
                        class="w-full flex items-center justify-between px-3 py-2 rounded-md text-xs font-medium text-gray-800 dark:text-gray-100 hover:bg-white/70 dark:hover:bg-gray-800 transition-colors"
                    >
                        <span class="flex items-center gap-2">
                            <span>⚙️</span>
                            <span>Twin Settings</span>
                        </span>
                        <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </button>

                    <button
                        id="analyticsBtnMobile"
                        type="button"
                        class="w-full flex items-center justify-between px-3 py-2 rounded-md text-xs font-medium text-gray-800 dark:text-gray-100 hover:bg-white/70 dark:hover:bg-gray-800 transition-colors"
                    >
                        <span class="flex items-center gap-2">
                            <span>📈</span>
                            <span>Analytics</span>
                        </span>
                        <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>            

            <!-- ⬇️ BOTTOM SECTION: SIRF CHAT HISTORY SCROLL HOGA -->
            <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 pb-6">
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Chat History</h3>
                    <div id="mobile-chat-history" class="space-y-2">
                        <!-- Chat history items will be populated here -->
                    </div>
                </div>
            </div>
        </div>

<!-- Desktop Sidebar -->
<div class="hidden lg:block w-64 bg-white dark:bg-gray-800 shadow-lg dark:shadow-gray-900 overflow-x-hidden flex flex-col min-h-0">    
