                    </div>                    
                </div>
            </div>

            <!-- Chat Messages -->
                   <div class="flex-1 min-h-0 overflow-y-auto p-3 sm:p-4 lg:p-6 pb-[100px] sm:pb-6 space-y-3 sm:space-y-4 bg-gray-50 dark:bg-gray-900 w-full" id="chatMessages">                           
                <!-- Messages will be loaded here -->

