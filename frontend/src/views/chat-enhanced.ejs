<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enhanced Chat - AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg">
            <div class="p-4 border-b">
                <h2 class="text-lg font-semibold">AI Twin Chat</h2>
                <p class="text-sm text-gray-600">Enhanced with style learning</p>
            </div>
            
            <!-- Style Settings -->
            <div class="p-4 border-b">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Style Settings</h3>
                <div class="space-y-2">
                    <label class="flex items-center">
                        <input type="checkbox" id="strictStyle" class="mr-2">
                        <span class="text-sm">Strict Style Mode</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" id="intentClassification" class="mr-2" checked>
                        <span class="text-sm">Intent Classification</span>
                    </label>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="p-4">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Quick Actions</h3>
                <div class="space-y-2">
                    <button id="loadStyleAnchorsBtn" class="w-full text-left px-3 py-2 text-sm bg-blue-50 text-blue-700 rounded hover:bg-blue-100">
                        Manage Style Anchors
                    </button>
                    <button id="loadStyleCorrectionsBtn" class="w-full text-left px-3 py-2 text-sm bg-green-50 text-green-700 rounded hover:bg-green-100">
                        Style Corrections
                    </button>
                    <button id="loadAIRunsBtn" class="w-full text-left px-3 py-2 text-sm bg-purple-50 text-purple-700 rounded hover:bg-purple-100">
                        AI Runs Analytics
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="flex-1 flex flex-col">
            <!-- Chat Header -->
            <div class="bg-white border-b px-6 py-4">
                <div class="flex justify-between items-center">
                    <div>
                        <div class="flex items-center space-x-3">
                            <a href="/dashboard" class="text-blue-600 hover:text-blue-800 text-sm">← Back to Dashboard</a>
                            <div>
                                <h1 class="text-xl font-semibold">Enhanced Chat</h1>
                                <p class="text-sm text-gray-600">AI responses with style learning and corrections</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="text-sm text-gray-600">
                            <span id="intentDisplay">Intent: -</span>
                        </div>
                        <div class="text-sm text-gray-600">
                            <span id="criticScore">Score: -</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chat Messages -->
            <div class="flex-1 overflow-y-auto p-6 space-y-4" id="chatMessages">
                <!-- Messages will be loaded here -->
            </div>

            <!-- Message Input -->
            <div class="bg-white border-t p-6">
                <form id="messageForm" class="space-y-4">
                    <div>
                        <label for="messageInput" class="block text-sm font-medium text-gray-700 mb-2">Your Message</label>
                        <textarea 
                            id="messageInput" 
                            name="message"
                            rows="3"
                            placeholder="Type your message here..."
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            maxlength="300"
                            required
                        ></textarea>
                        <div class="mt-2 text-sm text-gray-500 text-right">
                            <span id="charCount">0</span> / 300 characters
                        </div>
                    </div>
                    <div class="flex space-x-4">
                        <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
                            Send Message
                        </button>
                        <button type="button" id="loadHistoryBtn" class="bg-gray-500 text-white px-6 py-3 rounded-lg hover:bg-gray-600 transition-colors font-semibold">
                            Load History
                        </button>
                    </div>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
            </div>
        </div>
    </div>

    <!-- AI Response Actions Modal -->
    <div id="responseActionsModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full">
                <div class="px-6 py-4 border-b">
                    <h3 class="text-lg font-medium">AI Response Actions</h3>
                </div>
                
                <div class="p-6">
<!-- Style Correction Buttons -->
<div class="mb-6">
    <h4 class="text-sm font-medium text-gray-700 mb-3">Style Corrections</h4>
    <div class="grid grid-cols-2 gap-2">
        <button id="shorterBtn" class="px-3 py-2 bg-red-100 text-red-700 rounded text-sm hover:bg-red-200">
            Shorter
        </button>
        <button id="longerBtn" class="px-3 py-2 bg-green-100 text-green-700 rounded text-sm hover:bg-green-200">
            Longer
        </button>
        <button id="casualBtn" class="px-3 py-2 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200">
            More Casual
        </button>
        <button id="formalBtn" class="px-3 py-2 bg-purple-100 text-purple-700 rounded text-sm hover:bg-purple-200">
            More Formal
        </button>
        <button id="emojiBtn" class="px-3 py-2 bg-orange-100 text-orange-700 rounded text-sm hover:bg-orange-200">
            Less Emojis
        </button>
        <button id="punchlineBtn" class="px-3 py-2 bg-yellow-100 text-yellow-700 rounded text-sm hover:bg-yellow-200">
            Add Punchline
        </button>
    </div>
</div>

<!-- Add to Anchors -->
<div class="mb-6">
    <h4 class="text-sm font-medium text-gray-700 mb-3">Learning</h4>
    <button id="addAnchorBtn" class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
        Add to Style Anchors
    </button>
</div>                    
                    <!-- Response Info -->
                    <div class="text-sm text-gray-600">
                        <p><strong>Intent:</strong> <span id="modalIntent">-</span></p>
                        <p><strong>Critic Score:</strong> <span id="modalScore">-</span></p>
                        <p><strong>Latency:</strong> <span id="modalLatency">-</span>ms</p>
                    </div>
                </div>
                
                <div class="px-6 py-4 border-t flex justify-end space-x-3">
                    <button id="closeModalBtn" class="px-4 py-2 text-gray-700 bg-gray-100 rounded hover:bg-gray-200">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentChatId = null;
        let currentResponse = null;
        let responseMetadata = null;

        // Initialize chat
        document.addEventListener('DOMContentLoaded', function() {
            // Get chat ID from EJS variable
            currentChatId = '<%= chatId %>';
            console.log('Enhanced chat initialized with chatId:', currentChatId);
            loadChatHistory();
            
            // Add event listeners for style settings
            const strictStyleCheckbox = document.getElementById('strictStyle');
            const intentClassificationCheckbox = document.getElementById('intentClassification');
            
            if (strictStyleCheckbox) {
                strictStyleCheckbox.addEventListener('change', function() {
                    console.log('Strict style mode:', this.checked);
                    // You can add logic here to save the setting
                });
            }
            
            if (intentClassificationCheckbox) {
                intentClassificationCheckbox.addEventListener('change', function() {
                    console.log('Intent classification:', this.checked);
                    // You can add logic here to save the setting
                });
            }

            // Add event listeners for quick action buttons
            document.getElementById('loadStyleAnchorsBtn').addEventListener('click', function() {
                console.log('Opening style anchors page...');
                window.open('/twin/' + getCurrentTwinId() + '/style-customize', '_blank');
            });

            document.getElementById('loadStyleCorrectionsBtn').addEventListener('click', function() {
                console.log('Opening style corrections page...');
                window.open('/twin/' + getCurrentTwinId() + '/learning-dashboard', '_blank');            });

            document.getElementById('loadAIRunsBtn').addEventListener('click', function() {
                console.log('Opening AI runs analytics page...');
                window.open('/ai-runs?twinId=' + getCurrentTwinId(), '_blank');
            });
        
            // Add event listeners for modal buttons
            document.getElementById('shorterBtn').addEventListener('click', () => applyStyleCorrection('shorter', 1));
            document.getElementById('longerBtn').addEventListener('click', () => applyStyleCorrection('shorter', -1));
            document.getElementById('casualBtn').addEventListener('click', () => applyStyleCorrection('casual', 1));
            document.getElementById('formalBtn').addEventListener('click', () => applyStyleCorrection('formal', 1));
            document.getElementById('emojiBtn').addEventListener('click', () => applyStyleCorrection('emoji_off', 1));
            document.getElementById('punchlineBtn').addEventListener('click', () => applyStyleCorrection('punchline', 1));
            document.getElementById('addAnchorBtn').addEventListener('click', addToAnchors);
            document.getElementById('loadHistoryBtn').addEventListener('click', loadChatHistory);
            document.getElementById('closeModalBtn').addEventListener('click', closeResponseActions);
        });


        // Message form submission
        const messageForm = document.getElementById('messageForm');
        if (messageForm) {
            messageForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const messageInput = document.getElementById('messageInput');
                if (!messageInput) return;
                
                const message = messageInput.value.trim();
                
                if (!message) return;
                
                console.log('🚀 Send message clicked!');
                console.log('Current chatId:', currentChatId);
                console.log('Message:', message);
                
                if (!currentChatId) {
                    console.log('❌ No chatId available');
                    alert('Chat not initialized. Please refresh the page.');
                    return;
                }
                
                // Add user message to chat
                addMessageToChat('user', message);
                
                // Clear input
                messageInput.value = '';
                document.getElementById('charCount').textContent = '0';
                
                // Show loading indicator
                const typingId = addMessageToChat('ai', 'Thinking...', true);
                
                try {
                    const strictStyle = document.getElementById('strictStyle').checked;
                    const intentClassification = document.getElementById('intentClassification').checked;
                    
                    console.log('📡 Sending request to:', `/api/enhanced-chat/${currentChatId}/enhanced-reply`);
                    console.log('Request body:', { message, strictStyle });
                    
                    const response = await fetch(`/api/enhanced-chat/${currentChatId}/enhanced-reply`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': '<%= csrfToken %>',
                            credentials: 'include'
                        },
                        body: JSON.stringify({
                            message: message,
                            strictStyle: strictStyle
                        })
                    });
                    
                    console.log('📡 Response status:', response.status);
                    const data = await response.json();
                    console.log('📡 Response data:', data);
                    
                    if (data.success) {
                        console.log('✅ Success! Adding response to chat');
                        // Remove typing indicator
                        removeMessage(typingId);
                        
                        // Add AI response
                        const responseId = addMessageToChat('ai', data.response, false, {
                            intent: data.intent,
                            criticScore: data.criticScore,
                            latency: data.latency
                        });
                        
                        // Store response metadata for actions
                        currentResponse = data.response;
                        responseMetadata = {
                            intent: data.intent,
                            criticScore: data.criticScore,
                            latency: data.latency
                        };
                        
                        // Update display
                        updateIntentDisplay(data.intent);
                        updateCriticScore(data.criticScore);
                        
                        // Add response actions button
                        addResponseActionsButton(responseId);
                    } else {
                        console.log('❌ API returned error:', data.error);
                        removeMessage(typingId);
                        addMessageToChat('ai', 'Sorry, I had trouble processing that. Please try again.');
                    }
                } catch (error) {
                    console.error('💥 Error sending message:', error);
                    removeMessage(typingId);
                    addMessageToChat('ai', 'Sorry, something went wrong. Please try again.');
                }
            });
        }

        // Character counter
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.addEventListener('input', (e) => {
                const count = e.target.value.length;
                const charCount = document.getElementById('charCount');
                if (charCount) {
                    charCount.textContent = count;
                }
            });
        }

        // Add message to chat
        function addMessageToChat(sender, content, isTyping = false, metadata = null) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageId = `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
            
            const messageDiv = document.createElement('div');
            messageDiv.id = messageId;
            messageDiv.className = `flex ${sender === 'user' ? 'justify-end' : 'justify-start'}`;
            
            const messageContent = document.createElement('div');
            messageContent.className = `max-w-xs lg:max-w-md px-4 py-2 rounded-lg ${
                sender === 'user' 
                    ? 'bg-blue-600 text-white' 
                    : 'bg-white border border-gray-200'
            }`;
            
            if (isTyping) {
                messageContent.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-gray-600"></div>
                        <span>${content}</span>
                    </div>
                `;
            } else {
                messageContent.innerHTML = `
                    <p class="text-sm">${content}</p>
                    <p class="text-xs mt-1 opacity-75">
                        ${metadata && metadata.timestamp ? 
                            new Date(metadata.timestamp).toLocaleTimeString() : 
                            new Date().toLocaleTimeString()
                        }
                    </p>
                `;
            }
            
            messageDiv.appendChild(messageContent);
            messagesContainer.appendChild(messageDiv);
            
            // Scroll to bottom
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            return messageId;
        }

        // Remove message
        function removeMessage(messageId) {
            const message = document.getElementById(messageId);
            if (message) {
                message.remove();
            }
        }

        // Add response actions button
        function addResponseActionsButton(responseId) {
            const messageDiv = document.getElementById(responseId);
            if (!messageDiv) return;
            
            const actionsDiv = document.createElement('div');
            actionsDiv.className = 'mt-2 flex space-x-2';
            actionsDiv.innerHTML = `
                <button id="styleActionsBtn" class="text-xs text-blue-600 hover:text-blue-800">
                    Style Actions
                </button>
                <button id="regenerateBtn" class="text-xs text-green-600 hover:text-green-800">
                    Regenerate
                </button>
            `;
            
            // Add event listeners for the dynamically created buttons
            actionsDiv.querySelector('#styleActionsBtn').addEventListener('click', () => showResponseActions(responseId));
            actionsDiv.querySelector('#regenerateBtn').addEventListener('click', () => regenerateResponse(responseId));
            
            messageDiv.appendChild(actionsDiv);
        }

        // Show response actions modal
        function showResponseActions(responseId) {
            const modal = document.getElementById('responseActionsModal');
            const modalIntent = document.getElementById('modalIntent');
            const modalScore = document.getElementById('modalScore');
            const modalLatency = document.getElementById('modalLatency');
            
            if (responseMetadata) {
                modalIntent.textContent = responseMetadata.intent;
                modalScore.textContent = responseMetadata.criticScore || 'N/A';
                modalLatency.textContent = responseMetadata.latency || 'N/A';
            }
            
            modal.classList.remove('hidden');
        }

        // Close response actions modal
        function closeResponseActions() {
            const modal = document.getElementById('responseActionsModal');
            modal.classList.add('hidden');
        }

        // Apply style correction
        async function applyStyleCorrection(knob, delta) {
            try {
                const response = await fetch(`/api/enhanced-chat/${currentChatId}/style-correct`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>',
                        credentials: 'include'
                    },
                    body: JSON.stringify({
                        knob: knob,
                        delta: delta
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Update the last AI message
                    const messages = document.querySelectorAll('[id^="msg_"]');
                    const lastAIMessage = Array.from(messages).reverse().find(msg => 
                        msg.querySelector('.bg-white.border')
                    );
                    
                    if (lastAIMessage) {
                        const contentDiv = lastAIMessage.querySelector('.bg-white.border');
                        contentDiv.textContent = data.correctedResponse;
                    }
                    
                    closeResponseActions();
                    showNotification('Style correction applied!', 'success');
                } else {
                    showNotification('Failed to apply correction', 'error');
                }
            } catch (error) {
                console.error('Style correction error:', error);
                showNotification('Error applying correction', 'error');
            }
        }

        // Add to anchors
        async function addToAnchors() {
            const userUtterance = prompt('What did the user say?');
            if (!userUtterance) return;
            
            try {
                const response = await fetch(`/api/enhanced-chat/${currentChatId}/add-anchor`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>',
                        credentials: 'include'
                    },
                    body: JSON.stringify({
                        userUtterance: userUtterance,
                        idealReply: currentResponse
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showNotification('Added to style anchors!', 'success');
                    closeResponseActions();
                } else {
                    showNotification('Failed to add anchor', 'error');
                }
            } catch (error) {
                console.error('Add anchor error:', error);
                showNotification('Error adding anchor', 'error');
            }
        }

        // Regenerate response
        async function regenerateResponse(responseId) {
            // This would implement response regeneration
            showNotification('Regeneration feature coming soon!', 'info');
        }

        // Update intent display
        function updateIntentDisplay(intent) {
            document.getElementById('intentDisplay').textContent = `Intent: ${intent}`;
        }

        // Update critic score display
        function updateCriticScore(score) {
            if (score !== null) {
                document.getElementById('criticScore').textContent = `Score: ${score}`;
            }
        }

        // Load chat history
        async function loadChatHistory() {
            try {
                console.log('Loading chat history for chatId:', currentChatId);
                
                // Clear existing messages
                const messagesContainer = document.getElementById('chatMessages');
                messagesContainer.innerHTML = '';
                
                // Try to load existing messages
                const response = await fetch(`/api/enhanced-chat/${currentChatId}`, {
                    headers: {
                        'X-CSRF-Token': '<%= csrfToken %>',
                        credentials: 'include'
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    console.log('Chat data loaded:', data);
                    
                    if (data.chat && data.chat.messages && data.chat.messages.length > 0) {
                        // Display existing messages (both user and AI)
                        data.chat.messages.forEach(msg => {
                            const sender = msg.sender === 'human' ? 'user' : 'ai';
                            addMessageToChat(sender, msg.content, false, {
                                timestamp: msg.createdAt
                            });
                        });
                    } else {
                        // Show welcome message if no history
                        addMessageToChat('ai', 'Hello! I\'m your AI twin with enhanced style learning. How can I help you today?');
                    }
                } else {
                    // Show welcome message if loading fails
                    addMessageToChat('ai', 'Hello! I\'m your AI twin with enhanced style learning. How can I help you today?');
                }
            } catch (error) {
                console.error('Error loading chat history:', error);
                // Show welcome message if error
                addMessageToChat('ai', 'Hello! I\'m your AI twin with enhanced style learning. How can I help you today?');
            }
        }


        // Helper function to get current twin ID
        function getCurrentTwinId() {
            // You can get this from the chat data or pass it from the server
            return 'default'; // This should be replaced with actual twin ID
        }

        // Add these new functions after line 575
function setStyleMode(mode) {
    console.log('Setting style mode:', mode);
    // Update UI to show current mode
    document.querySelectorAll('#casualBtn, #formalBtn, #toggleStyleBtn').forEach(btn => {
        btn.classList.remove('bg-blue-600', 'text-white');
        btn.classList.add('bg-gray-100', 'text-gray-700');
    });
    
    const activeBtn = document.getElementById(mode + 'Btn') || document.getElementById('toggleStyleBtn');
    if (activeBtn) {
        activeBtn.classList.remove('bg-gray-100', 'text-gray-700');
        activeBtn.classList.add('bg-blue-600', 'text-white');
    }
    
    showNotification(`Style mode: ${mode}`, 'info');
}

function giveFeedback(type) {
    console.log('Giving feedback:', type);
    // Send feedback to backend
    fetch(`/api/enhanced-chat/${currentChatId}/feedback`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({ type: type, responseId: currentResponseId })
    });
    
    showNotification(`Feedback: ${type}`, 'success');
    closeResponseActions();
}

function copyResponse() {
    if (currentResponse) {
        navigator.clipboard.writeText(currentResponse);
        showNotification('Response copied!', 'success');
        closeResponseActions();
    }
}

        // Show notification
        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-md shadow-lg z-50 ${
                type === 'success' ? 'bg-green-500 text-white' : 
                type === 'error' ? 'bg-red-500 text-white' : 
                'bg-blue-500 text-white'
            }`;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }
    </script>
</body>
</html>
