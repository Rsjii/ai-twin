          <div class="flex-1 flex flex-col w-full min-w-0 min-h-0">                   
            <!-- Mobile Chat Header with Hamburger -->
            <div class="lg:hidden bg-white dark:bg-gray-800 border-b dark:border-gray-700 px-3 sm:px-4 py-3 flex items-center gap-3 flex-shrink-0">   
    <button
