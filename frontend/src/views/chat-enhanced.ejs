    >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h6"></path>
        </svg>
    </button>
    <div class="flex-1 min-w-0">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white truncate">Chat</h2>
        <p class="text-xs text-gray-600 dark:text-gray-300">Smart replies in your style</p>
    </div>
    <!-- Mobile Tone Chip + Dropdown (small + medium: <lg) -->
