// Switch to different chat
async function switchToChat(chatId) {
    try {
        // Update current chat ID
        currentChatId = chatId;

        // ✅ URL sirf real chats ke liye
        if (chatId && !chatId.startsWith('draft_')) {
            const newUrl = `/chat/${encodeURIComponent(chatId)}`;
            window.history.pushState({}, '', newUrl);
        }

        // 🔥 Draft chats: pure blank state, backend ko touch nahi
        if (chatId && chatId.startsWith('draft_')) {
            const messagesContainer = document.getElementById('chatMessages');
            if (messagesContainer) messagesContainer.innerHTML = '';

            const initialLoading = document.getElementById('initialLoadingState');
            if (initialLoading) initialLoading.classList.add('hidden');

            const errorState = document.getElementById('errorState');
            if (errorState) errorState.classList.add('hidden');

            // (Optional) welcome message:
            // addMessageToChat('ai', 'Hello! I\'m your twin. How can I help you today?', false, null, new Date().toISOString());

            return;
        }

        // Real chats: load messages + sidebar
        await loadChatMessages();
        await loadChatHistory(false);
    } catch (error) {
        ErrorLogger.error('Error switching to chat', error, {});
        showNotification('Error switching to chat', 'error');
    }
}

// Delete chat function
async function deleteChat(chatId) {
    // Show confirmation dialog
    const confirmed = await window.ModalHelpers.confirm({
        title: 'Delete this chat?',
        message: 'This action cannot be undone. All messages in this chat will be permanently removed.',
        confirmLabel: 'Delete',
        cancelLabel: 'Cancel',
        type: 'danger'
    });
    if (!confirmed) {
        return;
    }
    
    // Find the chat item and delete button
    const chatItem = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
    const deleteBtn = chatItem?.querySelector('.delete-chat-btn');
    
    // Disable button and show loading state
    if (deleteBtn) {
        deleteBtn.disabled = true;
        deleteBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>';
    }
    
    try {
        const response = await fetch(`/api/chat/${chatId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            credentials: 'include'
        });
        
        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Failed to delete chat');
        }
        
        const data = await response.json();

        const pathParts = window.location.pathname.split('/').filter(Boolean); // ["chat", chatId?]
        const urlChatId = (pathParts[0] === 'chat' && pathParts[1]) ? pathParts[1] : null;
        const isCurrent = (chatId === currentChatId) || (urlChatId === chatId);

        if (isCurrent) {

            try {
                const chatMessages = document.getElementById('chatMessages');
                if (chatMessages) chatMessages.innerHTML =
                    '<div class="text-center py-8 text-gray-500 dark:text-gray-400">Chat deleted. Reloading…</div>';

                const messageInput = document.getElementById('messageInput');
                const sendBtn = document.getElementById('sendMessageBtn');
                if (messageInput) messageInput.disabled = true;
                if (sendBtn) sendBtn.disabled = true;
            } catch (e) {
                ErrorLogger.error('[deleteChat] UI hide failed', e, {});
            }

            setTimeout(() => window.location.replace('/chat'), 50);
            return;
        }

        // ✅ Non-current chat delete: update sidebar only
        document
            .querySelectorAll(`.chat-item[data-chat-id="${chatId}"]`)
            .forEach(el => el.remove());

        if (chatItem) {
            chatItem.style.transition = 'opacity 0.3s ease-out';
            chatItem.style.opacity = '0';
            await new Promise(resolve => setTimeout(resolve, 300));
            chatItem.remove();
        }

        await loadChatHistory(false);
        showNotification('Chat deleted successfully', 'success');
        
    } catch (error) {
        ErrorLogger.error('Error deleting chat', error, {});
        showNotification(error.message || 'Failed to delete chat', 'error');
        
        // Re-enable button on error
        if (deleteBtn) {
            deleteBtn.disabled = false;
            deleteBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
        }
    }
}


// Edit chat title function
async function editChatTitle(chatId, sourceEl) {
    // 1️⃣ Jis item pe click hua, usi ko prefer karo (desktop / mobile dono me safe)
    let chatItem = null;
    if (sourceEl && sourceEl.closest) {
        chatItem = sourceEl.closest('.chat-item');
    }
    if (!chatItem) {
        // Fallback: pehla matching chat-item (old delegations ke liye)
        chatItem = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
    }
    if (!chatItem) {
        ErrorLogger.error('Chat item not found for chatId', null, { chatId });
        return;
    }

    const titleElement = chatItem.querySelector('h4[id^="chat-title-"]');
    if (!titleElement) {
        ErrorLogger.error('Title element not found for chatId', null, { chatId });
        return;
    }

    // 2️⃣ Multiple inputs / re‑entry guard
    const existingInput = chatItem.querySelector('input[type="text"]');
    if (existingInput) {
        existingInput.focus();
        existingInput.select();
        return;
    }

    if (titleElement.style.display === 'none') {
        return; // already editing
    }

    const currentTitle = titleElement.textContent.trim();

    // 3️⃣ Input create + replace
    const input = document.createElement('input');
    input.type = 'text';
    input.value = currentTitle;
    input.className = 'font-medium text-sm flex-1 px-2 py-1 border border-blue-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500';
    input.style.minWidth = '100px';
    input.style.maxWidth = '200px';

    const parent = titleElement.parentElement;
    titleElement.style.display = 'none';
    parent.insertBefore(input, titleElement);
    input.focus();
    input.select();

    // 4️⃣ Save / cancel logic (same as pehle, bus titleElement/chatItem wale references use karo)
    const saveTitle = async () => {
        const newTitle = input.value.trim();

        if (newTitle === currentTitle) {
            input.remove();
            titleElement.style.display = '';
            return;
        }

        if (!newTitle) {
            input.remove();
            titleElement.style.display = '';
            showNotification('Title cannot be empty', 'error');
            return;
        }

        try {
            const response = await fetch(`/api/chats/${chatId}/title`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                credentials: 'include',
                body: JSON.stringify({ title: newTitle })
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || 'Failed to update title');
            }

            titleElement.textContent = newTitle;
            input.remove();
            titleElement.style.display = '';

            showNotification('Title updated successfully', 'success');
            await loadChatHistory(false);
        } catch (error) {
            ErrorLogger.error('Error updating title', error, {});
            showNotification(error.message || 'Failed to update title', 'error');
            input.remove();
            titleElement.style.display = '';
        }
    };

    input.addEventListener('blur', saveTitle);
    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            input.blur();
        } else if (e.key === 'Escape') {
            input.remove();
            titleElement.style.display = '';
        }
    });
}


// Create new enhanced chat (draft-only; real chat on first message)
async function createNewChat() {
    try {
        const existingDraftData = sessionStorage.getItem('draftEnhancedChat');
        if (existingDraftData) {
            const draft = JSON.parse(existingDraftData);
            // Draft ke liye switchToChat ab blank state show karega
            await switchToChat(draft.chatId);
            return;
        }
        
        const draftChatId = `draft_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
        const twinId = getCurrentTwinId();

        sessionStorage.setItem('draftEnhancedChat', JSON.stringify({
            chatId: draftChatId,
            twinId,
            createdAt: Date.now()
        }));

        addDraftChatToSidebar(draftChatId, 'New Chat');
        currentChatId = draftChatId;

        const chatMessages = document.getElementById('chatMessages');
        if (chatMessages) chatMessages.innerHTML = '';

        const initialLoading = document.getElementById('initialLoadingState');
        if (initialLoading) initialLoading.classList.add('hidden');

        const errorState = document.getElementById('errorState');
        if (errorState) errorState.classList.add('hidden');

        const newChatBtn = document.getElementById('newChatBtn');
        if (newChatBtn) newChatBtn.disabled = true;
    } catch (error) {
        ErrorLogger.error('Error creating enhanced draft chat', error, {});
    }
}

function addDraftChatToSidebar(chatId, title) {
    const sidebar = document.getElementById('chatHistoryItems') || document.getElementById('chatHistoryList');
    if (!sidebar) return;
    
    const emptyState = document.getElementById('chatHistoryEmptyState');
    if (emptyState) emptyState.classList.add('hidden');
    
    const draftItem = document.createElement('div');
    draftItem.className = 'chat-item draft';
    draftItem.dataset.chatId = chatId;
    draftItem.innerHTML = `
        <div class="flex items-center space-x-2">
            <span class="text-gray-400">💬</span>
            <span class="text-sm text-gray-600 dark:text-gray-300">${title}</span>
        </div>
    `;
    
    // Add click handler
    draftItem.addEventListener('click', () => {
        switchToChat(chatId);
    });
    
    // Insert at top
    sidebar.insertBefore(draftItem, sidebar.firstChild);
}

