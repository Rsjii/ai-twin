                    messageDiv.id = messageId;
                    messageDiv.className = `flex flex-col ${sender === 'user' ? 'justify-end items-end' : 'justify-start items-start'}`;
                    
                    const messageWrapper = document.createElement('div');
                    messageWrapper.className = `flex ${sender === 'user' ? 'justify-end' : 'justify-start'}`;
                    
                    const messageContent = document.createElement('div');
                    messageContent.className = `max-w-xs sm:max-w-md lg:max-w-lg px-4 py-2 rounded-lg ${
                        sender === 'user' 
                            ? 'bg-blue-600 text-white' 
                            : 'bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-100'                    
                    }`;
                    
                    messageContent.innerHTML = `
                        <p class="text-sm ${sender === 'user' ? 'text-white' : 'text-gray-900 dark:text-gray-100'}">${msg.content}</p>
                    `;
                    
                    // Add timestamp if available
                    if (msg.createdAt && window.TimeUtils) {
                        const timestampEl = document.createElement('div');
                        timestampEl.className = 'text-xs text-gray-500 dark:text-gray-400 mt-1';
                        timestampEl.textContent = formatRelativeLabel(msg.createdAt);
                        timestampEl.title = window.TimeUtils.formatFullDateTime(msg.createdAt);
                        messageContent.appendChild(timestampEl);
                    }
                    
                    // ✅ Create actions container for AI messages
                    const actionsContainer = document.createElement('div');
                    actionsContainer.id = `actions_${messageId}`;
                    actionsContainer.className = 'mt-2';
                    
                    messageWrapper.appendChild(messageContent);
                    messageDiv.appendChild(messageWrapper);
                    messageDiv.appendChild(actionsContainer); // ✅ Actions container separate
                    document.getElementById('chatMessages').appendChild(messageDiv);
                    
                    // Add feedback buttons to AI messages (not user messages)
                    if (sender === 'ai') {
                        // Delay to ensure container is in DOM
                        setTimeout(() => {
                            addResponseActionsButton(messageId);
                            
                            // Check if feedback already exists for this message
                            if (feedbackStatus[messageId]) {
                                const feedbackType = feedbackStatus[messageId].rating === 'positive' ? 'positive' : 'negative';
                                disableFeedbackButtons(messageId, feedbackType);
                            }
                        }, 50);
                    }
                });
            } else {
                // Show welcome message if no history
                addMessageToChat('ai', 'Hello! I\'m your twin. How can I help you today?');
            }
        } else {
            // Show welcome message if loading fails
            addMessageToChat('ai', 'Hello! I\'m your twin. How can I help you today?');
        }
    } catch (error) {
        ErrorLogger.error('Error loading chat messages', error, {});
        // Show welcome message if error
        addMessageToChat('ai', 'Hello! I\'m your twin. How can I help you today?');
    }
}

// Load chat history list for sidebar
async function loadChatHistory(showLoading = true) {
    // ✅ Show loading state
    const loadingState = document.getElementById('chatHistoryLoadingState');
    const emptyState = document.getElementById('chatHistoryEmptyState');

 // ✅ Loader sirf jab showLoading = true ho
 if (showLoading) {
        if (loadingState) loadingState.classList.remove('hidden');
        if (emptyState) emptyState.classList.add('hidden');
    }    
    
    try {
        const response = await fetch('/api/chats', {
            headers: {
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            credentials: 'include'
        });
        
        if (response.ok) {
            const data = await response.json();
            enhancedAllChats = Array.isArray(data.chats) ? data.chats : [];
            displayChatHistory(enhancedAllChats);
            return enhancedAllChats; // Return chats for caller to use
        }
        return [];
    } catch (error) {
        ErrorLogger.error('Error loading chat history', error, {});
        const itemsContainer = document.getElementById('chatHistoryItems') || document.getElementById('chatHistoryList');
        if (itemsContainer) itemsContainer.innerHTML = '';
        const emptyState = document.getElementById('chatHistoryEmptyState');
        if (emptyState) emptyState.classList.remove('hidden');
        return [];
    } finally {
        // ✅ Hide loading state after fetch completes
        if (showLoading && loadingState) loadingState.classList.add('hidden');
    }
}

