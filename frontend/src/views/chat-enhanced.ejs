                type="button"
                data-tone-mode="casual"
            >
                <span class="font-semibold">Casual</span>
                <span class="text-xs text-blue-600 dark:text-blue-300 font-normal">More friendly</span>
            </button>

            <button
                class="w-full text-left px-4 py-3 text-sm font-medium flex flex-col items-start gap-1 bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-200 hover:bg-purple-100 dark:hover:bg-purple-900/40 transition-colors"
                type="button"
                data-tone-mode="formal"
            >
                <span class="font-semibold">Formal</span>
                <span class="text-xs text-purple-600 dark:text-purple-300 font-normal">More professional</span>
            </button>

            <button
                class="w-full text-left px-4 py-3 text-sm font-medium flex flex-col items-start gap-1 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-100 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                type="button"
                data-tone-mode="auto"
            >
                <span class="font-semibold">Auto</span>
                <span class="text-xs text-gray-600 dark:text-gray-400 font-normal">Let AI decide</span>
            </button>
        </div>
    </div>
</div>

            <!-- Desktop Chat Header -->
            <div class="hidden lg:block bg-white dark:bg-gray-800 border-b dark:border-gray-700 px-6 py-4 flex-shrink-0">
                <div class="flex justify-between items-center">
                    <div>
                        <div>
