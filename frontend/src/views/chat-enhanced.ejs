            document.addEventListener('touchstart', handleChatTouchStart, { passive: true });
            document.addEventListener('touchend', handleChatTouchEnd, { passive: true });
            
            loadChatHistory();
            loadCurrentChatMessages();

            // Add event listeners for quick action buttons
            document.getElementById('styleCustomizeBtn').addEventListener('click', function() {
                window.open('/twin/' + getCurrentTwinId() + '/style-customize', '_blank');
            });

            document.getElementById('learningBtn').addEventListener('click', function() {
                window.open('/twin/' + getCurrentTwinId() + '/learning-dashboard', '_blank');
            });

            document.getElementById('analyticsBtn').addEventListener('click', function() {
                window.open('/analytics', '_blank');
            });

            // New chat button
            document.getElementById('newChatBtn').addEventListener('click', createNewChat);

            // Quick style buttons
            document.getElementById('casualBtn').addEventListener('click', () => setStyleMode('casual'));
            document.getElementById('formalBtn').addEventListener('click', () => setStyleMode('formal'));
            document.getElementById('toggleStyleBtn').addEventListener('click', () => setStyleMode('auto'));

            // Modal event listeners
            document.getElementById('closeModalBtn').addEventListener('click', closeResponseActions);
            document.getElementById('submitFeedbackBtn').addEventListener('click', submitModalFeedback);
            
            // Feedback buttons
            document.getElementById('thumbsUpBtn').addEventListener('click', () => giveFeedback('positive'));
            document.getElementById('thumbsDownBtn').addEventListener('click', () => giveFeedback('negative'));
            document.getElementById('regenerateBtn').addEventListener('click', () => regenerateResponse(currentResponseId));
            document.getElementById('copyBtn').addEventListener('click', () => copyResponse(currentResponseId));


// Message form submission
const messageForm = document.getElementById('messageForm');
if (messageForm) {
    messageForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const messageInput = document.getElementById('messageInput');
        if (!messageInput) return;
        
        const message = messageInput.value.trim();
        if (!message) return;
        
        // ✅ ADD: Show generating indicator
        const generatingIndicator = document.getElementById('generatingIndicator');
        if (generatingIndicator) {
            generatingIndicator.classList.remove('hidden');
            // Scroll to bottom to show generating indicator
            const chatMessages = document.getElementById('chatMessages');
            if (chatMessages) {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }
        
        // Disable input and button
        messageInput.disabled = true;
        const sendBtn = document.querySelector('#messageForm button[type="submit"]');
        if (sendBtn) sendBtn.disabled = true;
        
        // ✅ FIX: Declare typingId outside try block for catch block access
        let typingId = null;
        
        try {
            // ✅ FIX: Add user message to chat UI first
            addMessageToChat('user', message);
            
            // ✅ FIX: Create typing indicator
            typingId = addMessageToChat('ai', 'Thinking...', true);
            
            // FIRST: Save user message to database
            await fetch(`/api/chat/${currentChatId}/send`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>',
                    credentials: 'include'
                },
                body: JSON.stringify({ message: message })
            });

            // Clear input after saving
            messageInput.value = '';
            
            // Get current style mode from button states
            const strictStyle = document.getElementById('formalBtn').classList.contains('bg-blue-600');
            
            console.log('📡 Sending request to:', `/api/enhanced-chat/${currentChatId}/enhanced-reply`);
            console.log('Request body:', { message, strictStyle });
            
            const response = await fetch(`/api/enhanced-chat/${currentChatId}/enhanced-reply`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>',
                    credentials: 'include'
                },
                body: JSON.stringify({
                    message: message,
                    strictStyle: strictStyle
                })
            });
            
            console.log('📡 Response status:', response.status);
            const data = await response.json();
            console.log('📡 Response data:', data);
            
            if (data.success) {
                console.log('✅ Success! Adding response to chat');
                // Remove typing indicator
                removeMessage(typingId);
                
                // ✅ Hide generating indicator after response
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                
                // ✅ IMMEDIATE: Update sidebar BEFORE typing starts (last message only)
                updateSidebarImmediately(data.response, message);
                
                // ✅ Display with character-by-character typing effect
                const responseId = displayWithTypingEffect('ai', data.response, {
                    intent: data.intent,
                    criticScore: data.criticScore,
                    latency: data.latency
                }, (messageId) => {
                    // Callback after typing completes
                    // Store response metadata for actions
                    currentResponse = data.response;
                    currentResponseId = messageId;
                    responseMetadata = {
                        intent: data.intent,
                        criticScore: data.criticScore,
                        latency: data.latency
                    };
                    
                    // Update display
                    updateIntentDisplay(data.intent);
                    updateCriticScore(data.criticScore);
                });
                
                // ✅ IMMEDIATE: Add response actions button (with delay to ensure container exists)
                setTimeout(() => {
                    addResponseActionsButton(responseId);
                }, 200); // 200ms delay to ensure actions container is created
                
                // ✅ Update title if generated
                if (data.generatedTitle) {
                    console.log('📝 Title generated:', data.generatedTitle);
                    // Update title in sidebar immediately
                    const currentChatItem = document.querySelector(`.chat-item[data-chat-id="${currentChatId}"]`);
                    if (currentChatItem) {
                        const titleElement = currentChatItem.querySelector('h4');
                        if (titleElement) {
                            titleElement.textContent = data.generatedTitle;
                            console.log('✅ Title updated in sidebar:', data.generatedTitle);
                        }
                    }
                }
                
                // ✅ Refresh chat history after a delay (to sync with backend - this will update count and title correctly)
                setTimeout(() => {
                    loadChatHistory();
                }, 1000);
                
                // ✅ RE-ENABLE: Input and button after successful response
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
                
            } else {
                console.log('❌ API returned error:', data.error);
                removeMessage(typingId);
                // Hide generating indicator on error
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                addMessageToChat('ai', 'Sorry, I had trouble processing that. Please try again.');
                
                // ✅ RE-ENABLE: Input and button on error
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
            }
        } catch (error) {
            // Hide generating indicator on error
            if (generatingIndicator) {
                generatingIndicator.classList.add('hidden');
            }
            
            // ✅ Safety check: Remove typing indicator if it exists
            if (typingId) {
                removeMessage(typingId);
            }
            
            // ✅ RE-ENABLE: Input and button on exception
            messageInput.disabled = false;
            if (sendBtn) sendBtn.disabled = false;
            
            console.error('Error sending message:', error);
            showNotification('Error sending message', 'error');
        }
    });
      }   

        // Character counter
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.addEventListener('input', (e) => {
                const count = e.target.value.length;
                const charCount = document.getElementById('charCount');
                if (charCount) {
                    charCount.textContent = count;
                }
            });
        }

        // Handle Enter key for submission (Enter = submit, Shift+Enter = new line)
        if (messageInput) {
            messageInput.addEventListener('keydown', function(e) {
                // If Enter is pressed without Shift, submit the form
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault(); // Prevent default newline behavior
                    // Trigger form submission
                    const messageForm = document.getElementById('messageForm');
                    if (messageForm) {
                        messageForm.dispatchEvent(new Event('submit'));
                    }
                }
                // If Shift+Enter is pressed, allow default behavior (new line)
            });
        }

        }); // Close DOMContentLoaded
    </script>

    <style>
        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }
        
        .streaming-cursor {
            display: inline-block;
            animation: blink 1s infinite;
            color: inherit;
        }
    </style>
</body>
</html>
