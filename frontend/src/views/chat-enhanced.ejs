async function loadFeedbackStatus(chatId) {
    // ✅ SAFETY: Check if chatId is null/empty before API call
    if (!chatId || chatId === 'null' || chatId === 'undefined' || chatId === '') {
        ErrorLogger.warn('Cannot load feedback status: chatId is empty', {});
        return {};
    }
    
    // ✅ FIX: Skip API call for draft chats
    if (chatId && chatId.startsWith('draft_')) {
        return {};
    }
    
    try {
        const response = await fetch(`/api/enhanced-chat/${chatId}/feedback-status`, {
            headers: {
                'X-CSRF-Token': '<%= csrfToken %>',
                credentials: 'include'
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            return data.feedback || {};
        }
        return {};
    } catch (error) {
        ErrorLogger.error('Error loading feedback status', error, {});
        return {};
    }
}

