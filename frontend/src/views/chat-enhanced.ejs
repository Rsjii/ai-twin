});

// Mobile Quick Actions buttons (mobile sidebar only)
['learningBtnMobile', 'analyticsBtnMobile'].forEach(id => {
    const el = document.getElementById(id);
    if (el) {
        el.addEventListener('click', () => {
            if (id === 'learningBtnMobile') {
                window.location.href = '/twin-settings';
            } else if (id === 'analyticsBtnMobile') {
                window.location.href = '/analytics';
            }
        });
    }
});


    // Mobile Tone dropdown (small + medium: <lg)
    const mobileToneButton = document.getElementById('mobileToneButton');
    const mobileToneLabel = document.getElementById('mobileToneLabel');
    const desktopToneLabel = document.getElementById('desktopToneLabel');
    const mobileToneDropdown = document.getElementById('mobileToneDropdown');

    function closeMobileToneDropdown() {
        if (mobileToneDropdown) mobileToneDropdown.classList.add('hidden');
    }

    if (mobileToneButton && mobileToneDropdown) {
        mobileToneButton.addEventListener('click', (e) => {
            e.stopPropagation();
            mobileToneDropdown.classList.toggle('hidden');
        });
    }

    // Close mobile dropdown on outside click
    document.addEventListener('click', (e) => {
        if (!mobileToneDropdown || !mobileToneButton) return;
        if (!mobileToneDropdown.contains(e.target) && !mobileToneButton.contains(e.target)) {
            closeMobileToneDropdown();
        }
    });

    // Handle tone selection (mobile dropdown)
    if (mobileToneDropdown) {
        mobileToneDropdown.querySelectorAll('[data-tone-mode]').forEach(btn => {
            btn.addEventListener('click', () => {
                const mode = btn.getAttribute('data-tone-mode') || 'auto';

                // Reuse existing style logic
                setStyleMode(mode);

                const pretty =
                    mode === 'casual' ? 'Casual' :
                    mode === 'formal' ? 'Formal' :
                    'Auto';

                if (mobileToneLabel) mobileToneLabel.textContent = `Tone: ${pretty}`;
                if (desktopToneLabel) desktopToneLabel.textContent = `Tone: ${pretty}`;

                closeMobileToneDropdown();
            });
        });
    }

    
// Desktop Tone Dropdown (with mutual exclusivity)
if (desktopToneButton && desktopToneDropdown) {
    desktopToneButton.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = desktopToneDropdown.classList.contains('hidden');
        closeAllDesktopDropdowns();
        if (isHidden) {
            desktopToneDropdown.classList.remove('hidden');
        }
    });
    
    // Handle tone selection in dropdown
    desktopToneDropdown.querySelectorAll('[data-tone-mode]').forEach(btn => {
        btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-tone-mode') || 'auto';
            
            // Call existing style logic
            setStyleMode(mode);
            
            const pretty =
                mode === 'casual' ? 'Casual' :
                mode === 'formal' ? 'Formal' :
                'Auto';
            
            // Update desktop label
            if (desktopToneLabel) {
                desktopToneLabel.textContent = `Tone: ${pretty}`;
            }
            
            // Close dropdown
            closeAllDesktopDropdowns();
        });
    });
}

// Close dropdowns when clicking outside (both Quick Actions and Tone)
document.addEventListener('click', (e) => {
    if (desktopQuickActionsButton && desktopToneButton) {
        if (!desktopQuickActionsButton.contains(e.target) && 
            !desktopQuickActionsDropdown?.contains(e.target) &&
            !desktopToneButton.contains(e.target) && 
            !desktopToneDropdown?.contains(e.target)) {
            closeAllDesktopDropdowns();
        }
    }
});

// Quick style buttons (now only desktop/main area)
['casualBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', () => setStyleMode('casual'));
});
['formalBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', () => setStyleMode('formal'));
});
['toggleStyleBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', () => setStyleMode('auto'));
});


            // Modal event listeners
            const closeModalBtn = document.getElementById('closeModalBtn');
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', closeResponseActions);
            }

            const copyBtnEl = document.getElementById('copyBtn');
            if (copyBtnEl) {
                copyBtnEl.addEventListener('click', () => copyResponse(currentResponseId));
            }

            <% if (FEATURE_FLAGS.chatFeedbackUI) { %>
            const submitFeedbackBtn = document.getElementById('submitFeedbackBtn');
            if (submitFeedbackBtn) {
                submitFeedbackBtn.addEventListener('click', submitModalFeedback);
            }

            // Feedback buttons
            const thumbsUpBtn = document.getElementById('thumbsUpBtn');
            if (thumbsUpBtn) {
                thumbsUpBtn.addEventListener('click', () => giveFeedback('positive'));
            }

            const thumbsDownBtn = document.getElementById('thumbsDownBtn');
            if (thumbsDownBtn) {
                thumbsDownBtn.addEventListener('click', () => giveFeedback('negative'));
            }

            const regenerateBtnEl = document.getElementById('regenerateBtn');
            if (regenerateBtnEl) {
                regenerateBtnEl.addEventListener('click', () => regenerateResponse(currentResponseId));
            }
            <% } %>

            // ✅ FIX: Handle Enter key + character counter after DOM is ready
            const sharedMessageInput = document.getElementById('messageInput');
            if (sharedMessageInput) {
                // Character counter
                sharedMessageInput.addEventListener('input', (e) => {
                    const count = e.target.value.length;
                    const charCount = document.getElementById('charCount');
                    if (charCount) {
                        charCount.textContent = count;
                    }
                });

                // Enter = submit, Shift+Enter = newline
                sharedMessageInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        const messageForm = document.getElementById('messageForm');
                        if (messageForm) {
                            messageForm.dispatchEvent(new Event('submit'));
                        }
                    }
                    // Shift+Enter keeps default behavior
                });
            }

// Message form submission
const messageForm = document.getElementById('messageForm');
if (messageForm) {
    messageForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const messageInput = document.getElementById('messageInput');
        if (!messageInput) return;
        
        const message = messageInput.value.trim();
        if (!message) return;
        
        // ✅ ADD: Show generating indicator
        const generatingIndicator = document.getElementById('generatingIndicator');
        if (generatingIndicator) {
            generatingIndicator.classList.remove('hidden');
            // Scroll to bottom to show generating indicator
            const chatMessages = document.getElementById('chatMessages');
            if (chatMessages) {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }
        
        // Disable input and button
        messageInput.disabled = true;
        const sendBtn = document.querySelector('#messageForm button[type="submit"]');
        if (sendBtn) sendBtn.disabled = true;
        
        // ✅ FIX: Declare typingId and userMessageId outside try block for catch block access
        let typingId = null;
        let userMessageId = null;
        
        try {
            // ✅ FIX: Add user message to chat UI first (store ID to remove if quota exceeded)
            const userMessageTimestamp = new Date().toISOString();
            userMessageId = addMessageToChat('user', message, false, null, userMessageTimestamp);
            
            // ✅ FIX: Create typing indicator
            typingId = addMessageToChat('ai', 'Thinking...', true, null, null);


            // ✅ Check if draft chat, convert to actual chat first
let actualChatId = currentChatId;
if (currentChatId && currentChatId.startsWith('draft_')) {
    try {
        const draftData = sessionStorage.getItem('draftEnhancedChat');
        if (!draftData) {
            showNotification('Draft data not found', 'error');
            return;
        }

            const draft = JSON.parse(draftData);
            const response = await fetch('/api/chats/new', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                credentials: 'include',
                body: JSON.stringify({ twinId: draft.twinId })
            });
                        
                        if (!response.ok) {
                            const errorData = await response.json();
                            throw new Error(errorData.error || 'Failed to create chat');
                        }
            
            const data = await response.json();
                        
        // ✅ Normalize new chat id from backend
        if (!data.success) {
            ErrorLogger.error('Failed to create chat', null, { data });
            showNotification(data.error || 'Failed to create chat', 'error');
            return;
        }

        const newId = data.chatId || (data.chat && data.chat.publicId);
        if (!newId) {
            showNotification('Backend did not return a chatId', 'error');
            return;
        }

        actualChatId = newId;
        currentChatId = newId;

        // ✅ Common cleanup (works for both chatId/publicId paths)
        removeDraftFromSidebar(draft.chatId);
        await loadChatHistory(false);
                sessionStorage.removeItem('draftEnhancedChat');
                
                const newChatBtn = document.getElementById('newChatBtn');
                if (newChatBtn) newChatBtn.disabled = false;
    } catch (error) {
        ErrorLogger.error('Error creating chat from draft', error, {});
                    showNotification(error.message || 'Error creating chat', 'error');
        return;
    }
}

            
            // Get current style mode from button states
            const strictStyle = document.getElementById('formalBtn').classList.contains('bg-blue-600');
            
            const response = await fetch(`/api/enhanced-chat/${actualChatId}/enhanced-reply`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                credentials: 'include',
                body: JSON.stringify({
                    message: message,
                    strictStyle: strictStyle
                })
            });
            
            const data = await response.json();
            
            // ✅ ADD: quota handling (logged-in users) - BEFORE saving message
            if (!response.ok && response.status === 429) {
                // Remove typing indicator
                if (typingId) removeMessage(typingId);
                // ✅ FIX: Remove user message from UI if quota exceeded (message not sent)
                if (userMessageId) removeMessage(userMessageId);
                // Hide generating indicator on quota error
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                // Re-enable input and button (lockEnhancedChatForQuota will disable again, but we need to restore message)
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
                // Restore message text so user doesn't lose it
                messageInput.value = message;
                lockEnhancedChatForQuota(data?.errorCode, data?.retryAfter);
                return;
            }
            
            // Clear input only after successful response
            messageInput.value = '';
            
            if (data.success) {
                // Remove typing indicator
                removeMessage(typingId);
                
                // ✅ Hide generating indicator after response
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                
                // ✅ IMMEDIATE: Update sidebar BEFORE typing starts (last message only)
                updateSidebarImmediately(data.response, message);
                
                // ✅ Display with character-by-character typing effect
                const responseId = displayWithTypingEffect('ai', data.response, {
                    intent: data.intent,
                    criticScore: data.criticScore,
                    latency: data.latency,
                    timestamp: data.timestamp || new Date().toISOString()
                }, (messageId) => {
                    // Callback after typing completes
                    // Store response metadata for actions
                    currentResponse = data.response;
                    currentResponseId = messageId;
                    responseMetadata = {
                        intent: data.intent,
                        criticScore: data.criticScore,
                        latency: data.latency
                    };
                    
                    // Update display
                    updateIntentDisplay(data.intent);
                    updateCriticScore(data.criticScore);
                });
                
                // ✅ IMMEDIATE: Add response actions button (with delay to ensure container exists)
                setTimeout(() => {
                    addResponseActionsButton(responseId);
                }, 200); // 200ms delay to ensure actions container is created
                
                // ✅ Update title if generated
                if (data.generatedTitle) {
                    // Update title in sidebar immediately
                    const currentChatItem = document.querySelector(`.chat-item[data-chat-id="${currentChatId}"]`);
                    if (currentChatItem) {
                        const titleElement = currentChatItem.querySelector('h4');
                        if (titleElement) {
                            titleElement.textContent = data.generatedTitle;
                        }
                    }
                }
                
                // ✅ Refresh chat history after a delay (to sync with backend - this will update count and title correctly)
                setTimeout(() => {
                    loadChatHistory(false);
                }, 1000);
                
                // ✅ RE-ENABLE: Input and button after successful response
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
                
            } else {
                removeMessage(typingId);
                // Hide generating indicator on error
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                addMessageToChat('ai', 'Sorry, I had trouble processing that. Please try again.', false, null, new Date().toISOString());
                
                // ✅ RE-ENABLE: Input and button on error
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
            }
        } catch (error) {
            // Hide generating indicator on error
            if (generatingIndicator) {
                generatingIndicator.classList.add('hidden');
            }
            
            // ✅ Safety check: Remove typing indicator if it exists
            if (typingId) {
                removeMessage(typingId);
            }
            
            // ✅ RE-ENABLE: Input and button on exception
            messageInput.disabled = false;
            if (sendBtn) sendBtn.disabled = false;
            
            ErrorLogger.error('Error sending message', error, {});
            showNotification('Error sending message', 'error');
        }
    });
      }   


}); // Close DOMContentLoaded function

// Enhanced Chat – sidebar search (desktop + mobile)
let enhancedSearchTimeout;
const enhancedSearchInputs = [
    document.getElementById('enhancedChatSearchDesktop'),
    document.getElementById('enhancedChatSearchMobile')
].filter(Boolean);

function applyEnhancedChatSearch(query) {
    if (!Array.isArray(enhancedAllChats)) return;
    const q = (query || '').trim().toLowerCase();
    const source = enhancedAllChats;
    const filtered = q
        ? source.filter(chat => {
            const title = (chat.title || '').toLowerCase();
            const lastRaw = chat.lastMessage
                ? (typeof chat.lastMessage === 'string'
                    ? chat.lastMessage
                    : (chat.lastMessage.content || ''))
                : '';
            const last = lastRaw.toLowerCase();
            return title.includes(q) || last.includes(q);
        })
        : source;
    displayChatHistory(filtered);
}

enhancedSearchInputs.forEach(input => {
    input.addEventListener('input', (e) => {
        const value = e.target.value;
        if (enhancedSearchTimeout) clearTimeout(enhancedSearchTimeout);
        enhancedSearchTimeout = setTimeout(() => applyEnhancedChatSearch(value), 150);
    });
});

