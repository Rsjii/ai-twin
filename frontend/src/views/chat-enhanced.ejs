    <script>
        // Mobile chat functionality
        function openMobileChatSidebar() {
    const sidebar = document.getElementById('mobile-chat-sidebar');
    if (sidebar) {
        // Slide IN from left
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
    }
}

function closeMobileChatSidebar() {
    const sidebar = document.getElementById('mobile-chat-sidebar');
    if (sidebar) {
        // Slide OUT to left again
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        document.body.style.overflow = '';
    }
}

        // Touch gesture handling for chat
        let chatTouchStartX = 0;
        let chatTouchStartY = 0;
        
        function handleChatTouchStart(e) {
            chatTouchStartX = e.touches[0].clientX;
            chatTouchStartY = e.touches[0].clientY;
        }
        
        function handleChatTouchEnd(e) {
            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const deltaX = touchEndX - chatTouchStartX;
            const deltaY = touchEndY - chatTouchStartY;
            
            // Check if it's a horizontal swipe
            if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
                const sidebar = document.getElementById('mobile-chat-sidebar');
                
                if (deltaX < 0 && sidebar && sidebar.classList.contains('translate-x-0')) {
                    // Swipe left to close sidebar
                    closeMobileChatSidebar();
                } else if (deltaX > 0 && sidebar && sidebar.classList.contains('translate-x-full')) {
                    // Swipe right to open sidebar
                    openMobileChatSidebar();
                }
            }
        }

// Global variables
let currentChatId = null;
let currentResponse = null;
let currentResponseId = null;
let responseMetadata = null;
let enhancedAllChats = [];

// Human-friendly relative time (no exact clock times)
function formatRelativeLabel(timestamp) {
    try {
        const date = new Date(timestamp);
        if (isNaN(date.getTime())) return '';
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffSec = Math.floor(diffMs / 1000);
        const diffMin = Math.floor(diffSec / 60);
        const diffHr  = Math.floor(diffMin / 60);
        const diffDay = Math.floor(diffHr / 24);
        const diffMonth = Math.floor(diffDay / 30);
        const diffYear  = Math.floor(diffDay / 365);

        if (diffSec < 60) return 'Just now';
        if (diffMin < 60) return `${diffMin} min${diffMin > 1 ? 's' : ''} ago`;
        if (diffHr  < 24) return `${diffHr} hour${diffHr > 1 ? 's' : ''} ago`;
        if (diffDay < 7)  return `${diffDay} day${diffDay > 1 ? 's' : ''} ago`;

        const weeks = Math.floor(diffDay / 7);
        if (diffDay < 30) return `${weeks} week${weeks > 1 ? 's' : ''} ago`;
        if (diffMonth < 12) return `${diffMonth} month${diffMonth > 1 ? 's' : ''} ago`;
        return `${diffYear} year${diffYear > 1 ? 's' : ''} ago`;
    } catch (e) {
        ErrorLogger.error('Error in formatRelativeLabel', e, {});
        return '';
    }
}


async function upvoteResponse(responseId) {
