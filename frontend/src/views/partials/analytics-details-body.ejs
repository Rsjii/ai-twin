<div class="px-4 py-6 sm:px-0">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-6 sm:mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                        <%= analyticsTypeValue === 'likers' ? 'Likes' : analyticsTypeValue === 'followers' ? 'Followers' : 'Chat Participants' %> Details
                    </h1>
                    <p class="text-gray-600 dark:text-gray-300">Detailed analytics for your twin's <%= analyticsTypeValue %></p>
                </div>
                <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
                    <a href="/analytics"
                       class="flex-1 sm:flex-none inline-flex justify-center px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base items-center"
                       aria-label="Back to Analytics">
                        ← Back to Analytics
                    </a>
                    <button
                       type="button"
                       id="exportCSVBtn"
                       class="flex-1 sm:flex-none inline-flex justify-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base items-center"
                       aria-label="Export CSV">
                        Export CSV
                    </button>
                </div>
            </div>
        </div>

        <!-- Search and Filters -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6 mb-4 sm:mb-6">
            <div class="flex flex-col gap-3">
                <div class="flex-1">
                    <input 
                        type="text" 
                        id="searchInput" 
                        placeholder="Search by name or handle..." 
                        class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]"
                        aria-label="Search by name or handle"
                    >
                </div>
                <div class="flex flex-row gap-2">
                    <button 
                        id="searchBtn"
                        class="flex-1 px-6 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors font-medium min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
                        aria-label="Search"
                    >
                        Search
                    </button>
                    <button 
                        id="clearBtn"
                        class="flex-1 px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
                        aria-label="Clear search"
                    >
                        Clear
                    </button>
                </div>
            </div>
        </div>

        <!-- Results Count -->
        <div class="mb-4">
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Showing <span id="resultsCount"><%= analyticsDataLength %></span> of <span id="totalCount"><%= analyticsTotal %></span> results
            </p>
        </div>

        <!-- Data List -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 overflow-hidden">
            <div id="dataList" class="divide-y divide-gray-200 dark:divide-gray-700">
                <% if (data && data.length > 0) { %>
                    <% data.forEach((item, index) => { %>
                        <% 
                        const isAnonymous = item.isAnonymous || item.handle === 'anonymous';
                        const displayName = isAnonymous ? 'Anonymous Users' : (item.name || item.handle);
                        %>
                        <div class="p-4 sm:p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors <%= isAnonymous ? 'bg-gray-50 dark:bg-gray-800/50' : '' %> user-profile-item"
                             data-user-handle="<%= item.handle %>"
                             <% if (isAnonymous) { %>data-is-anonymous="true"<% } %>>
                            <div class="flex items-center justify-between gap-3">
                                <div class="flex items-start sm:items-center space-x-3 sm:space-x-4 flex-1 min-w-0">
                                    <!-- Avatar: only clickable for logged in users, not anonymous -->
                                    <% if (isAnonymous) { %>
                                        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gray-300 dark:bg-gray-600 rounded-full flex items-center justify-center text-gray-700 dark:text-gray-300 font-bold text-base sm:text-lg overflow-hidden flex-shrink-0">
                                            <span class="text-lg sm:text-xl">👤</span>
                                        </div>
                                    <% } else { %>
                                        <a href="/@<%= item.handle %>" 
                                           class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-base sm:text-lg overflow-hidden flex-shrink-0 no-underline hover:opacity-90 transition-opacity"
                                           aria-label="View profile">
                                            <% if (item.profileImage) { %>
                                                <img src="<%= item.profileImage %>" 
                                                     alt="<%= displayName %>" 
                                                     class="w-full h-full rounded-full object-cover" 
                                                     loading="lazy">
                                            <% } else { %>
                                                <span><%= item.name ? item.name.charAt(0).toUpperCase() : (item.handle ? item.handle.charAt(0).toUpperCase() : 'U') %></span>
                                            <% } %>
                                        </a>
                                    <% } %>
                                    <div class="flex-1 min-w-0 overflow-hidden">
                                        <h3 class="font-semibold text-gray-900 dark:text-white truncate text-sm sm:text-base">
                                            <%= displayName %>
                                        </h3>
                                        <% if (type === 'chatters') { %>
                                        <div class="flex flex-wrap items-center gap-1.5 sm:gap-3 sm:gap-4 mt-1 sm:mt-2 text-[10px] sm:text-xs text-gray-500 dark:text-gray-400">
                                            <span class="whitespace-nowrap">📊 <strong><%= item.chatCount || 0 %></strong> chats</span>
                                            <span class="whitespace-nowrap">💬 <strong><%= item.messageCount || 0 %></strong> messages</span>
                                            <% if (item.lastChatAt) { %>
                                            <span class="whitespace-nowrap flex items-center gap-0.5 sm:gap-1">
                                                <span class="hidden sm:inline">📅 Last chatted:</span>
                                                <span class="sm:hidden">📅 Last:</span>
                                                <span class="analytics-date-relative" data-timestamp="<%= item.lastChatAt %>"></span>
                                            </span>
                                            <% } %>
                                        </div>
                                        <% } else if (type === 'likers') { %>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                            Liked on <span class="analytics-date" data-timestamp="<%= item.likedAt %>"></span>
                                        </p>
                                        <% } else if (type === 'followers') { %>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                            Followed on <span class="analytics-date" data-timestamp="<%= item.followedAt %>"></span>
                                        </p>
                                        <% } %>
                                    </div>
                                </div>
                                <!-- View button: right side -->
                                     <% if (isAnonymous && type === 'chatters') { %>
                                        <div class="flex items-center justify-end flex-shrink-0">
                                            <a href="/public-chat-history?view=chat&participantType=anonymous"
                                               class="w-full sm:w-auto sm:min-w-[120px] px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-xs sm:text-sm font-medium min-h-[44px] touch-manipulation no-underline flex items-center justify-center"
                                               aria-label="View anonymous chats">
                                               <span class="sm:hidden">View</span>
                                               <span class="hidden sm:inline">View All Chats</span>                                        
                                            </a>
                                        </div>
                                     <% } else if (!isAnonymous && type === 'chatters') { %>
                                        <div class="flex items-center justify-end flex-shrink-0">
                                            <a href="/public-chat-history?view=user&userId=<%= item.publicUserId || item.id %>"
                                               class="w-full sm:w-auto sm:min-w-[120px] px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-xs sm:text-sm font-medium min-h-[44px] touch-manipulation no-underline flex items-center justify-center"
                                               aria-label="View all chats">
                                               <span class="sm:hidden">View</span>
                                               <span class="hidden sm:inline">View All Chats</span>                                        
                                            </a>
                                        </div>
                                     <% } else if (!isAnonymous) { %>
                                        <div class="flex items-center justify-end flex-shrink-0">
                                            <a href="/@<%= item.handle %>"
                                               class="w-full sm:w-auto sm:min-w-[120px] px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-xs sm:text-sm font-medium min-h-[44px] touch-manipulation no-underline flex items-center justify-center"
                                               aria-label="View profile">
                                               <span class="sm:hidden">View</span>
                                               <span class="hidden sm:inline">View Profile</span>                                        
                                            </a>
                                        </div>
                                     <% } %>                                
                            </div>
                        </div>                        
                    <% }); %>
                <% } else { %>
                    <div class="p-6 sm:p-8 lg:p-12 text-center">
                        <svg class="w-16 h-16 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <p class="text-gray-500 dark:text-gray-400 text-lg mb-2">No <%= analyticsTypeValue %> found</p>
                        <p class="text-gray-400 dark:text-gray-500 text-sm">Try adjusting your search or filters</p>
                    </div>
                <% } %>
            </div>
        </div>

<!-- Pagination (simple server-side, 1–2 buttons) -->
<%
    const currentPage = Number(analyticsPageValue) || 1;
    const totalCount = Number(analyticsTotal) || 0;
    const limitCount = Number(analyticsLimit) || 50;
    const totalPages = limitCount > 0 ? Math.ceil(totalCount / limitCount) : 0;
%>

<% if (totalPages > 1) { %>
    <div class="mt-6 sm:mt-8 flex flex-wrap justify-center items-center gap-2 px-2">
        
        <!-- Previous -->
        <% if (currentPage > 1) { %>
            <a 
                href="/analytics/details?type=<%= analyticsTypeValue %>&page=<%= currentPage - 1 %>&limit=<%= limitCount %>"
                class="px-3 sm:px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors min-h-[44px] touch-manipulation text-sm sm:text-base flex items-center justify-center"
                aria-label="Previous page"
            >
                <span class="hidden sm:inline">Previous</span>
                <span class="sm:hidden">Prev</span>
            </a>
        <% } %>

        <!-- Page Numbers -->
        <% for (let i = 1; i <= totalPages; i++) { %>
            <a 
                href="/analytics/details?type=<%= analyticsTypeValue %>&page=<%= i %>&limit=<%= limitCount %>"
                class="px-3 sm:px-4 py-2 rounded-lg transition-colors min-h-[44px] touch-manipulation text-sm sm:text-base flex items-center justify-center <%= i === currentPage ? 'bg-primary text-white' : 'bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700' %>"
                aria-label="Page <%= i %>"
            >
                <%= i %>
            </a>
        <% } %>

        <!-- Next -->
        <% if (currentPage < totalPages) { %>
            <a 
                href="/analytics/details?type=<%= analyticsTypeValue %>&page=<%= currentPage + 1 %>&limit=<%= limitCount %>"
                class="px-3 sm:px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors min-h-[44px] touch-manipulation text-sm sm:text-base flex items-center justify-center"
                aria-label="Next page"
            >
                Next
            </a>
        <% } %>

    </div>
<% } %>

    </div>
</div>

<script>
// Format analytics dates using TimeUtils
document.addEventListener('DOMContentLoaded', () => {
    // Relative time for "Last chatted at"
    document.querySelectorAll('.analytics-date-relative').forEach(el => {
        if (el.dataset.timestamp && window.TimeUtils) {
            el.textContent = TimeUtils.formatRelativeTime(el.dataset.timestamp);
            el.title = TimeUtils.formatFullDateTime(el.dataset.timestamp);
        }
    });
    // Keep absolute time for other dates (liked on, followed on)
    document.querySelectorAll('.analytics-date').forEach(el => {
        if (el.dataset.timestamp && window.TimeUtils) {
            el.textContent = TimeUtils.formatDateOnly(el.dataset.timestamp);
            el.title = TimeUtils.formatFullDateTime(el.dataset.timestamp);
        }
    });
});
</script>