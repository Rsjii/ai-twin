<div class="px-4 py-6 sm:px-0">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-6 sm:mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                        <%= analyticsTypeValue === 'likers' ? 'Likes' : analyticsTypeValue === 'followers' ? 'Followers' : 'Chat Participants' %> Details
                    </h1>
                    <p class="text-gray-600 dark:text-gray-300">Detailed analytics for your twin's <%= analyticsTypeValue %></p>
                </div>
                <a href="/analytics" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Back to Analytics">
                    ← Back to Analytics
                </a>
            </div>
        </div>

        <!-- Search and Filters -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6 mb-4 sm:mb-6">
            <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                    <input 
                        type="text" 
                        id="searchInput" 
                        placeholder="Search by name or handle..." 
                        class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]"
                        aria-label="Search by name or handle"
                    >
                </div>
                <button 
                    id="searchBtn"
                    class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors font-medium min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
                    aria-label="Search"
                >
                    Search
                </button>
                <button 
                    id="clearBtn"
                    class="px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
                    aria-label="Clear search"
                >
                    Clear
                </button>
            </div>
        </div>

        <!-- Results Count -->
        <div class="mb-4">
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Showing <span id="resultsCount"><%= analyticsDataLength %></span> of <span id="totalCount"><%= analyticsTotal %></span> results
            </p>
        </div>

        <!-- Data List -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 overflow-hidden">
            <div id="dataList" class="divide-y divide-gray-200 dark:divide-gray-700">
                <% if (data && data.length > 0) { %>
                    <% data.forEach((item, index) => { %>
                        <div class="p-4 sm:p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer group"
                             data-user-handle="<%= item.handle %>">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-4 flex-1">
                                    <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-lg overflow-hidden">
                                        <% if (item.profileImage) { %>
                                            <img src="<%= item.profileImage %>" alt="<%= item.name || item.handle || 'User' %>" class="w-full h-full rounded-full object-cover" loading="lazy">                                            
                                        <% } else { %>
                                            <span><%= item.name ? item.name.charAt(0).toUpperCase() : (item.handle ? item.handle.charAt(0).toUpperCase() : 'U') %></span>
                                        <% } %>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-semibold text-gray-900 dark:text-white truncate">
                                            <%= item.name || item.handle %>
                                        </h3>
                                        <p class="text-sm text-gray-600 dark:text-gray-300 truncate">
                                            @<%= item.handle %>
                                        </p>
                                        <% if (type === 'chatters') { %>
                                        <div class="flex items-center gap-4 mt-2 text-xs text-gray-500 dark:text-gray-400">
                                            <span>📊 <strong><%= item.chatCount || 0 %></strong> chats</span>
                                            <% if (item.messageCount) { %>
                                            <span>💬 <strong><%= item.messageCount %></strong> messages</span>
                                            <% } %>
                                            <% if (item.firstChatAt) { %>
                                            <span>📅 First: <%= new Date(item.firstChatAt).toLocaleDateString() %></span>
                                            <% } %>
                                        </div>
                                        <% } else if (type === 'likers') { %>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                            Liked on <%= new Date(item.likedAt).toLocaleDateString() %>
                                        </p>
                                        <% } else if (type === 'followers') { %>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                            Followed on <%= new Date(item.followedAt).toLocaleDateString() %>
                                        </p>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <button class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="View Profile">
                                        View Profile
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="p-6 sm:p-8 lg:p-12 text-center">
                        <svg class="w-16 h-16 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <p class="text-gray-500 dark:text-gray-400 text-lg mb-2">No <%= analyticsTypeValue %> found</p>
                        <p class="text-gray-400 dark:text-gray-500 text-sm">Try adjusting your search or filters</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-8 flex justify-center items-center space-x-2">
            <% 
            const currentPage = parseInt(analyticsPageValue);
            const totalPages = Math.ceil(analyticsTotal / analyticsLimit);
            const maxPages = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxPages / 2));
            let endPage = Math.min(totalPages, startPage + maxPages - 1);
            if (endPage - startPage < maxPages - 1) {
                startPage = Math.max(1, endPage - maxPages + 1);
            }
            %>
            
            <% if (totalPages > 1) { %>
                <!-- Previous Button -->
                <button 
                    data-page="<%= currentPage - 1 %>"
                    class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base <%= currentPage === 1 ? 'opacity-50 cursor-not-allowed' : '' %>"
                    <%= currentPage === 1 ? 'disabled' : '' %>
                    aria-label="Previous page"
                >
                    Previous
                </button>

                <!-- Page Numbers -->
                <% for (let i = startPage; i <= endPage; i++) { %>
                    <button 
                        data-page="<%= i %>"
                        class="px-4 py-2 rounded-lg transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base <%= i === currentPage ? 'bg-primary text-white' : 'bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700' %>"
                        aria-label="Page <%= i %>"
                    >
                        <%= i %>
                    </button>
                <% } %>

                <!-- Next Button -->
                <button 
                    data-page="<%= currentPage + 1 %>"
                    class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base <%= currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : '' %>"
                    <%= currentPage === totalPages ? 'disabled' : '' %>
                    aria-label="Next page"
                >
                    Next
                </button>
            <% } %>
        </div>
    </div>
</div>