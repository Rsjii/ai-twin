<div class="px-4 py-6 sm:px-0">
    <div class="max-w-7xl mx-auto">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-6 sm:mb-8">Analytics Dashboard</h1>
        
        <!-- Loading State for Overview Cards -->
        <div id="overviewLoadingState" class="hidden mb-6 sm:mb-8">
            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
                <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
            </div>
        </div>
        
        <!-- Overview Cards Container -->
        <div id="overviewContainer" class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Views</p>
                        <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white" id="totalViews">-</p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-green-100 dark:bg-green-900/30 rounded-lg">
                        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Likes</p>
                        <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white" id="totalLikes">-</p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-purple-100 dark:bg-purple-900/30 rounded-lg">
                        <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Followers</p>
                        <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white" id="totalFollowers">-</p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-orange-100 dark:bg-orange-900/30 rounded-lg">
                        <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Chats</p>
                        <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white" id="totalChats">-</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Empty State for Overview -->
        <div id="overviewEmptyState" class="hidden mb-6 sm:mb-8 text-center py-12">
            <div class="text-4xl mb-4">📊</div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No analytics data</h3>
            <p class="text-gray-600 dark:text-gray-400">Analytics data will appear here once you have enough activity.</p>
        </div>
        
        <!-- Error State for Overview -->
        <div id="overviewErrorState" class="hidden mb-6 sm:mb-8 text-center py-12">
            <div class="text-4xl mb-4">⚠️</div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Failed to load analytics</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">We encountered an error while loading analytics. Please try again.</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Please <a href="javascript:location.reload()" class="text-primary hover:text-secondary underline font-medium cursor-pointer">reload the page</a> to try again.
            </p>                    
        </div>
        
        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-8 mb-6 sm:mb-8">
            <!-- Chart 1: Engagement Over Time -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Engagement Over Time</h3>
                
                <!-- Loading State for Chart -->
                <div id="chartLoadingState" class="hidden">
                    <div class="h-64 bg-gray-200 dark:bg-gray-700 rounded-lg animate-pulse"></div>
                </div>
                
                <!-- Chart Container -->
                <div id="chartContainer" class="h-64 relative">
                    <canvas id="engagementChart"></canvas>
                </div>
                
                <!-- Empty State for Chart -->
                <div id="chartEmptyState" class="hidden text-center py-12">
                    <div class="text-4xl mb-4">📈</div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No chart data</h3>
                    <p class="text-gray-600 dark:text-gray-400">Chart data will appear here once you have enough engagement.</p>
                </div>
                
                <!-- Error State for Chart -->
                <div id="chartErrorState" class="hidden text-center py-12">
                    <div class="text-4xl mb-4">⚠️</div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Failed to load chart</h3>
                    <p class="text-gray-600 dark:text-gray-400 mb-4">We encountered an error while loading the chart. Please try again.</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Please <a href="javascript:location.reload()" class="text-primary hover:text-secondary underline font-medium cursor-pointer">reload the page</a> to try again.
                    </p>                    
                </div>
            </div>
            
            <!-- Chart 2: Top Performing Content -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Performing Content</h3>
                
                <!-- Loading State for Top Content -->
                <div id="topContentLoadingState" class="hidden space-y-3">
                    <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-16 animate-pulse"></div>
                    <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-16 animate-pulse"></div>
                    <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-16 animate-pulse"></div>
                </div>
                
                <!-- Top Content Container -->
                <div id="topContent" class="space-y-3">
                    <p class="text-gray-500 dark:text-gray-400">Loading...</p>
                </div>
                
                <!-- Empty State for Top Content -->
                <div id="topContentEmptyState" class="hidden text-center py-12">
                    <div class="text-4xl mb-4">📝</div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No content data</h3>
                    <p class="text-gray-600 dark:text-gray-400">Content performance data will appear here once you have enough activity.</p>
                </div>
                
                <!-- Error State for Top Content -->
                <div id="topContentErrorState" class="hidden text-center py-12">
                    <div class="text-4xl mb-4">⚠️</div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Failed to load content</h3>
                    <p class="text-gray-600 dark:text-gray-400 mb-4">We encountered an error while loading content data. Please try again.</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Please <a href="javascript:location.reload()" class="text-primary hover:text-secondary underline font-medium cursor-pointer">reload the page</a> to try again.
                    </p>                    
                </div>
            </div>
        </div>

        <!-- Feedback Analytics Section -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4 sm:p-6 mb-6 sm:mb-8">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Feedback Analytics</h3>
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
                <div class="text-center">
                    <p class="text-xl sm:text-2xl font-bold text-green-600 dark:text-green-400" id="positiveFeedback">-</p>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Positive Feedback</p>
                </div>
                <div class="text-center">
                    <p class="text-xl sm:text-2xl font-bold text-red-600 dark:text-red-400" id="negativeFeedback">-</p>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Negative Feedback</p>
                </div>
                <div class="text-center">
                    <p class="text-xl sm:text-2xl font-bold text-blue-600 dark:text-blue-400" id="satisfactionScore">-</p>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Satisfaction Score</p>
                </div>
            </div>
        </div>
        
        <!-- ✅ NEW: Period Summary Section (replaces Recent Activity) -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 mb-6 sm:mb-8">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between flex-wrap gap-3">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Activity Summary</h3>
                <!-- Period Toggle -->
                <div class="flex items-center gap-2 bg-gray-100 dark:bg-gray-700 rounded-lg p-1">
                    <button id="periodToggle7" class="px-3 py-1.5 text-sm font-medium rounded-md transition-all bg-primary text-white" data-period="7">
                        7 Days
                    </button>
                    <button id="periodToggle30" class="px-3 py-1.5 text-sm font-medium rounded-md transition-all text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-period="30">
                        30 Days
                    </button>
                </div>
            </div>
            <div class="p-6">
                <!-- Loading State -->
                <div id="periodSummaryLoadingState" class="hidden">
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                        <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                        <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                        <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                        <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                        <div class="bg-gray-200 dark:bg-gray-700 rounded-lg h-24 animate-pulse"></div>
                    </div>
                </div>
                
                <!-- Period Summary Container -->
                <div id="periodSummary" class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                    <!-- Will be populated by JavaScript -->
                </div>
                
                <!-- Empty State -->
                <div id="periodSummaryEmptyState" class="hidden text-center py-12">
                    <div class="text-4xl mb-4">📊</div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No activity yet</h3>
                    <p class="text-gray-600 dark:text-gray-400">Activity summary will appear here once people start engaging with your twin.</p>
                </div>
                
                <!-- Error State -->
                <div id="periodSummaryErrorState" class="hidden text-center py-12">
                    <div class="text-4xl mb-4">⚠️</div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Failed to load summary</h3>
                    <p class="text-gray-600 dark:text-gray-400 mb-4">We encountered an error while loading activity summary. Please try again.</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Please <a href="javascript:location.reload()" class="text-primary hover:text-secondary underline font-medium cursor-pointer">reload the page</a> to try again.
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Debug Section -->
        <% if (process.env.NODE_ENV !== 'production' || (typeof user !== 'undefined' && user?.isAdmin)) { %>
        <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 mt-6">
            <h3 class="text-lg font-semibold text-yellow-800 dark:text-yellow-300 mb-2">Debug Tools</h3>
            <p class="text-sm text-yellow-700 dark:text-yellow-300 mb-4">Use these tools to debug analytics data</p>
            <div class="flex space-x-3">
                <button onclick="window.location.reload()" class="bg-gradient-to-r from-yellow-500 to-orange-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-semibold text-sm">                        
                    Debug User Data
                </button>
                <button onclick="createSampleData()" class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-semibold text-sm">                        
                    Create Sample Data
                </button>
                <button onclick="loadAnalytics()" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-semibold text-sm">                        
                    Refresh Analytics
                </button>
            </div>
        </div>
        <% } else { %>
        <!-- Support message for production users -->
        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mt-6">
            <p class="text-sm text-blue-700 dark:text-blue-300">
                Having trouble? <a href="/contact" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Contact support</a>
            </p>
        </div>
        <% } %>
    </div>
</div>