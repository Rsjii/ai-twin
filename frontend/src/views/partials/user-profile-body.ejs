<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- User Basic Info Header - Enhanced -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl card-shadow dark:shadow-gray-900 overflow-hidden border border-gray-100 dark:border-gray-700 mb-8">
        <div class="gradient-bg px-8 py-16 text-white relative">
            <div class="relative z-10">
                <div class="flex flex-col md:flex-row items-center md:items-start space-y-6 md:space-y-0 md:space-x-8">
                    <!-- User Profile Image - Enhanced -->
                    <div class="relative">
                        <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl bg-white bg-opacity-20 backdrop-blur-lg flex items-center justify-center overflow-hidden border-4 border-white border-opacity-30 shadow-2xl transform hover:scale-105 transition-transform duration-300">
                            <% if (profileUser.profileImage) { %>
                                <img src="<%= profileUser.profileImage %>" alt="<%= profileUser.name %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="w-full h-full bg-gradient-to-br from-white/40 to-white/20 flex items-center justify-center">
                                    <span class="text-4xl md:text-5xl font-bold text-white"><%= (profileUser.name || profileUser.handle).charAt(0).toUpperCase() %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- User Info - Enhanced -->
                    <div class="flex-1 text-center md:text-left">
                        <h1 class="text-4xl md:text-5xl font-bold text-white drop-shadow-lg mb-3">
                            <%= profileUser.name || profileUser.handle %>
                        </h1>
                        <div class="flex items-center justify-center md:justify-start space-x-3 mb-4">
                            <p class="text-xl md:text-2xl opacity-90 text-white/90 font-medium">
                                @<%= profileUser.handle %>
                            </p>
                            <div class="w-2 h-2 bg-white/60 rounded-full"></div>
                            <p class="text-sm opacity-75 text-white/75">
                                Member since <span id="profile-member-since" data-timestamp="<%= profileUser.createdAt %>"></span>
                            </p>
                        </div>
                        <% if (profileUser.bio) { %>
                            <p class="text-lg md:text-xl opacity-90 max-w-2xl text-white/90 leading-relaxed"><%= profileUser.bio %></p>
                        <% } else { %>
                            <p class="text-base opacity-75 text-white/75 italic">No bio yet</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Twins Section - Enhanced -->
    <% if (hasTwins) { %>
        <div class="mb-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center space-x-3">
                    <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    <span>AI Twin</span>
                </h2>
            </div>
            
            <div class="grid grid-cols-1 gap-6">
                <% twins.forEach((twin) => { %>
                    <!-- Twin Card - Enhanced Design -->
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-gray-900 overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 cursor-pointer"
                    onclick="window.location.href='/@<%= twin.publicHandle %>'">                        
                        <!-- Twin Header - Enhanced -->
                        <div class="gradient-bg px-8 py-10 text-white relative">
                            <div class="relative z-10">
                                <div class="flex flex-col md:flex-row items-center md:items-start space-y-4 md:space-y-0 md:space-x-6">
                                    <!-- Twin Image - Enhanced -->
                                    <div class="relative">
                                        <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-white bg-opacity-20 backdrop-blur-lg flex items-center justify-center overflow-hidden border-4 border-white border-opacity-30 shadow-2xl transform hover:scale-110 transition-transform duration-300">
                                            <% if (twin.profileImage) { %>
                                                <img src="<%= twin.profileImage %>" alt="<%= twin.publicHandle %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <span class="text-3xl md:text-4xl font-bold text-white"><%= twin.publicHandle.charAt(0).toUpperCase() %></span>
                                            <% } %>
                                        </div>
                                        <% if (twin.verified) { %>
                                            <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full flex items-center justify-center border-4 border-white shadow-lg">
                                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                    <!-- Twin Info - Enhanced -->
                                    <div class="flex-1 text-center md:text-left">
                                        <div class="flex flex-col md:flex-row items-center md:items-center space-y-2 md:space-y-0 md:space-x-3 mb-3">
                                            <h3 class="text-3xl md:text-4xl font-bold text-white drop-shadow-lg">@<%= twin.publicHandle %></h3>
                                        </div>
                                        <% if (twin.bio) { %>
                                            <p class="text-base md:text-lg opacity-90 max-w-2xl text-white/90 leading-relaxed break-words overflow-wrap-anywhere"><%= twin.bio %></p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Twin Stats - Enhanced with Icons -->
                        <div class="px-8 py-6 bg-gradient-to-br from-gray-50 to-white dark:from-gray-800 dark:to-gray-900 border-b border-gray-200 dark:border-gray-700">
                            <div class="grid grid-cols-3 gap-6">
                                <div class="text-center p-4 rounded-xl bg-gradient-to-br from-pink-50 to-rose-50 dark:from-pink-900/20 dark:to-rose-900/20 border border-pink-200 dark:border-pink-800 hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                                    <div class="w-12 h-12 mx-auto mb-3 bg-gradient-to-br from-pink-500 to-rose-500 rounded-xl flex items-center justify-center shadow-lg">
                                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <div class="text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= twin.likeCount || 0 %></div>
                                    <div class="text-xs font-medium text-gray-600 dark:text-gray-400">Likes</div>
                                </div>
                                
                                <div class="text-center p-4 rounded-xl bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                                    <div class="w-12 h-12 mx-auto mb-3 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-xl flex items-center justify-center shadow-lg">
                                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                                        </svg>
                                    </div>
                                    <div class="text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= twin.followCount || 0 %></div>
                                    <div class="text-xs font-medium text-gray-600 dark:text-gray-400">Followers</div>
                                </div>
                                
                                <div class="text-center p-4 rounded-xl bg-gradient-to-br from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20 border border-purple-200 dark:border-purple-800 hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                                    <div class="w-12 h-12 mx-auto mb-3 bg-gradient-to-br from-purple-500 to-violet-500 rounded-xl flex items-center justify-center shadow-lg">
                                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <div class="text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= twin.chatCount || 0 %></div>
                                    <div class="text-xs font-medium text-gray-600 dark:text-gray-400">Chats</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Sample Reply - Enhanced -->
                        <% if (twin.sampleReply) { %>
                            <div class="px-8 py-6 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
                                <div class="flex items-start space-x-3">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Sample Reply</p>
                                        <p class="text-base text-gray-800 dark:text-gray-200 leading-relaxed italic">"<%= twin.sampleReply %>"</p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                        
                        <!-- Chat Button - Enhanced -->
                        <div class="px-8 py-6 bg-gray-50 dark:bg-gray-700/30">
                            <a href="/@<%= twin.publicHandle %>" class="w-full block text-center px-6 py-4 bg-gradient-to-r from-purple-600 via-pink-600 to-purple-600 text-white rounded-xl hover:from-purple-700 hover:via-pink-700 hover:to-purple-700 transition-all duration-300 font-semibold text-lg shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center space-x-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                </svg>
                                <span>Chat with @<%= twin.publicHandle %></span>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } else { %>
        <!-- No Twins Message - Enhanced -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-gray-900 p-16 text-center border border-gray-100 dark:border-gray-700">
            <div class="max-w-md mx-auto">
                <div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 rounded-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">No Twin Created Yet</h3>
                <p class="text-gray-600 dark:text-gray-400 text-lg mb-6">
                    <%= profileUser.name || profileUser.handle %> hasn't created an AI twin yet.
                </p>
                <div class="inline-block px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 rounded-lg text-sm">
                    Check back later!
                </div>
            </div>
        </div>
    <% } %>
</div>

<script>
// Format profile member since date using TimeUtils
document.addEventListener('DOMContentLoaded', () => {
    const memberSinceEl = document.getElementById('profile-member-since');
    if (memberSinceEl && memberSinceEl.dataset.timestamp) {
        if (typeof TimeUtils !== 'undefined' && TimeUtils.formatExactTime) {
            const formatted = TimeUtils.formatExactTime(memberSinceEl.dataset.timestamp, { month: 'short', year: 'numeric' });
            memberSinceEl.textContent = formatted;
            memberSinceEl.title = TimeUtils.formatFullDateTime(memberSinceEl.dataset.timestamp);
        } else {
            // Fallback if TimeUtils not loaded
            const date = new Date(memberSinceEl.dataset.timestamp);
            const formatted = window.TimeUtils ? window.TimeUtils.formatDateOnly(memberSinceEl.dataset.timestamp) : date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            memberSinceEl.textContent = formatted;
        }
    }
});
</script>