<%- include('layout', { title: 'Login - AI Twin', body: `
<div class="px-4 py-6 sm:px-0">
    <div class="max-w-md mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8">
            <h1 class="text-2xl font-bold text-gray-900 mb-6 text-center">Login to AI Twin</h1>
            
            <form id="loginForm">
                <div class="mb-4">
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        Email Address
                    </label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        placeholder="Enter your email"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                        required
                    >
                </div>
                
                <button 
                    type="submit"
                    class="w-full bg-primary text-white py-3 px-6 rounded-lg hover:bg-secondary transition-colors font-semibold mb-4"
                >
                    Send OTP
                </button>
                
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            </form>
            
            <div class="text-center">
                <p class="text-sm text-gray-600">
                    Don't have an account? 
                    <a href="/" class="text-primary hover:text-secondary">Join the waitlist</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const email = formData.get('email');
    
    try {
        const response = await fetch('/api/auth/login/start', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
            body: JSON.stringify({ email })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            showFlashMessage('OTP sent to your email!', 'success');
            // Redirect to verify page
            setTimeout(() => {
                window.location.href = '/login/verify';
            }, 1000);
        } else {
            showFlashMessage(result.error || 'Failed to send OTP', 'error');
        }
    } catch (error) {
        console.error('Login error:', error);
        showFlashMessage('Network error. Please try again.', 'error');
    }
});
</script>
` }) %>
