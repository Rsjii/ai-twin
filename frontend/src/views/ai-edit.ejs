  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 dark:border-gray-700 shadow-md dark:shadow-gray-900">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <!-- Buttons row (always in one row, will wrap only on very small screens) -->
      <div class="flex flex-row flex-wrap items-center gap-2 sm:gap-4">
        <a href="/twin-settings"
           class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base">
