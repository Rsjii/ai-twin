<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <title>AI Tools - AI Twin</title>
  <link rel="stylesheet" href="/css/output.css" />
    <script src="/utils/timeUtils.js"></script>
    <script type="module" src="/js/form-dirty-state.js"></script>
    <script>
    (function () {
            const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') document.documentElement.classList.add('dark');
        })();
    </script>
  <script>window.csrfToken = '<%= csrfToken %>';</script>
</head>

<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!--Header-->
    <%- include('header') %>    

    <div class="container mx-auto px-3 sm:px-4 lg:px-8 py-6 sm:py-8">        
        <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">AI Tools</h1>
      <p class="text-gray-600 dark:text-gray-300">Test your twin + rewrite messages instantly (no extra drama).</p>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 dark:border-gray-700 shadow-md dark:shadow-gray-900">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-row flex-wrap items-center gap-2 sm:gap-4">
        <a href="/twin-settings"
           class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
            Twin Settings
          </a>

          <a href="/analytics"
          class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base">            
            Open Analytics
        </a>
      </div>
    </div>
  </div>

    <div class="grid lg:grid-cols-12 gap-4 lg:gap-6">
      <!-- Main -->
      <div class="lg:col-span-8 space-y-4">
        <!-- ✅ Tabs: Reply vs Rewrite -->
<div class="mb-3 inline-flex rounded-xl border border-gray-200 dark:border-gray-700 bg-white/70 dark:bg-gray-800/70 overflow-hidden">
  <button id="tabTester" type="button"
  class="px-4 py-2 text-sm font-medium bg-primary text-white">    
    Reply (Tester)
  </button>
  <button id="tabRewrite" type="button"
    class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700">
    Rewrite
  </button>
</div>

        <!-- Quick Tester -->
        <div id="testerCard" class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 border border-white/20 dark:border-gray-700">          
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Quick Tester</h2>
              <p class="text-sm text-gray-600 dark:text-gray-300">Paste what someone said. Get your twin’s reply.</p>
            </div>
        </div>

          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Message you received
        </label>
          <textarea id="testerInput" rows="4"
            placeholder='e.g. "Bro kal plan hai?"'
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base"></textarea>

          <div class="mt-3 flex flex-wrap gap-2">
            <select id="testerTone" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
              <option value="">Tone (use settings)</option>
              <option value="polite">Polite & respectful</option>
              <option value="normal">Normal & friendly</option>
              <option value="casual">Casual & relaxed</option>
            </select>

            <select id="testerLength" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
              <option value="">Length (use settings)</option>
              <option value="short">Short</option>
              <option value="normal">Normal</option>
              <option value="detailed">Detailed</option>
            </select>

            <select id="testerEmoji" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
              <option value="">Emoji (use settings)</option>
              <option value="off">Off</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
            </select>
                </div>

          <div class="mt-4 flex flex-col sm:flex-row gap-2">
            <button id="testerRun"
              class="w-full sm:w-auto inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-5 py-2.5 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px]">
              Generate replies
          </button>

            <button id="testerClear"
              class="w-full sm:w-auto inline-flex items-center justify-center bg-white/80 dark:bg-gray-700/80 text-gray-800 dark:text-gray-100 px-5 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 transition-all font-medium min-h-[44px]">
              Clear
          </button>
                    </div>
        
          <div class="mt-4">
            <div id="testerLoading" class="hidden text-sm text-gray-500 dark:text-gray-400">Generating…</div>
            <div id="testerOut" class="space-y-3"></div>
                </div>
            </div>
        
        <!-- Rewrite Assistant -->
        <div id="rewriteCard" class="hidden bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 border border-white/20 dark:border-gray-700">          
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Rewrite Assistant</h2>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Write what you want to say. We’ll rewrite it in your twin voice.</p>

          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Your message
          </label>
          <textarea id="rewriteInput" rows="4"
            placeholder='e.g. "Haan bhai, kal 6 baje milte hai."'
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base"></textarea>

          <div class="mt-3 flex flex-wrap gap-2">
            <select id="rewriteTone" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
              <option value="">Tone (use settings)</option>
              <option value="polite">Polite & respectful</option>
              <option value="normal">Normal & friendly</option>
              <option value="casual">Casual & relaxed</option>
            </select>

            <select id="rewriteLength" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
              <option value="">Length (use settings)</option>
              <option value="short">Short</option>
              <option value="normal">Normal</option>
              <option value="detailed">Detailed</option>
            </select>

            <select id="rewriteEmoji" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
              <option value="">Emoji (use settings)</option>
              <option value="off">Off</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
            </select>
          </div>

          <div class="mt-4 flex flex-col sm:flex-row gap-2">
            <button id="rewriteRun"
              class="w-full sm:w-auto inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-5 py-2.5 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px]">
              Rewrite
            </button>
            <button id="rewriteClear"
              class="w-full sm:w-auto inline-flex items-center justify-center bg-white/80 dark:bg-gray-700/80 text-gray-800 dark:text-gray-100 px-5 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 transition-all font-medium min-h-[44px]">
              Clear
            </button>
                    </div>

          <div class="mt-4">
            <div id="rewriteLoading" class="hidden text-sm text-gray-500 dark:text-gray-400">Generating…</div>
            <div id="rewriteOut" class="space-y-3"></div>
            </div>
        </div>

        <!-- Templates -->
      <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 border border-white/20 dark:border-gray-700">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Templates</h2>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Tap a card to fill your input.</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button type="button" data-template="follow_up"
              class="templateBtn text-left p-3 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Follow-up</div>
              <div class="text-xs text-gray-600 dark:text-gray-300">“Hey, just checking in…”</div>
            </button>

            <button type="button" data-template="say_no"
              class="templateBtn text-left p-3 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Say no (polite)</div>
              <div class="text-xs text-gray-600 dark:text-gray-300">“I can’t right now…”</div>
            </button>

            <button type="button" data-template="ask_payment"
              class="templateBtn text-left p-3 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Ask for payment</div>
              <div class="text-xs text-gray-600 dark:text-gray-300">“Quick reminder about payment…”</div>
            </button>

            <button type="button" data-template="apology"
              class="templateBtn text-left p-3 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Apology</div>
              <div class="text-xs text-gray-600 dark:text-gray-300">“Sorry about that…”</div>
            </button>
          </div>
        </div>
            </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-4 lg:sticky lg:top-6 lg:self-start">
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 border border-white/20 dark:border-gray-700">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Twin Snapshot</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Based on your Twin Settings.</p>

          <div id="snapshotBox" class="space-y-1 text-xs text-gray-700 dark:text-gray-300">
            <p class="text-gray-400 dark:text-gray-500">Loading…</p>
          </div>

          <div class="mt-4">
            <a href="/twin-settings"
              class="inline-flex justify-center w-full px-4 py-2 bg-white/80 dark:bg-gray-700/80 text-gray-800 dark:text-gray-100 rounded-xl border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors min-h-[44px] items-center text-sm font-medium">
              Edit Settings
            </a>
          </div>
        </div>

        <!-- Quick Memory -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 border border-white/20 dark:border-gray-700">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Quick Memory</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Save a fact/preference instantly. (Also works in chat: <code>remember this: ...</code>)</p>

          <textarea id="quickMemValue" rows="3"
            placeholder="e.g. I prefer short replies. / I hate cold coffee."
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-white/20 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm"></textarea>

          <div class="mt-3 grid grid-cols-2 gap-2">
            <button id="quickMemSaveFact" type="button"
              class="inline-flex justify-center px-3 py-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors min-h-[44px] items-center text-sm font-medium">
              Save as Fact
            </button>
            <button id="quickMemSavePref" type="button"
              class="inline-flex justify-center px-3 py-2 bg-white/80 dark:bg-gray-700/80 text-gray-800 dark:text-gray-100 rounded-xl border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors min-h-[44px] items-center text-sm font-medium">
              Save as Preference
            </button>
          </div>

          <div class="mt-3">
            <a href="/twin-settings#memorySection"
               class="text-sm text-primary hover:text-secondary font-medium transition-colors">
              Manage all memory →
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!--Footer-->
  <%- include('footer/footer-conditional-private') %>
  <%- include('partials/modal-helpers') %>

    <script type="module">
    const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : "" %>';

    const testerInput = document.getElementById('testerInput');
    const testerRun = document.getElementById('testerRun');
    const testerClear = document.getElementById('testerClear');
    const testerLoading = document.getElementById('testerLoading');
    const testerOut = document.getElementById('testerOut');

    const rewriteInput = document.getElementById('rewriteInput');
    const rewriteRun = document.getElementById('rewriteRun');
    const rewriteClear = document.getElementById('rewriteClear');
    const rewriteLoading = document.getElementById('rewriteLoading');
    const rewriteOut = document.getElementById('rewriteOut');

    const snapshotBox = document.getElementById('snapshotBox');

    // ✅ Tabs logic
const tabTester = document.getElementById('tabTester');
const tabRewrite = document.getElementById('tabRewrite');
const testerCard = document.getElementById('testerCard');
const rewriteCard = document.getElementById('rewriteCard');

function setTab(mode) {
  const isTester = mode === 'tester';

  testerCard?.classList.toggle('hidden', !isTester);
  rewriteCard?.classList.toggle('hidden', isTester);

  // active styles
  tabTester?.classList.toggle('bg-primary', isTester);
  tabTester?.classList.toggle('text-white', isTester);
  tabTester?.classList.toggle('text-gray-700', !isTester);
  tabTester?.classList.toggle('dark:text-gray-200', !isTester);

  tabRewrite?.classList.toggle('bg-primary', !isTester);
  tabRewrite?.classList.toggle('text-white', !isTester);
  tabRewrite?.classList.toggle('text-gray-700', isTester);
  tabRewrite?.classList.toggle('dark:text-gray-200', isTester);
}

tabTester?.addEventListener('click', () => setTab('tester'));
tabRewrite?.addEventListener('click', () => setTab('rewrite'));

// default
setTab('tester');

      function escapeHtml(text) {
        const div = document.createElement('div');
      div.textContent = String(text ?? '');
        return div.innerHTML;
      }

    function showToast(message, type = 'info') {
      if (window.UI && typeof window.UI.showToast === 'function') return window.UI.showToast(message, type);
      alert(message);
    }

    function setLoading(el, isLoading) {
      if (!el) return;
      el.classList.toggle('hidden', !isLoading);
    }

    function renderSuggestions(container, suggestions) {
      if (!container) return;
      container.innerHTML = '';

      (suggestions || []).forEach((s, idx) => {
        const text = s.text || '';
        const label = s.label || `option_${idx + 1}`;

        const card = document.createElement('div');
        card.className = 'border border-white/20 dark:border-gray-700 rounded-xl p-4 bg-gray-50 dark:bg-gray-900/40';

        card.innerHTML = `
          <div class="flex items-center justify-between gap-3 mb-2">
            <div class="text-sm font-semibold text-gray-900 dark:text-white">${escapeHtml(label)}</div>
            <div class="flex flex-wrap gap-2">
              <button type="button" class="copyBtn px-3 py-1.5 text-xs rounded-lg bg-white/80 dark:bg-gray-700/80 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600">Copy</button>
              <button type="button" class="useBtn px-3 py-1.5 text-xs rounded-lg bg-blue-600 text-white border border-blue-600 hover:bg-blue-700">Use in Chat</button>
              <button type="button" class="saveFactBtn px-3 py-1.5 text-xs rounded-lg bg-white/80 dark:bg-gray-700/80 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600">Save Fact</button>
              <button type="button" class="savePrefBtn px-3 py-1.5 text-xs rounded-lg bg-white/80 dark:bg-gray-700/80 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600">Save Pref</button>
            </div>
          </div>
          <div class="text-sm text-gray-800 dark:text-gray-100 whitespace-pre-wrap">${escapeHtml(text)}</div>
        `;

        card.querySelector('.copyBtn')?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(text);
            showToast('Copied ✔', 'success');
          } catch {
            showToast('Copy failed', 'error');
          }
        });

        card.querySelector('.useBtn')?.addEventListener('click', () => {
          try { sessionStorage.setItem('enhancedChatDraft', text); } catch {}
          window.location.href = '/chat';
        });

        card.querySelector('.saveFactBtn')?.addEventListener('click', async () => {
          try {
            await saveToLongTermMemory(text, 'fact');
            showToast('Saved as fact ✔', 'success');
        } catch (e) {
            showToast('Save failed', 'error');
          }
        });

        card.querySelector('.savePrefBtn')?.addEventListener('click', async () => {
          try {
            await saveToLongTermMemory(text, 'preference');
            showToast('Saved as preference ✔', 'success');
          } catch (e) {
            showToast('Save failed', 'error');
          }
        });

        container.appendChild(card);
      });
    }

    async function callAiTools(mode, input, opts) {
      const res = await fetch(`/api/twin/${twinToken}/ai-tools`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': window.csrfToken,
            },
            credentials: 'include',
            body: JSON.stringify({
          mode,
          input,
          ...opts,
            }),
          });
          const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed');
      return data.suggestions || [];
    }

    // Templates
    document.querySelectorAll('.templateBtn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.getAttribute('data-template');
        const map = {
          follow_up: 'Hey — just checking in. Did you get a chance to see my last message?',
          say_no: 'I can’t commit to this right now. Can we do it later?',
          ask_payment: 'Quick reminder about the payment — can you share an update?',
          apology: 'Sorry about that — my bad. I’ll fix it right away.',
        };
        const fill = map[t] || '';
        if (rewriteInput) rewriteInput.value = fill;
        rewriteInput?.focus();
      });
    });

    // Tester
    testerClear?.addEventListener('click', () => {
      if (testerInput) testerInput.value = '';
      if (testerOut) testerOut.innerHTML = '';
    });

    testerRun?.addEventListener('click', async () => {
      const input = (testerInput?.value || '').trim();
      if (!input) return showToast('Paste a message first.', 'info');

      setLoading(testerLoading, true);
      if (testerOut) testerOut.innerHTML = '';
      try {
        const suggestions = await callAiTools('tester', input, {
          tonePreset: document.getElementById('testerTone')?.value || undefined,
          lengthPreset: document.getElementById('testerLength')?.value || undefined,
          emojiPreset: document.getElementById('testerEmoji')?.value || undefined,
        });
        renderSuggestions(testerOut, suggestions);
      } catch (e) {
        showToast('Could not generate replies.', 'error');
        } finally {
        setLoading(testerLoading, false);
      }
    });

    // Rewrite
    rewriteClear?.addEventListener('click', () => {
      if (rewriteInput) rewriteInput.value = '';
      if (rewriteOut) rewriteOut.innerHTML = '';
    });

    rewriteRun?.addEventListener('click', async () => {
      const input = (rewriteInput?.value || '').trim();
      if (!input) return showToast('Write your message first.', 'info');

      setLoading(rewriteLoading, true);
      if (rewriteOut) rewriteOut.innerHTML = '';
      try {
        const suggestions = await callAiTools('rewrite', input, {
          tonePreset: document.getElementById('rewriteTone')?.value || undefined,
          lengthPreset: document.getElementById('rewriteLength')?.value || undefined,
          emojiPreset: document.getElementById('rewriteEmoji')?.value || undefined,
        });
        renderSuggestions(rewriteOut, suggestions);
      } catch (e) {
        showToast('Could not rewrite.', 'error');
      } finally {
        setLoading(rewriteLoading, false);
      }
    });

    // Snapshot
    async function loadSnapshot() {
      if (!snapshotBox) return;
      try {
        const [editRes, settingsRes] = await Promise.all([
          fetch(`/api/twin/${twinToken}/edit-data`, { credentials: 'include' }),
          fetch(`/api/twin/${twinToken}/settings`, { credentials: 'include' }),
        ]);
        const editData = await editRes.json();
        const settingsData = await settingsRes.json();

        const pd = editData?.twin?.personaData || {};
        const sv = editData?.twin?.styleVector || {};
        const s = settingsData?.settings || {};

        const basic = pd.basicInfo || {};
        const role = basic.role || basic.primaryUseCase || '—';
        const language = basic.language || '—';
        const purpose = basic.purpose ? basic.purpose.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) : '—'; // ✅ ADD
        const toneStyle = pd.preferences?.toneStyle || sv.tone || '—'; // ✅ FIX: use toneStyle
        const replySize = pd.rules?.replySize || sv.response_length_preference || '—'; // ✅ FIX: use replySize
        const engagementStyle = pd.rules?.engagementStyle || '—'; // ✅ ADD
        const memoryEnabled = s.memory?.enabled !== false; // Default true
        const memoryOn = memoryEnabled ? 'ON' : 'OFF';

        snapshotBox.innerHTML = `
          <p><strong>Name:</strong> ${escapeHtml(basic.name || basic.fullName || '—')}</p>
          <p><strong>Role:</strong> ${escapeHtml(role)}</p>
          <p><strong>Purpose:</strong> ${escapeHtml(purpose)}</p>
          <p><strong>Language:</strong> ${escapeHtml(language)}</p>
          <p class="mt-2"><strong>Tone:</strong> ${escapeHtml(toneStyle === 'polite' ? 'Polite & respectful' : toneStyle === 'normal' ? 'Normal & friendly' : toneStyle === 'casual' ? 'Casual & relaxed' : toneStyle)}</p>
          <p><strong>Reply length:</strong> ${escapeHtml(replySize === 'short' ? 'Short' : replySize === 'normal' ? 'Normal' : replySize === 'detailed' ? 'Detailed' : replySize)}</p>
          <p><strong>Engagement:</strong> ${escapeHtml(engagementStyle === 'ask_questions' ? 'Ask questions' : engagementStyle === 'natural' ? 'Natural' : engagementStyle === 'mix' ? 'Mix' : '—')}</p>
          <p><strong>Memory:</strong> ${escapeHtml(memoryOn)}</p>
        `;
      } catch (e) {
        snapshotBox.innerHTML = `<p class="text-xs text-red-500">Could not load snapshot.</p>`;
      }
    }

    loadSnapshot();

    // ✅ ADD: save to long-term memory helper
    async function saveToLongTermMemory(value, category) {
      const v = String(value || '').trim();
      if (!v) return showToast('Write something first.', 'info');

      const res = await fetch(`/api/twin/${twinToken}/long-term-memory`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': window.csrfToken,
            },
            credentials: 'include',
        body: JSON.stringify({ value: v, category }),
      });

          const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed');
      return data.memory;
    }

    // ✅ CHANGE: add Save-to-Memory buttons in suggestion cards
    document.getElementById('quickMemSaveFact')?.addEventListener('click', async () => {
      try {
        const v = document.getElementById('quickMemValue')?.value || '';
        await saveToLongTermMemory(v, 'fact');
        document.getElementById('quickMemValue').value = '';
        showToast('Saved ✔', 'success');
        } catch (e) {
        showToast('Save failed', 'error');
      }
    });

    document.getElementById('quickMemSavePref')?.addEventListener('click', async () => {
      try {
        const v = document.getElementById('quickMemValue')?.value || '';
        await saveToLongTermMemory(v, 'preference');
        document.getElementById('quickMemValue').value = '';
        showToast('Saved ✔', 'success');
      } catch (e) {
        showToast('Save failed', 'error');
      }
    });
    </script>
</body>
</html>