<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AI Edit - AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 min-h-screen font-inter">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">AI Edit</h1>
            <p class="text-gray-600">Edit your AI twin's personality, prompts, and memory like GPT custom instructions</p>
        </div>

        <!-- Navigation Breadcrumbs -->
<div class="mb-6">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/dashboard" class="text-gray-500 hover:text-gray-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/my-twins" class="text-gray-500 hover:text-gray-700 transition-colors">My Twins</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/twin/<%= twinId %>/learning-dashboard" class="text-gray-500 hover:text-gray-700 transition-colors">Learning Dashboard</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-gray-900 font-medium">AI Edit</span>
        </li>
      </ol>
    </nav>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 shadow-md">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="/twin/<%= twinId %>/learning-dashboard" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Learning Dashboard
        </a>
        <a href="/twin/<%= twinId %>/style-customize" class="bg-gradient-to-r from-accent to-purple-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
          Style Customize
        </a>
      </div>
      <div class="text-sm text-gray-600">
        <span class="font-medium">Twin ID:</span> <%= twinId %>
      </div>
    </div>
  </div>

        <!-- Memory Categories Tabs -->
        <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 mb-8 border border-white/20">
            <h2 class="text-xl font-semibold mb-4">Memory Categories</h2>
            
            <!-- Category Tabs -->
            <div class="flex space-x-2 mb-4 border-b border-gray-200">
                <button data-category="fact" id="tab-fact" class="category-tab px-4 py-2 font-medium text-blue-600 border-b-2 border-blue-600">
                    Facts
                </button>
                <button data-category="preference" id="tab-preference" class="category-tab px-4 py-2 font-medium text-gray-600 hover:text-blue-600">
                    Preferences
                </button>
                <button data-category="interest" id="tab-interest" class="category-tab px-4 py-2 font-medium text-gray-600 hover:text-blue-600">
                    Interests
                </button>
                <button data-category="relationship" id="tab-relationship" class="category-tab px-4 py-2 font-medium text-gray-600 hover:text-blue-600">
                    Relationships
                </button>
                <button data-category="context" id="tab-context" class="category-tab px-4 py-2 font-medium text-gray-600 hover:text-blue-600">
                    Context
                </button>
            </div>
            
            <!-- Memory List for Current Category -->
            <div id="memoryList" class="space-y-3 mb-4 min-h-[100px]">
                <div class="text-center text-gray-500 py-4">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mx-auto"></div>
                    <p class="mt-2">Loading memories...</p>
                </div>
            </div>
            
            <!-- Add Memory Form -->
            <div class="flex space-x-4">
                <input type="text" id="newMemory" placeholder="Add new memory..." 
                       class="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                <button id="addMemoryBtn" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600">
                    Add Memory
                </button>
            </div>
        </div>

        <!-- Enhanced Personality & Persona -->
        <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 mb-8 border border-white/20">
            <h2 class="text-xl font-semibold mb-4">Personality & Persona</h2>
            
            <!-- Basic Information -->
            <div class="mb-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700">Basic Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Full Name</label>
                    <input type="text" id="fullName" placeholder="Your full name" 
                           class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                </div>
                <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Username</label>
                        <input type="text" id="username" placeholder="Your username" 
                               class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                    <div class="space-y-2 md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700">Bio</label>
                    <textarea id="bio" placeholder="Tell us about yourself" rows="3"
                              class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md"></textarea>
                </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700">Primary Use Case</label>
                        <input type="text" id="primaryUseCase" placeholder="What will you use this AI twin for?" 
                               class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                </div>
            </div>
            
            <!-- Communication Style -->
            <div class="mb-6 border-t pt-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700">Communication Style</h3>
                
                <!-- Tone Sliders -->
                <div class="mb-4">
                    <h4 class="text-sm font-medium mb-3 text-gray-600">Tone Preferences</h4>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Formal ↔ Casual: <span id="formalCasual-value">50</span>
                            </label>
                            <input type="range" id="formalCasual" min="0" max="100" value="50" 
                                   class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Serious ↔ Playful: <span id="seriousPlayful-value">50</span>
                            </label>
                            <input type="range" id="seriousPlayful" min="0" max="100" value="50" 
                                   class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Direct ↔ Diplomatic: <span id="directDiplomatic-value">50</span>
                            </label>
                            <input type="range" id="directDiplomatic" min="0" max="100" value="50" 
                                   class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                        </div>
                    </div>
                </div>
                
                <!-- Language Preferences -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Greeting Style</label>
                        <input type="text" id="greetingStyle" placeholder="e.g., Hey, Hi, Hello" 
                               class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Closing Style</label>
                        <input type="text" id="closingStyle" placeholder="e.g., Thanks, Cheers, Best" 
                               class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Emoji Usage</label>
                        <select id="emojiUsage" class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                            <option value="none">None</option>
                            <option value="minimal">Minimal</option>
                            <option value="moderate" selected>Moderate</option>
                            <option value="frequent">Frequent</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Response Length</label>
                        <select id="responseLength" class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                            <option value="brief">Brief</option>
                            <option value="detailed" selected>Detailed</option>
                            <option value="comprehensive">Comprehensive</option>
                        </select>
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700">Common Phrases</label>
                        <textarea id="commonPhrases" placeholder="Phrases you commonly use..." rows="2"
                                  class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Context -->
            <div class="mb-6 border-t pt-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700">Context & Interests</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2 md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700">Interests (comma-separated)</label>
                    <input type="text" id="interests" placeholder="technology, music, travel" 
                           class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Target Audience</label>
                        <input type="text" id="targetAudience" placeholder="Who are you communicating with?" 
                               class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700">Topics to Avoid</label>
                        <input type="text" id="topicsToAvoid" placeholder="Topics you prefer not to discuss" 
                               class="w-full px-3 py-2 bg-white/80 backdrop-blur-sm border border-white/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary/50 shadow-md">
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between items-center">
            <button id="previewChangesBtn" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                Preview Changes
            </button>
            <div class="space-x-4">
                <button id="resetChangesBtn" class="bg-white/80 backdrop-blur-sm text-gray-700 px-6 py-2 rounded-xl hover:bg-white border border-white/20 transition-all font-medium shadow-md">
                    Reset
                </button>
                <button id="saveChangesBtn" class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                    Save Changes
                </button>
            </div>
        </div>
    </div>

    <script>
    let currentTwinData = null;
    const twinId = '<%= twinId %>';
    let currentMemoryCategory = 'fact'; // Track current category

    function switchMemoryCategory(category) {
        console.log('Switching to category:', category);
        
        if (!category) {
            console.error('No category provided');
            return;
        }
        
        currentMemoryCategory = category;
        console.log('Current category set to:', currentMemoryCategory);
        
        // Update tab styles - remove active from all
        document.querySelectorAll('.category-tab').forEach(tab => {
            tab.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
            tab.classList.add('text-gray-600');
        });
        
        // Add active to selected tab
        const activeTab = document.querySelector(`[data-category="${category}"]`);
        if (activeTab) {
            activeTab.classList.remove('text-gray-600');
            activeTab.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
            console.log('Tab activated:', category);
        } else {
            console.error('Tab not found for category:', category);
        }
        
        // Reload memories for new category
        if (typeof loadMemories === 'function') {
            loadMemories();
        } else {
            console.error('loadMemories function not found');
        }
    }

    // Load twin data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTwinData();
        setupEventListeners();
        
        // Setup tone slider listeners
        ['formalCasual', 'seriousPlayful', 'directDiplomatic'].forEach(id => {
            const slider = document.getElementById(id);
            if (slider) {
                slider.addEventListener('input', function() {
                    document.getElementById(`${id}-value`).textContent = this.value;
                });
            }
        });
    });

    function setupEventListeners() {
        // Setup category tab click listeners
        document.querySelectorAll('.category-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                const category = this.dataset.category;
                if (category) {
                    switchMemoryCategory(category);
                }
            });
        });

        // Setup Add Memory button
        const addMemoryBtn = document.getElementById('addMemoryBtn');
        if (addMemoryBtn) {
            addMemoryBtn.addEventListener('click', function(e) {
                e.preventDefault();
                addMemory();
            });
        }

        // Setup Enter key for Add Memory input
        const newMemoryInput = document.getElementById('newMemory');
        if (newMemoryInput) {
            newMemoryInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addMemory();
                }
            });
        }

        // Setup event delegation for Edit/Delete buttons (for dynamically generated content)
        const memoryListEl = document.getElementById('memoryList');
        if (memoryListEl) {
            memoryListEl.addEventListener('click', function(e) {
                // Handle Edit button clicks
                if (e.target.classList.contains('edit-memory-btn') || e.target.closest('.edit-memory-btn')) {
                    e.preventDefault();
                    e.stopPropagation();
                    const btn = e.target.closest('.edit-memory-btn') || e.target;
                    const memoryKey = btn.dataset.memoryKey;
                    const currentValue = btn.dataset.memoryValue;
                    const category = btn.dataset.memoryCategory;
                    if (memoryKey && currentValue && category) {
                        editMemory(memoryKey, currentValue, category);
                    }
                }
                
                // Handle Delete button clicks
                if (e.target.classList.contains('delete-memory-btn') || e.target.closest('.delete-memory-btn')) {
                    e.preventDefault();
                    e.stopPropagation();
                    const btn = e.target.closest('.delete-memory-btn') || e.target;
                    const memoryKey = btn.dataset.memoryKey;
                    if (memoryKey) {
                        deleteMemory(memoryKey);
                    }
                }
            });
        }

        // Setup Action Buttons
        const previewBtn = document.getElementById('previewChangesBtn');
        if (previewBtn) {
            previewBtn.addEventListener('click', function(e) {
                e.preventDefault();
                previewChanges();
            });
        }

        const resetBtn = document.getElementById('resetChangesBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function(e) {
                e.preventDefault();
                resetChanges();
            });
        }

        const saveBtn = document.getElementById('saveChangesBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', function(e) {
                e.preventDefault();
                saveChanges();
            });
        }
    }

    async function loadTwinData() {
        try {
            const response = await fetch(`/api/twin/${twinId}/edit-data`);
            const data = await response.json();
            
            if (data.success) {
                currentTwinData = data.twin;
                populateForm(data.twin);
            }
        } catch (error) {
            console.error('Error loading twin data:', error);
        }
    }

    function populateForm(twin) {        
        const pd = twin.personaData || {};
        
        // Basic Info - Support both old structure (basicInfo) and new structure (direct fields)
        const basicInfo = pd.basicInfo || {};
        if (document.getElementById('fullName')) document.getElementById('fullName').value = basicInfo.fullName || pd.name || '';
        if (document.getElementById('bio')) document.getElementById('bio').value = basicInfo.bio || pd.bio || '';
        if (document.getElementById('username')) document.getElementById('username').value = basicInfo.username || pd.username || '';
        if (document.getElementById('primaryUseCase')) document.getElementById('primaryUseCase').value = basicInfo.primaryUseCase || pd.primaryUseCase || '';
        
        // Context - Interests
        const interests = pd.context?.interests || pd.interests || [];
        if (document.getElementById('interests')) document.getElementById('interests').value = Array.isArray(interests) ? interests.join(', ') : '';
        
        // Context - Target Audience & Topics to Avoid
        if (document.getElementById('targetAudience')) document.getElementById('targetAudience').value = pd.context?.targetAudience || '';
        if (document.getElementById('topicsToAvoid')) document.getElementById('topicsToAvoid').value = pd.context?.topicsToAvoid || '';
        
        // Communication Style - Tone
        const tone = pd.communicationStyle?.tone || {};
        if (document.getElementById('formalCasual')) {
            document.getElementById('formalCasual').value = tone.formalCasual || 50;
            document.getElementById('formalCasual-value').textContent = tone.formalCasual || 50;
        }
        if (document.getElementById('seriousPlayful')) {
            document.getElementById('seriousPlayful').value = tone.seriousPlayful || 50;
            document.getElementById('seriousPlayful-value').textContent = tone.seriousPlayful || 50;
        }
        if (document.getElementById('directDiplomatic')) {
            document.getElementById('directDiplomatic').value = tone.directDiplomatic || 50;
            document.getElementById('directDiplomatic-value').textContent = tone.directDiplomatic || 50;
        }
        
        // Communication Style - Language
        const language = pd.communicationStyle?.language || {};
        if (document.getElementById('greetingStyle')) document.getElementById('greetingStyle').value = language.greetingStyle || '';
        if (document.getElementById('closingStyle')) document.getElementById('closingStyle').value = language.closingStyle || '';
        if (document.getElementById('emojiUsage')) document.getElementById('emojiUsage').value = language.emojiUsage || 'moderate';
        if (document.getElementById('responseLength')) document.getElementById('responseLength').value = language.responseLength || 'detailed';
        if (document.getElementById('commonPhrases')) document.getElementById('commonPhrases').value = language.commonPhrases || '';
        
        // Load memories for all categories
        loadMemories();
    }


    function updateToneDisplays() {
        const formalCasual = document.getElementById('formalCasual');
        const seriousPlayful = document.getElementById('seriousPlayful');
        const directDiplomatic = document.getElementById('directDiplomatic');
        
        if (formalCasual) document.getElementById('formalCasual-value').textContent = formalCasual.value;
        if (seriousPlayful) document.getElementById('seriousPlayful-value').textContent = seriousPlayful.value;
        if (directDiplomatic) document.getElementById('directDiplomatic-value').textContent = directDiplomatic.value;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function escapeForAttribute(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    async function loadMemories() {
    try {
            const response = await fetch(`/api/twin/${twinId}/long-term-memory?category=${currentMemoryCategory}&limit=20`, {
            credentials: 'include'
        });
        const data = await response.json();
            
            const memoryListEl = document.getElementById('memoryList');
            if (!memoryListEl) return;
        
        if (data.success && data.memories && data.memories.length > 0) {
                const memoryHTML = data.memories.map(memory => {
                    const safeKey = escapeForAttribute(memory.key);
                    const safeValue = escapeHtml(memory.value);
                    const safeValueAttr = escapeForAttribute(memory.value);
                    const safeCategory = escapeForAttribute(memory.category || currentMemoryCategory);
                    const date = memory.createdAt || memory.created_at ? new Date(memory.createdAt || memory.created_at).toLocaleDateString() : '';
                    
                    return `
                        <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                    <div class="flex-1">
                                <p class="text-sm text-gray-900">${safeValue}</p>
                                <span class="text-xs text-gray-500">${safeCategory} • ${date}</span>
                            </div>
                            <div class="flex space-x-2">
                                <button data-memory-key="${safeKey}" data-memory-value="${safeValueAttr}" data-memory-category="${safeCategory}" class="edit-memory-btn text-blue-600 hover:text-blue-800 text-sm px-2 py-1 rounded hover:bg-blue-50 cursor-pointer">
                                    Edit
                                </button>
                                <button data-memory-key="${safeKey}" class="delete-memory-btn text-red-600 hover:text-red-800 text-sm px-2 py-1 rounded hover:bg-red-50 cursor-pointer">
                                    Delete
                                </button>
                    </div>
                </div>
                    `;
                }).join('');
                memoryListEl.innerHTML = memoryHTML;
        } else {
                memoryListEl.innerHTML = `<p class="text-gray-500 text-center py-4">No ${currentMemoryCategory} memories yet. Add your first one above!</p>`;
        }
    } catch (error) {
        console.error('Error loading memories:', error);
            const memoryListEl = document.getElementById('memoryList');
            if (memoryListEl) {
                memoryListEl.innerHTML = '<p class="text-red-500 text-center py-4">Error loading memories</p>';
            }
    }
}

async function addMemory() {
        const memoryText = document.getElementById('newMemory')?.value.trim();
    if (!memoryText) {
        alert('Please enter a memory');
        return;
    }
    
    try {
        const response = await fetch(`/api/twin/${twinId}/long-term-memory`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
            credentials: 'include',
            body: JSON.stringify({
                value: memoryText,
                    category: currentMemoryCategory
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            document.getElementById('newMemory').value = '';
                loadMemories();
            alert('Memory added successfully!');
        } else {
            alert('Error: ' + (data.error || 'Failed to add memory'));
        }
    } catch (error) {
        console.error('Error adding memory:', error);
            alert('Error adding memory: ' + error.message);
        }
    }

    async function editMemory(memoryKey, currentValue, category) {
        const newValue = prompt('Edit memory:', currentValue);
        if (newValue === null || newValue.trim() === '') {
            return;
        }
        
        try {
            const response = await fetch(`/api/twin/${twinId}/long-term-memory/${memoryKey}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.csrfToken
                },
                credentials: 'include',
                body: JSON.stringify({
                    value: newValue.trim(),
                    category: category
                })
            });
            
            const data = await response.json();
            
            if (data.success) {
                loadMemories();
                alert('Memory updated successfully!');
            } else {
                alert('Error: ' + (data.error || 'Failed to update memory'));
            }
        } catch (error) {
            console.error('Error updating memory:', error);
            alert('Error updating memory: ' + error.message);
    }
}

async function deleteMemory(memoryKey) {
    if (!confirm('Are you sure you want to delete this memory?')) {
        return;
    }
    
    try {
        const response = await fetch(`/api/twin/${twinId}/long-term-memory/${memoryKey}`, {
            method: 'DELETE',
            headers: {
                'X-CSRF-Token': window.csrfToken
            },
            credentials: 'include'
        });
        
        const data = await response.json();
        
        if (data.success) {
                loadMemories();
            alert('Memory deleted successfully!');
        } else {
            alert('Error: ' + (data.error || 'Failed to delete memory'));
        }
    } catch (error) {
        console.error('Error deleting memory:', error);
            alert('Error deleting memory: ' + error.message);
    }
}

async function saveChanges() {
    const updates = {
        personaData: {
            basicInfo: {
                    fullName: document.getElementById('fullName')?.value || '',
                    bio: document.getElementById('bio')?.value || '',
                    username: document.getElementById('username')?.value || '',
                    primaryUseCase: document.getElementById('primaryUseCase')?.value || ''
                },
                communicationStyle: {
                    tone: {
                        formalCasual: parseInt(document.getElementById('formalCasual')?.value || 50),
                        seriousPlayful: parseInt(document.getElementById('seriousPlayful')?.value || 50),
                        directDiplomatic: parseInt(document.getElementById('directDiplomatic')?.value || 50)
                    },
                    language: {
                        greetingStyle: document.getElementById('greetingStyle')?.value || '',
                        closingStyle: document.getElementById('closingStyle')?.value || '',
                        emojiUsage: document.getElementById('emojiUsage')?.value || 'moderate',
                        responseLength: document.getElementById('responseLength')?.value || 'detailed',
                        commonPhrases: document.getElementById('commonPhrases')?.value || ''
                    }
                },
                context: {
                    interests: (document.getElementById('interests')?.value || '').split(',').map(i => i.trim()).filter(i => i),
                    targetAudience: document.getElementById('targetAudience')?.value || '',
                    topicsToAvoid: document.getElementById('topicsToAvoid')?.value || ''
                }
        }
    };
    
    try {
        const response = await fetch(`/api/twin/${twinId}/update-persona`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
                credentials: 'include',
            body: JSON.stringify(updates)
        });
        
        const data = await response.json();
        if (data.success) {
            alert('Changes saved successfully!');
            loadTwinData();
        } else {
            alert('Error: ' + (data.error || 'Failed to save changes'));
        }
    } catch (error) {
        console.error('Error saving changes:', error);
            alert('Error saving changes: ' + error.message);
    }
}
    
    function resetChanges() {
        if (currentTwinData) {
            populateForm(currentTwinData);
        } else {
            alert('No data loaded. Please refresh the page.');
        }
    }

    function previewChanges() {
    if (!currentTwinData) {
            alert('Please wait for data to load first');
        return;
    }
        
        const pd = currentTwinData.personaData || {};
        const basicInfo = pd.basicInfo || {};
        const tone = pd.communicationStyle?.tone || {};
        const language = pd.communicationStyle?.language || {};
    
    const current = {
            fullName: basicInfo.fullName || pd.name || '',
            username: basicInfo.username || pd.username || '',
            bio: basicInfo.bio || pd.bio || '',
            primaryUseCase: basicInfo.primaryUseCase || pd.primaryUseCase || '',
            formalCasual: tone.formalCasual || 50,
            seriousPlayful: tone.seriousPlayful || 50,
            directDiplomatic: tone.directDiplomatic || 50,
            greetingStyle: language.greetingStyle || '',
            closingStyle: language.closingStyle || '',
            emojiUsage: language.emojiUsage || 'moderate',
            responseLength: language.responseLength || 'detailed',
            commonPhrases: language.commonPhrases || '',
            interests: (pd.context?.interests || pd.interests || []).join(', '),
            targetAudience: pd.context?.targetAudience || '',
            topicsToAvoid: pd.context?.topicsToAvoid || ''
    };
    
    const updated = {
            fullName: document.getElementById('fullName')?.value || '',
            username: document.getElementById('username')?.value || '',
            bio: document.getElementById('bio')?.value || '',
            primaryUseCase: document.getElementById('primaryUseCase')?.value || '',
            formalCasual: parseInt(document.getElementById('formalCasual')?.value || 50),
            seriousPlayful: parseInt(document.getElementById('seriousPlayful')?.value || 50),
            directDiplomatic: parseInt(document.getElementById('directDiplomatic')?.value || 50),
            greetingStyle: document.getElementById('greetingStyle')?.value || '',
            closingStyle: document.getElementById('closingStyle')?.value || '',
            emojiUsage: document.getElementById('emojiUsage')?.value || 'moderate',
            responseLength: document.getElementById('responseLength')?.value || 'detailed',
            commonPhrases: document.getElementById('commonPhrases')?.value || '',
            interests: document.getElementById('interests')?.value || '',
            targetAudience: document.getElementById('targetAudience')?.value || '',
            topicsToAvoid: document.getElementById('topicsToAvoid')?.value || ''
    };
    
    let changes = [];
        Object.keys(current).forEach(key => {
            if (String(current[key]) !== String(updated[key])) {
                changes.push(`${key}: "${current[key]}" → "${updated[key]}"`);
            }
        });
    
    if (changes.length === 0) {
        alert('No changes detected');
    } else {
        alert('Preview Changes:\n\n' + changes.join('\n'));
    }
}

    // Make functions globally accessible
    window.switchMemoryCategory = switchMemoryCategory;
    window.addMemory = addMemory;
    window.editMemory = editMemory;
    window.deleteMemory = deleteMemory;
    window.saveChanges = saveChanges;
    window.resetChanges = resetChanges;
    window.previewChanges = previewChanges;

    </script>
</body>
</html>