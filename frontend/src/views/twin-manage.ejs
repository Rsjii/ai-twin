<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="/utils/timeUtils.js"></script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- IMMEDIATE Auth Check -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <%
    // Feature flags (if not already defined in layout)
    var FEATURE_FLAGS = (typeof FEATURE_FLAGS !== 'undefined') ? FEATURE_FLAGS : {
      advancedLearningUI: false,
      memoryUI: false,
      styleAnchorsUI: false,
      chatFeedbackUI: false,
      advancedPublicAnalyticsUI: false
    };
  %>    
    <!-- Header -->
    <%- include('header') %>    

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">My Twin Management</h1>
            <p class="text-gray-600 dark:text-gray-300">Manage your AI twin's settings and chats</p>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 cursor-pointer hover:shadow-xl transition-all" data-twin-id="<%= twinPublicId %>" data-list-type="chatters" id="twinManageChattersCard">                
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Chats</p>
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalChats %></p>
                    </div>                    
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                </div>
            </div>

    <!-- ... Views card (not clickable, no API for views) ... -->

    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 cursor-pointer hover:shadow-xl transition-all" data-twin-id="<%= twinPublicId %>" data-list-type="likers" id="twinManageLikersCard">                
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Likes</p>
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalLikes %></p>
                    </div>                    
                    <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 cursor-pointer hover:shadow-xl transition-all" data-twin-id="<%= twinPublicId %>" data-list-type="followers" id="twinManageFollowersCard">                
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Followers</p>
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalFollowers %></p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Twin Info Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8 mb-6 sm:mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Twin Information</h2>
                <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-3">
                    <a href="/ai-edit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base flex items-center justify-center">
                        AI Edit
                    </a>
                    <a href="/style-customize" class="px-4 py-2 bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-600 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base flex items-center justify-center">
                        Style Customize
                    </a>
                    <a href="/twin-settings" class="px-4 py-2 bg-accent text-white rounded-lg hover:bg-purple-600 transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base flex items-center justify-center">
                        Twin Settings
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <div>
                    <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Last Updated</p>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">
                        <span class="timestamp-display" 
                              data-timestamp="<%= twin.updatedAt || twin.updated_at %>" 
                              data-format="smart">
                        </span>
                    </p>
                </div>
                <% if (publicTwin) { %>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Public Handle</p>
                        <div class="flex items-center space-x-2">
                            <input type="text" readonly value="/@<%= publicTwin.handle %>" id="publicLinkInput" class="flex-1 px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-base">
                            <button id="copyPublicLinkBtn" onclick="copyPublicLink()" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation text-base">
                                Copy
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <% /* TODO(V2): Training Stats */ %>
        <% if (FEATURE_FLAGS.advancedLearningUI) { %>

        <!-- Training Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Memory Chunks</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.memoryChunks %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Style Corrections</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.styleCorrections %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Learning Goals</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.learningGoals %></p>
            </div>
        </div>
        <% } %>

        <!-- Recent Chats -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Recent Chats</h2>
                <a href="/public-chat-history" class="text-sm text-primary hover:text-secondary font-medium">
                    View All Public Chats →
                </a>            
            </div>
            <% if (recentChats && recentChats.length > 0) { %>
                <div class="space-y-4">
                    <% recentChats.forEach(chat => { %>
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-white">
                                    <%= chat.title || 'Untitled Chat' %>
                                    <span class="ml-2 text-xs px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded">Public</span>
                                </p>
                                <p class="text-sm text-gray-600 dark:text-gray-300">
                                    <%= chat.message_count || 0 %> messages • 
                                    <span class="chat-date" data-timestamp="<%= chat.lastActivity || chat.createdAt || chat.created_at %>"></span>                                
                                </p>
                            </div>
                            <a href="/public-chat-history/view/<%= chat.publicId %>" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                                Open
                            </a>                            
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-gray-600 dark:text-gray-300">No recent chats</p>
            <% } %>
        </div>

        <!-- Danger Zone (Moved to bottom) -->
        <div class="mt-8 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4 sm:p-6">
            <h2 class="text-xl font-bold text-red-900 dark:text-red-300 mb-4">⚠️ Danger Zone</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
                Once you delete your twin, all data including chats, memories, and training will be permanently removed. This action cannot be undone.
            </p>
            <button 
                id="deleteTwinBtn" 
                class="bg-gradient-to-r from-red-600 to-red-700 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold hover:scale-105 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
            >
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Delete Twin Permanently
                </span>
            </button>
        </div>
    </main>
    <script>
        // Copy Public Link function
        window.copyPublicLink = function() {
            try {
                const input = document.getElementById('publicLinkInput');
                if (!input) {
                    console.error('Input element not found');
                    return;
                }
                
                const url = window.location.origin + input.value;
                console.log('Copying URL:', url);
                
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(() => {
                        alert('Public link copied to clipboard!');
                    }).catch(err => {
                        console.error('Copy failed:', err);
                        alert('Failed to copy link');
                    });
                } else {
                    // Fallback for older browsers
                    input.select();
                    document.execCommand('copy');
                    alert('Public link copied to clipboard!');
                }
            } catch (error) {
                console.error('Error copying link:', error);
                alert('Failed to copy link');
            }
        };
    </script>

<script>
    async function confirmDeleteTwin() {
        const twinId = '<%= twinId %>';
        
        // Double confirmation
        const confirm1 = confirm('⚠️ WARNING: This will permanently delete your twin and ALL associated data (chats, memories, training). This cannot be undone!\n\nAre you sure you want to continue?');
        
        if (!confirm1) {
            return;
        }
        
        const confirm2 = confirm('This is your last chance. Type "DELETE" in the next prompt to confirm.\n\nAre you absolutely sure?');
        
        if (!confirm2) {
            return;
        }
        
        const finalConfirm = prompt('Type "DELETE" to confirm permanent deletion:');
        
        if (finalConfirm !== 'DELETE') {
            alert('Deletion cancelled. Your twin is safe.');
            return;
        }
        
        // Show loading state
        const deleteBtn = document.getElementById('deleteTwinBtn');
        const originalText = deleteBtn.innerHTML;
        deleteBtn.disabled = true;
        deleteBtn.innerHTML = '<span class="flex items-center"><svg class="animate-spin h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Deleting...</span>';
        
        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || window.csrfToken;
            
            const response = await fetch(`/api/twin/${twinId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                credentials: 'include'
            });
            
            const data = await response.json();
            
            if (response.ok && data.success) {
                alert('✅ Twin deleted successfully. Redirecting to onboarding...');
                // Redirect to onboarding to create new twin
                window.location.replace('/onboarding');
            } else {
                throw new Error(data.error || 'Failed to delete twin');
            }
        } catch (error) {
            console.error('Delete twin error:', error);
            alert('❌ Failed to delete twin: ' + error.message);
            deleteBtn.disabled = false;
            deleteBtn.innerHTML = originalText;
        }
    }
    
    // Setup delete button event listener
    document.addEventListener('DOMContentLoaded', function() {
        const deleteBtn = document.getElementById('deleteTwinBtn');
        if (deleteBtn) {
            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                confirmDeleteTwin();
            });
        }
    });
    
// Add click handlers for social list cards
document.addEventListener('DOMContentLoaded', () => {
        const cards = [
            { element: document.getElementById('twinManageChattersCard'), type: 'chatters' },
            { element: document.getElementById('twinManageLikersCard'), type: 'likers' },
            { element: document.getElementById('twinManageFollowersCard'), type: 'followers' }
        ];
        
        cards.forEach(card => {
            if (card.element) {
                card.element.addEventListener('click', function() {
                    const twinId = this.getAttribute('data-twin-id');
                    const listType = this.getAttribute('data-list-type');
                    // ✅ Show view details button for twin/manage
                    if (twinId && typeof window.showSocialList === 'function') {
                        window.showSocialList(twinId, listType, true); // ✅ Changed to true
                    }
                });
            }
        });
    });

// Add after existing scripts
document.addEventListener('DOMContentLoaded', () => {
    // Format twin created date
    const dateEl = document.getElementById('twin-created-date');
    if (dateEl && dateEl.dataset.timestamp) {
        dateEl.textContent = TimeUtils.formatDateOnly(dateEl.dataset.timestamp);
        dateEl.title = TimeUtils.formatFullDateTime(dateEl.dataset.timestamp);
    }
    
    // ✅ FIX: Format all timestamp-display elements (including Last Updated)
    document.querySelectorAll('.timestamp-display').forEach(el => {
        const timestamp = el.dataset.timestamp;
        const format = el.dataset.format || 'smart';
        if (timestamp && window.TimeUtils) {
            try {
                let displayTime, fullTime;
                if (format === 'smart') {
                    displayTime = window.TimeUtils.formatRelativeTime(timestamp);
                } else {
                    displayTime = window.TimeUtils.formatSmartTime(timestamp);
                }
                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                el.textContent = displayTime;
                el.title = fullTime;
            } catch (e) {
                console.error('Error formatting timestamp:', e);
            }
        }
    });
});

// ✅ FIX: Change Recent Chats from absolute date to relative time
document.querySelectorAll('.chat-date').forEach(el => {
    if (el.dataset.timestamp && window.TimeUtils) {
        // Use relative time instead of absolute date
        el.textContent = window.TimeUtils.formatRelativeTime(el.dataset.timestamp);
        el.title = window.TimeUtils.formatFullDateTime(el.dataset.timestamp);
    }
});

</script>
    <!--Footer-->
    <%- include('footer/footer-conditional-private') %>

    <!-- Social List Modal -->
    <%- include('shared/social-list-modal') %>
</body>
</html>