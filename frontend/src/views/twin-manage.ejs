// ✅ NEW: Twin Status Toggle (Same as Settings Flow)
document.addEventListener('DOMContentLoaded', function() {
    const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : "" %>';
    const isPublic = <%= typeof isPublic !== 'undefined' && isPublic ? 'true' : 'false' %>;
    
    // ✅ Bio character counter with input prevention (max MAX_BIO_CHARS)
    const publicBio = document.getElementById('publicBio');
    const bioCharCount = document.getElementById('bioCharCount');
    if (publicBio && bioCharCount) {
        let bioPrevValue = publicBio.value;
        const updateBioCount = () => {
            const length = publicBio.value.length;
            bioCharCount.textContent = length;
            if (length > MAX_BIO_CHARS) {
                bioCharCount.classList.add('text-red-600', 'dark:text-red-400');
            } else {
                bioCharCount.classList.remove('text-red-600', 'dark:text-red-400');
            }
        };
        publicBio.addEventListener('input', function() {
            if (publicBio.value.length > MAX_BIO_CHARS) {
                publicBio.value = bioPrevValue;
                return;
            }
            bioPrevValue = publicBio.value;
            updateBioCount();
        });
        updateBioCount(); // Initial count
    }
    
    // Make Twin Public (with bio form)
    const makeTwinPublicBtn = document.getElementById('makeTwinPublicBtn');
    if (makeTwinPublicBtn) {
        makeTwinPublicBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            
            if (!twinToken) {
                showNotification('Twin token not found', 'error');
                return;
            }
            
            const bio = document.getElementById('publicBio')?.value?.trim() || '';
            
            // ✅ Validate bio is not empty
            if (!bio || bio.length === 0) {
                showNotification('Bio is required', 'error');
                return;
            }
            
            // ✅ Validate bio length (MAX_BIO_CHARS chars max)
            if (bio.length > MAX_BIO_CHARS) {
                showNotification(`Bio must be ${MAX_BIO_CHARS} characters or less (currently ${bio.length})`, 'error');
                return;
            }
            
            // Disable button during submission
            makeTwinPublicBtn.disabled = true;
            const originalText = makeTwinPublicBtn.textContent;
            makeTwinPublicBtn.textContent = 'Making Public...';
            
            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || window.csrfToken;
                
                const response = await fetch('/api/public-twin/make-public', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        twinId: twinToken,
                        bio: bio
                    })
                });
                
                // ✅ Handle 429 rate limit errors properly
                if (response.status === 429) {
                    const result = await response.json().catch(() => ({ error: 'Rate limit exceeded', errorCode: 'RATE_LIMIT_EXCEEDED' }));
                    showNotification(result.error || 'Too many visibility changes. Please try again later.', 'error');
                    makeTwinPublicBtn.disabled = false;
                    makeTwinPublicBtn.textContent = originalText;
                    return;
                }
                
                const result = await response.json();
                
                if (response.ok && result.success) {
                    showNotification('Twin made public successfully!', 'success');
                    // Force page reload to show updated status
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    // ✅ Handle rate limit errors from response body
                    if (result.errorCode === 'RATE_LIMIT_EXCEEDED') {
                        showNotification(result.error || 'Too many visibility changes. Please try again later.', 'error');
                    } else {
                        showNotification(result.error || result.message || 'Failed to make twin public', 'error');
                    }
                    makeTwinPublicBtn.disabled = false;
                    makeTwinPublicBtn.textContent = originalText;
                }
            } catch (error) {
                ErrorLogger.error('Make twin public error', error, {});
                showNotification('Network error. Please try again.', 'error');
                makeTwinPublicBtn.disabled = false;
                makeTwinPublicBtn.textContent = originalText;
            }
        });
    }
    
    // Make Twin Private
    const makeTwinPrivateBtn = document.getElementById('makeTwinPrivateBtn');
    if (makeTwinPrivateBtn) {
        makeTwinPrivateBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            
            if (!twinToken) {
                showNotification('Twin token not found', 'error');
                return;
            }
            
            const confirmed = await window.ModalHelpers?.confirm?.({
                title: 'Make Twin Private',
                message: 'Make your twin private? Only you will be able to access it.',
                confirmLabel: 'Yes, Continue',
                cancelLabel: 'Cancel',
                type: 'info'
            });
            
            if (!confirmed) return;
            
            // Show loading
            const originalText = this.textContent;
            this.disabled = true;
            this.textContent = 'Making Private...';
            
            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || window.csrfToken;
                
                const response = await fetch('/api/public-twin/make-private', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify({ twinId: twinToken })
                });
                
                // ✅ Handle 429 rate limit errors properly
                if (response.status === 429) {
                    const data = await response.json().catch(() => ({ error: 'Rate limit exceeded', errorCode: 'RATE_LIMIT_EXCEEDED' }));
                    showNotification(data.error || 'Too many visibility changes. Please try again later.', 'error');
                    this.disabled = false;
                    this.textContent = originalText;
                    return;
                }
                
                const data = await response.json();
                
                if (response.ok && data.success) {
                    showNotification('Twin is now private!', 'success');
                    // Reload page to reflect changes
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    // ✅ Handle rate limit errors from response body
                    if (data.errorCode === 'RATE_LIMIT_EXCEEDED') {
                        showNotification(data.error || 'Too many visibility changes. Please try again later.', 'error');
                    } else {
                        showNotification(data.error || 'Failed to update status', 'error');
                    }
                    this.disabled = false;
                    this.textContent = originalText;
                }
            } catch (error) {
                ErrorLogger.error('Make twin private error', error, {});
                // ✅ Handle JSON parsing errors (e.g., if response is not JSON)
                if (error.message && error.message.includes('JSON')) {
                    showNotification('Rate limit exceeded. Please try again later.', 'error');
                } else {
                    showNotification('Failed to update status: ' + (error.message || 'Unknown error'), 'error');
                }
                this.disabled = false;
                this.textContent = originalText;
            }
        });
    }
    
    // Copy Public Link handler (for both desktop and mobile buttons)
    function setupCopyButton(buttonId) {
        const copyBtn = document.getElementById(buttonId);
        if (copyBtn) {
            copyBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const url = window.location.origin + '/@<%= user.handle %>';
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(() => {
                        // Update button text temporarily
                        const originalText = this.innerHTML;
                        const isMobile = buttonId.includes('Mobile');
                        // Ensure button maintains exact square dimensions (44px x 44px) matching handle box height
                        if (isMobile) {
                            this.style.height = '44px';
                            this.style.width = '44px';
                            this.style.minHeight = '44px';
                            this.style.maxHeight = '44px';
                            this.style.minWidth = '44px';
                            this.style.maxWidth = '44px';
                            this.style.padding = '0';
                            this.style.display = 'flex';
                            this.style.alignItems = 'center';
                            this.style.justifyContent = 'center';
                        } else {
                            this.style.height = '44px';
                            this.style.minHeight = '44px';
                            this.style.maxHeight = '44px';
                        }
                        this.innerHTML = isMobile 
                            ? '<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
                            : '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><span class="hidden sm:inline">Copied!</span>';
                        this.classList.add('bg-green-600', 'hover:bg-green-700', 'dark:bg-green-500', 'dark:hover:bg-green-600');
                        this.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'dark:bg-blue-500', 'dark:hover:bg-blue-600');
                        showNotification('Public link copied to clipboard!', 'success');
                        setTimeout(() => {
                            this.innerHTML = originalText;
                            this.classList.remove('bg-green-600', 'hover:bg-green-700', 'dark:bg-green-500', 'dark:hover:bg-green-600');
                            this.classList.add('bg-blue-600', 'hover:bg-blue-700', 'dark:bg-blue-500', 'dark:hover:bg-blue-600');
                            // Ensure square dimensions are maintained after reset (mobile only)
                            if (isMobile) {
                                this.style.height = '44px';
                                this.style.width = '44px';
                                this.style.minHeight = '44px';
                                this.style.maxHeight = '44px';
                                this.style.minWidth = '44px';
                                this.style.maxWidth = '44px';
                                this.style.padding = '0';
                            }
                        }, 2000);
                    }).catch(err => {
                        ErrorLogger.error('Copy failed', err, {});
                        showNotification('Failed to copy link', 'error');
                    });
                } else {
                    // Fallback
                    const textArea = document.createElement('textarea');
                    textArea.value = url;
                    document.body.appendChild(textArea);
                    textArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textArea);
                    showNotification('Public link copied to clipboard!', 'success');
                }
            });
        }
    }
    
    // Setup both desktop and mobile copy buttons
    setupCopyButton('copyPublicLinkBtnManage');
    setupCopyButton('copyPublicLinkBtnManageMobile');
});

</script>
