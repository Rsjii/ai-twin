// Add after existing scripts
document.addEventListener('DOMContentLoaded', () => {
    // Format twin created date
    const dateEl = document.getElementById('twin-created-date');
    if (dateEl && dateEl.dataset.timestamp) {
        dateEl.textContent = TimeUtils.formatDateOnly(dateEl.dataset.timestamp);
        dateEl.title = TimeUtils.formatFullDateTime(dateEl.dataset.timestamp);
    }
    
    // ✅ FIX: Format all timestamp-display elements (including Last Updated) - Timezone-aware
    document.querySelectorAll('.timestamp-display').forEach(el => {
        const timestamp = el.dataset.timestamp;
        const format = el.dataset.format || 'smart';
        
        if (timestamp && window.TimeUtils) {
            try {
                let displayTime, fullTime;
                if (format === 'exact') {
                    // ✅ FIX: Always show exact time in user's timezone for "Last Updated"
                    displayTime = window.TimeUtils.formatExactTime(timestamp);
                } else if (format === 'smart') {
                    // Smart format: relative for recent, exact for old (like chats)
                    displayTime = window.TimeUtils.formatSmartTime(timestamp);
                } else if (format === 'relative') {
                    // Relative format: "2h ago", "3d ago"
                    displayTime = window.TimeUtils.formatRelativeTime(timestamp);
                } else if (format === 'context') {
                    // Context format: "Today at 3:45 PM", "Yesterday at 3:45 PM"
                    displayTime = window.TimeUtils.formatTimeWithContext(timestamp);
                } else {
                    // Default: smart format
                    displayTime = window.TimeUtils.formatSmartTime(timestamp);
                }
                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                
                el.textContent = displayTime || '';
                el.title = fullTime || '';
            } catch (e) {
                ErrorLogger.error('Error formatting timestamp', e, {});
                el.textContent = '';
            }
        }
    });
});

