<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="/utils/timeUtils.js"></script>
    <script src="/utils/errorHandler.js"></script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- IMMEDIATE Auth Check -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <%
    // Feature flags (if not already defined in layout)
    var FEATURE_FLAGS = (typeof FEATURE_FLAGS !== 'undefined') ? FEATURE_FLAGS : {
      advancedLearningUI: false,
      memoryUI: false,
      styleAnchorsUI: false,
      chatFeedbackUI: false,
      advancedPublicAnalyticsUI: false
    };
  %>    
    <!-- Header -->
    <%- include('header') %>    

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">My Twin Management</h1>
            <p class="text-gray-600 dark:text-gray-300">Manage your AI twin's settings and chats</p>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6 mb-6 sm:mb-8">            
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 cursor-pointer hover:shadow-xl transition-all" data-twin-id="<%= twinPublicId %>" data-list-type="chatters" id="twinManageChattersCard">                
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Messages</p>
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalChats %></p>
                    </div>                    
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                </div>
            </div>

    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Views</p>
          <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalViews %></p>
        </div>
        <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 cursor-pointer hover:shadow-xl transition-all" data-twin-id="<%= twinPublicId %>" data-list-type="likers" id="twinManageLikersCard">                
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Total Likes</p>
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalLikes %></p>
                    </div>                    
                    <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 cursor-pointer hover:shadow-xl transition-all" data-twin-id="<%= twinPublicId %>" data-list-type="followers" id="twinManageFollowersCard">                
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Followers</p>
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalFollowers %></p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Twin Info Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8 mb-6 sm:mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Twin Information</h2>
                <div class="grid grid-cols-3 gap-2 w-full sm:w-auto">
                    <a href="/@<%= user.handle %>" class="px-2 py-2 text-xs sm:text-sm bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors min-h-[36px] sm:min-h-[44px] touch-manipulation flex items-center justify-center text-center truncate">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        View Profile
                    </a>
                    <% /* ✅ MVP: AI Edit button removed (V2 feature) */ %>
                    <a href="/analytics" class="px-2 py-2 text-xs sm:text-sm bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-600 transition-colors min-h-[36px] sm:min-h-[44px] touch-manipulation flex items-center justify-center text-center truncate">
                        Analytics
                    </a>
                    <a href="/twin-settings" class="px-2 py-2 text-xs sm:text-sm bg-accent text-white rounded-lg hover:bg-purple-600 transition-colors min-h-[36px] sm:min-h-[44px] touch-manipulation flex items-center justify-center text-center truncate">
                        Twin Settings
                    </a>
                </div>
            </div>

            <!-- ✅ NEW: Twin Status Badge and Form (Same as Settings) -->
            <div class="mt-4">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-3">
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Status:</span>
                        <% if (typeof isPublic !== 'undefined' && isPublic) { %>
                            <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 rounded-lg text-sm font-semibold">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Public
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded-lg text-sm font-semibold">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                                Private
                            </span>
                        <% } %>
                    </div>
                    <!-- ✅ Mobile: Last Updated in status row (right side) -->
                    <div class="sm:hidden text-right">
                        <p class="text-xs text-gray-600 dark:text-gray-300 mb-0.5">Last Updated</p>
                        <p class="text-xs font-medium text-gray-900 dark:text-white">
                            <span class="timestamp-display" 
                                  data-timestamp="<%= twin.updatedAt || twin.updated_at %>" 
                                  data-format="smart">
                            </span>
                        </p>
                    </div>
                </div>

                <% if (!isPublic) { %>
                    <!-- Make Public Form (Same as Settings) -->
                    <div id="makePublicForm" class="space-y-4 p-4 bg-white/60 dark:bg-gray-800/60 rounded-lg border border-gray-200 dark:border-gray-700">
                        <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
                            <p class="text-sm text-blue-800 dark:text-blue-300">
                                <strong>Profile URL:</strong> Your profile will be accessible at <code class="bg-white dark:bg-gray-800 px-2 py-1 rounded">/@<%= user.handle %></code>
                            </p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Bio <span class="text-red-500">*</span></label>
                            <textarea id="publicBio" rows="3" placeholder="Describe your AI twin..." maxlength="150" required class="w-full px-4 py-2 border-2 border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900 dark:text-white break-words overflow-wrap-anywhere"><%= typeof twin !== 'undefined' && twin && twin.bio ? twin.bio : '' %></textarea>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><span id="bioCharCount"><%= typeof twin !== 'undefined' && twin && twin.bio ? twin.bio.length : 0 %></span>/150 characters</p>
                        </div>
                        <button id="makeTwinPublicBtn" class="w-full bg-gradient-to-r from-green-500 to-emerald-500 text-white py-2 px-4 rounded-lg hover:shadow-lg transition-all font-semibold">
                            Make Twin Public
                        </button>
                    </div>
                <% } else { %>
                    <!-- Make Private Section (When Public) -->
                    <div class="p-4 bg-green-50 dark:bg-green-900/20 rounded-lg border border-green-200 dark:border-green-800">
                        <button 
                            id="makeTwinPrivateBtn"
                            class="w-full bg-gradient-to-r from-red-600 to-red-700 text-white py-2 px-4 rounded-lg hover:shadow-lg transition-all font-semibold">
                            Make Twin Private
                        </button>
                        <!-- ✅ Mobile: Public Profile below Make Private button -->
                        <% if (publicTwin) { %>
                            <div class="mt-4 sm:hidden">
                                <p class="text-xs text-gray-600 dark:text-gray-300 mb-1.5">Public Profile</p>
                                <div class="flex items-stretch gap-2">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-1.5 px-3 py-2 h-[44px] bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                                            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                                            </svg>
                                            <code class="flex-1 text-xs font-mono text-blue-700 dark:text-blue-300 truncate">/@<%= publicTwin.handle %></code>
                                        </div>
                                    </div>
                                    <button
                                        type="button"
                                        id="copyPublicLinkBtnManageMobile"
                                        class="w-[44px] h-[44px] min-w-[44px] max-w-[44px] min-h-[44px] max-h-[44px] aspect-square flex-shrink-0 p-0 bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white rounded-lg transition-colors duration-200 flex items-center justify-center shadow-sm hover:shadow-md"
                                        aria-label="Copy public link"
                                        title="Copy profile URL"
                                    >
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16h8a2 2 0 002-2V6a2 2 0 00-2-2H8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 8h2a2 2 0 012 2v8a2 2 0 01-2 2h-8a2 2 0 01-2-2v-2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- ✅ Desktop: Last Updated and Public Profile (hidden on mobile) -->
            <div class="hidden sm:block mt-6 sm:mt-8">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Last Updated</p>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">
                            <span class="timestamp-display" 
                                  data-timestamp="<%= twin.updatedAt || twin.updated_at %>" 
                                  data-format="smart">
                            </span>
                        </p>
                    </div>
                    <% if (publicTwin) { %>
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-300 mb-1">Public Profile</p>
                            <div class="flex items-center gap-2">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                                        </svg>
                                        <code class="flex-1 text-sm font-mono text-blue-700 dark:text-blue-300 truncate">/@<%= publicTwin.handle %></code>
                                    </div>
                                </div>
                                <button
                                    type="button"
                                    id="copyPublicLinkBtnManage"
                                    class="flex-shrink-0 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white rounded-lg transition-colors duration-200 font-medium text-sm flex items-center gap-2 shadow-sm hover:shadow-md"
                                    aria-label="Copy public link"
                                    title="Copy profile URL"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16h8a2 2 0 002-2V6a2 2 0 00-2-2H8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8h2a2 2 0 012 2v8a2 2 0 01-2 2h-8a2 2 0 01-2-2v-2"></path>
                                    </svg>
                                    <span class="hidden sm:inline">Copy</span>
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <% /* TODO(V2): Training Stats */ %>
        <% if (FEATURE_FLAGS.advancedLearningUI) { %>

        <!-- Training Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Memory Chunks</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.memoryChunks %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Style Corrections</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.styleCorrections %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Learning Goals</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.learningGoals %></p>
            </div>
        </div>
        <% } %>

        <!-- Recent Chats -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Recent Chats</h2>
                <a href="/public-chat-history" class="text-sm text-primary hover:text-secondary font-medium">
                    View All Public Chats →
                </a>            
            </div>
            <% if (recentChats && recentChats.length > 0) { %>
                <div class="space-y-4">
                    <% recentChats.forEach(chat => { %>
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-white">
                                    <%= chat.title || 'Untitled Chat' %>
                                </p>
                                <p class="text-sm text-gray-600 dark:text-gray-300">
                                    <%= chat.message_count || 0 %> messages • 
                                    <span class="chat-date" data-timestamp="<%= chat.lastActivity || chat.createdAt || chat.created_at %>"></span>                                
                                </p>
                            </div>
                            <a href="/public-chat-history/view/<%= chat.publicId %>" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                                Open
                            </a>                            
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-gray-600 dark:text-gray-300">No recent chats</p>
            <% } %>
        </div>

        <!-- Danger Zone (Moved to bottom) -->
        <div class="mt-8 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4 sm:p-6">
            <h2 class="text-xl font-bold text-red-900 dark:text-red-300 mb-4">⚠️ Danger Zone</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
                Once you delete your twin, all data including chats, memories, and training will be permanently removed. This action cannot be undone.
            </p>
            <button 
                id="deleteTwinBtn" 
                class="bg-gradient-to-r from-red-600 to-red-700 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold hover:scale-105 min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
            >
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Delete Twin Permanently
                </span>
            </button>
        </div>
    </main>
    <script>
        // Copy Public Link function
        window.copyPublicLink = function() {
            try {
                const input = document.getElementById('publicLinkInput');
                if (!input) {
                    ErrorLogger.error('Input element not found', null, {});
                    return;
                }
                
                const url = window.location.origin + input.value;
                
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(() => {
                        showNotification('Public link copied to clipboard!', 'success');
                    }).catch(err => {
                        ErrorLogger.error('Copy failed', err, {});
                        showNotification('Failed to copy link', 'error');
                    });
                } else {
                    // Fallback for older browsers
                    input.select();
                    document.execCommand('copy');
                    showNotification('Public link copied to clipboard!', 'success');
                }
            } catch (error) {
                ErrorLogger.error('Error copying link', error, {});
                showNotification('Failed to copy link', 'error');
            }
        };
    </script>

<script>
    // ✅ Bio limit constant (must match backend MEMORY_LIMITS.MAX_BIO_CHARS)
    const MAX_BIO_CHARS = 150;
    
    async function confirmDeleteTwin() {
        // ✅ SECURITY: Use tokenized twinToken instead of raw twinId
        const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : (typeof twinPublicId !== "undefined" ? twinPublicId : "") %>';
        
        // Step 1: First confirmation
        const confirm1 = await window.ModalHelpers.confirm({
            title: '⚠️ WARNING: Delete Twin',
            message: 'This will permanently delete your twin and ALL associated data (chats, memories, training). This cannot be undone!',
            confirmLabel: 'Continue',
            cancelLabel: 'Cancel',
            type: 'danger'
        });
        
        if (!confirm1) {
            return;
        }
        
        // Step 2: Second confirmation
        const confirm2 = await window.ModalHelpers.confirm({
            title: '⚠️ Last Chance',
            message: 'This is your last chance. Are you absolutely sure you want to permanently delete your twin?',
            confirmLabel: 'Yes, Delete',
            cancelLabel: 'Cancel',
            type: 'danger'
        });
        
        if (!confirm2) {
            return;
        }
        
        // Step 3: Final confirmation with input
        const finalConfirm = await window.ModalHelpers.input({
            title: 'Final Confirmation',
            message: 'Type "DELETE" (all caps) to confirm permanent deletion:',
            placeholder: 'Type DELETE here...'
        });
        
        if (finalConfirm !== 'DELETE') {
            showNotification('Deletion cancelled. Your twin is safe.', 'info');
            return;
        }
        
        // Show loading state
        const deleteBtn = document.getElementById('deleteTwinBtn');
        const originalText = deleteBtn.innerHTML;
        deleteBtn.disabled = true;
        deleteBtn.innerHTML = '<span class="flex items-center"><svg class="animate-spin h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Deleting...</span>';
        
        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || window.csrfToken;
            
            const response = await fetch(`/api/twin/${twinToken}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                credentials: 'include'
            });
            
            // ✅ Handle 429 rate limit errors properly
            if (response.status === 429) {
                const result = await response.json().catch(() => ({ error: 'Rate limit exceeded', errorCode: 'RATE_LIMIT_EXCEEDED' }));
                showNotification(result.error || 'Too many twin deletion attempts. Please try again later.', 'error');
                deleteBtn.disabled = false;
                deleteBtn.innerHTML = originalText;
                return;
            }
            
            const data = await response.json();
            
            if (response.ok && data.success) {
                // ✅ FIX: Clear onboarding localStorage before redirect
                try {
                    localStorage.removeItem('enhancedOnboarding_v1');
                } catch (e) {
                    ErrorLogger.warn('Failed to clear onboarding localStorage', { error: e });
                }
                
                showNotification('✅ Twin deleted successfully. Redirecting to onboarding...', 'success');
                // Redirect to onboarding to create new twin
                setTimeout(() => {
                    window.location.replace('/onboarding');
                }, 1000);
            } else {
                // ✅ Handle rate limit errors from response body
                if (data.errorCode === 'RATE_LIMIT_EXCEEDED') {
                    showNotification(data.error || 'Too many twin deletion attempts. Please try again later.', 'error');
                } else {
                    throw new Error(data.error || 'Failed to delete twin');
                }
                deleteBtn.disabled = false;
                deleteBtn.innerHTML = originalText;
            }
        } catch (error) {
            ErrorLogger.error('Delete twin error', error, {});
            // ✅ Handle JSON parsing errors (e.g., if response is not JSON)
            if (error.message && error.message.includes('JSON')) {
                showNotification('Rate limit exceeded. Please try again later.', 'error');
            } else {
                showNotification('❌ Failed to delete twin: ' + error.message, 'error');
            }
            deleteBtn.disabled = false;
            deleteBtn.innerHTML = originalText;
        }
    }
    
    // Setup delete button event listener
    document.addEventListener('DOMContentLoaded', function() {
        const deleteBtn = document.getElementById('deleteTwinBtn');
        if (deleteBtn) {
            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                confirmDeleteTwin();
            });
        }
    });
    
