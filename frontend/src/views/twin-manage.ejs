<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444',
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen font-inter">
    <!-- Header -->
    <header class="bg-white/80 backdrop-blur-xl border-b border-white/20 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <a href="/" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" stroke="currentColor" fill="none">
                                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </a>
                </div>
                
                <!-- Navigation -->
                <nav class="flex space-x-8">
                    <a href="/dashboard" class="text-gray-600 hover:text-primary transition-colors font-medium">Dashboard</a>
                    <a href="/profile" class="text-gray-600 hover:text-primary transition-colors font-medium">Profile</a>
                    <a href="/discover" class="text-gray-600 hover:text-primary transition-colors font-medium">Discover</a>
                </nav>

                <!-- User Menu -->
                <div class="flex items-center space-x-4">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="relative" id="userDropdown" data-open="false">
                            <button id="dropdownButton" class="flex items-center space-x-3 px-4 py-2 rounded-xl bg-white/80 hover:bg-white transition-all duration-300 shadow-lg hover:shadow-xl border border-white/20 group">
                                <% if (user.profileImage) { %>
                                    <img src="<%= user.profileImage %>" alt="Profile" class="w-10 h-10 rounded-full object-cover shadow-lg">
                                <% } else { %>
                                    <div class="w-10 h-10 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg">
                                        <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div class="hidden sm:block text-left">
                                    <div class="text-sm font-semibold text-gray-900"><%= user.handle || user.email %></div>
                                    <div class="text-xs text-gray-500"><%= user.email %></div>
                                </div>
                                <svg id="arrowIcon" class="w-4 h-4 text-gray-400 transition-transform duration-200 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            
                            <div id="dropdownMenu" class="absolute right-0 mt-3 w-72 bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 py-3 z-50 hidden transition-all duration-200 opacity-0 scale-95">
                                <div class="px-6 py-4 border-b border-gray-100/50">
                                    <div class="flex items-center space-x-4">
                                        <% if (user.profileImage) { %>
                                            <img src="<%= user.profileImage %>" alt="Profile" class="w-14 h-14 rounded-2xl object-cover shadow-lg">
                                        <% } else { %>
                                            <div class="w-14 h-14 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-2xl flex items-center justify-center text-white text-xl font-bold shadow-lg">
                                                <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-lg font-semibold text-gray-900 truncate"><%= user.name || user.handle || 'User' %></p>
                                            <p class="text-sm text-gray-500 truncate"><%= user.email %></p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="py-2">
                                    <a href="/profile" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        Profile
                                    </a>
                                    <% if (hasTwins) { %>
                                        <a href="/twin/manage" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                            <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                            </svg>
                                            My Twin
                                        </a>
                                    <% } %>
                                    <a href="/analytics" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                        </svg>
                                        Analytics
                                    </a>
                                    <a href="/profile?tab=settings" class="flex items-center px-6 py-3 text-gray-700 hover:bg-gray-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                        Settings
                                    </a>
                                </div>
                                
                                <div class="border-t border-gray-100/50 pt-2">
                                    <button onclick="logout()" class="flex items-center w-full px-6 py-3 text-red-600 hover:bg-red-50/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                        </svg>
                                        Sign Out
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">My Twin Management</h1>
            <p class="text-gray-600">Manage your AI twin's settings, training, and analytics</p>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Total Chats</p>
                        <p class="text-3xl font-bold text-gray-900"><%= stats.totalChats %></p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Total Views</p>
                        <p class="text-3xl font-bold text-gray-900"><%= stats.totalViews %></p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Total Likes</p>
                        <p class="text-3xl font-bold text-gray-900"><%= stats.totalLikes %></p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Followers</p>
                        <p class="text-3xl font-bold text-gray-900"><%= stats.totalFollowers %></p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Twin Info Card -->
        <div class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 p-8 mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-gray-900">Twin Information</h2>
                <div class="flex space-x-3">
                    <a href="/twin/<%= twinId %>/ai-edit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                        AI Edit
                    </a>
                    <a href="/twin/<%= twinId %>/style-customize" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                        Style Customize
                    </a>
                    <a href="/twin/<%= twinId %>/learning-dashboard" class="px-4 py-2 bg-accent text-white rounded-lg hover:bg-purple-600 transition-colors">
                        Learning Dashboard
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Created</p>
                    <p class="text-lg font-semibold text-gray-900">
                        <%= new Date(twin.createdAt || twin.created_at).toLocaleDateString() %>
                    </p>
                </div>
                <% if (publicTwin) { %>
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Public Handle</p>
                        <div class="flex items-center space-x-2">
                            <input type="text" readonly value="/@<%= publicTwin.handle %>" id="publicLinkInput" class="flex-1 px-4 py-2 border border-gray-200 rounded-lg bg-gray-50 text-gray-600">
                            <button id="copyPublicLinkBtn" onclick="copyPublicLink()" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                                Copy
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Training Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <p class="text-sm text-gray-600 mb-2">Memory Chunks</p>
                <p class="text-2xl font-bold text-gray-900"><%= stats.memoryChunks %></p>
            </div>
            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <p class="text-sm text-gray-600 mb-2">Style Corrections</p>
                <p class="text-2xl font-bold text-gray-900"><%= stats.styleCorrections %></p>
            </div>
            <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg border border-white/20 p-6">
                <p class="text-sm text-gray-600 mb-2">Learning Goals</p>
                <p class="text-2xl font-bold text-gray-900"><%= stats.learningGoals %></p>
            </div>
        </div>

        <!-- Recent Chats -->
        <div class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Recent Chats</h2>
            <% if (recentChats && recentChats.length > 0) { %>
                <div class="space-y-4">
                    <% recentChats.forEach(chat => { %>
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                            <div>
                                <p class="font-semibold text-gray-900"><%= chat.title || 'Untitled Chat' %></p>
                                <p class="text-sm text-gray-600">
                                    <%= chat.message_count || 0 %> messages • 
                                    <%= new Date(chat.createdAt || chat.created_at).toLocaleDateString() %>
                                </p>
                            </div>
                            <a href="/chat-enhanced?chatId=<%= chat.id %>" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                                Open
                            </a>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-gray-600">No recent chats</p>
            <% } %>
        </div>
    </main>

    <script>
        // Copy Public Link function
        window.copyPublicLink = function() {
            try {
                const input = document.getElementById('publicLinkInput');
                if (!input) {
                    console.error('Input element not found');
                    return;
                }
                
                const url = window.location.origin + input.value;
                console.log('Copying URL:', url);
                
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(() => {
                        alert('Public link copied to clipboard!');
                    }).catch(err => {
                        console.error('Copy failed:', err);
                        alert('Failed to copy link');
                    });
                } else {
                    // Fallback for older browsers
                    input.select();
                    document.execCommand('copy');
                    alert('Public link copied to clipboard!');
                }
            } catch (error) {
                console.error('Error copying link:', error);
                alert('Failed to copy link');
            }
        };

        // Dropdown functionality
        document.addEventListener('DOMContentLoaded', function() {
            const dropdown = document.getElementById('userDropdown');
            const button = document.getElementById('dropdownButton');
            const menu = document.getElementById('dropdownMenu');
            const arrow = document.getElementById('arrowIcon');

            if (button && menu) {
                button.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isOpen = dropdown.getAttribute('data-open') === 'true';
                    
                    if (isOpen) {
                        menu.classList.add('hidden');
                        menu.classList.remove('opacity-100', 'scale-100');
                        menu.classList.add('opacity-0', 'scale-95');
                        arrow.style.transform = 'rotate(0deg)';
                        dropdown.setAttribute('data-open', 'false');
                    } else {
                        menu.classList.remove('hidden');
                        menu.classList.remove('opacity-0', 'scale-95');
                        menu.classList.add('opacity-100', 'scale-100');
                        arrow.style.transform = 'rotate(180deg)';
                        dropdown.setAttribute('data-open', 'true');
                    }
                });

                document.addEventListener('click', function(e) {
                    if (!dropdown.contains(e.target)) {
                        menu.classList.add('hidden');
                        menu.classList.remove('opacity-100', 'scale-100');
                        menu.classList.add('opacity-0', 'scale-95');
                        arrow.style.transform = 'rotate(0deg)';
                        dropdown.setAttribute('data-open', 'false');
                    }
                });
            }

            // Copy button event listener
            const copyPublicLinkBtn = document.getElementById('copyPublicLinkBtn');
            if (copyPublicLinkBtn) {
                copyPublicLinkBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof window.copyPublicLink === 'function') {
                        window.copyPublicLink();
                    }
                });
            }
        });

        // Logout function
        function logout() {
            if (confirm('Are you sure you want to sign out?')) {
                window.location.href = '/api/auth/logout';
            }
        }
    </script>
</body>
</html>