                                            </svg>
                                            <svg id="themeIconMoon" class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>                           
            </div>
        </div>
    </div>

    <script>
        // Tab switching functionality - Make it globally accessible
        const activeTab = '<%= activeTab %>' || 'profile';
        
        // ✅ FIX ISSUE 3: Get active tab and subtab from URL
        function getActiveTabFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const tab = urlParams.get('tab') || 'profile';
            const subtab = urlParams.get('subtab') || null;
            return { tab, subtab };
        }
        
        // ✅ FIX ISSUE 3: Update switchTab to preserve subtab in URL
        function switchTab(tabName) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.add('hidden');
            });
            
            // Remove active state from all tab buttons
            document.querySelectorAll('.tab-button').forEach(button => {
                button.classList.remove('border-primary', 'dark:border-blue-400', 'text-primary', 'dark:text-blue-400');
                button.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
            });
            
            // Show selected tab content
            const contentId = `tab-${tabName}-content`;
            const content = document.getElementById(contentId);
            if (content) {
                content.classList.remove('hidden');
            }
            
            // Activate selected tab button
            const tabId = `tab-${tabName}`;
            const tabButton = document.getElementById(tabId);
            
            if (tabButton) {
                tabButton.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
                tabButton.classList.add('border-primary', 'dark:border-blue-400', 'text-primary', 'dark:text-blue-400');
            } else {
                console.error('Tab button not found:', tabId);
            }
            
            // ✅ FIX ISSUE 3: Update URL with tab, preserve subtab if exists
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('tab', tabName);
            // Preserve subtab if it exists and we're switching to settings
            if (tabName === 'settings' && urlParams.has('subtab')) {
                // Keep existing subtab
            } else if (tabName !== 'settings') {
                // Remove subtab if switching away from settings
                urlParams.delete('subtab');
            }
            const newUrl = `/profile?${urlParams.toString()}`;
            window.history.replaceState({}, '', newUrl);
        }
        
        // ✅ FIX ISSUE 3: Update switchSettingsTab to preserve in URL
        function switchSettingsTab(tabName) {
            // Hide all settings tab contents
            document.querySelectorAll('.settings-tab-content').forEach(content => {
                content.classList.add('hidden');
            });
            
            // Remove active state from all settings tab buttons
            document.querySelectorAll('.settings-tab-btn').forEach(button => {
                button.classList.remove('border-primary', 'text-primary', 'dark:text-blue-400');
                button.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
            });
            
            // Show selected settings tab content
            const contentId = `settings-tab-${tabName}`;
            const content = document.getElementById(contentId);
            if (content) {
                content.classList.remove('hidden');
            }
            
            // Activate selected settings tab button
            const button = document.querySelector(`[data-settings-tab="${tabName}"]`);
            if (button) {
                button.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
                button.classList.add('border-primary', 'text-primary', 'dark:text-blue-400');
            }
            
            // ✅ FIX ISSUE 3: Update URL with subtab parameter
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('tab', 'settings');
            urlParams.set('subtab', tabName);
            const newUrl = `/profile?${urlParams.toString()}`;
            window.history.replaceState({}, '', newUrl);
        }
        
        // ✅ FIX 1: Define toggleEditMode and cancelEdit OUTSIDE DOMContentLoaded
        let profileFormTracker = null;
        
        function toggleEditMode() {
            const form = document.getElementById('profileForm');
            if (!form) return;

            // ✅ Global flag: ab se Edit mode ON hai
            window.__profileEditMode = true;

            const inputs = form.querySelectorAll('input, textarea');
            const editBtn = document.getElementById('editProfileBtn');
            const cancelBtn = document.getElementById('cancelBtn');
            const saveBtn = document.getElementById('saveBtn');
            const profileImageFile = document.getElementById('profileImageFile');
            
            inputs.forEach(input => {
                if (input.id !== 'email') {
                    input.removeAttribute('readonly');
                    input.classList.remove('bg-white/50', 'bg-gray-100', 'border-gray-200');
                    input.classList.add('bg-white', 'border-primary/30');
                }
            });
            
            if (profileImageFile) {
                profileImageFile.removeAttribute('readonly');
                profileImageFile.classList.remove('bg-white/50', 'border-gray-200', 'cursor-not-allowed', 'opacity-60');
                profileImageFile.classList.add('bg-white', 'border-primary/30', 'cursor-pointer', 'opacity-100');
            }
            
            if (editBtn) editBtn.classList.add('hidden');
            if (cancelBtn) cancelBtn.classList.remove('hidden');
            if (saveBtn) saveBtn.classList.remove('hidden');
            
            // ✅ Initialize dirty form tracking when entering edit mode
            if (!profileFormTracker && saveBtn) {
                import('/js/form-dirty-state.js').then(({ initDirtyForm }) => {
                    profileFormTracker = initDirtyForm('#profileForm', '#saveBtn');
                    if (profileFormTracker) {
                        profileFormTracker.update(); // Update button state
                    }
                });
            } else if (profileFormTracker) {
                profileFormTracker.update(); // Update button state
            }
        }

        function cancelEdit() {
            const form = document.getElementById('profileForm');
            if (!form) return;

            // ✅ Edit mode OFF
            window.__profileEditMode = false;

            const inputs = form.querySelectorAll('input, textarea');
            const editBtn = document.getElementById('editProfileBtn');
            const cancelBtn = document.getElementById('cancelBtn');
            const saveBtn = document.getElementById('saveBtn');
            const profileImageFile = document.getElementById('profileImageFile');
        
            inputs.forEach(input => {
                if (input.id !== 'email') {
                    input.setAttribute('readonly', 'true');
                    input.classList.add('bg-white/50', 'border-gray-200');
                    input.classList.remove('bg-white', 'border-primary/30');
                }
            });
            
            if (profileImageFile) {
                profileImageFile.setAttribute('readonly', 'true');
                profileImageFile.classList.add('bg-white/50', 'border-gray-200', 'cursor-not-allowed', 'opacity-60');
                profileImageFile.classList.remove('bg-white', 'border-primary/30', 'cursor-pointer', 'opacity-100');
                profileImageFile.value = '';
            }
            
            if (editBtn) editBtn.classList.remove('hidden');
            if (cancelBtn) cancelBtn.classList.add('hidden');
            if (saveBtn) saveBtn.classList.add('hidden');
            
            // ✅ Reset dirty form tracking when canceling
            if (profileFormTracker) {
                profileFormTracker.reset();
            }
        }

        // ✅ Make these available globally
        window.toggleEditMode = toggleEditMode;
        window.cancelEdit = cancelEdit;
        
        // ✅ FIX: Add showNotification function (required for Save button)
        function showNotification(message, type = 'success') {
            // Remove existing notification if any
            const existing = document.getElementById('profile-notification');
            if (existing) {
                existing.remove();
            }
            
            // Create notification element
            const notification = document.createElement('div');
            notification.id = 'profile-notification';
    
            // Styling based on type
            let bgClass = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
            let icon = '✅';
            
            if (type === 'error') {
                bgClass = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
                icon = '❌';
            } else if (type === 'info') {
                bgClass = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
                icon = 'ℹ️';
            }
            
            notification.className = `fixed top-20 right-4 z-50 px-6 py-4 rounded-xl shadow-2xl transition-all duration-300 transform translate-x-0 ${bgClass}`;
            
            notification.innerHTML = `
                <div class="flex items-center gap-3">
                    <span class="text-xl">${icon}</span>
                    <span class="font-semibold">${message}</span>
                </div>
            `;
            
            // Add to body
            document.body.appendChild(notification);
            
            // Animate in
            setTimeout(() => {
                notification.style.opacity = '1';
                notification.style.transform = 'translateX(0)';
            }, 10);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }
        
        // ✅ Make showNotification available globally
        window.showNotification = showNotification;
        
        // ✅ FIX ISSUE 3: Initialize on page load with URL parameters
        document.addEventListener('DOMContentLoaded', function() {
            // ✅ FIX: Get active tab and subtab from URL FIRST (before any other logic)
            const { tab, subtab } = getActiveTabFromURL();
            
            // Main tabs - Add event listeners as backup (in addition to inline onclick)
            const tabProfileBtn = document.getElementById('tab-profile');
            const tabSettingsBtn = document.getElementById('tab-settings');
            
            if (tabProfileBtn) {
                tabProfileBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    switchTab('profile');
                });
            }
            
            if (tabSettingsBtn) {
                tabSettingsBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    switchTab('settings');
                });
            }
            
            // ✅ FIX: Initialize active tab from URL (not hardcoded)
            // This ensures the tab state matches the URL on page load
            if (tab) {
                switchTab(tab); // Use tab from URL
            }
            
            // ✅ FIX: Initialize settings subtab from URL (not hardcoded to 'account')
            if (tab === 'settings') {
                const settingsSubtab = subtab || 'account'; // Default to 'account' only if no subtab in URL
                switchSettingsTab(settingsSubtab);
            } else {
                // If not on settings tab, still initialize to account (for when user switches to settings)
                // But don't call switchSettingsTab here - it will be called when user clicks settings tab
            }
            
            // Setup settings tab button listeners
            document.querySelectorAll('.settings-tab-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const tabName = this.getAttribute('data-settings-tab');
                    if (tabName) {
                        switchSettingsTab(tabName);
                    }
                });
            });
            
            // ✅ FIX: Handle browser back/forward buttons
            window.addEventListener('popstate', function() {
                const { tab, subtab } = getActiveTabFromURL();
                switchTab(tab);
                if (tab === 'settings' && subtab) {
                    switchSettingsTab(subtab);
                }
            });
            
            // ✅ FIX 1: Add event listener for Edit Profile button (instead of onclick)
            const editProfileBtn = document.getElementById('editProfileBtn');
            if (editProfileBtn) {
                editProfileBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    toggleEditMode();
                });
            }
            
            // ✅ FIX 1: Add event listener for Cancel button (instead of onclick)
            const cancelBtn = document.getElementById('cancelBtn');
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    cancelEdit();
                });
            }
            
            // Profile form submission
            const profileForm = document.getElementById('profileForm');
            if (profileForm) {
                profileForm.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    // ✅ EDIT GUARD: bina Edit mode ke submit mat hone do
                    if (!window.__profileEditMode) {
                        showNotification('Click "Edit Profile" before saving changes.', 'info');
                        return;
                    }
                    
                    const formData = new FormData();
                    const profileImageFile = document.getElementById('profileImageFile');
                    
                    formData.append('name', document.getElementById('name').value);
                    formData.append('handle', document.getElementById('handle').value);
                    formData.append('dob', document.getElementById('dob').value);
                    formData.append('bio', document.getElementById('bio').value);
                    
                    if (profileImageFile && profileImageFile.files.length > 0) {
                        formData.append('profileImageFile', profileImageFile.files[0]);
                        
                        // ✅ FIX 3: Show preview immediately
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const imageContainer = document.querySelector('.flex-shrink-0');
                            if (imageContainer) {
                                const existingImg = imageContainer.querySelector('img');
                                if (existingImg) {
                                    existingImg.src = e.target.result;
                                } else {
                                    // If no image exists, create preview
                                    const existingDiv = imageContainer.querySelector('div.flex.flex-col');
                                    if (existingDiv) {
                                        const newImg = document.createElement('img');
                                        newImg.src = e.target.result;
                                        newImg.alt = 'Profile';
                                        newImg.className = 'w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-gray-800';
                                        newImg.loading = 'lazy';
                                        existingDiv.insertBefore(newImg, existingDiv.firstChild);
                                    } else {
                                        imageContainer.innerHTML = `
                                            <div class="flex flex-col items-start space-y-3">
                                                <img src="${e.target.result}" alt="Profile" class="w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-gray-800" loading="lazy">
                                                <button type="button" id="removeProfileImageBtn" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-red-300 text-red-600 bg-red-50 hover:bg-red-100 dark:border-red-700 dark:text-red-300 dark:bg-red-900/30 dark:hover:bg-red-900/50 transition-colors">
                                                    Remove Photo
                                                </button>
                                            </div>
                                        `;
                                        // Re-attach remove button listener
                                        attachRemoveButtonListener();
                                    }
                                }
                            }
                        };
                        reader.readAsDataURL(profileImageFile.files[0]);
                    }
                    
                    try {
                        const response = await fetch('/api/profile/update', {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'X-CSRF-Token': '<%= csrfToken %>'
                            },
                            body: formData
                        });
                        
                        const result = await response.json();
                        
                        if (response.ok) {
                            showNotification('Profile updated successfully!', 'success');
                            // ✅ Reset dirty form tracking after successful save
                            if (profileFormTracker) {
                                profileFormTracker.reset();
                            }
                            // ✅ FIX 3: Reload after short delay to show updated image
                            setTimeout(() => {
                                window.location.reload();
                            }, 1500);
                        } else {
                            showNotification(result.error || 'Failed to update profile', 'error');
                             // ✅ Clear previous field errors
                            ['name','handle','dob','bio'].forEach((field) => {
                                const el = document.getElementById(field + 'Error');
                                if (el) {
                                    el.textContent = '';
                                    el.classList.add('hidden');
                                }
                            });

                            // 1) Special case: handle already taken
                            if (result.error === 'Handle already taken') {
                                const el = document.getElementById('handleError');
                                if (el) {
                                    el.textContent = 'This username is already taken.';
                                    el.classList.remove('hidden');
                                }
                                showNotification('Username is already taken', 'error');
                                return;
                            }

                            // 1.b) Special case: handle cooldown (45 days)
                            if (result.error && result.error.includes('You can change your username again in')) {
                                const el = document.getElementById('handleError');
                                if (el) {
                                    el.textContent = result.error;
                                    el.classList.remove('hidden');
                                }
                                showNotification(result.error, 'error');
                                return;
                            }

                            // 2) Zod validation errors (details[])
                            if (result.details && Array.isArray(result.details)) {
                                result.details.forEach((err) => {
                                    const field = err.path && err.path[0];
                                    if (!field) return;
                                    const el = document.getElementById(field + 'Error');
                                    if (el) {
                                        el.textContent = err.message || 'Invalid value';
                                        el.classList.remove('hidden');
                                    }
                                });
                                showNotification(result.error || 'Please fix the highlighted fields', 'error');
                                return;
                            }

                            // 3) Fallback generic error
                            showNotification(result.error || 'Failed to update profile', 'error');
                        }
                    } catch (error) {
                        console.error('Profile update error:', error);
                        showNotification('Network error. Please try again.', 'error');
                    }
                });
            }

            // ✅ FIX 2: Handle file input change to show preview
            const profileImageFile = document.getElementById('profileImageFile');
            if (profileImageFile) {
                profileImageFile.addEventListener('change', function(e) {
                    if (e.target.files.length > 0) {
                        // ✅ FIX 3: Show preview immediately
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const imageContainer = document.querySelector('.flex-shrink-0');
                            if (imageContainer) {
                                const existingImg = imageContainer.querySelector('img');
                                if (existingImg) {
                                    existingImg.src = e.target.result;
                                } else {
                                    // If no image exists, create preview
                                    const existingDiv = imageContainer.querySelector('div.flex.flex-col');
                                    if (existingDiv) {
                                        const newImg = document.createElement('img');
                                        newImg.src = e.target.result;
                                        newImg.alt = 'Profile';
                                        newImg.className = 'w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-gray-800';
                                        newImg.loading = 'lazy';
                                        existingDiv.insertBefore(newImg, existingDiv.firstChild);
                                    } else {
                                        imageContainer.innerHTML = `
                                            <div class="flex flex-col items-start space-y-3">
                                                <img src="${e.target.result}" alt="Profile" class="w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-gray-800" loading="lazy">
                                                <button type="button" id="removeProfileImageBtn" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-red-300 text-red-600 bg-red-50 hover:bg-red-100 dark:border-red-700 dark:text-red-300 dark:bg-red-900/30 dark:hover:bg-red-900/50 transition-colors">
                                                    Remove Photo
                                                </button>
                                            </div>
                                        `;
                                        // Re-attach remove button listener
                                        attachRemoveButtonListener();
                                    }
                                }
                            }
                        };
                        reader.readAsDataURL(e.target.files[0]);
                    }
                });
            }

            // ✅ Helper function to attach remove button listener
            function attachRemoveButtonListener() {
                const removeBtn = document.getElementById('removeProfileImageBtn');
                if (removeBtn && !removeBtn.hasAttribute('data-listener-attached')) {
                    removeBtn.setAttribute('data-listener-attached', 'true');
                    removeBtn.addEventListener('click', async function(e) {
                        e.preventDefault();
                        if (!confirm('Remove your profile picture?')) return;

                        try {
                            const response = await fetch('/api/profile/update', {
                                method: 'POST',
                                credentials: 'include',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-Token': '<%= csrfToken %>'
                                },
                                body: JSON.stringify({ profileImage: null })
                            });

                            const result = await response.json();

                            if (response.ok && result.success) {
                                showNotification('Profile image removed.', 'success');
                                setTimeout(() => window.location.reload(), 1000);
                            } else {
                                showNotification(result.error || 'Failed to remove profile image', 'error');
                            }
                        } catch (err) {
                            console.error('Remove profile image error:', err);
                            showNotification('Network error. Please try again.', 'error');
                        }
                    });
                }
            }

            // ✅ Remove profile image button (initial attachment)
            attachRemoveButtonListener();
        
            // ===== Account & Security – Change Password =====
            const showChangePasswordBtn = document.getElementById('showChangePasswordBtn');
            const changePasswordFormContainer = document.getElementById('changePasswordFormContainer');
            const changePasswordForm = document.getElementById('changePasswordForm');
            const cancelChangePasswordBtn = document.getElementById('cancelChangePasswordBtn');

            if (showChangePasswordBtn && changePasswordFormContainer) {
                showChangePasswordBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    changePasswordFormContainer.classList.remove('hidden');
                    const currentInput = document.getElementById('currentPassword');
                    if (currentInput) currentInput.focus();
                });
            }

            if (cancelChangePasswordBtn && changePasswordFormContainer && changePasswordForm) {
                cancelChangePasswordBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    changePasswordFormContainer.classList.add('hidden');
                    changePasswordForm.reset();
                });
            }

            // Helper for password show/hide toggles
            function setupPasswordToggle(inputId, buttonId, eyeClosedId, eyeOpenId) {
                const input = document.getElementById(inputId);
                const btn = document.getElementById(buttonId);
                const eyeClosed = document.getElementById(eyeClosedId);
                const eyeOpen = document.getElementById(eyeOpenId);
                if (!input || !btn || !eyeClosed || !eyeOpen) return;

                btn.addEventListener('click', () => {
                    const isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    eyeClosed.classList.toggle('hidden', !isHidden);
                    eyeOpen.classList.toggle('hidden', isHidden);
                });
            }

            // Eye toggles for 3 password fields
            setupPasswordToggle('currentPassword', 'toggleCurrentPassword', 'currentPasswordEyeClosed', 'currentPasswordEyeOpen');
            setupPasswordToggle('newPassword', 'toggleNewPassword', 'newPasswordEyeClosed', 'newPasswordEyeOpen');
            setupPasswordToggle('confirmPassword', 'toggleConfirmPassword', 'confirmPasswordEyeClosed', 'confirmPasswordEyeOpen');

            if (changePasswordForm) {
                changePasswordForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const currentPassword = document.getElementById('currentPassword').value.trim();
                    const newPassword = document.getElementById('newPassword').value.trim();
                    const confirmPassword = document.getElementById('confirmPassword').value.trim();

                    if (!currentPassword || !newPassword || !confirmPassword) {
                        showNotification('Please fill all password fields.', 'error');
                        return;
                    }
                    if (newPassword !== confirmPassword) {
                        showNotification('New password and confirm password do not match.', 'error');
                        return;
                    }

                    try {
                        const res = await fetch('/api/auth/change-password', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': '<%= csrfToken %>'
                            },
                            credentials: 'include',
                            body: JSON.stringify({ currentPassword, newPassword })
                        });
                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            showNotification(data.error || 'Failed to change password', 'error');
                            return;
                        }
                        showNotification('Password changed successfully.', 'success');
                        changePasswordForm.reset();
                        changePasswordFormContainer.classList.add('hidden');
                    } catch (err) {
                        console.error('Change password error:', err);
                        showNotification('Network error. Please try again.', 'error');
                    }
                });
            }

            // ===== Account Management – Export Data =====
            const exportDataBtn = document.getElementById('exportDataBtn');
            if (exportDataBtn) {
                exportDataBtn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    try {
                        // Trigger download in a new tab
                        window.open('/api/user/export-data', '_blank');
                        showNotification('Export started. If download does not start, please check pop‑up blocker.', 'info');
                    } catch (err) {
                        console.error('Export data error:', err);
                        showNotification('Failed to start export. Please try again.', 'error');
                    }
                });
            }

            // ===== Account Management – Delete Account =====
            const deleteAccountBtn = document.getElementById('deleteAccountBtn');
            if (deleteAccountBtn) {
                deleteAccountBtn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const c1 = confirm('This will permanently delete your account and all data. Continue?');
                    if (!c1) return;
                    const c2 = confirm('Last confirm. Are you absolutely sure?');
                    if (!c2) return;

                    const password = prompt('Optional: enter your password to confirm (leave blank if you signed up with OTP only).') || undefined;

                    try {
                        const res = await fetch('/api/user/account', {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': '<%= csrfToken %>'
                            },
                            credentials: 'include',
                            body: JSON.stringify({ password })
                        });
                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            showNotification(data.error || 'Failed to delete account', 'error');
                            return;
                        }
                        showNotification('Account deleted successfully. Redirecting...', 'success');
                        setTimeout(() => {
                            window.location.href = '/auth';
                        }, 1500);
                    } catch (err) {
                        console.error('Delete account error:', err);
                        showNotification('Network error. Please try again.', 'error');
                    }
                });
            }
            
            // ✅ FIX ISSUE 3: Privacy settings form - preserve tab on reload
            const privacySettingsForm = document.getElementById('privacySettingsForm');
            if (privacySettingsForm) {
                privacySettingsForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    // ... existing form submission code ...
                    
                    try {
                        const response = await fetch('/api/twin/privacy-settings', {
                            method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    credentials: 'include',
                            body: JSON.stringify(settings)
                });
                
                const result = await response.json();
                
                        if (response.ok && result.success) {
                            showNotification('Privacy settings updated successfully!', 'success');
                            
                            // ✅ FIX ISSUE 3: Preserve current tab/subtab on reload
                            const urlParams = new URLSearchParams(window.location.search);
                            const currentTab = urlParams.get('tab') || 'profile';
                            const currentSubtab = urlParams.get('subtab') || 'privacy';
                            
                            let reloadUrl = `/profile?tab=${currentTab}`;
                            if (currentSubtab) {
                                reloadUrl += `&subtab=${currentSubtab}`;
                            }
                            
                            setTimeout(() => {
                                window.location.href = reloadUrl; // Preserve URL params
                            }, 1500);
                    } else {
                            showNotification(result.error || 'Failed to update privacy settings', 'error');
                }
            } catch (error) {
                        console.error('Privacy settings update error:', error);
                        showNotification('Network error. Please try again.', 'error');
                    }
                });
            }
        });

            // ✅ FIX: Privacy settings change detection and button enable/disable
            const savePrivacyBtn = document.getElementById('savePrivacySettingsBtn');
            const privacyToggles = document.querySelectorAll('.privacy-toggle');
            
            // Get twinId from EJS (passed from backend)
            const currentTwinId = '<%= typeof twinId !== "undefined" && twinId ? twinId : "" %>';
            
            if (!currentTwinId) {
                console.error('Twin ID not found');
                if (savePrivacyBtn) {
                    savePrivacyBtn.disabled = true;
                    savePrivacyBtn.textContent = 'No Twin Found';
                }
            }
            
            // Store initial values
            const initialValues = {
                showChatHistory: document.getElementById('showChatHistory')?.checked ?? true,
                requireLogin: document.getElementById('requireLogin')?.checked ?? false,
                blockNonLoggedUsers: document.getElementById('blockNonLoggedUsers')?.checked ?? false,
                allowLikes: document.getElementById('allowLikes')?.checked ?? true,
                allowFollows: document.getElementById('allowFollows')?.checked ?? true
            };
            
            // Function to check if values changed
            function checkForChanges() {
                if (!currentTwinId) return; // Don't enable if no twinId
                
                const currentValues = {
                    showChatHistory: document.getElementById('showChatHistory')?.checked ?? true,
                    requireLogin: document.getElementById('requireLogin')?.checked ?? false,
                    blockNonLoggedUsers: document.getElementById('blockNonLoggedUsers')?.checked ?? false,
                    allowLikes: document.getElementById('allowLikes')?.checked ?? true,
                    allowFollows: document.getElementById('allowFollows')?.checked ?? true
                };
                
                const hasChanges = 
                    currentValues.showChatHistory !== initialValues.showChatHistory ||
                    currentValues.requireLogin !== initialValues.requireLogin ||
                    currentValues.blockNonLoggedUsers !== initialValues.blockNonLoggedUsers ||
                    currentValues.allowLikes !== initialValues.allowLikes ||
                    currentValues.allowFollows !== initialValues.allowFollows;
                
                if (hasChanges && savePrivacyBtn) {
                    // Enable button - change color and make clickable
                    savePrivacyBtn.disabled = false;
                    savePrivacyBtn.classList.remove('bg-gray-400', 'cursor-not-allowed');
                    savePrivacyBtn.classList.add('bg-gradient-to-r', 'from-green-500', 'to-emerald-500', 'hover:from-green-600', 'hover:to-emerald-600', 'cursor-pointer', 'shadow-lg', 'hover:shadow-xl', 'transform', 'hover:scale-105');
                } else if (savePrivacyBtn) {
                    // Disable button - gray and not clickable
                    savePrivacyBtn.disabled = true;
                    savePrivacyBtn.classList.remove('bg-gradient-to-r', 'from-green-500', 'to-emerald-500', 'hover:from-green-600', 'hover:to-emerald-600', 'cursor-pointer', 'shadow-lg', 'hover:shadow-xl', 'transform', 'hover:scale-105');
                    savePrivacyBtn.classList.add('bg-gray-400', 'cursor-not-allowed');
                }
            }
            
            // Add change listeners to all privacy toggles
            privacyToggles.forEach(toggle => {
                toggle.addEventListener('change', checkForChanges);
            });

                        // ✅ FIX: Theme toggle button functionality
                        const themeToggleBtn = document.getElementById('themeToggleBtn');
            const themeIconSun = document.getElementById('themeIconSun');
            const themeIconMoon = document.getElementById('themeIconMoon');
            
            function updateThemeIcons() {
                const currentTheme = localStorage.getItem('theme') || 'light';
                if (currentTheme === 'dark') {
                    if (themeIconSun) themeIconSun.classList.remove('hidden');
                    if (themeIconMoon) themeIconMoon.classList.add('hidden');
                } else {
                    if (themeIconSun) themeIconSun.classList.add('hidden');
                    if (themeIconMoon) themeIconMoon.classList.remove('hidden');
                }
            }
            
            function toggleTheme() {
                const currentTheme = localStorage.getItem('theme') || 'light';
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                localStorage.setItem('theme', newTheme);
                
                if (newTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                
                updateThemeIcons();
            }
            
            if (themeToggleBtn) {
                // Set initial icon state
                updateThemeIcons();
                
                // Add click listener
                themeToggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    toggleTheme();
                });
            }
            
            // Initial check (button should be disabled if no changes)
            checkForChanges();
            
            // ✅ FIX: Add click handler to save button with CORRECT endpoint and format
            if (savePrivacyBtn && currentTwinId) {
                savePrivacyBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    
                    // Don't proceed if button is disabled
                    if (savePrivacyBtn.disabled || !currentTwinId) {
                        return;
                    }
                    
                    // Disable button during submission
                    savePrivacyBtn.disabled = true;
                    const originalText = savePrivacyBtn.textContent;
                    savePrivacyBtn.textContent = 'Saving...';
                    
                    try {
                        const settings = {
                            showChatHistory: document.getElementById('showChatHistory')?.checked ?? true,
                            requireLogin: document.getElementById('requireLogin')?.checked ?? false,
                            blockNonLoggedUsers: document.getElementById('blockNonLoggedUsers')?.checked ?? false,
                            allowLikes: document.getElementById('allowLikes')?.checked ?? true,
                            allowFollows: document.getElementById('allowFollows')?.checked ?? true
                        };
                        
                        // ✅ FIX: Use correct endpoint and method
                        const response = await fetch('/api/privacy/settings', {
                            method: 'PUT',  // ✅ Changed from POST to PUT
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': '<%= csrfToken %>'
                            },
                            credentials: 'include',
                            body: JSON.stringify({
                                twinId: currentTwinId,  // ✅ Add twinId to request body
                                settings: settings      // ✅ Wrap settings in settings object
                            })
                        });
                        
                        // ✅ FIX: Check if response is JSON before parsing
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            const text = await response.text();
                            console.error('Non-JSON response:', text.substring(0, 200));
                            throw new Error(`Server returned ${response.status}: ${response.statusText}`);
                        }
                        
                        const result = await response.json();
                        
                        if (response.ok && result.success) {
                            showNotification('Privacy settings updated successfully!', 'success');
                            
                            // Update initial values to current values (so button disables again)
                            Object.assign(initialValues, settings);
                            checkForChanges(); // This will disable the button again
                            
                            // ✅ FIX ISSUE 3: Preserve current tab/subtab on reload
                            const urlParams = new URLSearchParams(window.location.search);
                            const currentTab = urlParams.get('tab') || 'profile';
                            const currentSubtab = urlParams.get('subtab') || 'privacy';
                            
                            let reloadUrl = `/profile?tab=${currentTab}`;
                            if (currentSubtab) {
                                reloadUrl += `&subtab=${currentSubtab}`;
                            }
                            
                            setTimeout(() => {
                                window.location.href = reloadUrl; // Preserve URL params
                            }, 1500);
                        } else {
                            showNotification(result.error || 'Failed to update privacy settings', 'error');
                            // Re-enable button on error
                            checkForChanges();
                        }
                    } catch (error) {
                        console.error('Privacy settings update error:', error);
                        showNotification(error.message || 'Network error. Please try again.', 'error');
                        // Re-enable button on error
                        checkForChanges();
                    } finally {
                        savePrivacyBtn.textContent = originalText;
                    }
                });
            }    
            
                    // ✅ BLOCKED USERS: Load + Block + Unblock logic
        (function initBlockedUsers() {
            const currentTwinId = '<%= typeof twinId !== "undefined" && twinId ? twinId : "" %>';
            const blockedUsersList = document.getElementById('blockedUsersList');
            const blockUserBtn = document.getElementById('blockUserBtn');

            if (!currentTwinId || !blockedUsersList || !blockUserBtn) {
                return; // No twin / no UI → nothing to do
            }

            // Render blocked users in the list
            function renderBlockedUsers(users) {
                blockedUsersList.innerHTML = '';

                if (!users || users.length === 0) {
                    blockedUsersList.innerHTML = `
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                            No users are blocked yet.
                        </p>
                    `;
                    return;
                }

                users.forEach(user => {
                    const item = document.createElement('div');
                    item.className = 'flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-800/60 rounded-lg border border-gray-200 dark:border-gray-700';

                    const name = user.name || '';
                    const handle = user.handle ? `@${user.handle}` : '';
                    const label = (handle && name) ? `${handle} (${name})` : (handle || name || 'Unknown user');

                    item.innerHTML = `
                        <div class="flex flex-col">
                            <span class="text-sm font-medium text-gray-900 dark:text-white">${label}</span>
                        </div>
                        <button 
                            type="button"
                            class="text-xs px-3 py-1 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                            data-unblock-user-id="${user.id}"
                        >
                            Unblock
                        </button>
                    `;

                    blockedUsersList.appendChild(item);
                });
            }

            // Load blocked users from backend
            async function loadBlockedUsers() {
                try {
                    const response = await fetch(`/api/privacy/settings/${currentTwinId}`, {
                        credentials: 'include'
                    });

                    const data = await response.json();
                    if (response.ok && data.success && data.settings) {
                        renderBlockedUsers(data.settings.blockedUsers || []);
                    } else {
                        console.error('Failed to load blocked users:', data);
                        blockedUsersList.innerHTML = `
                            <p class="text-sm text-red-500">
                                Failed to load blocked users.
                            </p>
                        `;
                    }
                } catch (error) {
                    console.error('Error loading blocked users:', error);
                    blockedUsersList.innerHTML = `
                        <p class="text-sm text-red-500">
                            Failed to load blocked users.
                        </p>
                    `;
                }
            }

            // Handle "Block User" click
            blockUserBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                if (!currentTwinId) return;

                const input = prompt('Enter the handle or email of the user you want to block:');
                if (!input || !input.trim()) {
                    return;
                }

                const payload = {
                    twinId: currentTwinId,
                    userHandle: input.trim()   // backend will resolve handle/email → userId
                };

                try {
                    const response = await fetch('/api/privacy/block', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': '<%= csrfToken %>'
                        },
                        credentials: 'include',
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        showNotification('User blocked successfully.', 'success');
                        await loadBlockedUsers();
                    } else {
                        showNotification(data.error || 'Failed to block user.', 'error');
                    }
                } catch (error) {
                    console.error('Block user error:', error);
                    showNotification('Network error. Please try again.', 'error');
                }
            });

            // Handle "Unblock" clicks inside the list (event delegation)
            blockedUsersList.addEventListener('click', async function (e) {
                const btn = e.target.closest('button[data-unblock-user-id]');
                if (!btn) return;

                e.preventDefault();
                const userId = btn.getAttribute('data-unblock-user-id');
                if (!userId) return;

                if (!confirm('Unblock this user?')) return;

                try {
                    const response = await fetch('/api/privacy/unblock', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': '<%= csrfToken %>'
                        },
                        credentials: 'include',
                        body: JSON.stringify({ twinId: currentTwinId, userId })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        showNotification('User unblocked successfully.', 'success');
                        await loadBlockedUsers();
                    } else {
                        showNotification(data.error || 'Failed to unblock user.', 'error');
                    }
                } catch (error) {
                    console.error('Unblock user error:', error);
                    showNotification('Network error. Please try again.', 'error');
                }
            });

            // Initial load
            loadBlockedUsers();
        })();
        
        // ✅ Make Twin Public handler - uses user.handle automatically
        const makeTwinPublicBtn = document.getElementById('makeTwinPublicBtn');
        if (makeTwinPublicBtn) {
            makeTwinPublicBtn.addEventListener('click', async function(e) {
                e.preventDefault();
                
                const currentTwinId = '<%= typeof twinId !== "undefined" && twinId ? twinId : "" %>';
                if (!currentTwinId) {
                    showNotification('Twin ID not found', 'error');
                    return;
                }
                
                console.log('Making twin public with ID:', currentTwinId);
                
                const bio = document.getElementById('publicBio')?.value || '';
                
                // Disable button during submission
                makeTwinPublicBtn.disabled = true;
                const originalText = makeTwinPublicBtn.textContent;
                makeTwinPublicBtn.textContent = 'Making Public...';
                
                try {
                    const response = await fetch('/api/public-twin/make-public', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': '<%= csrfToken %>'
                        },
                        credentials: 'include',
                        body: JSON.stringify({
                            twinId: currentTwinId,
                            bio: bio
                        })
                    });
                    
                    const result = await response.json();
                    console.log('Make public response:', result);
                    
                    if (response.ok && result.success) {
                        showNotification('Twin made public successfully!', 'success');
                        // ✅ Force page reload to show updated status
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showNotification(result.error || result.message || 'Failed to make twin public', 'error');
                        makeTwinPublicBtn.disabled = false;
                        makeTwinPublicBtn.textContent = originalText;
                    }
                } catch (error) {
                    console.error('Make twin public error:', error);
                    showNotification('Network error. Please try again.', 'error');
                    makeTwinPublicBtn.disabled = false;
                    makeTwinPublicBtn.textContent = originalText;
                }
            });
        }

        // ✅ Copy Public Link handler
const copyPublicLinkBtn = document.getElementById('copyPublicLinkBtn');
if (copyPublicLinkBtn) {
  copyPublicLinkBtn.addEventListener('click', async function (e) {
    e.preventDefault();

    const publicLinkInput = document.getElementById('publicLinkInput');
    if (!publicLinkInput) {
      showNotification('Public link not found', 'error');
      return;
    }

    const url = window.location.origin + publicLinkInput.value;
    try {
      await navigator.clipboard.writeText(url);
      showNotification('Profile link copied to clipboard!', 'success');
    } catch (error) {
      console.error('Copy to clipboard error:', error);
      showNotification('Failed to copy link. Please copy manually: ' + url, 'error');
    }
  });
}

// ✅ Make Twin Private handler
const makeTwinPrivateBtn = document.getElementById('makeTwinPrivateBtn');
if (makeTwinPrivateBtn) {
  makeTwinPrivateBtn.addEventListener('click', async function (e) {
    e.preventDefault();

    const currentTwinId = '<%= typeof twinId !== "undefined" && twinId ? twinId : "" %>';
    if (!currentTwinId) {
      showNotification('Twin ID not found', 'error');
      return;
    }

    if (!confirm('Are you sure you want to make your twin private? Others will no longer be able to discover it.')) {
      return;
    }

    makeTwinPrivateBtn.disabled = true;
    const originalText = makeTwinPrivateBtn.textContent;
    makeTwinPrivateBtn.textContent = 'Making Private...';

    try {
      const response = await fetch('/api/public-twin/make-private', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        credentials: 'include',
        body: JSON.stringify({ twinId: currentTwinId })
      });

      const result = await response.json();
      console.log('Make private response:', result);

      if (response.ok && result.success) {
        showNotification('Twin made private successfully!', 'success');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showNotification(result.error || result.message || 'Failed to make twin private', 'error');
        makeTwinPrivateBtn.disabled = false;
        makeTwinPrivateBtn.textContent = originalText;
      }
    } catch (error) {
      console.error('Make twin private error:', error);
      showNotification('Network error. Please try again.', 'error');
      makeTwinPrivateBtn.disabled = false;
      makeTwinPrivateBtn.textContent = originalText;
    }
  });
}

// ✅ FIX: File change -> preview + immediate backend upload
const profileImageFile = document.getElementById('profileImageFile');
if (profileImageFile) {
    profileImageFile.addEventListener('change', function(e) {
        if (e.target.files.length > 0) {
            const file = e.target.files[0];

            // --- existing preview logic (ye wala part as-is rehne do) ---
            const reader = new FileReader();
            reader.onload = function(e2) {
                const imageContainer = document.querySelector('.flex-shrink-0');
                if (imageContainer) {
                    const existingImg = imageContainer.querySelector('img');
                    if (existingImg) {
                        existingImg.src = e2.target.result;
                    } else {
                        const existingDiv = imageContainer.querySelector('div.flex.flex-col');
                        if (existingDiv) {
                            const newImg = document.createElement('img');
                            newImg.src = e2.target.result;
                            newImg.alt = 'Profile';
                            newImg.className = 'w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-gray-800';
                            newImg.loading = 'lazy';
                            existingDiv.insertBefore(newImg, existingDiv.firstChild);
                        } else {
                            imageContainer.innerHTML = `
                                <div class="flex flex-col items-start space-y-3">
                                    <img src="${e2.target.result}" alt="Profile" class="w-24 h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-gray-800" loading="lazy">
                                    <button type="button" id="removeProfileImageBtn" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-red-300 text-red-600 bg-red-50 hover:bg-red-100 dark:border-red-700 dark:text-red-300 dark:bg-red-900/30 dark:hover:bg-red-900/50 transition-colors">
                                        Remove Photo
                                    </button>
                                </div>
                            `;
                            // existing helper call
                            attachRemoveButtonListener();
                        }
                    }
                }
            };
            reader.readAsDataURL(file);
            // --- preview part yahi tak ---

            // --- ✅ NEW: immediately persist to backend via /upload ---
            const uploadFormData = new FormData();
            uploadFormData.append('profileImage', file); // NOTE: backend uploadController expects 'profileImage'

            fetch('/api/profile/upload', {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: uploadFormData
            })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    // backend already updated User.profileImage
                    showNotification('Profile photo saved!', 'success');
                } else {
                    showNotification(data.error || 'Failed to save profile photo', 'error');
                }
            })
            .catch(err => {
                console.error('Profile image upload error:', err);
                showNotification('Failed to upload image. Please try again.', 'error');
            });
        }
    });
}

    </script>

