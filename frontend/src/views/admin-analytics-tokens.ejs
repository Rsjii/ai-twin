<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://unpkg.com/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script src="/utils/timeUtils.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .token-card { transition: all 0.3s ease; }
        .token-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/analytics" class="text-xl font-bold text-gray-900">← Back to Analytics</a>
                    <span class="ml-4 px-3 py-1 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">Tokens</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <img src="<%= user.profileImage || '/uploads/profiles/default.jpg' %>" alt="Profile" class="w-8 h-8 rounded-full" loading="lazy">
                        <span class="text-sm font-medium text-gray-700"><%= user.handle || user.email %></span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Token Usage Analytics</h1>
            <p class="text-gray-600 dark:text-gray-300 mt-2">Detailed token usage tracking and analytics</p>
        </div>

        <!-- Period Filter -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6 mb-6">
            <div class="flex flex-wrap gap-2">
                <button onclick="loadTokenAnalytics('day')" class="period-btn px-4 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700">Today</button>
                <button onclick="loadTokenAnalytics('week')" class="period-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300">7 Days</button>
                <button onclick="loadTokenAnalytics('month')" class="period-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300">30 Days</button>
            </div>
        </div>

        <!-- Summary Cards -->
        <div id="summaryCards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-indigo-100 rounded-lg">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Tokens</p>
                        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white" id="totalTokens">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-blue-100 rounded-lg">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Input Tokens</p>
                        <p class="text-2xl font-bold text-gray-900" id="totalInputTokens">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-green-100 rounded-lg">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Output Tokens</p>
                        <p class="text-2xl font-bold text-gray-900" id="totalOutputTokens">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-purple-100 rounded-lg">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Avg per Message</p>
                        <p class="text-2xl font-bold text-gray-900" id="avgTokensPerMessage">-</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <input type="text" id="userIdFilter" placeholder="Filter by User ID (optional)" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                    </div>
                    <div class="flex-1">
                        <input type="text" id="chatIdFilter" placeholder="Filter by Chat ID (optional)" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                    </div>
                    <button onclick="applyFilters()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Apply Filters</button>
                    <button onclick="clearFilters()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Clear</button>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Daily Breakdown Chart -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Daily Token Usage (Last 30 Days)</h3>
                <div class="chart-container" style="position: relative; height: 300px;">
                    <canvas id="dailyChart"></canvas>
                </div>
            </div>

            <!-- Top Users Chart -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Users by Token Usage</h3>
                <div class="chart-container" style="position: relative; height: 300px;">
                    <canvas id="topUsersChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Per User Summary -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 mb-8">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Per User Summary</h3>
            </div>
            <div id="perUserSummary" class="divide-y divide-gray-200">
                <div class="p-6 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                    <p class="text-gray-600 mt-4">Loading...</p>
                </div>
            </div>
        </div>

        <!-- Per Chat Summary -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 mb-8">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Per Chat Summary</h3>
            </div>
            <div id="perChatSummary" class="divide-y divide-gray-200">
                <div class="p-6 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                    <p class="text-gray-600 mt-4">Loading...</p>
                </div>
            </div>
        </div>

        <!-- Per Message Details -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Recent Token Usage (Per Message)</h3>
            </div>
            <div id="perMessageDetails" class="divide-y divide-gray-200">
                <div class="p-6 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                    <p class="text-gray-600 mt-4">Loading...</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentPeriod = 'day';
        let currentUserId = '';
        let currentChatId = '';
        let dailyChart = null;
        let topUsersChart = null;

        async function loadTokenAnalytics(period = 'day') {
            currentPeriod = period;
            
            // Update button states - FIX: Find button by text instead of event.target
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
                
                // Highlight the button matching the period
                const btnText = btn.textContent.trim().toLowerCase();
                if ((period === 'day' && btnText.includes('today')) ||
                    (period === 'week' && btnText.includes('7')) ||
                    (period === 'month' && btnText.includes('30'))) {
                    btn.classList.remove('bg-gray-200', 'text-gray-700');
                    btn.classList.add('bg-indigo-600', 'text-white');
                }
            });

            const params = new URLSearchParams({ period });
            if (currentUserId) params.append('userId', currentUserId);
            if (currentChatId) params.append('chatId', currentChatId);

            try {
                const response = await fetch(`/api/admin/analytics/tokens?${params}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();

                if (!data.success) {
                    throw new Error(data.error || 'Failed to load token analytics');
                }

                // Update summary cards
                const overall = data.summary?.overall || {};
                
                document.getElementById('totalTokens').textContent = formatNumber(overall.total_tokens || 0);
                document.getElementById('totalInputTokens').textContent = formatNumber(overall.input_tokens || 0);
                document.getElementById('totalOutputTokens').textContent = formatNumber(overall.output_tokens || 0);
                document.getElementById('avgTokensPerMessage').textContent = formatNumber(overall.avg_tokens_per_message || 0);

                // Update charts
                updateDailyChart(data.details?.daily || []);
                updateTopUsersChart(data.details?.topUsers || []);

                // Update per user summary
                updatePerUserSummary(data.summary?.perUser || []);

                // Update per chat summary
                updatePerChatSummary(data.summary?.perChat || []);

                // Update per message details
                updatePerMessageDetails(data.details?.messages || []);

            } catch (error) {
                alert('Failed to load token analytics: ' + (error.message || 'Unknown error'));
            }
        }

        function updateDailyChart(dailyData) {
            const ctx = document.getElementById('dailyChart').getContext('2d');
            if (dailyChart) dailyChart.destroy();

            dailyChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dailyData.map(d => new Date(d.date).toLocaleDateString()),
                    datasets: [{
                        label: 'Total Tokens',
                        data: dailyData.map(d => d.total_tokens),
                        borderColor: 'rgb(99, 102, 241)',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        tension: 0.4
                    }, {
                        label: 'Input Tokens',
                        data: dailyData.map(d => d.input_tokens),
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.4
                    }, {
                        label: 'Output Tokens',
                        data: dailyData.map(d => d.output_tokens),
                        borderColor: 'rgb(34, 197, 94)',
                        backgroundColor: 'rgba(34, 197, 94, 0.1)',
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        function updateTopUsersChart(topUsersData) {
            const ctx = document.getElementById('topUsersChart').getContext('2d');
            if (topUsersChart) topUsersChart.destroy();

            topUsersChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: topUsersData.map(u => `User ${u.userId?.substring(0, 8) || 'Unknown'}`),
                    datasets: [{
                        label: 'Total Tokens',
                        data: topUsersData.map(u => u.total_tokens),
                        backgroundColor: 'rgba(99, 102, 241, 0.8)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        function updatePerUserSummary(perUserData) {
            const container = document.getElementById('perUserSummary');
            if (!perUserData || perUserData.length === 0) {
                container.innerHTML = '<div class="p-6 text-center text-gray-500">No user data available</div>';
                return;
            }

            container.innerHTML = perUserData.map(user => `
                <div class="p-4 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="font-medium text-gray-900 dark:text-white">User: ${user.userId || 'Unknown'}</p>
                            <p class="text-sm text-gray-600 dark:text-gray-400">${user.message_count || 0} messages</p>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-indigo-600">${formatNumber(user.total_tokens || 0)} tokens</p>
                            <p class="text-xs text-gray-500">${formatNumber(user.input_tokens || 0)} in / ${formatNumber(user.output_tokens || 0)} out</p>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function updatePerChatSummary(perChatData) {
            const container = document.getElementById('perChatSummary');
            if (!perChatData || perChatData.length === 0) {
                container.innerHTML = '<div class="p-6 text-center text-gray-500">No chat data available</div>';
                return;
            }

            container.innerHTML = perChatData.map(chat => `
                <div class="p-4 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="font-medium text-gray-900 dark:text-white">Chat: ${chat.chat_id || 'Unknown'}</p>
                            <p class="text-sm text-gray-600 dark:text-gray-400">${chat.message_count || 0} messages</p>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-indigo-600">${formatNumber(chat.total_tokens || 0)} tokens</p>
                            <p class="text-xs text-gray-500">${formatNumber(chat.input_tokens || 0)} in / ${formatNumber(chat.output_tokens || 0)} out</p>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function updatePerMessageDetails(messagesData) {
            const container = document.getElementById('perMessageDetails');
            if (!messagesData || messagesData.length === 0) {
                container.innerHTML = '<div class="p-6 text-center text-gray-500">No message data available</div>';
                return;
            }

            container.innerHTML = messagesData.map(msg => `
                <div class="p-4 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <p class="text-sm text-gray-500">${new Date(msg.createdAt).toLocaleString()}</p>
                            <p class="font-medium text-gray-900 dark:text-white">Message ID: ${msg.message_id || 'N/A'}</p>
                            <p class="text-xs text-gray-600 dark:text-gray-400">
                                Mode: ${msg.mode || 'N/A'} | 
                                Chat: ${msg.chat_id?.substring(0, 8) || 'N/A'} | 
                                ${msg.reason ? `<span class="text-red-600">Blocked: ${msg.reason}</span>` : ''}
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-indigo-600">${formatNumber(msg.total_tokens || 0)} tokens</p>
                            <p class="text-xs text-gray-500">${formatNumber(msg.input_tokens || 0)} in / ${formatNumber(msg.output_tokens || 0)} out</p>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function applyFilters() {
            currentUserId = document.getElementById('userIdFilter').value.trim();
            currentChatId = document.getElementById('chatIdFilter').value.trim();
            loadTokenAnalytics(currentPeriod);
        }

        function clearFilters() {
            document.getElementById('userIdFilter').value = '';
            document.getElementById('chatIdFilter').value = '';
            currentUserId = '';
            currentChatId = '';
            loadTokenAnalytics(currentPeriod);
        }

        function formatNumber(num) {
            if (num >= 1000000) return (num / 1000000).toFixed(2) + 'M';
            if (num >= 1000) return (num / 1000).toFixed(2) + 'K';
            return num.toLocaleString();
        }

        // Load on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadTokenAnalytics('day');
        });
    </script>
</body>
</html>
