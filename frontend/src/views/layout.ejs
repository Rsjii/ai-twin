<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <!-- ✅ Mobile-specific meta tags -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Selflyx">
    <meta name="description" content="Create your twin that communicates in your unique style, tone, and personality">
    <meta name="theme-color" content="#6366f1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://unpkg.com">
    <!-- Favicon - Bulb Icon (Same as Landing Hero Section) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.svg?v=3">
    <title><%= title %></title>
    <!-- SEO Meta Tags -->
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
<% } else { %>
    <meta name="description" content="Create your twin that communicates in your unique style, tone, and personality">
<% } %>

<!-- Open Graph Tags -->
<meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title %>">
<meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : (typeof metaDescription !== 'undefined' ? metaDescription : 'Create your twin that communicates in your unique style') %>">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
<% } %>
<meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : (typeof baseUrl !== 'undefined' ? baseUrl + req.path : '') %>">
<meta property="og:site_name" content="Selflyx">

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title %>">
<meta name="twitter:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : (typeof metaDescription !== 'undefined' ? metaDescription : 'Create your twin') %>">
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta name="twitter:image" content="<%= ogImage %>">
<% } %>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <script src="/utils/errorHandler.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
        <%
  // ============================================
  // GLOBAL FEATURE FLAGS - Control all V2 features from here
  // ============================================
  // Set to true to enable advanced features, false for MVP
  const FEATURE_FLAGS = {
    advancedLearningUI: false,   // Big learning dashboard analytics, charts, progress, goals, milestones, templates
    memoryUI: false,             // Full memory-management UI (dashboard, categories, stats, style anchors)
    styleAnchorsUI: false,       // Style anchors tables/forms (separate from memoryUI for granular control)
    chatFeedbackUI: false,       // Thumbs up/down, regenerate, training buttons in chat
    advancedPublicAnalyticsUI: false // Any fancy charts/analytics on public side
  };
%>
    </script>
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ✅ PHASE 1: COMPLETE DARK THEME COLOR SYSTEM */
        
        /* Dark Theme CSS Variables */
        :root {
            /* Light theme colors (existing) */
            --light-bg-primary: #ffffff;
            --light-bg-secondary: #f8fafc;
            --light-text-primary: #1f2937;
            --light-text-secondary: #6b7280;
        }
        
        .dark {
            /* Dark Theme Backgrounds */
            --dark-bg-primary: #0f172a;      /* Slate 900 - Main background */
            --dark-bg-secondary: #1e293b;   /* Slate 800 - Cards, sections */
            --dark-bg-tertiary: #334155;     /* Slate 700 - Hover states */
            --dark-bg-elevated: #1e293b;     /* Elevated surfaces */
            
            /* Dark Theme Text */
            --dark-text-primary: #f1f5f9;    /* Slate 100 - Primary text */
            --dark-text-secondary: #cbd5e1;  /* Slate 300 - Secondary text */
            --dark-text-tertiary: #94a3b8;   /* Slate 400 - Tertiary text */
            --dark-text-muted: #64748b;      /* Slate 500 - Muted text */
            
            /* Dark Theme Accents - Vibrant & Glowing */
            --dark-accent-primary: #3b82f6;      /* Blue 500 */
            --dark-accent-primary-hover: #2563eb; /* Blue 600 */
            --dark-accent-secondary: #8b5cf6;    /* Purple 500 */
            --dark-accent-success: #10b981;       /* Emerald 500 */
            --dark-accent-warning: #f59e0b;      /* Amber 500 */
            --dark-accent-danger: #ef4444;        /* Red 500 */
            --dark-accent-info: #06b6d4;         /* Cyan 500 */
            
            /* Dark Theme Borders */
            --dark-border-primary: rgba(51, 65, 85, 0.5);
            --dark-border-secondary: rgba(71, 85, 105, 0.3);
            --dark-border-accent: rgba(59, 130, 246, 0.3);
        }
        
        /* Dark Theme Buttons - Enhanced with Glow */
        .dark .btn-primary,
        .dark button.bg-gradient-to-r.from-primary,
        .dark a.bg-gradient-to-r.from-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
            color: white !important;
            box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.4) !important;
            border: none !important;
        }
        
        .dark .btn-primary:hover,
        .dark button.bg-gradient-to-r.from-primary:hover,
        .dark a.bg-gradient-to-r.from-primary:hover {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
            box-shadow: 0 6px 20px 0 rgba(59, 130, 246, 0.6) !important;
        }
        
        .dark .btn-secondary,
        .dark button.bg-gradient-to-r.from-accent,
        .dark a.bg-gradient-to-r.from-accent {
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%) !important;
            color: white !important;
            box-shadow: 0 4px 14px 0 rgba(139, 92, 246, 0.4) !important;
        }
        
        .dark .btn-secondary:hover,
        .dark button.bg-gradient-to-r.from-accent:hover,
        .dark a.bg-gradient-to-r.from-accent:hover {
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%) !important;
            box-shadow: 0 6px 20px 0 rgba(139, 92, 246, 0.6) !important;
        }
        
        /* Dark Theme Cards */
        .dark .bg-white\/50,
        .dark .bg-white\/80,
        .dark .bg-white {
            background: rgba(30, 41, 59, 0.8) !important;
            border-color: rgba(51, 65, 85, 0.5) !important;
        }
        
        /* ✅ Dropdown menu must be fully opaque - override any transparency */
        #dropdownMenu {
            background: #ffffff !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
        
        .dark #dropdownMenu {
            background: #111827 !important; /* dark:bg-gray-900 - fully opaque */
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
        
        .dark .bg-white\/50:hover,
        .dark .bg-white\/80:hover {
            background: rgba(30, 41, 59, 0.95) !important;
            border-color: rgba(59, 130, 246, 0.3) !important;
            box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.2) !important;
        }
        
        /* Dark Theme Inputs */
        .dark input,
        .dark textarea,
        .dark select {
            background: #1e293b !important;
            border-color: rgba(51, 65, 85, 0.5) !important;
            color: #f1f5f9 !important;
        }
        
        .dark input:focus,
        .dark textarea:focus,
        .dark select:focus {
            border-color: rgba(59, 130, 246, 0.5) !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
        }
        
        /* Dark Theme Links */
        .dark a.text-primary,
        .dark a.hover\:text-primary:hover {
            color: #3b82f6 !important;
        }
        
        .dark a.text-primary:hover,
        .dark a.hover\:text-primary:hover {
            color: #60a5fa !important;
            text-decoration: underline;
        }
        
        /* Enhanced Dark Mode Glass Effect */
        .dark .glass-effect {
            background: rgba(17, 24, 39, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(55, 65, 81, 0.5) !important;
        }
        
        /* Dark Mode Mobile Glass */
        .dark .mobile-glass {
            background: rgba(17, 24, 39, 0.9) !important;
        }
        
        /* Dark Mode Mobile Nav */
        .dark .mobile-nav {
            background: #1e293b !important;
            border-bottom: 1px solid #334155 !important;
        }

        /* ✅ Dark Mode Support - Consolidated */
        .dark .gradient-text {
            -webkit-text-fill-color: white;
            color: white;
        }

        /* Skeleton Loader Styles */
.skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s ease-in-out infinite;
    border-radius: 4px;
}

.dark .skeleton {
    background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
    background-size: 200% 100%;
}

@keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

.skeleton-text {
    height: 1rem;
    width: 100%;
}

.skeleton-title {
    height: 1.5rem;
    width: 60%;
}

.skeleton-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
}

.skeleton-card {
    height: 200px;
    border-radius: 8px;
}

        
        /* ✅ Mobile-specific global fixes */
        * {
            -webkit-tap-highlight-color: transparent;
            -webkit-touch-callout: none;
        }
        
        html {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
            /* ✅ iOS Safari viewport height fix */
            height: -webkit-fill-available;
        }
        
        body {
            overflow-x: hidden;
            width: 100%;
            position: relative;
            /* ✅ iOS Safari viewport height fix */
            min-height: 100vh;
            min-height: -webkit-fill-available;
        }
        
        /* ✅ Mobile button touch targets */
        button, a.button, input[type="button"], input[type="submit"] {
            min-height: 44px;
            min-width: 44px;
            touch-action: manipulation;
        }
        
        /* Mobile-specific styles */
