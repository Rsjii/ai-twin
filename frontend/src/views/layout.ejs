        @media (max-width: 640px) {
            /* Mobile - Small screens */
        }
        
        @media (min-width: 641px) and (max-width: 768px) {
            /* Tablet Portrait */
        }
        
        @media (min-width: 769px) and (max-width: 1024px) {
            /* Tablet Landscape */
        }
        
        @media (min-width: 1025px) {
            /* Desktop */
        }
        
        /* Main mobile styles */
        @media (max-width: 768px) {            
            /* Touch targets */
            button, a, input, select, textarea {
                min-height: 44px;
                min-width: 44px;
            }
            
            /* Mobile-friendly spacing */
            .mobile-p-4 { padding: 1rem; }
            .mobile-p-6 { padding: 1.5rem; }
            .mobile-p-8 { padding: 2rem; }
            .mobile-m-4 { margin: 1rem; }
            .mobile-m-6 { margin: 1.5rem; }
            .mobile-m-8 { margin: 2rem; }
            
            /* Mobile text sizes */
            .mobile-text-xs { font-size: 0.75rem; }
            .mobile-text-sm { font-size: 0.875rem; }
            .mobile-text-base { font-size: 1rem; }
            .mobile-text-lg { font-size: 1.125rem; }
            .mobile-text-xl { font-size: 1.25rem; }
            .mobile-text-2xl { font-size: 1.5rem; }
            
            /* Mobile modals */
            .mobile-modal {
                margin: 1rem;
                max-height: calc(100vh - 2rem);
                overflow-y: auto;
            }
            
            /* Mobile forms */
            .mobile-form input, .mobile-form textarea, .mobile-form select {
                font-size: 16px; /* Prevents zoom on iOS */
                padding: 12px;
                border-radius: 8px;
            }
            
            /* Mobile buttons */
            .mobile-btn {
                padding: 12px 24px;
                font-size: 16px;
                border-radius: 8px;
                min-height: 44px;
            }
            
            /* Mobile cards */
            .mobile-card {
                margin: 0.5rem;
                border-radius: 12px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }
            
            /* Mobile navigation */
            .mobile-nav {
                padding: 1rem;
                background: white;
                border-bottom: 1px solid #e5e7eb;
            }
            
            /* Mobile sidebar */
            .mobile-sidebar {
                width: 280px;
                max-width: 85vw;
            }
            
            /* Mobile chat */
            .mobile-chat-container {
                height: calc(100vh - 60px);
                padding: 0.5rem;
            }
            
            /* Mobile tables */
            .mobile-table {
                font-size: 14px;
                overflow-x: auto;
            }
            
            /* Mobile scrollbars */
            .mobile-scrollbar::-webkit-scrollbar {
                width: 4px;
            }
            
            .mobile-scrollbar::-webkit-scrollbar-track {
                background: #f1f1f1;
            }
            
            .mobile-scrollbar::-webkit-scrollbar-thumb {
                background: #c1c1c1;
                border-radius: 2px;
            }
            
            /* Mobile animations */
            .mobile-fade-in {
                animation: mobileFadeIn 0.3s ease-in-out;
            }
            
            @keyframes mobileFadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
            
            /* Mobile shadows */
            .mobile-shadow {
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }
            
            /* Mobile gradients */
            .mobile-gradient {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }
            
            /* Mobile glass effect */
