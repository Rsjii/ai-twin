                <!-- Contact Information -->
                <div class="border-t border-gray-200 dark:border-gray-700 pt-8 mt-8">
                    <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Other Ways to Reach Us</h2>
