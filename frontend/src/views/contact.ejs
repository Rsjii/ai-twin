<%- include('layout', { 
  title: 'Contact Us - TwinOS', 
  user: typeof user !== 'undefined' ? user : null,
  hasTwins: typeof hasTwins !== 'undefined' ? hasTwins : false,
  twinId: typeof twinId !== 'undefined' ? twinId : null,
  csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '',
  pathname: typeof pathname !== 'undefined' ? pathname : '/contact',
  body: `
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-gray-900 p-4 sm:p-6 lg:p-8 xl:p-12">
            <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold gradient-text mb-4 text-center">Contact Us</h1>
            <p class="text-gray-600 dark:text-gray-300 text-center mb-8">We're here to help! Get in touch with our support team.</p>
            
            <div class="space-y-6">
                <!-- Contact Form -->
                <form id="contactForm" class="space-y-6">
                    <div>
                        <label for="name" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Your Name</label>
                        <input type="text" id="name" name="name" required
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]"
                            placeholder="Enter your name" aria-label="Your Name"
                            maxlength="50">
                    </div>
                    
                    <div>
                        <label for="email" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                        <input type="email" id="email" name="email" required
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]"
                            placeholder="your.email@example.com" aria-label="Email Address"
                            maxlength="254">
                    </div>
                    
                    <div>
                        <label for="subject" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Subject</label>
                        <select id="subject" name="subject" required
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px]" aria-label="Subject">
                            <option value="">Select a subject</option>
                            <option value="general">General Inquiry</option>
                            <option value="technical">Technical Support</option>
                            <option value="billing">Billing Question</option>
                            <option value="feature">Feature Request</option>
                            <option value="bug">Report a Bug</option>
                            <option value="other">Other</option>
                        </select>
                        <input
                            id="subjectOther"
                            name="subjectOther"
                            type="text"
                            class="mt-2 w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px] hidden"
                            placeholder="Please specify the subject..."
                            maxlength="100"
                        />
                        <div id="subjectOther-error" class="hidden mt-1 text-xs text-red-600 dark:text-red-400"></div>
                    </div>
                    
                    <div>
                        <label for="message" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Message</label>
                        <textarea id="message" name="message" rows="6" required
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent resize-none text-base"
                            placeholder="Tell us how we can help..." aria-label="Message"
                            maxlength="2000"></textarea>
                        <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                            <span id="contactMessageCharCount">0</span>/2000 characters
                        </div>
                    </div>
                    
                    <button type="submit" 
                        class="w-full bg-gradient-to-r from-primary to-accent text-white py-4 px-6 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold transform hover:scale-[1.02] min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Send Message">
                        Send Message
                    </button>
                </form>

                <!-- Contact Information -->
                <div class="border-t border-gray-200 dark:border-gray-700 pt-8 mt-8">
                    <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Other Ways to Reach Us</h2>
                    <div class="space-y-4">
                        <div class="flex items-start space-x-4">
                            <div class="w-12 h-12 bg-primary/10 dark:bg-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                <svg class="w-6 h-6 text-primary dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-900 dark:text-white">Email</h3>
                                <p class="text-gray-600 dark:text-gray-300">support@twinos.com</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start space-x-4">
                            <div class="w-12 h-12 bg-primary/10 dark:bg-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                <svg class="w-6 h-6 text-primary dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-900 dark:text-white">Response Time</h3>
                                <p class="text-gray-600 dark:text-gray-300">We typically respond within 24-48 hours</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="border-t border-gray-200 dark:border-gray-700 pt-8">
                    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Quick Links</h2>
                    <div class="flex flex-wrap gap-4">
                        <a href="/help-center" class="text-primary hover:text-secondary transition-colors">Help Center</a>
                        <a href="/privacy" class="text-primary hover:text-secondary transition-colors">Privacy Policy</a>
                        <a href="/terms" class="text-primary hover:text-secondary transition-colors">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
` }) %>

<script>
// ✅ Initialize contact form functionality - wait for elements to be available
(function initContactForm() {
    function setupContactForm() {
        // ✅ Character counter for contact form message
        const messageTextarea = document.getElementById('message');
        const charCount = document.getElementById('contactMessageCharCount');
        if (messageTextarea && charCount) {
            const updateCount = () => {
                const len = messageTextarea.value.length;
                charCount.textContent = len;
            };
            messageTextarea.addEventListener('input', updateCount);
            updateCount(); // Initial count
        }

        // ✅ Subject "other" field show/hide
        const subjectSelect = document.getElementById('subject');
        const subjectOther = document.getElementById('subjectOther');
        if (subjectSelect && subjectOther) {
            subjectSelect.addEventListener('change', () => {
                if (subjectSelect.value === 'other') {
                    subjectOther.classList.remove('hidden');
                    subjectOther.required = true;
                } else {
                    subjectOther.classList.add('hidden');
                    subjectOther.required = false;
                    subjectOther.value = '';
                }
            });
        }

        // ✅ Form submit handler
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                // ✅ Validate subjectOther if "other" is selected
                const subjectSelect = document.getElementById('subject');
                const subjectOther = document.getElementById('subjectOther');
                const subjectOtherError = document.getElementById('subjectOther-error');
                
                if (subjectSelect && subjectSelect.value === 'other') {
                    const otherValue = subjectOther?.value?.trim() || '';
                    if (!otherValue) {
                        if (subjectOtherError) {
                            subjectOtherError.textContent = 'Please specify the subject';
                            subjectOtherError.classList.remove('hidden');
                        }
                        if (subjectOther) {
                            subjectOther.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                            subjectOther.focus();
                        }
                        return;
                    } else {
                        if (subjectOtherError) {
                            subjectOtherError.classList.add('hidden');
                        }
                        if (subjectOther) {
                            subjectOther.classList.remove('border-red-500', 'ring-2', 'ring-red-500/20');
                        }
                    }
                }
                
                const formData = new FormData(e.target);
                const subject = formData.get('subject');
                const data = {
                    name: formData.get('name'),
                    email: formData.get('email'),
                    subject: subject === 'other' ? formData.get('subjectOther') : subject,
                    message: formData.get('message')
                };

                // ✅ Submit to backend
                const submitBtn = contactForm.querySelector('button[type="submit"]');
                const originalBtnText = submitBtn?.textContent || 'Send Message';
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Sending...';
                }

                try {
                    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || window.csrfToken;
                    const response = await fetch('/contact', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        },
                        credentials: 'include',
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        // Success
                        if (window.UI && typeof window.UI.showToast === 'function') {
                            window.UI.showToast(result.message || 'Thank you for contacting us! We will get back to you soon.', 'success');
                        } else if (typeof showNotification === 'function') {
                            showNotification(result.message || 'Thank you for contacting us! We will get back to you soon.', 'success');
                        }
                        
                        // Reset form
                        e.target.reset();
                        // Reset character counter
                        const charCount = document.getElementById('contactMessageCharCount');
                        if (charCount) charCount.textContent = '0';
                        // Hide subjectOther field after reset
                        if (subjectOther) {
                            subjectOther.classList.add('hidden');
                            subjectOther.required = false;
                        }
                        if (subjectOtherError) {
                            subjectOtherError.classList.add('hidden');
                        }
                    } else {
                        // Error
                        const errorMsg = result.error || 'Failed to submit contact form. Please try again.';
                        if (window.UI && typeof window.UI.showToast === 'function') {
                            window.UI.showToast(errorMsg, 'error');
                        } else if (typeof showNotification === 'function') {
                            showNotification(errorMsg, 'error');
                        }
                    }
                } catch (error) {
                    // Network error
                    const errorMsg = 'Network error. Please check your connection and try again.';
                    if (window.UI && typeof window.UI.showToast === 'function') {
                        window.UI.showToast(errorMsg, 'error');
                    } else if (typeof showNotification === 'function') {
                        showNotification(errorMsg, 'error');
                    }
                } finally {
                    // Re-enable button
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = originalBtnText;
                    }
                }
            });
        }
    }

    // ✅ Try to setup - use multiple strategies to ensure elements are available
    function trySetup() {
        const messageTextarea = document.getElementById('message');
        const subjectSelect = document.getElementById('subject');
        
        if (messageTextarea && subjectSelect) {
            // Elements found, setup now
            setupContactForm();
            return true;
        }
        return false;
    }

    // Strategy 1: If DOM is loading, wait for DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            if (!trySetup()) {
                // Elements not found yet, wait a bit more
                setTimeout(() => {
                    trySetup();
                }, 200);
            }
        });
    } else {
        // Strategy 2: DOM already loaded, try immediately then with delay
        if (!trySetup()) {
            // Wait for layout to render body
            setTimeout(() => {
                if (!trySetup()) {
                    // Strategy 3: Use MutationObserver as last resort
                    const observer = new MutationObserver(() => {
                        if (trySetup()) {
                            observer.disconnect();
                        }
                    });
                    observer.observe(document.body, { childList: true, subtree: true });
                    // Timeout after 5 seconds
                    setTimeout(() => {
                        observer.disconnect();
                    }, 5000);
                }
            }, 200);
        }
    }
})();
</script>

