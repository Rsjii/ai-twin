<%
const twinIdValue = typeof userTwinId !== 'undefined' && userTwinId ? userTwinId : '';
%>
<script src="https://unpkg.com/chart.js@4.4.1/dist/chart.umd.js"></script>
<%- include('layout', { 
    title: title, 
    user: user, 
    csrfToken: csrfToken, 
    body: include('partials/analytics-body'),
}) %>

<script>
    // Set twinId from server-side variable (outside template string, so EJS works)
    window.twinIdValue = '<%- twinIdValue %>';
    
    // Simplified loading state functions
    function showLoading(section) {
        const loadingEl = document.getElementById(`${section}LoadingState`);
        const containerEl = document.getElementById(`${section}Container`) || document.getElementById(section);
        const emptyEl = document.getElementById(`${section}EmptyState`);
        const errorEl = document.getElementById(`${section}ErrorState`);
        
        if (loadingEl) loadingEl.classList.remove('hidden');
        if (containerEl) containerEl.classList.add('hidden');
        if (emptyEl) emptyEl.classList.add('hidden');
        if (errorEl) errorEl.classList.add('hidden');
    }
    
    function hideLoading(section) {
        const loadingEl = document.getElementById(`${section}LoadingState`);
        if (loadingEl) loadingEl.classList.add('hidden');
    }
    
    function showEmpty(section) {
        const emptyEl = document.getElementById(`${section}EmptyState`);
        const containerEl = document.getElementById(`${section}Container`) || document.getElementById(section);
        const loadingEl = document.getElementById(`${section}LoadingState`);
        
        if (emptyEl) emptyEl.classList.remove('hidden');
        if (containerEl) containerEl.classList.add('hidden');
        if (loadingEl) loadingEl.classList.add('hidden');
    }
    
    function showError(section) {
        const errorEl = document.getElementById(`${section}ErrorState`);
        const containerEl = document.getElementById(`${section}Container`) || document.getElementById(section);
        const loadingEl = document.getElementById(`${section}LoadingState`);
        
        if (errorEl) errorEl.classList.remove('hidden');
        if (containerEl) containerEl.classList.add('hidden');
        if (loadingEl) loadingEl.classList.add('hidden');
    }
    
    // Legacy function names for compatibility
    function showOverviewLoading() { showLoading('overview'); }
    function hideOverviewLoading() { hideLoading('overview'); }
    function showOverviewEmpty() { showEmpty('overview'); }
    function showOverviewError() { showError('overview'); }
    function hideOverviewError() { document.getElementById('overviewErrorState')?.classList.add('hidden'); }
    
    function showChartLoading() { showLoading('chart'); }
    function hideChartLoading() { hideLoading('chart'); }
    function showChartEmpty() { showEmpty('chart'); }
    function showChartError() { showError('chart'); }
    
    function showTopContentLoading() { showLoading('topContent'); }
    function hideTopContentLoading() { hideLoading('topContent'); }
    function showTopContentEmpty() { showEmpty('topContent'); }
    function showTopContentError() { showError('topContent'); }
    
    function showPeriodSummaryLoading() { showLoading('periodSummary'); }
    function hidePeriodSummaryLoading() { hideLoading('periodSummary'); }
    function showPeriodSummaryEmpty() { showEmpty('periodSummary'); }
    function showPeriodSummaryError() { showError('periodSummary'); }
    
    // Debug function to check user data
    async function debugUserData() {
        try {
            const response = await fetch('/api/metrics/debug');
            const data = await response.json();
            
            if (data.success) {
                showNotification('Debug Info:\nUser: ' + (data.user?.email || 'No user') + '\nTwins: ' + (data.counts?.twins || 0) + '\nChats: ' + (data.counts?.chats || 0) + '\nEvents: ' + (data.counts?.events || 0), 'info');
            } else {
                showNotification('Debug failed: ' + data.error, 'error');
            }
        } catch (error) {
            showNotification('Debug error: ' + error.message, 'error');
        }
    }
    
    // Create sample data function
    async function createSampleData() {
        try {
            const response = await fetch('/api/metrics/create-sample', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });
            const data = await response.json();
            
            if (data.success) {
                showNotification('Sample data created successfully! Refreshing analytics...', 'success');
                loadAnalytics();
            } else {
                showNotification('Failed to create sample data: ' + data.error, 'error');
            }
        } catch (error) {
            showNotification('Error creating sample data: ' + error.message, 'error');
        }
    }
    
    async function loadAnalytics() {
    showOverviewLoading();
    showChartLoading();
    showTopContentLoading();
    showPeriodSummaryLoading();
    hideOverviewError();
    
    const elements = {
        totalViews: document.getElementById('totalViews'),
        totalLikes: document.getElementById('totalLikes'),
        totalFollowers: document.getElementById('totalFollowers'),
        totalChats: document.getElementById('totalChats'),
        positiveFeedback: document.getElementById('positiveFeedback'),
        negativeFeedback: document.getElementById('negativeFeedback'),
        satisfactionScore: document.getElementById('satisfactionScore'),
        overviewContainer: document.getElementById('overviewContainer'),
        topContent: document.getElementById('topContent'),
        periodSummary: document.getElementById('periodSummary'),
        chartContainer: document.getElementById('chartContainer')
    };

    try {
        const [response, feedbackResponse] = await Promise.all([
            fetch('/api/metrics/user', {
                method: 'GET',
                credentials: 'include',
                cache: 'no-store',
                headers: { 
                    'Cache-Control': 'no-cache',
                    'Content-Type': 'application/json',                
                },
            }),
            fetch('/api/analytics/feedback', {
                method: 'GET',
                credentials: 'include',
                cache: 'no-store',
                headers: { 
                    'Cache-Control': 'no-cache',
                    'Content-Type': 'application/json',                
                },
            })
        ]);

        // ✅ ADD: Check for errors BEFORE parsing
        if (!response.ok) {
            const errorText = await response.text();
            ErrorLogger.error('Metrics API error', new Error(`Status: ${response.status}`), { status: response.status, errorText });
            throw new Error(`Metrics API failed: ${response.status}`);
        }
        
        if (!feedbackResponse.ok) {
            ErrorLogger.warn('Feedback API error', { status: feedbackResponse.status });
            // Don't throw, just log - feedback is optional
        }

        let data = {};
        let feedbackData = {};

        // ✅ FIX: Always parse JSON, remove 304 check
        try {
            data = await response.json();
        } catch (err) {
            ErrorLogger.error('Failed to parse analytics JSON', err, {});
            showOverviewError();
            showChartError();
            return; // Exit early on parse error
        }

        try {
            feedbackData = await feedbackResponse.json();
        } catch (err) {
            // Feedback is optional, continue without it
            feedbackData = {}; // Continue without feedback data
        }

        // Overview cards
        if (data.success && data.analytics) {
            hideOverviewLoading();
            elements.overviewContainer?.classList.remove('hidden');

            const views = Number.isInteger(data.analytics.totalViews) ? data.analytics.totalViews : 0;
            const likes = Number.isInteger(data.analytics.totalLikes) ? data.analytics.totalLikes : 0;
            const followers = Number.isInteger(data.analytics.totalFollowers) ? data.analytics.totalFollowers : 0;
            const chats = Number.isInteger(data.analytics.totalChats) ? data.analytics.totalChats : 0;

            if (elements.totalViews) elements.totalViews.textContent = views;
            const totalViewsDesktop = document.getElementById('totalViewsDesktop');
            if (totalViewsDesktop) totalViewsDesktop.textContent = views;
            
            if (elements.totalLikes) elements.totalLikes.textContent = likes;
            const totalLikesDesktop = document.getElementById('totalLikesDesktop');
            if (totalLikesDesktop) totalLikesDesktop.textContent = likes;
            
            if (elements.totalFollowers) elements.totalFollowers.textContent = followers;
            const totalFollowersDesktop = document.getElementById('totalFollowersDesktop');
            if (totalFollowersDesktop) totalFollowersDesktop.textContent = followers;
            
            if (elements.totalChats) elements.totalChats.textContent = chats;
            const totalChatsDesktop = document.getElementById('totalChatsDesktop');
            if (totalChatsDesktop) totalChatsDesktop.textContent = chats;

            if (views === 0 && likes === 0 && followers === 0 && chats === 0) {
                showOverviewEmpty();
            }
        } else {
            ErrorLogger.error('Analytics: Data validation failed', null, {});
            showOverviewError();
        }

        // Feedback analytics
        if (feedbackData.success && feedbackData.analytics) {
            const pos = Number.isInteger(feedbackData.analytics.positiveFeedback) 
                ? feedbackData.analytics.positiveFeedback : 0;
            const neg = Number.isInteger(feedbackData.analytics.negativeFeedback) 
                ? feedbackData.analytics.negativeFeedback : 0;
            const score = Number.isFinite(feedbackData.analytics.satisfactionScore) 
                ? Math.round(feedbackData.analytics.satisfactionScore) : 0;

            if (elements.positiveFeedback) elements.positiveFeedback.textContent = pos;
            if (elements.negativeFeedback) elements.negativeFeedback.textContent = neg;
            if (elements.satisfactionScore) elements.satisfactionScore.textContent = score + '%';
        } else {
            if (elements.positiveFeedback) elements.positiveFeedback.textContent = '0';
            if (elements.negativeFeedback) elements.negativeFeedback.textContent = '0';
            if (elements.satisfactionScore) elements.satisfactionScore.textContent = '0%';
        }

// ✅ Chart: Engagement Over Time
hideChartLoading();
if (elements.chartContainer) {
    elements.chartContainer.classList.remove('hidden');

    function initializeChart() {
        // Wait for Chart.js
        if (typeof Chart === 'undefined') {
            setTimeout(initializeChart, 100);
            return;
        }

        const canvas = document.getElementById('engagementChart');
        if (!canvas) {
            ErrorLogger.error('Engagement chart: canvas element not found', null, {});
            showChartEmpty();
            return;
        }

        const ctx = canvas.getContext('2d');
        if (!ctx) {
            ErrorLogger.error('Engagement chart: could not get canvas context', null, {});
            showChartError();
            return;
        }

        // Destroy existing chart
        if (window.engagementChartInstance) {
            window.engagementChartInstance.destroy();
        }

        // Validate and prepare data
        const chartData = data.analytics?.engagementData || null;
        
        if (!chartData || !chartData.labels || !chartData.values) {
            showChartEmpty();
            return;
        }

        // Ensure arrays are valid
        const labels = Array.isArray(chartData.labels) ? chartData.labels : [];
        const values = Array.isArray(chartData.values) ? chartData.values.map(v => Number(v) || 0) : [];

        if (labels.length === 0 || values.length === 0) {
            showChartEmpty();
            return;
        }

        try {
            window.engagementChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Engagement Over Time',
                        data: values,
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            display: true, 
                            position: 'top',
                            // ✅ FIX: Disable legend click to prevent deselection (MVP requirement)
                            // Legend is for display only, not interactive - clicking won't hide/show dataset
                            onClick: () => {
                                // Do nothing - prevent default legend click behavior
                                return false;
                            }
                        },
                        tooltip: { enabled: true }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    }
                }
            });
        } catch (error) {
            ErrorLogger.error('Error initializing engagement chart', error, {});
            showChartError();
        }
    }

    // ✅ Initialize chart after data is loaded
    initializeChart();
} else {
    ErrorLogger.error('Analytics: Chart container not found', null, {});
    showChartEmpty();
}        

        // Top Users (this twin)
        await loadTopUsersForTwin(elements);

        // ✅ NEW: Period Summary
        hidePeriodSummaryLoading();
        if (elements.periodSummary) {
            elements.periodSummary.classList.remove('hidden');
            
            const periodSummary = data.analytics?.periodSummary;
            if (periodSummary) {
                // Store data globally for toggle
                window.analyticsData = data;
                renderPeriodSummary(periodSummary, window.currentPeriod || 7);
            } else {
                showPeriodSummaryEmpty();
            }
        } else {
            ErrorLogger.error('Analytics: Period summary container not found', null, {});
        }
    } catch (error) {
        ErrorLogger.error('Error loading analytics', error, {});
        showOverviewError();
        showChartError();
        showTopContentError();
        showPeriodSummaryError();
    }
}

// ✅ NEW: Function to render period summary
function renderPeriodSummary(periodSummary, selectedPeriod) {
    const container = document.getElementById('periodSummary');
    if (!container) return;
    
    const periodData = selectedPeriod === 7 ? periodSummary.period7Days : periodSummary.period30Days;
    
    if (!periodData) {
        showPeriodSummaryEmpty();
        return;
    }
    
    const summaryCards = [
        {
            label: 'New Chats',
            value: periodData.newChats || 0,
            icon: '💬',
            bgClass: 'bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20',
            borderClass: 'border-blue-200 dark:border-blue-800',
            textClass: 'text-blue-600 dark:text-blue-400'
        },
        {
            label: 'New Likes',
            value: periodData.newLikes || 0,
            icon: '❤️',
            bgClass: 'bg-gradient-to-br from-red-50 to-red-100 dark:from-red-900/20 dark:to-red-800/20',
            borderClass: 'border-red-200 dark:border-red-800',
            textClass: 'text-red-600 dark:text-red-400'
        },
        {
            label: 'New Followers',
            value: periodData.newFollowers || 0,
            icon: '👥',
            bgClass: 'bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20',
            borderClass: 'border-purple-200 dark:border-purple-800',
            textClass: 'text-purple-600 dark:text-purple-400'
        },
        {
            label: 'Shares',
            value: periodData.newShares || 0,
            icon: '🔗',
            bgClass: 'bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20',
            borderClass: 'border-green-200 dark:border-green-800',
            textClass: 'text-green-600 dark:text-green-400'
        },
        {
            label: 'Messages',
            value: periodData.newMessages || 0,
            icon: '📨',
            bgClass: 'bg-gradient-to-br from-orange-50 to-orange-100 dark:from-orange-900/20 dark:to-orange-800/20',
            borderClass: 'border-orange-200 dark:border-orange-800',
            textClass: 'text-orange-600 dark:text-orange-400'
        }
    ];
    
    container.innerHTML = summaryCards.map(card => `
        <div class="${card.bgClass} rounded-xl p-4 border ${card.borderClass}">
            <div class="flex items-center justify-between mb-2">
                <span class="text-2xl">${card.icon}</span>
                <span class="text-2xl sm:text-3xl font-bold ${card.textClass}">${card.value}</span>
            </div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">${card.label}</p>
        </div>
    `).join('');
    
    container.classList.remove('hidden');
}

// ✅ NEW: Helper function to escape HTML
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

    // ✅ NEW: Period toggle handler
    window.currentPeriod = 7;
    
    // Load analytics on page load and add click handlers
    document.addEventListener('DOMContentLoaded', () => {
        // Setup period toggle
        const toggle7 = document.getElementById('periodToggle7');
        const toggle30 = document.getElementById('periodToggle30');
        
        if (toggle7 && toggle30) {
            toggle7.addEventListener('click', () => {
                window.currentPeriod = 7;
                toggle7.classList.add('bg-primary', 'text-white');
                toggle7.classList.remove('text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-200', 'dark:hover:bg-gray-600');
                toggle30.classList.remove('bg-primary', 'text-white');
                toggle30.classList.add('text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-200', 'dark:hover:bg-gray-600');
                
                if (window.analyticsData?.analytics?.periodSummary) {
                    renderPeriodSummary(window.analyticsData.analytics.periodSummary, 7);
                }
            });
            
            toggle30.addEventListener('click', () => {
                window.currentPeriod = 30;
                toggle30.classList.add('bg-primary', 'text-white');
                toggle30.classList.remove('text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-200', 'dark:hover:bg-gray-600');
                toggle7.classList.remove('bg-primary', 'text-white');
                toggle7.classList.add('text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-200', 'dark:hover:bg-gray-600');
                
                if (window.analyticsData?.analytics?.periodSummary) {
                    renderPeriodSummary(window.analyticsData.analytics.periodSummary, 30);
                }
            });
        }
        
        loadAnalytics();
        
        // Get twinId from global variable (set by script tag outside template string)
        const twinIdValue = window.twinIdValue || '';
        
        // Set data attributes on cards and add click handlers
        const cards = [
            { element: document.getElementById('totalLikes')?.closest('[class*="bg-white"]'), type: 'likers' },
            { element: document.getElementById('totalFollowers')?.closest('[class*="bg-white"]'), type: 'followers' },
            { element: document.getElementById('totalChats')?.closest('[class*="bg-white"]'), type: 'chatters' }
        ];
        
        cards.forEach(card => {
            if (card.element) {
                card.element.classList.add('cursor-pointer', 'hover:shadow-xl', 'transition-all');
                card.element.setAttribute('data-twin-id', twinIdValue);
                card.element.setAttribute('data-list-type', card.type);
                
                // Direct redirect to analytics/details (NO popup)
                card.element.addEventListener('click', function() {
                    const listType = this.getAttribute('data-list-type');
                    if (listType) {
                        // Direct redirect to details page (use string concatenation instead of template literal)
                        window.location.href = '/analytics/details?type=' + listType;
                    }                            
                });                    
            }
        });
    });
    
    // ✅ Unified notification wrapper for analytics
    function showNotification(message, type = 'success') {
        if (window.UI && typeof window.UI.showToast === 'function') {
            window.UI.showToast(message, type);
        }
    }

    // ✅ NEW: Load top users who interacted with this twin (via public chat)
    async function loadTopUsersForTwin(elements) {
        const container = elements.topContent || document.getElementById('topContent');
        hideTopContentLoading();

        if (!container) {
            ErrorLogger.error('Analytics: Top users container not found', null, {});
            showTopContentError();
            return;
        }

        const twinToken = window.twinIdValue || '';
        if (!twinToken) {
            showTopContentEmpty();
            return;
        }

        try {
            const params = new URLSearchParams({
                page: '1',
                limit: '5',
                view: 'user',
                userSortBy: 'totalMessages',
                minMessages: '1'
            });

            const response = await fetch(`/api/public-chat/twin/${twinToken}/user-chats?${params.toString()}`, {
                method: 'GET',
                credentials: 'include',
                cache: 'no-store'
            });

            if (!response.ok) {
                ErrorLogger.error('Analytics: Top users API failed', new Error(`Status: ${response.status}`), { status: response.status });
                showTopContentError();
                return;
            }

            const data = await response.json();

            const users = Array.isArray(data.users) ? data.users : [];
            if (users.length === 0) {
                showTopContentEmpty();
                return;
            }

            container.classList.remove('hidden');
            container.innerHTML = '';

            const fragment = document.createDocumentFragment();

            users.forEach((group) => {
                const user = group.user || {};
                const div = document.createElement('div');
                div.className =
                    'w-full text-left p-3 bg-gray-50 dark:bg-gray-700 rounded-lg flex items-center justify-between ' +
                    'transition-colors';

                const name = escapeHtml(user.name || user.handle || 'Unknown user');
                const handle = escapeHtml(user.handle || '');
                const totalChats = group.totalChats || 0;
                const totalMessages = group.totalMessages || 0;
                const lastActivity = group.lastActivity || null;

                // Format relative time for last activity
                let lastActiveText = 'Never';
                if (lastActivity) {
                    try {
                        if (window.TimeUtils && typeof window.TimeUtils.formatRelativeTime === 'function') {
                            lastActiveText = window.TimeUtils.formatRelativeTime(lastActivity);
                        } else {
                            // Fallback if TimeUtils not available
                            const diff = Date.now() - new Date(lastActivity).getTime();
                            const minutes = Math.floor(diff / (1000 * 60));
                            const hours = Math.floor(minutes / 60);
                            const days = Math.floor(hours / 24);
                            if (minutes < 60) {
                                lastActiveText = `${minutes}m ago`;
                            } else if (hours < 24) {
                                lastActiveText = `${hours}h ago`;
                            } else {
                                lastActiveText = `${days}d ago`;
                            }
                        }
                    } catch (e) {
                        ErrorLogger.error('Error formatting last activity', e, {});
                        lastActiveText = 'Unknown';
                    }
                }

                // Profile icon with click handler
                const profileIconClickable = handle 
                    ? `cursor-pointer hover:opacity-80 transition-opacity`
                    : '';

                div.innerHTML = `
                    <div class="flex items-center gap-3">
                        ${user.profileImage
                            ? `<img src="${escapeHtml(user.profileImage)}" alt="${name}" class="w-8 h-8 rounded-full ${profileIconClickable}" data-user-handle="${escapeHtml(handle)}">`
                            : `<div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center ${profileIconClickable}" data-user-handle="${escapeHtml(handle)}">
                                   <span class="text-primary font-semibold text-sm">${escapeHtml((name || 'U').charAt(0).toUpperCase())}</span>
                               </div>`
                        }
                        <div>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">${name}</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">
                                ${totalMessages} messages, ${totalChats} chats
                            </p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">
                            Last active: ${escapeHtml(lastActiveText)}
                        </p>
                        <p class="text-xs font-medium text-primary dark:text-primary mt-1 cursor-pointer" data-view-history="true" data-user-public-id="${user.publicId || ''}">View full history →</p>
                    </div>
                `;

                // Profile icon click handler - redirect to twin profile
                const profileIcon = div.querySelector('[data-user-handle]');
                if (profileIcon && handle) {
                    profileIcon.addEventListener('click', (e) => {
                        e.stopPropagation();
                        window.location.href = `/@${handle}`;
                    });
                }

                // View full history click handler - redirect to public chat history for this user
                const viewHistoryBtn = div.querySelector('[data-view-history="true"]');
                if (viewHistoryBtn && user.publicId) {
                    viewHistoryBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const url = new URL('/public-chat-history', window.location.origin);
                        url.searchParams.set('view', 'user');
                        url.searchParams.set('userId', user.publicId);
                        window.location.href = url.toString();
                    });
                }

                fragment.appendChild(div);
            });

            container.appendChild(fragment);
        } catch (error) {
            ErrorLogger.error('Error loading top users', error, {});
            showTopContentError();
        }
    }
</script>

<!-- Social List Modal -->
<%- include('shared/social-list-modal') %>