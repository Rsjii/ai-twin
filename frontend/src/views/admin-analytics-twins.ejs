<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .twin-card { transition: all 0.3s ease; }
        .twin-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/analytics" class="text-xl font-bold text-gray-900">← Back to Analytics</a>
                    <span class="ml-4 px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full">Twins</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <img src="<%= user.profileImage || '/uploads/profiles/default.jpg' %>" alt="Profile" class="w-8 h-8 rounded-full">
                        <span class="text-sm font-medium text-gray-700"><%= user.handle || user.email %></span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Twins Analytics</h1>
            <p class="text-gray-600 dark:text-gray-300 mt-2">Detailed twins analytics and management</p>
        </div>

        <!-- Summary Cards -->
        <div id="summaryCards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-green-100 rounded-lg">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Twins</p>
                        <p class="text-2xl font-bold text-gray-900" id="totalTwins">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-blue-100 rounded-lg">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">New Today</p>
                        <p class="text-2xl font-bold text-gray-900" id="newToday">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-purple-100 rounded-lg">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Avg Likes</p>
                        <p class="text-2xl font-bold text-gray-900" id="avgLikes">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-orange-100 rounded-lg">
                        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Avg Chats</p>
                        <p class="text-2xl font-bold text-gray-900" id="avgChats">-</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search and Filters -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <input type="text" id="searchInput" placeholder="Search twins by name, user email or handle..." 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                    </div>
                    <div class="flex gap-2">
                        <input type="date" id="fromDate" placeholder="From Date" 
                               class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                        <input type="date" id="toDate" placeholder="To Date" 
                               class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                    </div>
                </div>
                <div class="flex flex-col md:flex-row gap-4">
                    <select id="isPublic" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                        <option value="">All Visibility</option>
                        <option value="true">Public Only</option>
                        <option value="false">Private Only</option>
                    </select>
                    <input type="number" id="minLikes" placeholder="Min Likes" min="0" 
                           class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                    <input type="number" id="minChats" placeholder="Min Chats" min="0" 
                           class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                    <select id="sortBy" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                        <option value="createdAt">Sort by Date</option>
                        <option value="likeCount">Sort by Likes</option>
                        <option value="chatCount">Sort by Chats</option>
                        <option value="followCount">Sort by Follows</option>
                        <option value="messageCount">Sort by Messages</option>
                        <option value="eventCount">Sort by Events</option>
                        <option value="name">Sort by Name</option>
                    </select>
                    <select id="sortOrder" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                        <option value="DESC">Highest First</option>
                        <option value="ASC">Lowest First</option>
                    </select>
                    <button id="applyFiltersBtn" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">Apply Filters</button>
                    <button id="clearFiltersBtn" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Clear</button>
                </div>
            </div>
        </div>

        <!-- Twins List -->
        <div class="bg-white rounded-lg shadow-sm">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900">Twins List</h3>
            </div>
            <div id="twinsList" class="divide-y divide-gray-200">
                <div class="p-4 sm:p-6 lg:p-8 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-green-600"></div>
                    <p class="text-gray-600 mt-4">Loading twins...</p>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-8 flex justify-center">
            <!-- Pagination will be loaded here -->
        </div>
    </div>

    <script>
        let currentPage = 1;
        let currentSearch = '';
        let currentSortBy = 'createdAt';
        let currentSortOrder = 'DESC';
        let currentFromDate = '';
        let currentToDate = '';
        let currentIsPublic = '';
        let currentMinLikes = '';
        let currentMinChats = '';

        // Load twins data
        async function loadTwinsData() {
            try {
                const params = new URLSearchParams({
                    page: currentPage,
                    limit: 10,
                    search: currentSearch,
                    sortBy: currentSortBy,
                    sortOrder: currentSortOrder,
                    fromDate: currentFromDate,
                    toDate: currentToDate,
                    isPublic: currentIsPublic,
                    minLikes: currentMinLikes,
                    minChats: currentMinChats
                });

                const response = await fetch(`/api/admin/analytics/page/twins?${params}`);
                const data = await response.json();

                if (data.success) {
                    // Update summary cards
                    document.getElementById('totalTwins').textContent = data.data.summary.totalTwins;
                    document.getElementById('newToday').textContent = data.data.summary.newToday;
                    document.getElementById('avgLikes').textContent = Math.round(data.data.summary.avgLikes || 0);
                    document.getElementById('avgChats').textContent = Math.round(data.data.summary.avgChats || 0);

                    // Update twins list
                    updateTwinsList(data.data.twins);
                    
                    // Update pagination
                    updatePagination(data.data.pagination);
                } else {
                    showError('Failed to load twins data: ' + data.error);
                }
            } catch (error) {
                console.error('Load twins error:', error);
                showError('Error loading twins data');
            }
        }

        // Update twins list
        function updateTwinsList(twins) {
            const twinsList = document.getElementById('twinsList');
            
            if (twins && twins.length > 0) {
                twinsList.innerHTML = twins.map(twin => `
                    <div class="twin-card p-6 hover:bg-gray-50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                    ${(twin.name || 'T').charAt(0).toUpperCase()}
                                </div>
                                <div>
                                    <h4 class="text-lg font-semibold text-gray-900">${twin.name || twin.publicHandle || 'Unnamed Twin'}</h4>
                                    <p class="text-sm text-gray-600">Owner: ${twin.userHandle || twin.userEmail}</p>
                                    <p class="text-xs text-gray-500 timestamp-display" data-timestamp="${twin.createdAt}" data-format="date" data-prefix="Created: "></p>                                    
                                    <p class="text-xs text-gray-500">ID: ${twin.id}</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-6">
                                <div class="text-center">
                                    <p class="text-lg font-bold text-green-600">${twin.likeCount || 0}</p>
                                    <p class="text-xs text-gray-500">Likes</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-lg font-bold text-blue-600">${twin.chatCount || 0}</p>
                                    <p class="text-xs text-gray-500">Chats</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-lg font-bold text-purple-600">${twin.messageCount || 0}</p>
                                    <p class="text-xs text-gray-500">Messages</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-lg font-bold text-orange-600">${twin.eventCount || 0}</p>
                                    <p class="text-xs text-gray-500">Events</p>
                                </div>
                                <div class="flex space-x-2">
<button 
  class="view-twin-btn px-3 py-1 bg-green-100 text-green-700 rounded text-sm hover:bg-green-200" 
  data-twin-id="${twin.publicId || twin.id}"
  data-twin='${JSON.stringify(twin).replace(/'/g, "&apos;")}'
>
  View Details
</button>                                    
                                    <button class="view-owner-btn px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200" data-user-id="${twin.publicUserId || twin.userId}">
                                        View Owner
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');
                
                // ✅ Format timestamps client-side after rendering
                if (window.TimeUtils) {
                    twinsList.querySelectorAll('.timestamp-display').forEach(el => {
                        const timestamp = el.dataset.timestamp;
                        const format = el.dataset.format || 'date';
                        const prefix = el.dataset.prefix || '';
                        if (timestamp) {
                            try {
                                let displayTime, fullTime;
                                if (format === 'date') {
                                    displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                } else {
                                    displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                    fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                }
                                el.textContent = prefix + displayTime;
                                el.title = fullTime;
                            } catch (e) {
                                console.error('Error formatting timestamp:', e);
                            }
                        }
                    });
                }
            } else {
                twinsList.innerHTML = '<div class="p-4 sm:p-6 lg:p-8 text-center text-gray-500 dark:text-gray-400">No twins found</div>';
            }
        }

        // Update pagination
        function updatePagination(pagination) {
            const paginationDiv = document.getElementById('pagination');
            const { currentPage, totalPages, totalItems } = pagination;
            
            let paginationHTML = '<div class="flex items-center space-x-2">';
            
            // Previous button
            if (currentPage > 1) {
                paginationHTML += `<button class="page-btn px-3 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" data-page="${currentPage - 1}">Previous</button>`;
            }
            
            // Page numbers
            for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
                paginationHTML += `<button class="page-btn px-3 py-2 ${i === currentPage ? 'bg-green-600 text-white' : 'bg-white border border-gray-300 hover:bg-gray-50'} rounded-lg" data-page="${i}">${i}</button>`;
            }
            
            // Next button
            if (currentPage < totalPages) {
                paginationHTML += `<button class="page-btn px-3 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" data-page="${currentPage + 1}">Next</button>`;
            }
            
            paginationHTML += '</div>';
            paginationHTML += `<div class="ml-4 text-sm text-gray-600">Showing ${((currentPage - 1) * 10) + 1}-${Math.min(currentPage * 10, totalItems)} of ${totalItems} twins</div>`;
            
            paginationDiv.innerHTML = paginationHTML;
        }

        // Change page
        function changePage(page) {
            currentPage = page;
            loadTwinsData();
        }

        // Search twins
        function searchTwins() {
            currentSearch = document.getElementById('searchInput').value;
            currentPage = 1;
            loadTwinsData();
        }

        // View twin details
        async function viewTwinDetails(twinId, twinData) {
  try {
    const twinWindow = window.open('', '_blank', 'width=900,height=700,scrollbars=yes,resizable=yes');
    twinWindow.document.write(`
      <html>
      <head><title>Twin Details</title></head>
      <body style="font-family: Arial, sans-serif; padding: 20px;">
        <h2>Twin Details</h2>
        <p><strong>Twin ID (token):</strong> ${twinId}</p>
        <pre>${twinData ? JSON.stringify(twinData, null, 2) : 'No extra data passed'}</pre>
      </body>
      </html>
    `);
  } catch (error) {
    console.error('View twin details error:', error);
    alert('Error loading twin details');
  }
}

        // View owner profile
        async function viewOwnerProfile(userId) {
            try {
                const response = await fetch(`/api/admin/analytics/user/${userId}/detailed`);
                const data = await response.json();
                
                if (data.success) {
                    // Open owner details in new window
                    const ownerWindow = window.open('', '_blank', 'width=800,height=600,scrollbars=yes,resizable=yes');
                    ownerWindow.document.write(`
                        <html>
                        <head><title>Owner Details</title></head>
                        <body style="font-family: Arial, sans-serif; padding: 20px;">
                            <h2>Owner Details</h2>
                            <pre>${JSON.stringify(data.data, null, 2)}</pre>
                        </body>
                        </html>
                    `);
                }
            } catch (error) {
                console.error('View owner profile error:', error);
                alert('Error loading owner profile');
            }
        }

        // Show error
        function showError(message) {
            const twinsList = document.getElementById('twinsList');
            twinsList.innerHTML = `<div class="p-4 sm:p-6 lg:p-8 text-center text-red-600 dark:text-red-400">${message}</div>`;
        }

        // Apply filters
        function applyFilters() {
            currentSearch = document.getElementById('searchInput').value;
            currentFromDate = document.getElementById('fromDate').value;
            currentToDate = document.getElementById('toDate').value;
            currentIsPublic = document.getElementById('isPublic').value;
            currentMinLikes = document.getElementById('minLikes').value;
            currentMinChats = document.getElementById('minChats').value;
            currentPage = 1;
            loadTwinsData();
        }

        // Clear filters
        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('fromDate').value = '';
            document.getElementById('toDate').value = '';
            document.getElementById('isPublic').value = '';
            document.getElementById('minLikes').value = '';
            document.getElementById('minChats').value = '';
            currentSearch = '';
            currentFromDate = '';
            currentToDate = '';
            currentIsPublic = '';
            currentMinLikes = '';
            currentMinChats = '';
            currentPage = 1;
            loadTwinsData();
        }

        // Event listeners
        document.getElementById('searchInput').addEventListener('input', debounce(searchTwins, 300));
        document.getElementById('sortBy').addEventListener('change', (e) => {
            currentSortBy = e.target.value;
            loadTwinsData();
        });
        document.getElementById('sortOrder').addEventListener('change', (e) => {
            currentSortOrder = e.target.value;
            loadTwinsData();
        });
        document.getElementById('searchInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') applyFilters();
        });

        // Event delegation for dynamically added buttons
        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('page-btn')) {
                const page = parseInt(e.target.dataset.page);
                if (page) changePage(page);
            }
            if (e.target.classList.contains('view-twin-btn')) {
  const twinId = e.target.dataset.twinId;
  const twinJson = e.target.dataset.twin;
  const twinData = twinJson ? JSON.parse(twinJson) : null;
  if (twinId) viewTwinDetails(twinId, twinData);
}            
            if (e.target.classList.contains('view-owner-btn')) {
                const userId = e.target.dataset.userId;
                if (userId) viewOwnerProfile(userId);
            }
        });

        document.getElementById('applyFiltersBtn').addEventListener('click', applyFilters);
        document.getElementById('clearFiltersBtn').addEventListener('click', clearFilters);

        // Debounce function
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Load data on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadTwinsData();
        });
    </script>
</body>
</html>
