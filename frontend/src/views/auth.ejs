                                    </svg>
                                </div>
                                <input type="email" id="loginEmail" name="email" placeholder="Enter your email" class="w-full pl-12 pr-4 py-3 sm:py-4 bg-white/80 dark:bg-gray-800/80 border border-white/30 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent backdrop-blur-sm transition-all duration-200 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-base min-h-[44px]" style="font-size: 16px;" required aria-label="Email Address">
                            </div>
                        </div>
                        
<!-- For Login Password -->
