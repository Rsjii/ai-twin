                <div id="forgotPasswordForm" class="auth-form" style="display: none;">
                    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">Reset Password</h1>
                    <form id="forgotPasswordFormElement">
                        <div class="mb-4">
                            <label for="forgotEmail" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                            <input type="email" id="forgotEmail" name="email" placeholder="Enter your email" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent dark:bg-gray-700 dark:text-white" required>
                        </div>
