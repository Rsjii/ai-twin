// ✅ NEW: Lock chat when limit exhausted (supports both anonymous and logged-in users)
function lockChatForLimitExhausted(errorCode, retryAfter) {
    // ✅ NEW: Persist limit exceeded state in sessionStorage (survives refresh)
    sessionStorage.setItem('limitExceeded', String(errorCode || 'true'));
    
    // Hide loading state
    const initialLoading = document.getElementById('initialLoadingState');
    if (initialLoading) initialLoading.classList.add('hidden');
    
    // Determine if this is anonymous (needs login) or logged-in (try tomorrow)
    const isLoginRequired = errorCode === 'LOGIN_REQUIRED';
    const title = 'Daily Limit Reached';
    const message = isLoginRequired
        ? 'You have exhausted your daily token limit. Please login to continue.'
        : 'You have exhausted your daily token limit. Please try again tomorrow.';
    
    const retryLine = retryAfter ? `<p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Try again in ${retryAfter}.</p>` : '';
    
    // Different action button based on user type
    const redirectUrl = `/public-twin/chat/${encodeURIComponent(currentTwinId)}`;
    const actionHtml = isLoginRequired
        ? `<a href="/auth?redirect=${redirectUrl}" class="inline-block bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold">Go to Login</a>`
        : `<a href="/dashboard" class="inline-block bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold">Go to Dashboard</a>`;
    
    // Show message in chat area
    const chatMessages = document.getElementById('chatMessages');
    if (chatMessages) {
        chatMessages.innerHTML = `
            <div class="text-center py-12">
                <div class="w-16 h-16 bg-gradient-to-r from-yellow-100 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">${title}</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-2">${message}</p>
                ${retryLine}
                ${actionHtml}
            </div>
        `;
    }
    
    // Update subtitle text
    const chatSubtitle = document.getElementById('chatSubtitle');
    if (chatSubtitle) {
        chatSubtitle.textContent = isLoginRequired 
            ? 'Login required to chat with this twin.' 
            : 'Daily limit reached. Try again tomorrow.';
    }
    
    // Disable chat input and buttons
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendMessageBtn');
    const newChatBtn = document.getElementById('newPublicChatBtn');
    const chatForm = document.getElementById('chatForm');
    const chatInputSection = document.getElementById('chatInputSection');
    
    // Disable individual inputs
    if (messageInput) {
        messageInput.disabled = true;
        messageInput.style.opacity = '0.6';
        messageInput.style.cursor = 'not-allowed';
    }
    if (sendBtn) {
        sendBtn.disabled = true;
        sendBtn.style.opacity = '0.6';
        sendBtn.style.cursor = 'not-allowed';
    }
    if (newChatBtn) newChatBtn.disabled = true;
    
    // Disable entire chat form and input section
    if (chatForm) {
        chatForm.style.pointerEvents = 'none';
        chatForm.style.opacity = '0.6';
    }
    if (chatInputSection) {
        chatInputSection.style.pointerEvents = 'none';
        chatInputSection.style.opacity = '0.6';
    }
    
    // Hide chat history loading
    const chatHistoryLoading = document.getElementById('chatHistoryLoadingState');
    if (chatHistoryLoading) chatHistoryLoading.classList.add('hidden');
    
    // Show empty state for chat history
    const chatHistoryEmpty = document.getElementById('chatHistoryEmptyState');
    if (chatHistoryEmpty) {
        chatHistoryEmpty.classList.remove('hidden');
        chatHistoryEmpty.innerHTML = `<p class="text-gray-500 dark:text-gray-400 text-sm">${isLoginRequired ? 'Login required to view chat history' : 'Daily limit reached. Try again tomorrow.'}</p>`;
    }
}

async function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput?.value.trim();
            
            // ✅ NEW: Check if quota is exceeded at page render time (from server) - highest priority
            if (window.__quotaExceeded === true) {
                // Ensure UI is locked
                if (messageInput) messageInput.disabled = true;
                const sendBtn = document.getElementById('sendMessageBtn');
                if (sendBtn) sendBtn.disabled = true;
                return; // Don't send request
            }
            
            // ✅ NEW: Check if chat is already locked (limit exceeded) - prevent extra requests
            if (sessionStorage.getItem('limitExceeded') === 'true') {
                // Ensure UI is locked
                if (messageInput) messageInput.disabled = true;
                const sendBtn = document.getElementById('sendMessageBtn');
                if (sendBtn) sendBtn.disabled = true;
                return; // Don't send request
            }
            
            if (!message || isChatting) return;
            
            isChatting = true;
            
            // ✅ Disable input and show generating state
            if (messageInput) messageInput.disabled = true;
            const sendBtn = document.getElementById('sendMessageBtn');
            if (sendBtn) {
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mx-auto"></div>';
            }
            
            // ✅ Hide empty state
            const emptyState = document.getElementById('emptyChatState');
            if (emptyState) emptyState.classList.add('hidden');

             // ✅ FIX: Handle null or draft chatId - create chat first
             let actualChatId = currentChatId;
             
             // Case 1: chatId is null or empty (logged out user, no draft)
             if (!actualChatId || actualChatId === 'null' || actualChatId === '') {
                 try {
                     // Get twinId from already defined currentTwinId variable
                     const twinId = currentTwinId;
                     if (!twinId) {
                         throw new Error('Twin ID not found');
                     }
                     
                     // Get or create visitorId (use sessionStorage for logged out users)
                     let visitorIdToUse = visitorId || sessionStorage.getItem('visitorId');
                     if (!visitorIdToUse) {
                         visitorIdToUse = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                         sessionStorage.setItem('visitorId', visitorIdToUse);
                         visitorId = visitorIdToUse;
                     }
                     
                     // Create new chat
                     const response = await fetch(`/api/public-chat/start`, {
                         method: 'POST',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         credentials: 'include',
                         body: JSON.stringify({
                             twinToken: currentTwinId,
                             visitorId: visitorIdToUse
                         })
                     });
                     
                     const data = await response.json();
                     if (data.success && data.chatId) {
                         actualChatId = data.chatId;
                         currentChatId = actualChatId;
                         // Clear any draft
                         sessionStorage.removeItem('draftPublicChat');
                         // Enable "New Chat" button
                         const newChatBtn = document.getElementById('newPublicChatBtn');
                         if (newChatBtn) newChatBtn.disabled = false;
                     } else {
                         throw new Error(data.error || 'Failed to create chat');
                     }
                 } catch (error) {
                     console.error('Error creating chat:', error);
                     showNotification('Failed to create chat. Please try again.', 'error');
                     isChatting = false;
                     if (messageInput) messageInput.disabled = false;
                     if (sendBtn) {
                         sendBtn.disabled = false;
                         sendBtn.textContent = 'Send';
                     }
                     return;
                 }
             }
             // Case 2: chatId is draft (starts with 'draft_')
             else if (actualChatId && actualChatId.startsWith('draft_')) {
                 // This is a draft chat - create it now
                 try {
                     const draftData = sessionStorage.getItem('draftPublicChat');
                     if (draftData) {
                         const draft = JSON.parse(draftData);
                         const response = await fetch(`/api/public-chat/start`, {
                             method: 'POST',
                             headers: {
                                 'Content-Type': 'application/json',
                             },
                             credentials: 'include',
                             body: JSON.stringify({
                                 twinToken: draft.twinToken,
                                 visitorId: draft.visitorId
                             })
                         });
                         
                         const data = await response.json();
                         if (data.success && data.chatId) {
                             actualChatId = data.chatId;
                             currentChatId = actualChatId;
                             // Clear draft
                             sessionStorage.removeItem('draftPublicChat');
                             // Enable "New Chat" button
                             const newChatBtn = document.getElementById('newPublicChatBtn');
                             if (newChatBtn) newChatBtn.disabled = false;
                         } else {
                             throw new Error(data.error || 'Failed to create chat');
                         }
                     } else {
                         // No draft data, create new chat
                         const twinId = currentTwinId;
                         let visitorIdToUse = visitorId || sessionStorage.getItem('visitorId');
                         if (!visitorIdToUse) {
                             visitorIdToUse = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                             sessionStorage.setItem('visitorId', visitorIdToUse);
                             visitorId = visitorIdToUse;
                         }
                         
                         const response = await fetch(`/api/public-chat/start`, {
                             method: 'POST',
                             headers: {
                                 'Content-Type': 'application/json',
                             },
                             credentials: 'include',
                             body: JSON.stringify({
                                 twinToken: currentTwinId,
                                 visitorId: visitorIdToUse
                             })
                         });
                         
                         const data = await response.json();
                         if (data.success && data.chatId) {
                             actualChatId = data.chatId;
                             currentChatId = actualChatId;
                         } else {
                             throw new Error(data.error || 'Failed to create chat');
                         }
                     }
                 } catch (error) {
                     console.error('Error creating chat:', error);
                     showNotification('Failed to create chat. Please try again.', 'error');
                     isChatting = false;
                     if (messageInput) messageInput.disabled = false;
                     if (sendBtn) {
                         sendBtn.disabled = false;
                         sendBtn.textContent = 'Send';
                     }
                     return;
                 }
             }
             
             // ✅ Validate actualChatId before sending
             if (!actualChatId || actualChatId === 'null' || actualChatId === '') {
                 console.error('Invalid chatId:', actualChatId);
                 showNotification('Chat ID is invalid. Please refresh the page and try again.', 'error');
                 isChatting = false;
                 if (messageInput) messageInput.disabled = false;
                 if (sendBtn) {
                     sendBtn.disabled = false;
                     sendBtn.textContent = 'Send';
                 }
                 return;
             }
            
            // ✅ Add user message and create typing indicator
            addMessageToChat(message, 'human', false, new Date().toISOString());
            const typingId = addMessageToChat('Thinking...', 'ai', true);
            messageInput.value = '';
            
            try {
                const response = await fetch(`/api/public-chat/${actualChatId}/message`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ message })
                });

                const data = await response.json();
                
                // ✅ CRITICAL: Set server time FIRST - before any other processing
                if (data && data.serverTime) {
                    const serverTimeStr = String(data.serverTime).trim();
                    if (window && window.TimeUtils && typeof window.TimeUtils.setServerTime === 'function') {
                        try {
                            window.TimeUtils.setServerTime(serverTimeStr);
                        } catch (e) {
                            console.error('[sendMessage] ❌ ERROR setting server time:', e);
                        }
                    }
                }
                
                // Remove typing indicator
                removeMessage(typingId);

                // ✅ FIX: Handle quota exceeded (both anonymous and logged-in users)
                if (!response.ok && response.status === 429) {
                    // Lock chat with proper error code and retry after
                    lockChatForLimitExhausted(data?.errorCode, data?.retryAfter);
                    
                    isChatting = false;
                    return;
                }                

                // ✅ Handle CHAT_NOT_FOUND error
                if (!response.ok && data.errorCode === 'CHAT_NOT_FOUND') {
                    console.error('Chat not found, creating new chat...');
                    // Try to create chat again
                    const twinId = currentTwinId;
                    let visitorIdToUse = visitorId || sessionStorage.getItem('visitorId');
                    if (!visitorIdToUse) {
                        visitorIdToUse = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                        sessionStorage.setItem('visitorId', visitorIdToUse);
                        visitorId = visitorIdToUse;
                    }
                    
                    const createResponse = await fetch(`/api/public-chat/start`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include',
                        body: JSON.stringify({
                            twinToken: currentTwinId,
                            visitorId: visitorIdToUse
                        })
                     });
                    
                    const createData = await createResponse.json();
                    if (createData.success && createData.chatId) {
                        actualChatId = createData.chatId;
                        currentChatId = actualChatId;
                        // Retry sending message
                        const retryResponse = await fetch(`/api/public-chat/${actualChatId}/message`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ message })
                        });
                        const retryData = await retryResponse.json();
                        if (retryData.success && retryData.messages) {
                            const aiMessage = retryData.messages.find(m => m.sender === 'twin');
                            if (aiMessage) {
                                displayWithTypingEffect('ai', aiMessage.content, {
                                    timestamp: aiMessage.createdAt
                                }, () => {
                                    loadPublicChatHistory();
                                });
                            }
                        } else {
                            addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
                        }
                    } else {
                        addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
                    }
                    isChatting = false;
                    if (messageInput) messageInput.disabled = false;
                    if (sendBtn) {
                        sendBtn.disabled = false;
                        sendBtn.textContent = 'Send';
                    }
                    return;
                }
                
                // ✅ PHASE 2: Handle OWN_TWIN_CHAT error
                if (!response.ok && data.errorCode === 'OWN_TWIN_CHAT') {
                    const message = data.error || 'You cannot chat with your own twin in public chat. Redirecting to Enhanced Chat...';
                    showNotification(message, 'info');
                    if (data.redirectUrl) {
                        setTimeout(() => {
                            window.location.href = data.redirectUrl;
                        }, 800);
                    } else {
                        setTimeout(() => {
                            window.location.href = `/chat?twinId=${currentTwinId}`;
                        }, 800);
                    }
                    isChatting = false;
                    if (messageInput) messageInput.disabled = false;
                    if (sendBtn) {
                        sendBtn.disabled = false;
                        sendBtn.textContent = 'Send';
                    }
                    return;
                }
                
                if (data.success && data.messages) {                    
                    // Find the AI message (sender: 'twin')
                    const aiMessage = data.messages.find(m => m.sender === 'twin');
                    if (aiMessage) {
                        // ✅ Use typing effect instead of direct display
                        displayWithTypingEffect('ai', aiMessage.content, {
                            timestamp: aiMessage.createdAt
                        }, async () => {
                            // ✅ After typing finishes, reload full chat from server
            try {
                await switchToPublicChat(actualChatId);
            } catch (e) {
                console.error('[sendMessage] Error reloading chat after reply:', e);
            }

                        });
                    }
                } else {
                    addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
                }
            } catch (error) {
                console.error('Send message error:', error);
                // ✅ Safety check: Remove typing indicator if it exists
                if (typingId) {
                    removeMessage(typingId);
                }
                addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
            } finally {
                // ✅ Re-enable input and button
                isChatting = false;
                if (messageInput) messageInput.disabled = false;
                if (sendBtn) {
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'Send';
                }
            }
        }

        // Show notification function
        function showNotification(message, type = 'info') {
            // Remove existing notification if any
            const existing = document.getElementById('notification-toast');
            if (existing) {
                existing.remove();
            }
            
            // Create notification element
            const notification = document.createElement('div');
            notification.id = 'notification-toast';
            notification.className = `fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg transition-all duration-300 transform translate-x-0 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            notification.textContent = message;
            
            // Add to body
            document.body.appendChild(notification);
            
            // Animate in
            setTimeout(() => {
                notification.style.opacity = '1';
            }, 10);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        // Event listeners
        document.getElementById('newPublicChatBtn').addEventListener('click', createNewPublicChat);
        // ✅ Add this line for mobile "New Chat" button:
const newChatBtnMobile = document.getElementById('newPublicChatBtnMobile');
if (newChatBtnMobile) {
    newChatBtnMobile.addEventListener('click', createNewPublicChat);
}
        document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keydown', function(e) {
            // Enter without Shift = submit
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
            // Shift+Enter = new line (default behavior)
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', async function() {
            // ✅ NEW: Check if quota is exceeded at page render time (from server) - highest priority
            if (window.__quotaExceeded === true) {
                // Use stored errorCode from sessionStorage if available, otherwise default
                const storedErrorCode = sessionStorage.getItem('limitExceeded') || 'QUOTA_EXCEEDED';
                lockChatForLimitExhausted(storedErrorCode);
                return; // Don't proceed with normal initialization
            }
            
            // ✅ NEW: Check if limit was exceeded before refresh - restore locked state immediately
            const storedLimitExceeded = sessionStorage.getItem('limitExceeded');
            if (storedLimitExceeded) {
                lockChatForLimitExhausted(storedLimitExceeded);
                return; // Don't proceed with normal initialization
            }
            
            initializeVisitorId();

            // Show loading skeletons before any API calls (for logged-in users)
const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
const initialLoading = document.getElementById('initialLoadingState');
const sidebarLoading = document.getElementById('chatHistoryLoadingState');
const chatEmpty = document.getElementById('emptyChatState');
const historyEmpty = document.getElementById('chatHistoryEmptyState');

if (isLoggedIn) {
    if (chatEmpty) chatEmpty.classList.add('hidden');
    if (historyEmpty) historyEmpty.classList.add('hidden');
    if (initialLoading) initialLoading.classList.remove('hidden');
    if (sidebarLoading) sidebarLoading.classList.remove('hidden');
}
            
            // ✅ PHASE 2: Check if user is trying to chat with own twin
            const isOwnTwin = await checkOwnTwin();
            if (isOwnTwin) {
                return; // Don't proceed if own twin
            }
            
            // ✅ For logged out users: Hide all loading states immediately
            if (!isLoggedIn) {

                sessionStorage.removeItem('draftPublicChat');

                 // ✅ NEW: Remove chatId from URL for anonymous users (prevent reuse)
                 const url = new URL(window.location.href);
                if (url.searchParams.has('chatId')) {
                    url.searchParams.delete('chatId');
                    window.history.replaceState({}, '', url.toString());
                }
                

                // Hide initial loading state
                const initialLoading = document.getElementById('initialLoadingState');
                if (initialLoading) initialLoading.classList.add('hidden');
                
                // Hide chat history loading state
                const chatHistoryLoading = document.getElementById('chatHistoryLoadingState');
                if (chatHistoryLoading) chatHistoryLoading.classList.add('hidden');
                
                // Show empty states
                const emptyChatState = document.getElementById('emptyChatState');
                const emptyHistoryState = document.getElementById('chatHistoryEmptyState');
                if (emptyChatState) emptyChatState.classList.remove('hidden');
                if (emptyHistoryState) emptyHistoryState.classList.remove('hidden');
                
                // Clear chat history list
                const container = document.getElementById('publicChatHistoryList');
                if (container) {
                    container.innerHTML = '';
                }
                
                // Don't load any history - just show empty state
                // User can start chatting and it will create draft chat
                return; // Exit early - no API calls for logged out users
            }
            
            // If initialChatId provided, load that chat
            if ('<%= initialChatId || "" %>') {
                currentChatId = '<%= initialChatId %>';

                 // ✅ NEW: Update URL to include chatId (if not already present)
                 const url = new URL(window.location.href);
                if (!url.searchParams.has('chatId')) {
                    url.searchParams.set('chatId', '<%= initialChatId %>');
                    window.history.replaceState({}, '', url.toString());
                }
                
                // ✅ Check if this is user's own twin
                const isOwnTwin = <%= typeof user !== 'undefined' && user && twin.userId === user.id ? 'true' : 'false' %>;
                
                if (isOwnTwin) {
                    // For own twin: Load chat history in read-only mode
                    await switchToPublicChat('<%= initialChatId %>');
                } else {
                    // For other users: Normal chat loading
                    switchToPublicChat('<%= initialChatId %>');
                }
            } else {
                // Otherwise, load chat history and auto-select/create
                await startPublicChat();
            }
        });        
    </script>

