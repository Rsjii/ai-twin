<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat with <%= twin.publicHandle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
<body class="bg-gray-100 dark:bg-gray-900">
    <!--Header-->
    <%- include('header') %>

    <div class="flex h-screen">
        <!-- Chat Sidebar -->
        <div class="w-64 bg-white dark:bg-gray-800 shadow-lg dark:shadow-gray-900 overflow-x-hidden">
            <div class="p-4 border-b dark:border-gray-700">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Chat with <%= twin.publicHandle %></h2>
                <button id="newPublicChatBtn" class="w-full mt-2 bg-blue-600 dark:bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors">
                    + New Chat
                </button>
            </div>
            
            <!-- Chat History List -->
            <div id="publicChatHistoryList" class="p-4 space-y-2 max-h-96 overflow-y-auto overflow-x-hidden">
                <!-- ✅ ADD: Loading state -->
                <div id="chatHistoryLoadingState" class="text-center py-8">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 dark:border-blue-400 mx-auto mb-2"></div>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">Loading chat history...</p>
                </div>
                
                <!-- ✅ ADD: Empty state -->
                <div id="chatHistoryEmptyState" class="hidden text-center py-8">
                    <div class="w-12 h-12 bg-gradient-to-r from-blue-100 to-indigo-100 dark:from-blue-900/30 dark:to-indigo-900/30 rounded-full flex items-center justify-center mx-auto mb-3">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">No previous chats</p>
                </div>
                
                <!-- Chat items will be loaded here -->
            </div>
        </div>
        
        <!-- Main Chat Area -->
        <div class="flex-1 flex flex-col">
            <!-- Chat Header -->
            <div class="bg-white dark:bg-gray-800 p-4 border-b dark:border-gray-700 flex items-center gap-3">
                <a href="/@<%= twin.publicHandle %>" class="flex-shrink-0 hover:opacity-80 transition-opacity" title="View @<%= twin.publicHandle %> profile">
                    <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg hover:shadow-xl transition-all">
                        <%= twin.publicHandle ? twin.publicHandle.charAt(0).toUpperCase() : 'T' %>
                    </div>
                </a>
                <div class="flex-1 min-w-0">
                    <h1 class="text-xl font-semibold text-gray-900 dark:text-white truncate">Chat with @<%= twin.publicHandle %></h1>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        <% if (typeof requiresLogin !== 'undefined' && requiresLogin) { %>
                            Login required to chat with this twin.
                        <% } else { %>
                            You can chat with this AI twin without logging in!
                        <% } %>
                    </p>
                </div>
            </div>      

            <!-- Chat Messages -->
            <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50 dark:bg-gray-900">
                <!-- ✅ ADD: Initial loading state -->
                <div id="initialLoadingState" class="text-center py-12">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                    <p class="text-gray-600 dark:text-gray-300">Loading chat...</p>
                </div>
                
                <!-- ✅ ADD: Empty state -->
                <div id="emptyChatState" class="hidden text-center py-12">
                    <div class="w-16 h-16 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No messages yet</h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">Start the conversation by sending a message!</p>
                </div>
                
                <!-- Messages will be loaded here -->
            </div>
            
            <!-- Chat Input -->
            <div class="bg-white dark:bg-gray-800 p-4 border-t dark:border-gray-700 shadow-lg dark:shadow-gray-900">
                <form id="chatForm" class="flex space-x-4">
                    <textarea 
                        type="text" 
                        id="messageInput" 
                        placeholder="Type your message..." 
                        class="flex-1 px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                        rows="2"
                        maxlength="1000"
                        required
                    ></textarea>
                    <button type="submit" id="sendMessageBtn" class="bg-blue-600 dark:bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-semibold">
                        Send
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let currentChatId = null;
        let currentTwinId = '<%= twin.id %>';
        let visitorId = null;
        let isChatting = false;
    
// ✅ NEW: Check if login is required on page load - SIMPLE MESSAGE
<% if (typeof requiresLogin !== 'undefined' && requiresLogin) { %>
document.addEventListener('DOMContentLoaded', function() {
    // Hide loading state
    const initialLoading = document.getElementById('initialLoadingState');
    if (initialLoading) initialLoading.classList.add('hidden');
    
    // Show simple message in chat area
    const chatMessages = document.getElementById('chatMessages');
    if (chatMessages) {
        chatMessages.innerHTML = `
            <div class="text-center py-12">
                <div class="w-16 h-16 bg-gradient-to-r from-yellow-100 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Login Required</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">You need to login to chat with this twin.</p>
                <a href="/auth?redirect=/public-twin/chat/<%= twin.id %>" class="inline-block bg-blue-600 dark:bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-semibold">
                    Go to Login
                </a>
            </div>
        `;
    }
    
    // Disable chat input and buttons
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendMessageBtn');
    const newChatBtn = document.getElementById('newPublicChatBtn');
    if (messageInput) messageInput.disabled = true;
    if (sendBtn) sendBtn.disabled = true;
    if (newChatBtn) newChatBtn.disabled = true;
    
    // Hide chat history loading
    const chatHistoryLoading = document.getElementById('chatHistoryLoadingState');
    if (chatHistoryLoading) chatHistoryLoading.classList.add('hidden');
    
    // Show empty state for chat history
    const chatHistoryEmpty = document.getElementById('chatHistoryEmptyState');
    if (chatHistoryEmpty) {
        chatHistoryEmpty.classList.remove('hidden');
        chatHistoryEmpty.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">Login required to view chat history</p>';
    }
    
    // Don't load chat history or create new chat
    return;
});
<% } %>

// ✅ PHASE 2: Check if user is trying to chat with their own twin
<% if (typeof user !== 'undefined' && user && typeof twin !== 'undefined' && twin) { %>
    <%
        // Check if this twin belongs to the current user
        // We need to fetch twin owner info - for now, we'll check in frontend after page load
    %>
<% } %>

        // ✅ PHASE 2: Check own twin on page load
        async function checkOwnTwin() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                if (!isLoggedIn) return false;
                
                const response = await fetch(`/api/public-twin/check-owner/${currentTwinId}`, {
                    credentials: 'include'
                });                
                const data = await response.json();
                
                if (data.isOwner) {
                    // User is trying to chat with their own twin
                    const chatMessages = document.getElementById('chatMessages');
                    const initialLoading = document.getElementById('initialLoadingState');
                    if (initialLoading) initialLoading.classList.add('hidden');
                    
                    if (chatMessages) {
                        chatMessages.innerHTML = `
                            <div class="text-center py-12">
                                <div class="w-16 h-16 bg-gradient-to-r from-amber-100 to-orange-100 dark:from-amber-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-8 h-8 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Use Enhanced Chat</h3>
                                <p class="text-gray-600 dark:text-gray-300 mb-4">You cannot chat with your own twin in public chat. Please use Enhanced Chat for a better experience.</p>
                                <a href="/chat-enhanced?twinId=${currentTwinId}" class="inline-block bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all font-semibold">
                                    Go to Enhanced Chat
                                </a>
                            </div>
                        `;
                    }
                    
                    // Disable chat input and buttons
                    const messageInput = document.getElementById('messageInput');
                    const sendBtn = document.getElementById('sendMessageBtn');
                    const newChatBtn = document.getElementById('newPublicChatBtn');
                    if (messageInput) messageInput.disabled = true;
                    if (sendBtn) sendBtn.disabled = true;
                    if (newChatBtn) newChatBtn.disabled = true;
                    
                    return true; // Own twin detected
                }
            } catch (error) {
                console.error('Error checking own twin:', error);
            }
            return false;
        }

        // Initialize visitor ID        
        function initializeVisitorId() {
            const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
            
            if (!isLoggedIn) {
                // ✅ Use sessionStorage - automatically clears on tab close
                visitorId = sessionStorage.getItem('visitorId');
                if (!visitorId) {
                    // Fresh session - generate new visitorId
                    visitorId = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    sessionStorage.setItem('visitorId', visitorId);
                }
                // Clear old localStorage if exists
                localStorage.removeItem('visitorId');
            } else {
                visitorId = null;
            }
        }

        // Load all chats for this twin
        async function loadPublicChatHistory() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                
                // ✅ For logged out users: Don't load chat history at all
                if (!isLoggedIn) {
                    // Hide loading, show empty state
                    const emptyState = document.getElementById('chatHistoryEmptyState');
                    const loadingState = document.getElementById('chatHistoryLoadingState');
                    if (loadingState) loadingState.classList.add('hidden');
                    if (emptyState) emptyState.classList.remove('hidden');
                    
                    // Clear chat history list
                    const container = document.getElementById('publicChatHistoryList');
                    if (container) {
                        container.innerHTML = '';
                    }
                    return; // No API call for logged out users
                }
                
                // ✅ Show loading state (only for logged in users)
                const loadingState = document.getElementById('chatHistoryLoadingState');
                const emptyState = document.getElementById('chatHistoryEmptyState');
                if (loadingState) loadingState.classList.remove('hidden');
                if (emptyState) emptyState.classList.add('hidden');
                
                // Build query params - backend will use userId from JWT cookie if available
                const params = new URLSearchParams();
                if (visitorId && !isLoggedIn) {
                    params.append('visitorId', visitorId);
                }
                
                const response = await fetch(`/api/public-chat/twin/${currentTwinId}/chats?${params.toString()}`);
                const data = await response.json();
                
                // ✅ Hide loading state
                if (loadingState) loadingState.classList.add('hidden');
                
                if (data.success) {
                    displayPublicChatHistory(data.chats);
                    
                    // ✅ Show/hide empty state
                    if (data.chats.length === 0) {
                        if (emptyState) emptyState.classList.remove('hidden');
                    } else {
                        if (emptyState) emptyState.classList.add('hidden');
                    }
                    
                    // Auto-select first chat or create new one
                    if (data.chats.length > 0 && !currentChatId) {
                        if ('<%= initialChatId || "" %>') {
                            currentChatId = '<%= initialChatId %>';
                            await switchToPublicChat(currentChatId);
                        } else {
                            currentChatId = data.chats[0].id;
                            await switchToPublicChat(currentChatId);
                        }
                    } else if (data.chats.length === 0 && !currentChatId) {
                        // No chats exist, create draft instead
                        await createNewPublicChat();
                    }
                }
            } catch (error) {
                console.error('Error loading public chat history:', error);
            }
        }        

        // Display chat history
        function displayPublicChatHistory(chats) {
            const container = document.getElementById('publicChatHistoryList');
            
            if (chats.length === 0) {
                container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">No chats yet</p>';
                return;
            }

            container.innerHTML = chats.map(chat => `
                <div class="chat-item p-3 border-b dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg relative group ${chat.id === currentChatId ? 'bg-blue-50 dark:bg-blue-900/30 border-blue-200 dark:border-blue-700' : ''}" data-chat-id="${chat.id}">
                    <div class="flex justify-between items-start min-w-0">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2 mb-1 min-w-0">
                                <h4 class="font-medium text-sm flex-1 min-w-0 truncate ${chat.id === currentChatId ? 'text-blue-700 dark:text-blue-400' : 'text-gray-900 dark:text-white'}" id="public-chat-title-${chat.id}">${chat.title || 'Chat #' + chat.id.slice(-6)}</h4>
                                <div class="flex items-center gap-1 flex-shrink-0">
                                    <button class="edit-chat-btn opacity-0 group-hover:opacity-100 transition-opacity text-blue-500 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 p-1 rounded hover:bg-blue-50 dark:hover:bg-blue-900/30 pointer-events-auto" data-chat-id="${chat.id}" title="Edit title">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </button>
                                    <button class="delete-chat-btn opacity-0 group-hover:opacity-100 transition-opacity text-red-500 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 p-1 rounded hover:bg-red-50 dark:hover:bg-red-900/30 pointer-events-auto" data-chat-id="${chat.id}" title="Delete chat">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <p class="text-xs text-gray-500 dark:text-gray-400 truncate">${chat.lastMessage ? chat.lastMessage.content : 'No messages yet'}</p>
                        </div>
                    </div>
                    <div class="flex items-center justify-between mt-2">
                        <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-2 py-1 rounded">${chat.messageCount || 0} messages</span>
                    </div>
                </div>
            `).join('');

            // Add click listeners
            container.querySelectorAll('.chat-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    // Don't switch if delete or edit button was clicked
                    if (e.target.closest('.delete-chat-btn') || e.target.closest('.edit-chat-btn')) {
                        return;
                    }
                    const chatId = this.dataset.chatId;
                    if (chatId !== currentChatId) {
                        switchToPublicChat(chatId);
                    }
                });
            });
            
            // Add click listeners to delete buttons
            container.querySelectorAll('.delete-chat-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    const chatId = this.dataset.chatId;
                    if (chatId && typeof deletePublicChat === 'function') {
                        deletePublicChat(chatId);
                    } else {
                        console.error('deletePublicChat function not found or chatId missing');
                    }
                });
            });
            
            // Add click listeners to edit buttons
            container.querySelectorAll('.edit-chat-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    const chatId = this.dataset.chatId;
                    if (chatId && typeof editPublicChatTitle === 'function') {
                        editPublicChatTitle(chatId);
                    } else {
                        console.error('editPublicChatTitle function not found or chatId missing');
                    }
                });
            });
        }

        // Switch to different chat
        async function switchToPublicChat(chatId) {
            try {
                currentChatId = chatId;
                
                // ✅ Hide initial loading state
                const initialLoading = document.getElementById('initialLoadingState');
                const emptyState = document.getElementById('emptyChatState');
                if (initialLoading) initialLoading.classList.add('hidden');
                
                // Load chat messages
                const response = await fetch(`/api/public-chat/${chatId}/history`, {
                    credentials: 'include'
                });
                const data = await response.json();
                
                if (data.success) {
            // ✅ FIX: Check if history is hidden (empty messages but chat exists)
            if (data.messages.length === 0 && data.chat && data.chat.twinId) {
                // Show message that history is hidden
                const chatMessages = document.getElementById('chatMessages');
                chatMessages.innerHTML = `
                    <div class="text-center py-12">
                        <div class="w-16 h-16 bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Chat History Hidden</h3>
                        <p class="text-gray-600 dark:text-gray-300 mb-4">The twin owner has hidden chat history. You can still send new messages.</p>
                    </div>
                `;
                if (emptyState) emptyState.classList.add('hidden');
            } else if (data.messages.length === 0) {
                // No messages yet (new chat)
                displayMessages([]);
                if (emptyState) emptyState.classList.remove('hidden');
            } else {
                // Has messages
                displayMessages(data.messages);
                if (emptyState) emptyState.classList.add('hidden');
            }
            
            await loadPublicChatHistory(); // Refresh sidebar
        } else {
            // Error loading chat
            if (emptyState) emptyState.classList.remove('hidden');
        }

            } catch (error) {
                console.error('Error switching to chat:', error);
            }
        }

        // Delete public chat function
        async function deletePublicChat(chatId) {
            // Show confirmation dialog
            if (!confirm('Are you sure you want to delete this chat?\n\nThis action cannot be undone.')) {
                return;
            }
            
            // Find the chat item and delete button
            const chatItem = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
            const deleteBtn = chatItem?.querySelector('.delete-chat-btn');
            
            // Disable button and show loading state
            if (deleteBtn) {
                deleteBtn.disabled = true;
                deleteBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>';
            }
            
            try {
                const response = await fetch(`/api/public-chat/${chatId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include'
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Failed to delete chat');
                }
                
                const data = await response.json();
                
                // Fade-out animation before removing
                if (chatItem) {
                    chatItem.style.transition = 'opacity 0.3s ease-out';
                    chatItem.style.opacity = '0';
                    await new Promise(resolve => setTimeout(resolve, 300));
                }
                
                // If deleted chat is currently open, switch to another chat
                if (chatId === currentChatId) {
                    // Reload chat history to get updated list
                    await loadPublicChatHistory();
                    
                    // Get updated chats
                    const container = document.getElementById('publicChatHistoryList');
                    const remainingChats = container.querySelectorAll('.chat-item');
                    
                    if (remainingChats.length > 0) {
                        // Switch to first available chat
                        const firstChatId = remainingChats[0].dataset.chatId;
                        await switchToPublicChat(firstChatId);
                    } else {
                        // No chats left, create new chat or show empty state
                        currentChatId = null;
                        const messagesContainer = document.getElementById('messages');
                        if (messagesContainer) {
                            messagesContainer.innerHTML = '<div class="text-center py-8 text-gray-500 dark:text-gray-400">No chats available. Create a new chat to get started.</div>';
                        }
                        // Optionally create new chat automatically
                        await createNewPublicChat();
                    }
                } else {
                    // Just reload the chat history
                    await loadPublicChatHistory();
                }
                
                // Show success notification
                showNotification('Chat deleted successfully', 'success');
                
            } catch (error) {
                console.error('Error deleting public chat:', error);
                showNotification(error.message || 'Failed to delete chat', 'error');
                
                // Re-enable button on error
                if (deleteBtn) {
                    deleteBtn.disabled = false;
                    deleteBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
                }
            }
        }

        // Edit public chat title function
        async function editPublicChatTitle(chatId) {
            const titleElement = document.getElementById(`public-chat-title-${chatId}`);
            if (!titleElement) {
                console.error('Title element not found');
                return;
            }
            
            const currentTitle = titleElement.textContent.trim();
            
            // Create input field
            const input = document.createElement('input');
            input.type = 'text';
            input.value = currentTitle;
            input.className = 'font-medium text-sm flex-1 px-2 py-1 border border-blue-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500';
            input.style.minWidth = '100px';
            input.style.maxWidth = '200px';
            
            // Replace title with input
            const parent = titleElement.parentElement;
            titleElement.style.display = 'none';
            parent.insertBefore(input, titleElement);
            input.focus();
            input.select();
            
            // Save on Enter or blur
            const saveTitle = async () => {
                const newTitle = input.value.trim();
                
                if (newTitle === currentTitle) {
                    // No change, just restore
                    input.remove();
                    titleElement.style.display = '';
                    return;
                }
                
                if (!newTitle) {
                    // Empty title, restore original
                    input.remove();
                    titleElement.style.display = '';
                    showNotification('Title cannot be empty', 'error');
                    return;
                }
                
                try {
                    const response = await fetch(`/api/public-chat/${chatId}/title`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include',
                        body: JSON.stringify({ title: newTitle })
                    });
                    
                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.error || 'Failed to update title');
                    }
                    
                    // Update title in UI
                    titleElement.textContent = newTitle;
                    input.remove();
                    titleElement.style.display = '';
                    
                    showNotification('Title updated successfully', 'success');
                    
                    // Reload chat history to reflect changes
                    await loadPublicChatHistory();
                } catch (error) {
                    console.error('Error updating title:', error);
                    showNotification(error.message || 'Failed to update title', 'error');
                    input.remove();
                    titleElement.style.display = '';
                }
            };
            
            input.addEventListener('blur', saveTitle);
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    input.blur();
                } else if (e.key === 'Escape') {
                    input.remove();
                    titleElement.style.display = '';
                }
            });
        }

// Find createNewPublicChat function and add error handling
async function createNewPublicChat() {
    try {
        // ✅ Don't create chat immediately - store as draft
        // Generate a temporary draft chat ID
        const draftChatId = `draft_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
        
        // Store draft chat info in sessionStorage
        sessionStorage.setItem('draftPublicChat', JSON.stringify({
            chatId: draftChatId,
            twinId: currentTwinId,
            visitorId: visitorId,
            createdAt: Date.now()
        }));
        
        // Set current chat to draft
        currentChatId = draftChatId;
        
        // Clear chat messages UI
        const chatMessages = document.getElementById('chatMessages');
        if (chatMessages) chatMessages.innerHTML = '';
        
        // Show empty state
        const emptyState = document.getElementById('emptyChatState');
        if (emptyState) emptyState.classList.remove('hidden');
        
        // Disable "New Chat" button until first message is sent
        const newChatBtn = document.getElementById('newPublicChatBtn');
        if (newChatBtn) newChatBtn.disabled = true;
        
        console.log('Draft chat created:', draftChatId);
    } catch (error) {
        console.error('Error creating draft chat:', error);
        alert('Network error. Please try again.');
    }
}

        // Start public chat (load existing or create new one)
        async function startPublicChat() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                
                // ✅ For logged out users: Just create draft, no API calls
                if (!isLoggedIn) {
                    if (!currentChatId) {
                        // Check if there's a draft chat
                        const draftData = sessionStorage.getItem('draftPublicChat');
                        if (draftData) {
                            const draft = JSON.parse(draftData);
                            currentChatId = draft.chatId;
                        } else {
                            // Create draft chat (not saved to DB yet)
                            await createNewPublicChat();
                        }
                    }
                    return; // Exit - no history loading for logged out users
                }
                
                // For logged in users: Load chat history
                await loadPublicChatHistory();
                
                // ✅ Don't auto-create chat - let user send first message
                // If no existing chat, create draft instead
                if (!currentChatId) {
                    // Check if there's a draft chat
                    const draftData = sessionStorage.getItem('draftPublicChat');
                    if (draftData) {
                        const draft = JSON.parse(draftData);
                        currentChatId = draft.chatId;
                    } else {
                        // Create draft chat (not saved to DB yet)
                        await createNewPublicChat();
                    }
                }
            } catch (error) {
                console.error('Error starting chat:', error);
            }
        }

        // Display messages in chat
        function displayMessages(messages) {
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.innerHTML = '';
            
            messages.forEach(msg => {
                addMessageToChat(msg.content, msg.sender);
            });
        }

        // Add message to chat (updated to support typing indicator)
        function addMessageToChat(content, sender, isTyping = false) {
            const chatMessages = document.getElementById('chatMessages');
            const messageId = `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
            const messageDiv = document.createElement('div');
            messageDiv.id = messageId;
            messageDiv.className = `flex ${sender === 'human' ? 'justify-end' : 'justify-start'}`;
            
            if (isTyping) {
                messageDiv.innerHTML = `
                    <div class="max-w-xs lg:max-w-md px-4 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
                        <div class="flex items-center space-x-2">
                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-gray-600"></div>
                            <span class="text-sm">${content}</span>
                        </div>
                    </div>
                `;
            } else {
                messageDiv.innerHTML = `
                    <div class="max-w-xs lg:max-w-md px-4 py-2 rounded-lg ${
                        sender === 'human' 
                            ? 'bg-blue-600 text-white' 
                            : 'bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 border dark:border-gray-700'
                    }">
                        <p class="text-sm">${content}</p>
                    </div>
                `;
            }
            
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return messageId;
        }

        // Remove message helper
        function removeMessage(messageId) {
            const message = document.getElementById(messageId);
            if (message) {
                message.remove();
            }
        }

        /**
         * Display text with word-by-word typing effect (same as chat-enhanced.ejs)
         */
        function displayWithTypingEffect(sender, fullText, metadata = null, callback = null) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageId = `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
            
            const messageDiv = document.createElement('div');
            messageDiv.id = messageId;
            messageDiv.className = `flex ${sender === 'user' || sender === 'human' ? 'justify-end' : 'justify-start'}`;
            
            const messageContent = document.createElement('div');
            messageContent.className = `max-w-xs lg:max-w-md px-4 py-2 rounded-lg ${
                sender === 'user' || sender === 'human' 
                    ? 'bg-blue-600 text-white' 
                    : 'bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700'
            }`;
            
            messageDiv.appendChild(messageContent);
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            // Split into words for realistic typing
            const words = fullText.split(/(\s+)/); // Keep spaces
            let currentWordIndex = 0;
            let currentText = '';
            
            function typeNextWord() {
                if (currentWordIndex < words.length) {
                    const word = words[currentWordIndex];
                    currentText += word;
                    
                    // Show text with blinking cursor
                    messageContent.innerHTML = `
                        <p class="text-sm">${currentText}<span class="streaming-cursor" style="animation: blink 1s infinite;">▊</span></p>
                    `;
                    
                    currentWordIndex++;
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                    
                    // ✅ Variable speed: faster for short words, slower for long words
                    // Also add small random delay to feel more natural
                    const baseSpeed = word.length < 3 ? 20 : word.length < 6 ? 40 : 60;
                    const randomDelay = Math.random() * 30; // 0-30ms random
                    const speed = baseSpeed + randomDelay;
                    
                    setTimeout(typeNextWord, speed);
                } else {
                    // Typing complete - show final text
                    messageContent.innerHTML = `
                        <p class="text-sm">${fullText}</p>
                    `;
                    
                    // Call callback if provided
                    if (callback) {
                        callback(messageId);
                    }
                }
            }
            
            // Start typing
            typeNextWord();
            
            return messageId;
        }

        // Send message (updated with typing effect)

async function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput?.value.trim();
            
            if (!message || isChatting) return;
            
            isChatting = true;
            
            // ✅ Disable input and show generating state
            if (messageInput) messageInput.disabled = true;
            const sendBtn = document.getElementById('sendMessageBtn');
            if (sendBtn) {
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mx-auto"></div>';
            }
            
            // ✅ Hide empty state
            const emptyState = document.getElementById('emptyChatState');
            if (emptyState) emptyState.classList.add('hidden');

             // ✅ FIX: Handle null or draft chatId - create chat first
             let actualChatId = currentChatId;
             
             // Case 1: chatId is null or empty (logged out user, no draft)
             if (!actualChatId || actualChatId === 'null' || actualChatId === '') {
                 try {
                     // Get twinId from already defined currentTwinId variable
                     const twinId = currentTwinId;
                     if (!twinId) {
                         throw new Error('Twin ID not found');
                     }
                     
                     // Get or create visitorId (use sessionStorage for logged out users)
                     let visitorIdToUse = visitorId || sessionStorage.getItem('visitorId');
                     if (!visitorIdToUse) {
                         visitorIdToUse = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                         sessionStorage.setItem('visitorId', visitorIdToUse);
                         visitorId = visitorIdToUse;
                     }
                     
                     // Create new chat
                     const response = await fetch(`/api/public-chat/start`, {
                         method: 'POST',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         credentials: 'include',
                         body: JSON.stringify({
                             twinId: twinId,
                             visitorId: visitorIdToUse
                         })
                     });
                     
                     const data = await response.json();
                     if (data.success && data.chatId) {
                         actualChatId = data.chatId;
                         currentChatId = actualChatId;
                         // Clear any draft
                         sessionStorage.removeItem('draftPublicChat');
                         // Enable "New Chat" button
                         const newChatBtn = document.getElementById('newPublicChatBtn');
                         if (newChatBtn) newChatBtn.disabled = false;
                     } else {
                         throw new Error(data.error || 'Failed to create chat');
                     }
                 } catch (error) {
                     console.error('Error creating chat:', error);
                     alert('Failed to create chat. Please try again.');
                     isChatting = false;
                     if (messageInput) messageInput.disabled = false;
                     if (sendBtn) {
                         sendBtn.disabled = false;
                         sendBtn.textContent = 'Send';
                     }
                     return;
                 }
             }
             // Case 2: chatId is draft (starts with 'draft_')
             else if (actualChatId && actualChatId.startsWith('draft_')) {
                 // This is a draft chat - create it now
                 try {
                     const draftData = sessionStorage.getItem('draftPublicChat');
                     if (draftData) {
                         const draft = JSON.parse(draftData);
                         const response = await fetch(`/api/public-chat/start`, {
                             method: 'POST',
                             headers: {
                                 'Content-Type': 'application/json',
                             },
                             credentials: 'include',
                             body: JSON.stringify({
                                 twinId: draft.twinId,
                                 visitorId: draft.visitorId
                             })
                         });
                         
                         const data = await response.json();
                         if (data.success && data.chatId) {
                             actualChatId = data.chatId;
                             currentChatId = actualChatId;
                             // Clear draft
                             sessionStorage.removeItem('draftPublicChat');
                             // Enable "New Chat" button
                             const newChatBtn = document.getElementById('newPublicChatBtn');
                             if (newChatBtn) newChatBtn.disabled = false;
                         } else {
                             throw new Error(data.error || 'Failed to create chat');
                         }
                     } else {
                         // No draft data, create new chat
                         const twinId = currentTwinId;
                         let visitorIdToUse = visitorId || sessionStorage.getItem('visitorId');
                         if (!visitorIdToUse) {
                             visitorIdToUse = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                             sessionStorage.setItem('visitorId', visitorIdToUse);
                             visitorId = visitorIdToUse;
                         }
                         
                         const response = await fetch(`/api/public-chat/start`, {
                             method: 'POST',
                             headers: {
                                 'Content-Type': 'application/json',
                             },
                             credentials: 'include',
                             body: JSON.stringify({
                                 twinId: twinId,
                                 visitorId: visitorIdToUse
                             })
                         });
                         
                         const data = await response.json();
                         if (data.success && data.chatId) {
                             actualChatId = data.chatId;
                             currentChatId = actualChatId;
                         } else {
                             throw new Error(data.error || 'Failed to create chat');
                         }
                     }
                 } catch (error) {
                     console.error('Error creating chat:', error);
                     alert('Failed to create chat. Please try again.');
                     isChatting = false;
                     if (messageInput) messageInput.disabled = false;
                     if (sendBtn) {
                         sendBtn.disabled = false;
                         sendBtn.textContent = 'Send';
                     }
                     return;
                 }
             }
             
             // ✅ Validate actualChatId before sending
             if (!actualChatId || actualChatId === 'null' || actualChatId === '') {
                 console.error('Invalid chatId:', actualChatId);
                 alert('Chat ID is invalid. Please refresh the page and try again.');
                 isChatting = false;
                 if (messageInput) messageInput.disabled = false;
                 if (sendBtn) {
                     sendBtn.disabled = false;
                     sendBtn.textContent = 'Send';
                 }
                 return;
             }
            
            // ✅ Add user message and create typing indicator
            addMessageToChat(message, 'human');
            const typingId = addMessageToChat('Thinking...', 'ai', true);
            messageInput.value = '';
            
            try {
                const response = await fetch(`/api/public-chat/${actualChatId}/message`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ message })
                });

                const data = await response.json();
                
                // Remove typing indicator
                removeMessage(typingId);

                // ✅ FIX: Handle LOGIN_REQUIRED error
                if (!response.ok && data.errorCode === 'LOGIN_REQUIRED') {
                    alert('You are logged out. Please login to send messages to this twin.');
                    if (confirm('Would you like to go to login page?')) {
                        window.location.href = '/auth';
                    }
                    // Remove the user message that was added
                    const chatMessages = document.getElementById('chatMessages');
                    const lastMessage = chatMessages.lastElementChild;
                    if (lastMessage) lastMessage.remove();
                    isChatting = false;
                    if (messageInput) messageInput.disabled = false;
                    if (sendBtn) {
                        sendBtn.disabled = false;
                        sendBtn.textContent = 'Send';
                    }
                    return;
                }

                // ✅ Handle CHAT_NOT_FOUND error
                if (!response.ok && data.errorCode === 'CHAT_NOT_FOUND') {
                    console.error('Chat not found, creating new chat...');
                    // Try to create chat again
                    const twinId = currentTwinId;
                    let visitorIdToUse = visitorId || sessionStorage.getItem('visitorId');
                    if (!visitorIdToUse) {
                        visitorIdToUse = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                        sessionStorage.setItem('visitorId', visitorIdToUse);
                        visitorId = visitorIdToUse;
                    }
                    
                    const createResponse = await fetch(`/api/public-chat/start`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include',
                        body: JSON.stringify({
                            twinId: twinId,
                            visitorId: visitorIdToUse
                        })
                     });
                    
                    const createData = await createResponse.json();
                    if (createData.success && createData.chatId) {
                        actualChatId = createData.chatId;
                        currentChatId = actualChatId;
                        // Retry sending message
                        const retryResponse = await fetch(`/api/public-chat/${actualChatId}/message`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ message })
                        });
                        const retryData = await retryResponse.json();
                        if (retryData.success && retryData.messages) {
                            const aiMessage = retryData.messages.find(m => m.sender === 'twin');
                            if (aiMessage) {
                                displayWithTypingEffect('ai', aiMessage.content, {
                                    timestamp: aiMessage.createdAt
                                }, () => {
                                    loadPublicChatHistory();
                                });
                            }
                        } else {
                            addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
                        }
                    } else {
                        addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
                    }
                    isChatting = false;
                    if (messageInput) messageInput.disabled = false;
                    if (sendBtn) {
                        sendBtn.disabled = false;
                        sendBtn.textContent = 'Send';
                    }
                    return;
                }
                
                // ✅ PHASE 2: Handle OWN_TWIN_CHAT error
                if (!response.ok && data.errorCode === 'OWN_TWIN_CHAT') {
                    alert(data.error || 'You cannot chat with your own twin in public chat.');
                    if (data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        window.location.href = `/chat-enhanced?twinId=${currentTwinId}`;
                    }
                    isChatting = false;
                    if (messageInput) messageInput.disabled = false;
                    if (sendBtn) {
                        sendBtn.disabled = false;
                        sendBtn.textContent = 'Send';
                    }
                    return;
                }
                
                if (data.success && data.messages) {                    
                    // Find the AI message (sender: 'twin')
                    const aiMessage = data.messages.find(m => m.sender === 'twin');
                    if (aiMessage) {
                        // ✅ Use typing effect instead of direct display
                        displayWithTypingEffect('ai', aiMessage.content, {
                            timestamp: aiMessage.createdAt
                        }, () => {
                            // Callback after typing completes
                            loadPublicChatHistory(); // Refresh sidebar
                        });
                    }
                } else {
                    addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
                }
            } catch (error) {
                console.error('Send message error:', error);
                // ✅ Safety check: Remove typing indicator if it exists
                if (typingId) {
                    removeMessage(typingId);
                }
                addMessageToChat('Sorry, I encountered an error. Please try again.', 'ai');
            } finally {
                // ✅ Re-enable input and button
                isChatting = false;
                if (messageInput) messageInput.disabled = false;
                if (sendBtn) {
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'Send';
                }
            }
        }

        // Show notification function
        function showNotification(message, type = 'info') {
            // Remove existing notification if any
            const existing = document.getElementById('notification-toast');
            if (existing) {
                existing.remove();
            }
            
            // Create notification element
            const notification = document.createElement('div');
            notification.id = 'notification-toast';
            notification.className = `fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg transition-all duration-300 transform translate-x-0 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            notification.textContent = message;
            
            // Add to body
            document.body.appendChild(notification);
            
            // Animate in
            setTimeout(() => {
                notification.style.opacity = '1';
            }, 10);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        // Event listeners
        document.getElementById('newPublicChatBtn').addEventListener('click', createNewPublicChat);
        document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keydown', function(e) {
            // Enter without Shift = submit
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
            // Shift+Enter = new line (default behavior)
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', async function() {
            initializeVisitorId();
            
            // ✅ PHASE 2: Check if user is trying to chat with own twin
            const isOwnTwin = await checkOwnTwin();
            if (isOwnTwin) {
                return; // Don't proceed if own twin
            }
            
            const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
            
            // ✅ For logged out users: Hide all loading states immediately
            if (!isLoggedIn) {
                // Hide initial loading state
                const initialLoading = document.getElementById('initialLoadingState');
                if (initialLoading) initialLoading.classList.add('hidden');
                
                // Hide chat history loading state
                const chatHistoryLoading = document.getElementById('chatHistoryLoadingState');
                if (chatHistoryLoading) chatHistoryLoading.classList.add('hidden');
                
                // Show empty states
                const emptyChatState = document.getElementById('emptyChatState');
                const emptyHistoryState = document.getElementById('chatHistoryEmptyState');
                if (emptyChatState) emptyChatState.classList.remove('hidden');
                if (emptyHistoryState) emptyHistoryState.classList.remove('hidden');
                
                // Clear chat history list
                const container = document.getElementById('publicChatHistoryList');
                if (container) {
                    container.innerHTML = '';
                }
                
                // Don't load any history - just show empty state
                // User can start chatting and it will create draft chat
                return; // Exit early - no API calls for logged out users
            }
            
            // For logged in users: Load chat history
            // If initialChatId provided, load that chat
            if ('<%= initialChatId || "" %>') {
                currentChatId = '<%= initialChatId %>';
                await switchToPublicChat(currentChatId);
            } else {
                // Otherwise, load chat history and auto-select/create
                await startPublicChat();
            }
        });        
    </script>

