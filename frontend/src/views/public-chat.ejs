            </div>            

            <!-- Chat Messages -->
            <div id="chatMessages" class="flex-1 min-h-0 overflow-y-auto p-3 sm:p-4 pb-[100px] sm:pb-4 space-y-3 sm:space-y-4 bg-gray-50 dark:bg-gray-900">            
