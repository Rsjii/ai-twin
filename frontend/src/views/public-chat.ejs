                    <%- include('components/loading-skeleton', { type: 'list', count: 6 }) %>
                </div>                
                
                <!-- ✅ ADD: Empty state -->
                <div id="emptyChatState" class="hidden text-center py-12">
                    <div class="w-16 h-16 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No messages yet</h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">Start the conversation by sending a message!</p>
                </div>

                                <!-- Error State -->
                                <div id="errorState" class="hidden">
                                    <%- include('components/error-state', { 
                                        title: 'Failed to load chat',
                                        message: 'We encountered an error while loading messages. Please try again.',
                                        retryFunction: 'location.reload()'
                                    }) %>
                                </div>
                
                <!-- Messages will be loaded here -->
            </div>
            
            <!-- Chat Input -->
            <div id="chatInputSection" class="bg-gray-50 dark:bg-gray-900 p-3 sm:p-4 w-full flex-shrink-0" style="padding-bottom: calc(env(safe-area-inset-bottom) + 8px); border: none !important; box-shadow: none !important;">                
                <form id="chatForm" class="flex gap-2 sm:gap-3 md:gap-4">                    
                    <textarea 
                        type="text" 
                        id="messageInput" 
                        placeholder="Type your message..." 
                        class="flex-1 px-3 sm:px-4 py-2.5 sm:py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-base text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 resize-none"                        
                        rows="1"
                        maxlength="1000"
                        required
                        style="font-size: 16px; min-height: 44px;"
                    ></textarea>
                    <button type="submit" id="sendMessageBtn" class="bg-gradient-to-r from-primary to-accent text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold min-h-[44px] min-w-[60px] sm:min-w-[80px] touch-manipulation text-base flex items-center justify-center">                        
                        Send
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Mobile public chat sidebar toggle (ChatGPT-style, like enhanced chat)
        document.addEventListener('DOMContentLoaded', function() {
            const menuBtn  = document.getElementById('mobile-public-chat-menu-btn');
            const sidebar  = document.getElementById('chatSidebar');
    
            if (menuBtn && sidebar) {
                // Hamburger click => open/close
                menuBtn.addEventListener('click', function() {
                    const isOpen = !sidebar.classList.contains('-translate-x-full');
                    if (isOpen) {
                        sidebar.classList.add('-translate-x-full');
                    } else {
                        sidebar.classList.remove('-translate-x-full');
                    }
                });
    
                // Outside click => close (mobile only)
                document.addEventListener('click', function(e) {
                    if (window.innerWidth < 768) {
                        if (!sidebar.contains(e.target) && !menuBtn.contains(e.target)) {
                            sidebar.classList.add('-translate-x-full');
                        }
                    }
                });
            }
        });
    </script>    

    <script>
        let currentChatId = null;
        const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : (typeof twinPublicId !== "undefined" ? twinPublicId : (twin.publicId || "")) %>';
        let currentTwinId = twinToken;
        let publicAllChats = [];
        let visitorId = null;
        let isChatting = false;
        window.csrfToken = '<%= typeof csrfToken !== "undefined" && csrfToken ? csrfToken : "" %>';
            // ✅ Global human‑friendly relative time (used by sidebar + messages)
    function formatRelativeLabel(timestamp) {
        try {
            const date = new Date(timestamp);
            if (isNaN(date.getTime())) return '';
            const now = new Date();
            const diffMs = now.getTime() - date.getTime();
            const diffSec = Math.floor(diffMs / 1000);
            const diffMin = Math.floor(diffSec / 60);
            const diffHr  = Math.floor(diffMin / 60);
            const diffDay = Math.floor(diffHr / 24);
            const diffMonth = Math.floor(diffDay / 30);
            const diffYear  = Math.floor(diffDay / 365);

            if (diffSec < 60) return 'Just now';
            if (diffMin < 60) return `${diffMin} min${diffMin > 1 ? 's' : ''} ago`;
            if (diffHr  < 24) return `${diffHr} hour${diffHr > 1 ? 's' : ''} ago`;
            if (diffDay < 7)  return `${diffDay} day${diffDay > 1 ? 's' : ''} ago`;

            const weeks = Math.floor(diffDay / 7);
            if (diffDay < 30) return `${weeks} week${weeks > 1 ? 's' : ''} ago`;
            if (diffMonth < 12) return `${diffMonth} month${diffMonth > 1 ? 's' : ''} ago`;
            return `${diffYear} year${diffYear > 1 ? 's' : ''} ago`;
        } catch (e) {
            console.error('Error in formatRelativeLabel:', e);
            return '';
        }
    }
    
    // ✅ Global escapeHtml helper – used by addMessageToChat + sidebar rendering
    // NOTE: Required by addMessageToChat() and other functions that render user content
    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = String(text);
        return div.innerHTML;
    }
    
// ✅ NEW: Check if login is required on page load - SIMPLE MESSAGE
<% if (typeof requiresLogin !== 'undefined' && requiresLogin) { %>
document.addEventListener('DOMContentLoaded', function() {
    // Hide loading state
    const initialLoading = document.getElementById('initialLoadingState');
    if (initialLoading) initialLoading.classList.add('hidden');
    
    // Show simple message in chat area
    const chatMessages = document.getElementById('chatMessages');
    if (chatMessages) {
        chatMessages.innerHTML = `
            <div class="text-center py-12">
                <div class="w-16 h-16 bg-gradient-to-r from-yellow-100 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Login Required</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">You need to login to chat with this twin.</p>
                <a href="/auth?redirect=/public-twin/chat/<%= twinPublicId %>" class="inline-block bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold">                    
                    Go to Login
                </a>
            </div>
        `;
    }
    
    // Disable chat input and buttons
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendMessageBtn');
    const newChatBtn = document.getElementById('newPublicChatBtn');
    if (messageInput) messageInput.disabled = true;
    if (sendBtn) sendBtn.disabled = true;
    if (newChatBtn) newChatBtn.disabled = true;
    
    // Hide chat history loading
    const chatHistoryLoading = document.getElementById('chatHistoryLoadingState');
    if (chatHistoryLoading) chatHistoryLoading.classList.remove('hidden');
    if (chatHistoryLoading) chatHistoryLoading.classList.add('hidden');
    
    // Show empty state for chat history
    const chatHistoryEmpty = document.getElementById('chatHistoryEmptyState');
    if (chatHistoryEmpty) {
        chatHistoryEmpty.classList.remove('hidden');
        chatHistoryEmpty.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">Login required to view chat history</p>';
    }
    
    // Don't load chat history or create new chat
    return;
});
<% } %>

// ✅ PHASE 2: Check if user is trying to chat with own twin
<% if (typeof user !== 'undefined' && user && typeof twin !== 'undefined' && twin) { %>
    <%
        // Check if this twin belongs to the current user
        // We need to fetch twin owner info - for now, we'll check in frontend after page load
    %>
<% } %>

        // ✅ PHASE 2: Check own twin on page load
        async function checkOwnTwin() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                if (!isLoggedIn) return false;
                
                const response = await fetch(`/api/twin/${currentTwinId}/is-owner`, {
                    credentials: 'include'
                });
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.isOwner) {
                        // ✅ If initialChatId is provided, we're viewing history - don't redirect
                        const hasInitialChatId = '<%= initialChatId || "" %>';
                        
                        if (hasInitialChatId) {
                            // Just hide loader, history will be loaded by loadChatHistoryForViewing
                            const initialLoading = document.getElementById('initialLoadingState');
                            if (initialLoading) initialLoading.classList.add('hidden');
                            return true; // Own twin detected, but viewing history
                        } else {
                            // No chatId - trying to start new chat, show message but don't redirect
                            const initialLoading = document.getElementById('initialLoadingState');
                            if (initialLoading) initialLoading.classList.add('hidden');
                            
                            const chatMessages = document.getElementById('chatMessages');
                            chatMessages.innerHTML = `
                                <div class="text-center py-12">
                                    <div class="w-16 h-16 bg-gradient-to-r from-yellow-100 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Use Enhanced Chat</h3>
                                    <p class="text-gray-600 dark:text-gray-300 mb-4">You cannot chat with your own twin in public chat. Please use Enhanced Chat for a better experience.</p>
                                    <a href="/chat?twinId=${currentTwinId}" class="inline-block px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all duration-300 font-semibold">                                       
                                        Go to Enhanced Chat
                                    </a>
                                </div>
                            `;
                            return true; // Own twin detected
                        }
                    }
                }
                return false;
            } catch (error) {
                console.error('Error checking own twin:', error);
                return false;
            }
        }

        // Initialize visitor ID        
        function initializeVisitorId() {
            const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
            
            if (!isLoggedIn) {
                // ✅ Use sessionStorage - automatically clears on tab close
                visitorId = sessionStorage.getItem('visitorId');
                if (!visitorId) {
                    // Fresh session - generate new visitorId
                    visitorId = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    sessionStorage.setItem('visitorId', visitorId);
                }
                // Clear old localStorage if exists
                localStorage.removeItem('visitorId');
            } else {
                visitorId = null;
            }
        }

        // Load all chats for this twin
        async function loadPublicChatHistory() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                
                // ✅ For logged out users: Don't load chat history at all
                if (!isLoggedIn) {
                    // Hide loading, show empty state
                    const emptyState = document.getElementById('chatHistoryEmptyState');
                    const loadingState = document.getElementById('chatHistoryLoadingState');
                    if (loadingState) loadingState.classList.add('hidden');
                    if (emptyState) emptyState.classList.remove('hidden');
                    
                    // Clear chat history list
                    const container = document.getElementById('publicChatHistoryList');
                    if (container) {
                        container.innerHTML = '';
                    }
                    return; // No API call for logged out users
                }
                
                // ✅ Show loading state (only for logged in users)
                const loadingState = document.getElementById('chatHistoryLoadingState');
                const emptyState = document.getElementById('chatHistoryEmptyState');
                if (loadingState) loadingState.classList.remove('hidden');
                if (emptyState) emptyState.classList.add('hidden');
                
                // Build query params - backend will use userId from JWT cookie if available
                const params = new URLSearchParams();
                // ✅ For logged-out case hum already early-return kar rahe hain above
                // (yaha sirf logged-in aaega)
                if (visitorId && !isLoggedIn) {
                    params.append('visitorId', visitorId);
                }
                
                // ✅ FIX: Only use tokenized ID - backend will detokenize from path
                const response = await fetch(`/api/public-chat/twin/${currentTwinId}/chats?${params.toString()}`);
                const data = await response.json();
                
                // ✅ CRITICAL: Set server time FIRST - before any other processing
                // Force set server time - multiple fallback methods
                if (data && data.serverTime) {
                    const serverTimeStr = String(data.serverTime).trim();
                    
                    if (window && window.TimeUtils) {
                        if (typeof window.TimeUtils.setServerTime === 'function') {
                            try {
                                window.TimeUtils.setServerTime(serverTimeStr);
                            } catch (e) {
                                console.error('[loadPublicChatHistory] ❌ ERROR setting server time:', e);
                            }
                        } else {
                            // Try direct assignment as fallback
                            try {
                                if (window.TimeUtils.globalServerTime !== undefined) {
                                    window.TimeUtils.globalServerTime = serverTimeStr;
                                }
                            } catch (e2) {
                                console.error('[loadPublicChatHistory] ❌ Direct assignment failed:', e2);
                            }
                        }
                    } else {
                        console.error('[loadPublicChatHistory] ❌ window.TimeUtils not available');
                    }
                } else {
                    console.error('[loadPublicChatHistory] ❌ NO SERVER TIME IN RESPONSE');
                }
                
                // ✅ Hide loading state
                if (loadingState) loadingState.classList.add('hidden');
                
                if (data.success) {
                     // ✅ Cache all chats for search/filter
                     publicAllChats = Array.isArray(data.chats) ? data.chats : [];
                    // ✅ Call display function AFTER setting server time
                    displayPublicChatHistory(data.chats);                    
                    
                    // ✅ Show/hide empty state
                    if (data.chats && data.chats.length === 0) {
                        if (emptyState) emptyState.classList.remove('hidden');
                    } else {
                        if (emptyState) emptyState.classList.add('hidden');
                    }
                    
                    // Auto-select first chat or create new one
                    if (data.chats && data.chats.length > 0 && !currentChatId) {
                        if ('<%= initialChatId || "" %>') {
                            currentChatId = '<%= initialChatId %>';
                            await switchToPublicChat(currentChatId);
                        } else {
                            currentChatId = data.chats[0].publicId;
                            await switchToPublicChat(currentChatId);
                        }
                    } else if (!data.chats || data.chats.length === 0 && !currentChatId) {
                        // No chats exist, create draft instead
                        await createNewPublicChat();
                    }
                } else {
                    console.error('[loadPublicChatHistory] API returned error:', data.error);
                }
            } catch (error) {
                console.error('Error loading public chat history:', error);
            }
        }        

        // Display chat history
        function displayPublicChatHistory(chats) {
            const container = document.getElementById('publicChatHistoryList');
            
            if (!container) {
                console.error('[displayPublicChatHistory] Container not found!');
                return;
            }
            
            if (!chats || chats.length === 0) {
                container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">No chats yet</p>';
                return;
            }

            // ✅ NOTE: escapeHtml is now a global function (defined above), no need for local version

            // ✅ FIX: If showChatHistory is disabled, only show the latest chat
            // The backend should already filter this, but we'll ensure here too
            const chatsToDisplay = chats; // Backend already filters, but we can add extra check if needed
            
            try {
                container.innerHTML = chatsToDisplay.map(chat => `
    <div class="chat-item p-3 border-b border-gray-200 dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 rounded-lg relative group ${chat.publicId === currentChatId ? 'bg-blue-50 dark:bg-blue-900/30 border-blue-200 dark:border-blue-700' : ''}" data-chat-id="${chat.publicId}">        
        <div class="flex justify-between items-start min-w-0">
            <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1 min-w-0">
                    <h4 class="font-medium text-sm flex-1 min-w-0 truncate ${chat.publicId === currentChatId ? 'text-blue-700 dark:text-blue-400' : 'text-gray-900 dark:text-white'}" id="public-chat-title-${chat.publicId}">${escapeHtml(chat.title || 'Chat #' + (chat.publicId ? chat.publicId.slice(-6) : ''))}</h4>
                    <div class="flex items-center gap-1 flex-shrink-0">
