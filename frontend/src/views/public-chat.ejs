<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Chat with <%= twin.publicHandle %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js?v=<%= new Date().getTime() %>"></script>
    <script>
        // ✅ VERIFY TimeUtils loaded - with delay check
        (function() {
            function checkTimeUtils() {
                if (typeof window.TimeUtils === 'undefined') {
                    console.error('❌ TimeUtils not loaded! Check script path.');
                    console.error('Available scripts:', Array.from(document.scripts).map(s => s.src));
                } else {
                    console.log('✅ TimeUtils loaded successfully');
                    console.log('✅ TimeUtils.setServerTime:', typeof window.TimeUtils.setServerTime);
                    console.log('✅ TimeUtils methods:', Object.keys(window.TimeUtils));
                }
            }
            // Check immediately
            checkTimeUtils();
            // Also check after a delay (in case script loads async)
            setTimeout(checkTimeUtils, 100);
        })();
        
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script>
        // ✅ Wait for TimeUtils to be ready
        (function() {
            if (typeof window.TimeUtils === 'undefined') {
                console.error('❌ TimeUtils not loaded! Check script path.');
            } else {
                console.log('✅ TimeUtils loaded successfully');
            }
        })();
        
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
<body class="bg-gray-100 dark:bg-gray-900">
    <!--Header-->
    <%- include('header') %>

    <div class="flex flex-col md:flex-row min-h-screen md:h-screen">        
        <!-- Chat Sidebar -->
        <div id="chatSidebar" class="hidden md:flex md:w-64 flex-col bg-white dark:bg-gray-800 shadow-lg dark:shadow-gray-900 overflow-x-hidden">            
            <div class="p-4 border-b dark:border-gray-700">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Chat with <%= twin.publicHandle %></h2>
                <button id="newPublicChatBtn" class="w-full mt-2 bg-blue-600 dark:bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors" aria-label="Start new chat">
                    + New Chat
                </button>
            </div>
            
            <!-- Chat History List -->
            <div id="publicChatHistoryList" class="p-4 space-y-2 max-h-96 overflow-y-auto overflow-x-hidden">
                <!-- Loading state -->
                <div id="chatHistoryLoadingState" class="hidden">
                    <%- include('components/loading-skeleton', { type: 'list', count: 5 }) %>
                </div>                
                
                <!-- ✅ ADD: Empty state -->
                <div id="chatHistoryEmptyState" class="hidden text-center py-8">
                    <div class="w-12 h-12 bg-gradient-to-r from-blue-100 to-indigo-100 dark:from-blue-900/30 dark:to-indigo-900/30 rounded-full flex items-center justify-center mx-auto mb-3">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">No previous chats</p>
                </div>
                
                <!-- Chat items will be loaded here -->
            </div>
        </div>
        
        <!-- Main Chat Area -->
        <div class="flex-1 flex flex-col w-full md:w-auto">            
            <!-- Chat Header -->
            <div class="bg-white dark:bg-gray-800 p-3 sm:p-4 border-b dark:border-gray-700 flex items-center gap-2 sm:gap-3">
                <a href="/@<%= twin.publicHandle %>" class="flex-shrink-0 hover:opacity-80 transition-opacity" title="View @<%= twin.publicHandle %> profile" aria-label="View @<%= twin.publicHandle %> profile">
                    <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg hover:shadow-xl transition-all">
                        <%= twin.publicHandle ? twin.publicHandle.charAt(0).toUpperCase() : 'T' %>
                    </div>
                </a>
                <div class="flex-1 min-w-0">
                    <h1 class="text-xl font-semibold text-gray-900 dark:text-white truncate">Chat with @<%= twin.publicHandle %></h1>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        <% if (typeof requiresLogin !== 'undefined' && requiresLogin) { %>
                            Login required to chat with this twin.
                        <% } else { %>
                            You can chat with this AI twin without logging in!
                        <% } %>
                    </p>
                </div>
            </div>      

            <!-- Chat Messages -->
            <div id="chatMessages" class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-3 sm:space-y-4 bg-gray-50 dark:bg-gray-900">
                <!-- Initial loading state -->
                <div id="initialLoadingState" class="hidden">
                    <%- include('components/loading-skeleton', { type: 'list', count: 6 }) %>
                </div>                
                
                <!-- ✅ ADD: Empty state -->
                <div id="emptyChatState" class="hidden text-center py-12">
                    <div class="w-16 h-16 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No messages yet</h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">Start the conversation by sending a message!</p>
                </div>

                                <!-- Error State -->
                                <div id="errorState" class="hidden">
                                    <%- include('components/error-state', { 
                                        title: 'Failed to load chat',
                                        message: 'We encountered an error while loading messages. Please try again.',
                                        retryFunction: 'location.reload()'
                                    }) %>
                                </div>
                
                <!-- Messages will be loaded here -->
            </div>
            
            <!-- Chat Input -->
            <div class="bg-white dark:bg-gray-800 p-3 sm:p-4 border-t dark:border-gray-700 shadow-lg dark:shadow-gray-900">
                <form id="chatForm" class="flex gap-2 sm:gap-3 md:gap-4">                    
                    <textarea 
                        type="text" 
                        id="messageInput" 
                        placeholder="Type your message..." 
                        class="flex-1 px-3 sm:px-4 py-2.5 sm:py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 resize-none"
                        rows="1"
                        maxlength="1000"
                        required
                        style="font-size: 16px; min-height: 44px;"
                    ></textarea>
                    <button type="submit" id="sendMessageBtn" class="bg-blue-600 dark:bg-blue-500 text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-semibold min-h-[44px] min-w-[60px] sm:min-w-[80px] touch-manipulation text-base flex items-center justify-center">
                        Send
                    </button>
                </form>
            </div>            
        </div>
    </div>

    <!-- Mobile Bottom Sheet for Chat History - Enhanced UX -->
    <div id="mobileChatHistory" class="md:hidden fixed inset-0 z-50 pointer-events-none">
        <!-- Backdrop -->
        <div id="mobileChatHistoryBackdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-auto"></div>
        
        <!-- Bottom Sheet -->
        <div id="mobileChatHistorySheet" class="absolute bottom-0 left-0 right-0 bg-white dark:bg-gray-800 rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 max-h-[85vh] flex flex-col pointer-events-auto">
            <!-- Drag Handle -->
            <div class="flex justify-center pt-3 pb-2">
                <div class="w-12 h-1.5 bg-gray-300 dark:bg-gray-600 rounded-full"></div>
            </div>
            
            <!-- Header -->
            <div class="px-4 pb-4 border-b dark:border-gray-700">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Chat History</h2>
                    <button id="closeMobileHistory" class="p-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center touch-manipulation" aria-label="Close chat history">
                        <svg class="w-6 h-6 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <button id="newPublicChatBtnMobile" class="w-full bg-gradient-to-r from-blue-600 to-blue-700 dark:from-blue-500 dark:to-blue-600 text-white py-3 px-4 rounded-xl hover:shadow-lg transition-all font-semibold min-h-[48px] touch-manipulation shadow-md" aria-label="Start new chat">
                    <span class="flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Chat
                    </span>
                </button>
            </div>
            
            <!-- Chat List -->
            <div id="publicChatHistoryListMobile" class="flex-1 overflow-y-auto px-4 py-4 space-y-2">
                <!-- Chat items will be loaded here -->
            </div>
        </div>
    </div>    
    
    <!-- Mobile Chat History Toggle Button -->
    <button id="mobileHistoryToggle" class="md:hidden fixed bottom-20 right-4 bg-blue-600 dark:bg-blue-500 text-white p-4 rounded-full shadow-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors z-40" aria-label="Open chat history">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>

    <script>

    // Mobile chat history toggle - Enhanced with backdrop
    const mobileHistoryToggle = document.getElementById('mobileHistoryToggle');
    const mobileChatHistory = document.getElementById('mobileChatHistory');
    const mobileChatHistorySheet = document.getElementById('mobileChatHistorySheet');
    const mobileChatHistoryBackdrop = document.getElementById('mobileChatHistoryBackdrop');
    const closeMobileHistoryBtn = document.getElementById('closeMobileHistory');
    
    function openMobileHistory() {
        if (mobileChatHistory && mobileChatHistorySheet && mobileChatHistoryBackdrop) {
            mobileChatHistory.classList.remove('pointer-events-none');
            mobileChatHistorySheet.classList.remove('translate-y-full');
            mobileChatHistoryBackdrop.classList.remove('opacity-0');
            mobileChatHistoryBackdrop.classList.add('opacity-100');
            document.body.style.overflow = 'hidden';
        }
    }
    
    function closeMobileHistory() {
        if (mobileChatHistory && mobileChatHistorySheet && mobileChatHistoryBackdrop) {
            mobileChatHistorySheet.classList.add('translate-y-full');
            mobileChatHistoryBackdrop.classList.remove('opacity-100');
            mobileChatHistoryBackdrop.classList.add('opacity-0');
            setTimeout(() => {
                mobileChatHistory.classList.add('pointer-events-none');
                document.body.style.overflow = '';
            }, 300);
        }
    }
    
    if (mobileHistoryToggle) {
        mobileHistoryToggle.addEventListener('click', openMobileHistory);
    }
    
    if (closeMobileHistoryBtn) {
        closeMobileHistoryBtn.addEventListener('click', closeMobileHistory);
    }
    
    // Close on backdrop click
    if (mobileChatHistoryBackdrop) {
        mobileChatHistoryBackdrop.addEventListener('click', closeMobileHistory);
    }
    
    // Swipe down to close (optional enhancement)
    let touchStartY = 0;
    let touchEndY = 0;
    
    if (mobileChatHistorySheet) {
        mobileChatHistorySheet.addEventListener('touchstart', (e) => {
            touchStartY = e.changedTouches[0].screenY;
        }, { passive: true });
        
        mobileChatHistorySheet.addEventListener('touchend', (e) => {
            touchEndY = e.changedTouches[0].screenY;
            const swipeDistance = touchStartY - touchEndY;
            if (swipeDistance < -100) { // Swipe down
                closeMobileHistory();
            }
        }, { passive: true });
    }    

    </script>

    <script>
        let currentChatId = null;
        // ✅ PHASE 2: Use tokenized twinPublicId instead of raw twin.id
        let currentTwinId = '<%= typeof twinPublicId !== 'undefined' ? twinPublicId : (twin.publicId || '') %>';
        let visitorId = null;
        let isChatting = false;
    
// ✅ NEW: Check if login is required on page load - SIMPLE MESSAGE
<% if (typeof requiresLogin !== 'undefined' && requiresLogin) { %>
document.addEventListener('DOMContentLoaded', function() {
    // Hide loading state
    const initialLoading = document.getElementById('initialLoadingState');
    if (initialLoading) initialLoading.classList.add('hidden');
    
    // Show simple message in chat area
    const chatMessages = document.getElementById('chatMessages');
    if (chatMessages) {
        chatMessages.innerHTML = `
            <div class="text-center py-12">
                <div class="w-16 h-16 bg-gradient-to-r from-yellow-100 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Login Required</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">You need to login to chat with this twin.</p>
                <a href="/auth?redirect=/public-twin/chat/<%= twinPublicId %>" class="inline-block bg-blue-600 dark:bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-semibold">
                    Go to Login
                </a>
            </div>
        `;
    }
    
    // Disable chat input and buttons
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendMessageBtn');
    const newChatBtn = document.getElementById('newPublicChatBtn');
    if (messageInput) messageInput.disabled = true;
    if (sendBtn) sendBtn.disabled = true;
    if (newChatBtn) newChatBtn.disabled = true;
    
    // Hide chat history loading
    const chatHistoryLoading = document.getElementById('chatHistoryLoadingState');
    if (chatHistoryLoading) chatHistoryLoading.classList.remove('hidden');
    if (chatHistoryLoading) chatHistoryLoading.classList.add('hidden');
    
    // Show empty state for chat history
    const chatHistoryEmpty = document.getElementById('chatHistoryEmptyState');
    if (chatHistoryEmpty) {
        chatHistoryEmpty.classList.remove('hidden');
        chatHistoryEmpty.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">Login required to view chat history</p>';
    }
    
    // Don't load chat history or create new chat
    return;
});
<% } %>

// ✅ PHASE 2: Check if user is trying to chat with own twin
<% if (typeof user !== 'undefined' && user && typeof twin !== 'undefined' && twin) { %>
    <%
        // Check if this twin belongs to the current user
        // We need to fetch twin owner info - for now, we'll check in frontend after page load
    %>
<% } %>

        // ✅ PHASE 2: Check own twin on page load
        async function checkOwnTwin() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                if (!isLoggedIn) return false;
                
                const response = await fetch(`/api/twin/${currentTwinId}/is-owner`, {
                    credentials: 'include'
                });
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.isOwner) {
                        // ✅ If initialChatId is provided, we're viewing history - don't redirect
                        const hasInitialChatId = '<%= initialChatId || "" %>';
                        
                        if (hasInitialChatId) {
                            // Just hide loader, history will be loaded by loadChatHistoryForViewing
                            const initialLoading = document.getElementById('initialLoadingState');
                            if (initialLoading) initialLoading.classList.add('hidden');
                            return true; // Own twin detected, but viewing history
                        } else {
                            // No chatId - trying to start new chat, show message but don't redirect
                            const initialLoading = document.getElementById('initialLoadingState');
                            if (initialLoading) initialLoading.classList.add('hidden');
                            
                            const chatMessages = document.getElementById('chatMessages');
                            chatMessages.innerHTML = `
                                <div class="text-center py-12">
                                    <div class="w-16 h-16 bg-gradient-to-r from-yellow-100 to-orange-100 dark:from-yellow-900/30 dark:to-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Use Enhanced Chat</h3>
                                    <p class="text-gray-600 dark:text-gray-300 mb-4">You cannot chat with your own twin in public chat. Please use Enhanced Chat for a better experience.</p>
                                    <a href="/chat-enhanced?twinId=${currentTwinId}" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                        Go to Enhanced Chat
                                    </a>
                                </div>
                            `;
                            return true; // Own twin detected
                        }
                    }
                }
                return false;
            } catch (error) {
                console.error('Error checking own twin:', error);
                return false;
            }
        }

        // Initialize visitor ID        
        function initializeVisitorId() {
            const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
            
            if (!isLoggedIn) {
                // ✅ Use sessionStorage - automatically clears on tab close
                visitorId = sessionStorage.getItem('visitorId');
                if (!visitorId) {
                    // Fresh session - generate new visitorId
                    visitorId = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    sessionStorage.setItem('visitorId', visitorId);
                }
                // Clear old localStorage if exists
                localStorage.removeItem('visitorId');
            } else {
                visitorId = null;
            }
        }

        // Load all chats for this twin
        async function loadPublicChatHistory() {
            try {
                const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
                
                // ✅ For logged out users: Don't load chat history at all
                if (!isLoggedIn) {
                    // Hide loading, show empty state
                    const emptyState = document.getElementById('chatHistoryEmptyState');
                    const loadingState = document.getElementById('chatHistoryLoadingState');
                    if (loadingState) loadingState.classList.add('hidden');
                    if (emptyState) emptyState.classList.remove('hidden');
                    
                    // Clear chat history list
                    const container = document.getElementById('publicChatHistoryList');
                    if (container) {
                        container.innerHTML = '';
                    }
                    return; // No API call for logged out users
                }
                
                // ✅ Show loading state (only for logged in users)
                const loadingState = document.getElementById('chatHistoryLoadingState');
                const emptyState = document.getElementById('chatHistoryEmptyState');
                if (loadingState) loadingState.classList.remove('hidden');
                if (emptyState) emptyState.classList.add('hidden');
                
                // Build query params - backend will use userId from JWT cookie if available
                const params = new URLSearchParams();
                if (visitorId && !isLoggedIn) {
                    params.append('visitorId', visitorId);
                }
                
                const response = await fetch(`/api/public-chat/twin/${currentTwinId}/chats?${params.toString()}`);
                const data = await response.json();
                
                // ✅ CRITICAL: Set server time FIRST - before any other processing
                // Force immediate execution with explicit check
                console.log('[loadPublicChatHistory] ========== SERVER TIME SETUP START ==========');
                console.log('[loadPublicChatHistory] Full data object:', JSON.stringify(data, null, 2));
                console.log('[loadPublicChatHistory] data.serverTime value:', data.serverTime);
                console.log('[loadPublicChatHistory] data.serverTime type:', typeof data.serverTime);
                console.log('[loadPublicChatHistory] window object exists:', typeof window !== 'undefined');
                console.log('[loadPublicChatHistory] window.TimeUtils exists:', typeof window.TimeUtils);
                
                // Force set server time - multiple fallback methods
                if (data && data.serverTime) {
                    const serverTimeStr = String(data.serverTime).trim();
                    console.log('[loadPublicChatHistory] serverTimeStr:', serverTimeStr);
                    
                    if (window && window.TimeUtils) {
                        console.log('[loadPublicChatHistory] TimeUtils object:', window.TimeUtils);
                        console.log('[loadPublicChatHistory] setServerTime exists:', 'setServerTime' in window.TimeUtils);
                        console.log('[loadPublicChatHistory] setServerTime type:', typeof window.TimeUtils.setServerTime);
                        
                        if (typeof window.TimeUtils.setServerTime === 'function') {
                            try {
                                window.TimeUtils.setServerTime(serverTimeStr);
                                console.log('[loadPublicChatHistory] ✅✅✅ SERVER TIME SET SUCCESSFULLY:', serverTimeStr);
                                console.log('[loadPublicChatHistory] ✅ Verified globalServerTime:', window.TimeUtils.globalServerTime);
                            } catch (e) {
                                console.error('[loadPublicChatHistory] ❌ ERROR setting server time:', e);
                                console.error('[loadPublicChatHistory] Error stack:', e.stack);
                            }
                        } else {
                            console.error('[loadPublicChatHistory] ❌ setServerTime is not a function');
                            // Try direct assignment as fallback
                            try {
                                if (window.TimeUtils.globalServerTime !== undefined) {
                                    window.TimeUtils.globalServerTime = serverTimeStr;
                                    console.log('[loadPublicChatHistory] ✅ Set via direct assignment');
                                }
                            } catch (e2) {
                                console.error('[loadPublicChatHistory] ❌ Direct assignment also failed:', e2);
                            }
                        }
                    } else {
                        console.error('[loadPublicChatHistory] ❌ window.TimeUtils not available');
                        console.error('[loadPublicChatHistory] window keys:', Object.keys(window).slice(0, 20));
                    }
                } else {
                    console.error('[loadPublicChatHistory] ❌ NO SERVER TIME IN RESPONSE');
                    console.error('[loadPublicChatHistory] data keys:', data ? Object.keys(data) : 'data is null');
                }
                console.log('[loadPublicChatHistory] ========== SERVER TIME SETUP END ==========');
                
                // Now continue with rest of the code
                console.log('[loadPublicChatHistory] Response received:', data);
                console.log('[loadPublicChatHistory] Chats count:', data.chats?.length || 0);
                
                // ✅ Hide loading state
                if (loadingState) loadingState.classList.add('hidden');
                
                if (data.success) {
                    console.log('[loadPublicChatHistory] Displaying chats:', data.chats);
                    // ✅ Call display function AFTER setting server time
                    displayPublicChatHistory(data.chats);                    
                    
                    // ✅ Show/hide empty state
                    if (data.chats && data.chats.length === 0) {
                        if (emptyState) emptyState.classList.remove('hidden');
                    } else {
                        if (emptyState) emptyState.classList.add('hidden');
                    }
                    
                    // Auto-select first chat or create new one
                    if (data.chats && data.chats.length > 0 && !currentChatId) {
                        if ('<%= initialChatId || "" %>') {
                            currentChatId = '<%= initialChatId %>';
                            await switchToPublicChat(currentChatId);
                        } else {
                            currentChatId = data.chats[0].publicId;
                            await switchToPublicChat(currentChatId);
                        }
                    } else if (!data.chats || data.chats.length === 0 && !currentChatId) {
                        // No chats exist, create draft instead
                        await createNewPublicChat();
                    }
                } else {
                    console.error('[loadPublicChatHistory] API returned error:', data.error);
                }
            } catch (error) {
