<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Chat with <%= twin.publicHandle %></title>
    <link rel="stylesheet" href="/css/output.css?v=<%= Date.now() %>">    
    <script src="/utils/timeUtils.js?v=<%= new Date().getTime() %>"></script>
    <script>
        // ✅ VERIFY TimeUtils loaded - with delay check
        (function() {
            function checkTimeUtils() {
                if (typeof window.TimeUtils === 'undefined') {
                    console.error('❌ TimeUtils not loaded! Check script path.');
                    console.error('Available scripts:', Array.from(document.scripts).map(s => s.src));
                }
            }
            // Check immediately
            checkTimeUtils();
            // Also check after a delay (in case script loads async)
            setTimeout(checkTimeUtils, 100);
        })();
        
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script>
        // ✅ Wait for TimeUtils to be ready
        (function() {
            if (typeof window.TimeUtils === 'undefined') {
                console.error('❌ TimeUtils not loaded! Check script path.');
            }
        })();
        
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script>
        // ✅ NEW: Set quota exceeded status from server (for both anonymous and logged-in users)
        window.__quotaExceeded = <%= typeof quotaExceeded !== 'undefined' && quotaExceeded ? 'true' : 'false' %>;
        if (window.__quotaExceeded) {
            // Quota exceeded - chat will be locked
        }
    </script>
</head>
<body class="bg-gray-100 dark:bg-gray-900 h-screen overflow-hidden flex flex-col">    
    <!--Header-->
    <%- include('header') %>

    <div class="flex flex-col md:flex-row w-full flex-1 min-h-0 overflow-hidden">        
        <!-- Chat Sidebar -->
        <div
        id="chatSidebar"
        class="fixed top-16 bottom-0 left-0 w-72 bg-white dark:bg-gray-800 shadow-xl z-40 transform -translate-x-full transition-transform duration-200 ease-out flex flex-col min-h-0 overflow-x-hidden md:static md:transform-none md:w-64 md:h-full md:shadow-lg md:border-r border-gray-200 dark:border-gray-700"   
    >    
