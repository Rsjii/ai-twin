    <!-- Public Chat – sidebar search -->
    <script>
        // Public Chat – sidebar search
        let publicSearchTimeout;
        const publicSearchInput = document.getElementById('publicChatSearchInput');

        function applyPublicChatSearch(query) {
            if (!Array.isArray(publicAllChats)) return;
            const q = (query || '').trim().toLowerCase();
            const source = publicAllChats;
            const filtered = q
                ? source.filter(chat => {
                    const title = (chat.title || '').toLowerCase();
                    const lastRaw = chat.lastMessage
                        ? (typeof chat.lastMessage === 'string'
                            ? chat.lastMessage
                            : (chat.lastMessage.content || ''))
                        : '';
                    const last = lastRaw.toLowerCase();
                    return title.includes(q) || last.includes(q);
                })
                : source;
            displayPublicChatHistory(filtered);
        }

        if (publicSearchInput) {
            publicSearchInput.addEventListener('input', (e) => {
                const value = e.target.value;
                if (publicSearchTimeout) clearTimeout(publicSearchTimeout);
                publicSearchTimeout = setTimeout(() => applyPublicChatSearch(value), 150);
            });
        }
    </script>
    <%- include('partials/modal-helpers') %>
