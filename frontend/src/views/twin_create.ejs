<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen font-inter">
    <!-- Header -->
    <header class="bg-white/80 backdrop-blur-xl border-b border-white/20 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <a href="/" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" stroke="currentColor" fill="none">
                                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </a>
                </div>
                
                <!-- Navigation -->
                <nav class="hidden md:flex space-x-8">
                    <a href="/dashboard" class="text-gray-600 hover:text-primary transition-colors font-medium">Dashboard</a>
                    <a href="/profile" class="text-gray-600 hover:text-primary transition-colors font-medium">Profile</a>
                    <a href="/onboarding" class="text-primary font-semibold">Create Twin</a>
                </nav>
                
                <!-- User Menu -->
                <div class="flex items-center space-x-4">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="flex items-center space-x-3">
                            <% if (user.profileImage) { %>
                                <img src="<%= user.profileImage %>" alt="Profile" class="w-10 h-10 rounded-full object-cover shadow-lg" loading="lazy">
                            <% } else { %>
                                <div class="w-10 h-10 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg">
                                    <%= (user.handle || user.email).charAt(0).toUpperCase() %>
                                </div>
                            <% } %>
                            <div class="hidden sm:block text-left">
                                <div class="text-sm font-semibold text-gray-900"><%= user.handle || user.email %></div>
                                <div class="text-xs text-gray-500"><%= user.email %></div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <div class="px-3 sm:px-4 py-6 sm:py-8">
    <div class="max-w-4xl mx-auto">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8">
                <div class="mb-6 sm:mb-8">
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Create Your AI Twin</h1>
                    <p class="text-gray-600 dark:text-gray-300">Complete our enhanced onboarding to create an AI version of yourself with comprehensive personality analysis and communication style.</p>
                </div>

                <!-- Enhanced Onboarding Steps -->
                <div class="mb-6 sm:mb-8">
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 text-center">
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-semibold mb-2">1</div>
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Basic Info</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-semibold mb-2">2</div>
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Personality</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-semibold mb-2">3</div>
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Tone & Style</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-semibold mb-2">4</div>
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Create Twin</span>
                        </div>
                    </div>
                </div>

                <!-- Enhanced Onboarding Description -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900 p-4 sm:p-6 lg:p-8">
                    <div class="text-center mb-6 sm:mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Enhanced AI Twin Creation</h2>
                        <p class="text-gray-600 dark:text-gray-300 mb-6">Our new onboarding process creates a more accurate and personalized AI twin by analyzing your personality, communication style, and preferences.</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 md:gap-6 mb-6 sm:mb-8">
                        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-3">🎯 Personality Analysis</h3>
                            <p class="text-blue-800 dark:text-blue-200">Complete OCEAN Big Five personality assessment to understand your core traits and communication patterns.</p>
                        </div>
                        <div class="bg-green-50 dark:bg-green-900/20 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg font-semibold text-green-900 dark:text-green-100 mb-3">💬 Communication Style</h3>
                            <p class="text-green-800 dark:text-green-200">Fine-tune your AI twin's tone, formality level, humor style, and language preferences.</p>
                        </div>
                        <div class="bg-purple-50 dark:bg-purple-900/20 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg font-semibold text-purple-900 dark:text-purple-100 mb-3">📝 Writing Patterns</h3>
                            <p class="text-purple-800 dark:text-purple-200">Customize greetings, closings, punctuation style, and vocabulary level to match your writing.</p>
                        </div>
                        <div class="bg-orange-50 dark:bg-orange-900/20 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg font-semibold text-orange-900 dark:text-orange-100 mb-3">🎨 Context & Interests</h3>
                            <p class="text-orange-800 dark:text-orange-200">Provide background information, interests, and use cases to make your AI twin more contextual.</p>
                        </div>
                    </div>

                    <!-- Start Button -->
                    <div class="text-center">
                        <a 
                            href="/onboarding"
                            class="inline-block bg-primary text-white px-4 sm:px-8 py-2.5 sm:py-3 rounded-lg hover:bg-secondary transition-colors font-semibold text-lg min-h-[44px] touch-manipulation text-base"
                            aria-label="Start Enhanced Onboarding"
                        >
                            Start Enhanced Onboarding
                        </a>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-3">Takes about 5-10 minutes to complete</p>
                    </div>
                </div>
        </div>
    </div>
</div>

</body>
</html>