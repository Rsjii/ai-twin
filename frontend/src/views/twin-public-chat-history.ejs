<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Public Chat History - My Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen">
    <%- include('header') %>
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">Public Chat History</h1>
                    <p class="text-gray-600 dark:text-gray-300">View all public chats that users have had with your AI twin</p>
                </div>
                <a href="/twin/manage" class="px-4 py-2 bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                    Back to Manage
                </a>
            </div>
        </div>

        <!-- Chats List -->
        <div id="chatsContainer" class="space-y-4 mb-8">
            <div class="text-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto"></div>
                <p class="mt-4 text-gray-600 dark:text-gray-400">Loading public chats...</p>
            </div>
        </div>

        <!-- Pagination -->
        <div id="paginationContainer" class="mt-8"></div>
    </main>

    <%- include('footer') %>

    <!-- Pagination Script -->
    <script src="/utils/pagination.js"></script>
    
    <script>
        const twinId = '<%= twinId %>';
        let currentPage = 1;
        let pagination = null;

        // Load public chat history
        async function loadPublicChatHistory(page = 1) {
            try {
                const response = await fetch(`/api/public-chat/twin/${twinId}/all-chats?page=${page}&limit=20`, {
                    credentials: 'include'
                });
                
                const data = await response.json();

                if (data.success) {
                    displayChats(data.chats);
                    
                    // Initialize or update pagination
                    if (!pagination) {
                        pagination = new Pagination({
                            container: document.getElementById('paginationContainer'),
                            currentPage: data.pagination.currentPage,
                            totalPages: data.pagination.totalPages,
                            totalItems: data.pagination.totalItems,
                            itemsPerPage: data.pagination.itemsPerPage,
                            onPageChange: (page) => {
                                currentPage = page;
                                loadPublicChatHistory(page);
                                window.scrollTo({ top: 0, behavior: 'smooth' });
                            }
                        });
                    } else {
                        pagination.update({
                            currentPage: data.pagination.currentPage,
                            totalPages: data.pagination.totalPages,
                            totalItems: data.pagination.totalItems
                        });
                    }
                } else {
                    showError(data.error || 'Failed to load public chats');
                }
            } catch (error) {
                console.error('Load public chat history error:', error);
                showError('Network error. Please try again.');
            }
        }

        function displayChats(chats) {
            const container = document.getElementById('chatsContainer');
            
            if (chats.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <p class="text-gray-600 dark:text-gray-400">No public chats yet</p>
                        <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">Users haven't started any public chats with your twin</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = chats.map(chat => `
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                ${chat.user ? `
                                    <a href="/user/${escapeHtml(chat.user.handle)}" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                                        ${chat.user.profileImage ? `
                                            <img src="${escapeHtml(chat.user.profileImage)}" alt="${escapeHtml(chat.user.name || chat.user.handle)}" class="w-10 h-10 rounded-full">
                                        ` : `
                                            <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                                                <span class="text-primary font-semibold">${escapeHtml((chat.user.name || chat.user.handle || 'U').charAt(0).toUpperCase())}</span>
                                            </div>
                                        `}
                                        <div>
                                            <h3 class="font-semibold text-gray-900 dark:text-white">${escapeHtml(chat.user.name || chat.user.handle || 'Unknown User')}</h3>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">@${escapeHtml(chat.user.handle || 'unknown')}</p>
                                        </div>
                                    </a>
                                ` : `
                                    <div class="flex items-center gap-2">
                                        <div class="w-10 h-10 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
                                            <span class="text-gray-600 dark:text-gray-300 font-semibold">?</span>
                                        </div>
                                        <div>
                                            <h3 class="font-semibold text-gray-900 dark:text-white">Anonymous User</h3>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">Visitor ID: ${escapeHtml(chat.visitorId?.substring(0, 8) || 'unknown')}</p>
                                        </div>
                                    </div>
                                `}
                            </div>
                            <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400 mt-2">
                                <span>${chat.messageCount} messages</span>
                                <span>•</span>
                                <span>${new Date(chat.createdAt).toLocaleDateString()}</span>
                                ${chat.lastMessage ? `
                                    <span>•</span>
                                    <span>Last: ${new Date(chat.lastMessage.createdAt).toLocaleDateString()}</span>
                                ` : ''}
                            </div>
                            ${chat.lastMessage ? `
                                <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 truncate">${escapeHtml(chat.lastMessage.content)}</p>
                            ` : ''}
                        </div>
                        <a 
                            href="/twin/${chat.twinId}/view-chat-history/${chat.id}" 
                            class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors whitespace-nowrap"
                        >
                            View Chat
                        </a>           
                    </div>
                </div>
            `).join('');
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showError(message) {
            const container = document.getElementById('chatsContainer');
            container.innerHTML = `
                <div class="text-center py-12">
                    <p class="text-red-500">${escapeHtml(message)}</p>
                </div>
            `;
        }

        // Load on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadPublicChatHistory(1);
        });
    </script>
</body>
</html>
