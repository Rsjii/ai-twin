<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Public Chat History - My Twin</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen">
    <%- include('header') %>
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-2">Public Chat History</h1>
                    <p class="text-gray-600 dark:text-gray-300">View all public chats that users have had with your AI twin</p>
                </div>
                <a href="/twin/manage" class="w-full sm:w-auto inline-flex justify-center px-4 py-2 bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-600 transition-colors">
                    Back to Manage
                </a>
            </div>
        </div>

        <!-- View Toggle (Chat-wise / User-wise) -->
        <div class="flex items-center gap-2 mb-3 sm:mb-4">
            <span class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">View:</span>
            <button 
                id="viewChatBtn" 
                class="px-3 py-1.5 rounded-full text-xs sm:text-sm bg-primary text-white"
            >
                Chat-wise
            </button>
            <button 
                id="viewUserBtn" 
                class="px-3 py-1.5 rounded-full text-xs sm:text-sm bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600"
            >
                User-wise
            </button>
        </div>

        <!-- Quick Filters Row (mobile-friendly, Amazon-style) -->
        <div class="flex items-center gap-2 mb-4 sm:mb-6">
            <!-- Left: Filters button to open full filter screen -->
            <button
                id="openTwinFiltersSheetBtn"
                class="flex-shrink-0 inline-flex items-center justify-center px-3 py-2 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-xs sm:text-sm text-gray-700 dark:text-gray-200 shadow-sm touch-manipulation"
                type="button"
            >
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 4h18M4 8h16M5 12h14M6 16h12M7 20h10"></path>
                </svg>
                <span>Filters</span>
            </button>

            <!-- Right: horizontal scrollable chips -->
            <div class="flex-1 overflow-x-auto scrollbar-hide">
                <div class="flex flex-row gap-2">
                    <!-- Time chips -->
                    <button
                        class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-primary/40 bg-primary/10 text-primary dark:border-primary/40 dark:bg-primary/20 dark:text-primary whitespace-nowrap touch-manipulation"
                        data-filter-type="time"
                        data-filter-value="all"
                    >
                        All time
                    </button>
                    <button
                        class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                        data-filter-type="time"
                        data-filter-value="today"
                    >
                        Today
                    </button>
                    <button
                        class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                        data-filter-type="time"
                        data-filter-value="7days"
                    >
                        Last 7 days
                    </button>
                    <button
                        class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                        data-filter-type="time"
                        data-filter-value="30days"
                    >
                        Last 30 days
                    </button>

                    <!-- Sort chip -->
                    <button
                        class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                        data-filter-type="sort"
                        data-filter-value="messageCount"
                    >
                        Most messages
                    </button>

                    <!-- Participant chips (chat-wise only) -->
                    <div class="twin-filter-chat-only flex gap-2">
                        <button
                            class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                            data-filter-type="participant"
                            data-filter-value="loggedIn"
                        >
                            Logged-in
                        </button>
                        <button
                            class="twin-filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                            data-filter-type="participant"
                            data-filter-value="anonymous"
                        >
                            Anonymous
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hidden filter inputs (for JavaScript compatibility - synced with quick filters and mobile sheet) -->
        <div class="hidden">
            <input type="text" id="filterSearch" value="">
            <input type="date" id="filterDateFrom" value="">
            <input type="date" id="filterDateTo" value="">
            <select id="filterSortBy">
                <option value="lastActivity">Last Activity</option>
                <option value="createdAt">Date Created</option>
                <option value="messageCount">Message Count</option>
            </select>
            <select id="filterUserSortBy">
                <option value="lastActivity">Last Activity</option>
                <option value="totalMessages">Total Messages</option>
                <option value="totalChats">Total Chats</option>
            </select>
            <input type="number" id="filterMinMessages" value="">
            <input type="number" id="filterMaxMessages" value="">
            <select id="quickDatePreset">
                <option value="">Select preset</option>
                <option value="today">Today</option>
                <option value="7days">Last 7 days</option>
                <option value="30days">Last 30 days</option>
                <option value="90days">Last 90 days</option>
            </select>
            <select id="filterParticipantType">
                <option value="all">All (anonymous + logged-in)</option>
                <option value="loggedIn">Logged-in only</option>
                <option value="anonymous">Anonymous only</option>
            </select>
            <div id="activeFiltersContainer"></div>
            <div id="participantFilterContainer"></div>
            <div id="userSortByContainer" class="hidden"></div>
            <button id="applyFiltersBtn"></button>
            <button id="clearFiltersBtn"></button>
        </div>

        <!-- Chats List -->
        <div id="chatsContainer" class="space-y-4 mb-8">
            <div class="text-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto"></div>
                <p class="mt-4 text-gray-600 dark:text-gray-400">Loading public chats...</p>
            </div>
        </div>

        <!-- Pagination -->
        <%- include('shared/pagination', {
            containerId: 'paginationContainer',
            loadFunction: 'loadPublicChatHistory',
            scrollToTop: true,
            className: 'mt-8'
        }) %>

        <!-- Full Filter Sheet (mobile-friendly, slides up from bottom) -->
        <div id="twinFiltersSheetOverlay" class="fixed inset-0 z-40 bg-black/40 hidden">
            <div class="absolute inset-x-0 bottom-0 bg-white dark:bg-gray-900 rounded-t-2xl max-h-[80vh] shadow-2xl flex flex-col">
                <!-- Header -->
                <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold text-gray-900 dark:text-white">Filters</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Refine your public chat history</p>
                    </div>
                    <button id="closeTwinFiltersSheetBtn"
                            class="inline-flex items-center justify-center w-8 h-8 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 dark:text-gray-300"
                            type="button">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <!-- Filter content -->
                <div class="flex-1 overflow-y-auto px-4 py-3 space-y-4 text-sm">
                    <!-- Search -->
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Search Messages</label>
                        <input
                            type="text"
                            id="twinFilterSheetSearch"
                            placeholder="Search in messages..."
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm"
                        >
                    </div>

                    <!-- Quick date -->
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Quick Date</label>
                        <select
                            id="twinFilterSheetQuickDate"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm"
                        >
                            <option value="">None</option>
                            <option value="today">Today</option>
                            <option value="7days">Last 7 days</option>
                            <option value="30days">Last 30 days</option>
                            <option value="90days">Last 90 days</option>
                        </select>
                    </div>

                    <!-- Sort -->
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Sort By</label>
                        <select
                            id="twinFilterSheetSortBy"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm"
                        >
                            <option value="lastActivity">Last Activity</option>
                            <option value="createdAt">Date Created</option>
                            <option value="messageCount">Message Count</option>
                        </select>
                    </div>

                    <!-- Participants (chat-wise only) -->
                    <div id="twinFilterSheetParticipantBlock">
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Participants</label>
                        <select
                            id="twinFilterSheetParticipantType"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm"
                        >
                            <option value="all">All (anonymous + logged-in)</option>
                            <option value="loggedIn">Logged-in only</option>
                            <option value="anonymous">Anonymous only</option>
                        </select>
                    </div>
                </div>

                <!-- Footer buttons -->
                <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 flex gap-3">
                    <button id="twinFiltersClearBtn"
                            class="flex-1 px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-xs sm:text-sm text-gray-700 dark:text-gray-200">
                        Clear
                    </button>
                    <button id="twinFiltersApplyBtn"
                            class="flex-1 px-4 py-2.5 rounded-xl bg-gradient-to-r from-primary to-accent text-xs sm:text-sm text-white font-semibold shadow-md">
                        Apply
                    </button>
                </div>
            </div>
        </div>
    </main>

    <%- include('footer/footer-conditional-private') %>

    <script>
        const twinId = '<%= twinPublicId %>';
        // ✅ FIX: Read view and page from URL on init
        const urlParams = new URLSearchParams(window.location.search);
        let currentPage = parseInt(urlParams.get('page')) || 1;
        let currentView = urlParams.get('view') || 'chat';
        // Validate view
        if (currentView !== 'chat' && currentView !== 'user') {
            currentView = 'chat';
        }
        let currentFilters = {
            userId: urlParams.get('userId') || '',
            dateFrom: urlParams.get('dateFrom') || '',
            dateTo: urlParams.get('dateTo') || '',
            search: urlParams.get('search') || '',
            sortBy: urlParams.get('sortBy') || 'lastActivity',
            minMessages: urlParams.get('minMessages') || '',
            maxMessages: urlParams.get('maxMessages') || '',
            userSortBy: urlParams.get('userSortBy') || 'lastActivity',
            participantType: urlParams.get('participantType') || 'all',
        };

        let searchDebounceTimer = null;
        
        // Load public chat history
        async function loadPublicChatHistory(page = 1) {
            try {
                currentPage = page;
                
                // ✅ FIX: Update URL with current page and view
                const url = new URL(window.location);
                url.searchParams.set('page', page.toString());
                url.searchParams.set('view', currentView);
                window.history.replaceState({}, '', url);
                
                // Build query params
                const params = new URLSearchParams({
                    page: page.toString(),
                    limit: '10',
                    view: currentView,
                    sortBy: currentView === 'user' ? currentFilters.userSortBy : currentFilters.sortBy
                });
                
                if (currentFilters.userId) params.append('userId', currentFilters.userId);
                if (currentFilters.dateFrom) params.append('dateFrom', currentFilters.dateFrom);
                if (currentFilters.dateTo) params.append('dateTo', currentFilters.dateTo);
                if (currentFilters.search) params.append('search', currentFilters.search);
                // ✅ NEW: Advanced filters
                if (currentFilters.minMessages) params.append('minMessages', currentFilters.minMessages);
                if (currentFilters.maxMessages) params.append('maxMessages', currentFilters.maxMessages);
                // ✅ NEW: User sort (only for user-wise view)
                if (currentView === 'user' && currentFilters.userSortBy) {
                    params.append('userSortBy', currentFilters.userSortBy);
                }
                // ✅ NEW: Participant type filter
                if (currentFilters.participantType && currentFilters.participantType !== 'all') {
                    params.append('participantType', currentFilters.participantType);
                }

                const endpoint = currentView === 'user' 
                    ? `/api/public-chat/twin/${twinId}/user-chats?${params.toString()}`
                    : `/api/public-chat/twin/${twinId}/all-chats?${params.toString()}`;

                const response = await fetch(endpoint, {
                    credentials: 'include'
                });
                
                const data = await response.json();
                console.log('[HISTORY] pagination =', data.pagination, 'chatsLen =', data.chats?.length, 'usersLen =', data.users?.length);

                if (data.success) {
                    if (currentView === 'user') {
                        displayUsers(data.users || []);
                    } else {
                        displayChats(data.chats || []);
                    }
                    
                    // Initialize pagination
                    if (typeof window.initPaginationContainerPagination === 'function') {
                        window.initPaginationContainerPagination(data);
                    }
                } else {
                    showError(data.error || 'Failed to load public chats');
                }
            } catch (error) {
                console.error('Load public chat history error:', error);
                showError('Network error. Please try again.');
            }
        }        

        function displayChats(chats) {
            const container = document.getElementById('chatsContainer');
            
            if (chats.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <p class="text-gray-600 dark:text-gray-400">No public chats found</p>
                        <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">Try adjusting your filters</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = chats.map(chat => `
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                ${chat.user ? `
                                    <a href="/@${escapeHtml(chat.user.handle || 'unknown')}" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                                        ${chat.user.profileImage ? `
                                            <img src="${escapeHtml(chat.user.profileImage)}" alt="${escapeHtml(chat.user.name || chat.user.handle)}" class="w-10 h-10 rounded-full">
                                        ` : `
                                            <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                                                <span class="text-primary font-semibold">${escapeHtml((chat.user.name || chat.user.handle || 'U').charAt(0).toUpperCase())}</span>
                                            </div>
                                        `}
                                        <div>
                                            <h3 class="font-semibold text-gray-900 dark:text-white">${escapeHtml(chat.user.name || chat.user.handle || 'Unknown User')}</h3>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">@${escapeHtml(chat.user.handle || 'unknown')}</p>
                                        </div>
                                    </a>
                                ` : `
                                    <!-- Anonymous user -->
                                    <div class="flex items-center gap-2">
                                        <div class="w-10 h-10 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
                                            <span class="text-gray-600 dark:text-gray-300 font-semibold">?</span>
                                        </div>
                                        <div>
                                            <h3 class="font-semibold text-gray-900 dark:text-white">Anonymous User</h3>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">Visitor ID: ${escapeHtml(chat.visitorId?.substring(0, 8) || 'unknown')}</p>
                                        </div>
                                    </div>
                                `}
                            </div>
                            <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400 mt-2">
                                <span>${chat.messageCount} messages</span>
                                ${chat.lastMessage ? `
                                    <span>•</span>
                                    <span class="timestamp-display" data-timestamp="${chat.lastMessage.createdAt}" data-format="relative"></span>                                    
                                ` : ''}
                            </div>                                                     
                            ${chat.lastMessage ? `
                                <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 line-clamp-2">${escapeHtml(chat.lastMessage.content)}</p>
                            ` : ''}
                        </div>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                            <a 
                                href="/public-chat-history/view/${chat.publicId}" 
                                class="w-full sm:w-auto px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors whitespace-nowrap text-center"
                            >
                                View Chat
                            </a>
                            <button 
                                id="deleteChatBtn_${chat.publicId}"
                                class="w-full sm:w-auto px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors flex items-center justify-center"
                                title="Delete Chat"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
            
            // Format timestamps
            if (window.TimeUtils) {
                container.querySelectorAll('.timestamp-display').forEach(el => {
                    const timestamp = el.dataset.timestamp;
                    const format = el.dataset.format || 'relative';
                    if (timestamp) {
                        try {
                            let displayTime, fullTime;
                            if (format === 'relative') {
                                displayTime = window.TimeUtils.formatRelativeTime(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                            } else if (format === 'smart') {
                                displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                            } else {
                                displayTime = window.TimeUtils.formatRelativeTime(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                            }
                            el.textContent = displayTime;
                            el.title = fullTime;
                        } catch (e) {
                            console.error('Error formatting timestamp:', e);
                        }
                    }
                });            
            }
            
            // Add delete button listeners
            chats.forEach(chat => {
                const deleteBtn = document.getElementById(`deleteChatBtn_${chat.publicId}`);
                if (deleteBtn) {
                    deleteBtn.addEventListener('click', () => {
                        deleteChat(chat.publicId);
                    });
                }
            });
        }

        function displayUsers(users) {
            const container = document.getElementById('chatsContainer');
            
            if (users.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <p class="text-gray-600 dark:text-gray-400">No users found</p>
                        <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">Try adjusting your filters</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = users.map(userGroup => `
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-6 mb-4">
                    <div class="flex items-center justify-between mb-4">
                        <!-- ✅ FIX: Wrap profile info in link -->
                        <a href="/@${escapeHtml(userGroup.user.handle || 'unknown')}" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                            ${userGroup.user.profileImage ? `
                                <img src="${escapeHtml(userGroup.user.profileImage)}" alt="${escapeHtml(userGroup.user.name || userGroup.user.handle)}" class="w-12 h-12 rounded-full">
                            ` : `
                                <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center">
                                    <span class="text-primary font-semibold text-lg">${escapeHtml((userGroup.user.name || userGroup.user.handle || 'U').charAt(0).toUpperCase())}</span>
                                </div>
                            `}
                            <div>
                                <h3 class="font-semibold text-gray-900 dark:text-white">${escapeHtml(userGroup.user.name || userGroup.user.handle || 'Unknown User')}</h3>
                                <p class="text-xs text-gray-500 dark:text-gray-400">@${escapeHtml(userGroup.user.handle || 'unknown')}</p>
                            </div>
                        </a>
                        <div class="text-right">
                            <p class="text-sm text-gray-600 dark:text-gray-400">${userGroup.totalChats} chats</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">${userGroup.totalMessages} messages</p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        ${userGroup.chats.map(chat => `
                            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                                <div class="flex-1">
                                    <p class="font-medium text-gray-900 dark:text-white">${escapeHtml(chat.title)}</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-1">${chat.messageCount} messages • <span class="timestamp-display" data-timestamp="${chat.lastActivity}" data-format="relative"></span></p>
                                </div>                                
                                <a href="/public-chat-history/view/${chat.publicId}" class="px-3 py-1 bg-primary text-white rounded-lg hover:bg-secondary transition-colors text-sm">
                                    View
                                </a>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            // Format timestamps
            if (window.TimeUtils) {
                container.querySelectorAll('.timestamp-display').forEach(el => {
                    const timestamp = el.dataset.timestamp;
                    if (timestamp) {
                        try {
                            const displayTime = window.TimeUtils.formatRelativeTime(timestamp);
                            const fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                            el.textContent = displayTime;
                            el.title = fullTime;
                        } catch (e) {
                            console.error('Error formatting timestamp:', e);
                        }
                    }
                });
            }            
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showError(message) {
            const container = document.getElementById('chatsContainer');
            container.innerHTML = `
                <div class="text-center py-12">
                    <p class="text-red-500">${escapeHtml(message)}</p>
                </div>
            `;
        }

        async function deleteChat(chatId) {
            const confirmed = await window.ModalHelpers.confirm({
                title: 'Delete this chat?',
                message: 'This action cannot be undone. All messages in this chat will be permanently removed.',
                confirmLabel: 'Delete',
                cancelLabel: 'Cancel',
                type: 'danger'
            });
            if (!confirmed) {
                return;
            }
            
            try {
                const response = await fetch(`/api/public-chat/${chatId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    const container = document.getElementById('chatsContainer');
                    const successMsg = document.createElement('div');
                    successMsg.className = 'mb-4 p-4 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 rounded-lg';
                    successMsg.textContent = 'Chat deleted successfully';
                    container.insertBefore(successMsg, container.firstChild);
                    
                    setTimeout(() => {
                        successMsg.remove();
                    }, 3000);
                    
                    loadPublicChatHistory(currentPage);
                } else {
                    showError(data.error || 'Failed to delete chat');
                }
            } catch (error) {
                console.error('Delete chat error:', error);
                showError('Network error. Please try again.');
            }
        }

        // Filter functions
        function applyFilters() {
            currentFilters.search = document.getElementById('filterSearch')?.value || '';
            currentFilters.dateFrom = document.getElementById('filterDateFrom')?.value || '';
            currentFilters.dateTo = document.getElementById('filterDateTo')?.value || '';
            currentFilters.sortBy = document.getElementById('filterSortBy')?.value || 'lastActivity';
            // ✅ NEW: User sort
            if (currentView === 'user') {
                currentFilters.userSortBy = document.getElementById('filterUserSortBy')?.value || 'lastActivity';
            }
            // ✅ NEW: Advanced filters
            currentFilters.minMessages = document.getElementById('filterMinMessages')?.value || '';
            currentFilters.maxMessages = document.getElementById('filterMaxMessages')?.value || '';
            currentFilters.participantType = document.getElementById('filterParticipantType')?.value || 'all'; // ✅ NEW
            currentPage = 1;
            updateActiveFiltersDisplay();
            updateQuickFilterChipsFromState();
            loadPublicChatHistory(1);
        }

        function updateActiveFiltersDisplay() {
            const container = document.getElementById('activeFiltersContainer');
            if (!container) return;
            
            const activeFilters = [];
            
            if (currentFilters.search && currentFilters.search.trim()) {
                activeFilters.push({
                    key: 'search',
                    label: `Search: "${currentFilters.search}"`,
                    value: currentFilters.search
                });
            }
            if (currentFilters.dateFrom) {
                activeFilters.push({
                    key: 'dateFrom',
                    label: `From: ${new Date(currentFilters.dateFrom).toLocaleDateString()}`,
                    value: currentFilters.dateFrom
                });
            }
            if (currentFilters.dateTo) {
                activeFilters.push({
                    key: 'dateTo',
                    label: `To: ${new Date(currentFilters.dateTo).toLocaleDateString()}`,
                    value: currentFilters.dateTo
                });
            }
            if (currentFilters.sortBy && currentFilters.sortBy !== 'lastActivity') {
                const sortLabels = {
                    'createdAt': 'Date Created',
                    'messageCount': 'Message Count'
                };
                activeFilters.push({
                    key: 'sortBy',
                    label: `Sort: ${sortLabels[currentFilters.sortBy] || currentFilters.sortBy}`,
                    value: currentFilters.sortBy
                });
            }
            // ✅ NEW: Advanced filter chips
            if (currentFilters.minMessages) {
                activeFilters.push({
                    key: 'minMessages',
                    label: `Min: ${currentFilters.minMessages} messages`,
                    value: currentFilters.minMessages
                });
            }
            if (currentFilters.maxMessages) {
                activeFilters.push({
                    key: 'maxMessages',
                    label: `Max: ${currentFilters.maxMessages} messages`,
                    value: currentFilters.maxMessages
                });
            }
            if (currentFilters.participantType && currentFilters.participantType !== 'all') {
                activeFilters.push({
                    key: 'participantType',
                    label: `Participants: ${currentFilters.participantType}`,
                    value: currentFilters.participantType
                });
            }
            
            if (activeFilters.length === 0) {
                container.innerHTML = '';
                return;
            }
            
            container.innerHTML = activeFilters.map(filter => `
                <span class="inline-flex items-center gap-1 px-3 py-1 bg-primary/20 text-primary dark:bg-primary/30 dark:text-primary-300 rounded-full text-sm">
                    ${escapeHtml(filter.label)}
                    <button 
                        data-filter-key="${filter.key}"
                        class="remove-filter-btn ml-1 hover:bg-primary/30 rounded-full p-0.5 transition-colors"
                        title="Remove filter"
                    >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </span>
            `).join('');
            
            // Add event listeners for remove buttons
            container.querySelectorAll('.remove-filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const key = btn.dataset.filterKey;
                    removeFilter(key);
                });
            });
        }

        function removeFilter(key) {
            switch(key) {
                case 'search':
                    document.getElementById('filterSearch').value = '';
                    currentFilters.search = '';
                    break;
                case 'dateFrom':
                    document.getElementById('filterDateFrom').value = '';
                    currentFilters.dateFrom = '';
                    break;
                case 'dateTo':
                    document.getElementById('filterDateTo').value = '';
                    currentFilters.dateTo = '';
                    break;
                case 'sortBy':
                    document.getElementById('filterSortBy').value = 'lastActivity';
                    currentFilters.sortBy = 'lastActivity';
                    break;
                // ✅ NEW: Advanced filters
                case 'minMessages':
                    document.getElementById('filterMinMessages').value = '';
                    currentFilters.minMessages = '';
                    break;
                case 'maxMessages':
                    document.getElementById('filterMaxMessages').value = '';
                    currentFilters.maxMessages = '';
                    break;
                case 'participantType':
                    document.getElementById('filterParticipantType').value = 'all';
                    currentFilters.participantType = 'all';
                    break;
            }
            updateActiveFiltersDisplay();
            applyFilters();
        }

        function clearFilters() {
            currentFilters = {
                userId: '',
                dateFrom: '',
                dateTo: '',
                search: '',
                sortBy: 'lastActivity',
                minMessages: '',
                maxMessages: '',
                userSortBy: 'lastActivity', // Added for user-wise view
                participantType: 'all' // ✅ RESET
            };
            
            // Clear all input fields
            const filterSearch = document.getElementById('filterSearch');
            const filterDateFrom = document.getElementById('filterDateFrom');
            const filterDateTo = document.getElementById('filterDateTo');
            const filterSortBy = document.getElementById('filterSortBy');
            const filterUserSortBy = document.getElementById('filterUserSortBy');
            const filterMinMessages = document.getElementById('filterMinMessages');
            const filterMaxMessages = document.getElementById('filterMaxMessages');
            const quickDatePreset = document.getElementById('quickDatePreset');
            const filterParticipantType = document.getElementById('filterParticipantType');
            
            if (filterSearch) filterSearch.value = '';
            if (filterDateFrom) filterDateFrom.value = '';
            if (filterDateTo) filterDateTo.value = '';
            if (filterSortBy) filterSortBy.value = 'lastActivity';
            if (filterUserSortBy) filterUserSortBy.value = 'lastActivity';
            if (filterMinMessages) filterMinMessages.value = '';
            if (filterMaxMessages) filterMaxMessages.value = '';
            if (quickDatePreset) quickDatePreset.value = '';
            if (filterParticipantType) filterParticipantType.value = 'all';
            
            updateActiveFiltersDisplay();
            updateQuickFilterChipsFromState();
            applyFilters();
        }

        // Quick filters (chips + sheet) helpers
        function updateQuickFilterChipsFromState() {
            const quickPresetEl = document.getElementById('quickDatePreset');
            const quickPreset = quickPresetEl ? quickPresetEl.value || '' : '';
            const participant = currentFilters.participantType || 'all';
            const sortBy = currentFilters.sortBy || 'lastActivity';

            document.querySelectorAll('.twin-filter-chip').forEach(chip => {
                const type = chip.dataset.filterType;
                const value = chip.dataset.filterValue;
                let active = false;

                if (type === 'time') {
                    if (!quickPreset && !currentFilters.dateFrom && !currentFilters.dateTo) {
                        active = (value === 'all');
                    } else if (quickPreset === 'today') {
                        active = (value === 'today');
                    } else if (quickPreset === '7days') {
                        active = (value === '7days');
                    } else if (quickPreset === '30days') {
                        active = (value === '30days');
                    }
                } else if (type === 'sort') {
                    active = (value === sortBy);
                } else if (type === 'participant') {
                    active = (value === participant);
                }

                // Prevent participant chips from being "active" in user view
                if (currentView === 'user' && type === 'participant') {
                    active = false;
                }

                if (active) {
                    chip.classList.add(
                        'border-primary/40','bg-primary/10','text-primary',
                        'dark:border-primary/40','dark:bg-primary/20','dark:text-primary'
                    );
                    chip.classList.remove(
                        'border-gray-200','dark:border-gray-700',
                        'bg-white','dark:bg-gray-900',
                        'text-gray-700','dark:text-gray-300'
                    );
                } else {
                    chip.classList.remove(
                        'border-primary/40','bg-primary/10','text-primary',
                        'dark:border-primary/40','dark:bg-primary/20','dark:text-primary'
                    );
                    chip.classList.add(
                        'border-gray-200','dark:border-gray-700',
                        'bg-white','dark:bg-gray-900',
                        'text-gray-700','dark:text-gray-300'
                    );
                }
            });
        }

        function setupQuickFilterUI() {
            // Chips click → map to existing inputs + applyFilters
            document.querySelectorAll('.twin-filter-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    const type = chip.dataset.filterType;
                    const value = chip.dataset.filterValue;

                    if (type === 'time') {
                        const quickPreset = document.getElementById('quickDatePreset');
                        const dateFrom = document.getElementById('filterDateFrom');
                        const dateTo = document.getElementById('filterDateTo');

                        if (value === 'all') {
                            if (quickPreset) quickPreset.value = '';
                            if (dateFrom) dateFrom.value = '';
                            if (dateTo) dateTo.value = '';
                            applyFilters();
                        } else {
                            if (quickPreset) {
                                quickPreset.value = value;
                                quickPreset.dispatchEvent(new Event('change'));
                            }
                        }
                    } else if (type === 'sort') {
                        if (currentView === 'chat') {
                            const filterSortBy = document.getElementById('filterSortBy');
                            if (filterSortBy) {
                                filterSortBy.value = value; // e.g. 'messageCount'
                                applyFilters();
                            }
                        } else {
                            // user-wise: map 'messageCount' → 'totalMessages' for userSortBy
                            const userSortBy = document.getElementById('filterUserSortBy');
                            if (userSortBy) {
                                userSortBy.value = (value === 'messageCount') ? 'totalMessages' : value;
                                applyFilters();
                            }
                        }
                    } else if (type === 'participant') {
                        // Only meaningful in chat-wise view
                        if (currentView === 'chat') {
                            const filterParticipantType = document.getElementById('filterParticipantType');
                            if (filterParticipantType) {
                                filterParticipantType.value = value; // 'loggedIn' | 'anonymous'
                                applyFilters();
                            }
                        }
                    }
                });
            });

            // Bottom sheet open/close
            const sheet = document.getElementById('twinFiltersSheetOverlay');
            const openBtn = document.getElementById('openTwinFiltersSheetBtn');
            const closeBtn = document.getElementById('closeTwinFiltersSheetBtn');

            if (openBtn && sheet) {
                openBtn.addEventListener('click', () => {
                    // Sync sheet controls from current state
                    const baseSearch = document.getElementById('filterSearch');
                    const sheetSearch = document.getElementById('twinFilterSheetSearch');
                    if (baseSearch && sheetSearch) sheetSearch.value = baseSearch.value || '';

                    const quickPreset = document.getElementById('quickDatePreset');
                    const sheetQuick = document.getElementById('twinFilterSheetQuickDate');
                    if (quickPreset && sheetQuick) sheetQuick.value = quickPreset.value || '';

                    const sheetSort = document.getElementById('twinFilterSheetSortBy');
                    if (sheetSort) {
                        if (currentView === 'chat') {
                            sheetSort.value = currentFilters.sortBy || 'lastActivity';
                        } else {
                            // user-wise
                            sheetSort.value = currentFilters.userSortBy || 'lastActivity';
                        }
                    }

                    const sheetParticipant = document.getElementById('twinFilterSheetParticipantType');
                    if (sheetParticipant) sheetParticipant.value = currentFilters.participantType || 'all';

                    sheet.classList.remove('hidden');
                });
            }
            if (closeBtn && sheet) {
                closeBtn.addEventListener('click', () => {
                    sheet.classList.add('hidden');
                });
            }
            if (sheet) {
                sheet.addEventListener('click', (e) => {
                    if (e.target === sheet) {
                        sheet.classList.add('hidden');
                    }
                });
            }

            // Sheet controls → bridge to existing inputs
            const sheetSearch = document.getElementById('twinFilterSheetSearch');
            if (sheetSearch) {
                sheetSearch.addEventListener('input', () => {
                    const baseSearch = document.getElementById('filterSearch');
                    if (baseSearch) {
                        baseSearch.value = sheetSearch.value;
                        clearTimeout(searchDebounceTimer);
                        searchDebounceTimer = setTimeout(() => {
                            applyFilters();
                        }, 500);
                    }
                });
            }

            const sheetQuick = document.getElementById('twinFilterSheetQuickDate');
            if (sheetQuick) {
                sheetQuick.addEventListener('change', () => {
                    const quickPreset = document.getElementById('quickDatePreset');
                    if (quickPreset) {
                        quickPreset.value = sheetQuick.value;
                        quickPreset.dispatchEvent(new Event('change'));
                    }
                });
            }

            const sheetSort = document.getElementById('twinFilterSheetSortBy');
            if (sheetSort) {
                sheetSort.addEventListener('change', () => {
                    if (currentView === 'chat') {
                        const filterSortBy = document.getElementById('filterSortBy');
                        if (filterSortBy) {
                            filterSortBy.value = sheetSort.value;
                            applyFilters();
                        }
                    } else {
                        const userSortBy = document.getElementById('filterUserSortBy');
                        if (userSortBy) {
                            userSortBy.value = (sheetSort.value === 'messageCount')
                                ? 'totalMessages'
                                : sheetSort.value;
                            applyFilters();
                        }
                    }
                });
            }

            const sheetParticipant = document.getElementById('twinFilterSheetParticipantType');
            if (sheetParticipant) {
                sheetParticipant.addEventListener('change', () => {
                    if (currentView === 'chat') {
                        const filterParticipantType = document.getElementById('filterParticipantType');
                        if (filterParticipantType) {
                            filterParticipantType.value = sheetParticipant.value;
                            applyFilters();
                        }
                    }
                });
            }

            const clearBtn = document.getElementById('twinFiltersClearBtn');
            const applyBtn = document.getElementById('twinFiltersApplyBtn');

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    clearFilters();
                    if (sheet) sheet.classList.add('hidden');
                });
            }
            if (applyBtn) {
                applyBtn.addEventListener('click', () => {
                    applyFilters();
                    if (sheet) sheet.classList.add('hidden');
                });
            }
        }

        function syncViewSpecificFilterVisibility() {
            const participantContainer = document.getElementById('participantFilterContainer');
            const participantSheetBlock = document.getElementById('twinFilterSheetParticipantBlock');

            // Quick chips: chat-only participant chips
            document.querySelectorAll('.twin-filter-chat-only').forEach(el => {
                if (currentView === 'chat') {
                    el.classList.remove('hidden');
                } else {
                    el.classList.add('hidden');
                }
            });

            // Desktop participant select
            if (participantContainer) {
                if (currentView === 'chat') {
                    participantContainer.classList.remove('hidden');
                } else {
                    participantContainer.classList.add('hidden');
                }
            }

            // Sheet participants
            if (participantSheetBlock) {
                if (currentView === 'chat') {
                    participantSheetBlock.classList.remove('hidden');
                } else {
                    participantSheetBlock.classList.add('hidden');
                }
            }

            // User-wise view: participants filter logically 'all'
            if (currentView === 'user') {
                currentFilters.participantType = 'all';
            }
        }

        // ✅ FIX: Optimize toggleView function
        function toggleView(view) {
            if (currentView === view) return; // ✅ FIX: Don't do anything if already on that view
            
            // ✅ FIX: Show loading state immediately
            const container = document.getElementById('chatsContainer');
            container.innerHTML = `
                <div class="text-center py-12">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto"></div>
                    <p class="mt-4 text-gray-600 dark:text-gray-400">Loading...</p>
                </div>
            `;
            
            currentView = view;
            
            // ✅ FIX: Update URL immediately (use replaceState for better performance)
            const url = new URL(window.location.href);
            url.searchParams.set('view', view);
            window.history.replaceState({}, '', url.toString());
            
            // ✅ FIX: Update button states synchronously
            if (view === 'chat') {
                document.getElementById('viewChatBtn').classList.add('bg-primary', 'text-white');
                document.getElementById('viewChatBtn').classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
                document.getElementById('viewUserBtn').classList.remove('bg-primary', 'text-white');
                document.getElementById('viewUserBtn').classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-300', 'dark:text-gray-300');
                document.getElementById('userSortByContainer').classList.add('hidden');
            } else {
                document.getElementById('viewChatBtn').classList.remove('bg-primary', 'text-white');
                document.getElementById('viewChatBtn').classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
                document.getElementById('viewUserBtn').classList.add('bg-primary', 'text-white');
                document.getElementById('viewUserBtn').classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-300', 'dark:text-gray-300');
                document.getElementById('userSortByContainer').classList.remove('hidden');
            }

            syncViewSpecificFilterVisibility();
            updateQuickFilterChipsFromState();
            
            // ✅ FIX: Load data immediately without setTimeout
            currentPage = 1;
            if (view === 'chat') {
                loadPublicChatHistory(1);
            } else {
                loadPublicChatHistory(1); // This will call user-wise endpoint based on currentView
            }
        }        

        // ✅ FIX: Restore view state on page load
        // Load on page load
        document.addEventListener('DOMContentLoaded', () => {
            // ✅ Restore view toggle state from URL
            if (currentView === 'chat') {
                document.getElementById('viewChatBtn').classList.add('bg-primary', 'text-white');
                document.getElementById('viewUserBtn').classList.remove('bg-primary', 'text-white');
                document.getElementById('userSortByContainer').classList.add('hidden');
            } else {
                document.getElementById('viewChatBtn').classList.remove('bg-primary', 'text-white');
                document.getElementById('viewUserBtn').classList.add('bg-primary', 'text-white');
                document.getElementById('userSortByContainer').classList.remove('hidden');
            }
            
            loadPublicChatHistory(currentPage);
            
            // ✅ Setup event listeners for buttons
            const viewChatBtn = document.getElementById('viewChatBtn');
            const viewUserBtn = document.getElementById('viewUserBtn');
            const applyFiltersBtn = document.getElementById('applyFiltersBtn');
            const clearFiltersBtn = document.getElementById('clearFiltersBtn');
            const filterSearch = document.getElementById('filterSearch');
            const filterDateFrom = document.getElementById('filterDateFrom');
            const filterDateTo = document.getElementById('filterDateTo');
            const filterSortBy = document.getElementById('filterSortBy');
            
            // View toggle buttons
            if (viewChatBtn) {
                viewChatBtn.addEventListener('click', () => {
                    toggleView('chat');
                });
            }
            
            if (viewUserBtn) {
                viewUserBtn.addEventListener('click', () => {
                    toggleView('user');
                });
            }
            
            // Filter buttons
            // Search input - Debounced auto-apply (500ms delay) + Enter key
            if (filterSearch) {
                filterSearch.addEventListener('input', () => {
                    clearTimeout(searchDebounceTimer);
                    searchDebounceTimer = setTimeout(() => {
                        applyFilters();
                    }, 500);
                });
                
                // Also apply on Enter key for immediate feedback
                filterSearch.addEventListener('keyup', (e) => {
                    if (e.key === 'Enter') {
                        clearTimeout(searchDebounceTimer);
                        applyFilters();
                    }
                });
            }            

            // Date inputs - Instant auto-apply on change
            if (filterDateFrom) {
                filterDateFrom.addEventListener('change', () => {
                    applyFilters();
                });
            }
            
            if (filterDateTo) {
                filterDateTo.addEventListener('change', () => {
                    applyFilters();
                });
            }
            
            // Sort select - Instant auto-apply on change
            if (filterSortBy) {
                filterSortBy.addEventListener('change', () => {
                    currentFilters.sortBy = filterSortBy.value;
                    applyFilters();
                });
            }
            
            // ✅ NEW: User sort select - Instant auto-apply on change
            const userSortBySelect = document.getElementById('filterUserSortBy');
            if (userSortBySelect) {
                userSortBySelect.addEventListener('change', () => {
                    if (currentView === 'user') {
                        currentFilters.userSortBy = userSortBySelect.value;
                        applyFilters();
                    }
                });
            }
            
            // ✅ NEW: Quick date preset
            const quickDatePreset = document.getElementById('quickDatePreset');
            if (quickDatePreset) {
                quickDatePreset.addEventListener('change', () => {
                    const preset = quickDatePreset.value;
                    const dateFromInput = document.getElementById('filterDateFrom');
                    const dateToInput = document.getElementById('filterDateTo');
                    
                    if (!preset) {
                        if (dateFromInput) dateFromInput.value = '';
                        if (dateToInput) dateToInput.value = '';
                        applyFilters();
                        return;
                    }
                    
                    const today = new Date();
                    let fromDate = new Date();
                    
                    switch(preset) {
                        case 'today':
                            fromDate = new Date(today);
                            break;
                        case '7days':
                            fromDate.setDate(today.getDate() - 7);
                            break;
                        case '30days':
                            fromDate.setDate(today.getDate() - 30);
                            break;
                        case '90days':
                            fromDate.setDate(today.getDate() - 90);
                            break;
                    }
                    
                    if (dateFromInput) {
                        dateFromInput.value = fromDate.toISOString().split('T')[0];
                    }
                    if (dateToInput) {
                        dateToInput.value = today.toISOString().split('T')[0];
                    }
                    applyFilters();
                });
            }
            
            // ✅ NEW: Message count filters - auto-apply on change
            const filterMinMessages = document.getElementById('filterMinMessages');
            const filterMaxMessages = document.getElementById('filterMaxMessages');
            
            if (filterMinMessages) {
                filterMinMessages.addEventListener('change', () => {
                    applyFilters();
                });
            }
            
            if (filterMaxMessages) {
                filterMaxMessages.addEventListener('change', () => {
                    applyFilters();
                });
            }

            // ✅ NEW: Participant type filter - auto-apply on change
            const filterParticipantType = document.getElementById('filterParticipantType');
            if (filterParticipantType) {
                filterParticipantType.addEventListener('change', () => {
                    applyFilters();
                });
            }
            
            // Apply Filters button - Manual trigger (useful for re-applying or when auto-apply doesn't trigger)
            if (applyFiltersBtn) {
                applyFiltersBtn.addEventListener('click', () => {
                    // Clear any pending debounce
                    clearTimeout(searchDebounceTimer);
                    applyFilters();
                });
            }
            
            // ✅ FIX: Clear Filters button - Missing event listener
            if (clearFiltersBtn) {
                clearFiltersBtn.addEventListener('click', () => {
                    clearFilters();
                });
            }
            
            // Initial filter display
            updateActiveFiltersDisplay();
            
            // ✅ Set initial visibility of user sort based on current view
            const userSortContainer = document.getElementById('userSortByContainer');
            if (userSortContainer) {
                if (currentView === 'user') {
                    userSortContainer.classList.remove('hidden');
                } else {
                    userSortContainer.classList.add('hidden');
                }
            }

            // View-specific visibility (participants, chat-only chips)
            syncViewSpecificFilterVisibility();
            
            // Quick filters (chips + sheet)
            updateQuickFilterChipsFromState();
            setupQuickFilterUI();
        });
    </script>
    <%- include('partials/modal-helpers') %>
</body>
</html>
