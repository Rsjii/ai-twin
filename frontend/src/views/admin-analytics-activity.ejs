<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .activity-item { transition: all 0.3s ease; }
        .activity-item:hover { transform: translateX(4px); }
        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/analytics" class="text-xl font-bold text-gray-900">← Back to Analytics</a>
                    <span class="ml-4 px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">Activity Feed</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <img src="<%= user.profileImage || '/uploads/profiles/default.jpg' %>" alt="Profile" class="w-8 h-8 rounded-full" loading="lazy">
                        <span class="text-sm font-medium text-gray-700"><%= user.handle || user.email %></span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Activity Feed</h1>
            <p class="text-gray-600 dark:text-gray-300 mt-2">Timeline of all key events and activities</p>
        </div>

        <!-- Summary Cards -->
        <div id="summaryCards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 sm:gap-6 mb-6 sm:mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-blue-100 rounded-lg">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Signups</p>
                        <p class="text-2xl font-bold text-gray-900" id="signupsCount">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-green-100 rounded-lg">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Twins Created</p>
                        <p class="text-2xl font-bold text-gray-900" id="twinsCount">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-purple-100 rounded-lg">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Chats Started</p>
                        <p class="text-2xl font-bold text-gray-900" id="chatsCount">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-orange-100 rounded-lg">
                        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Messages</p>
                        <p class="text-2xl font-bold text-gray-900" id="messagesCount">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-yellow-100 rounded-lg">
                        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Invites</p>
                        <p class="text-2xl font-bold text-gray-900" id="invitesCount">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm dark:shadow-gray-900 p-4 sm:p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-pink-100 rounded-lg">
                        <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Shares</p>
                        <p class="text-2xl font-bold text-gray-900" id="sharesCount">-</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Start Date</label>
                    <input type="date" id="startDate" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">End Date</label>
                    <input type="date" id="endDate" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Event Types</label>
                    <select id="eventTypes" multiple class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        <option value="signup">Signups</option>
                        <option value="twin_created">Twin Created</option>
                        <option value="chat_started">Chat Started</option>
                        <option value="message_approved">Message Approved</option>
                        <option value="invite_sent">Invite Sent</option>
                        <option value="invite_accepted">Invite Accepted</option>
                        <option value="profile_shared">Profile Shared</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button id="applyFiltersBtn" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        Apply Filters
                    </button>
                </div>
            </div>
            <div class="mt-4 flex gap-3">
                <button id="resetFiltersBtn" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                    Reset
                </button>
                <button id="exportCsvBtn" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                    📋 Export CSV
                </button>                
            </div>
        </div>

                <!-- Activity Chart -->
                <div class="bg-white rounded-lg shadow-sm mb-8">
                    <div class="p-6 border-b">
                        <h3 class="text-lg font-semibold text-gray-900">Events Over Time</h3>
                        <p class="text-sm text-gray-500">Filtered by date range and event types</p>
                    </div>
                    <div class="p-6">
                        <canvas id="activityChart" height="120"></canvas>
                    </div>
                </div>
        
        <!-- Activity Timeline -->
        <div class="bg-white rounded-lg shadow-sm">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900">Activity Timeline</h3>
            </div>
            <div id="activityList" class="divide-y divide-gray-200">
                <div class="p-4 sm:p-6 lg:p-8 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                    <p class="text-gray-600 mt-4">Loading activities...</p>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-8 flex justify-center">
            <!-- Pagination will be loaded here -->
        </div>
    </div>

    <script>
        let currentPage = 1;
        let currentStartDate = '';
        let currentEndDate = '';
        let currentEventTypes = '';
        let activityChart = null;

        // Load activity feed
        async function loadActivityFeed() {
            try {
                const params = new URLSearchParams({
                    page: currentPage,
                    limit: 50
                });
                
                if (currentStartDate) params.append('startDate', currentStartDate);
                if (currentEndDate) params.append('endDate', currentEndDate);
                if (currentEventTypes) params.append('eventTypes', currentEventTypes);

                const response = await fetch(`/api/admin/analytics/activity?${params}`, {
                    credentials: 'include'
                });
                const data = await response.json();

                if (data.success) {
                    // Update summary cards
                    document.getElementById('signupsCount').textContent = data.data.summary.signups || 0;
                    document.getElementById('twinsCount').textContent = data.data.summary.twinsCreated || 0;
                    document.getElementById('chatsCount').textContent = data.data.summary.chatsStarted || 0;
                    document.getElementById('messagesCount').textContent = data.data.summary.messagesApproved || 0;
                    document.getElementById('invitesCount').textContent = data.data.summary.invites || 0;
                    document.getElementById('sharesCount').textContent = data.data.summary.shares || 0;

                    // Update activity list
                    updateActivityList(data.data.activities);
                    
                    // Update pagination
                    updatePagination(data.data.pagination);

                     // Update chart
                     if (data.data.dailyCounts) {
                        updateActivityChart(data.data.dailyCounts);
                    }
                } else {
                    showError('Failed to load activity feed: ' + data.error);
                }
            } catch (error) {
                showError('Error loading activity feed');
            }
        }

        // Update activity list
        function updateActivityList(activities) {
            const activityList = document.getElementById('activityList');
            
            if (activities && activities.length > 0) {
                activityList.innerHTML = activities.map(activity => {
                    const iconColor = getActivityIconColor(activity.type);
                    const iconText = getActivityIconText(activity.type);
                    
                    return `
                    <div class="activity-item p-6 hover:bg-gray-50">
                        <div class="flex items-start space-x-4">
                            <div class="activity-icon ${iconColor}">
                                ${iconText}
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center space-x-2 mb-2">
                                    <h4 class="text-sm font-semibold text-gray-900">${activity.description || activity.type}</h4>
                                    <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">
                                        ${activity.type}
                                    </span>
                                </div>
                                <div class="flex items-center space-x-4 text-xs text-gray-500">
                                    <span>User: ${activity.userHandle || activity.userEmail || 'Unknown'}</span>
                                    ${activity.twinHandle ? `<span>Twin: @${activity.twinHandle}</span>` : ''}
                                    <span class="timestamp-display" data-timestamp="${activity.createdAt}" data-format="context"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                }).join('');
                
                // Format timestamps
                if (window.TimeUtils) {
                    activityList.querySelectorAll('.timestamp-display').forEach(el => {
                        const timestamp = el.dataset.timestamp;
                        if (timestamp) {
                            try {
                                el.textContent = window.TimeUtils.formatTimeWithContext(timestamp);
                                el.title = window.TimeUtils.formatFullDateTime(timestamp);
                            } catch (e) {
                                // Silently handle timestamp formatting errors
                            }
                        }
                    });
                }
            } else {
                activityList.innerHTML = '<div class="p-4 sm:p-6 lg:p-8 text-center text-gray-500">No activities found</div>';
            }
        }

        function getActivityIconColor(type) {
            const colors = {
                'signup': 'bg-blue-500',
                'twin_created': 'bg-green-500',
                'chat_started': 'bg-purple-500',
                'message_approved': 'bg-orange-500',
                'invite_sent': 'bg-yellow-500',
                'invite_accepted': 'bg-yellow-600',
                'profile_shared': 'bg-pink-500',
                'twin_shared': 'bg-pink-500'
            };
            return colors[type] || 'bg-gray-500';
        }

        function getActivityIconText(type) {
            const icons = {
                'signup': '👤',
                'twin_created': '✨',
                'chat_started': '💬',
                'message_approved': '✓',
                'invite_sent': '📤',
                'invite_accepted': '📥',
                'profile_shared': '🔗',
                'twin_shared': '🔗'
            };
            return icons[type] || '•';
        }

        function getActivityIconText(type) {
            const icons = {
                'signup': '👤',
                'twin_created': '✨',
                'chat_started': '💬',
                'message_approved': '✓',
                'invite_sent': '📤',
                'invite_accepted': '📥',
                'profile_shared': '🔗',
                'twin_shared': '🔗'
            };
            return icons[type] || '•';
        }

        // Update activity chart
        function updateActivityChart(dailyCounts) {
            // ✅ Guard: if Chart.js isn't loaded or data is bad, just skip chart instead of throwing
            if (typeof Chart === 'undefined' || !Array.isArray(dailyCounts)) {
                return;
            }

            const ctx = document.getElementById('activityChart')?.getContext('2d');
            if (!ctx) return;

            const labels = dailyCounts.map(d => {
                const date = new Date(d.date);
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            });
            const values = dailyCounts.map(d => Number(d.total) || 0);

            if (activityChart) {
                activityChart.destroy();
            }

            activityChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Events per day',
                        data: values,
                        borderColor: '#2563EB',
                        backgroundColor: 'rgba(37,99,235,0.1)',
                        tension: 0.25,
                        fill: true,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#2563EB',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: '#2563EB',
                            borderWidth: 1
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { maxTicksLimit: 15 }
                        },
                        y: {
                            beginAtZero: true,
                            precision: 0,
                            ticks: { stepSize: 1 },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        }
                    },
                    interaction: {
                        mode: 'nearest',
                        axis: 'x',
                        intersect: false
                    }
                }
            });
        }

        function updatePagination(pagination) {
            const paginationDiv = document.getElementById('pagination');
            if (!pagination || pagination.totalPages <= 1) {
                paginationDiv.innerHTML = '';
                return;
            }
            
            let html = '<div class="flex items-center space-x-2">';
            
            // Previous button
            if (pagination.currentPage > 1) {
                html += `<button class="page-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" data-page="${pagination.currentPage - 1}">Previous</button>`;
            }
            
            // Page numbers
            for (let i = 1; i <= pagination.totalPages; i++) {
                if (i === pagination.currentPage) {
                    html += `<button class="px-4 py-2 bg-blue-600 text-white rounded-lg">${i}</button>`;
                } else if (i === 1 || i === pagination.totalPages || Math.abs(i - pagination.currentPage) <= 2) {
                    html += `<button class="page-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" data-page="${i}">${i}</button>`;
                } else if (Math.abs(i - pagination.currentPage) === 3) {
                    html += `<span class="px-2">...</span>`;
                }
            }
            
            // Next button
            if (pagination.currentPage < pagination.totalPages) {
                html += `<button class="page-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" data-page="${pagination.currentPage + 1}">Next</button>`;
            }
            
            html += '</div>';
            html += `<div class="ml-4 text-sm text-gray-600">Showing ${((pagination.currentPage - 1) * 50) + 1}-${Math.min(pagination.currentPage * 50, pagination.totalItems)} of ${pagination.totalItems} activities</div>`;
            paginationDiv.innerHTML = html;
        }

        function changePage(page) {
            currentPage = page;
            loadActivityFeed();
        }

        function applyFilters() {
            currentStartDate = document.getElementById('startDate').value;
            currentEndDate = document.getElementById('endDate').value;
            const eventTypesSelect = document.getElementById('eventTypes');
            currentEventTypes = Array.from(eventTypesSelect.selectedOptions).map(opt => opt.value).join(',');
            currentPage = 1;
            loadActivityFeed();
        }

        function resetFilters() {
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
            document.getElementById('eventTypes').selectedIndex = -1;
            applyFilters();
        }

        function exportToCSV() {
            alert('CSV export coming soon!');
        }

        function showError(message) {
            alert('Error: ' + message);
        }

        // Wire buttons
        document.getElementById('applyFiltersBtn').addEventListener('click', applyFilters);
        document.getElementById('resetFiltersBtn').addEventListener('click', resetFilters);
        document.getElementById('exportCsvBtn').addEventListener('click', exportToCSV);

        // Event delegation for pagination
        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('page-btn')) {
                const page = parseInt(e.target.dataset.page);
                if (page) changePage(page);
            }
        });

        // Load on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadActivityFeed();
        });
    </script>    
</body>
</html>
