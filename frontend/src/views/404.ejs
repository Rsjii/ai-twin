<%
  const mainMessage =
    typeof message !== 'undefined' && message
      ? message
      : "The page you're looking for doesn't exist or has been moved.";
%>
<%- include('layout', {
  title: 'Page Not Found - TwinOS',
  body:
    '<div class="px-4 py-6 sm:px-0 mobile-p-4">' +
      '<div class="max-w-md mx-auto text-center">' +
        '<div class="text-6xl mb-6 mobile-text-5xl">🤖</div>' +
        '<h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4 text-center">404</h1>' +
        '<h2 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-6 mobile-text-xl mobile-text-center">Page Not Found</h2>' +
        '<p class="text-gray-600 dark:text-gray-400 mb-8 mobile-text-sm mobile-text-center">' +
          mainMessage +
        '</p>' +
        '<div class="space-y-4 mobile-gap-2">' +
          '<a href="/" class="block bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-lg hover:shadow-lg transition-all font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base text-center" aria-label="Go Home">' +
            'Go Home' +
          '</a>' +
        '</div>' +
        '<p class="mt-4 text-sm text-gray-500 dark:text-gray-400">' +
          'Need help? <a href="/help-center" class="text-primary hover:underline">Visit Help Center</a>.' +
        '</p>' +
      '</div>' +
    '</div>'
}) %>
