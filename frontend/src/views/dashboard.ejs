<script>
    const MAX_RECENT_CHATS = 5;
    const userHasTwin = <%= hasTwins ? 'true' : 'false' %>;  // ✅ add this
    // Set CSRF token from server
    window.csrfToken = '<%= csrfToken %>';
    
    // ✅ Simple toast notification (similar to public-profile)
    function showNotification(message, type = 'info') {
        const existing = document.getElementById('dashboard-notification');
        if (existing) existing.remove();

        const el = document.createElement('div');
        el.id = 'dashboard-notification';
        el.className =
            'fixed top-20 right-4 z-50 px-6 py-4 rounded-xl shadow-2xl transition-all duration-300 ' +
            (type === 'success'
                ? 'bg-gradient-to-r from-green-500 to-emerald-500 text-white'
                : 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white');

        const icon = type === 'success' ? '✅' : 'ℹ️';
        el.innerHTML = `
            <div class="flex items-center gap-3">
                <span class="text-xl">${icon}</span>
                <span class="font-semibold">${message}</span>
            </div>
        `;

        document.body.appendChild(el);

        setTimeout(() => {
            el.style.opacity = '1';
        }, 10);

        setTimeout(() => {
            el.style.opacity = '0';
            setTimeout(() => {
                if (el.parentNode) el.parentNode.removeChild(el);
            }, 300);
        }, 3000);
    }
    
    async function startNewChat() {        
        try {
            // Redirect to enhanced chat
            window.location.href = '/chat';
        } catch (error) {
            ErrorLogger.error('Start chat error', error, {});
            showNotification('Network error. Please try again.', 'error');
        }
    }
    // ===== DISCOVER SECTION FUNCTIONS =====
    
    // Load trending twins for Discover section
    async function loadTrendingTwins() {
        try {
            const response = await fetch('/api/discover/trending?limit=5&offset=0');
            const data = await response.json();
            
            if (data.success && data.twins && data.twins.length > 0) {
                renderTrendingCarousel(data.twins);
            } else {
                // Show empty state
                const container = document.getElementById('trendingCards');
                if (container) {
                    container.innerHTML = `
                        <div class="bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 rounded-xl p-6 border border-amber-200/50 dark:border-amber-800/30 text-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-amber-100 to-orange-100 dark:from-amber-900/40 dark:to-orange-900/40 rounded-full flex items-center justify-center mx-auto mb-3">
                                <span class="text-2xl">🌟</span>
                            </div>
                            <p class="text-gray-600 dark:text-gray-300 text-sm">No trending twins available right now.</p>
                            <p class="text-gray-500 dark:text-gray-400 text-xs mt-1">Check back later for exciting discoveries!</p>
                        </div>
                    `;
                }
            }
        } catch (error) {
            ErrorLogger.error('Error loading trending twins', error, {});
            const container = document.getElementById('trendingCards');
            if (container) {
                container.innerHTML = `
                    <div class="bg-red-50 dark:bg-red-900/20 rounded-xl p-6 border border-red-200/50 dark:border-red-800/30 text-center">
                        <div class="w-12 h-12 bg-gradient-to-r from-red-100 to-pink-100 dark:from-red-900/40 dark:to-pink-900/40 rounded-full flex items-center justify-center mx-auto mb-3">
                            <span class="text-2xl">⚠️</span>
                        </div>
                        <p class="text-red-600 dark:text-red-400 text-sm">Failed to load trending twins</p>
                        <p class="text-red-500 dark:text-red-500 text-xs mt-1">Please refresh the page</p>
                    </div>
                `;
            }
        }
    }
    
    // Render trending carousel
    function renderTrendingCarousel(twins) {
        const container = document.getElementById('trendingCards');
        if (!container) return;
        
        container.innerHTML = '';
        twins.forEach(twin => {
            const card = createTwinCard(twin);
            container.appendChild(card);
        });
    }
    
    // Create twin card HTML element
    function createTwinCard(twin) {
        const card = document.createElement('div');
        card.className = 'twin-card-discover w-[280px] max-w-[280px] bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm rounded-xl shadow-md dark:shadow-gray-900 p-6 border border-white/30 dark:border-gray-700 hover:shadow-xl hover:scale-[1.02] transition-all duration-300 cursor-pointer flex-shrink-0';
        card.setAttribute('data-twin-id', twin.publicId || twinPublicId);
        
         // ✅ Prefer real user handle, then publicHandle, last fallback 'twin'
    const displayHandle = twin.userHandle || twin.publicHandle || 'twin';
        
        // ✅ Prefer user's actual profile image, then twin profile image, else initial
        const profileImage = twin.userProfileImage || twin.profileImage || null;
        const avatarInitial = displayHandle.charAt(0).toUpperCase();
        
        card.innerHTML = `
            <div class="flex items-center mb-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-primary to-accent rounded-full flex items-center justify-center text-white font-bold shadow-lg mr-3 flex-shrink-0">
                        ${profileImage ? `<img src="${profileImage}" alt="${displayHandle}" class="w-12 h-12 rounded-full object-cover" loading="lazy">` : avatarInitial}                    
                    </div>
                <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h4 class="font-semibold text-gray-900 dark:text-white truncate">@${displayHandle}</h4>
                            ${twin.verified ? '<span class="text-primary text-xs flex-shrink-0">✓</span>' : ''}
                        </div>
                        <p class="text-xs text-gray-500 dark:text-gray-400 truncate">${twin.userName || twin.userHandle || 'Twin'}</p>
                    </div>
