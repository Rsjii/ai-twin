        if (chatNowBtn) {
            chatNowBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                e.stopPropagation();
                const twinId = this.getAttribute('data-twin-id');
                if (!twinId) return;

                try {
                    const response = await fetch(`/api/public-twin/check-owner/${twinId}`, {
                        credentials: 'include'
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.isOwner) {
                            // ✅ Same behaviour as twin profile / discover
                            showNotification(
                                'You cannot chat with your own twin in public chat. Redirecting to Chat...',
                                'info'
                            );
                            setTimeout(() => {
                                window.location.href = '/chat';
                            }, 800);
                            return;
                        }
                    }
                } catch (err) {
                    ErrorLogger.error('Error checking own twin from dashboard trending', err, {});
                }

                window.location.href = `/public-twin/chat/${twinId}`;
            });
        }
        
        // Click on card also navigates
        card.addEventListener('click', function(e) {
            if (e.target.closest('.chat-now-btn')) {
                return;
            }
            if (e.target.tagName !== 'BUTTON') {
        // OLD:
        // window.location.href = '/@' + (twin.publicHandle || 'twin');

        // ✅ NEW: prefer real user handle, then fallback to publicHandle, else no-op
        const profileHandle = twin.userHandle || twin.publicHandle || '';
        if (profileHandle) {
            window.location.href = '/@' + profileHandle;
        } else {
            ErrorLogger.warn('[createTwinCard] No handle available for profile redirect', { twin });
            showNotification('Profile is not available for this twin yet.', 'error');
        }
            }
        });
        
        return card;        
    }
    
// Load public chat interactions (twins user chatted with)
async function loadPublicChatInteractions() {
    try {
        const response = await fetch('/api/public-chat/user/my-chats', {
            credentials: 'include',
            headers: {
                'X-CSRF-Token': '<%= csrfToken %>'
            }
        });
        
        if (!response.ok) {
            if (response.status === 401) {
                renderRecentInteractions([]);
                return;
            }
            throw new Error('Failed to fetch public chats');
        }

        const data = await response.json();
        
        if (!data.success || !data.chats || data.chats.length === 0) {
            renderRecentInteractions([]);
            return;
        }
        
        // API returns: { success: true, chats: [{ twin, latestChat, lastMessage }], total }
        // Already sorted by lastActivity DESC
        // Show 2 chats if available, otherwise show what we have
        const maxToShow = Math.min(MAX_RECENT_CHATS, data.chats.length);
        const twinChats = data.chats.slice(0, maxToShow);
        
        renderRecentInteractions(twinChats);        
    } catch (error) {
        ErrorLogger.error('❌ Error loading public chat interactions', error, {});
        // Don't hide section, show error message instead
        const container = document.getElementById('recentInteractions');
        if (container) {
            container.innerHTML = `
                <div class="bg-red-50 dark:bg-red-900/20 rounded-xl p-6 border border-red-200 dark:border-red-800/30 text-center">
                    <p class="text-red-600 dark:text-red-400 text-sm mb-2">Unable to load recent chats</p>
                    <button onclick="loadPublicChatInteractions()" class="text-xs text-red-500 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 underline">
                        Try Again
                    </button>
                </div>
            `;
        }
    }
}    

