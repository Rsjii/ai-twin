function hideChatSection() {
    document.getElementById('chatSection').classList.add('hidden');
}

function addChatFormListeners() {
    // Character counter
    const messageInput = document.getElementById('messageInput');
    if (messageInput) {
        messageInput.addEventListener('input', (e) => {
            const count = e.target.value.length;
            document.getElementById('charCount').textContent = count;
        });
    }
    
    // Chat form submission
    const chatForm = document.getElementById('chatForm');
    if (chatForm) {
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const message = document.getElementById('messageInput').value.trim();
            if (!message) return;
            
            // Show loading
            const submitBtn = e.target.querySelector('button[type="submit"]');
            const originalText = submitBtn.textContent;
            submitBtn.textContent = 'Sending...';
            submitBtn.disabled = true;
            
            try {
                // Here you can add logic to send the message
                console.log('Sending message:', message);
                
                // For now, just show success
                showFlashMessage('Message sent successfully!', 'success');
                
                // Clear form
                document.getElementById('messageInput').value = '';
                document.getElementById('charCount').textContent = '0';
                
            } catch (error) {
                console.error('Send message error:', error);
                showFlashMessage('Failed to send message. Please try again.', 'error');
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        });
    }
}

