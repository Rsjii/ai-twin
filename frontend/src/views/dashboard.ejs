    async function loadTwins() {
        try {
            const response = await fetch('/api/twin', {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            });
            
            const result = await response.json();
            
            if (response.ok) {
                const twinsList = document.getElementById('twinsList');
                if (result.twins.length === 0) {
                    twinsList.innerHTML = '<p class="text-gray-500">No twins created yet.</p>';
                } else {
                    twinsList.innerHTML = result.twins.map(twin => 
                        '<div class="border rounded-lg p-3">' +
                        '<p class="font-medium">Twin #' + twin.publicId.slice(-6) + '</p>' +
                        '</div>'
                    ).join('');
                }
            }
        } catch (error) {
            ErrorLogger.error('Load twins error', error, {});
        }
    }
    
    async function generateProfileLink() {
        try {
            const response = await fetch('/api/profile/link', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            });
            
            const result = await response.json();
            
            if (response.ok) {
                navigator.clipboard.writeText(window.location.origin + result.profileUrl);
                showNotification('Profile link copied to clipboard!', 'success');
            } else {
                showNotification(result.error || 'Failed to generate profile link', 'error');
            }
        } catch (error) {
            ErrorLogger.error('Generate profile link error', error, {});
            showNotification('Network error. Please try again.', 'error');
        }
    }
    
async function createInvite() {
    try {
        const response = await fetch('/api/invite/my-code', {
            method: 'GET',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            // Copy just the referral code, not the full URL
            const referralCode = result.referralCode;
            await navigator.clipboard.writeText(referralCode);
            showNotification('Referral code copied to clipboard!', 'success');
        } else {
            ErrorLogger.error('❌ API error', null, { result });
            showNotification(result.error || 'Failed to get referral code', 'error');
        }
    } catch (error) {
        ErrorLogger.error('💥 Get referral code error', error, {});
        showNotification('Network error. Please try again.', 'error');
    }
}
