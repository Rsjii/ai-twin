async function makeTwinPublic() {
    try {
        const response = await fetch('/api/public-twin/make-public', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': window.csrfToken
            },
            body: JSON.stringify({
                bio: 'Check out my AI twin!',
                publicHandle: generateHandle()
            })
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
            showFlashMessage('Twin made public successfully!', 'success');
            loadPublicTwinStatus();
        } else {
            showFlashMessage(result.error || 'Failed to make twin public', 'error');
        }
    } catch (error) {
        console.error('Make twin public error:', error);
        showFlashMessage('Network error. Please try again.', 'error');
    }
}

async function sharePublicTwin(handle) {
    const url = `${window.location.origin}/@${handle}`;
    try {
        await navigator.clipboard.writeText(url);
        showFlashMessage('Public profile link copied to clipboard!', 'success');
    } catch (error) {
        console.error('Copy to clipboard error:', error);
        showFlashMessage('Failed to copy link. Please copy manually: ' + url, 'error');
    }
}

