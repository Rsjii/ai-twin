    <script>
        (function() {
            // Check if user is authenticated (from EJS template)
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            
            // Also check localStorage for auth state
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            // If not authenticated, redirect immediately (prevents back button showing cached page)
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            // Double-check: if user object is null/undefined, redirect
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
