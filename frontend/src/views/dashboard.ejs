            // document.addEventListener('touchend', handleTouchEnd, { passive: true });
            
            // Setup logout button
            const logoutBtn = document.querySelector('button[onclick="logout()"]');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    logout();
                });
            } else {
                ErrorLogger.error('Logout button not found on page load', null, {});
            }
            
// REPLACE lines 1826-1904 with improved theme toggle that handles header conflict:

            // ✅ Dark Mode Toggle Functionality (GLOBAL) - Fixed for header conflict
            const htmlRoot = document.documentElement;
            const darkModeToggle = document.getElementById('darkModeToggle');
            const darkModeToggleNavbar = document.getElementById('darkModeToggleNavbar');
            const sunIcon = document.getElementById('sunIcon');
            const moonIcon = document.getElementById('moonIcon');
            const sunIconNavbar = document.getElementById('sunIconNavbar');
            const moonIconNavbar = document.getElementById('moonIconNavbar');
            const darkModeText = document.getElementById('darkModeText');
            
            // Load saved theme preference
            const savedTheme = localStorage.getItem('theme') || 'light';
            const isDark = savedTheme === 'dark';
            
            // Apply theme on page load (GLOBAL)
            function applyTheme(dark) {
                if (dark) {
                    htmlRoot.classList.add('dark');
                    // Update dropdown icons
                    document.querySelectorAll('#sunIcon').forEach(el => el?.classList.remove('hidden'));
                    document.querySelectorAll('#moonIcon').forEach(el => el?.classList.add('hidden'));
                    // Update navbar icons
                    document.querySelectorAll('#sunIconNavbar').forEach(el => el?.classList.remove('hidden'));
                    document.querySelectorAll('#moonIconNavbar').forEach(el => el?.classList.add('hidden'));
                    // Update text
                    const textEl = document.getElementById('darkModeText');
                    if (textEl) textEl.textContent = 'Change to Light Mode';
                } else {
                    htmlRoot.classList.remove('dark');
                    // Update dropdown icons
                    document.querySelectorAll('#sunIcon').forEach(el => el?.classList.add('hidden'));
                    document.querySelectorAll('#moonIcon').forEach(el => el?.classList.remove('hidden'));
                    // Update navbar icons
                    document.querySelectorAll('#sunIconNavbar').forEach(el => el?.classList.add('hidden'));
                    document.querySelectorAll('#moonIconNavbar').forEach(el => el?.classList.remove('hidden'));
                    // Update text
                    const textEl = document.getElementById('darkModeText');
                    if (textEl) textEl.textContent = 'Change to Dark Mode';
                }
            }
            
            // Apply initial theme
            applyTheme(isDark);
            
            // Toggle function (GLOBAL - works across all pages)
            function toggleDarkMode() {
                const isCurrentlyDark = htmlRoot.classList.contains('dark');
                const newTheme = isCurrentlyDark ? 'light' : 'dark';
                
                // Save to localStorage (GLOBAL)
                localStorage.setItem('theme', newTheme);
                
                // Apply theme
                applyTheme(newTheme === 'dark');
                
                // Dispatch event for other pages (if needed)
                window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: newTheme } }));
            }
            
            // ✅ FIX: Remove existing listeners and re-initialize to avoid conflicts
            if (darkModeToggleNavbar) {
                // Clone button to remove all event listeners
                const newButton = darkModeToggleNavbar.cloneNode(true);
                darkModeToggleNavbar.parentNode.replaceChild(newButton, darkModeToggleNavbar);
                
                // Add fresh listener
                newButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleDarkMode();
                });
            }
            
            // Add event listener to settings toggle (if exists)
            if (darkModeToggle) {
                darkModeToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleDarkMode();
                });
            }
            
            // Listen for theme changes from other tabs/pages (GLOBAL SYNC)
            window.addEventListener('storage', (e) => {
                if (e.key === 'theme') {
                    applyTheme(e.newValue === 'dark');
                }
            });
            
            // Listen for custom theme change events
            window.addEventListener('themechange', (e) => {
                applyTheme(e.detail.theme === 'dark');
            });
        });

                // Stats loading functions
                function showStatsLoading() {
            document.getElementById('statsLoadingState')?.classList.remove('hidden');
            document.getElementById('statsContainer')?.classList.add('hidden');
            document.getElementById('statsEmptyState')?.classList.add('hidden');
            document.getElementById('statsErrorState')?.classList.add('hidden');
        }
        
        function hideStatsLoading() {
            document.getElementById('statsLoadingState')?.classList.add('hidden');
        }
        
        function showStatsEmpty() {
            document.getElementById('statsEmptyState')?.classList.remove('hidden');
            document.getElementById('statsContainer')?.classList.add('hidden');
            document.getElementById('statsLoadingState')?.classList.add('hidden');
        }
        
        function showStatsError() {
            document.getElementById('statsErrorState')?.classList.remove('hidden');
            document.getElementById('statsContainer')?.classList.add('hidden');
            document.getElementById('statsLoadingState')?.classList.add('hidden');
        }
        
        function hideStatsError() {
            document.getElementById('statsErrorState')?.classList.add('hidden');
        }
        
        // Load stats function
        async function loadStats() {
            showStatsLoading();
            hideStatsError();
            
            try {
                // Stats already loaded from server, just show them
                const statsContainer = document.getElementById('statsContainer');
                if (statsContainer) {
                    hideStatsLoading();
                    statsContainer.classList.remove('hidden');
                }
            } catch (error) {
                ErrorLogger.error('Error loading stats', error, {});
                showStatsError();
            } finally {
                hideStatsLoading();
            }
        }

        // ✅ NEW: Load analytics data for Twin Analytics Cards
        async function loadAnalytics() {
            try {
                <% if (hasTwins && twinPublicId) { %>
                const twinToken = '<%= twinPublicId %>';
                
                // Get memory count
                try {
                    const memoryRes = await fetch(`/api/twin/${twinToken}/long-term-memory?limit=1000`);
                    if (memoryRes.ok) {
                        const memoryData = await memoryRes.json();
                        const memoryCountEl = document.getElementById('memoryCount');
                        if (memoryCountEl) {
                            memoryCountEl.textContent = memoryData.memories?.length || 0;
                        }
                    }
                } catch (error) {
                    ErrorLogger.error('Failed to load memory stats', error, {});
                }

                // Get IQ growth (calculate from feedback)
                try {
                    const feedbackRes = await fetch('/api/analytics/feedback');
                    if (feedbackRes.ok) {
                        const feedbackData = await feedbackRes.json();
                        // ✅ FIX: Use correct property path
                        const satisfactionScore = feedbackData.analytics?.satisfactionScore || 0;
                        const iqGrowthEl = document.getElementById('iqGrowth');
                        if (iqGrowthEl) {
                            // satisfactionScore is already 0-100, no need to multiply
                            iqGrowthEl.textContent = `+${satisfactionScore}%`;
                        }
                    }
                } catch (error) {
                    ErrorLogger.error('Failed to load feedback stats', error, {});
                }

                // Get conversation count
                try {
                    const chatRes = await fetch('/api/chats');
                    if (chatRes.ok) {
                        const chatData = await chatRes.json();
                        const conversationCountEl = document.getElementById('conversationCount');
                        if (conversationCountEl) {
                            conversationCountEl.textContent = chatData.length || 0;
                        }
                    }
                } catch (error) {
                    ErrorLogger.error('Failed to load chat count', error, {});
                }
                <% } %>
            } catch (error) {
                ErrorLogger.error('Failed to load analytics', error, {});
            }
        }

        // Load analytics on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadAnalytics);
        } else {
            loadAnalytics();
        }
        
  // Add click handlers for social list cards
document.addEventListener('DOMContentLoaded', () => {
    const topCards = [
        { element: document.getElementById('topLikesCard'), type: 'likers' },
        { element: document.getElementById('topFollowersCard'), type: 'followers' },
        { element: document.getElementById('topChatsCard'), type: 'chatters' }
    ];
    
    topCards.forEach(card => {
        if (card.element) {
            card.element.addEventListener('click', function() {
                const twinId = this.getAttribute('data-twin-id');
                const listType = this.getAttribute('data-list-type');
                // ✅ Show view details button for dashboard
                if (twinId && typeof window.showSocialList === 'function') {
                    window.showSocialList(twinId, listType, true); // ✅ Changed to true
                }
            });
        }
    });    
});        
