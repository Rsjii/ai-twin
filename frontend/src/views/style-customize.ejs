<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Style Customize your AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Style Customize</h1>
            <p class="text-gray-600 dark:text-gray-300">Customize your AI twin's communication style and personality</p>
        </div>

        <!-- Navigation Breadcrumbs -->
<div class="mb-6">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/dashboard" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/my-twins" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">My Twins</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/twin/<%= twinId %>/learning-dashboard" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">Learning Dashboard</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-gray-900 dark:text-white font-medium">Style Customize</span>
        </li>
      </ol>
    </nav>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 dark:border-gray-700 shadow-md dark:shadow-gray-900">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="/twin/<%= twinId %>/learning-dashboard" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Learning Dashboard
        </a>
        <a href="/twin/<%= twinId %>/ai-edit" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
          AI Edit
        </a>
                    <a href="/twin/<%= twinId %>/memory-management" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                        Memory Management
                    </a>
      </div>
      <div class="text-sm text-gray-600 dark:text-gray-300">
        <span class="font-medium">Twin ID:</span> <%= twinId %>
      </div>
    </div>
  </div>

        <!-- Style Controls -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-6 mb-8 border border-white/20 dark:border-gray-700">
            <h2 class="text-xl font-semibold mb-4 dark:text-white">Communication Style</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Formality Level -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Formality Level</label>
                    <input type="range" id="formality" min="0" max="1" step="0.1" value="0.5" 
                           class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                    <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Casual</span>
                        <span id="formality-value">0.5</span>
                        <span>Formal</span>
                    </div>
                </div>

                <!-- Emoji Usage -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Emoji Usage</label>
                    <input type="range" id="emoji_usage" min="0" max="1" step="0.1" value="0.3" 
                           class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                    <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>None</span>
                        <span id="emoji-value">0.3</span>
                        <span>Frequent</span>
                    </div>
                </div>

                <!-- Humor Style -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Humor Style</label>
                    <select id="humor_style" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white">
                        <option value="none">None</option>
                        <option value="light" selected>Light</option>
                        <option value="moderate">Moderate</option>
                        <option value="heavy">Heavy</option>
                    </select>
                </div>

                <!-- Question Frequency -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Question Frequency</label>
                    <input type="range" id="question_frequency" min="0" max="1" step="0.1" value="0.4" 
                           class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                    <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Rare</span>
                        <span id="question-value">0.4</span>
                        <span>Frequent</span>
                    </div>
                </div>

                <!-- Response Length -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Response Length</label>
                    <select id="response_length_preference" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white">
                        <option value="brief">Brief</option>
                        <option value="detailed" selected>Detailed</option>
                        <option value="comprehensive">Comprehensive</option>
                    </select>
                </div>

                <!-- Tone -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Tone</label>
                    <select id="tone" class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white">
                        <option value="casual" selected>Casual</option>
                        <option value="witty">Witty</option>
                        <option value="serious">Serious</option>
                        <option value="friendly">Friendly</option>
                        <option value="professional">Professional</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Style Anchors Preview Section -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-6 mb-8 border border-white/20 dark:border-gray-700">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold dark:text-white">Style Anchors</h2>
                <a href="/twin/<%= twinId %>/memory-management" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium">
                    Manage All Style Anchors →
                </a>
            </div>

            <!-- Tabs -->
            <div class="flex space-x-2 mb-4 border-b border-gray-200 dark:border-gray-700">
                <button id="tab-phrases" data-tab="phrases" class="px-4 py-2 font-medium text-blue-600 dark:text-blue-400 border-b-2 border-blue-600 dark:border-blue-400 style-anchor-tab">
                    Phrases
                </button>
                <button id="tab-interactions" data-tab="interactions" class="px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 style-anchor-tab">
                    Interactions
                </button>
            </div>

            <!-- Phrases Tab Content -->
            <div id="phrases-content" class="style-anchor-content">
                <div id="phrasesList" class="space-y-3 mb-4 min-h-[100px]">
                    <div class="text-center text-gray-500 py-4">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mx-auto"></div>
                        <p class="mt-2">Loading phrases...</p>
                    </div>
                </div>
            </div>

            <!-- Interactions Tab Content -->
            <div id="interactions-content" class="style-anchor-content" style="display: none;">
                <div id="interactionsList" class="space-y-3 mb-4 min-h-[100px]">
                    <div class="text-center text-gray-500 py-4">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mx-auto"></div>
                        <p class="mt-2">Loading interactions...</p>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex justify-between text-sm text-gray-600 dark:text-gray-300">
                    <span>Total Phrases: <span id="totalPhrases" class="font-medium text-gray-900 dark:text-white">0</span></span>
                    <span>Total Interactions: <span id="totalInteractions" class="font-medium text-gray-900 dark:text-white">0</span></span>
                </div>
            </div>
        </div>


        <!-- Action Buttons -->
        <div class="flex justify-between items-center">
            <button id="previewChangesBtn" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                Preview Changes
            </button>
            <div class="space-x-4">
                <button id="resetChangesBtn" class="bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 px-6 py-2 rounded-xl hover:bg-white dark:hover:bg-gray-700 border border-white/20 dark:border-gray-600 transition-all font-medium shadow-md">
                    Reset
                </button>
                <button id="saveChangesBtn" class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                    Save Changes
                </button>
            </div>
        </div>

        <!-- Preview Section -->
        <div id="preview-section" class="mt-8 bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 border border-white/20" style="display: none;">
            <h3 class="text-lg font-semibold mb-4">Preview Your Changes</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h4 class="font-medium mb-2">Current Response:</h4>
                    <div id="original-text" class="p-4 bg-white/60 backdrop-blur-sm rounded-xl border border-white/20"></div>
                </div>
                <div>
                    <h4 class="font-medium mb-2">New Response:</h4>
                    <div id="new-text" class="p-4 bg-primary/10 backdrop-blur-sm rounded-xl border border-primary/20"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
    let currentTwinData = null;
    const twinId = '<%= twinId %>';
    let currentStyleAnchorTab = 'phrases';

    // Load twin data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTwinData();
        setupRangeListeners();
        setupEventListeners();
        loadStyleAnchors();
    });

    function setupEventListeners() {
        // Style anchor tab switching
        document.querySelectorAll('.style-anchor-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                const tabType = this.dataset.tab;
                switchStyleAnchorTab(tabType);
            });
        });

        // Action buttons
        const previewBtn = document.getElementById('previewChangesBtn');
        if (previewBtn) {
            previewBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Preview button clicked');
                previewChanges();
            });
        }

        const resetBtn = document.getElementById('resetChangesBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Reset button clicked');
                resetChanges();
            });
        }

        const saveBtn = document.getElementById('saveChangesBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Save button clicked');
                saveChanges();
            });
        }
    }

    function switchStyleAnchorTab(tabType) {
        currentStyleAnchorTab = tabType;
        
        // Update tab styles
        document.querySelectorAll('.style-anchor-tab').forEach(tab => {
            tab.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
            tab.classList.add('text-gray-600');
        });
        document.getElementById(`tab-${tabType}`).classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
        document.getElementById(`tab-${tabType}`).classList.remove('text-gray-600');

        // Show/hide content
        document.getElementById('phrases-content').style.display = tabType === 'phrases' ? 'block' : 'none';
        document.getElementById('interactions-content').style.display = tabType === 'interactions' ? 'block' : 'none';

        // Reload data for selected tab
        if (tabType === 'phrases') {
            loadPhrases();
        } else {
            loadInteractions();
        }
    }


    function setupRangeListeners() {
        const formality = document.getElementById('formality');
        const emoji = document.getElementById('emoji_usage');
        const question = document.getElementById('question_frequency');
        
        if (formality) {
            formality.addEventListener('input', function() {
            document.getElementById('formality-value').textContent = this.value;
        });
        }
        if (emoji) {
            emoji.addEventListener('input', function() {
            document.getElementById('emoji-value').textContent = this.value;
        });
        }
        if (question) {
            question.addEventListener('input', function() {
            document.getElementById('question-value').textContent = this.value;
        });
        }
    }

    async function loadTwinData() {
        try {
            const response = await fetch(`/api/twin/${twinId}/edit-data`);
            const data = await response.json();
            
            if (data.success) {
                currentTwinData = data.twin;
                populateForm(data.twin);
            }
        } catch (error) {
            console.error('Error loading twin data:', error);
        }
    }

    function populateForm(twin) {
        const styleVector = twin.styleVector || {};
        const formalityEl = document.getElementById('formality');
        const emojiEl = document.getElementById('emoji_usage');
        const humorEl = document.getElementById('humor_style');
        const questionEl = document.getElementById('question_frequency');
        const responseEl = document.getElementById('response_length_preference');
        const toneEl = document.getElementById('tone');

        if (formalityEl) formalityEl.value = styleVector.formality || styleVector.formality_level || 0.5;
        if (emojiEl) emojiEl.value = styleVector.emoji_usage || 0.3;
        if (humorEl) humorEl.value = styleVector.humor_style || 'light';
        if (questionEl) questionEl.value = styleVector.question_frequency || 0.4;
        if (responseEl) responseEl.value = styleVector.response_length_preference || 'detailed';
        if (toneEl) toneEl.value = styleVector.tone || 'casual';
                
        updateRangeDisplays();
    }

    function updateRangeDisplays() {
        const formalityEl = document.getElementById('formality');
        const emojiEl = document.getElementById('emoji_usage');
        const questionEl = document.getElementById('question_frequency');
        const formalityValue = document.getElementById('formality-value');
        const emojiValue = document.getElementById('emoji-value');
        const questionValue = document.getElementById('question-value');

        if (formalityEl && formalityValue) {
            formalityValue.textContent = formalityEl.value;
        }
        if (emojiEl && emojiValue) {
            emojiValue.textContent = emojiEl.value;
        }
        if (questionEl && questionValue) {
            questionValue.textContent = questionEl.value;
        }
    }

    async function loadStyleAnchors() {
        await Promise.all([
            loadPhrases(),
            loadInteractions(),
            loadStyleAnchorStats()
        ]);
    }

    async function loadPhrases() {
        try {
            const response = await fetch(`/api/twin/${twinId}/style-anchors?type=phrase&limit=5`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            const phrasesListEl = document.getElementById('phrasesList');
            if (!phrasesListEl) return;

            if (data.success && data.anchors && data.anchors.length > 0) {
                const phrasesHTML = data.anchors.map(anchor => {
                    const phrase = anchor.phrase || '';
                    const tags = anchor.tags || [];
                    const date = anchor.created_at ? new Date(anchor.created_at).toLocaleDateString() : '';
                    const tagsDisplay = tags.length > 0 ? tags.map(tag => `<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs rounded">${escapeHtml(tag)}</span>`).join(' ') : '';
                    
                    return `
                        <div class="flex justify-between items-start p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <div class="flex-1">
                                <p class="text-sm text-gray-900 dark:text-white font-medium">${escapeHtml(phrase)}</p>
                                <div class="flex items-center space-x-2 mt-1">
                                    ${tagsDisplay}
                                    <span class="text-xs text-gray-500 dark:text-gray-400">${date}</span>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
                phrasesListEl.innerHTML = phrasesHTML;
            } else {
                phrasesListEl.innerHTML = `<p class="text-gray-500 dark:text-gray-400 text-center py-4">No phrases yet. <a href="/twin/${twinId}/memory-management" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">Add your first one here</a>!</p>`;
            }
        } catch (error) {
            console.error('Error loading phrases:', error);
            const phrasesListEl = document.getElementById('phrasesList');
            if (phrasesListEl) {
                phrasesListEl.innerHTML = '<p class="text-red-500 text-center py-4">Error loading phrases</p>';
            }
        }
    }

    async function loadInteractions() {
        try {
            const response = await fetch(`/api/twin/${twinId}/style-anchors?type=interaction&limit=5`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            const interactionsListEl = document.getElementById('interactionsList');
            if (!interactionsListEl) return;

            if (data.success && data.anchors && data.anchors.length > 0) {
                const interactionsHTML = data.anchors.map(anchor => {
                    const userUtterance = anchor.user_utterance || '';
                    const idealReply = anchor.ideal_reply || '';
                    const tags = anchor.tags || [];
                    const date = anchor.created_at ? new Date(anchor.created_at).toLocaleDateString() : '';
                    const tagsDisplay = tags.length > 0 ? tags.map(tag => `<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs rounded">${escapeHtml(tag)}</span>`).join(' ') : '';
                    
                    return `
                        <div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <div class="mb-2">
                                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">User:</p>
                                <p class="text-sm text-gray-700 dark:text-gray-300">${escapeHtml(userUtterance)}</p>
                            </div>
                            <div class="mb-2">
                                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Ideal Reply:</p>
                                <p class="text-sm text-gray-900 dark:text-white font-medium">${escapeHtml(idealReply)}</p>
                            </div>
                            <div class="flex items-center space-x-2">
                                ${tagsDisplay}
                                <span class="text-xs text-gray-500 dark:text-gray-400">${date}</span>
                            </div>
                        </div>
                    `;
                }).join('');
                interactionsListEl.innerHTML = interactionsHTML;
            } else {
                interactionsListEl.innerHTML = `<p class="text-gray-500 dark:text-gray-400 text-center py-4">No interactions yet. <a href="/twin/${twinId}/memory-management" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">Add your first one here</a>!</p>`;
            }
        } catch (error) {
            console.error('Error loading interactions:', error);
            const interactionsListEl = document.getElementById('interactionsList');
            if (interactionsListEl) {
                interactionsListEl.innerHTML = '<p class="text-red-500 text-center py-4">Error loading interactions</p>';
            }
        }
    }

    async function loadStyleAnchorStats() {
        try {
            const response = await fetch(`/api/twin/${twinId}/style-anchors?limit=1000`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            if (data.success && data.anchors) {
                const phrases = data.anchors.filter(a => a.type === 'phrase' || a.phrase);
                const interactions = data.anchors.filter(a => a.type === 'interaction' || (a.user_utterance && a.ideal_reply));
                
                const totalPhrasesEl = document.getElementById('totalPhrases');
                const totalInteractionsEl = document.getElementById('totalInteractions');
                
                if (totalPhrasesEl) totalPhrasesEl.textContent = phrases.length;
                if (totalInteractionsEl) totalInteractionsEl.textContent = interactions.length;
            }
        } catch (error) {
            console.error('Error loading style anchor stats:', error);
        }
    }


    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function previewChanges() {
        if (!currentTwinData) {
            alert('Please wait for data to load first');
            return;
        }

        const styleVector = currentTwinData.styleVector || {};
        
        const current = {
            formality: styleVector.formality || styleVector.formality_level || 0.5,
            emoji_usage: styleVector.emoji_usage || 0.3,
            humor_style: styleVector.humor_style || 'light',
            question_frequency: styleVector.question_frequency || 0.4,
            response_length_preference: styleVector.response_length_preference || 'detailed',
            tone: styleVector.tone || 'casual'
        };
        
        const updated = {
            formality: parseFloat(document.getElementById('formality')?.value || 0.5),
            emoji_usage: parseFloat(document.getElementById('emoji_usage')?.value || 0.3),
            humor_style: document.getElementById('humor_style')?.value || 'light',
            question_frequency: parseFloat(document.getElementById('question_frequency')?.value || 0.4),
            response_length_preference: document.getElementById('response_length_preference')?.value || 'detailed',
            tone: document.getElementById('tone')?.value || 'casual'
        };
        
        let changes = [];
        Object.keys(current).forEach(key => {
            if (String(current[key]) !== String(updated[key])) {
                changes.push(`${key}: "${current[key]}" → "${updated[key]}"`);
            }
        });
        
        if (changes.length === 0) {
            alert('No changes detected');
        } else {
            alert('Preview Changes:\n\n' + changes.join('\n'));
        }
    }

    async function saveChanges() {
        const styleUpdates = getStyleChanges();
        
        try {
            if (Object.keys(styleUpdates).length > 0) {
                const response = await fetch(`/api/twin/${twinId}/update-style`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': window.csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify(styleUpdates)
                });
                
                const data = await response.json();
                if (data.success) {
                    alert('Changes saved successfully!');
                    loadTwinData();
                } else {
                    alert('Error: ' + (data.error || 'Failed to save changes'));
                }
            } else {
                alert('No changes to save');
            }
        } catch (error) {
            console.error('Error saving changes:', error);
            alert('Error saving changes');
        }
    }

    function getStyleChanges() {
        return {
            formality_level: parseFloat(document.getElementById('formality')?.value || 0.5),
            emoji_usage: parseFloat(document.getElementById('emoji_usage')?.value || 0.3),
            humor_style: document.getElementById('humor_style')?.value || 'light',
            question_frequency: parseFloat(document.getElementById('question_frequency')?.value || 0.4),
            response_length_preference: document.getElementById('response_length_preference')?.value || 'detailed',
            tone: document.getElementById('tone')?.value || 'casual'
        };
    }

    function resetChanges() {
        if (currentTwinData) {
            populateForm(currentTwinData);
            alert('Form reset to original values');
        } else {
            alert('No data loaded. Please refresh the page.');
        }
    }

    // Make functions globally accessible
    window.previewChanges = previewChanges;
    window.resetChanges = resetChanges;
    window.saveChanges = saveChanges;
    </script>
</body>
</html>