<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Style Customize your AI Twin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 min-h-screen font-inter">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Style Customize</h1>
            <p class="text-gray-600">Customize your AI twin's communication style and personality</p>
        </div>


        <!-- Navigation Breadcrumbs -->
<div class="mb-6">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/dashboard" class="text-gray-500 hover:text-gray-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/my-twins" class="text-gray-500 hover:text-gray-700 transition-colors">My Twins</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/twin/<%= twinId %>/learning-dashboard" class="text-gray-500 hover:text-gray-700 transition-colors">Learning Dashboard</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-gray-900 font-medium">Style Customize</span>
        </li>
      </ol>
    </nav>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 shadow-md">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="/twin/<%= twinId %>/learning-dashboard" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Learning Dashboard
        </a>
        <a href="/twin/<%= twinId %>/ai-edit" class="bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
          AI Edit
        </a>
      </div>
      <div class="text-sm text-gray-600">
        <span class="font-medium">Twin ID:</span> <%= twinId %>
      </div>
    </div>
  </div>

        <!-- Style Controls -->
        <div class="bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 mb-8 border border-white/20">
            <h2 class="text-xl font-semibold mb-4">Communication Style</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Formality Level -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Formality Level</label>
                    <input type="range" id="formality" min="0" max="1" step="0.1" value="0.5" 
                           class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                    <div class="flex justify-between text-xs text-gray-500">
                        <span>Casual</span>
                        <span id="formality-value">0.5</span>
                        <span>Formal</span>
                    </div>
                </div>

                <!-- Emoji Usage -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Emoji Usage</label>
                    <input type="range" id="emoji_usage" min="0" max="1" step="0.1" value="0.3" 
                           class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                    <div class="flex justify-between text-xs text-gray-500">
                        <span>None</span>
                        <span id="emoji-value">0.3</span>
                        <span>Frequent</span>
                    </div>
                </div>

                <!-- Humor Style -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Humor Style</label>
                    <select id="humor_style" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="none">None</option>
                        <option value="light" selected>Light</option>
                        <option value="moderate">Moderate</option>
                        <option value="heavy">Heavy</option>
                    </select>
                </div>

                <!-- Question Frequency -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Question Frequency</label>
                    <input type="range" id="question_frequency" min="0" max="1" step="0.1" value="0.4" 
                           class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer">
                    <div class="flex justify-between text-xs text-gray-500">
                        <span>Rare</span>
                        <span id="question-value">0.4</span>
                        <span>Frequent</span>
                    </div>
                </div>

                <!-- Response Length -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Response Length</label>
                    <select id="response_length_preference" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="brief">Brief</option>
                        <option value="detailed" selected>Detailed</option>
                        <option value="comprehensive">Comprehensive</option>
                    </select>
                </div>

                <!-- Tone -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Tone</label>
                    <select id="tone" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="casual" selected>Casual</option>
                        <option value="witty">Witty</option>
                        <option value="serious">Serious</option>
                        <option value="friendly">Friendly</option>
                        <option value="professional">Professional</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between items-center">
            <button onclick="previewChanges()" class="bg-gradient-to-r from-primary to-accent text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                Preview Changes
            </button>
            <div class="space-x-4">
                <button onclick="resetChanges()" class="bg-white/80 backdrop-blur-sm text-gray-700 px-6 py-2 rounded-xl hover:bg-white border border-white/20 transition-all font-medium shadow-md">
                    Reset
                </button>
                <button onclick="saveChanges()" class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md">
                    Save Changes
                </button>
            </div>
        </div>

        <!-- Preview Section -->
        <div id="preview-section" class="mt-8 bg-white/80 backdrop-blur-xl rounded-xl shadow-lg p-6 border border-white/20" style="display: none;">
            <h3 class="text-lg font-semibold mb-4">Preview Your Changes</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h4 class="font-medium mb-2">Current Response:</h4>
                    <div id="original-text" class="p-4 bg-white/60 backdrop-blur-sm rounded-xl border border-white/20"></div>
                </div>
                <div>
                    <h4 class="font-medium mb-2">New Response:</h4>
                    <div id="new-text" class="p-4 bg-primary/10 backdrop-blur-sm rounded-xl border border-primary/20"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
    let currentTwinData = null;
    const twinId = '<%= twinId %>';

    // Load twin data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTwinData();
        setupRangeListeners();
    });

    function setupRangeListeners() {
        document.getElementById('formality').addEventListener('input', function() {
            document.getElementById('formality-value').textContent = this.value;
        });
        document.getElementById('emoji_usage').addEventListener('input', function() {
            document.getElementById('emoji-value').textContent = this.value;
        });
        document.getElementById('question_frequency').addEventListener('input', function() {
            document.getElementById('question-value').textContent = this.value;
        });
    }

    async function loadTwinData() {
        try {
            const response = await fetch(`/api/twin/${twinId}/edit-data`);
            const data = await response.json();
            
            if (data.success) {
                currentTwinData = data.twin;
                populateForm(data.twin);
            }
        } catch (error) {
            console.error('Error loading twin data:', error);
        }
    }

    function populateForm(twin) {
        // Populate style controls
        document.getElementById('formality').value = twin.styleVector.formality || 0.5;
        document.getElementById('emoji_usage').value = twin.styleVector.emoji_usage || 0.3;
        document.getElementById('humor_style').value = twin.styleVector.humor_style || 'light';
        document.getElementById('question_frequency').value = twin.styleVector.question_frequency || 0.4;
        document.getElementById('response_length_preference').value = twin.styleVector.response_length_preference || 'detailed';
        document.getElementById('tone').value = twin.styleVector.tone || 'casual';
                
        updateRangeDisplays();
    }

    function updateRangeDisplays() {
        document.getElementById('formality-value').textContent = document.getElementById('formality').value;
        document.getElementById('emoji-value').textContent = document.getElementById('emoji_usage').value;
        document.getElementById('question-value').textContent = document.getElementById('question_frequency').value;
    }

    async function previewChanges() {
        const styleChanges = getStyleChanges();
        const testMessage = "Hello! How are you doing today?";
        
        try {
            const response = await fetch(`/api/twin/${twinId}/style-preview`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.csrfToken
                },
                body: JSON.stringify({ styleChanges, testMessage })
            });
            
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('original-text').textContent = data.originalResponse;
                document.getElementById('new-text').textContent = data.newResponse;
                document.getElementById('preview-section').style.display = 'block';
            }
        } catch (error) {
            console.error('Error previewing changes:', error);
        }
    }

    async function saveChanges() {
        const styleUpdates = getStyleChanges();
        
        try {
            if (Object.keys(styleUpdates).length > 0) {
                const response = await fetch(`/api/twin/${twinId}/update-style`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': window.csrfToken
                    },
                    body: JSON.stringify(styleUpdates)
                });
                
                const data = await response.json();
                if (data.success) {
                    alert('Changes saved successfully!');
                    loadTwinData();
                } else {
                    alert('Error: ' + (data.error || 'Failed to save changes'));
                }
            } else {
                alert('No changes to save');
            }
        } catch (error) {
            console.error('Error saving changes:', error);
            alert('Error saving changes');
        }
    }

    function getStyleChanges() {
        return {
            formality_level: parseFloat(document.getElementById('formality').value),
            emoji_usage: parseFloat(document.getElementById('emoji_usage').value),
            humor_style: document.getElementById('humor_style').value,
            question_frequency: parseFloat(document.getElementById('question_frequency').value),
            response_length_preference: document.getElementById('response_length_preference').value,
            tone: document.getElementById('tone').value
        };
    }

    function resetChanges() {
        if (currentTwinData) {
            populateForm(currentTwinData);
        }
    }
    </script>
</body>
</html>