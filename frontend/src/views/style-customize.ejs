<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Style Customize your AI Twin</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script type="module" src="/js/form-dirty-state.js"></script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script> window.csrfToken = '<%= csrfToken %>';</script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- IMMEDIATE Auth Check -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
<%
// Feature flags (if not already defined in layout)
var FEATURE_FLAGS = (typeof FEATURE_FLAGS !== 'undefined') ? FEATURE_FLAGS : {
  advancedLearningUI: false,
  memoryUI: false,
  styleAnchorsUI: false,
  chatFeedbackUI: false,
  advancedPublicAnalyticsUI: false
};
%>    
    <!--Header-->
    <%- include('header') %>    

    <div class="container mx-auto px-4 py-8">
        <!-- Page Title Section -->
        <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Style & Anchors</h1>
            <p class="text-gray-600 dark:text-gray-300">Control your twin's tone, emojis, roasting level, and typical lines here.</p>
        </div>

        <!-- Navigation Breadcrumbs -->
<div class="mb-6">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/dashboard" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/my-twins" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">My Twins</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <a href="/twin-settings" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">Twin Settings</a>
        </li>
        <li>
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-gray-900 dark:text-white font-medium">Style Customize</span>
        </li>
      </ol>
    </nav>
  </div>
  
  <!-- Quick Actions -->
  <div class="mb-6 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-xl p-4 border border-white/20 dark:border-gray-700 shadow-md dark:shadow-gray-900">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <!-- Buttons row -->
      <div class="flex flex-row flex-wrap items-center gap-2 sm:gap-4">
        <a href="/twin-settings"
           class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base"
           aria-label="Back to Twin Settings">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Twin Settings
        </a>
        <a href="/ai-edit"
           class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base"
           aria-label="AI Edit">
          AI Edit
        </a>
        <% /* TODO(V2): Memory Management button */ %>
        <% if (FEATURE_FLAGS.memoryUI) { %>
          <a href="/memory-management"
             class="inline-flex items-center justify-center bg-gradient-to-r from-primary to-accent text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base"
             aria-label="Memory Management">
            Memory Management
          </a>
        <% } %>
      </div>
    </div>
  </div>

        <!-- Communication Style -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 mb-6 sm:mb-8 border border-white/20 dark:border-gray-700">
            <h2 class="text-xl font-semibold mb-4 dark:text-white">Communication Style</h2>

            <!-- 1) Detailed Tone Preferences (from AI Edit) -->
            <div class="mb-6">
                <h3 class="text-lg font-medium mb-3 text-gray-700 dark:text-gray-300">Tone Preferences</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Formal ↔ Casual: <span id="formalCasual-value">50</span>
                        </label>
                        <input type="range" id="formalCasual" min="0" max="100" value="50" 
                               class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Serious ↔ Playful: <span id="seriousPlayful-value">50</span>
                        </label>
                        <input type="range" id="seriousPlayful" min="0" max="100" value="50" 
                               class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Direct ↔ Diplomatic: <span id="directDiplomatic-value">50</span>
                        </label>
                        <input type="range" id="directDiplomatic" min="0" max="100" value="50" 
                               class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
                    </div>
                </div>
            </div>

            <!-- 2) High-level Style Knobs (existing style-customize) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                
                <!-- Formality Level -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Formality Level</label>
                    <input type="range" id="formality" min="0" max="1" step="0.1" value="0.5" 
                           class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer min-h-[44px] touch-manipulation" aria-label="Formality Level">
                    <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Casual</span>
                        <span id="formality-value">0.5</span>
                        <span>Formal</span>
                    </div>
                </div>

                <!-- Emoji Usage (slider) -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Emoji Usage</label>
                    <input type="range" id="emoji_usage" min="0" max="1" step="0.1" value="0.3" 
                           class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer min-h-[44px] touch-manipulation" aria-label="Emoji Usage">
                    <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>None</span>
                        <span id="emoji-value">0.3</span>
                        <span>Frequent</span>
                    </div>
                </div>

                <!-- Humor Style -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Humor Style</label>
                    <select id="humor_style" class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white text-base min-h-[44px]" style="font-size: 16px;">
                        <option value="none">None</option>
                        <option value="light" selected>Light</option>
                        <option value="moderate">Moderate</option>
                        <option value="heavy">Heavy</option>
                    </select>
                </div>

                <!-- Question Frequency -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Question Frequency</label>
                    <input type="range" id="question_frequency" min="0" max="1" step="0.1" value="0.4" 
                           class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer min-h-[44px] touch-manipulation" aria-label="Question Frequency">
                    <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Rare</span>
                        <span id="question-value">0.4</span>
                        <span>Frequent</span>
                    </div>
                </div>

                <!-- Response Length Preference -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Response Length</label>
                    <select id="response_length_preference" class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white text-base min-h-[44px]" style="font-size: 16px;">
                        <option value="brief">Brief</option>
                        <option value="detailed" selected>Detailed</option>
                        <option value="comprehensive">Comprehensive</option>
                    </select>
                </div>

                <!-- Tone -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Tone</label>
                    <select id="tone" class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white text-base min-h-[44px]" style="font-size: 16px;">
                        <option value="casual" selected>Casual</option>
                        <option value="witty">Witty</option>
                        <option value="serious">Serious</option>
                        <option value="friendly">Friendly</option>
                        <option value="professional">Professional</option>
                    </select>
                </div>
            </div>

            <!-- 3) Language Preferences & Common Phrases (from AI Edit) -->
            <div class="mt-6 pt-6 border-t dark:border-gray-700">
                <h3 class="text-lg font-medium mb-3 text-gray-700 dark:text-gray-300">Language Preferences</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Greeting Style</label>
                        <input type="text" id="greetingStyle" placeholder="e.g., Hey, Hi, Hello" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Closing Style</label>
                        <input type="text" id="closingStyle" placeholder="e.g., Thanks, Cheers, Best" 
                               class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Common Phrases</label>
                        <textarea id="commonPhrases" placeholder="Phrases you commonly use..." rows="2"
                                  class="w-full px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"></textarea>
                    </div>
                </div>
            </div>
        </div>        

        <!-- Style Anchors Preview - Advanced memory/voice pattern management -->
        <% if (true) { %>
        <!-- Style Anchors Preview Section -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 mb-6 sm:mb-8 border border-white/20 dark:border-gray-700">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold dark:text-white">Style Anchors</h2>
                <a href="/memory-management" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium">
                    Manage All Style Anchors →
                </a>
            </div>

            <!-- Add style line UI -->
            <div class="mt-3 mb-4 space-y-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    Add style line (something you say a lot)
                </label>
                <div class="flex flex-col sm:flex-row gap-2">
                    <input
                        type="text"
                        id="newPhraseInput"
                        maxlength="200"
                        placeholder="e.g. bro this is next level..."
                        class="flex-1 px-3 py-2 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                    />
                    <button
                        type="button"
                        id="addPhraseBtn"
                        class="px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-md hover:shadow-lg transition-all text-sm min-h-[40px]"
                    >
                        Add style line
                    </button>
                </div>
            </div>

            <!-- Tabs -->
            <div class="flex space-x-2 mb-4 border-b border-gray-200 dark:border-gray-700">
                <button id="tab-phrases" data-tab="phrases" class="px-4 py-2 font-medium text-blue-600 dark:text-blue-400 border-b-2 border-blue-600 dark:border-blue-400 style-anchor-tab min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Phrases tab">
                    Phrases
                </button>
                <button id="tab-interactions" data-tab="interactions" class="px-4 py-2 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 style-anchor-tab min-h-[48px] sm:min-h-[44px] touch-manipulation text-base" aria-label="Interactions tab">
                    Interactions
                </button>
            </div>

            <!-- Phrases Tab Content -->
            <div id="phrases-content" class="style-anchor-content">
                <div id="phrasesList" class="space-y-3 mb-4 min-h-[100px]">
                    <div class="text-center text-gray-500 py-4">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mx-auto"></div>
                        <p class="mt-2">Loading phrases...</p>
                    </div>
                </div>
            </div>

            <!-- Interactions Tab Content -->
            <div id="interactions-content" class="style-anchor-content" style="display: none;">
                <div id="interactionsList" class="space-y-3 mb-4 min-h-[100px]">
                    <div class="text-center text-gray-500 py-4">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mx-auto"></div>
                        <p class="mt-2">Loading interactions...</p>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex justify-between text-sm text-gray-600 dark:text-gray-300">
                    <span>Total Phrases: <span id="totalPhrases" class="font-medium text-gray-900 dark:text-white">0</span></span>
                    <span>Total Interactions: <span id="totalInteractions" class="font-medium text-gray-900 dark:text-white">0</span></span>
                </div>
            </div>
        </div>
        <% } %>        


        <!-- Action Buttons -->
        <!-- Desktop: All 3 in one row -->
        <div class="hidden md:flex md:items-center md:gap-3">
            <button id="previewChangesBtn" class="flex-1 bg-gradient-to-r from-primary to-accent text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base" aria-label="Preview Changes">
                Preview Changes
            </button>
            <button id="resetChangesBtn" class="flex-1 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 px-6 py-3 rounded-xl hover:bg-white dark:hover:bg-gray-700 border border-white/20 dark:border-gray-600 transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base" aria-label="Reset Changes">
                Reset
            </button>
            <button id="saveChangesBtn" class="flex-1 bg-gray-400 cursor-not-allowed opacity-50 text-white px-6 py-3 rounded-xl transition-all font-medium shadow-md min-h-[44px] touch-manipulation text-base" aria-label="Save Changes" disabled>
                Save Changes
            </button>
        </div>
        <!-- Mobile: Preview+Reset row 1, Save row 2 -->
        <div class="flex flex-col gap-3 md:hidden">
            <div class="flex flex-row gap-3">
                <button id="previewChangesBtnMobile" class="flex-1 bg-gradient-to-r from-primary to-accent text-white px-6 py-2 rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[48px] touch-manipulation text-base" aria-label="Preview Changes">
                    Preview Changes
                </button>
                <button id="resetChangesBtnMobile" class="flex-1 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 px-6 py-2 rounded-xl hover:bg-white dark:hover:bg-gray-700 border border-white/20 dark:border-gray-600 transition-all font-medium shadow-md min-h-[48px] touch-manipulation text-base" aria-label="Reset Changes">
                    Reset
                </button>
            </div>
            <button id="saveChangesBtnMobile" class="w-full bg-gray-400 cursor-not-allowed opacity-50 text-white px-6 py-2 rounded-xl transition-all font-medium shadow-md min-h-[48px] touch-manipulation text-base" aria-label="Save Changes" disabled>
                Save Changes
            </button>
        </div>

        <!-- Preview Section -->
        <div id="preview-section" class="mt-6 sm:mt-8 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 border border-white/20 dark:border-gray-700" style="display: none;">
            <h3 class="text-lg font-semibold mb-4 dark:text-white">Sample reply with current settings</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <div>
                    <h4 class="font-medium mb-2 dark:text-white">Current style:</h4>
                    <div id="original-text" class="p-4 bg-white/60 dark:bg-gray-700/60 backdrop-blur-sm rounded-xl border border-white/20 dark:border-gray-600 text-gray-900 dark:text-white"></div>
                </div>
                <div>
                    <h4 class="font-medium mb-2 dark:text-white">New style with sliders:</h4>
                    <div id="new-text" class="p-4 bg-primary/10 dark:bg-primary/20 backdrop-blur-sm rounded-xl border border-primary/20 dark:border-primary/30 text-gray-900 dark:text-white"></div>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
    import { initDirtyForm } from '/js/form-dirty-state.js';
    
    let currentTwinData = null;
    // ✅ SECURITY: Use tokenized twinToken instead of raw twinToken
    const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : "" %>';
    let dirtyFormTracker = null;
    let dirtyFormTrackerMobile = null;
    // ✅ FIX: Read tab from URL on init, default to 'phrases'
    const urlParams = new URLSearchParams(window.location.search);
    let currentStyleAnchorTab = urlParams.get('tab') || 'phrases';
    // Validate tab value
    if (currentStyleAnchorTab !== 'phrases' && currentStyleAnchorTab !== 'interactions') {
        currentStyleAnchorTab = 'phrases';
    }

    // Load twin data on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadTwinData();
        setupRangeListeners();
        setupEventListeners();
        loadStyleAnchors();
        // ✅ FIX: Restore tab state on page load
        switchStyleAnchorTab(currentStyleAnchorTab, false); // false = don't update URL (already set)
        
        // ✅ Initialize dirty form tracking after form is populated
        setTimeout(() => {
            const container = document.querySelector('.container');
            if (container) {
                dirtyFormTracker = initDirtyForm(container, '#saveChangesBtn', '#resetChangesBtn');
                dirtyFormTrackerMobile = initDirtyForm(container, '#saveChangesBtnMobile', '#resetChangesBtnMobile');
            }
        }, 800);
    });

    function setupEventListeners() {
        // Style anchor tab switching
        document.querySelectorAll('.style-anchor-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                const tabType = this.dataset.tab;
                switchStyleAnchorTab(tabType, true); // ✅ true = update URL
            });
        });

        // Action buttons
        const previewBtn = document.getElementById('previewChangesBtn');
        if (previewBtn) {
            previewBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Preview button clicked');
                previewChanges();
            });
        }

        const resetBtn = document.getElementById('resetChangesBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Reset button clicked');
                resetChanges();
            });
        }

        const saveBtn = document.getElementById('saveChangesBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Save button clicked');
                saveChanges();
            });
        }

        // Mobile button handlers
        const previewBtnMobile = document.getElementById('previewChangesBtnMobile');
        if (previewBtnMobile) {
            previewBtnMobile.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Preview button clicked (mobile)');
                previewChanges();
            });
        }

        const resetBtnMobile = document.getElementById('resetChangesBtnMobile');
        if (resetBtnMobile) {
            resetBtnMobile.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Reset button clicked (mobile)');
                resetChanges();
            });
        }

        const saveBtnMobile = document.getElementById('saveChangesBtnMobile');
        if (saveBtnMobile) {
            saveBtnMobile.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Save button clicked (mobile)');
                saveChanges();
            });
        }

        // Add style line
        const addPhraseBtn = document.getElementById('addPhraseBtn');
        if (addPhraseBtn) {
            addPhraseBtn.addEventListener('click', (e) => {
                e.preventDefault();
                addNewPhrase();
            });
        }

        // Phrases list: Edit / Delete
        const phrasesListEl = document.getElementById('phrasesList');
        if (phrasesListEl) {
            phrasesListEl.addEventListener('click', async (e) => {
                const target = e.target;
                if (!(target instanceof HTMLElement)) return;

                const wrapper = target.closest('[data-anchor-id]');
                if (!wrapper) return;
                const anchorId = wrapper.getAttribute('data-anchor-id');
                if (!anchorId) return;

                if (target.classList.contains('delete-phrase-btn')) {
                    e.preventDefault();
                    if (!window.confirm('Delete this style line?')) return;
                    await deleteAnchor(anchorId);
                    await Promise.all([loadPhrases(), loadStyleAnchorStats()]);
                } else if (target.classList.contains('edit-phrase-btn')) {
                    e.preventDefault();
                    const textEl = wrapper.querySelector('p.text-sm');
                    const currentText = textEl ? textEl.textContent || '' : '';
                    const nextText = window.prompt('Edit style line:', currentText);
                    if (!nextText || !nextText.trim()) return;
                    await updatePhrase(anchorId, nextText.trim());
                    await Promise.all([loadPhrases(), loadStyleAnchorStats()]);
                }
            });
        }

        // Interactions list: Delete
        const interactionsListEl = document.getElementById('interactionsList');
        if (interactionsListEl) {
            interactionsListEl.addEventListener('click', async (e) => {
                const target = e.target;
                if (!(target instanceof HTMLElement)) return;
                if (!target.classList.contains('delete-interaction-btn')) return;

                const wrapper = target.closest('[data-anchor-id]');
                if (!wrapper) return;
                const anchorId = wrapper.getAttribute('data-anchor-id');
                if (!anchorId) return;

                e.preventDefault();
                if (!window.confirm('Delete this interaction anchor?')) return;
                await deleteAnchor(anchorId);
                await Promise.all([loadInteractions(), loadStyleAnchorStats()]);
            });
        }
    }

    function switchStyleAnchorTab(tabType, updateUrl = true) {
        currentStyleAnchorTab = tabType;
        
        // ✅ FIX: Update URL query param
        if (updateUrl) {
            const url = new URL(window.location);
            url.searchParams.set('tab', tabType);
            window.history.replaceState({}, '', url);
        }
        
        // Update tab styles
        document.querySelectorAll('.style-anchor-tab').forEach(tab => {
            tab.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600', 'dark:text-blue-400', 'dark:border-blue-400');
            tab.classList.add('text-gray-600', 'dark:text-gray-300');
        });
        const activeTab = document.getElementById(`tab-${tabType}`);
        if (activeTab) {
            activeTab.classList.add('text-blue-600', 'border-b-2', 'border-blue-600', 'dark:text-blue-400', 'dark:border-blue-400');
            activeTab.classList.remove('text-gray-600', 'dark:text-gray-300');
        }

        // Show/hide content
        const phrasesContent = document.getElementById('phrases-content');
        const interactionsContent = document.getElementById('interactions-content');
        if (phrasesContent) phrasesContent.style.display = tabType === 'phrases' ? 'block' : 'none';
        if (interactionsContent) interactionsContent.style.display = tabType === 'interactions' ? 'block' : 'none';

        // Reload data for selected tab
        if (tabType === 'phrases') {
            loadPhrases();
        } else {
            loadInteractions();
        }
    }


    function setupRangeListeners() {
        const formality = document.getElementById('formality');
        const emoji = document.getElementById('emoji_usage');
        const question = document.getElementById('question_frequency');
        
        if (formality) {
            formality.addEventListener('input', function() {
            document.getElementById('formality-value').textContent = this.value;
        });
        }
        if (emoji) {
            emoji.addEventListener('input', function() {
            document.getElementById('emoji-value').textContent = this.value;
        });
        }
        if (question) {
            question.addEventListener('input', function() {
            document.getElementById('question-value').textContent = this.value;
        });
        }
    }

    async function loadTwinData() {
        try {
            const response = await fetch(`/api/twin/${twinToken}/edit-data`);
            const data = await response.json();
            
            if (data.success) {
                currentTwinData = data.twin;
                populateForm(data.twin);
            }
        } catch (error) {
            console.error('Error loading twin data:', error);
        }
    }

    function populateForm(twin) {
        const styleVector = twin.styleVector || {};
        const formalityEl = document.getElementById('formality');
        const emojiEl = document.getElementById('emoji_usage');
        const humorEl = document.getElementById('humor_style');
        const questionEl = document.getElementById('question_frequency');
        const responseEl = document.getElementById('response_length_preference');
        const toneEl = document.getElementById('tone');

        if (formalityEl) formalityEl.value = styleVector.formality || styleVector.formality_level || 0.5;
        if (emojiEl) emojiEl.value = styleVector.emoji_usage || 0.3;
        if (humorEl) humorEl.value = styleVector.humor_style || 'light';
        if (questionEl) questionEl.value = styleVector.question_frequency || 0.4;
        if (responseEl) responseEl.value = styleVector.response_length_preference || 'detailed';
        if (toneEl) toneEl.value = styleVector.tone || 'casual';
                
        updateRangeDisplays();
    }

    function updateRangeDisplays() {
        const formalityEl = document.getElementById('formality');
        const emojiEl = document.getElementById('emoji_usage');
        const questionEl = document.getElementById('question_frequency');
        const formalityValue = document.getElementById('formality-value');
        const emojiValue = document.getElementById('emoji-value');
        const questionValue = document.getElementById('question-value');

        if (formalityEl && formalityValue) {
            formalityValue.textContent = formalityEl.value;
        }
        if (emojiEl && emojiValue) {
            emojiValue.textContent = emojiEl.value;
        }
        if (questionEl && questionValue) {
            questionValue.textContent = questionEl.value;
        }
    }

    async function loadStyleAnchors() {
        await Promise.all([
            loadPhrases(),
            loadInteractions(),
            loadStyleAnchorStats()
        ]);
    }

    async function loadPhrases() {
        try {
            const response = await fetch(`/api/twin/${twinToken}/style-anchors?type=phrase&limit=5`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            const phrasesListEl = document.getElementById('phrasesList');
            if (!phrasesListEl) return;

            if (data.success && data.anchors && data.anchors.length > 0) {
                const phrasesHTML = data.anchors.map(anchor => {
                    const phrase = anchor.phrase || '';
                    const tags = anchor.tags || [];
                    const date = anchor.created_at ? TimeUtils.formatDateOnly(anchor.created_at) : '';                    
                    const tagsDisplay = tags.length > 0 ? tags.map(tag => `<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs rounded">${escapeHtml(tag)}</span>`).join(' ') : '';
                    
                    return `
                        <div class="flex justify-between items-start p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                             data-anchor-id="${anchor.id}">
                            <div class="flex-1">
                                <p class="text-sm text-gray-900 dark:text-white font-medium">${escapeHtml(phrase)}</p>
                                <div class="flex flex-wrap items-center gap-2 mt-1">
                                    ${tagsDisplay}
                                    <span class="text-xs text-gray-500 dark:text-gray-400">${date}</span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-1 ml-3">
                                <button
                                    type="button"
                                    class="edit-phrase-btn px-2 py-1 text-xs rounded bg-white/80 dark:bg-gray-800 text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">
                                    Edit
                                </button>
                                <button
                                    type="button"
                                    class="delete-phrase-btn px-2 py-1 text-xs rounded bg-red-50 dark:bg-red-900/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-700 hover:bg-red-100 dark:hover:bg-red-900/60">
                                    Delete
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
                phrasesListEl.innerHTML = phrasesHTML;
            } else {
                phrasesListEl.innerHTML = `<p class="text-gray-500 dark:text-gray-400 text-center py-4">No phrases yet. <a href="/memory-management" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">Add your first one here</a>!</p>`;
            }
        } catch (error) {
            console.error('Error loading phrases:', error);
            const phrasesListEl = document.getElementById('phrasesList');
            if (phrasesListEl) {
                phrasesListEl.innerHTML = '<p class="text-red-500 text-center py-4">Error loading phrases</p>';
            }
        }
    }

    async function loadInteractions() {
        try {
            const response = await fetch(`/api/twin/${twinToken}/style-anchors?type=interaction&limit=5`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            const interactionsListEl = document.getElementById('interactionsList');
            if (!interactionsListEl) return;

            if (data.success && data.anchors && data.anchors.length > 0) {
                const interactionsHTML = data.anchors.map(anchor => {
                    const userUtterance = anchor.user_utterance || '';
                    const idealReply = anchor.ideal_reply || '';
                    const tags = anchor.tags || [];
                    const date = anchor.created_at ? TimeUtils.formatDateOnly(anchor.created_at) : '';                  
                    const tagsDisplay = tags.length > 0 ? tags.map(tag => `<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs rounded">${escapeHtml(tag)}</span>`).join(' ') : '';
                    
                    return `
                        <div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                             data-anchor-id="${anchor.id}">
                            <div class="mb-2">
                                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">User:</p>
                                <p class="text-sm text-gray-700 dark:text-gray-300">${escapeHtml(userUtterance)}</p>
                            </div>
                            <div class="mb-2">
                                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Ideal Reply:</p>
                                <p class="text-sm text-gray-900 dark:text-white font-medium">${escapeHtml(idealReply)}</p>
                            </div>
                            <div class="flex items-center justify-between mt-1">
                                <div class="flex flex-wrap gap-2">
                                ${tagsDisplay}
                                <span class="text-xs text-gray-500 dark:text-gray-400">${date}</span>
                                </div>
                                <button
                                    type="button"
                                    class="delete-interaction-btn px-2 py-1 text-xs rounded bg-red-50 dark:bg-red-900/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-700 hover:bg-red-100 dark:hover:bg-red-900/60">
                                    Delete
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
                interactionsListEl.innerHTML = interactionsHTML;
            } else {
                interactionsListEl.innerHTML = `<p class="text-gray-500 dark:text-gray-400 text-center py-4">No interactions yet. <a href="/memory-management" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">Add your first one here</a>!</p>`;
            }
        } catch (error) {
            console.error('Error loading interactions:', error);
            const interactionsListEl = document.getElementById('interactionsList');
            if (interactionsListEl) {
                interactionsListEl.innerHTML = '<p class="text-red-500 text-center py-4">Error loading interactions</p>';
            }
        }
    }

    async function loadStyleAnchorStats() {
        try {
            const response = await fetch(`/api/twin/${twinToken}/style-anchors?limit=1000`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            if (data.success && data.anchors) {
                const phrases = data.anchors.filter(a => a.type === 'phrase' || a.phrase);
                const interactions = data.anchors.filter(a => a.type === 'interaction' || (a.user_utterance && a.ideal_reply));
                
                const totalPhrasesEl = document.getElementById('totalPhrases');
                const totalInteractionsEl = document.getElementById('totalInteractions');
                
                if (totalPhrasesEl) totalPhrasesEl.textContent = phrases.length;
                if (totalInteractionsEl) totalInteractionsEl.textContent = interactions.length;
            }
        } catch (error) {
            console.error('Error loading style anchor stats:', error);
        }
    }


    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function previewChanges() {
        if (!currentTwinData) {
            showNotification('Please wait for data to load first', 'info');
            return;
        }

        // Build styleChanges object from current sliders/selects
        const styleChanges = getStyleChanges();

        try {
            const response = await fetch(`/api/twin/${twinToken}/style-preview`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.csrfToken,
                },
                credentials: 'include',
                body: JSON.stringify({
                    styleChanges,
                    testMessage: 'Friend says: "Bro are we still meeting tomorrow?"',
                }),
            });

            const data = await response.json();
            if (!data.success) {
                showNotification(data.error || 'Could not generate preview, please try again.', 'error');
                return;
            }

            const original = data.originalResponse || '';
            const updated = data.newResponse || '';

            const previewSection = document.getElementById('preview-section');
            const originalEl = document.getElementById('original-text');
            const newEl = document.getElementById('new-text');

            if (previewSection) previewSection.style.display = 'block';
            if (originalEl) originalEl.textContent = original;
            if (newEl) newEl.textContent = updated;

            if (!original && !updated) {
                showNotification('Preview came back empty, please try again later.', 'info');
            }
        } catch (error) {
            console.error('Style preview error:', error);
            showNotification('Preview could not be loaded.', 'error');
        }
    }

    async function saveChanges() {
        const styleUpdates = getStyleChanges();
        
        try {
            if (Object.keys(styleUpdates).length > 0) {
                const response = await fetch(`/api/twin/${twinToken}/update-style`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': window.csrfToken
                    },
                    credentials: 'include',
                    body: JSON.stringify(styleUpdates)
                });
                
                const data = await response.json();
                if (data.success) {
                    showNotification('Changes saved successfully!', 'success');
                    // ✅ Reset dirty form tracking after successful save
                    if (dirtyFormTracker) dirtyFormTracker.reset();
                    if (dirtyFormTrackerMobile) dirtyFormTrackerMobile.reset();
                    loadTwinData();
                } else {
                    showNotification('Error: ' + (data.error || 'Failed to save changes'), 'error');
                }
            } else {
                showNotification('No changes to save', 'info');
            }
        } catch (error) {
            console.error('Error saving changes:', error);
            showNotification('Error saving changes', 'error');
        }
    }

    function getStyleChanges() {
        return {
            formality_level: parseFloat(document.getElementById('formality')?.value || 0.5),
            emoji_usage: parseFloat(document.getElementById('emoji_usage')?.value || 0.3),
            humor_style: document.getElementById('humor_style')?.value || 'light',
            question_frequency: parseFloat(document.getElementById('question_frequency')?.value || 0.4),
            response_length_preference: document.getElementById('response_length_preference')?.value || 'detailed',
            tone: document.getElementById('tone')?.value || 'casual'
        };
    }

    function resetChanges() {
        if (currentTwinData) {
            populateForm(currentTwinData);
            showNotification('Form reset to original values', 'success');
        } else {
            showNotification('No data loaded. Please refresh the page.', 'error');
        }
    }

    async function addNewPhrase() {
        const input = document.getElementById('newPhraseInput');
        if (!input) return;
        const phrase = (input.value || '').trim();
        if (!phrase) {
            showNotification('Please type a style line first.', 'info');
            return;
        }

        try {
            const res = await fetch(`/api/twin/${twinToken}/style-anchors`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.csrfToken,
                },
                credentials: 'include',
                body: JSON.stringify({
                    type: 'phrase',
                    phrase,
                    tags: ['manual'],
                }),
            });
            const data = await res.json();
            if (!data.success) {
                showNotification(data.error || 'Could not add style line.', 'error');
                return;
            }
            input.value = '';
            showNotification('Style line added.', 'success');
            await Promise.all([loadPhrases(), loadStyleAnchorStats()]);
        } catch (err) {
            console.error('addNewPhrase error:', err);
            showNotification('Server error while adding style line.', 'error');
        }
    }

    async function deleteAnchor(anchorId) {
        try {
            const res = await fetch(`/api/twin/${twinToken}/style-anchors/${anchorId}`, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': window.csrfToken },
                credentials: 'include',
            });
            const data = await res.json();
            if (!data.success) {
                showNotification(data.error || 'Delete failed.', 'error');
            } else {
                showNotification('Anchor deleted.', 'success');
            }
        } catch (err) {
            console.error('deleteAnchor error:', err);
            showNotification('Server error while deleting anchor.', 'error');
        }
    }

    async function updatePhrase(anchorId, phrase) {
        try {
            const res = await fetch(`/api/twin/${twinToken}/style-anchors/${anchorId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.csrfToken,
                },
                credentials: 'include',
                body: JSON.stringify({
                    type: 'phrase',
                    phrase,
                }),
            });
            const data = await res.json();
            if (!data.success) {
                showNotification(data.error || 'Update failed.', 'error');
            } else {
                showNotification('Style line updated.', 'success');
            }
        } catch (err) {
            console.error('updatePhrase error:', err);
            showNotification('Server error while updating anchor.', 'error');
        }
    }

    // Make functions globally accessible
    window.previewChanges = previewChanges;
    window.resetChanges = resetChanges;
    window.saveChanges = saveChanges;
    </script>
    
<!--Footer-->
<%- include('footer/footer-conditional-private') %>
<%- include('partials/modal-helpers') %>
<!-- ✅ Global Toast / Notification System (for standalone page) -->
<script>
    (function () {
        window.UI = window.UI || {};
        if (window.UI.showToast) return; // don't override if layout already defined

        window.UI.showToast = function (message, type = 'success', opts = {}) {
            const duration = typeof opts.duration === 'number' ? opts.duration : 3000;
            const existing = document.getElementById('global-toast');
            if (existing && existing.parentNode) existing.parentNode.removeChild(existing);

            const el = document.createElement('div');
            el.id = 'global-toast';
            el.className =
                'fixed top-4 right-4 z-50 max-w-sm w-[90vw] sm:w-auto px-4 py-3 sm:px-6 sm:py-4 ' +
                'rounded-xl shadow-2xl transition-all duration-300 transform opacity-0 translate-y-2';

            let bgClasses, icon;
            if (type === 'success') {
                bgClasses = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
                icon = '✅';
            } else if (type === 'error') {
                bgClasses = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
                icon = '❌';
            } else {
                bgClasses = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
                icon = 'ℹ️';
            }

            el.className += ' ' + bgClasses;
            el.innerHTML = `
                <div class="flex items-center gap-3">
                    <span class="text-xl">${icon}</span>
                    <div class="flex flex-col text-left">
                        <span class="font-semibold">${message}</span>
                    </div>
                </div>
            `;

            document.body.appendChild(el);

            requestAnimationFrame(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
            });

            setTimeout(() => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(-8px)';
                setTimeout(() => {
                    if (el.parentNode) el.parentNode.removeChild(el);
                }, 300);
            }, duration);
        };
    })();
</script>

<script>
    // ✅ Unified notification wrapper for style-customize
    function showNotification(message, type = 'success') {
        if (window.UI && typeof window.UI.showToast === 'function') {
            window.UI.showToast(message, type);
        }
    }
</script>
</body>
</html>