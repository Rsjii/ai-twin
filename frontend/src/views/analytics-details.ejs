<%
// Get server-side values BEFORE template string to avoid EJS parsing issues
const analyticsTypeValue = typeof type !== 'undefined' ? type : '';
const analyticsPageValue = typeof pagination !== 'undefined' && pagination.page ? pagination.page : 1;
const analyticsDataLength = typeof data !== 'undefined' && Array.isArray(data) ? data.length : 0;
const analyticsTotal = typeof pagination !== 'undefined' && pagination.total ? pagination.total : 0;
const analyticsLimit = typeof pagination !== 'undefined' && pagination.limit ? pagination.limit : 50;
%>

<%- include('layout', { 
    title: title, 
    user: user, 
    csrfToken: csrfToken, 
    body: include('partials/analytics-details-body', {
        analyticsTypeValue: analyticsTypeValue,
        analyticsPageValue: analyticsPageValue,
        analyticsDataLength: analyticsDataLength,
        analyticsTotal: analyticsTotal,
        analyticsLimit: analyticsLimit,
        data: data,
        pagination: pagination,
        type: analyticsTypeValue
    })    
}) %>

<!-- Hidden element to store server-side data (OUTSIDE template string) -->
<div id="analytics-data" data-type="<%= analyticsTypeValue %>" data-page="<%= analyticsPageValue %>" style="display: none;"></div>


<script>
    // Get data from hidden element
    const analyticsDataEl = document.getElementById('analytics-data');
    const analyticsTypeValue = analyticsDataEl ? analyticsDataEl.getAttribute('data-type') : '';
    const analyticsPageValue = analyticsDataEl ? parseInt(analyticsDataEl.getAttribute('data-page')) || 1 : 1;
    
    const urlParams = new URLSearchParams(window.location.search);
    const type = urlParams.get('type') || analyticsTypeValue;
    let currentPage = analyticsPageValue;
    let currentSearch = urlParams.get('search') || '';
    let currentLimit = parseInt('<%= analyticsLimit %>') || parseInt(urlParams.get('limit')) || 50;    

    function formatTime(date) {
        if (!date) return 'N/A';
        if (window.TimeUtils) {
            return window.TimeUtils.formatTimeWithContext(date);
        }
        const d = new Date(date);
        const diff = Date.now() - d.getTime();
        if (diff < 60000) return 'Just now';
        if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
        if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
        if (diff < 604800000) return Math.floor(diff / 86400000) + 'd ago';
        return window.TimeUtils ? window.TimeUtils.formatDateOnly(date) : d.toLocaleDateString();
    }
// Change page
function changePage(page) {
    if (page < 1) {
        return;
    }
    currentPage = page;
    loadData();
}    

    // Perform search
    function performSearch() {
        const searchInput = document.getElementById('searchInput');
        currentSearch = searchInput.value.trim();
        currentPage = 1;
        loadData();
    }

    // Clear search
    function clearSearch() {
        document.getElementById('searchInput').value = '';
        currentSearch = '';
        currentPage = 1;
        loadData();
    }

// Load data (AJAX - no page reload)
async function loadData() {
    try {
        // ✅ FIX: Always read limit from current URL to preserve it
        const currentUrlParams = new URLSearchParams(window.location.search);
        const requestLimit = parseInt(currentUrlParams.get('limit')) || currentLimit || 50;
        
        // ✅ Update currentLimit to keep it in sync
        currentLimit = requestLimit;
        
        const params = new URLSearchParams({
            type: type,
            page: currentPage,
            limit: requestLimit,  // ✅ Use fresh limit
            search: currentSearch
        });
        
        // Show loading state
        const dataList = document.getElementById('dataList');
        const paginationContainer = document.getElementById('analyticsPagination');
        const resultsCount = document.getElementById('resultsCount');
        const totalCount = document.getElementById('totalCount');
        
        if (dataList) {
            dataList.innerHTML = '<div class="p-8 text-center"><div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div><p class="mt-2 text-gray-500">Loading...</p></div>';
        }
        if (paginationContainer) {
            paginationContainer.style.opacity = '0.5';
        }

        // Update URL without reload (preserves limit parameter)
        window.history.pushState({}, '', '/analytics/details?' + params.toString());

            const response = await fetch('/analytics/details?' + params.toString(), {
                credentials: 'include',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (response.ok) {
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                
                // Extract the data list from the response
                const newDataList = doc.getElementById('dataList');
                const newPaginationContainer = doc.getElementById('analyticsPagination');
                const newPaginationData = doc.getElementById('analyticsPaginationData');
                const newResultsCount = doc.querySelector('#resultsCount');
                const newTotalCount = doc.querySelector('#totalCount');
                
                if (newDataList && dataList) {
                    dataList.innerHTML = newDataList.innerHTML;
                }
                
                // ✅ FIX: Update pagination data element and re-initialize pagination widget
                if (newPaginationData) {
                    const currentPaginationData = document.getElementById('analyticsPaginationData');
                    if (currentPaginationData) {
                        currentPaginationData.dataset.currentPage = newPaginationData.dataset.currentPage || '1';
                        currentPaginationData.dataset.totalItems = newPaginationData.dataset.totalItems || '0';
                        currentPaginationData.dataset.itemsPerPage = newPaginationData.dataset.itemsPerPage || '50';
                    }
                    // Re-initialize pagination widget with new data
                    initAnalyticsPaginationFromDOM();
                }
                
                if (newResultsCount && resultsCount) {
                    resultsCount.textContent = newResultsCount.textContent;
                }
                
                if (newTotalCount && totalCount) {
                    totalCount.textContent = newTotalCount.textContent;
                }
                
                // Re-run date formatting
                document.querySelectorAll('.analytics-date').forEach(el => {
                    if (el.dataset.timestamp && window.TimeUtils) {
                        el.textContent = TimeUtils.formatDateOnly(el.dataset.timestamp);
                        el.title = TimeUtils.formatFullDateTime(el.dataset.timestamp);
                    }
                });
            } else {
                // Failed to load data
                if (dataList) {
                    dataList.innerHTML = '<div class="p-8 text-center text-red-500">Failed to load data. Please try again.</div>';
                }
            }
        } catch (error) {
            // Error loading data
            const dataList = document.getElementById('dataList');
            if (dataList) {
                dataList.innerHTML = '<div class="p-8 text-center text-red-500">Network error. Please try again.</div>';
            }
        }
    }

    // ✅ View twin profile function
    function viewTwinProfile(userHandle) {
        if (userHandle) {
            window.location.href = `/@${userHandle}`;
        } else {
            if (typeof showNotification === 'function') {
                showNotification('User profile not available', 'error');
            } else {
                // User profile not available
            }
        }
    }

    // ✅ FIX: Initialize pagination from DOM data (like public-chat-history)
    function initAnalyticsPaginationFromDOM() {
        const paginationDataEl = document.getElementById('analyticsPaginationData');
        if (!paginationDataEl || typeof window.initAnalyticsPagination !== 'function') {
            return;
        }

        const currentPage = parseInt(paginationDataEl.dataset.currentPage) || 1;
        const totalItems = parseInt(paginationDataEl.dataset.totalItems) || 0;
        const itemsPerPage = parseInt(paginationDataEl.dataset.itemsPerPage) || 50;
        const totalPages = itemsPerPage > 0 ? Math.ceil(totalItems / itemsPerPage) : 0;

        window.initAnalyticsPagination({
            pagination: {
                currentPage,
                totalPages,
                totalItems,
                itemsPerPage
            }
        });
    }

    // ✅ FIX: Pagination callback - called by pagination.js when user clicks a page
    window.handleAnalyticsPagination = function(page) {
        changePage(page);
    };

    function exportAnalyticsCSV() {
        const params = new URLSearchParams(window.location.search);
        const type = params.get('type') || analyticsTypeValue;
        if (!type) return;

        const exportParams = new URLSearchParams();
        exportParams.set('type', type);
        const search = params.get('search');
        if (search) exportParams.set('search', search);

        window.location.href = '/analytics/details/export?' + exportParams.toString();
    }


// Add event listeners for buttons
document.addEventListener('DOMContentLoaded', function() {
    // ✅ FIX: Initialize pagination widget on page load
    initAnalyticsPaginationFromDOM();
    
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const clearBtn = document.getElementById('clearBtn');
    const exportCSVBtn = document.getElementById('exportCSVBtn');
    
    if (searchInput) {
        searchInput.value = currentSearch;
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
    }
    
    if (searchBtn) {
        searchBtn.addEventListener('click', performSearch);
    }
    
    if (clearBtn) {
        clearBtn.addEventListener('click', clearSearch);
    }
    
    if (exportCSVBtn) {
        exportCSVBtn.addEventListener('click', exportAnalyticsCSV);
    }
    

    // ✅ FIX: Event delegation for twin profile clicks - REMOVED
    // Now only the profile icon (<a href="/@...">) will be clickable
    // No need for div-level click handling
});
</script>