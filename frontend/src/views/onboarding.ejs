<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes"
  />
  <title>Create Your Twin – Onboarding</title>
  <link rel="stylesheet" href="/css/output.css" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
    <script>
    (function () {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        .step-active {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #ffffff;
        }
        .step-completed {
            background: #10b981;
      color: #ffffff;
        }
        .step-pending {
            background: #e5e7eb;
            color: #6b7280;
        }
        .dark .step-pending {
            background: #374151;
            color: #9ca3af;
        }
    .chip {
      border-radius: 9999px;
      padding: 0.5rem 0.9rem;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(255, 255, 255, 0.9);
      color: #1f2933;
      font-size: 0.875rem;
            cursor: pointer;
      transition:
        background 0.15s ease,
        color 0.15s ease,
        border-color 0.15s ease,
        transform 0.1s ease;
    }
    .dark .chip {
      background: #1f2937;
      color: #e5e7eb;
      border-color: #4b5563;
    }
    .chip.selected {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #ffffff;
      border-color: transparent;
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
        }
        .fade-in {
      animation: fadeIn 0.3s ease-out;
        }
        @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
        }
    </style>
  <script>
    window.csrfToken = '<%= csrfToken %>';
  </script>
</head>
<body
  class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter"
>
  <!-- Auth check -->
    <script>
    (function () {
      const isAuthenticated =
        <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <!-- Header -->
    <%- include('header') %>    

  <!-- Top progress bar -->
  <div
    class="sticky top-20 z-40 bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-b border-white/20 dark:border-gray-700"
  >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex items-center justify-center space-x-4">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300"
          >Step <span id="currentStepNumber">1</span> of 5</span
        >
                <div class="w-48 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div
            id="progressBar"
            class="h-full bg-gradient-to-r from-primary to-accent transition-all duration-300"
            style="width: 20%"
          ></div>
                </div>
            </div>
        </div>
    </div>

  <main class="px-3 sm:px-4 py-6 sm:py-8 pt-20 sm:pt-24">
        <div class="max-w-4xl mx-auto">
      <!-- Step indicators -->
            <div class="mb-8">
        <div
          class="flex items-center justify-center space-x-2 md:space-x-4 overflow-x-auto pb-4"
        >
                    <div class="flex items-center space-x-2">
            <div
              id="step1"
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-active"
            >
              1
            </div>
            <span class="hidden md:block text-sm font-medium text-gray-700 dark:text-gray-300"
              >About You</span
            >
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300 dark:bg-gray-600"></div>
                    <div class="flex items-center space-x-2">
            <div
              id="step2"
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending"
            >
              2
            </div>
            <span class="hidden md:block text-sm font-medium text-gray-700 dark:text-gray-300"
              >Chat Style</span
            >
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300 dark:bg-gray-600"></div>
                    <div class="flex items-center space-x-2">
            <div
              id="step3"
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending"
            >
              3
            </div>
            <span class="hidden md:block text-sm font-medium text-gray-700 dark:text-gray-300"
              >Preferences & Tone</span
            >
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300 dark:bg-gray-600"></div>
                    <div class="flex items-center space-x-2">
            <div
              id="step4"
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending"
            >
              4
            </div>
            <span class="hidden md:block text-sm font-medium text-gray-700 dark:text-gray-300"
              >Rules</span
            >
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300 dark:bg-gray-600"></div>
                    <div class="flex items-center space-x-2">
            <div
              id="step5"
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending"
            >
              5
            </div>
            <span class="hidden md:block text-sm font-medium text-gray-700 dark:text-gray-300"
              >Preview</span
            >
                    </div>
                </div>
            </div>

      <!-- Card -->
      <div
        class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8"
      >
                <form id="onboardingForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    
          <!-- STEP 1: About you & usage context -->
                    <div id="step1-content" class="step-content fade-in">
                        <div class="mb-8">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                About you
              </h1>
              <p class="text-gray-600 dark:text-gray-300">
                Tell us about yourself so we can personalize your twin.
              </p>
                        </div>

                        <div class="space-y-6">
              <!-- Name -->
                                <div>
                <label
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
                  for="name"
                >
                  Name / nickname *
                </label>
                <input
                  id="name"
                  type="text"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                  placeholder="What do people call you?"
                  required
                />
                                </div>

              <!-- Twin one-line bio (optional) -->
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="oneLineBio">
                  Twin one-line bio <span class="text-red-500">*</span>
                </label>
                <input
                  id="oneLineBio"
                  type="text"
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                  placeholder="e.g. Replies like me — casual, witty, helpful."
                  maxlength="500"
                />
              </div>

              <!-- Role (Twin role) -->
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Your twin's role *
                </label>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                  <button type="button" class="chip role-chip" data-value="friend">
                    Friend
                  </button>
                  <button type="button" class="chip role-chip" data-value="creator">
                    Creator
                  </button>
                  <button type="button" class="chip role-chip" data-value="support">
                    Customer Support
                  </button>
                  <button type="button" class="chip role-chip" data-value="coach">
                    Coach
                  </button>
                  <button type="button" class="chip role-chip" data-value="other">
                    Other
                  </button>
                </div>
                <input
                  id="roleOther"
                  type="text"
                  class="mt-2 w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 hidden"
                  placeholder="Optional: describe the role"
                />
                            </div>

              <!-- Purpose -->
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  What do you want your twin to help you with? (optional)
                </label>
                <select
                  id="purpose"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                >
                  <option value="">Select (optional)</option>
                  <option value="just_chat">Just chat</option>
                  <option value="practice">Practice conversations</option>
                  <option value="brainstorm">Brainstorm ideas</option>
                  <option value="advice">Get advice</option>
                  <option value="remember">Remember things</option>
                  <option value="other">Other</option>
                </select>
              </div>
                        </div>
                    </div>

          <!-- STEP 2: Real chat style (examples) -->
                    <div id="step2-content" class="step-content hidden">
                        <div class="mb-8">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                Show us your real chat style
              </h1>
              <p class="text-gray-600 dark:text-gray-300">
                Paste real examples of how you actually type. This is the most important part for
                style.
              </p>
                        </div>

            <div class="space-y-6">
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  Example 1 – Close friend (required)
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-3">
                  Paste real messages you've sent to friends, family, or colleagues. This is the most important part for style.
                </p>
                <textarea
                  id="casualSample"
                  rows="4"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                  placeholder="Type how you would really reply..."
                  required
                ></textarea>
              </div>

              <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  Example 2 – More serious (optional but recommended)
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-3">
                  Optional: A more formal message (work email, professional context). This helps the twin learn your formal side.
                </p>
                <textarea
                  id="formalSample"
                  rows="4"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                  placeholder="Type a more formal or work-style message (optional)"
                ></textarea>
                                        </div>
            </div>
                                    </div>

          <!-- STEP 3: Taste & comfort zone -->
          <div id="step3-content" class="step-content hidden">
            <div class="mb-8">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                What you like & how you communicate
              </h1>
              <p class="text-gray-600 dark:text-gray-300">
                This helps your twin know which topics and tone feel natural versus uncomfortable.
              </p>
                                    </div>

            <div class="space-y-6">
              <!-- Likes -->
              <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  Topics you like (choose a few)
                </h3>
                <div class="flex flex-wrap gap-2" id="likesChips">
                  <button type="button" class="chip like-chip" data-value="startups">
                    Startups / business
                  </button>
                  <button type="button" class="chip like-chip" data-value="tech">
                    Tech / coding
                  </button>
                  <button type="button" class="chip like-chip" data-value="money">
                    Money / investing
                  </button>
                  <button type="button" class="chip like-chip" data-value="fitness">
                    Fitness / health
                  </button>
                  <button type="button" class="chip like-chip" data-value="games_anime">
                    Games / anime
                  </button>
                  <button type="button" class="chip like-chip" data-value="movies_series">
                    Movies / series
                  </button>
                  <button type="button" class="chip like-chip" data-value="music">
                    Music
                  </button>
                  <button type="button" class="chip like-chip" data-value="memes">
                    Memes & jokes
                  </button>
                  <button type="button" class="chip like-chip" data-value="relationships">
                    Relationships / feelings
                  </button>
                  <button type="button" class="chip like-chip" data-value="random_chat">
                    Random small talk
                  </button>
                                        </div>
                <input
                  id="likeCustom"
                  type="text"
                  class="mt-3 w-full px-4 py-2.5 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-sm text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                  placeholder="Other topic you like (press Enter to add)"
                />
                <div id="likesCustomList" class="mt-2 flex flex-wrap gap-2"></div>
                                    </div>

              <!-- Avoids -->
              <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  Topics to avoid or keep very light
                </h3>
                <div class="flex flex-wrap gap-2" id="avoidChips">
                  <button type="button" class="chip avoid-chip" data-value="politics">
                    Politics
                  </button>
                  <button type="button" class="chip avoid-chip" data-value="religion">
                    Religion
                  </button>
                  <button type="button" class="chip avoid-chip" data-value="family_drama">
                    Family drama
                  </button>
                  <button type="button" class="chip avoid-chip" data-value="dark_jokes">
                    Dark jokes
                  </button>
                  <button type="button" class="chip avoid-chip" data-value="office_gossip">
                    Office gossip
                  </button>
                  <button type="button" class="chip avoid-chip" data-value="deep_mental_health">
                    Very personal mental health
                  </button>
                                </div>
                <input
                  id="avoidCustom"
                  type="text"
                  class="mt-3 w-full px-4 py-2.5 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-sm text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                  placeholder="Other topic to avoid (press Enter to add)"
                />
                <div id="avoidsCustomList" class="mt-2 flex flex-wrap gap-2"></div>
                            </div>

              <!-- Tone & Language Style -->
              <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Tone & language style *
                </label>
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
                  How do you usually communicate? This affects humor and swearing in your twin's responses.
                </p>
                <div class="flex flex-wrap gap-2">
                  <button type="button" class="chip tone-style-chip" data-tone-style="polite">
                    Polite & respectful
                  </button>
                  <button type="button" class="chip tone-style-chip" data-tone-style="normal">
                    Normal & friendly
                  </button>
                  <button type="button" class="chip tone-style-chip" data-tone-style="casual">
                    Casual & relaxed
                  </button>
                </div>
              </div>

              <!-- Emojis -->
              <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Emojis *
                </label>
                <div class="flex flex-wrap gap-2">
                  <button type="button" class="chip emoji-chip" data-emoji="low">
                    Very few emojis
                  </button>
                  <button type="button" class="chip emoji-chip" data-emoji="medium">
                    Sometimes
                  </button>
                  <button type="button" class="chip emoji-chip" data-emoji="high">
                    Quite a lot
                  </button>
                </div>
              </div>
                        </div>
                    </div>

          <!-- STEP 4: Rules & control -->
          <div id="step4-content" class="step-content hidden">
                        <div class="mb-8">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                Rules and default behaviour
              </h1>
              <p class="text-gray-600 dark:text-gray-300">
                Set clear boundaries and how your twin should usually respond.
              </p>
                        </div>

            <div class="space-y-6">
              <div class="grid md:grid-cols-2 gap-6">
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                    Always do (1–3 short lines)
                  </h3>
                  <textarea
                    id="alwaysRules"
                    rows="4"
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                    placeholder="Example: Always stay calm and respectful.&#10;Example: Explain things in simple language."
                  ></textarea>
                                </div>
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                    Never do (1–3 short lines)
                  </h3>
                  <textarea
                    id="neverRules"
                    rows="4"
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary focus:border-transparent"
                    placeholder="Example: Do not insult or attack people.&#10;Example: Do not overshare my personal life."
                  ></textarea>
                </div>
                            </div>

              <!-- Default behaviour chips -->
              <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6 space-y-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Default reply size
                  </label>
                  <div class="flex flex-wrap gap-2">
                    <button type="button" class="chip reply-size-chip" data-reply-size="short">
                      Short & to the point
                    </button>
                    <button type="button" class="chip reply-size-chip" data-reply-size="normal">
                      Normal
                    </button>
                    <button type="button" class="chip reply-size-chip" data-reply-size="detailed">
                      A bit more detailed
                    </button>
                        </div>
                    </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Engagement style *
                  </label>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
                    How should your twin engage with you? This controls whether your twin asks questions to keep conversations going.
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <button type="button" class="chip engagement-style-chip" data-engagement-style="ask_questions">
                      Ask questions to keep conversation going
                    </button>
                    <button type="button" class="chip engagement-style-chip" data-engagement-style="natural">
                      Respond naturally without forcing questions
                    </button>
                    <button type="button" class="chip engagement-style-chip" data-engagement-style="mix">
                      Mix of both
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 5: Preview -->
                    <div id="step5-content" class="step-content hidden">
                        <div class="mb-8">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">
                Your twin summary
              </h1>
              <p class="text-gray-600 dark:text-gray-300">
                Check that this matches how you want your twin to sound. You can always change
                settings later.
              </p>
                        </div>

                        <div class="space-y-6">
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  Overview
                </h3>
                <div id="previewBasic" class="text-sm text-gray-800 dark:text-gray-200 space-y-1">
                  <!-- Filled by JS -->
                </div>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  Topics & tone
                </h3>
                <div
                  id="previewPreferences"
                  class="text-sm text-gray-800 dark:text-gray-200 space-y-1"
                >
                  <!-- Filled by JS -->
                </div>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  Rules
                </h3>
                <div id="previewRules" class="text-sm text-gray-800 dark:text-gray-200 space-y-1">
                  <!-- Filled by JS -->
                </div>
                            </div>

                            <div class="bg-gradient-to-r from-primary to-accent rounded-xl p-4 sm:p-6 text-white">
                <h3 class="text-lg font-semibold mb-3">Ready to create your twin?</h3>
                <p class="mb-3 text-sm sm:text-base">
                  Your twin will use this information and your real examples to write replies that
                  feel like you. You can always edit style, topics and rules later.
                </p>
                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                  <button
                    type="button"
                    id="editBackBtn"
                    class="px-4 sm:px-6 py-2.5 bg-white/15 text-white rounded-lg hover:bg-white/25 transition-colors font-semibold text-sm sm:text-base text-center"
                  >
                    Go back and edit
                                    </button>
                  <button
                    type="submit"
                    id="createTwinBtn"
                    class="px-4 sm:px-6 py-2.5 bg-white text-primary rounded-lg hover:bg-gray-100 transition-colors font-semibold text-sm sm:text-base text-center"
                  >
                    Create my twin
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

          <!-- Navigation -->
          <div
            class="flex justify-between items-center mt-8 pt-6 border-top border-gray-200 dark:border-gray-700"
          >
            <button
              type="button"
              id="prevBtn"
              class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors font-semibold hidden"
            >
                            ← Previous
                        </button>
                        <div class="flex-1"></div>
            <button
              type="button"
              id="nextBtn"
              class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-secondary transition-colors font-semibold"
            >
                            Next →
                        </button>
                    </div>
                </form>
            </div>
        </div>
  </main>

  <!-- Scripts -->
    <script>
        const ONBOARDING_STORAGE_KEY = 'enhancedOnboarding_v1';
        const ONBOARDING_USER_ID = <%- JSON.stringify(user?.id || null) %>; // ✅ ADD (prevents cross-user restore)

        let currentStep = 1;
        const totalSteps = 5;

    const onboardingData = {
      basicInfo: {},
      styleSamples: {},
      preferences: {},
      rules: {},
    };

    // ✅ ADD: helpers to validate restore
    function isNonEmptyString(v) {
      return typeof v === 'string' && v.trim().length > 0;
    }

    function isStep1Complete(d) {
      const b = d?.basicInfo || {};
      return isNonEmptyString(b.name) && isNonEmptyString(b.role);
    }

    function isStep2Complete(d) {
      const s = d?.styleSamples || {};
      return isNonEmptyString(s.casualSample) && s.casualSample.trim().length >= 20;
    }

    function isStep3Complete(d) {
      const p = d?.preferences || {};
      const toneOk = ['polite', 'normal', 'casual'].includes(p.toneStyle);
      const emojiOk = ['low', 'medium', 'high'].includes(p.emojiPref);
      return Array.isArray(p.likes) && p.likes.length > 0 && toneOk && emojiOk;
    }

    function isStep4Complete(d) {
      const r = d?.rules || {};
      const replyOk = ['short', 'normal', 'detailed'].includes(r.replySize);
      const engageOk = ['ask_questions', 'natural', 'mix'].includes(r.engagementStyle);
      return replyOk && engageOk;
    }

    function clampStep(step, data) {
      let s = typeof step === 'number' ? step : 1;
      s = Math.min(Math.max(s, 1), totalSteps);

      if (s >= 2 && !isStep1Complete(data)) s = 1;
      if (s >= 3 && !isStep2Complete(data)) s = 2;
      if (s >= 4 && !isStep3Complete(data)) s = 3;
      if (s >= 5 && !isStep4Complete(data)) s = 4;

      return s;
    }

    // ✅ NEW: Browser history management for back button support
    function pushStepToHistory(step) {
      const url = new URL(window.location.href);
      url.searchParams.set('step', String(step));
      history.pushState({ step }, '', url.toString());
    }

    function getStepFromUrl() {
      const stepFromUrl = Number(new URL(window.location.href).searchParams.get('step') || '1');
      return clampStep(stepFromUrl, onboardingData);
    }

    window.addEventListener('popstate', (e) => {
      const stepFromState = e.state?.step;
      const stepFromUrl = Number(new URL(window.location.href).searchParams.get('step') || '1');
      const target = clampStep(Number(stepFromState || stepFromUrl || 1), onboardingData);
      currentStep = target;
      updateStepUI();
    });

    document.addEventListener('DOMContentLoaded', () => {
      setupChips();
      
      // ✅ REMOVED: localStorage wipe on page load (was causing state loss on refresh)
      // Onboarding state should persist across refreshes until twin is successfully created
      // Only clear localStorage after successful twin creation or explicit abandonment
      
      loadOnboardingFromStorage();
      
      // ✅ NEW: Restore step from URL on page load
      const stepFromUrl = getStepFromUrl();
      if (stepFromUrl !== currentStep) {
        currentStep = stepFromUrl;
      }
      
      setupNavigation();
      updateStepUI();
      
      // ✅ NEW: Push initial step to history
      pushStepToHistory(currentStep);

 // Save latest answers before reload / close
 window.addEventListener('beforeunload', () => {
      try {
        saveCurrentStep();
        persistOnboardingState();
      } catch (e) {
        // Silently handle state persistence errors
      }
    });
  });    

    function setupChips() {
      // single-select groups
      const singleGroups = [
        '.role-chip',
        '.tone-style-chip',
        '.emoji-chip',
        '.reply-size-chip',
        '.engagement-style-chip',
      ];

      singleGroups.forEach((selector) => {
        document.querySelectorAll(selector).forEach((chip) => {
          chip.addEventListener('click', () => {
            document.querySelectorAll(selector).forEach((c) => c.classList.remove('selected'));
            chip.classList.add('selected');

            // special: role "other" toggles text input
            if (selector === '.role-chip') {
              const roleOther = document.getElementById('roleOther');
              if (!roleOther) return;
              if (chip.getAttribute('data-value') === 'other') {
                roleOther.classList.remove('hidden');
    } else {
                roleOther.classList.add('hidden');
                roleOther.value = '';
              }
            }
          });
        });
      });

      // ✅ NEW: Max 3 likes + 3 avoids enforced
      const MAX_LIKES = 3;
      const MAX_AVOIDS = 3;

      function countSelected(selector) {
        return document.querySelectorAll(`${selector}.selected`).length;
      }

      function countCustom(containerSel, type) {
        return document.querySelectorAll(`${containerSel} [data-type="${type}"]`).length;
      }

      function canAddLike() {
        return (countSelected('.like-chip') + countCustom('#likesCustomList', 'like-custom')) < MAX_LIKES;
      }

      function canAddAvoid() {
        return (countSelected('.avoid-chip') + countCustom('#avoidsCustomList', 'avoid-custom')) < MAX_AVOIDS;
      }

      // multi-select groups (capped at 3)
      ['.like-chip', '.avoid-chip'].forEach((selector) => {
        document.querySelectorAll(selector).forEach((chip) => {
          chip.addEventListener('click', () => {
            const isSelected = chip.classList.contains('selected');
            if (isSelected) {
              chip.classList.remove('selected');
              return;
            }

            // Check if we can add more
            if (selector === '.like-chip' && !canAddLike()) {
              showMessage('Maximum 3 likes allowed', 'error');
              return;
            }
            if (selector === '.avoid-chip' && !canAddAvoid()) {
              showMessage('Maximum 3 avoids allowed', 'error');
              return;
            }

            chip.classList.add('selected');
          });
        });
      });

      // custom like / avoid inputs (capped at 3)
      const likeCustom = document.getElementById('likeCustom');
      const likesCustomList = document.getElementById('likesCustomList');
      if (likeCustom && likesCustomList) {
        likeCustom.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            const value = likeCustom.value.trim();
            if (!value) return;
            if (!canAddLike()) {
              showMessage('Maximum 3 likes allowed', 'error');
              return;
            }
            addCustomChip(likesCustomList, value, 'like-custom');
            likeCustom.value = '';
          }
        });
      }

      const avoidCustom = document.getElementById('avoidCustom');
      const avoidsCustomList = document.getElementById('avoidsCustomList');
      if (avoidCustom && avoidsCustomList) {
        avoidCustom.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            const value = avoidCustom.value.trim();
            if (!value) return;
            if (!canAddAvoid()) {
              showMessage('Maximum 3 avoids allowed', 'error');
              return;
            }
            addCustomChip(avoidsCustomList, value, 'avoid-custom');
            avoidCustom.value = '';
          }
        });
      }
    }

    function addCustomChip(container, text, type) {
      const span = document.createElement('span');
      span.className =
        'inline-flex items-center gap-1 px-3 py-1 rounded-full bg-gray-200 dark:bg-gray-700 text-xs text-gray-800 dark:text-gray-100';
      span.setAttribute('data-value', text);
      span.setAttribute('data-type', type);
      span.innerHTML = `
        <span>${escapeHtml(text)}</span>
        <button type="button" class="text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-white">&times;</button>
      `;
      const btn = span.querySelector('button');
      btn.addEventListener('click', () => span.remove());
      container.appendChild(span);
    }

function persistOnboardingState() {
    try {
      const payload = {
        userId: ONBOARDING_USER_ID,   // ✅ ADD
        savedAt: Date.now(),          // ✅ ADD
        currentStep,
        onboardingData,
      };
      localStorage.setItem(ONBOARDING_STORAGE_KEY, JSON.stringify(payload));
    } catch (e) {
      // Silently handle state persistence errors
    }
  }

  function loadOnboardingFromStorage() {
    try {
      const raw = localStorage.getItem(ONBOARDING_STORAGE_KEY);
      if (!raw) return;

      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return;

      // ✅ NEW: If different user (or legacy without userId), wipe
      if (ONBOARDING_USER_ID && parsed.userId && parsed.userId !== ONBOARDING_USER_ID) {
        localStorage.removeItem(ONBOARDING_STORAGE_KEY);
        return;
      }
      if (ONBOARDING_USER_ID && !parsed.userId) {
        localStorage.removeItem(ONBOARDING_STORAGE_KEY);
        return;
      }

      const incoming = parsed.onboardingData;
      if (!incoming || typeof incoming !== 'object') {
        localStorage.removeItem(ONBOARDING_STORAGE_KEY);
        return;
      }

      Object.assign(onboardingData, incoming);

      currentStep = clampStep(parsed.currentStep, onboardingData);

      hydrateFromOnboardingData();

      // ✅ NEW: If restored on step 5, regenerate preview so it’s not empty
      if (currentStep === 5) generatePreview();
    } catch (e) {
      try { localStorage.removeItem(ONBOARDING_STORAGE_KEY); } catch {}
    }
  }

  function hydrateFromOnboardingData() {
    restoreStep1();
    restoreStep2();
    restoreStep3();
    restoreStep4();
  }

  function restoreStep1() {
    const b = onboardingData.basicInfo || {};

    const nameInput = document.getElementById('name');
    const oneLineBio = document.getElementById('oneLineBio');
    const roleOther = document.getElementById('roleOther');
    const purposeSelect = document.getElementById('purpose');
    
    if (nameInput) nameInput.value = b.name || '';
    if (oneLineBio) oneLineBio.value = b.oneLineBio || '';
    if (purposeSelect) purposeSelect.value = b.purpose || '';

    // role chips
    document.querySelectorAll('.role-chip').forEach((chip) => {
      const val = chip.getAttribute('data-value');
      const isSelected = val === b.role;
      chip.classList.toggle('selected', isSelected);
    });

    if (roleOther) {
      if (b.role === 'other') {
        roleOther.classList.remove('hidden');
        roleOther.value = b.roleOther || '';
      } else {
        roleOther.classList.add('hidden');
        roleOther.value = '';
      }
    }
  }

  function restoreStep2() {
    const s = onboardingData.styleSamples || {};
    const casual = document.getElementById('casualSample');
    const formal = document.getElementById('formalSample');
    if (casual) casual.value = s.casualSample || '';
    if (formal) formal.value = s.formalSample || '';
  }

  function restoreStep3() {
    const p = onboardingData.preferences || {};
    const likes = Array.isArray(p.likes) ? [...p.likes] : [];
    const avoids = Array.isArray(p.avoids) ? [...p.avoids] : [];

    // explicit like chips
    document.querySelectorAll('.like-chip').forEach((chip) => {
      const val = chip.getAttribute('data-value');
      const idx = likes.indexOf(val);
      const selected = idx !== -1;
      chip.classList.toggle('selected', selected);
      if (selected) likes.splice(idx, 1);
    });
    // remaining likes → custom chips
    const likesCustomList = document.getElementById('likesCustomList');
    if (likesCustomList) {
      likes.forEach((text) => addCustomChip(likesCustomList, text, 'like-custom'));
    }

    // explicit avoid chips
    document.querySelectorAll('.avoid-chip').forEach((chip) => {
      const val = chip.getAttribute('data-value');
      const idx = avoids.indexOf(val);
      const selected = idx !== -1;
      chip.classList.toggle('selected', selected);
      if (selected) avoids.splice(idx, 1);
    });
    // remaining avoids → custom chips
    const avoidsCustomList = document.getElementById('avoidsCustomList');
    if (avoidsCustomList) {
      avoids.forEach((text) => addCustomChip(avoidsCustomList, text, 'avoid-custom'));
    }

    // tone style / emoji chips
    const toneStyle = p.toneStyle;
    document.querySelectorAll('.tone-style-chip').forEach((chip) => {
      chip.classList.toggle(
        'selected',
        chip.getAttribute('data-tone-style') === toneStyle
      );
    });

    const emoji = p.emojiPref;
    document.querySelectorAll('.emoji-chip').forEach((chip) => {
      chip.classList.toggle(
        'selected',
        chip.getAttribute('data-emoji') === emoji
      );
    });
  }

  function restoreStep4() {
    const r = onboardingData.rules || {};

    const alwaysArea = document.getElementById('alwaysRules');
    const neverArea = document.getElementById('neverRules');

    if (alwaysArea && Array.isArray(r.always)) {
      alwaysArea.value = r.always.join('\n');
    }
    if (neverArea && Array.isArray(r.never)) {
      neverArea.value = r.never.join('\n');
    }

    document.querySelectorAll('.reply-size-chip').forEach((chip) => {
      chip.classList.toggle(
        'selected',
        chip.getAttribute('data-reply-size') === r.replySize
      );
    });

    document.querySelectorAll('.engagement-style-chip').forEach((chip) => {
      chip.classList.toggle(
        'selected',
        chip.getAttribute('data-engagement-style') === r.engagementStyle
      );
    });

  }

    function setupNavigation() {
      const nextBtn = document.getElementById('nextBtn');
      const prevBtn = document.getElementById('prevBtn');
      const editBackBtn = document.getElementById('editBackBtn');
      const form = document.getElementById('onboardingForm');

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (!validateCurrentStep()) return;
          saveCurrentStep();
          if (currentStep < totalSteps) {
            currentStep += 1;
            if (currentStep === 5) {
              generatePreview();
            }
            pushStepToHistory(currentStep); // ✅ NEW: Update history
            updateStepUI();
          }
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentStep <= 1) return;
          saveCurrentStep();
          currentStep -= 1;
          pushStepToHistory(currentStep); // ✅ NEW: Update history
          updateStepUI();
        });
      }

      if (editBackBtn) {
        editBackBtn.addEventListener('click', () => {
          currentStep = 1;
          pushStepToHistory(currentStep); // ✅ NEW: Update history
          updateStepUI();
        });
      }

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          if (!validateCurrentStep()) return;
          saveCurrentStep();
          submitOnboarding();
        });
      }
    }

    function updateStepUI() {
      // show content
            for (let i = 1; i <= totalSteps; i++) {
        const content = document.getElementById(`step${i}-content`);
        if (!content) continue;
        if (i === currentStep) {
          content.classList.remove('hidden');
          content.classList.add('fade-in');
                } else {
          content.classList.add('hidden');
          content.classList.remove('fade-in');
        }

        const dot = document.getElementById(`step${i}`);
        if (!dot) continue;
        if (i < currentStep) {
          dot.className =
            'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-completed';
        } else if (i === currentStep) {
          dot.className =
            'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-active';
        } else {
          dot.className =
            'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending';
        }
      }

            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

      if (prevBtn) {
        if (currentStep > 1) prevBtn.classList.remove('hidden');
        else prevBtn.classList.add('hidden');
      }

      if (nextBtn) {
        if (currentStep === totalSteps) nextBtn.classList.add('hidden');
        else nextBtn.classList.remove('hidden');
      }

            const progress = (currentStep / totalSteps) * 100;
      const progressBar = document.getElementById('progressBar');
      const currentStepNumber = document.getElementById('currentStepNumber');
      if (progressBar) progressBar.style.width = `${progress}%`;
      if (currentStepNumber) currentStepNumber.textContent = String(currentStep);
}

        function validateCurrentStep() {
      if (currentStep === 1) return validateStep1();
      if (currentStep === 2) return validateStep2();
      if (currentStep === 3) return validateStep3();
      if (currentStep === 4) return validateStep4();
                    return true;
    }

    function validateStep1() {
      const name = document.getElementById('name').value.trim();
      const role = getSelectedValue('.role-chip');
      const oneLineBio = document.getElementById('oneLineBio')?.value?.trim();
      if (!name || !role || !oneLineBio) {
        showMessage('Please fill in your name, select what you do, and enter a bio.', 'error');
                return false;
            }
            return true;
        }

    function validateStep2() {
      const casual = document.getElementById('casualSample').value.trim();
      if (!casual || casual.length < 20) {
        showMessage('Please enter at least one real friend-style message (20+ characters).', 'error');
                return false;
            }
            return true;
        }

    function validateStep3() {
      const likes = collectLikes();
      if (likes.length === 0) {
        showMessage('Please select at least one topic you like.', 'error');
                return false;
            }
      const toneStyle = getSelectedAttr('.tone-style-chip', 'data-tone-style');
      const emoji = getSelectedAttr('.emoji-chip', 'data-emoji');
      if (!toneStyle || !emoji) {
        showMessage('Please choose tone & language style and emoji usage.', 'error');
                return false;
            }
            return true;
        }

    function validateStep4() {
      const replySize = getSelectedAttr('.reply-size-chip', 'data-reply-size');
      const engagementStyle = getSelectedAttr('.engagement-style-chip', 'data-engagement-style');
      if (!replySize || !engagementStyle) {
        showMessage('Please choose default reply size and engagement style.', 'error');
        return false;
      }
      return true;
    }

    function saveCurrentStep() {
      if (currentStep === 1) saveStep1();
      if (currentStep === 2) saveStep2();
      if (currentStep === 3) saveStep3();
      if (currentStep === 4) saveStep4();
      persistOnboardingState();
    }

    function saveStep1() {
            onboardingData.basicInfo = {
        name: document.getElementById('name').value.trim(),
        oneLineBio: document.getElementById('oneLineBio')?.value?.trim(), // ✅ MANDATORY: No default empty string
        role: getSelectedValue('.role-chip') || '',
        roleOther: document.getElementById('roleOther').value.trim(),
        purpose: document.getElementById('purpose').value || undefined,
      };
    }

    function saveStep2() {
      onboardingData.styleSamples = {
        casualSample: document.getElementById('casualSample').value.trim(),
        formalSample: document.getElementById('formalSample').value.trim() || undefined,
      };
    }

    function saveStep3() {
      onboardingData.preferences = {
        likes: collectLikes(),
        avoids: collectAvoids(),
        toneStyle: getSelectedAttr('.tone-style-chip', 'data-tone-style') || 'normal',
        emojiPref: getSelectedAttr('.emoji-chip', 'data-emoji') || 'medium',
      };
    }

    function saveStep4() {
      const alwaysText = document.getElementById('alwaysRules').value.trim();
      const neverText = document.getElementById('neverRules').value.trim();
      onboardingData.rules = {
        always: alwaysText
          ? alwaysText
              .split('\n')
              .map((l) => l.trim())
              .filter(Boolean)
          : [],
        never: neverText
          ? neverText
              .split('\n')
              .map((l) => l.trim())
              .filter(Boolean)
          : [],
        replySize: getSelectedAttr('.reply-size-chip', 'data-reply-size') || 'normal',
        engagementStyle: getSelectedAttr('.engagement-style-chip', 'data-engagement-style') || 'mix',
      };
    }

    function collectLikes() {
      const explicit = getSelectedValues('.like-chip');
      const custom = Array.from(
        document.querySelectorAll('#likesCustomList [data-type="like-custom"]')
      ).map((el) => el.getAttribute('data-value'))
        .filter(Boolean);
      // ✅ Safety cap: max 3 likes
      return [...explicit, ...custom].slice(0, 3);
    }

    function collectAvoids() {
      const explicit = getSelectedValues('.avoid-chip');
      const custom = Array.from(
        document.querySelectorAll('#avoidsCustomList [data-type="avoid-custom"]')
      ).map((el) => el.getAttribute('data-value'))
        .filter(Boolean);
      // ✅ Safety cap: max 3 avoids
      return [...explicit, ...custom].slice(0, 3);
    }

    function generatePreview() {
      // Make sure we pull latest from DOM for steps 1–4
      saveStep1();
      saveStep2();
      saveStep3();
      saveStep4();

      const b = onboardingData.basicInfo || {};
      const p = onboardingData.preferences || {};
      const r = onboardingData.rules || {};

      const previewBasic = document.getElementById('previewBasic');
      const previewPreferences = document.getElementById('previewPreferences');
      const previewRules = document.getElementById('previewRules');

      const purposeText = b.purpose ? b.purpose.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Not specified';

      if (previewBasic) {
        previewBasic.innerHTML = `
          <p><strong>Name:</strong> ${escapeHtml(b.name || 'N/A')}</p>
          <p><strong>Bio:</strong> ${escapeHtml(b.oneLineBio || 'N/A')}</p>
          <p><strong>Role:</strong> ${escapeHtml(b.role || 'N/A')}</p>
          <p><strong>Purpose:</strong> ${escapeHtml(purposeText)}</p>
        `;
      }

      if (previewPreferences) {
        const likes = Array.isArray(p.likes) ? p.likes.join(', ') : 'N/A';
        const avoids = Array.isArray(p.avoids) ? p.avoids.join(', ') : 'N/A';
        const toneStyleText = p.toneStyle === 'polite' ? 'Polite & respectful' : p.toneStyle === 'normal' ? 'Normal & friendly' : 'Casual & relaxed';
        previewPreferences.innerHTML = `
          <p><strong>Likes:</strong> ${escapeHtml(likes)}</p>
          <p><strong>Topics to avoid:</strong> ${escapeHtml(avoids)}</p>
          <p><strong>Tone & language:</strong> ${escapeHtml(toneStyleText)}</p>
          <p><strong>Emoji usage:</strong> ${escapeHtml(p.emojiPref || 'medium')}</p>
        `;
      }

      if (previewRules) {
        const engagementText = r.engagementStyle === 'ask_questions' ? 'Ask questions' : r.engagementStyle === 'natural' ? 'Respond naturally' : 'Mix of both';
        previewRules.innerHTML = `
          <p><strong>Default reply size:</strong> ${escapeHtml(r.replySize || 'normal')}</p>
          <p><strong>Engagement style:</strong> ${escapeHtml(engagementText)}</p>
          ${r.always?.length > 0 ? `<p><strong>Always rules:</strong> ${escapeHtml(r.always.join('; '))}</p>` : ''}
          ${r.never?.length > 0 ? `<p><strong>Never rules:</strong> ${escapeHtml(r.never.join('; '))}</p>` : ''}
        `;
      }
    }

    function submitOnboarding() {
      const payload = {
        basicInfo: onboardingData.basicInfo,
        styleSamples: onboardingData.styleSamples,
        preferences: onboardingData.preferences,
        rules: onboardingData.rules,
        onboardingCompleted: true,
        completedAt: new Date().toISOString(),
      };

            const createBtn = document.getElementById('createTwinBtn');
      const originalText = createBtn ? createBtn.textContent : '';
      if (createBtn) {
            createBtn.disabled = true;
        createBtn.textContent = 'Creating your twin...';
      }

            fetch('/api/onboarding/create-enhanced-twin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken || '',
                },
                credentials: 'include',
        body: JSON.stringify(payload),
      })
        .then((r) => r.json())
        .then((data) => {
          if (!data.success) {
            showMessage(data.error || 'Failed to create twin.', 'error');
            if (createBtn) {
                    createBtn.disabled = false;
              createBtn.textContent = originalText;
            }
            return;
          }
          // Clear local saved onboarding so next time starts fresh
          try {
            localStorage.removeItem(ONBOARDING_STORAGE_KEY);
        } catch (e) {
            // Silently handle storage clearing errors
        }

          showMessage('Your twin is ready!', 'success');
          setTimeout(() => {
            window.location.href = '/chat';
          }, 1200);
        })
        .catch((err) => {
          showMessage('Network error, please try again.', 'error');
          if (createBtn) {
                createBtn.disabled = false;
            createBtn.textContent = originalText;
          }
        });
    }

    // Helpers
    function getSelectedValue(selector) {
      const el = document.querySelector(selector + '.selected');
      return el ? el.getAttribute('data-value') : null;
    }

    function getSelectedAttr(selector, attr) {
      const el = document.querySelector(selector + '.selected');
      return el ? el.getAttribute(attr) : null;
    }

    function getSelectedValues(selector) {
      return Array.from(document.querySelectorAll(selector + '.selected'))
        .map((el) => el.getAttribute('data-value'))
        .filter(Boolean);
    }

    function escapeHtml(text) {
      if (text == null) return '';
      const div = document.createElement('div');
      div.textContent = String(text);
      return div.innerHTML;
    }

    function showMessage(message, type) {
      const div = document.createElement('div');
      div.className =
        'fixed top-4 right-4 px-4 py-3 rounded-lg shadow-lg text-sm z-50 ' +
        (type === 'success'
          ? 'bg-green-500 text-white'
          : type === 'error'
          ? 'bg-red-500 text-white'
          : 'bg-blue-500 text-white');
      div.textContent = message;
      document.body.appendChild(div);
      setTimeout(() => div.remove(), 4000);
    }
    </script>

    <%- include('footer/footer-conditional-private') %>
</body>
</html>
