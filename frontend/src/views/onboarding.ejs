<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title>Create Your AI Twin - Onboarding</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        .gradient-text {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .step-active {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
        }
        .step-completed {
            background: #10b981;
            color: white;
        }
        .step-pending {
            background: #e5e7eb;
            color: #6b7280;
        }
        .tone-slider {
            -webkit-appearance: none;
            appearance: none;
            height: 8px;
            border-radius: 5px;
            background: #e5e7eb;
            outline: none;
        }
        .tone-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #6366f1;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(99, 102, 241, 0.3);
        }
        .tone-slider::-moz-range-thumb {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #6366f1;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 8px rgba(99, 102, 241, 0.3);
        }
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
    <!-- IMMEDIATE Auth Check -->
    <script>
        (function() {
            const isAuthenticated = <%= typeof user !== 'undefined' && user !== null && typeof user === 'object' && user.id !== undefined && user.id !== null ? 'true' : 'false' %>;
            const hasAuthToken = localStorage.getItem('jwtToken') || localStorage.getItem('user');
            
            if (!isAuthenticated && !hasAuthToken) {
                window.location.replace('/auth');
                return;
            }
            
            if (!isAuthenticated) {
                window.location.replace('/auth');
            }
        })();
    </script>
    
    <!-- Header -->
    <%- include('header') %>    

    <!-- Progress Indicator (Below Header) -->
    <div class="sticky top-20 z-40 bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-b border-white/20 dark:border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex items-center justify-center space-x-4">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Step <span id="currentStepNumber">1</span> of 5</span>
                <div class="w-48 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                    <div id="progressBar" class="h-full bg-gradient-to-r from-primary to-accent transition-all duration-500" style="width: 20%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="px-3 sm:px-4 py-6 sm:py-8 pt-20 sm:pt-24">        
        <div class="max-w-4xl mx-auto">
            <!-- Progress Steps -->
            <div class="mb-8">
                <div class="flex items-center justify-center space-x-2 md:space-x-4 overflow-x-auto pb-4">
                    <div class="flex items-center space-x-2">
                        <div id="step1" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-active">1</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Basic Info</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step2" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">2</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Style</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step3" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">3</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Interests</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step4" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">4</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Samples</span>
                    </div>
                    <div class="w-8 h-0.5 bg-gray-300"></div>
                    <div class="flex items-center space-x-2">
                        <div id="step5" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending">5</div>
                        <span class="hidden md:block text-sm font-medium text-gray-700">Preview</span>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 lg:p-8">
                <form id="onboardingForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    
                    <!-- Step 1: Basic Information -->
                    <div id="step1-content" class="step-content fade-in">
                        <div class="mb-8">
                            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Let's Get Started!</h1>
                            <p class="text-gray-600 dark:text-gray-300">Tell us about yourself to create your perfect AI twin.</p>
                        </div>

                        <div class="space-y-6">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Full Name *</label>
                                    <input type="text" id="fullName" name="fullName" required
                                           class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-base min-h-[44px] bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                                           style="font-size: 16px;"
                                           placeholder="Enter your full name" aria-label="Full Name">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Username *</label>
                                    <input type="text" id="username" name="username" required
                                           class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-base min-h-[44px] bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                                           style="font-size: 16px;"
                                           placeholder="Choose a unique username" aria-label="Username">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Short Bio *</label>
                                <textarea id="bio" name="bio" required rows="3"
                                          class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-base min-h-[44px] bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                                          style="font-size: 16px;"
                                          placeholder="Tell us about yourself in 50-150 characters" aria-label="Short Bio"></textarea>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><span id="bioCount">0</span>/150 characters</p>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Primary Use Case *</label>
                                <select id="primaryUseCase" name="primaryUseCase" required
                                        class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-base min-h-[44px] bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" style="font-size: 16px;" aria-label="Primary Use Case">
                                    <option value="">Select how you'll use your AI twin</option>
                                    <option value="personal">Personal conversations & chat</option>
                                    <option value="professional">Professional networking & business</option>
                                    <option value="customer-service">Customer service & support</option>
                                    <option value="content-creation">Content creation & social media</option>
                                    <option value="educational">Educational & learning</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Communication Style -->
                    <div id="step2-content" class="step-content hidden">
                        <div class="mb-8">
                            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Communication Style</h1>
                            <p class="text-gray-600 dark:text-gray-300">How should your AI twin communicate? Adjust these settings to match your style.</p>
                        </div>

                        <div class="space-y-8">
                            <!-- Tone Sliders -->
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Tone Preferences</h3>
                                
                                <div class="space-y-6">
                                    <div class="tone-slider-group">
                                        <div class="flex justify-between items-center mb-2">
                                            <label class="text-sm font-medium text-gray-700">Casual</label>
                                            <span id="formalCasualValue" class="text-sm text-primary font-semibold">50</span>
                                            <label class="text-sm font-medium text-gray-700">Formal</label>
                                        </div>
                                        <input type="range" id="formalCasual" name="formalCasual" min="0" max="100" value="50" class="tone-slider w-full">
                                    </div>

                                    <div class="tone-slider-group">
                                        <div class="flex justify-between items-center mb-2">
                                            <label class="text-sm font-medium text-gray-700">Playful</label>
                                            <span id="seriousPlayfulValue" class="text-sm text-primary font-semibold">50</span>
                                            <label class="text-sm font-medium text-gray-700">Serious</label>
                                        </div>
                                        <input type="range" id="seriousPlayful" name="seriousPlayful" min="0" max="100" value="50" class="tone-slider w-full">
                                    </div>

                                    <div class="tone-slider-group">
                                        <div class="flex justify-between items-center mb-2">
                                            <label class="text-sm font-medium text-gray-700">Diplomatic</label>
                                            <span id="directDiplomaticValue" class="text-sm text-primary font-semibold">50</span>
                                            <label class="text-sm font-medium text-gray-700">Direct</label>
                                        </div>
                                        <input type="range" id="directDiplomatic" name="directDiplomatic" min="0" max="100" value="50" class="tone-slider w-full">
                                    </div>
                                </div>
                            </div>

                            <!-- Language Preferences -->
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Language Preferences</h3>
                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Greeting Style *</label>
                                        <select id="greetingStyle" name="greetingStyle" required
                                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent">
                                            <option value="">Select greeting style</option>
                                            <option value="formal">Formal: "Hello", "Good morning"</option>
                                            <option value="casual">Casual: "Hey", "Hi there"</option>
                                            <option value="friendly">Friendly: "Hey!", "Hi!"</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Closing Style *</label>
                                        <select id="closingStyle" name="closingStyle" required
                                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent">
                                            <option value="">Select closing style</option>
                                            <option value="formal">Formal: "Best regards", "Sincerely"</option>
                                            <option value="casual">Casual: "Talk soon", "Catch you later"</option>
                                            <option value="friendly">Friendly: "Take care!", "See you soon!"</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Additional Preferences -->
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Additional Preferences</h3>
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Emoji Usage *</label>
                                        <div class="flex space-x-4">
                                            <label class="flex items-center">
                                                <input type="radio" name="emojiUsage" value="high" class="mr-2" required>
                                                <span class="text-sm">High: Use emojis frequently 😊</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="radio" name="emojiUsage" value="medium" class="mr-2" required>
                                                <span class="text-sm">Medium: Occasional emojis</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="radio" name="emojiUsage" value="low" class="mr-2" required>
                                                <span class="text-sm">Low: Rarely use emojis</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Response Length *</label>
                                        <div class="flex space-x-4">
                                            <label class="flex items-center">
                                                <input type="radio" name="responseLength" value="short" class="mr-2" required>
                                                <span class="text-sm">Short: Brief, concise responses</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="radio" name="responseLength" value="medium" class="mr-2" required>
                                                <span class="text-sm">Medium: Balanced length</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="radio" name="responseLength" value="long" class="mr-2" required>
                                                <span class="text-sm">Long: Detailed, thorough responses</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Common Phrases (Optional)</label>
                                        <input type="text" id="commonPhrases" name="commonPhrases"
                                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent"
                                               placeholder="e.g., 'Thanks!', 'No worries', 'Absolutely!'">
                                        <p class="text-xs text-gray-500 mt-1">Enter phrases you commonly use, separated by commas</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Context & Interests -->
                    <div id="step3-content" class="step-content hidden">
                        <div class="mb-8">
                            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Interests & Context</h1>
                            <p class="text-gray-600">Help your AI twin understand your interests and context.</p>
                        </div>

                        <div class="space-y-8">
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Interests & Hobbies *</h3>
                                <p class="text-sm text-gray-600 mb-4">Select at least 3 interests:</p>
                                <div class="grid md:grid-cols-3 gap-4">
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="technology" class="mr-3">
                                        <span class="text-sm">Technology & AI</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="sports" class="mr-3">
                                        <span class="text-sm">Sports & Fitness</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="arts" class="mr-3">
                                        <span class="text-sm">Arts & Culture</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="travel" class="mr-3">
                                        <span class="text-sm">Travel & Adventure</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="food" class="mr-3">
                                        <span class="text-sm">Food & Cooking</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="music" class="mr-3">
                                        <span class="text-sm">Music & Entertainment</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="books" class="mr-3">
                                        <span class="text-sm">Books & Reading</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="gaming" class="mr-3">
                                        <span class="text-sm">Gaming</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="business" class="mr-3">
                                        <span class="text-sm">Business & Entrepreneurship</span>
                                    </label>
                                    <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                                        <input type="checkbox" name="interests" value="science" class="mr-3">
                                        <span class="text-sm">Science & Nature</span>
                                    </label>
                                </div>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Target Audience *</h3>
                                <select id="targetAudience" name="targetAudience" required
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent">
                                    <option value="">Select target audience</option>
                                    <option value="friends-family">Friends and family</option>
                                    <option value="colleagues">Professional colleagues</option>
                                    <option value="general-public">General public</option>
                                    <option value="industry-specific">Specific industry</option>
                                    <option value="students">Students/learners</option>
                                </select>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Topics to Avoid (Optional)</h3>
                                <textarea id="topicsToAvoid" name="topicsToAvoid" rows="3"
                                          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent"
                                          placeholder="List any topics your AI twin should avoid or be careful about..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Text Samples (REQUIRED) -->
                    <div id="step4-content" class="step-content hidden">
                        <div class="mb-8">
                            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Text Samples</h1>
                            <p class="text-gray-600">Provide real examples of your writing. This is the most important step for accuracy!</p>
                            <p class="text-sm text-red-600 mt-2 font-medium">* Required - At least 2 samples needed</p>
                        </div>

                        <div class="space-y-8">
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Sample 1: Email or Message *</h3>
                                <textarea id="sample1" name="sample1" required rows="4"
                                          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent"
                                          placeholder="Paste a real email or message you've written..."></textarea>
                                <p class="text-xs text-gray-500 mt-1">This helps us understand your writing style</p>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Sample 2: Social Media Post or Text *</h3>
                                <textarea id="sample2" name="sample2" required rows="4"
                                          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent"
                                          placeholder="Paste a social media post, tweet, or casual text message..."></textarea>
                                <p class="text-xs text-gray-500 mt-1">Shows your casual communication style</p>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Sample 3: Additional (Optional but Recommended)</h3>
                                <textarea id="sample3" name="sample3" rows="4"
                                          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent"
                                          placeholder="Any other writing sample - professional, creative, etc..."></textarea>
                                <p class="text-xs text-gray-500 mt-1">More samples = better accuracy</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 5: Preview & Confirm -->
                    <div id="step5-content" class="step-content hidden">
                        <div class="mb-8">
                            <h1 class="text-3xl font-bold text-gray-900 mb-2">Your AI Twin Preview</h1>
                            <p class="text-gray-600">Review your settings. You can edit them anytime after creation.</p>
                        </div>

                        <div class="space-y-6">
                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h3>
                                <div id="previewBasicInfo" class="space-y-2 text-sm text-gray-700"></div>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Communication Style</h3>
                                <div id="previewStyle" class="space-y-2 text-sm text-gray-700"></div>
                            </div>

                            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Interests</h3>
                                <div id="previewInterests" class="text-sm text-gray-700"></div>
                            </div>

                            <div class="bg-gradient-to-r from-primary to-accent rounded-xl p-6 text-white">
                                <h3 class="text-lg font-semibold mb-4">Ready to Create Your AI Twin?</h3>
                                <p class="mb-4">Your AI twin will be created with all the preferences you've selected. You can always modify these settings later.</p>
                                <div class="flex space-x-4">
                                    <button type="button" id="editSettingsBtn" class="px-6 py-3 bg-white/20 backdrop-blur-sm text-white rounded-lg hover:bg-white/30 transition-all duration-300 font-semibold">
                                        Edit Settings
                                    </button>
                                    <button type="submit" id="createTwinBtn" class="px-6 py-3 bg-white text-primary rounded-lg hover:bg-gray-100 transition-all duration-300 font-semibold">
                                        Create My AI Twin
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation Buttons -->
                    <div class="flex justify-between items-center mt-8 pt-6 border-t border-gray-200">
                        <button type="button" id="prevBtn" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-semibold hidden">
                            ← Previous
                        </button>
                        <div class="flex-1"></div>
                        <button type="button" id="nextBtn" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-secondary transition-colors font-semibold">
                            Next →
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Global variables
        let currentStep = 1;
        const totalSteps = 5;
        let onboardingData = {};

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            initializeOnboarding();
            setupEventListeners();
            updateProgress();
        });

        function initializeOnboarding() {
            showStep(1);
            
            // Bio character counter
            const bioTextarea = document.getElementById('bio');
            const bioCount = document.getElementById('bioCount');
            bioTextarea.addEventListener('input', function() {
                bioCount.textContent = this.value.length;
            });

            // Tone sliders
            initializeToneSliders();
        }

        function setupEventListeners() {
            document.getElementById('nextBtn').addEventListener('click', nextStep);
            document.getElementById('prevBtn').addEventListener('click', prevStep);
            document.getElementById('onboardingForm').addEventListener('submit', handleFormSubmission);
            document.getElementById('editSettingsBtn').addEventListener('click', editSettings);
        }

        function initializeToneSliders() {
            const sliders = ['formalCasual', 'seriousPlayful', 'directDiplomatic'];
            sliders.forEach(sliderId => {
                const slider = document.getElementById(sliderId);
                const valueSpan = document.getElementById(sliderId + 'Value');
                slider.addEventListener('input', function() {
                    valueSpan.textContent = this.value;
                });
            });
        }

        function showStep(step) {
            document.querySelectorAll('.step-content').forEach(content => {
                content.classList.add('hidden');
            });
            document.getElementById(`step${step}-content`).classList.remove('hidden');
            document.getElementById(`step${step}-content`).classList.add('fade-in');

            // Update step indicators
            for (let i = 1; i <= totalSteps; i++) {
                const stepElement = document.getElementById(`step${i}`);
                if (i < step) {
                    stepElement.className = 'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-completed';
                } else if (i === step) {
                    stepElement.className = 'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-active';
                } else {
                    stepElement.className = 'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold step-pending';
                }
            }

            updateNavigationButtons(step);
        }

        function updateNavigationButtons(step) {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (step > 1) {
                prevBtn.classList.remove('hidden');
            } else {
                prevBtn.classList.add('hidden');
            }

            if (step === totalSteps) {
                nextBtn.textContent = 'Create My AI Twin';
                nextBtn.type = 'submit';
            } else {
                nextBtn.textContent = 'Next →';
                nextBtn.type = 'button';
            }
        }

        function updateProgress() {
            const progress = (currentStep / totalSteps) * 100;
            document.getElementById('progressBar').style.width = `${progress}%`;
            document.getElementById('currentStepNumber').textContent = currentStep;
        }

        function nextStep() {
            if (validateCurrentStep()) {
                saveCurrentStepData();
                
                if (currentStep < totalSteps) {
                    currentStep++;
                    showStep(currentStep);
                    updateProgress();
                    
                    if (currentStep === 5) {
                        generatePreview();
                    }
                }
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                showStep(currentStep);
                updateProgress();
            }
        }

        function validateCurrentStep() {
            switch (currentStep) {
                case 1:
                    return validateBasicInfo();
                case 2:
                    return validateStyle();
                case 3:
                    return validateInterests();
                case 4:
                    return validateSamples();
                case 5:
                    return true;
                default:
                    return true;
            }
        }

        function validateBasicInfo() {
            const fullName = document.getElementById('fullName').value.trim();
            const username = document.getElementById('username').value.trim();
            const bio = document.getElementById('bio').value.trim();
            const primaryUseCase = document.getElementById('primaryUseCase').value;

            if (!fullName || !username || !bio || !primaryUseCase) {
                showMessage('Please fill in all required fields.', 'error');
                return false;
            }

            if (bio.length < 50 || bio.length > 150) {
                showMessage('Bio must be between 50-150 characters.', 'error');
                return false;
            }

            return true;
        }

        function validateStyle() {
            const greetingStyle = document.getElementById('greetingStyle').value;
            const closingStyle = document.getElementById('closingStyle').value;
            const emojiUsage = document.querySelector('input[name="emojiUsage"]:checked');
            const responseLength = document.querySelector('input[name="responseLength"]:checked');

            if (!greetingStyle || !closingStyle || !emojiUsage || !responseLength) {
                showMessage('Please fill in all required fields.', 'error');
                return false;
            }

            return true;
        }

        function validateInterests() {
            const interests = document.querySelectorAll('input[name="interests"]:checked');
            const targetAudience = document.getElementById('targetAudience').value;

            if (interests.length < 3) {
                showMessage('Please select at least 3 interests.', 'error');
                return false;
            }

            if (!targetAudience) {
                showMessage('Please select your target audience.', 'error');
                return false;
            }

            return true;
        }

        function validateSamples() {
            const sample1 = document.getElementById('sample1').value.trim();
            const sample2 = document.getElementById('sample2').value.trim();

            if (!sample1 || !sample2) {
                showMessage('Please provide at least 2 text samples. This is required for accuracy!', 'error');
                return false;
            }

            if (sample1.length < 20 || sample2.length < 20) {
                showMessage('Each sample should be at least 20 characters long.', 'error');
                return false;
            }

            return true;
        }

        function saveCurrentStepData() {
            switch (currentStep) {
                case 1:
                    saveBasicInfo();
                    break;
                case 2:
                    saveStyleData();
                    break;
                case 3:
                    saveContextData();
                    break;
                case 4:
                    saveSampleData();
                    break;
            }
        }

        function saveBasicInfo() {
            onboardingData.basicInfo = {
                fullName: document.getElementById('fullName').value,
                username: document.getElementById('username').value,
                bio: document.getElementById('bio').value,
                primaryUseCase: document.getElementById('primaryUseCase').value
            };
        }

        function saveStyleData() {
            onboardingData.communicationStyle = {
                tone: {
                    formalCasual: parseInt(document.getElementById('formalCasual').value),
                    seriousPlayful: parseInt(document.getElementById('seriousPlayful').value),
                    directDiplomatic: parseInt(document.getElementById('directDiplomatic').value)
                },
                language: {
                    greetingStyle: document.getElementById('greetingStyle').value,
                    closingStyle: document.getElementById('closingStyle').value,
                    emojiUsage: document.querySelector('input[name="emojiUsage"]:checked')?.value,
                    responseLength: document.querySelector('input[name="responseLength"]:checked')?.value,
                    commonPhrases: document.getElementById('commonPhrases').value || ''
                }
            };
        }

        function saveContextData() {
            const interests = Array.from(document.querySelectorAll('input[name="interests"]:checked'))
                .map(checkbox => checkbox.value);

            onboardingData.context = {
                interests: interests,
                targetAudience: document.getElementById('targetAudience').value,
                topicsToAvoid: document.getElementById('topicsToAvoid').value || ''
            };
        }

        function saveSampleData() {
            const samples = [];
            
            const sample1 = document.getElementById('sample1').value.trim();
            if (sample1) samples.push({ category: 'email-message', content: sample1 });
            
            const sample2 = document.getElementById('sample2').value.trim();
            if (sample2) samples.push({ category: 'social-media', content: sample2 });
            
            const sample3 = document.getElementById('sample3').value.trim();
            if (sample3) samples.push({ category: 'additional', content: sample3 });

            onboardingData.samples = {
                content: samples
            };
        }

        function generatePreview() {
            const basicInfo = onboardingData.basicInfo || {};
            const style = onboardingData.communicationStyle || {};
            const context = onboardingData.context || {};

            // Basic Info Preview
            document.getElementById('previewBasicInfo').innerHTML = `
                <p><strong>Name:</strong> ${basicInfo.fullName || 'N/A'}</p>
                <p><strong>Username:</strong> ${basicInfo.username || 'N/A'}</p>
                <p><strong>Bio:</strong> ${basicInfo.bio || 'N/A'}</p>
                <p><strong>Use Case:</strong> ${basicInfo.primaryUseCase || 'N/A'}</p>
            `;

            // Style Preview
            const tone = style.tone || {};
            const lang = style.language || {};
            document.getElementById('previewStyle').innerHTML = `
                <p><strong>Tone:</strong> ${tone.formalCasual > 50 ? 'Formal' : 'Casual'}, ${tone.seriousPlayful > 50 ? 'Serious' : 'Playful'}, ${tone.directDiplomatic > 50 ? 'Direct' : 'Diplomatic'}</p>
                <p><strong>Greeting:</strong> ${lang.greetingStyle || 'N/A'}</p>
                <p><strong>Emoji Usage:</strong> ${lang.emojiUsage || 'N/A'}</p>
                <p><strong>Response Length:</strong> ${lang.responseLength || 'N/A'}</p>
            `;

            // Interests Preview
            const interests = context.interests || [];
            document.getElementById('previewInterests').innerHTML = `
                <p><strong>Interests:</strong> ${interests.join(', ') || 'N/A'}</p>
                <p><strong>Target Audience:</strong> ${context.targetAudience || 'N/A'}</p>
            `;
        }

        function editSettings() {
            currentStep = 1;
            showStep(currentStep);
            updateProgress();
        }

        function handleFormSubmission(e) {
            e.preventDefault();
            if (currentStep === totalSteps) {
                createAITwin();
            }
        }

        function createAITwin() {
            const createBtn = document.getElementById('createTwinBtn');
            const originalText = createBtn.textContent;
            
            createBtn.textContent = 'Creating Your AI Twin...';
            createBtn.disabled = true;

            // Prepare data for API
            const twinData = {
                ...onboardingData,
                onboardingCompleted: true,
                completedAt: new Date().toISOString()
            };

            fetch('/api/onboarding/create-enhanced-twin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
                },
                credentials: 'include',
                body: JSON.stringify(twinData)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showMessage('Your AI Twin has been created successfully!', 'success');
                    setTimeout(() => {
                        const twinId = result.twin?.id;
                        if (twinId) {
                            window.location.href = `/chat-enhanced?twinId=${twinId}`;
                        }
                        else {
                            window.location.href = '/dashboard';
                        }
                    }, 2000);
                } else {
                    showMessage(result.error || 'Failed to create AI Twin', 'error');
                    createBtn.textContent = originalText;
                    createBtn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error creating twin:', error);
                showMessage('Network error. Please try again.', 'error');
                createBtn.textContent = originalText;
                createBtn.disabled = false;
            });
        }

        function showMessage(message, type = 'info') {
            const messageDiv = document.createElement('div');
            messageDiv.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            messageDiv.textContent = message;
            document.body.appendChild(messageDiv);
            setTimeout(() => {
                messageDiv.remove();
            }, 5000);
        }
    </script>
    <!--Footer-->
    <%- include('footer/footer-conditional-private') %>
</body>
</html>

