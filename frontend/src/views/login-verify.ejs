<%- include('layout', { title: title, user: user, csrfToken: csrfToken, body: `
    <div class="px-4 py-6 sm:px-0">
        <div class="max-w-md mx-auto">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900 p-4 sm:p-6 lg:p-8">
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">Verify Your Email</h1>
                
                <div id="errorMessage" class="hidden mb-4 p-3 bg-red-100 dark:bg-red-900/20 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-300 rounded"></div>
                <div id="successMessage" class="hidden mb-4 p-3 bg-green-100 dark:bg-green-900/20 border border-green-400 dark:border-green-600 text-green-700 dark:text-green-300 rounded"></div>
                
                <div class="mb-4 text-center">
                    <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">
                        We sent a 6-digit code to:
                    </p>
                    <p class="font-medium text-gray-900 dark:text-white"><%= email || 'your email' %></p>
                </div>
                
                <form id="verifyForm">
                    <div class="mb-4">
                        <label for="code" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Enter Verification Code
                        </label>
                        <input 
                            type="text" 
                            id="code" 
                            name="code" 
                            required
                            maxlength="6"
                            pattern="[0-9]{6}"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-center text-2xl tracking-widest text-base min-h-[44px]"
                            placeholder="123456"
                            aria-label="Verification Code"
                        >
                    </div>
                    
                    <button 
                        type="submit"
                        id="verifyBtn"
                        class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition-colors font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base"
                        aria-label="Verify Code"
                    >
                        Verify Code
                    </button>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="email" value="<%= email || '' %>">
                </form>
                
                <!-- ✅ ADD: Resend OTP Button (Visible by default with timer) -->
                <div class="mt-4 text-center">
                    <button type="button" id="resendOtpBtn" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium disabled:text-gray-400 disabled:cursor-not-allowed" aria-label="Resend OTP">
                        Didn't receive code?
                    </button>
                    <span id="resendTimer" class="text-sm text-gray-500 ml-2"></span>
                </div>
                
                <div class="mt-6 text-center">
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        <a href="/login" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">← Back to Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    
    <script>
    function showError(message) {
        const errorDiv = document.getElementById('errorMessage');
        const successDiv = document.getElementById('successMessage');
        errorDiv.textContent = message;
        errorDiv.classList.remove('hidden');
        successDiv.classList.add('hidden');
    }
    
    function showSuccess(message) {
        const errorDiv = document.getElementById('errorMessage');
        const successDiv = document.getElementById('successMessage');
        successDiv.textContent = message;
        successDiv.classList.remove('hidden');
        errorDiv.classList.add('hidden');
    }
    
    function hideMessages() {
        document.getElementById('errorMessage').classList.add('hidden');
        document.getElementById('successMessage').classList.add('hidden');
    }
    
    // ✅ ADD: Start timer immediately when page loads (30 seconds cooldown)
    startResendTimer(30);
    
    // Auto-focus on code input
    document.getElementById('code').focus();
    
    // Format code input (only numbers, max 6 digits)
    document.getElementById('code').addEventListener('input', function(e) {
        e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 6);
    });
    
    document.getElementById('verifyForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const code = document.getElementById('code').value;
        const email = document.querySelector('input[name="email"]').value;
        const verifyBtn = document.getElementById('verifyBtn');
        const originalText = verifyBtn.textContent;
        
        // Validate code
        if (!code || code.length !== 6) {
            showError('Please enter a valid 6-digit code');
            return;
        }
        
        // Show loading state
        verifyBtn.textContent = 'Verifying...';
        verifyBtn.disabled = true;
        hideMessages();
        
        try {
            const csrfToken = document.querySelector('input[name="_csrf"]').value;
            
            const response = await fetch('/api/auth/login/verify', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ 
                    email: email,
                    code: code
                })
            });
            
            const result = await response.json();
            
            if (response.ok) {
                showSuccess('OTP verification successful! Redirecting to dashboard...');
                setTimeout(() => {
                    window.location.replace('/dashboard');
                }, 2000);
            } else {
                // ✅ HANDLE OTP_EXPIRED and OTP_ALREADY_USED specially
                if (result.errorCode === 'OTP_EXPIRED' || result.errorCode === 'OTP_ALREADY_USED') {
                    showError(result.error || 'OTP expired. Please resend.');
                    // Resend button already visible, just ensure it's enabled if timer expired
                    const resendBtn = document.getElementById('resendOtpBtn');
                    if (resendBtn && !resendBtn.disabled) {
                        // Timer might have expired, button should be clickable
                    }
                } else {
                    showError(result.error || 'Invalid verification code');
                }
            }
        } catch (error) {
            console.error('Verification error:', error);
            showError('Network error. Please try again.');
        } finally {
            verifyBtn.textContent = originalText;
            verifyBtn.disabled = false;
        }
    });
    
    // ✅ ADD: Resend OTP Handler
    const resendBtn = document.getElementById('resendOtpBtn');
    if (resendBtn) {
        resendBtn.addEventListener('click', async () => {
            const email = document.querySelector('input[name="email"]').value;
            const timerSpan = document.getElementById('resendTimer');
            const csrfToken = document.querySelector('input[name="_csrf"]').value;
            
            if (!email) {
                showError('Email not found. Please go back and try again.');
                return;
            }
            
            // Disable button
            resendBtn.disabled = true;
            const originalHTML = resendBtn.innerHTML;
            resendBtn.innerHTML = 'Sending...';
            
            try {
                // ✅ UPDATE: Use dedicated resend endpoint
                const response = await fetch('/api/auth/resend-otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({ 
                        email: email,
                        type: 'login'
                    })
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    showSuccess('New OTP sent to your email!');
                     // ✅ UPDATE: Show "Sent!" before starting timer
                    resendBtn.innerHTML = '✓ Sent!';
                    resendBtn.disabled = true;
    
                     // Wait a moment to show "Sent!" then start timer
                    setTimeout(() => {
                        // ✅ RESTART timer after successful resend (30 seconds)
                        startResendTimer(30);
                    }, 1000); // 1 second delay to show "Sent!"

                } else {
                    // ✅ HANDLE rate limiting errors
                    if (response.status === 429) {
                        const retryAfter = response.headers.get('Retry-After') || '10 minutes';
                        showError(`Too many requests. Please wait ${retryAfter} before trying again.`);
                    } else {
                        showError(result.error || 'Failed to resend OTP');
                    }
                    resendBtn.disabled = false;
                    resendBtn.innerHTML = originalHTML;
                }
            } catch (error) {
                console.error('Resend OTP error:', error);
                showError('Network error. Please try again.');
                resendBtn.disabled = false;
                resendBtn.innerHTML = originalHTML;
            }
        });
    }
    
    // ✅ UPDATE: Countdown Timer Function (improved)
    function startResendTimer(seconds) {
        const resendBtn = document.getElementById('resendOtpBtn');
        const timerSpan = document.getElementById('resendTimer');
        
        if (!resendBtn || !timerSpan) return;
        
        // Clear any existing timer
        if (window.resendTimerInterval) {
            clearInterval(window.resendTimerInterval);
        }
        
        resendBtn.disabled = true;
        resendBtn.classList.remove('hidden');
        timerSpan.classList.remove('hidden');
        
        let remaining = seconds;
        timerSpan.textContent = `Resend in ${remaining}s`;
        
        window.resendTimerInterval = setInterval(() => {
            remaining--;
            if (remaining > 0) {
                timerSpan.textContent = `Resend in ${remaining}s`;
            } else {
                clearInterval(window.resendTimerInterval);
                timerSpan.classList.add('hidden');
                resendBtn.disabled = false;
                resendBtn.innerHTML = 'Didn\'t receive code?';
            }
        }, 1000);
    }
    </script>
    ` }) %>