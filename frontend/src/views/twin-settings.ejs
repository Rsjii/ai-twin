<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <title>Twin Settings - AI Twin</title>
  <link rel="stylesheet" href="/css/output.css" />
  <script src="/utils/timeUtils.js"></script>
  <script src="/utils/errorHandler.js"></script>
  <script>
    (function () {
      const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
  <script>window.csrfToken = '<%= csrfToken %>';</script>
</head>

<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 min-h-screen font-inter">
  <%- include('header') %>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-1">Twin Settings</h1>
          <p class="text-gray-600 dark:text-gray-300">Setup your twin once. Everything else becomes easy.</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-2">
          <a href="/analytics"
             class="inline-flex justify-center px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] items-center text-sm">
            Open Analytics
          </a>
        </div>
      </div>
    </div>

    <!-- Identity -->
    <section class="mb-6 bg-white/80 dark:bg-gray-800/80 rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          Identity
        </h2>
        <p class="text-xs text-gray-500 dark:text-gray-400">Define your twin's name, role, and basic bio.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Twin name
          </label>
          <input id="twinName" type="text"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all"
            placeholder="e.g. KS Twin"
            maxlength="50" />
          <p id="twinName-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Role
          </label>
          <select id="twinRole"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="">Select</option>
            <option value="friend">Friend</option>
            <option value="creator">Creator</option>
            <option value="support">Customer Support</option>
            <option value="coach">Coach</option>
          </select>
          <p id="twinRole-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>

        <div class="sm:col-span-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            One-line bio
          </label>
          <input id="twinBio" type="text"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] break-words overflow-wrap-anywhere transition-all"
            placeholder="e.g. Replies like me on WhatsApp — casual, witty, helpful."
            maxlength="150" />
          <p id="twinBio-error" class="text-xs text-red-500 mt-1 hidden"></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><span id="bioCharCount">0</span>/150 characters</p>
        </div>

        <!-- MVP: hide default language (V2 feature) -->
        <div class="hidden">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Default language
          </label>
          <select id="twinLanguage"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="">Use existing</option>
            <option value="en">English</option>
            <option value="hi">Hindi</option>
            <option value="hinglish">Hinglish</option>
          </select>
          <p id="twinLanguage-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            What do you want your twin to help you with?
          </label>
          <select id="twinPurpose"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="">Not specified</option>
            <option value="just_chat">Just chat</option>
            <option value="practice">Practice conversations</option>
            <option value="brainstorm">Brainstorm ideas</option>
            <option value="advice">Get advice</option>
            <option value="remember">Remember things</option>
            <option value="other">Other</option>
          </select>
          <p id="twinPurpose-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>
      </div>
    </section>

    <!-- Voice & Output -->
    <section id="styleSection" class="mb-6 bg-white/80 dark:bg-gray-800/80 rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>
          Voice & Output
        </h2>
        <p class="text-xs text-gray-500 dark:text-gray-400">Control how your twin speaks, reply length, and emoji usage.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Tone preset
          </label>
          <select id="tonePreset"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="polite">Polite & respectful</option>
            <option value="normal">Normal & friendly</option>
            <option value="casual">Casual & relaxed</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Reply length
          </label>
          <select id="replyLengthPreset"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="short">Short & to the point</option>
            <option value="normal">Normal</option>
            <option value="detailed">A bit more detailed</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Emoji level
          </label>
          <select id="emojiPreset"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="off">Off</option>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
          </select>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">This maps to your styleVector's emoji usage.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Engagement style
          </label>
          <select id="engagementStyle"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white min-h-[44px] transition-all">
            <option value="ask_questions">Ask questions to keep conversation going</option>
            <option value="natural">Respond naturally without forcing questions</option>
            <option value="mix">Mix of both</option>
          </select>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">This controls whether your twin asks questions to keep conversations going.</p>
        </div>
      </div>

      <div class="mt-4 hidden">
        <button id="previewStyleBtn" type="button"
          class="inline-flex justify-center px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px] items-center text-sm">
          Preview reply
        </button>
      </div>

      <div id="stylePreviewSection" class="hidden mt-4 p-3 sm:p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700" aria-hidden="true">
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Preview</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Current</p>
            <div id="stylePreviewOriginal" class="p-3 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white min-h-[60px]"></div>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">With your settings</p>
            <div id="stylePreviewNew" class="p-3 rounded-lg bg-primary/5 dark:bg-primary/20 text-gray-900 dark:text-white min-h-[60px]"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Boundaries -->
    <section class="mb-6 bg-white/80 dark:bg-gray-800/80 rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          Boundaries
        </h2>
        <p class="text-xs text-gray-500 dark:text-gray-400">Set safety limits and rules for what your twin should always or never say.</p>
      </div>

      <div class="space-y-3">
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
          <input type="checkbox" id="avoidNSFW" class="rounded border-gray-300 dark:border-gray-600" />
          <span>Avoid adult / NSFW content</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
          <input type="checkbox" id="avoidAbuse" class="rounded border-gray-300 dark:border-gray-600" />
          <span>Avoid heavy swearing / abusive language</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
          <input type="checkbox" id="avoidPoliticsReligion" class="rounded border-gray-300 dark:border-gray-600" />
          <span>Avoid deep politics / religion</span>
        </label>
      </div>

      <!-- Preferences & Rules (editable) -->
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Always do / say <span class="text-xs text-gray-500 dark:text-gray-400 font-normal">(comma separated)</span>
          </label>
          <textarea id="alwaysInput" rows="3"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white transition-all"
            placeholder="e.g. be concise, greet politely"></textarea>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
            Max 120 characters (<span id="alwaysInputCharCount">0</span>/120)
          </p>
          <p id="alwaysInput-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Never do / say <span class="text-xs text-gray-500 dark:text-gray-400 font-normal">(comma separated)</span>
          </label>
          <textarea id="neverInput" rows="3"
            class="w-full px-3 py-2.5 bg-white/80 dark:bg-gray-700/80 border border-gray-300 dark:border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary text-gray-900 dark:text-white transition-all"
            placeholder="e.g. insult, reveal private info"></textarea>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
            Max 120 characters (<span id="neverInputCharCount">0</span>/120)
          </p>
          <p id="neverInput-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>
      </div>
    </section>

    <!-- Memory (Facts & Preferences) -->
    <section id="memorySection" class="mb-6 bg-white/80 dark:bg-gray-800/80 rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6">
      <div class="flex items-center justify-between gap-2 mb-4">
        <div>
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
            Memory (Facts & Preferences)
          </h2>
          <p class="text-xs text-gray-500 dark:text-gray-400">Manage what your twin knows about you and what it shares publicly.</p>
        </div>
        <button id="openMemoryManagerBtn" type="button"
          class="inline-flex justify-center px-4 py-2 bg-white/80 dark:bg-gray-700/80 text-gray-800 dark:text-gray-100 rounded-xl border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors min-h-[44px] items-center text-sm font-medium">
          View all
        </button>
      </div>

      <div class="mt-3 space-y-3">
        <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
          <input type="checkbox" id="memoryEnabled" class="rounded border-gray-300 dark:border-gray-600" />
          <span>Enable memory to personalize replies</span>
        </label>

        <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
          <input type="checkbox" id="allowPublicUse" class="rounded border-gray-300 dark:border-gray-600" />
          <span>Allow public chat to use my “Public” memories</span>
        </label>

        <p class="text-xs text-gray-500 dark:text-gray-400">
          Public chat will ONLY use memories marked “Public”. Private memories stay private.
        </p>
      </div>

      <div class="mt-4 p-3 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-semibold text-gray-900 dark:text-white">Quick preview</p>
          <button id="refreshMemoryPreviewBtn" type="button"
            class="inline-flex justify-center px-3 py-2 bg-white/80 dark:bg-gray-700/80 text-gray-800 dark:text-gray-100 rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors min-h-[36px] items-center text-xs font-medium">
            Refresh
          </button>
        </div>
        <ul id="memoryBullets" class="mt-2 list-disc list-inside space-y-1 text-sm text-gray-700 dark:text-gray-300">
          <li class="text-gray-400 dark:text-gray-500">Loading…</li>
        </ul>
      </div>
    </section>

    <!-- Advanced (V2 Feature - Hidden for MVP) -->
    <section class="mb-6 bg-white/80 dark:bg-gray-800/80 rounded-xl shadow-lg dark:shadow-gray-900 border border-white/20 dark:border-gray-700 p-4 sm:p-6 hidden">
      <details>
        <summary class="cursor-pointer">
          <div class="inline-flex flex-col vertical-align-top">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
              Advanced
            </h2>
            <p class="text-xs text-gray-500 dark:text-gray-400">Fine-tune adaptation and access advanced creator tools.</p>
          </div>
        </summary>

        <div class="mt-4">
          <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
            <input type="checkbox" id="adaptationEnabled" class="rounded border-gray-300 dark:border-gray-600" />
            <span>Try to match the other person's tone & language</span>
          </label>

          <div id="adaptationSliderContainer" class="mt-3 space-y-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
              Style mix: <span id="styleMixValue">50</span>
            </label>
            <input type="range" id="styleMixSlider" min="0" max="100" value="50"
              class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer">
            <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
              <span>More like me</span>
              <span>More like them</span>
            </div>
          </div>
        </div>

        <% /* ✅ MVP: Creator Tools section removed (V2 feature - AI Edit) */ %>
      </details>
    </section>

    <!-- Save -->
    <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 sm:p-5 rounded-xl bg-gradient-to-r from-white/90 to-blue-50/90 dark:from-gray-800/90 dark:to-gray-800/90 border-2 border-primary/20 dark:border-primary/30 shadow-lg">
      <div class="text-sm text-gray-600 dark:text-gray-300">
        <span class="font-semibold text-gray-900 dark:text-white">Settings</span>
        <span class="ml-2">Save only when you change something.</span>
      </div>

      <button id="twinSettingsSave"
        class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-xl hover:scale-105 transition-all font-semibold shadow-lg min-h-[48px] text-base">
        Save settings
      </button>
    </div>

    <!-- Danger Zone -->
    <section class="mt-6 bg-red-50 dark:bg-red-900/20 border-2 border-red-200 dark:border-red-800 rounded-xl p-5 sm:p-6">
      <h2 class="text-xl font-bold text-red-900 dark:text-red-300 mb-2 flex items-center gap-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        Danger Zone
      </h2>
      <p class="text-sm text-gray-700 dark:text-gray-300 mb-4">
        Resetting deletes chats, memories, and training permanently. This action cannot be undone.
      </p>

      <button id="deleteTwinBtn"
        class="bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white px-6 py-3 rounded-xl hover:shadow-xl transition-all duration-300 font-semibold min-h-[48px] sm:min-h-[44px] touch-manipulation text-base">
        Reset my twin & clear stored info
      </button>
    </section>
  </div>

  <%- include('footer/footer-conditional-private') %>
  <%- include('partials/modal-helpers') %>

  <!-- Memory Manager Modal (custom UI, uses same visual language) -->
  <div id="memModalBackdrop" class="fixed inset-0 bg-black/50 hidden z-[9999] items-center justify-center overflow-hidden">
    <div id="memModalShell" class="relative bg-white dark:bg-gray-800 rounded-2xl max-w-3xl w-full mx-4 p-4 sm:p-6 shadow-2xl border border-gray-200 dark:border-gray-700 h-[90vh] max-h-[90vh] overflow-hidden flex flex-col">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Manage memories</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300">Add, search, edit, delete, and mark items as Public/Private.</p>
        </div>
        <button id="memModalCloseBtn" type="button"
          class="px-3 py-2 rounded-lg text-sm border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
          Close
        </button>
      </div>

      <!-- Tabs + compact filters + bulk actions -->
      <div class="mt-4 flex flex-col gap-2">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div class="inline-flex flex-wrap rounded-xl bg-gray-100 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 p-1">
            <button id="memTabFact" type="button"
              class="px-3 py-2 text-sm rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white shadow-sm">
              Facts
            </button>
            <button id="memTabPreference" type="button"
              class="px-3 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-200 hover:bg-white/70 dark:hover:bg-gray-800/70">
              Preferences
            </button>
          </div>

          <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200 sm:justify-end">
            <input id="memSelectAll" type="checkbox" class="rounded border-gray-300 dark:border-gray-600" />
            <span>Select all</span>
          </label>
        </div>

        <!-- keep category select hidden for compatibility -->
        <select id="memFilterCategory" class="hidden">
          <option value="fact">Facts</option>
          <option value="preference">Preferences</option>
        </select>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <select id="memFilterVisibility"
            class="px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]">
            <option value="all">All (Private + Public)</option>
            <option value="owner">Private only</option>
            <option value="public_twin">Public only</option>
          </select>

          <input id="memSearchInput" type="text"
            placeholder="Search…"
            class="sm:col-span-2 px-3 py-2 rounded-lg bg-white/80 dark:bg-gray-700/80 border border-gray-200 dark:border-gray-600 text-sm text-gray-900 dark:text-white min-h-[44px]" />
        </div>

        <div id="memBulkBar"
          class="hidden mt-1 p-2 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div class="text-sm text-gray-700 dark:text-gray-200">
            <span id="memSelectedCount" class="font-semibold">0</span> selected
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="memBulkPrivate" type="button"
              class="px-3 py-2 text-sm rounded-lg bg-white/80 dark:bg-gray-800 text-gray-800 dark:text-gray-100 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
              Make Private
            </button>
            <button id="memBulkPublic" type="button"
              class="px-3 py-2 text-sm rounded-lg bg-blue-600 text-white hover:bg-blue-700">
              Make Public
            </button>
            <button id="memBulkDelete" type="button"
              class="px-3 py-2 text-sm rounded-lg bg-red-600 text-white hover:bg-red-700">
              Delete
            </button>
            <button id="memBulkClear" type="button"
              class="px-3 py-2 text-sm rounded-lg bg-white/80 dark:bg-gray-800 text-gray-800 dark:text-gray-100 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
              Clear
            </button>
          </div>
        </div>
      </div>

      <div class="mt-2 flex items-center justify-end">
        <div id="memModalLoading" class="hidden text-sm text-gray-500 dark:text-gray-400">Loading…</div>
      </div>

      <div id="memModalList" class="mt-3 space-y-2 pr-1 overflow-y-auto overscroll-contain flex-1 min-h-0 pb-4"></div>

      <div class="mt-3 p-3 sm:p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 shrink-0">
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <div id="memAddTitle" class="text-sm font-semibold text-gray-900 dark:text-white sm:pr-2 shrink-0">
            Add fact
          </div>

          <input id="memAddCategory" type="hidden" value="fact" />

          <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 px-2 shrink-0">
            <input id="memAddPublic" type="checkbox" class="rounded border-gray-300 dark:border-gray-600" />
            <span>Public</span>
          </label>

          <input id="memAddValue" type="text"
            placeholder="e.g. I like chess"
            class="flex-1 px-3 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-sm text-gray-900 dark:text-white min-h-[44px]" />

          <button id="memAddBtn" type="button"
            class="inline-flex justify-center px-4 py-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors min-h-[44px] items-center text-sm font-medium shrink-0">
            Add
          </button>
        </div>
      </div>

      <div id="memInlineConfirm" class="hidden absolute inset-0 z-[2000000]">
        <div class="absolute inset-0 bg-black/40 rounded-2xl"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4">
          <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-6 sm:p-7 shadow-2xl border border-gray-200 dark:border-gray-700">
            <h3 id="memInlineConfirmTitle" class="text-lg font-semibold text-gray-900 dark:text-white mb-2 pr-2 break-words"></h3>
            <p id="memInlineConfirmMsg" class="text-sm text-gray-600 dark:text-gray-300 mb-5 leading-relaxed break-words"></p>
            <div class="flex justify-end gap-3">
              <button id="memInlineConfirmCancel" type="button"
                class="px-4 py-2 rounded-lg text-sm border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                Cancel
              </button>
              <button id="memInlineConfirmOk" type="button"
                class="px-4 py-2 rounded-lg text-sm bg-red-600 text-white hover:bg-red-700">
                Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ✅ Bio limit constant (must match backend MEMORY_LIMITS.MAX_BIO_CHARS)
    const MAX_BIO_CHARS = 150;
    
    const twinToken = '<%= typeof twinToken !== "undefined" ? twinToken : "" %>';

    let currentSettings = null;
    let currentPersonaData = null;
    let currentStyleVector = null;

    document.addEventListener('DOMContentLoaded', () => {
      (async () => {
        await Promise.all([loadSettings(), loadEditData()]);
        setupUI();
        await loadMemoryPreviewFromLTM();
        initDirtyTracking();
        updateSaveButtonState();

        // ✅ show "Saved" AFTER reload (consistent + reliable)
        const justSaved = sessionStorage.getItem('twinSettings.justSaved');
        if (justSaved) {
          sessionStorage.removeItem('twinSettings.justSaved');
          showNotification('Saved ✔', 'success');
        }
      })().catch(() => {});
    });

    function showNotification(message, type = 'success') {
      // ✅ Ensure we ALWAYS have top-right toasts on Twin Settings (no browser alert)
      window.UI = window.UI || {};
      if (typeof window.UI.showToast !== 'function') {
        window.UI.showToast = function (msg, t = 'success', opts = {}) {
          const duration = typeof opts.duration === 'number' ? opts.duration : 2500;
          const existing = document.getElementById('global-toast');
          if (existing) existing.remove();

          const el = document.createElement('div');
          el.id = 'global-toast';
          el.className =
            'fixed top-4 right-4 max-w-sm w-[92vw] sm:w-auto px-4 py-3 rounded-xl shadow-2xl ' +
            'transition-all duration-200 opacity-0 translate-y-2';
          
          // ✅ force it above sticky header + dropdown
          el.style.zIndex = '2147483647';
          el.style.pointerEvents = 'none';

          const bg =
            t === 'success' ? 'bg-green-600 text-white' :
            t === 'error' ? 'bg-red-600 text-white' :
            'bg-blue-600 text-white';

          el.className += ' ' + bg;
          el.textContent = String(msg || '');

          document.body.appendChild(el);
          requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          });

          setTimeout(() => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(-6px)';
            setTimeout(() => el.remove(), 250);
          }, duration);
        };
      }
      return window.UI.showToast(message, type);
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = String(text ?? '');
      return div.innerHTML;
    }

    async function loadSettings() {
      try {
        const res = await fetch(`/api/twin/${twinToken}/settings`, {
          credentials: 'include',
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' },
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed');
        currentSettings = data.settings;
        populateSettings(currentSettings);
      } catch (e) {
        showNotification('Could not load settings.', 'error');
      }
    }

    async function loadEditData() {
      try {
        const res = await fetch(`/api/twin/${twinToken}/edit-data`, {
          credentials: 'include',
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' },
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed');
        currentPersonaData = data.twin.personaData || {};
        currentStyleVector = data.twin.styleVector || {};
        populateIdentity(currentPersonaData);
        populateVoice(currentStyleVector, currentPersonaData);
        // preview is driven by long-term memories now (facts/preferences)
      } catch (e) {
        showNotification('Could not load twin data.', 'error');
      }
    }

    function populateIdentity(pd) {
      const basic = (pd && pd.basicInfo) ? pd.basicInfo : {};
      document.getElementById('twinName').value = basic.name || basic.fullName || '';
      document.getElementById('twinRole').value = basic.role || '';
      const bioInput = document.getElementById('twinBio');
      if (bioInput) {
        bioInput.value = basic.oneLineBio || basic.bio || '';
        updateBioCharCount(); // Update counter after loading
      }
      document.getElementById('twinLanguage').value = basic.language || '';
      document.getElementById('twinPurpose').value = basic.purpose || ''; // ✅ ADD

      // Rules
      const always = pd?.rules?.always || [];
      const never = pd?.rules?.never || [];
      document.getElementById('alwaysInput').value = Array.isArray(always) ? always.join(', ') : '';
      document.getElementById('neverInput').value = Array.isArray(never) ? never.join(', ') : '';
    }

    function populateVoice(sv, pd) {
      // Get tone from personaData.preferences.toneStyle (onboarding) or styleVector.tone (legacy)
      const toneStyle = pd?.preferences?.toneStyle || sv.tone || 'normal';
      const length = sv.response_length_preference || 'normal';
      const emoji = typeof sv.emoji_usage === 'number' ? sv.emoji_usage : 0.3;
      const qfreq = typeof sv.question_frequency === 'number' ? sv.question_frequency : 0.4;

      // Map toneStyle to tone preset
      document.getElementById('tonePreset').value = toneStyle; // polite/normal/casual
      
      // Map length
      const lengthMap = { 'brief': 'short', 'detailed': 'normal', 'comprehensive': 'detailed' };
      document.getElementById('replyLengthPreset').value = lengthMap[length] || length || 'normal';

      // map emoji usage float -> preset
      document.getElementById('emojiPreset').value =
        emoji <= 0.05 ? 'off' : emoji <= 0.35 ? 'low' : 'medium';

      // Map question_frequency to engagementStyle
      const engagementStyle = pd?.rules?.engagementStyle || (qfreq >= 0.5 ? 'ask_questions' : qfreq <= 0.2 ? 'natural' : 'mix');
      document.getElementById('engagementStyle').value = engagementStyle;
    }

    function populateSettings(s) {
      // Boundaries
      document.getElementById('avoidNSFW').checked = s.safety?.avoidNSFW ?? true;
      document.getElementById('avoidAbuse').checked = s.safety?.avoidAbuse ?? true;
      document.getElementById('avoidPoliticsReligion').checked = s.safety?.avoidPoliticsReligion ?? true;

      // Memory - read from settings.memory.enabled (single source of truth)
      const memoryEnabled = s.memory?.enabled !== false; // Default true
      document.getElementById('memoryEnabled').checked = memoryEnabled;
      document.getElementById('allowPublicUse').checked = s.memory?.allowPublicUse ?? false; // ✅ NEW

      // Advanced adaptation
      document.getElementById('adaptationEnabled').checked = s.adaptation?.enabled ?? true;
      toggleAdaptationSlider(s.adaptation?.enabled ?? true);

      const styleMix = s.adaptation?.styleMix ?? 50;
      document.getElementById('styleMixSlider').value = styleMix;
      document.getElementById('styleMixValue').textContent = String(styleMix);
    }

    function populateMemoryPreviewFromList(mems) {
      const bulletsEl = document.getElementById('memoryBullets');
      if (!bulletsEl) return;

      const safe = Array.isArray(mems) ? mems : [];
      if (!safe.length) {
        bulletsEl.innerHTML = `<li class="text-gray-400 dark:text-gray-500">No memories yet.</li>`;
        return;
      }

      const bullets = safe.slice(0, 5).map(m => {
        const cat = (m.category || 'fact');
        const vis = (m.visibility || 'owner');
        const tag = vis === 'public_twin' ? 'Public' : 'Private';
        return `<li><span class="text-xs text-gray-500 dark:text-gray-400">[${escapeHtml(cat)} • ${escapeHtml(tag)}]</span> ${escapeHtml(m.value || '')}</li>`;
      });

      bulletsEl.innerHTML = bullets.join('');
    }

    async function loadMemoryPreviewFromLTM() {
      try {
        const res = await fetch(`/api/twin/${twinToken}/long-term-memory?limit=5&visibility=all`, {
          credentials: 'include',
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' },
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed');
        populateMemoryPreviewFromList(data.memories || []);
      } catch (e) {
        ErrorLogger.error('Error', e, {});
        // keep UI calm
      }
    }

    function toggleAdaptationSlider(enabled) {
      const container = document.getElementById('adaptationSliderContainer');
      if (container) container.style.display = enabled ? 'block' : 'none';
    }

    function collectSettingsPayload() {
      const memoryEnabled = document.getElementById('memoryEnabled').checked;
      const allowPublicUse = document.getElementById('allowPublicUse').checked;
      
      return {
        replyBehavior: currentSettings?.replyBehavior || { defaultLength: 'normal', riskLevel: 'safe', energy: 'normal' },
        adaptation: {
          enabled: document.getElementById('adaptationEnabled').checked,
          styleMix: parseInt(document.getElementById('styleMixSlider').value || '50', 10),
        },
        safety: {
          avoidNSFW: document.getElementById('avoidNSFW').checked,
          avoidAbuse: document.getElementById('avoidAbuse').checked,
          avoidPoliticsReligion: document.getElementById('avoidPoliticsReligion').checked,
        },
        memory: {
          enabled: memoryEnabled,
          allowPublicContribution: false,
          autoExtractFacts: false,
          allowPublicUse: allowPublicUse, // ✅ NEW
        }
      };
    }

    function collectStylePayload() {
      const tone = document.getElementById('tonePreset').value || 'normal';
      const response_length_preference = document.getElementById('replyLengthPreset').value || 'normal';
      const engagementStyle = document.getElementById('engagementStyle').value || 'mix';

      const emojiPreset = document.getElementById('emojiPreset').value;
      const emoji_usage = emojiPreset === 'off' ? 0.0 : emojiPreset === 'low' ? 0.3 : 0.6;

      // Map engagementStyle to question_frequency
      const question_frequency = engagementStyle === 'ask_questions' ? 0.7 : engagementStyle === 'natural' ? 0.2 : 0.5;

      return {
        tone,
        response_length_preference,
        emoji_usage,
        question_frequency,
        engagementStyle, // ✅ ADD: pass to backend
      };
    }

    function collectPersonaPayload() {
      const name = document.getElementById('twinName').value.trim();
      const role = document.getElementById('twinRole').value;
      const oneLineBio = document.getElementById('twinBio').value.trim();
      const language = document.getElementById('twinLanguage').value;
      const purpose = document.getElementById('twinPurpose').value;
      const alwaysRaw = document.getElementById('alwaysInput').value || '';
      const neverRaw = document.getElementById('neverInput').value || '';

      // ✅ NEW: Get preferences fields that PromptBuilder actually uses
      const toneStyle = document.getElementById('tonePreset')?.value || 'normal';
      const emojiPreset = document.getElementById('emojiPreset')?.value || 'medium';
      const emojiPref = emojiPreset === 'off' ? 'low' : emojiPreset === 'low' ? 'low' : emojiPreset === 'high' ? 'high' : 'medium';
      const replySize = document.getElementById('replyLengthPreset')?.value || 'normal';
      const engagementStyle = document.getElementById('engagementStyle')?.value || 'mix';

      const toArr = (val) =>
        String(val || '')
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

      return {
        basicInfo: {
          name: name || undefined,
          role: role || undefined,
          oneLineBio: oneLineBio, // ✅ MANDATORY: Always send (backend will validate)
          language: language || undefined,
          purpose: purpose || undefined,
        },
        preferences: {
          toneStyle: toneStyle,    // ✅ Used by PromptBuilder
          emojiPref: emojiPref,    // ✅ Used by PromptBuilder
        },
        rules: {
          replySize: replySize,         // ✅ Used by PromptBuilder
          engagementStyle: engagementStyle, // ✅ Used by PromptBuilder
          always: toArr(alwaysRaw) || undefined,
          never: toArr(neverRaw) || undefined,
        }
      };
    }

    // ✅ Helper functions for field error handling
    function clearFieldErrors() {
      const errorFields = ['twinName', 'twinRole', 'twinBio', 'twinLanguage', 'twinPurpose', 'alwaysInput', 'neverInput'];
      errorFields.forEach(fieldId => {
        const fieldEl = document.getElementById(fieldId);
        const errorEl = document.getElementById(`${fieldId}-error`);
        if (fieldEl) {
          fieldEl.classList.remove('border-red-500', 'ring-2', 'ring-red-500/20');
        }
        if (errorEl) {
          errorEl.classList.add('hidden');
          errorEl.textContent = '';
        }
      });
    }

    function getFieldLabel(fieldId) {
      const labels = {
        'twinName': 'Twin name',
        'twinRole': 'Role',
        'twinBio': 'One-line bio',
        'twinLanguage': 'Default language',
        'twinPurpose': 'Purpose',
      };
      return labels[fieldId] || fieldId;
    }

    // ✅ Update bio character counter
    function updateBioCharCount() {
      const bioInput = document.getElementById('twinBio');
      const charCount = document.getElementById('bioCharCount');
      if (bioInput && charCount) {
        const length = bioInput.value.length;
        charCount.textContent = length;
        if (length > MAX_BIO_CHARS) {
          charCount.classList.add('text-red-600', 'dark:text-red-400');
        } else {
          charCount.classList.remove('text-red-600', 'dark:text-red-400');
        }
      }
    }

    async function saveAll() {
      clearFieldErrors(); // Clear previous errors
      const settingsPayload = collectSettingsPayload();
      const stylePayload = collectStylePayload();
      const personaPayload = collectPersonaPayload();

      const readJson = async (res) => {
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.success) {
          // ✅ Parse validation errors with field details
          if (data?.details && Array.isArray(data.details)) {
            const validationError = new Error(data?.error || 'Validation failed');
            validationError.validationDetails = data.details;
            throw validationError;
          }
          throw new Error(data?.error || data?.message || `Request failed (${res.status})`);
        }
        return data;
      };

      // ✅ IMPORTANT: SEQUENTIAL saves to avoid personaData overwrite race
      const settingsData = await readJson(
        await fetch(`/api/twin/${twinToken}/settings`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
          credentials: 'include',
          body: JSON.stringify(settingsPayload),
        })
      );

      const personaData = await readJson(
        await fetch(`/api/twin/${twinToken}/update-persona`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
          credentials: 'include',
          body: JSON.stringify({ personaData: personaPayload }),
        })
      );

      // ✅ MVP: style is legacy; don’t block saving if it fails
      try {
        await readJson(
          await fetch(`/api/twin/${twinToken}/update-style`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
            credentials: 'include',
            body: JSON.stringify(stylePayload),
          })
        );
      } catch (e) {
        ErrorLogger.warn('[twin-settings] update-style failed (ignored for MVP)', { error: e });
      }

      // Force refresh from server to avoid cached values
      await Promise.all([loadSettings(), loadEditData()]);
      await loadMemoryPreviewFromLTM();

      return { settingsData, personaData };
    }

    async function previewStyle() {
      try {
        const payload = collectStylePayload();
        const res = await fetch(`/api/twin/${twinToken}/style-preview`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
          credentials: 'include',
          body: JSON.stringify({
            styleChanges: payload,
            testMessage: 'Friend says: "Bro are we still meeting tomorrow?"'
          }),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Preview failed');

        document.getElementById('stylePreviewSection').classList.remove('hidden');
        document.getElementById('stylePreviewOriginal').textContent = data.originalResponse || '';
        document.getElementById('stylePreviewNew').textContent = data.newResponse || '';
      } catch (e) {
        ErrorLogger.error('Error', e, {});
        showNotification('Preview failed', 'error');
      }
    }

    async function saveToLongTermMemory(value, category) {
      const v = String(value || '').trim();
      if (!v) return showNotification('Write something first.', 'info');

      const res = await fetch(`/api/twin/${twinToken}/long-term-memory`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        credentials: 'include',
        body: JSON.stringify({ value: v, category }),
      });

      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed');
      return data.memory;
    }

    function memInlineConfirm({ title, message, okLabel = 'Delete' }) {
      return new Promise((resolve) => {
        const root = document.getElementById('memInlineConfirm');
        const t = document.getElementById('memInlineConfirmTitle');
        const m = document.getElementById('memInlineConfirmMsg');
        const btnOk = document.getElementById('memInlineConfirmOk');
        const btnCancel = document.getElementById('memInlineConfirmCancel');

        if (!root || !t || !m || !btnOk || !btnCancel) return resolve(false);

        t.textContent = title || '';
        m.textContent = message || '';
        btnOk.textContent = okLabel;

        const cleanup = () => {
          root.classList.add('hidden');
          btnOk.onclick = null;
          btnCancel.onclick = null;
        };

        btnOk.onclick = () => { cleanup(); resolve(true); };
        btnCancel.onclick = () => { cleanup(); resolve(false); };

        root.classList.remove('hidden');
      });
    }

    // --- Memory UI state (tabs + bulk actions) ---
    let memActiveTab = 'fact'; // 'fact' | 'preference'
    let memSelectedKeys = new Set();
    let memSearchByTab = { fact: '', preference: '' };
    let memVisibilityByTab = { fact: 'all', preference: 'all' };

    const escAttr = (v) => {
      if (window.CSS && typeof CSS.escape === 'function') return CSS.escape(String(v));
      return String(v).replace(/"/g, '\\"');
    };

    function setMemTab(tab) {
      // Save current tab inputs
      const searchEl = document.getElementById('memSearchInput');
      const visEl = document.getElementById('memFilterVisibility');
      if (searchEl) memSearchByTab[memActiveTab] = searchEl.value || '';
      if (visEl) memVisibilityByTab[memActiveTab] = visEl.value || 'all';

      // Switch tab
      memActiveTab = tab === 'preference' ? 'preference' : 'fact';

      const catSel = document.getElementById('memFilterCategory');
      if (catSel) catSel.value = memActiveTab;

      // Restore per-tab inputs
      if (searchEl) searchEl.value = memSearchByTab[memActiveTab] || '';
      if (visEl) visEl.value = memVisibilityByTab[memActiveTab] || 'all';

      // Lock add-memory to current tab
      const addCat = document.getElementById('memAddCategory');
      if (addCat) addCat.value = memActiveTab;

      const addTitle = document.getElementById('memAddTitle');
      if (addTitle) addTitle.textContent = memActiveTab === 'fact' ? 'Add fact' : 'Add preference';

      const addValue = document.getElementById('memAddValue');
      if (addValue) addValue.placeholder = memActiveTab === 'fact'
        ? 'e.g. I like chess'
        : 'e.g. I prefer short replies';

      clearMemSelection();
      updateMemTabUI();
      loadMemoryModalList();
    }

    function updateMemTabUI() {
      const factBtn = document.getElementById('memTabFact');
      const prefBtn = document.getElementById('memTabPreference');

      const active =
        'px-3 py-2 text-sm rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white shadow-sm';
      const inactive =
        'px-3 py-2 text-sm rounded-lg text-gray-700 dark:text-gray-200 hover:bg-white/70 dark:hover:bg-gray-800/70';

      if (factBtn) factBtn.className = (memActiveTab === 'fact') ? active : inactive;
      if (prefBtn) prefBtn.className = (memActiveTab === 'preference') ? active : inactive;
    }

    function updateBulkUI() {
      const bar = document.getElementById('memBulkBar');
      const countEl = document.getElementById('memSelectedCount');
      const selectAll = document.getElementById('memSelectAll');

      const count = memSelectedKeys.size;
      if (countEl) countEl.textContent = String(count);
      if (bar) bar.classList.toggle('hidden', count === 0);

      if (selectAll) {
        const boxes = Array.from(document.querySelectorAll('#memModalList .memSelect'));
        const allChecked = boxes.length > 0 && boxes.every(b => b.checked);
        selectAll.checked = allChecked;
        selectAll.indeterminate = count > 0 && !allChecked;
      }
    }

    function clearMemSelection() {
      memSelectedKeys.clear();
      document.querySelectorAll('#memModalList .memSelect').forEach(cb => { cb.checked = false; });
      updateBulkUI();
    }

    function anySelectedRowDirty() {
      for (const k of memSelectedKeys) {
        const row = document.querySelector(`#memModalList [data-mem-key="${escAttr(k)}"]`);
        const saveBtn = row?.querySelector('.memSaveIcon');
        if (saveBtn && saveBtn.disabled === false) return true; // save enabled => dirty
      }
      return false;
    }

    function renderMemoryModalList(mems) {
      const list = document.getElementById('memModalList');
      if (!list) return;

      // Reset UI but keep selection keys if same list is re-rendered
      list.innerHTML = '';

      const safe = Array.isArray(mems) ? mems : [];
      if (!safe.length) {
        list.innerHTML = `<div class="text-sm text-gray-500 dark:text-gray-400">No memories yet.</div>`;
        clearMemSelection();
        return;
      }

      safe.forEach((m) => {
        const key = m.key || m.id;
        if (!key) return;

        const value = m.value || m.text || '';
        const category = m.category || 'fact';
        const visibility = m.visibility || 'owner';

        const row = document.createElement('div');
        row.dataset.memKey = String(key);
        row.dataset.memCategory = String(category);
        row.className =
          'p-1.5 rounded-lg bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700';

        // Compact row UI (icons + single-line edit)
        row.innerHTML = `
          <div class="flex items-stretch gap-2">
            <div class="pt-1">
              <input type="checkbox" class="memSelect rounded border-gray-300 dark:border-gray-600" />
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-0.5">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="memVisibilityBadge text-[11px] px-2 py-0.5 rounded-full border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300">
                    ${visibility === 'public_twin' ? 'Public' : 'Private'}
                  </span>
                </div>

                <!-- Right controls: Public toggle + Save + Delete (one row) -->
                <div class="flex items-center gap-2 shrink-0">
                  <label class="inline-flex items-center gap-2 text-xs text-gray-600 dark:text-gray-300 cursor-pointer select-none">
                    <input type="checkbox" class="memPublic rounded border-gray-300 dark:border-gray-600"
                      ${visibility === 'public_twin' ? 'checked' : ''} />
                    <span>Public</span>
                  </label>

                  <button type="button"
                    class="memSaveIcon p-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700"
                    title="Save"
                    aria-label="Save"
                    disabled
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 13l4 4L19 7" />
                    </svg>
                  </button>

                  <button type="button"
                    class="memDelIcon p-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700"
                    title="Delete"
                    aria-label="Delete"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0V5a2 2 0 012-2h4a2 2 0 012 2v2" />
                    </svg>
                  </button>
                </div>
              </div>

              <textarea
                class="memEdit w-full text-sm bg-transparent border border-gray-200 dark:border-gray-700 rounded-lg px-2 py-1 text-gray-900 dark:text-white resize-none leading-tight"
                rows="1"
              >${escapeHtml(value)}</textarea>
            </div>
          </div>
        `;

        const getVisibility = () => (row.querySelector('.memPublic')?.checked ? 'public_twin' : 'owner');
        const editEl = row.querySelector('.memEdit');
        const selectEl = row.querySelector('.memSelect');
        const saveBtn = row.querySelector('.memSaveIcon');
        const delBtn = row.querySelector('.memDelIcon');
        const badgeEl = row.querySelector('.memVisibilityBadge'); // Badge showing Public/Private

        // Expand textarea on focus to avoid clutter but allow editing
        editEl?.addEventListener('focus', () => { editEl.rows = 3; });
        editEl?.addEventListener('blur', () => { editEl.rows = 1; });

        // Dirty tracking (save only)
        let originalValue = String(value || '');
        let originalVisibility = visibility === 'public_twin' ? 'public_twin' : 'owner';

        const updateRowDirtyUI = () => {
          const currentValue = String(editEl?.value || '');
          const currentVisibility = getVisibility();
          const dirty =
            currentValue.trim() !== originalValue.trim() ||
            currentVisibility !== originalVisibility;

          if (saveBtn) {
            saveBtn.disabled = !dirty;
            saveBtn.className = dirty
              ? 'memSaveIcon p-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700'
              : 'memSaveIcon p-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700';
          }
        };

        // ✅ Update badge to reflect current visibility state
        const updateBadge = () => {
          if (badgeEl) {
            const currentVisibility = getVisibility();
            badgeEl.textContent = currentVisibility === 'public_twin' ? 'Public' : 'Private';
          }
        };

        updateRowDirtyUI();

        // Selection
        if (selectEl) {
          selectEl.checked = memSelectedKeys.has(String(key));
          selectEl.addEventListener('change', () => {
            if (selectEl.checked) memSelectedKeys.add(String(key));
            else memSelectedKeys.delete(String(key));
            updateBulkUI();
          });
        }

        // Only mark dirty; no auto-save
        row.querySelector('.memPublic')?.addEventListener('change', updateRowDirtyUI);
        editEl?.addEventListener('input', updateRowDirtyUI);

        // Save
        saveBtn?.addEventListener('click', async () => {
          try {
            const newVal = String(editEl?.value || '');
            const currentVisibility = getVisibility();

            const res = await fetch(`/api/twin/${twinToken}/long-term-memory/${encodeURIComponent(key)}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
              credentials: 'include',
              body: JSON.stringify({ value: newVal, category, visibility: currentVisibility }),
            });

            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed');

            originalValue = newVal;
            originalVisibility = currentVisibility;
            updateRowDirtyUI();
            updateBadge(); // ✅ Update badge immediately after successful save

            showNotification('Saved ✔', 'success');
            await loadMemoryPreviewFromLTM();
          } catch (e) {
            ErrorLogger.error('Error', e, {});
            showNotification('Save failed', 'error');
          }
        });

        // Delete (single)
        delBtn?.addEventListener('click', async () => {
          const ok = await memInlineConfirm({
            title: 'Delete memory',
            message: 'Delete this memory permanently?',
            okLabel: 'Delete',
          });
          if (!ok) return;

          try {
            const res = await fetch(`/api/twin/${twinToken}/long-term-memory/${encodeURIComponent(key)}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': window.csrfToken },
              credentials: 'include',
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed');

            memSelectedKeys.delete(String(key));
            showNotification('Deleted ✔', 'success');
            await loadMemoryModalList();
            await loadMemoryPreviewFromLTM();
          } catch (e) {
            ErrorLogger.error('Error', e, {});
            showNotification('Delete failed', 'error');
          }
        });

        list.appendChild(row);
      });

      updateBulkUI();
    }

    async function loadMemoryModalList() {
      const loading = document.getElementById('memModalLoading');
      if (loading) loading.classList.remove('hidden');

      try {
        const vis = (document.getElementById('memFilterVisibility')?.value || 'all').trim();
        const q = (document.getElementById('memSearchInput')?.value || '').trim();

        const params = new URLSearchParams();
        params.set('limit', '50');
        params.set('visibility', vis || 'all');

        // ✅ Always request current tab category (facts vs preferences)
        params.set('category', memActiveTab);

        const res = await fetch(`/api/twin/${twinToken}/long-term-memory?${params.toString()}`, {
          credentials: 'include',
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' },
        });

        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed');

        // ✅ client-side search so category separation is always respected
        const qNorm = String(q || '').trim().toLowerCase();
        const list = Array.isArray(data.memories) ? data.memories : [];
        const filtered = qNorm
          ? list.filter(m => String(m?.value || m?.text || '').toLowerCase().includes(qNorm))
          : list;

        renderMemoryModalList(filtered);
      } catch (e) {
        ErrorLogger.error('Error', e, {});
        showNotification('Could not load memories', 'error');
        clearMemSelection();
      } finally {
        if (loading) loading.classList.add('hidden');
      }
    }

    let __memPrevOverflow = null;

    function lockPageScroll() {
      if (__memPrevOverflow) return;
      __memPrevOverflow = {
        html: document.documentElement.style.overflow,
        body: document.body.style.overflow,
      };
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function unlockPageScroll() {
      if (!__memPrevOverflow) return;
      document.documentElement.style.overflow = __memPrevOverflow.html || '';
      document.body.style.overflow = __memPrevOverflow.body || '';
      __memPrevOverflow = null;
    }

    function openMemoryModal() {
      const backdrop = document.getElementById('memModalBackdrop');
      if (!backdrop) return;

      lockPageScroll(); // ✅ stops main page scroll

      backdrop.classList.remove('hidden');
      backdrop.classList.add('flex');
      setMemTab('fact');
    }

    function closeMemoryModal() {
      const backdrop = document.getElementById('memModalBackdrop');
      if (!backdrop) return;

      backdrop.classList.add('hidden');
      backdrop.classList.remove('flex');

      unlockPageScroll(); // ✅ restore normal scroll
    }

    async function addMemoryFromModal() {
      const cat = memActiveTab; // ✅ always locked to current tab
      const value = (document.getElementById('memAddValue')?.value || '').trim();
      const isPublic = document.getElementById('memAddPublic')?.checked === true;
      const visibility = isPublic ? 'public_twin' : 'owner';
      if (!value) return showNotification('Write memory text first.', 'info');

      try {
        const res = await fetch(`/api/twin/${twinToken}/long-term-memory`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
          credentials: 'include',
          body: JSON.stringify({ value, category: cat, visibility }),
        });
        const data = await res.json();
        
        if (!res.ok || !data.success) {
          // ✅ NEW: Handle memory limit errors
          if (data.errorCode === 'MEMORY_LIMIT_EXCEEDED') {
            showNotification(data.message || `Maximum ${data.maxLimit} ${cat}s allowed. Please delete some first.`, 'error');
          } else if (data.errorCode === 'RATE_LIMIT_EXCEEDED') {
            showNotification(data.error || 'Too many requests. Please try again later.', 'error');
          } else {
            showNotification(data.error || 'Failed to add memory', 'error');
          }
          return;
        }
        
        document.getElementById('memAddValue').value = '';
        document.getElementById('memAddPublic').checked = false;
        showNotification('Memory added ✔', 'success');
        await loadMemoryModalList();
        await loadMemoryPreviewFromLTM();
      } catch (e) {
        ErrorLogger.error('Error', e, {});
        showNotification('Add failed', 'error');
      }
    }

    function setupUI() {
      // ✅ Bio character counter with input prevention (max MAX_BIO_CHARS)
      const bioInput = document.getElementById('twinBio');
      if (bioInput) {
        let bioPrevValue = bioInput.value;
        updateBioCharCount(); // Initial count
        bioInput.addEventListener('input', (e) => {
          if (bioInput.value.length > MAX_BIO_CHARS) {
            bioInput.value = bioPrevValue;
            return;
          }
          bioPrevValue = bioInput.value;
          updateBioCharCount();
          // Clear error on input
          const errorEl = document.getElementById('twinBio-error');
          if (errorEl) {
            errorEl.classList.add('hidden');
          }
          bioInput.classList.remove('border-red-500', 'ring-2', 'ring-red-500/20');
        });
      }
      
      // ✅ Always/Never character counters with input prevention (max 120 per item, comma-separated)
      const alwaysInput = document.getElementById('alwaysInput');
      const alwaysCharCount = document.getElementById('alwaysInputCharCount');
      if (alwaysInput && alwaysCharCount) {
        let alwaysPrevValue = alwaysInput.value;
        const updateAlwaysCount = () => {
          const items = alwaysInput.value.split(',').map(s => s.trim()).filter(Boolean);
          const longestItem = items.length > 0 ? Math.max(...items.map(item => item.length)) : 0;
          alwaysCharCount.textContent = longestItem;
          if (longestItem > 120) {
            alwaysCharCount.classList.add('text-red-600', 'dark:text-red-400');
          } else {
            alwaysCharCount.classList.remove('text-red-600', 'dark:text-red-400');
          }
        };
        
        alwaysInput.addEventListener('input', (e) => {
          const items = alwaysInput.value.split(',').map(s => s.trim()).filter(Boolean);
          const exceedsLimit = items.some(item => item.length > 120);
          if (exceedsLimit) {
            alwaysInput.value = alwaysPrevValue;
            return;
          }
          alwaysPrevValue = alwaysInput.value;
          updateAlwaysCount();
        });
        updateAlwaysCount(); // Initial count
      }
      
      const neverInput = document.getElementById('neverInput');
      const neverCharCount = document.getElementById('neverInputCharCount');
      if (neverInput && neverCharCount) {
        let neverPrevValue = neverInput.value;
        const updateNeverCount = () => {
          const items = neverInput.value.split(',').map(s => s.trim()).filter(Boolean);
          const longestItem = items.length > 0 ? Math.max(...items.map(item => item.length)) : 0;
          neverCharCount.textContent = longestItem;
          if (longestItem > 120) {
            neverCharCount.classList.add('text-red-600', 'dark:text-red-400');
          } else {
            neverCharCount.classList.remove('text-red-600', 'dark:text-red-400');
          }
        };
        
        neverInput.addEventListener('input', (e) => {
          const items = neverInput.value.split(',').map(s => s.trim()).filter(Boolean);
          const exceedsLimit = items.some(item => item.length > 120);
          if (exceedsLimit) {
            neverInput.value = neverPrevValue;
            return;
          }
          neverPrevValue = neverInput.value;
          updateNeverCount();
        });
        updateNeverCount(); // Initial count
      }
      
      // ✅ Clear errors on input for all fields
      ['twinName', 'twinRole', 'twinLanguage', 'twinPurpose'].forEach(fieldId => {
        const fieldEl = document.getElementById(fieldId);
        if (fieldEl) {
          fieldEl.addEventListener('input', () => {
            const errorEl = document.getElementById(`${fieldId}-error`);
            if (errorEl) {
              errorEl.classList.add('hidden');
            }
            fieldEl.classList.remove('border-red-500', 'ring-2', 'ring-red-500/20');
          });
          fieldEl.addEventListener('change', () => {
            const errorEl = document.getElementById(`${fieldId}-error`);
            if (errorEl) {
              errorEl.classList.add('hidden');
            }
            fieldEl.classList.remove('border-red-500', 'ring-2', 'ring-red-500/20');
          });
        }
      });
      // Adaptation toggle
      document.getElementById('adaptationEnabled')?.addEventListener('change', (e) => {
        toggleAdaptationSlider(e.target.checked);
      });

      // style mix
      document.getElementById('styleMixSlider')?.addEventListener('input', (e) => {
        document.getElementById('styleMixValue').textContent = e.target.value;
      });

      // preview
      document.getElementById('previewStyleBtn')?.addEventListener('click', (e) => {
        e.preventDefault();
        showNotification('Preview is disabled in MVP (style preview coming later).', 'info');
      });

      // save
      document.getElementById('twinSettingsSave')?.addEventListener('click', async (e) => {
        e.preventDefault();

        const btn = document.getElementById('twinSettingsSave');
        const oldText = btn?.textContent;

        try {
          if (btn) {
            btn.disabled = true;
            btn.textContent = 'Saving…';
          }

          await saveAll();

          // ✅ set flag so toast shows after reload
          sessionStorage.setItem('twinSettings.justSaved', '1');
          window.location.reload();
        } catch (err) {
          ErrorLogger.error('Error', err, {});
          
          // ✅ Show field-specific validation errors
          if (err?.validationDetails && Array.isArray(err.validationDetails)) {
            clearFieldErrors();
            let errorMessages = [];
            
            err.validationDetails.forEach((detail) => {
              const fieldName = detail.field || '';
              const message = detail.message || 'Invalid value';
              
              // Map backend field names to frontend IDs
              const fieldIdMap = {
                'basicInfo.oneLineBio': 'twinBio',
                'basicInfo.name': 'twinName',
                'basicInfo.role': 'twinRole',
                'basicInfo.language': 'twinLanguage',
                'basicInfo.purpose': 'twinPurpose',
                'rules.always': 'alwaysInput',
                'rules.never': 'neverInput',
              };
              
              const fieldId = fieldIdMap[fieldName] || fieldName.split('.').pop();
              const fieldEl = document.getElementById(fieldId);
              const errorEl = document.getElementById(`${fieldId}-error`);
              
              if (fieldEl && errorEl) {
                fieldEl.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                errorEl.textContent = message;
                errorEl.classList.remove('hidden');
                errorMessages.push(`${getFieldLabel(fieldId)}: ${message}`);
              } else {
                errorMessages.push(message);
              }
            });
            
            // Show summary notification
            if (errorMessages.length > 0) {
              showNotification(`Please fix the following errors:\n${errorMessages.join('\n')}`, 'error');
            } else {
              showNotification('Validation failed. Please check the form fields.', 'error');
            }
          } else if (err?.errorCode === 'MEMORY_LIMIT_EXCEEDED') {
            // ✅ NEW: Special handling for memory limit errors
            showNotification(err.message || 'Memory limit exceeded. Please delete some existing items first.', 'error');
          } else if (err?.errorCode === 'RATE_LIMIT_EXCEEDED') {
            // ✅ NEW: Special handling for rate limit errors
            showNotification(err.message || 'Too many requests. Please try again later.', 'error');
          } else {
            showNotification(`Save failed: ${err?.message || 'Unknown error'}`, 'error');
          }
          
          if (btn) btn.disabled = false;
        } finally {
          if (btn && !btn.disabled) btn.textContent = oldText || 'Save settings';
          updateSaveButtonState();
        }
      });

      // delete/reset (keep your existing confirm flow if you want)
      document.getElementById('deleteTwinBtn')?.addEventListener('click', async (e) => {
        e.preventDefault();
        const ok = await window.ModalHelpers?.confirm?.({
          title: '⚠️ Delete twin permanently',
          message: 'This will permanently delete your twin and ALL data. This cannot be undone.',
          confirmLabel: 'Continue',
          cancelLabel: 'Cancel',
          type: 'danger'
        });
        if (!ok) return;

        const typed = await window.ModalHelpers?.input?.({
          title: 'Final confirmation',
          message: 'Type DELETE to permanently delete your twin.',
          placeholder: 'DELETE',
          defaultValue: ''
        });

        if (String(typed || '').trim() !== 'DELETE') {
          showNotification('Cancelled (you did not type DELETE).', 'info');
          return;
        }

        // Get button element to manage state
        const deleteBtn = document.getElementById('deleteTwinBtn');
        const originalText = deleteBtn?.textContent || '';
        if (deleteBtn) {
          deleteBtn.disabled = true;
          deleteBtn.textContent = 'Deleting...';
        }

        try {
          const res = await fetch(`/api/twin/${twinToken}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
            credentials: 'include',
          });
          
          // ✅ Handle 429 rate limit errors properly
          if (res.status === 429) {
            const result = await res.json().catch(() => ({ error: 'Rate limit exceeded', errorCode: 'RATE_LIMIT_EXCEEDED' }));
            showNotification(result.error || 'Too many twin deletion attempts. Please try again later.', 'error');
            if (deleteBtn) {
              deleteBtn.disabled = false;
              deleteBtn.textContent = originalText;
            }
            return;
          }
          
          const data = await res.json();
          
          if (res.ok && data.success) {
            // ✅ FIX: Clear onboarding localStorage before redirect
            try {
              localStorage.removeItem('enhancedOnboarding_v1');
            } catch (e) {
              ErrorLogger.warn('Failed to clear onboarding localStorage', { error: e });
            }
            showNotification('Twin reset. Redirecting…', 'success');
            setTimeout(() => window.location.replace('/onboarding'), 800);
          } else {
            // ✅ Handle rate limit errors from response body
            if (data.errorCode === 'RATE_LIMIT_EXCEEDED') {
              showNotification(data.error || 'Too many twin deletion attempts. Please try again later.', 'error');
            } else {
              throw new Error(data.error || 'Failed');
            }
            if (deleteBtn) {
              deleteBtn.disabled = false;
              deleteBtn.textContent = originalText;
            }
          }
        } catch (err) {
          ErrorLogger.error('Error', err, {});
          // ✅ Handle JSON parsing errors (e.g., if response is not JSON)
          if (err.message && err.message.includes('JSON')) {
            showNotification('Rate limit exceeded. Please try again later.', 'error');
          } else {
            showNotification('Reset failed', 'error');
          }
          if (deleteBtn) {
            deleteBtn.disabled = false;
            deleteBtn.textContent = originalText;
          }
        }
      });

      // Memory modal
      document.getElementById('openMemoryManagerBtn')?.addEventListener('click', (e) => {
        e.preventDefault();
        openMemoryModal();
      });
      document.getElementById('memModalCloseBtn')?.addEventListener('click', (e) => {
        e.preventDefault();
        closeMemoryModal();
      });
      document.getElementById('memModalBackdrop')?.addEventListener('click', (e) => {
        if (e.target?.id === 'memModalBackdrop') closeMemoryModal();
      });

      // Tabs
      document.getElementById('memTabFact')?.addEventListener('click', (e) => {
        e.preventDefault();
        setMemTab('fact');
      });
      document.getElementById('memTabPreference')?.addEventListener('click', (e) => {
        e.preventDefault();
        setMemTab('preference');
      });

      // Visibility filter
      document.getElementById('memFilterVisibility')?.addEventListener('change', () => loadMemoryModalList());

      // Select all (current list only)
      document.getElementById('memSelectAll')?.addEventListener('change', (e) => {
        const checked = e.target.checked === true;
        document.querySelectorAll('#memModalList .memSelect').forEach(cb => {
          cb.checked = checked;
          const row = cb.closest('[data-mem-key]');
          const k = row?.getAttribute('data-mem-key');
          if (!k) return;
          if (checked) memSelectedKeys.add(k);
          else memSelectedKeys.delete(k);
        });
        updateBulkUI();
      });

      // Bulk clear
      document.getElementById('memBulkClear')?.addEventListener('click', (e) => {
        e.preventDefault();
        clearMemSelection();
      });

      // Bulk public/private helpers
      async function bulkSetVisibility(targetVisibility) {
        const keys = Array.from(memSelectedKeys);
        if (!keys.length) return showNotification('Select memories first.', 'info');

        if (anySelectedRowDirty()) {
          return showNotification('Save pending edits first.', 'info');
        }

        try {
          await Promise.all(keys.map(async (k) => {
            const row = document.querySelector(`#memModalList [data-mem-key="${escAttr(k)}"]`);
            const cat = row?.getAttribute('data-mem-category') || memActiveTab;
            const val = row?.querySelector('.memEdit')?.value || '';

            const res = await fetch(`/api/twin/${twinToken}/long-term-memory/${encodeURIComponent(k)}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.csrfToken },
              credentials: 'include',
              body: JSON.stringify({ value: val, category: cat, visibility: targetVisibility }),
            });

            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed');
          }));

          showNotification(targetVisibility === 'public_twin' ? 'Made Public ✔' : 'Made Private ✔', 'success');
          clearMemSelection();
          await loadMemoryModalList();
          await loadMemoryPreviewFromLTM();
        } catch (err) {
          ErrorLogger.error('Error', err, {});
          showNotification('Bulk update failed', 'error');
        }
      }

      document.getElementById('memBulkPublic')?.addEventListener('click', (e) => {
        e.preventDefault();
        bulkSetVisibility('public_twin');
      });
      document.getElementById('memBulkPrivate')?.addEventListener('click', (e) => {
        e.preventDefault();
        bulkSetVisibility('owner');
      });

      // Bulk delete
      document.getElementById('memBulkDelete')?.addEventListener('click', async (e) => {
        e.preventDefault();
        const keys = Array.from(memSelectedKeys);
        if (!keys.length) return showNotification('Select memories first.', 'info');

        if (anySelectedRowDirty()) {
          return showNotification('Save pending edits first.', 'info');
        }

        const ok = await memInlineConfirm({
          title: 'Delete memories',
          message: `Delete ${keys.length} selected memories permanently?`,
          okLabel: 'Delete',
        });
        if (!ok) return;

        try {
          await Promise.all(keys.map(async (k) => {
            const res = await fetch(`/api/twin/${twinToken}/long-term-memory/${encodeURIComponent(k)}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': window.csrfToken },
              credentials: 'include',
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed');
          }));

          showNotification('Deleted ✔', 'success');
          clearMemSelection();
          await loadMemoryModalList();
          await loadMemoryPreviewFromLTM();
        } catch (err) {
          ErrorLogger.error('Error', err, {});
          showNotification('Bulk delete failed', 'error');
        }
      });

      // Default tab UI
      updateMemTabUI();

      document.getElementById('memSearchInput')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') loadMemoryModalList();
      });
      document.getElementById('memAddBtn')?.addEventListener('click', (e) => {
        e.preventDefault();
        addMemoryFromModal();
      });
      document.getElementById('refreshMemoryPreviewBtn')?.addEventListener('click', (e) => {
        e.preventDefault();
        loadMemoryPreviewFromLTM();
      });
    }

    // --- Dirty Save Button ---
    let initialSnapshot = '';

    function takeSnapshot() {
      return JSON.stringify({
        persona: collectPersonaPayload(),
        style: collectStylePayload(),
        settings: collectSettingsPayload(),
      });
    }

    function updateSaveButtonState() {
      const btn = document.getElementById('twinSettingsSave');
      if (!btn) return;
      const dirty = takeSnapshot() !== initialSnapshot;
      btn.disabled = !dirty;
      btn.className = dirty
        ? 'w-full sm:w-auto px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-medium shadow-md min-h-[44px]'
        : 'w-full sm:w-auto px-6 py-3 bg-gray-300 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl cursor-not-allowed font-medium shadow-md min-h-[44px]';
    }

    function initDirtyTracking() {
      initialSnapshot = takeSnapshot();
      document.querySelectorAll('input,textarea,select').forEach(el => {
        el.addEventListener('input', updateSaveButtonState);
        el.addEventListener('change', updateSaveButtonState);
      });
    }
  </script>
</body>
</html>