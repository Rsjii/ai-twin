<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= typeof title !== 'undefined' ? title : 'Your Chat History - Selflyx' %></title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/utils/timeUtils.js"></script>
    <script>
        // Immediate theme application to prevent FOUC
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.classList.toggle('dark', theme === 'dark');
        })();
    </script>
    <style>
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 min-h-screen font-inter">
    <!--Header-->
    <%- include('header') %>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8 py-6 sm:py-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Your Chat History</h1>
                    <p class="text-gray-600 dark:text-gray-300">All the twins you've chatted with</p>
                </div>
                <div class="flex gap-3">
                    <a href="/discover" class="hidden md:flex items-center gap-2 px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl border border-white/20 dark:border-gray-700 hover:shadow-lg transition-all">
                        <span>🔍</span>
                        <span class="font-medium text-gray-700 dark:text-gray-300">Discover More</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl p-6 border border-white/20 dark:border-gray-700 shadow-lg mb-6 sm:mb-8" id="statsCards">
            <!-- Stats will be populated by JS -->
        </div>        

                <!-- Quick Filters Row (mobile-friendly, Amazon-style) -->
                <div class="flex items-center gap-2 mb-3 sm:mb-4">
                    <!-- Left: Filters button to open full filter screen -->
                    <button
                        id="openFiltersSheetBtn"
                        class="flex-shrink-0 inline-flex items-center justify-center px-3 py-2 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-xs sm:text-sm text-gray-700 dark:text-gray-200 shadow-sm touch-manipulation"
                        type="button"
                    >
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 4h18M4 8h16M5 12h14M6 16h12M7 20h10"></path>
                        </svg>
                        <span>Filters</span>
                    </button>
        
                    <!-- Right: horizontal scrollable filter chips -->
                    <div class="flex-1 overflow-x-auto scrollbar-hide">
                        <div id="filterChipsRow" class="flex flex-row gap-2">
                            <!-- Time filters -->
                            <button
                                class="filter-chip active flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-primary/40 bg-primary/10 text-primary dark:border-primary/40 dark:bg-primary/20 dark:text-primary whitespace-nowrap touch-manipulation"
                                data-filter-type="time" data-filter-value="all">
                                All time
                            </button>
                            <button
                                class="filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                                data-filter-type="time" data-filter-value="today">
                                Today
                            </button>
                            <button
                                class="filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                                data-filter-type="time" data-filter-value="7">
                                Last 7 days
                            </button>
                            <button
                                class="filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                                data-filter-type="time" data-filter-value="30">
                                Last 30 days
                            </button>
        
                            <!-- Sort filters -->
                            <button
                                class="filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                                data-filter-type="sort" data-filter-value="messages">
                                Most messages
                            </button>
                            <button
                                class="filter-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 whitespace-nowrap touch-manipulation"
                                data-filter-type="sort" data-filter-value="chats">
                                Most chats
                            </button>
                        </div>
                    </div>
                </div>

        <!-- Loading State -->
        <div id="loadingState" class="hidden">
            <%- include('components/loading-skeleton', { type: 'twin-card', count: 8 }) %>
        </div>        

        <!-- Empty State (hidden by default) -->
        <div id="emptyState" class="hidden text-center py-16">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl p-6 sm:p-8 lg:p-12 border border-white/20 dark:border-gray-700 shadow-xl max-w-md mx-auto">
                <div class="w-20 h-20 bg-gradient-to-r from-primary/20 to-accent/20 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-primary dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">No Chats Yet</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-6">Start exploring twins and begin conversations to see them here!</p>
                <a href="/discover" class="inline-flex items-center gap-2 px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-medium min-h-[44px] touch-manipulation text-base" aria-label="Discover Twins">
                    <span>🔍</span>
                    <span>Discover Twins</span>
                </a>
            </div>
        </div>

                <!-- Error State -->
                <div id="errorState" class="hidden">
                    <%- include('components/error-state', { 
                        title: 'Failed to load chat history',
                        message: 'We encountered an error while loading your chats. Please try again.'
                    }) %>
                </div>

        <!-- Twin Cards Grid -->
        <div id="twinsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6 hidden">
            <!-- Twin cards will be populated here by JS -->
        </div>
    </div>

    <script>
        // Set CSRF token from server
        window.csrfToken = '<%= csrfToken || "" %>';

        // Global filter state
        let allChatsData = [];
        let activeTimeFilter = 'all';      // 'all' | 'today' | '7' | '30'
               let activeSortFilter = null;       // null | 'messages' | 'chats'

        // Load chat history on page load
        async function loadChatHistory() {
            const loadingState = document.getElementById('loadingState');
            const emptyState = document.getElementById('emptyState');
            const twinsGrid = document.getElementById('twinsGrid');
            const statsCards = document.getElementById('statsCards');

            try {
                // Show loading
                loadingState.classList.remove('hidden');
                emptyState.classList.add('hidden');
                twinsGrid.classList.add('hidden');

                const response = await fetch('/api/public-chat/user/my-chats', {
                    credentials: 'include',
                    headers: {
                        'X-CSRF-Token': window.csrfToken
                    }
                });

                if (!response.ok) {
                    if (response.status === 401) {
                        // User not authenticated - show empty state
                        loadingState.classList.add('hidden');
                        emptyState.classList.remove('hidden');
                        statsCards.innerHTML = '';
                        return;
                    }
                    throw new Error('Failed to fetch chat history');
                }

                const data = await response.json();

                // ✅ FIX: Update global server time from API response
                if (data.serverTime && window.TimeUtils && window.TimeUtils.setServerTime) {
                    window.TimeUtils.setServerTime(data.serverTime);
                }

                // Hide loading
                loadingState.classList.add('hidden');

                if (!data.success || !data.chats || data.chats.length === 0) {
                    // Show empty state
                    emptyState.classList.remove('hidden');
                    statsCards.innerHTML = '';
                    return;
                }

                // Calculate stats from API data
                const totalTwins = data.chats.length;
                let totalChats = 0;
                let totalMessages = 0;

                // Use accurate counts from API
                data.chats.forEach(({ totalChats: twinChats, totalMessages: twinMessages }) => {
                    totalChats += twinChats || 0;
                    totalMessages += twinMessages || 0;
                });

                 // Save original data for filtering
                 allChatsData = data.chats || [];

                // Render stats
                renderStats(totalTwins, totalChats, totalMessages);

                // Render with current filters
                renderWithFilters();

                // Show grid
                emptyState.classList.add('hidden');
                twinsGrid.classList.remove('hidden');

            } catch (error) {
                loadingState.classList.add('hidden');
                emptyState.classList.add('hidden');  // Hide empty
                const errorState = document.getElementById('errorState');
                if (errorState) errorState.classList.remove('hidden');  // Show error
                statsCards.innerHTML = '';                
            }
        }

        // Render stats cards - Single line layout
        function renderStats(totalTwins, totalChats, totalMessages) {
            const statsCards = document.getElementById('statsCards');
            statsCards.innerHTML = `
                <div class="flex flex-row flex-wrap items-stretch justify-between gap-3 sm:gap-6">
                    <!-- Total Twins -->
                    <div class="flex items-center gap-3 flex-1 min-w-[min(200px,100%)]">
                        <div class="w-12 h-12 bg-gradient-to-r from-primary/20 to-accent/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-2xl">👥</span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Total Twins</p>
                            <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">${totalTwins}</p>
                        </div>
                    </div>
                    
                    <!-- Divider -->
                    <div class="hidden sm:block w-px h-12 bg-gray-200 dark:bg-gray-700"></div>
                    
                    <!-- Total Chats -->
                    <div class="flex items-center gap-3 flex-1 min-w-[min(200px,100%)]">
                        <div class="w-12 h-12 bg-gradient-to-r from-green-500/20 to-emerald-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-2xl">💬</span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Total Chats</p>
                            <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">${totalChats}</p>
                        </div>
                    </div>
                    
                    <!-- Divider -->
                    <div class="hidden sm:block w-px h-12 bg-gray-200 dark:bg-gray-700"></div>
                    
                    <!-- Total Messages -->
                    <div class="flex items-center gap-3 flex-1 min-w-[min(200px,100%)]">
                        <div class="w-12 h-12 bg-gradient-to-r from-blue-500/20 to-indigo-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-2xl">💭</span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Total Messages</p>
                            <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">${totalMessages}</p>
                        </div>
                    </div>
                </div>
            `;
        }

        // Render twin cards
        function renderTwinCards(chats) {
            const twinsGrid = document.getElementById('twinsGrid');
            twinsGrid.innerHTML = '';

            chats.forEach(({ twin, latestChat, lastMessage, totalChats, totalMessages }) => {
                const twinToken = twin.publicId;

                // ✅ FIX: Use user handle/profile image (same as dashboard)
                const profileHandle = twin.userHandle || twin.publicHandle || '';
                const profileImage = twin.userProfileImage || twin.profileImage || null;
                const avatarInitial = (profileHandle || 'T').charAt(0).toUpperCase();

                const card = document.createElement('div');
                card.className = 'bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-xl p-6 border border-white/20 dark:border-gray-700 shadow-lg hover:shadow-xl transition-all duration-300 group';
                card.setAttribute('data-twin-token', twinToken);

                // Last message preview
                const lastMessagePreview = lastMessage?.content 
                    ? (lastMessage.content.length > 60 ? lastMessage.content.substring(0, 60) + '...' : lastMessage.content)
                    : 'Continue conversation...';

                card.innerHTML = `
                    <div class="flex items-center gap-4 mb-4">
                        <div class="relative flex-shrink-0">
                            <div class="twin-avatar-clickable w-16 h-16 bg-gradient-to-r from-primary to-accent rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg group-hover:scale-110 transition-transform cursor-pointer" data-profile-handle="${profileHandle}" style="cursor: pointer;">
                                ${profileImage ? `<img src="${profileImage}" alt="${profileHandle}" class="w-16 h-16 rounded-full object-cover" loading="lazy">` : avatarInitial}
                            </div>
                            <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 dark:bg-green-600 rounded-full border-2 border-white dark:border-gray-800 flex items-center justify-center">
                                <span class="text-xs text-white font-bold">${totalChats || 0}</span>
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-semibold text-gray-900 dark:text-white text-lg truncate">@${profileHandle || 'twin'}</h3>
                                ${twin.verified ? '<span class="text-sm text-primary dark:text-blue-400">✓</span>' : ''}
                            </div>
                            <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-1">${twin.userName || twin.userHandle || 'Twin'}</p>
                            <div class="flex items-center gap-3 mt-1">
                                ${totalChats > 0 ? `<span class="text-xs text-gray-500 dark:text-gray-400">${totalChats} chat${totalChats > 1 ? 's' : ''}</span>` : ''}
                                ${latestChat?.lastActivity ? `<span class="text-xs text-gray-400 dark:text-gray-500 timestamp-display" data-timestamp="${latestChat.lastActivity}" data-format="smart"></span>` : ''}                                
                            </div>
                        </div>
                    </div>
                    
                    ${latestChat ? `
                        <div class="mb-4 p-3 bg-gray-50/50 dark:bg-gray-800/80 rounded-lg border border-gray-100 dark:border-gray-700">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-xs font-medium text-gray-700 dark:text-gray-200">Latest Chat</p>
                                <span class="text-xs bg-primary/10 dark:bg-primary/30 text-primary dark:text-blue-300 px-2 py-1 rounded-full">${totalMessages || 0} total msgs</span>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2">${lastMessagePreview}</p>
                        </div>
                    ` : ''}
                    
                    <button data-twin-token="${twinToken}"
                            class="continue-chat-btn w-full px-4 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg hover:shadow-lg transition-all font-medium text-sm">
                        💬 Continue Chat
                    </button>
                `;

                // ✅ FIX: Avatar click → profile (use userHandle with fallback)
                const avatarElement = card.querySelector('.twin-avatar-clickable');
                if (avatarElement) {
                    avatarElement.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const handle = this.getAttribute('data-profile-handle');
                        if (handle) {
                            window.location.href = `/@${handle}`;
                        } else {
                            // Fallback to public chat page if no handle
                            window.location.href = `/public-twin/chat/${twinToken}`;
                        }
                    });
                }

                // Add click listener to button after innerHTML
                const button = card.querySelector('.continue-chat-btn');
                if (button) {
                    button.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const token = this.getAttribute('data-twin-token') || twinToken;
                        window.location.href = `/public-twin/chat/${token}`;
                    });
                }
                
                // ✅ FIX: Card click → profile (use userHandle with fallback)
                card.style.cursor = 'pointer';
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.continue-chat-btn') || e.target.closest('.twin-avatar-clickable')) {
                        return;
                    }
                    if (profileHandle) {
                        window.location.href = `/@${profileHandle}`;
                    } else {
                        // Fallback to public chat page if no handle
                        window.location.href = `/public-twin/chat/${twinToken}`;
                    }
                });

                twinsGrid.appendChild(card);
            });
            
            // ✅ Format timestamps client-side after rendering
            if (window.TimeUtils) {
                twinsGrid.querySelectorAll('.timestamp-display').forEach(el => {
                    const timestamp = el.dataset.timestamp;
                    const format = el.dataset.format || 'smart';
                    if (timestamp) {
                        try {
                            let displayTime, fullTime;
                            if (format === 'smart') {
                                displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                el.textContent = 'Last: ' + displayTime;
                            } else {
                                displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                el.textContent = displayTime;
                            }
                            el.title = fullTime;
                        } catch (e) {
                            // Silently handle timestamp formatting errors
                        }
                    }
                });
            }
        }     
        
        function renderWithFilters() {
            if (!Array.isArray(allChatsData) || allChatsData.length === 0) {
                const twinsGrid = document.getElementById('twinsGrid');
                if (twinsGrid) twinsGrid.innerHTML = '';
                return;
            }

            let filtered = [...allChatsData];
            filtered = applyTimeFilter(filtered);
            filtered = applySortFilter(filtered);
            renderTwinCards(filtered);
        }

        function applyTimeFilter(chats) {
            if (activeTimeFilter === 'all') return chats;

            const now = new Date();
            const msPerDay = 24 * 60 * 60 * 1000;

            return chats.filter(({ latestChat, lastMessage }) => {
                const ts = latestChat?.lastActivity || lastMessage?.createdAt;
                if (!ts) return false;
                const diffDays = (now - new Date(ts)) / msPerDay;

                if (activeTimeFilter === 'today') return diffDays <= 1;
                if (activeTimeFilter === '7') return diffDays <= 7;
                if (activeTimeFilter === '30') return diffDays <= 30;
                return true;
            });
        }

        function applySortFilter(chats) {
            if (!activeSortFilter) return chats;

            const arr = [...chats];
            if (activeSortFilter === 'messages') {
                arr.sort((a, b) => (b.totalMessages || 0) - (a.totalMessages || 0));
            } else if (activeSortFilter === 'chats') {
                arr.sort((a, b) => (b.totalChats || 0) - (a.totalChats || 0));
            }
            return arr;
        }

        function syncChipActiveStates() {
            // main row chips
            document.querySelectorAll('.filter-chip').forEach(chip => {
                const type = chip.dataset.filterType;
                const value = chip.dataset.filterValue;
                let active = false;

                if (type === 'time') {
                    active = (value === activeTimeFilter);
                } else if (type === 'sort') {
                    active = (value === activeSortFilter);
                }

                if (active) {
                    chip.classList.add('border-primary/40','bg-primary/10','text-primary','dark:border-primary/40','dark:bg-primary/20','dark:text-primary');
                    chip.classList.remove('border-gray-200','dark:border-gray-700','bg-white','dark:bg-gray-900','text-gray-700','dark:text-gray-300');
                } else {
                    chip.classList.remove('border-primary/40','bg-primary/10','text-primary','dark:border-primary/40','dark:bg-primary/20','dark:text-primary');
                    chip.classList.add('border-gray-200','dark:border-gray-700','bg-white','dark:bg-gray-900','text-gray-700','dark:text-gray-300');
                }
            });

            // sheet chips
            document.querySelectorAll('.filter-chip-sheet').forEach(chip => {
                const type = chip.dataset.filterType;
                const value = chip.dataset.filterValue;
                let active = false;

                if (type === 'time') {
                    active = (value === activeTimeFilter);
                } else if (type === 'sort') {
                    active = (value === activeSortFilter);
                }

                if (active) {
                    chip.classList.add('border-primary/40','bg-primary/10','text-primary','dark:border-primary/40','dark:bg-primary/20','dark:text-primary');
                    chip.classList.remove('border-gray-200','dark:border-gray-700','bg-white','dark:bg-gray-800','text-gray-700','dark:text-gray-300');
                } else {
                    chip.classList.remove('border-primary/40','bg-primary/10','text-primary','dark:border-primary/40','dark:bg-primary/20','dark:text-primary');
                    chip.classList.add('border-gray-200','dark:border-gray-700','bg-white','dark:bg-gray-800','text-gray-700','dark:text-gray-300');
                }
            });
        }

        function setupFilterEvents() {
            // Main row chips
            document.querySelectorAll('.filter-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    const type = chip.dataset.filterType;
                    const value = chip.dataset.filterValue;

                    if (type === 'time') {
                        activeTimeFilter = value;
                    } else if (type === 'sort') {
                        activeSortFilter = (activeSortFilter === value ? null : value);
                    }

                    syncChipActiveStates();
                    renderWithFilters();
                });
            });

            // Sheet chips
            document.querySelectorAll('.filter-chip-sheet').forEach(chip => {
                chip.addEventListener('click', () => {
                    const type = chip.dataset.filterType;
                    const value = chip.dataset.filterValue;

                    if (type === 'time') {
                        activeTimeFilter = value;
                    } else if (type === 'sort') {
                        activeSortFilter = (activeSortFilter === value ? null : value);
                    }

                    syncChipActiveStates();
                });
            });

            // Open / Close sheet
            const sheet = document.getElementById('filtersSheetOverlay');
            const openBtn = document.getElementById('openFiltersSheetBtn');
            const closeBtn = document.getElementById('closeFiltersSheetBtn');

            if (openBtn && sheet) {
                openBtn.addEventListener('click', () => {
                    sheet.classList.remove('hidden');
                    syncChipActiveStates();
                });
            }
            if (closeBtn && sheet) {
                closeBtn.addEventListener('click', () => {
                    sheet.classList.add('hidden');
                });
            }
            if (sheet) {
                sheet.addEventListener('click', (e) => {
                    if (e.target === sheet) {
                        sheet.classList.add('hidden');
                    }
                });
            }

            // Clear / Apply in sheet
            const clearBtn = document.getElementById('clearFiltersBtn');
            const applyBtn = document.getElementById('applyFiltersBtn');

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    activeTimeFilter = 'all';
                    activeSortFilter = null;
                    syncChipActiveStates();
                });
            }

            if (applyBtn && sheet) {
                applyBtn.addEventListener('click', () => {
                    syncChipActiveStates();
                    renderWithFilters();
                    sheet.classList.add('hidden');
                });
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadChatHistory();
            setupFilterEvents();
        });
    </script>

        <!-- Full Filter Sheet (mobile-style, slides up from bottom) -->
        <div id="filtersSheetOverlay" class="fixed inset-0 z-40 bg-black/40 hidden">
            <div class="absolute inset-x-0 bottom-0 bg-white dark:bg-gray-900 rounded-t-2xl max-h-[80vh] shadow-2xl flex flex-col">
                <!-- Header -->
                <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold text-gray-900 dark:text-white">Filters</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Refine your public chat history</p>
                    </div>
                    <button id="closeFiltersSheetBtn"
                            class="inline-flex items-center justify-center w-8 h-8 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 dark:text-gray-300"
                            type="button">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
    
                <!-- Filter content -->
                <div class="flex-1 overflow-y-auto px-4 py-3 space-y-4">
                    <!-- Time filter group -->
                    <div>
                        <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase mb-2">Time</h3>
                        <div class="flex flex-wrap gap-2">
                            <button
                                class="filter-chip-sheet active px-3 py-1.5 rounded-full text-xs border border-primary/40 bg-primary/10 text-primary dark:border-primary/40 dark:bg-primary/20 dark:text-primary"
                                data-filter-type="time" data-filter-value="all">
                                All time
                            </button>
                            <button
                                class="filter-chip-sheet px-3 py-1.5 rounded-full text-xs border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300"
                                data-filter-type="time" data-filter-value="today">
                                Today
                            </button>
                            <button
                                class="filter-chip-sheet px-3 py-1.5 rounded-full text-xs border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300"
                                data-filter-type="time" data-filter-value="7">
                                Last 7 days
                            </button>
                            <button
                                class="filter-chip-sheet px-3 py-1.5 rounded-full text-xs border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300"
                                data-filter-type="time" data-filter-value="30">
                                Last 30 days
                            </button>
                        </div>
                    </div>
    
                    <!-- Sort group -->
                    <div>
                        <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase mb-2">Sort by</h3>
                        <div class="flex flex-wrap gap-2">
                            <button
                                class="filter-chip-sheet px-3 py-1.5 rounded-full text-xs border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300"
                                data-filter-type="sort" data-filter-value="messages">
                                Most messages
                            </button>
                            <button
                                class="filter-chip-sheet px-3 py-1.5 rounded-full text-xs border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300"
                                data-filter-type="sort" data-filter-value="chats">
                                Most chats
                            </button>
                        </div>
                    </div>
                </div>
    
                <!-- Footer buttons -->
                <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 flex gap-3">
                    <button id="clearFiltersBtn"
                            class="flex-1 px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-xs sm:text-sm text-gray-700 dark:text-gray-200">
                        Clear
                    </button>
                    <button id="applyFiltersBtn"
                            class="flex-1 px-4 py-2.5 rounded-xl bg-gradient-to-r from-primary to-accent text-xs sm:text-sm text-white font-semibold shadow-md">
                        Apply
                    </button>
                </div>
            </div>
        </div>

    <!--Footer-->
    <%- include('footer/footer-conditional-private') %>
</body>
</html>