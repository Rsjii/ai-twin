        function createTimeBasedChart(breakdown, period) {
    try {
        // Wait for Chart.js
        if (typeof Chart === 'undefined') {
            console.warn('Chart.js not loaded, retrying...');
            setTimeout(() => createTimeBasedChart(breakdown, period), 100);
            return;
        }

        // For time-based charts, we can update existing charts or create new ones
        // Since we already have eventBreakdownChart and growthTrendsChart,
        // we can update them with time-based data
        
        if (breakdown && breakdown.hourly && breakdown.hourly.length > 0) {
            // Update event breakdown chart with hourly data
            const canvas = document.getElementById('eventBreakdownChart');
            if (canvas && window.eventBreakdownChartInstance) {
                const ctx = canvas.getContext('2d');
                if (ctx) {
                    window.eventBreakdownChartInstance.destroy();
                    
                    const labels = breakdown.hourly.map(h => `${h.hour}:00`);
                    const values = breakdown.hourly.map(h => Number(h.count) || 0);
                    
                    window.eventBreakdownChartInstance = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: `${period} Activity`,
                                data: values,
                                backgroundColor: '#3B82F6',
                                borderColor: '#2563EB',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom'
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true
                                }
                            }
                        }
                    });
                }
            }
        }
        
        if (breakdown && breakdown.daily && breakdown.daily.length > 0) {
            // Update growth trends chart with daily data
            const canvas = document.getElementById('growthTrendsChart');
            if (canvas && window.growthTrendsChartInstance) {
                const ctx = canvas.getContext('2d');
                if (ctx) {
                    window.growthTrendsChartInstance.destroy();
                    
                    const labels = breakdown.daily.map(d => {
                        const date = new Date(d.date);
                        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                    });
                    const values = breakdown.daily.map(d => Number(d.count) || 0);
                    
                    window.growthTrendsChartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: `Events (${period})`,
                                data: values,
                                borderColor: '#3B82F6',
                                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                                tension: 0.4,
                                fill: true
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: {
                                    beginAtZero: true
                                }
                            }
                        }
                    });
                }
            }
        }
    } catch (error) {
        console.error('Error creating time-based chart:', error);
    }
}
        
        // Load detailed data for specific metric type
        async function loadDetailedData(type, timePeriod = null) {
            try {
                // Use currentTimePeriod if not provided
                const period = timePeriod || currentTimePeriod || 'today';
                console.log(`Loading detailed data for ${type} in ${period} period...`);
                
                let response;
                if (period === 'all') {
                    response = await fetch(`/api/admin/analytics/detailed/${type}`, {
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' }
                    });
                } else {
                    response = await fetch(`/api/admin/analytics/time/${period}`, {
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' }
                    });
                }
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                console.log(`Detailed ${type} data for ${period}:`, data);
                
                if (data.success) {
                    // Update currentAnalyticsData for accurate export
                    currentAnalyticsData = data.data || data.metrics;
                    
                    const content = document.getElementById('detailedModalContent');
                    if (period === 'all') {
                        content.innerHTML = generateDetailedContent(type, data.data);
                    } else {
                        // For time-based data, show summary and breakdown with period tabs
                        content.innerHTML = generateTimeBasedDetailedContent(type, data.data, period);
                    }
                } else {
                    document.getElementById('detailedModalContent').innerHTML = 
                        '<p class="text-red-600">Error: ' + (data.error || 'Unknown error') + '</p>';
                }
            } catch (error) {
                console.error('Detailed data error:', error);
                document.getElementById('detailedModalContent').innerHTML = 
                    '<p class="text-red-600">Error loading detailed data: ' + error.message + '</p>';
            }
        }

