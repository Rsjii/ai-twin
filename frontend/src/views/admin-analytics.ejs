// Chart 1: Events Over Time (Line chart - hourly for today, daily for others)
function createEventsOverTimeChart(breakdown, period) {
    try {
        if (typeof Chart === 'undefined') {
            setTimeout(() => createEventsOverTimeChart(breakdown, period), 100);
            return;
        }

        const canvas = document.getElementById('eventsOverTimeChart');
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        
        if (window.eventsOverTimeChartInstance) {
            window.eventsOverTimeChartInstance.destroy();
        }

        let labels, values;
        if (period === 'today' && breakdown.hourly && breakdown.hourly.length > 0) {
            // Today: Show hourly
            labels = breakdown.hourly.map(h => `${Math.floor(h.hour)}:00`);
            values = breakdown.hourly.map(h => Number(h.count) || 0);
        } else if (breakdown.daily && breakdown.daily.length > 0) {
            // Week/Month/All: Show daily
            labels = breakdown.daily.map(d => {
                const date = new Date(d.date);
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            });
            values = breakdown.daily.map(d => Number(d.count) || 0);
        } else {
            return; // No data
        }

        window.eventsOverTimeChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Events',
                    data: values,
                    borderColor: '#3B82F6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    tension: 0.4,
                    fill: true,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top' }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    } catch (error) {
        console.error('Error creating events over time chart:', error);
    }
}

// Chart 2: Entity Growth (Multi-line: Users/Twins/Chats per day)
function createEntityGrowthChart(entitiesDaily, period) {
    try {
        if (typeof Chart === 'undefined') {
            setTimeout(() => createEntityGrowthChart(entitiesDaily, period), 100);
            return;
        }

        const canvas = document.getElementById('entityGrowthChart');
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        
        if (window.entityGrowthChartInstance) {
            window.entityGrowthChartInstance.destroy();
        }

        if (!entitiesDaily || entitiesDaily.length === 0) {
            return; // No data
        }

        const labels = entitiesDaily.map(d => {
            const date = new Date(d.date);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        });
        const users = entitiesDaily.map(d => Number(d.users) || 0);
        const twins = entitiesDaily.map(d => Number(d.twins) || 0);
        const chats = entitiesDaily.map(d => Number(d.chats) || 0);

        window.entityGrowthChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Users',
                        data: users,
                        borderColor: '#3B82F6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.4
                    },
                    {
                        label: 'Twins',
                        data: twins,
                        borderColor: '#10B981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        tension: 0.4
                    },
                    {
                        label: 'Chats',
                        data: chats,
                        borderColor: '#F59E0B',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top' }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    } catch (error) {
        console.error('Error creating entity growth chart:', error);
    }
}

// Chart 3: Top Entities (Bar chart - Twins or Users)
let currentTopEntitiesTab = 'twins';
function switchTopEntitiesTab(tab) {
    currentTopEntitiesTab = tab;
    const twinsBtn = document.getElementById('topEntitiesTabTwins');
    const usersBtn = document.getElementById('topEntitiesTabUsers');
    
    if (twinsBtn && usersBtn) {
        if (tab === 'twins') {
            twinsBtn.classList.add('bg-blue-600', 'text-white');
            twinsBtn.classList.remove('bg-gray-200', 'text-gray-700');
            usersBtn.classList.remove('bg-blue-600', 'text-white');
            usersBtn.classList.add('bg-gray-200', 'text-gray-700');
        } else {
            usersBtn.classList.add('bg-blue-600', 'text-white');
            usersBtn.classList.remove('bg-gray-200', 'text-gray-700');
            twinsBtn.classList.remove('bg-blue-600', 'text-white');
            twinsBtn.classList.add('bg-gray-200', 'text-gray-700');
        }
    }
    
    // Re-render chart with current data
    if (window.lastTopEntitiesData) {
        createTopEntitiesChart(window.lastTopEntitiesData, currentTopEntitiesTab);
    }
}


function createTopEntitiesChart(topContent, activeTab = 'twins') {
    try {
        if (typeof Chart === 'undefined') {
            setTimeout(() => createTopEntitiesChart(topContent, activeTab), 100);
            return;
        }

        const canvas = document.getElementById('topEntitiesChart');
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        
        if (window.topEntitiesChartInstance) {
            window.topEntitiesChartInstance.destroy();
        }

        // Store for tab switching
        window.lastTopEntitiesData = topContent;

        let labels, values, labelKey;
        if (activeTab === 'twins' && topContent.twins && topContent.twins.length > 0) {
            const sorted = topContent.twins.slice(0, 10).sort((a, b) => (b.likeCount || 0) - (a.likeCount || 0));
            labels = sorted.map(t => t.publicHandle || 'Unknown');
            values = sorted.map(t => Number(t.likeCount) || 0);
            labelKey = 'Likes';
        } else if (activeTab === 'users' && topContent.users && topContent.users.length > 0) {
            const sorted = topContent.users.slice(0, 10).sort((a, b) => (b.eventCount || 0) - (a.eventCount || 0));
            labels = sorted.map(u => u.handle || u.email || 'Unknown');
            values = sorted.map(u => Number(u.eventCount) || 0);
            labelKey = 'Events';
        } else {
            return; // No data
        }

        window.topEntitiesChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: labelKey,
                    data: values,
                    backgroundColor: activeTab === 'twins' ? '#10B981' : '#3B82F6',
                    borderColor: activeTab === 'twins' ? '#059669' : '#2563EB',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { beginAtZero: true }
                }
            }
        });
    } catch (error) {
        console.error('Error creating top entities chart:', error);
    }
}

// Unified chart updater - calls all chart functions
function updateCharts(period, data) {
    const breakdown = data.breakdown || {};
    const topContent = data.topContent || {};
    const eventBreakdown = data.eventBreakdown || {};

    console.log('[UPDATE_CHARTS] Period:', period);
    console.log('[UPDATE_CHARTS] Breakdown:', breakdown);
    console.log('[UPDATE_CHARTS] TopContent:', topContent);
    console.log('[UPDATE_CHARTS] EventBreakdown:', eventBreakdown);

    // Chart 1: Events Over Time
    createEventsOverTimeChart(breakdown, period);

    // Chart 2: Entity Growth
    if (breakdown.entitiesDaily && breakdown.entitiesDaily.length > 0) {
        createEntityGrowthChart(breakdown.entitiesDaily, period);
    } else {
        console.warn('[UPDATE_CHARTS] No entitiesDaily data for period:', period);
    }

    // Chart 3: Event Breakdown (existing function)
    if (Object.keys(eventBreakdown).length > 0) {
        createEventBreakdownChart(eventBreakdown);
    }

    // Chart 4: Top Entities - Normalize data structure
    // Handle both formats: {twins: [], users: []} and {topTwins: [], mostActiveUsers: []}
    const normalizedTopContent = {
        twins: topContent.twins || topContent.topTwins || [],
        users: topContent.users || topContent.mostActiveUsers || []
    };
    
    console.log('[UPDATE_CHARTS] Normalized TopContent:', normalizedTopContent);
    
    if (normalizedTopContent.twins.length > 0 || normalizedTopContent.users.length > 0) {
        createTopEntitiesChart(normalizedTopContent, currentTopEntitiesTab);
    } else {
        console.warn('[UPDATE_CHARTS] No top entities data for period:', period);
    }
}

