        function updateRecentActivity(activity) {
            // Update recent signups
            const signupsContainer = document.getElementById('recentSignups');
            if (activity.recentSignups && activity.recentSignups.length > 0) {
                signupsContainer.innerHTML = activity.recentSignups.slice(0, 3).map(user => `
                    <div class="text-sm">
                        <p class="font-medium text-gray-900">${user.handle || user.email}</p>
                        <p class="text-gray-600 timestamp-display" data-timestamp="${user.createdAt}" data-format="date"></p>
                    </div>
                `).join('');
            } else {
                signupsContainer.innerHTML = '<p class="text-gray-500 text-sm">No recent signups</p>';
            }
            
            // Update recent twins
            const twinsContainer = document.getElementById('recentTwins');
            if (activity.recentTwins && activity.recentTwins.length > 0) {
                twinsContainer.innerHTML = activity.recentTwins.slice(0, 3).map(twin => `
                    <div class="text-sm">
                        <p class="font-medium text-gray-900">${twin.userHandle || 'Unknown'}</p>
                        <p class="text-gray-600 timestamp-display" data-timestamp="${twin.createdAt}" data-format="date"></p>
                    </div>
                `).join('');
            } else {
                twinsContainer.innerHTML = '<p class="text-gray-500 text-sm">No recent twins</p>';
            }
            
            // Update recent chats
            const chatsContainer = document.getElementById('recentChats');
            if (activity.recentChats && activity.recentChats.length > 0) {
                chatsContainer.innerHTML = activity.recentChats.slice(0, 3).map(chat => `
                    <div class="text-sm">
                        <p class="font-medium text-gray-900">${chat.userHandle || 'Unknown'}</p>
                        <p class="text-gray-600 timestamp-display" data-timestamp="${chat.createdAt}" data-format="date"></p>
                    </div>
                `).join('');
            } else {
                chatsContainer.innerHTML = '<p class="text-gray-500 text-sm">No recent chats</p>';
            }
            
// Update recent events (with meta tags)
const eventsContainer = document.getElementById('recentEvents');
if (activity.recentEvents && activity.recentEvents.length > 0) {
    eventsContainer.innerHTML = activity.recentEvents.slice(0, 3).map(event => {
        // Extract meta tags (simple client-side extraction)
        const meta = event.meta || {};
        const tags = [];
        if (meta.wv) tags.push(`wv:${meta.wv}`);
        if (meta.source) tags.push(`src:${meta.source}`);
        if (meta.twinId) tags.push(`twin:${meta.twinId.substring(0, 6)}`);
        
        const tagsHtml = tags.length > 0 
            ? `<div class="flex flex-wrap gap-1 mt-1">${tags.map(tag => 
                `<span class="px-1.5 py-0.5 text-xs bg-blue-100 text-blue-700 rounded">${tag}</span>`
              ).join('')}</div>`
            : '';
        
        return `
            <div class="text-sm">
                <p class="font-medium text-gray-900">${event.type}</p>
                <p class="text-gray-600 timestamp-display" data-timestamp="${event.createdAt}" data-format="date"></p>
                ${tagsHtml}
            </div>
        `;
    }).join('');
} else {
    eventsContainer.innerHTML = '<p class="text-gray-500 text-sm">No recent events</p>';
}            
            
            // ✅ Format timestamps client-side after rendering
            if (window.TimeUtils) {
                [signupsContainer, twinsContainer, chatsContainer, eventsContainer].forEach(container => {
                    if (container) {
                        container.querySelectorAll('.timestamp-display').forEach(el => {
                            const timestamp = el.dataset.timestamp;
                            const format = el.dataset.format || 'date';
                            if (timestamp) {
                                try {
                                    let displayTime, fullTime;
                                    if (format === 'date') {
                                        displayTime = window.TimeUtils.formatDateOnly(timestamp);
                                        fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                    } else {
                                        displayTime = window.TimeUtils.formatSmartTime(timestamp);
                                        fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                                    }
                                    el.textContent = displayTime;
                                    el.title = fullTime;
                                } catch (e) {
                                    console.error('Error formatting timestamp:', e);
                                }
                            }
                        });
                    }
                });
            }
        }
        
        function createEventBreakdownChart(eventBreakdown) {
    console.log('[ADMIN_CHART_EVENT] ========== START createEventBreakdownChart ==========');
    console.log('[ADMIN_CHART_EVENT] Input data:', eventBreakdown);
    console.log('[ADMIN_CHART_EVENT] Data type:', typeof eventBreakdown);
    console.log('[ADMIN_CHART_EVENT] Is object:', typeof eventBreakdown === 'object');
    console.log('[ADMIN_CHART_EVENT] Keys count:', eventBreakdown ? Object.keys(eventBreakdown).length : 0);
    
    try {
        // Wait for Chart.js
        if (typeof Chart === 'undefined') {
            console.warn('[ADMIN_CHART_EVENT] ⚠️ Chart.js not loaded, retrying...');
            setTimeout(() => createEventBreakdownChart(eventBreakdown), 100);
            return;
        }
        console.log('[ADMIN_CHART_EVENT] ✅ Chart.js is loaded');

        const canvas = document.getElementById('eventBreakdownChart');
        if (!canvas) {
            console.error('[ADMIN_CHART_EVENT] ❌ eventBreakdownChart canvas not found');
            return;
        }
        console.log('[ADMIN_CHART_EVENT] ✅ Canvas element found');
        
        const ctx = canvas.getContext('2d');
        if (!ctx) {
            console.error('[ADMIN_CHART_EVENT] ❌ Could not get canvas context');
            return;
        }
        console.log('[ADMIN_CHART_EVENT] ✅ Canvas context obtained');
        
        // Destroy existing chart if it exists
        if (window.eventBreakdownChartInstance) {
            console.log('[ADMIN_CHART_EVENT] Destroying existing chart instance');
            window.eventBreakdownChartInstance.destroy();
        }
        
        // Validate data
        if (!eventBreakdown || typeof eventBreakdown !== 'object' || Object.keys(eventBreakdown).length === 0) {
            console.warn('[ADMIN_CHART_EVENT] ⚠️ No event breakdown data available:', {
                hasEventBreakdown: !!eventBreakdown,
                type: typeof eventBreakdown,
                keysLength: eventBreakdown ? Object.keys(eventBreakdown).length : 0
            });
            return;
        }

        const labels = Object.keys(eventBreakdown);
        const values = Object.values(eventBreakdown).map(v => Number(v) || 0);
        
        console.log('[ADMIN_CHART_EVENT] Processed data:', {
            labelsCount: labels.length,
            valuesCount: values.length,
            labels: labels,
            values: values,
            totalValue: values.reduce((a, b) => a + b, 0)
        });
        
        if (labels.length === 0 || values.length === 0) {
            console.warn('[ADMIN_CHART_EVENT] ⚠️ Empty labels or values array');
