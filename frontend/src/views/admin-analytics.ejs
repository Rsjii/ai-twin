    <script>

                // Notification system
                function showNotification(message, type = 'success') {
            // Remove existing notification
            const existing = document.getElementById('globalNotification');
            if (existing) {
                existing.remove();
            }
            
            const notification = document.createElement('div');
            notification.id = 'globalNotification';
            notification.className = `notification ${type}`;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.animation = 'slideIn 0.3s ease-out reverse';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
        

        // Load admin analytics data
        async function loadAdminAnalytics() {
            try {
                console.log('Loading admin analytics data...');
                
                const response = await fetch('/api/admin/analytics/dashboard', {
                    method: 'GET',
                    credentials: 'include', // ✅ CRITICAL: Add this
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                console.log('Admin analytics response status:', response.status);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Admin analytics API error:', response.status, errorText);
                    throw new Error(`Admin analytics API failed: ${response.status} - ${errorText}`);
                }
                
                const data = await response.json();
                console.log('Admin analytics data:', data);
                
                if (data.success) {
                    // Hide loading state
                    document.getElementById('loadingState').classList.add('hidden');
                    document.getElementById('mainContent').classList.remove('hidden');
                    
                    // ✅ ADD: Check if metrics exist
                    if (!data.metrics) {
                        console.error('No metrics in response:', data);
                        throw new Error('Invalid response format: missing metrics');
                    }
                    
                    // Update overview cards
                    document.getElementById('totalUsers').textContent = data.metrics.lifetime?.users || 0;
                    document.getElementById('totalTwins').textContent = data.metrics.lifetime?.twins || 0;
                    document.getElementById('totalChats').textContent = data.metrics.lifetime?.chats || 0;
                    document.getElementById('totalMessages').textContent = data.metrics.lifetime?.messages || 0;
                    
                    // Update daily metrics
                    document.getElementById('dailyUsers').textContent = data.metrics.daily?.users || 0;
                    document.getElementById('dailyTwins').textContent = data.metrics.daily?.twins || 0;
                    document.getElementById('dailyChats').textContent = data.metrics.daily?.chats || 0;
                    document.getElementById('dailyMessages').textContent = data.metrics.daily?.messages || 0;
                    document.getElementById('dailyEvents').textContent = data.metrics.daily?.events || 0;
                    
                    // Update weekly metrics
                    document.getElementById('weeklyUsers').textContent = data.metrics.weekly?.users || 0;
                    document.getElementById('weeklyTwins').textContent = data.metrics.weekly?.twins || 0;
                    document.getElementById('weeklyChats').textContent = data.metrics.weekly?.chats || 0;
                    document.getElementById('weeklyMessages').textContent = data.metrics.weekly?.messages || 0;
                    document.getElementById('weeklyEvents').textContent = data.metrics.weekly?.events || 0;
                    
                    // Update monthly metrics
                    document.getElementById('monthlyUsers').textContent = data.metrics.monthly?.users || 0;
                    document.getElementById('monthlyTwins').textContent = data.metrics.monthly?.twins || 0;
                    document.getElementById('monthlyChats').textContent = data.metrics.monthly?.chats || 0;
                    document.getElementById('monthlyMessages').textContent = data.metrics.monthly?.messages || 0;
                    document.getElementById('monthlyEvents').textContent = data.metrics.monthly?.events || 0;
                    
                    // Update user activity
                    document.getElementById('activeUsersToday').textContent = data.metrics.userActivity?.activeUsersToday || 0;
                    document.getElementById('newUsersToday').textContent = data.metrics.userActivity?.newUsersToday || 0;
                    document.getElementById('newUsersThisWeek').textContent = data.metrics.userActivity?.newUsersThisWeek || 0;
                    document.getElementById('newUsersThisMonth').textContent = data.metrics.userActivity?.newUsersThisMonth || 0;
                    
                    // Update engagement metrics
                    const avgMsg = data.metrics.engagement?.avgMessagesPerChat || 0;
                    const avgChats = data.metrics.engagement?.avgChatsPerUser || 0;
                    const avgEvents = data.metrics.engagement?.avgEventsPerUser || 0;

                    // Add after existing metric updates:
                    document.getElementById('dauCount').textContent = data.metrics.userActivity?.dau || 0;
                    document.getElementById('wauCount').textContent = data.metrics.userActivity?.wau || 0;
                    document.getElementById('mauCount').textContent = data.metrics.userActivity?.mau || 0;
                    
                    document.getElementById('avgMessagesPerChat').textContent = Number(avgMsg).toFixed(2);
                    document.getElementById('avgChatsPerUser').textContent = Number(avgChats).toFixed(2);
                    document.getElementById('avgEventsPerUser').textContent = Number(avgEvents).toFixed(2);
                    
                    // Update content sections
                    if (data.content?.topContent) {
                        updateTopTwins(data.content.topContent.topTwins || []);
                        updateMostActiveUsers(data.content.topContent.mostActiveUsers || []);
                    }
                    if (data.content?.recentActivity) {
                        updateRecentActivity(data.content.recentActivity);
                    }
                    
                    // Create charts
                    console.log('[ADMIN] Creating charts...');
                    console.log('[ADMIN] Event breakdown check:', {
                        hasContent: !!data.content,
                        hasEventBreakdown: !!data.content?.eventBreakdown,
                        eventBreakdownType: typeof data.content?.eventBreakdown,
                        eventBreakdownKeys: data.content?.eventBreakdown ? Object.keys(data.content.eventBreakdown) : null,
                        eventBreakdownValues: data.content?.eventBreakdown ? Object.values(data.content.eventBreakdown) : null
                    });
                    
                    if (data.content?.eventBreakdown) {
                        console.log('[ADMIN] ✅ Calling createEventBreakdownChart');
                        createEventBreakdownChart(data.content.eventBreakdown);
                    } else {
                        console.warn('[ADMIN] ⚠️ No eventBreakdown data, skipping chart');
                    }
                    
                    console.log('[ADMIN] Metrics check:', {
                        hasMetrics: !!data.metrics,
                        hasDaily: !!data.metrics?.daily,
                        hasWeekly: !!data.metrics?.weekly,
                        hasMonthly: !!data.metrics?.monthly
                    });
                    
                    if (data.metrics) {
                        console.log('[ADMIN] ✅ Calling createGrowthTrendsChart');
                        createGrowthTrendsChart(data.metrics);
                    } else {
                        console.warn('[ADMIN] ⚠️ No metrics data, skipping chart');
                    }

                    // ✅ Show a friendly message when there is no event data
                    const hasEvents =
                        data.content &&
                        data.content.eventBreakdown &&
                        Object.values(data.content.eventBreakdown).some(v => Number(v) > 0);

                    if (!hasEvents) {
                        const chartEl = document.getElementById('eventBreakdownChart');
                        const container = chartEl ? chartEl.parentElement : null;
                        if (container && !container.querySelector('.no-data-label')) {
                            const p = document.createElement('p');
                            p.className = 'no-data-label mt-4 text-sm text-gray-500 text-center';
                            p.textContent = 'No events yet for this period.';
                            container.appendChild(p);
                        }
                    }

                    // After line 468 (engagement metrics), add:

                    // Update activation metrics
                    if (data.metrics.activation) {
                        const activation = data.metrics.activation;
                        document.getElementById('activationSignups').textContent = activation.signups || 0;
                        document.getElementById('activationTwinRate').textContent = activation.twinCreationRate + '%';
                        document.getElementById('activationChatRate').textContent = activation.firstChatRate + '%';
                        document.getElementById('activationApprovalRate').textContent = activation.firstApprovalRate + '%';
                    }

                    // Update retention metrics
                    if (data.metrics.retention) {
                        const retention = data.metrics.retention;
                        document.getElementById('retentionD1').textContent = retention.d1.rate + '%';
                        document.getElementById('retentionD7').textContent = retention.d7.rate + '%';
                        document.getElementById('retentionD30').textContent = retention.d30.rate + '%';
                    }

                    // Update virality metrics
                    if (data.metrics.virality) {
                        const virality = data.metrics.virality;
                        document.getElementById('viralityInvitesPerUser').textContent = virality.invitesPerActiveUser;
                        document.getElementById('viralitySharesPerUser').textContent = virality.sharesPerActiveUser;
                        document.getElementById('viralityConversionRate').textContent = virality.inviteConversionRate + '%';
                    }
                } else {
                    console.error('Failed to load admin analytics:', data.error);
                    document.getElementById('loadingState').innerHTML = '<p class="text-red-600">Failed to load analytics data: ' + (data.error || 'Unknown error') + '</p>';
                }
            } catch (error) {
                console.error('Admin analytics loading error:', error);
                const loadingEl = document.getElementById('loadingState');
                if (loadingEl) {
                    loadingEl.innerHTML = '<p class="text-red-600">Error loading analytics data: ' + error.message + '</p>';
                }
            }
        }
        
        function updateTopTwins(twins) {
            const container = document.getElementById('topTwins');
            if (twins && twins.length > 0) {
                container.innerHTML = twins.slice(0, 5).map(twin => `
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                        <div>
                            <p class="font-medium text-gray-900">${twin.userHandle || 'Unknown'}</p>
                            <p class="text-sm text-gray-600">${twin.likeCount || 0} likes, ${twin.chatCount || 0} chats</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-medium text-gray-900">${twin.likeCount || 0}</p>
                            <p class="text-xs text-gray-600">likes</p>
                        </div>
                    </div>
                `).join('');
            } else {
                container.innerHTML = '<p class="text-gray-500">No twins found</p>';
            }
        }
        
        function updateMostActiveUsers(users) {
            const container = document.getElementById('mostActiveUsers');
            if (users && users.length > 0) {
                container.innerHTML = users.slice(0, 5).map(user => `
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
