                        >
                            Login / Signup
                        </a>
                    </div>                    
                <% } %>
            </div>
        </div>
    </div>
</nav>

<!-- Header JavaScript (for dropdown and theme toggle) -->
<script>
    // ✅ GLOBAL: CSRF Token for all AJAX requests
    window.csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    // Dropdown toggle functionality
    document.addEventListener('DOMContentLoaded', function() {
        const dropdownButton = document.getElementById('dropdownButton');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const arrowIcon = document.getElementById('arrowIcon');
        const userDropdown = document.getElementById('userDropdown');
        
        if (dropdownButton && dropdownMenu) {
            dropdownButton.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = userDropdown.getAttribute('data-open') === 'true';
                
                if (isOpen) {
                    dropdownMenu.classList.add('hidden', 'opacity-0', 'scale-95');
                    dropdownMenu.classList.remove('opacity-100', 'scale-100');
                    arrowIcon.style.transform = 'rotate(0deg)';
                    userDropdown.setAttribute('data-open', 'false');
                } else {
                    dropdownMenu.classList.remove('hidden', 'opacity-0', 'scale-95');
                    dropdownMenu.classList.add('opacity-100', 'scale-100');
                    arrowIcon.style.transform = 'rotate(180deg)';
                    userDropdown.setAttribute('data-open', 'true');
                }
            });
            
            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!userDropdown.contains(e.target)) {
                    dropdownMenu.classList.add('hidden', 'opacity-0', 'scale-95');
                    dropdownMenu.classList.remove('opacity-100', 'scale-100');
                    arrowIcon.style.transform = 'rotate(0deg)';
                    userDropdown.setAttribute('data-open', 'false');
                }
            });
        }
        
        // Theme toggle functionality (if not already in page)
        const darkModeToggle = document.getElementById('darkModeToggleNavbar');
        const sunIcon = document.getElementById('sunIconNavbar');
        const moonIcon = document.getElementById('moonIconNavbar');
        
        if (darkModeToggle && !darkModeToggle.hasAttribute('data-initialized')) {
            darkModeToggle.setAttribute('data-initialized', 'true');
            
            // Set initial icon state
            const currentTheme = localStorage.getItem('theme') || 'light';
            if (currentTheme === 'dark') {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
            
            darkModeToggle.addEventListener('click', function() {
                const html = document.documentElement;
                const isDark = html.classList.contains('dark');
                
                if (isDark) {
                    html.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                    sunIcon.classList.add('hidden');
                    moonIcon.classList.remove('hidden');
                } else {
                    html.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                    sunIcon.classList.remove('hidden');
                    moonIcon.classList.add('hidden');
                }
            });
        }
    });
    
    // ✅ Logout function (GLOBAL - silent logout like dashboard, no confirm)
    async function logout() {
        console.log('Logout function called');
        
        // Get logout button for visual feedback (no confirm dialog)
        const logoutBtn = document.getElementById('logoutButton') || document.querySelector('button[onclick="logout()"]');
        if (logoutBtn) {
            const originalText = logoutBtn.textContent;
            logoutBtn.textContent = 'Logging out...';
            logoutBtn.disabled = true;
        }        
        
        try {
            // Get CSRF token from window or meta tag or button data attribute
            let csrfToken = window.csrfToken;
            if (!csrfToken) {
                // Try to get from meta tag
                const metaTag = document.querySelector('meta[name="csrf-token"]');
                if (metaTag) {
                    csrfToken = metaTag.getAttribute('content');
                }
            }
            if (!csrfToken && typeof csrfToken !== 'undefined') {
                // Try to get from EJS variable if available
                csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
            }
            
            // Make POST request to logout endpoint (like dashboard)
            const response = await fetch('/api/auth/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken || ''
                },
                credentials: 'include'
            });
            
            console.log('Logout response:', response.status);
            
            if (response.ok) {
                console.log('Logout successful, clearing all data...');
                
                // Clear localStorage
                localStorage.removeItem('jwtToken');
                localStorage.removeItem('user');
                
                // Clear sessionStorage
                sessionStorage.clear();
                
                // Clear all cookies
                document.cookie.split(";").forEach(function(c) { 
                    document.cookie = c.replace(/^ +/, "").replace(/=.*/, "=;expires=" + new Date().toUTCString() + ";path=/"); 
                });

                // ✅ PROPER FIX: Use history.go(1) method (from research)
                // Push current state to history
                window.history.pushState(null, null, window.location.href);
                
                // Override popstate to prevent back navigation
                window.onpopstate = function() {
                    // Force forward navigation (prevents going back)
                    window.history.go(1);
                };
                
                // Force redirect with cache busting
                const timestamp = new Date().getTime();
                window.location.replace('/auth?logout=' + timestamp);
                
            } else {
                console.log('Logout failed:', response.status);
                const errorData = await response.text();
                console.log('Error response:', errorData);
                
                // Restore button state
                if (logoutBtn) {
                    logoutBtn.textContent = originalText;
                    logoutBtn.disabled = false;
                }
                
                if (typeof showNotification === 'function') {
                    showNotification('Logout failed. Please try again.', 'error');
                } else {
                    console.error('Logout failed. Please try again.');
                }
            }
        } catch (error) {
            console.error('Logout error:', error);
            
            // Restore button state
            if (logoutBtn) {
                logoutBtn.textContent = originalText;
                logoutBtn.disabled = false;
            }
            
            if (typeof showNotification === 'function') {
                showNotification('Network error. Please try again.', 'error');
            } else {
                console.error('Network error. Please try again.');
            }
        }
    }    
    // Attach to window for extra safety
    window.logout = logout;
    
    // ✅ Also add event listener (backup method)
    document.addEventListener('DOMContentLoaded', function() {
        const logoutBtn = document.getElementById('logoutButton');
        if (logoutBtn && !logoutBtn.hasAttribute('data-listener-added')) {
            logoutBtn.setAttribute('data-listener-added', 'true');
            logoutBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                logout();
            });
        }
    });
</script>
<script>
    // Fallback: If pathname not set, use JavaScript
    document.addEventListener('DOMContentLoaded', function() {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('nav a[href]');
        
        navLinks.forEach(link => {
            const linkPath = new URL(link.href).pathname;
            const isActive = 
                (linkPath === '/dashboard' && currentPath === '/dashboard') ||
                (linkPath === '/discover' && currentPath === '/discover') ||
                (linkPath === '/chat' && (currentPath === '/chat' || currentPath.startsWith('/chat/')));
            
            if (isActive) {
                link.classList.add('text-primary', 'dark:text-blue-400');
                link.classList.remove('text-gray-600', 'dark:text-gray-300', 'bg-white/50', 'dark:bg-gray-800');
            } else {
                link.classList.remove('text-primary', 'dark:text-blue-400', 'bg-white/50', 'dark:bg-gray-800');
                link.classList.add('text-gray-600', 'dark:text-gray-300');
            }            
        });
    });
</script>