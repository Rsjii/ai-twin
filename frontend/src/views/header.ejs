<!-- Robust Authentication Check -->
<% 
  // ✅ ENHANCED: More robust authentication check for production
  const isAuthenticated = typeof user !== 'undefined' && 
                          user !== null && 
                          typeof user === 'object' &&
                          user.id !== undefined && 
                          user.id !== null &&
                          user.email !== undefined &&
                          user.email !== null;
  
  // ✅ ENHANCED: Safe hasTwins check (default to false if undefined)
  const userHasTwins = typeof hasTwins !== 'undefined' ? hasTwins : false;
%>

<style>
    /* Glass Effect for Header - Blurs content behind header */
    .glass-effect {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px); /* Safari support */
        border: 1px solid rgba(255, 255, 255, 0.18);
    }
    
    /* Dark Mode Glass Effect */
    .dark .glass-effect {
        background: rgba(17, 24, 39, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px); /* Safari support */
        border: 1px solid rgba(55, 65, 81, 0.5);
    }
</style>

<!-- Modern Navigation -->
<nav class="glass-effect sticky top-0 z-50 border-b border-white/20 dark:border-gray-700">    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 sm:h-20">
            
            <!-- LEFT SECTION: Logo + Main Navigation -->
            <div class="flex items-center space-x-8">
                <!-- Logo -->
                <div class="flex items-center space-x-3">
                    <% if (isAuthenticated) { %>
                        <a href="/dashboard" class="flex items-center space-x-3 group">
                            <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                </svg>
                            </div>
                            <span class="text-xl sm:text-2xl font-bold gradient-text dark:text-white">TwinOS</span>                            
                        </a>
                    <% } else { %>
                        <a href="/" class="flex items-center space-x-3 group">
                            <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                </svg>
                            </div>
                            <span class="text-xl sm:text-2xl font-bold gradient-text dark:text-white">TwinOS</span>                            
                        </a>
                    <% } %>
                </div>

                <!-- Main Navigation Links (ONLY for authenticated users) -->
                <%
                // Get current pathname
                const currentPath = typeof pathname !== 'undefined' ? pathname : '';
                
                // Exact path matching
                const isDashboard = currentPath === '/dashboard';
                const isDiscover = currentPath === '/discover';
                const isChat = currentPath === '/chat' || currentPath.startsWith('/chat/');
              %>
              
              <% if (isAuthenticated) { %>
                  <nav class="hidden md:flex items-center space-x-1">
                      <a href="/dashboard" 
                         class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium px-4 py-2 rounded-lg <%= isDashboard ? 'text-primary dark:text-blue-400 bg-white/50 dark:bg-gray-800' : '' %>">
                          Dashboard
                      </a>
                      <a href="/discover" 
                         class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium px-4 py-2 rounded-lg <%= isDiscover ? 'text-primary dark:text-blue-400 bg-white/50 dark:bg-gray-800' : '' %>">
                          Discover
                      </a>
                      <a href="/chat" 
                         class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium px-4 py-2 rounded-lg <%= isChat ? 'text-primary dark:text-blue-400 bg-white/50 dark:bg-gray-800' : '' %>">
