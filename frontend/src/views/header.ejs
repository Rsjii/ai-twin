                            <% } %>
                            <div class="hidden md:block text-left">
                                <div class="text-sm font-semibold text-gray-900 dark:text-white"><%= user.handle || user.email || 'User' %></div>
                                <div class="text-xs text-gray-500 dark:text-gray-400"><%= user.email %></div>
                            </div>
                            <svg id="arrowIcon" class="w-4 h-4 text-gray-400 dark:text-gray-500 transition-transform duration-200 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>                        

                        <!-- Dropdown Menu -->
                        <div id="dropdownMenu" class="absolute right-0 mt-3 w-72 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 dark:border-gray-700 py-3 z-50 hidden transition-all duration-200 opacity-0 scale-95">
                            
                            <!-- User Info Header -->
                            <div class="px-6 py-4 border-b border-gray-100/50 dark:border-gray-700/50">
                                <div class="flex items-center space-x-4">
                                    <% if (navProfileImage) { %>
                                        <img src="<%= navProfileImage %>" alt="Profile" class="w-14 h-14 rounded-2xl object-cover shadow-lg">
                                    <% } else { %>
                                        <div class="w-14 h-14 bg-gradient-to-r from-primary via-accent to-purple-500 rounded-2xl flex items-center justify-center text-white text-xl font-bold shadow-lg">
                                            <%= (user && (user.handle || user.email || 'U')) ? (user.handle || user.email || 'U').charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                    <% } %>                                    
                                    <div class="flex-1 min-w-0">
                                        <p class="text-lg font-semibold text-gray-900 dark:text-white truncate"><%= user.name || user.handle || 'User' %></p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400 truncate"><%= user.email %></p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Navigation Items in Dropdown -->
                            <div class="py-2">
                                <a href="/discover" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                    <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    Discover
                                </a>
                                <% if (typeof hasTwins !== 'undefined' && hasTwins && typeof twinId !== 'undefined' && twinId) { %>
                                    <a href="/twin/manage" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                        </svg>
                                        My Twin
                                    </a>
                                <% } %>
                                <% if (typeof hasTwins !== 'undefined' && hasTwins) { %>
                                    <a href="/analytics" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                        <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                        </svg>
                                        Analytics
                                    </a>
                                    <% } %>                                
                                <a href="/profile?tab=settings" class="flex items-center px-6 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50/80 dark:hover:bg-gray-800/80 transition-colors">
                                    <svg class="w-5 h-5 mr-3 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    Settings
                                </a>
                            </div>
                            
                            <!-- Sign Out -->
                            <div class="border-t border-gray-100/50 dark:border-gray-700/50 pt-2">
                                <button id="logoutButton" onclick="logout()" class="flex items-center w-full px-6 py-3 text-red-600 dark:text-red-400 hover:bg-red-50/80 dark:hover:bg-red-900/20 transition-colors">                                    
                                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                    </svg>
                                    Sign Out
                                </button>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Not Logged In: Show Discover + Login/Signup Button -->
                    <div class="flex items-center space-x-2 sm:space-x-3">
                        <!-- Discover: desktop / tablet only -->
                        <a
                            href="/discover"
                            class="hidden sm:inline-flex px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 transition-colors font-medium"
                        >
                            Discover
                        </a>
                    
                        <!-- Login / Signup: primary action, always visible -->
                        <a
                            href="/auth"
                            class="px-4 sm:px-6 py-2 sm:py-2.5 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all duration-300 font-medium
