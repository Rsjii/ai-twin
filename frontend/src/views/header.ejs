                                <img src="<%= navProfileImage %>" alt="Profile" class="w-10 h-10 rounded-full object-cover shadow-lg ring-2 ring-white dark:ring-gray-700" onerror="console.error('Image failed to load:', this.src); this.style.display='none'; this.nextElementSibling.style.display='flex';">
