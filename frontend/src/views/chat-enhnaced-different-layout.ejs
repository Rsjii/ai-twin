        const lastMessageSpan = currentChatItem.querySelector('p.text-xs.text-gray-500, p.text-xs.dark\\:text-gray-400');
        if (lastMessageSpan) {
            const truncated = aiResponse.length > 50 ? aiResponse.substring(0, 50) + '...' : aiResponse;
            lastMessageSpan.textContent = truncated;
            console.log('✅ Updated last message:', truncated);
        }
        
    } else {
        console.warn('⚠️ Chat item not found in sidebar');
    }
