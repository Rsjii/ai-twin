                <button id="downvoteBtn_${responseId}" class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 px-2 py-1 rounded hover:bg-red-50 dark:hover:bg-red-900/30">
                    👎 Bad
                </button>
            </div>
            <button id="regenerateBtn_${responseId}" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 px-2 py-1 rounded hover:bg-blue-50 dark:hover:bg-blue-900/30">
                🔄 Regenerate
            </button>
            <% } %>
            <button id="shareBtn_${responseId}" class="text-purple-600 dark:text-purple-400 hover:text-purple-800 dark:hover:text-purple-300 px-2 py-1 rounded hover:bg-purple-50 dark:hover:bg-purple-900/30">
                📤 Share
            </button>
        `;
        
        currentResponseId = responseId;
        actionsContainer.appendChild(actionsDiv);
        console.log('✅ Actions buttons added to container');
        
        // Add event listeners after creating the HTML
        setTimeout(() => {
            try {
                document.getElementById(`copyBtn_${responseId}`)?.addEventListener('click', () => copyResponse(responseId));
                document.getElementById(`upvoteBtn_${responseId}`)?.addEventListener('click', () => upvoteResponse(responseId));
                document.getElementById(`downvoteBtn_${responseId}`)?.addEventListener('click', () => downvoteResponse(responseId));
                document.getElementById(`regenerateBtn_${responseId}`)?.addEventListener('click', () => regenerateResponse(responseId));
                document.getElementById(`shareBtn_${responseId}`)?.addEventListener('click', () => shareResponse(responseId));
                console.log('✅ Event listeners attached');
            } catch (error) {
                console.error('❌ Error attaching event listeners:', error);
            }
        }, 50);
    };
    
    tryAdd();
