/**
 * Display text with character-by-character typing effect
 */
function displayWithTypingEffect(sender, fullText, metadata = null, callback = null) {
    const messagesContainer = document.getElementById('chatMessages');
    const messageId = `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    
    const messageDiv = document.createElement('div');
    messageDiv.id = messageId;
    messageDiv.className = `flex flex-col ${sender === 'user' ? 'justify-end items-end' : 'justify-start items-start'}`;
    
    const messageWrapper = document.createElement('div');
    messageWrapper.className = `flex ${sender === 'user' ? 'justify-end' : 'justify-start'}`;
    
    const messageContent = document.createElement('div');
    messageContent.className = `max-w-xs sm:max-w-md lg:max-w-lg px-4 py-2 rounded-lg ${
        sender === 'user' 
            ? 'bg-blue-600 dark:bg-blue-500 text-white' 
            : 'bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white'
    }`;
    
    // ✅ FIX: Create actions container OUTSIDE messageContent (so it doesn't get wiped)
    const actionsContainer = document.createElement('div');
    actionsContainer.id = `actions_${messageId}`;
    actionsContainer.className = 'mt-2';
    
    messageWrapper.appendChild(messageContent);
    messageDiv.appendChild(messageWrapper);
    messageDiv.appendChild(actionsContainer); // ✅ Actions container separate
    messagesContainer.appendChild(messageDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    
    // Split into words for realistic typing
    const words = fullText.split(/(\s+)/); // Keep spaces
    let currentWordIndex = 0;
    let currentText = '';
    
    function typeNextWord() {
        if (currentWordIndex < words.length) {
            const word = words[currentWordIndex];
            currentText += word;
            
            // Show text with blinking cursor
            messageContent.innerHTML = `
                <p class="text-sm dark:text-white">${currentText}<span class="streaming-cursor" style="animation: blink 1s infinite;">▊</span></p>
            `;
            
            currentWordIndex++;
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            // ✅ Variable speed: faster for short words, slower for long words
            // Also add small random delay to feel more natural
            const baseSpeed = word.length < 3 ? 20 : word.length < 6 ? 40 : 60;
            const randomDelay = Math.random() * 30; // 0-30ms random
            const speed = baseSpeed + randomDelay;
            
            setTimeout(typeNextWord, speed);
        } else {
            // Typing complete - show final text with timestamp
            messageContent.innerHTML = `
                <p class="text-sm dark:text-white">${fullText}</p>
            `;
            
            // Add timestamp if TimeUtils is available
            if (window.TimeUtils) {
                const timestampEl = document.createElement('div');
                timestampEl.className = 'text-xs text-gray-500 dark:text-gray-400 mt-1';
                const timestamp = metadata?.timestamp || new Date().toISOString();
                timestampEl.textContent = window.TimeUtils.formatSmartTime(timestamp);
                timestampEl.title = window.TimeUtils.formatFullDateTime(timestamp);
                messageContent.appendChild(timestampEl);
            }
            
            // Add metadata display if provided
            if (metadata && (metadata.intent || metadata.criticScore !== undefined)) {
                const metadataDiv = document.createElement('div');
                metadataDiv.className = 'mt-2 text-xs text-gray-500 dark:text-gray-400';
                if (metadata.intent) {
                    metadataDiv.innerHTML += `<span class="mr-2">Intent: ${metadata.intent}</span>`;
                }
                if (metadata.criticScore !== undefined) {
                    metadataDiv.innerHTML += `<span>Score: ${metadata.criticScore.toFixed(2)}</span>`;
                }
                messageContent.appendChild(metadataDiv);
            }
            
            // Call callback if provided
            if (callback) {
                callback(messageId);
            }
        }
    }
    
    // Start typing
    typeNextWord();
    
    return messageId;
}

function addResponseActionsButton(responseId) {
    console.log('🔧 Adding response actions for:', responseId);
    let retries = 0;
    const maxRetries = 20;
    const retryDelay = 100; // 100ms
    
    const tryAdd = () => {
        const actionsContainer = document.getElementById(`actions_${responseId}`);
        if (!actionsContainer) {
            retries++;
            if (retries < maxRetries) {
                console.log(`⏳ Actions container not found, retrying... (${retries}/${maxRetries})`);
                setTimeout(tryAdd, retryDelay);
            } else {
                console.error('❌ Actions container not found after', maxRetries, 'retries');
            }
            return;
        }
        
        // Check if buttons already exist
        if (actionsContainer.querySelector(`#copyBtn_${responseId}`)) {
            console.log('✅ Buttons already exist, skipping');
            return;
        }
        
        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'flex space-x-2 text-xs';
        actionsDiv.innerHTML = `
            <button id="copyBtn_${responseId}" class="text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-white px-2 py-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                📋 Copy
