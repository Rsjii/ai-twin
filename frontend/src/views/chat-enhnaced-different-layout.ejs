        console.log('Draft chat created:', draftChatId);
    } catch (error) {
        console.error('Error creating enhanced draft chat:', error);
    }
}

function addDraftChatToSidebar(chatId, title) {
    const sidebar = document.getElementById('chatHistoryList');
    if (!sidebar) return;
    
    const draftItem = document.createElement('div');
    draftItem.className = 'chat-item draft';
    draftItem.dataset.chatId = chatId;
    draftItem.innerHTML = `
        <div class="flex items-center space-x-2">
            <span class="text-gray-400">💬</span>
            <span class="text-sm text-gray-600 dark:text-gray-300">${title}</span>
        </div>
    `;
    
    // Add click handler
    draftItem.addEventListener('click', () => {
        switchToChat(chatId);
    });
    
    // Insert at top
    sidebar.insertBefore(draftItem, sidebar.firstChild);
}

function removeDraftFromSidebar(chatId) {
    const draftItem = document.querySelector(`[data-chat-id="${chatId}"]`);
    if (draftItem) draftItem.remove();
}

document.addEventListener('DOMContentLoaded', function() {
    // ✅ PHASE 2: Check for redirect message in URL (run FIRST)
    const urlParams = new URLSearchParams(window.location.search);
    const message = urlParams.get('message');
    
    if (message) {
        // Show banner with message
        const banner = document.getElementById('redirectMessageBanner');
        const messageText = document.getElementById('redirectMessageText');
        const closeBtn = document.getElementById('closeMessageBanner');
        
        if (banner && messageText) {
            messageText.textContent = decodeURIComponent(message);
            banner.classList.remove('hidden');
            
            // Close button functionality
            if (closeBtn) {
                closeBtn.addEventListener('click', () => {
                    banner.classList.add('hidden');
                    // Remove message from URL without reload
                    const newUrl = window.location.pathname + (urlParams.get('twinId') ? `?twinId=${urlParams.get('twinId')}` : '');
                    window.history.replaceState({}, '', newUrl);
                });
            }
            
            // Auto-hide after 5 seconds
            setTimeout(() => {
                if (banner && !banner.classList.contains('hidden')) {
                    banner.classList.add('hidden');
                    // Remove message from URL
                    const newUrl = window.location.pathname + (urlParams.get('twinId') ? `?twinId=${urlParams.get('twinId')}` : '');
                    window.history.replaceState({}, '', newUrl);
                }
            }, 5000);
        } else {
            console.error('Banner elements not found');
        }
    }
    
    // ✅ FIX: Get chat ID from EJS variable and validate
    const chatIdFromServer = '<%= chatId || "" %>';
    currentChatId = (chatIdFromServer && chatIdFromServer !== 'null' && chatIdFromServer !== 'undefined' && chatIdFromServer.trim() !== '') ? chatIdFromServer : null;
    
    console.log('Enhanced chat initialized with chatId:', currentChatId);
    
    // ✅ SAFETY: If no valid chatId, don't proceed with API calls
    if (!currentChatId) {
        console.warn('No valid chatId from server, skipping API calls');
        const initialLoading = document.getElementById('initialLoadingState');
        if (initialLoading) initialLoading.classList.add('hidden');
        const emptyState = document.getElementById('emptyState');
        if (emptyState) emptyState.classList.remove('hidden');
        // Still set up UI listeners, but don't load chat data
    }
                
    // Mobile event listeners
    const mobileChatMenuBtn = document.getElementById('mobile-chat-menu-btn');
    const mobileChatCloseBtn = document.getElementById('mobile-chat-close-btn');
    const mobileHistoryBtn = document.getElementById('mobile-history-btn');
    const mobileNewChatBtn = document.getElementById('mobile-new-chat-btn');
    const mobileSettingsBtn = document.getElementById('mobile-settings-btn');
    
    if (mobileChatMenuBtn) {
        mobileChatMenuBtn.addEventListener('click', openMobileChatSidebar);
    }
    
    if (mobileChatCloseBtn) {
        mobileChatCloseBtn.addEventListener('click', closeMobileChatSidebar);
    }
    
    if (mobileHistoryBtn) {
        mobileHistoryBtn.addEventListener('click', openMobileChatSidebar);
    }
    
    if (mobileNewChatBtn) {
        mobileNewChatBtn.addEventListener('click', createNewChat);
    }
    
    if (mobileSettingsBtn) {
        mobileSettingsBtn.addEventListener('click', function() {
            window.open('/style-customize', '_blank');
        });
    }
    
    // Touch gesture event listeners
    document.addEventListener('touchstart', handleChatTouchStart, { passive: true });
    document.addEventListener('touchend', handleChatTouchEnd, { passive: true });
    
    // ✅ Only load chat data if currentChatId is valid
    if (currentChatId) {
        loadChatHistory();
        loadCurrentChatMessages();
    }

            // Add event listeners for quick action buttons
            document.getElementById('styleCustomizeBtn').addEventListener('click', function() {
                window.open('/style-customize', '_blank');
            });

            document.getElementById('learningBtn').addEventListener('click', function() {
                window.open('/twin-settings', '_blank');
            });

            document.getElementById('analyticsBtn').addEventListener('click', function() {
                window.open('/analytics', '_blank');
            });

            // New chat button
            document.getElementById('newChatBtn').addEventListener('click', createNewChat);

            // Quick style buttons
            document.getElementById('casualBtn').addEventListener('click', () => setStyleMode('casual'));
            document.getElementById('formalBtn').addEventListener('click', () => setStyleMode('formal'));
            document.getElementById('toggleStyleBtn').addEventListener('click', () => setStyleMode('auto'));

            // Modal event listeners
            document.getElementById('closeModalBtn').addEventListener('click', closeResponseActions);
            document.getElementById('copyBtn').addEventListener('click', () => copyResponse(currentResponseId));

            <% if (FEATURE_FLAGS.chatFeedbackUI) { %>
            document.getElementById('submitFeedbackBtn').addEventListener('click', submitModalFeedback);
            
            // Feedback buttons
            document.getElementById('thumbsUpBtn').addEventListener('click', () => giveFeedback('positive'));
            document.getElementById('thumbsDownBtn').addEventListener('click', () => giveFeedback('negative'));
            document.getElementById('regenerateBtn').addEventListener('click', () => regenerateResponse(currentResponseId));
            
            <% } %>


// Message form submission
const messageForm = document.getElementById('messageForm');
if (messageForm) {
    messageForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const messageInput = document.getElementById('messageInput');
        if (!messageInput) return;
        
        const message = messageInput.value.trim();
        if (!message) return;
        
        // ✅ ADD: Show generating indicator
        const generatingIndicator = document.getElementById('generatingIndicator');
        if (generatingIndicator) {
            generatingIndicator.classList.remove('hidden');
            // Scroll to bottom to show generating indicator
            const chatMessages = document.getElementById('chatMessages');
            if (chatMessages) {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }
        
        // Disable input and button
        messageInput.disabled = true;
        const sendBtn = document.querySelector('#messageForm button[type="submit"]');
        if (sendBtn) sendBtn.disabled = true;
        
        // ✅ FIX: Declare typingId outside try block for catch block access
        let typingId = null;
        
        try {
            // ✅ FIX: Add user message to chat UI first
            const userMessageTimestamp = new Date().toISOString();
            addMessageToChat('user', message, false, null, userMessageTimestamp);
            
            // ✅ FIX: Create typing indicator
            typingId = addMessageToChat('ai', 'Thinking...', true, null, null);

            // ✅ Check if draft chat, convert to actual chat first
let actualChatId = currentChatId;
if (currentChatId && currentChatId.startsWith('draft_')) {
    try {
        const draftData = sessionStorage.getItem('draftEnhancedChat');
        if (draftData) {
            const draft = JSON.parse(draftData);
            const response = await fetch('/api/chats/new', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                credentials: 'include',
                body: JSON.stringify({ twinId: draft.twinId })
            });
                        
                        if (!response.ok) {
                            const errorData = await response.json();
                            throw new Error(errorData.error || 'Failed to create chat');
                        }
            
            const data = await response.json();
                        
                        // ✅ PHASE 4: Use data.chatId (now tokenized) or data.chat.publicId
                        if (data.success && data.chatId) {
                            actualChatId = data.chatId;  // ✅ Now tokenized
                            currentChatId = actualChatId;
                        } else if (data.success && data.chat && data.chat.publicId) {
                            actualChatId = data.chat.publicId;  // ✅ Fallback to publicId
                            currentChatId = actualChatId;
                
                // Remove draft from sidebar
                removeDraftFromSidebar(draft.chatId);
                
                // Reload chat history to show actual chat
                await loadChatHistory();
                
                // Clear draft
                sessionStorage.removeItem('draftEnhancedChat');
                
                // Enable "New Chat" button
                const newChatBtn = document.getElementById('newChatBtn');
                if (newChatBtn) newChatBtn.disabled = false;
            } else {
                            console.error('Failed to create chat:', data);
                showNotification('Failed to create chat', 'error');
                return;
            }
                    } else {
                        showNotification('Draft data not found', 'error');
                        return;
        }
    } catch (error) {
        console.error('Error creating chat from draft:', error);
                    showNotification(error.message || 'Error creating chat', 'error');
        return;
    }
}
            
            // FIRST: Save user message to database
            await fetch(`/api/chat/${actualChatId}/send`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                credentials: 'include',
                body: JSON.stringify({ content: message })
            });

            // Clear input after saving
            messageInput.value = '';
            
            // Get current style mode from button states
            const strictStyle = document.getElementById('formalBtn').classList.contains('bg-blue-600');
            
            console.log('📡 Sending request to:', `/api/enhanced-chat/${currentChatId}/enhanced-reply`);
            console.log('Request body:', { message, strictStyle });
            
            const response = await fetch(`/api/enhanced-chat/${actualChatId}/enhanced-reply`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>',
                    credentials: 'include'
                },
                body: JSON.stringify({
                    message: message,
                    strictStyle: strictStyle
                })
            });
            
            console.log('📡 Response status:', response.status);
            const data = await response.json();
            console.log('📡 Response data:', data);
            
            if (data.success) {
                console.log('✅ Success! Adding response to chat');
                // Remove typing indicator
                removeMessage(typingId);
                
                // ✅ Hide generating indicator after response
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                
                // ✅ IMMEDIATE: Update sidebar BEFORE typing starts (last message only)
                updateSidebarImmediately(data.response, message);
                
                // ✅ Display with character-by-character typing effect
                const responseId = displayWithTypingEffect('ai', data.response, {
                    intent: data.intent,
                    criticScore: data.criticScore,
                    latency: data.latency,
                    timestamp: data.timestamp || new Date().toISOString()
                }, (messageId) => {
                    // Callback after typing completes
                    // Store response metadata for actions
                    currentResponse = data.response;
                    currentResponseId = messageId;
                    responseMetadata = {
                        intent: data.intent,
                        criticScore: data.criticScore,
                        latency: data.latency
                    };
                    
                    // Update display
                    updateIntentDisplay(data.intent);
                    updateCriticScore(data.criticScore);
                });
                
                // ✅ IMMEDIATE: Add response actions button (with delay to ensure container exists)
                setTimeout(() => {
                    addResponseActionsButton(responseId);
                }, 200); // 200ms delay to ensure actions container is created
                
                // ✅ Update title if generated
                if (data.generatedTitle) {
                    console.log('📝 Title generated:', data.generatedTitle);
                    // Update title in sidebar immediately
                    const currentChatItem = document.querySelector(`.chat-item[data-chat-id="${currentChatId}"]`);
                    if (currentChatItem) {
                        const titleElement = currentChatItem.querySelector('h4');
                        if (titleElement) {
                            titleElement.textContent = data.generatedTitle;
                            console.log('✅ Title updated in sidebar:', data.generatedTitle);
                        }
                    }
                }
                
                // ✅ Refresh chat history after a delay (to sync with backend - this will update count and title correctly)
                setTimeout(() => {
                    loadChatHistory();
                }, 1000);
                
                // ✅ RE-ENABLE: Input and button after successful response
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
                
            } else {
                console.log('❌ API returned error:', data.error);
                removeMessage(typingId);
                // Hide generating indicator on error
                if (generatingIndicator) {
                    generatingIndicator.classList.add('hidden');
                }
                addMessageToChat('ai', 'Sorry, I had trouble processing that. Please try again.', false, null, new Date().toISOString());
                
                // ✅ RE-ENABLE: Input and button on error
                messageInput.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
            }
        } catch (error) {
            // Hide generating indicator on error
            if (generatingIndicator) {
                generatingIndicator.classList.add('hidden');
            }
            
            // ✅ Safety check: Remove typing indicator if it exists
            if (typingId) {
                removeMessage(typingId);
            }
            
            // ✅ RE-ENABLE: Input and button on exception
            messageInput.disabled = false;
            if (sendBtn) sendBtn.disabled = false;
            
            console.error('Error sending message:', error);
            showNotification('Error sending message', 'error');
        }
    });
      }   

        // Character counter
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.addEventListener('input', (e) => {
                const count = e.target.value.length;
                const charCount = document.getElementById('charCount');
                if (charCount) {
                    charCount.textContent = count;
                }
            });
        }

        // Handle Enter key for submission (Enter = submit, Shift+Enter = new line)
        if (messageInput) {
            messageInput.addEventListener('keydown', function(e) {
                // If Enter is pressed without Shift, submit the form
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault(); // Prevent default newline behavior
                    // Trigger form submission
                    const messageForm = document.getElementById('messageForm');
                    if (messageForm) {
                        messageForm.dispatchEvent(new Event('submit'));
                    }
                }
                // If Shift+Enter is pressed, allow default behavior (new line)
            });
        }

        }); // Close DOMContentLoaded        

        document.addEventListener('DOMContentLoaded', () => {
    const newChatBtn = document.getElementById('newChatBtn');
    if (newChatBtn) {
        newChatBtn.addEventListener('click', createNewChat);
        newChatBtn.disabled = false;
    }
});

</script>

