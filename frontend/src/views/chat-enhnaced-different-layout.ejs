    <script>
        // Mobile chat functionality
        function openMobileChatSidebar() {
            const sidebar = document.getElementById('mobile-chat-sidebar');
            if (sidebar) {
                sidebar.classList.remove('translate-x-full');
                sidebar.classList.add('translate-x-0');
                document.body.style.overflow = 'hidden';
            }
        }
        
        function closeMobileChatSidebar() {
            const sidebar = document.getElementById('mobile-chat-sidebar');
            if (sidebar) {
                sidebar.classList.add('translate-x-full');
                sidebar.classList.remove('translate-x-0');
                document.body.style.overflow = '';
            }
        }
        
        // Touch gesture handling for chat
        let chatTouchStartX = 0;
        let chatTouchStartY = 0;
        
        function handleChatTouchStart(e) {
            chatTouchStartX = e.touches[0].clientX;
            chatTouchStartY = e.touches[0].clientY;
        }
        
        function handleChatTouchEnd(e) {
            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const deltaX = touchEndX - chatTouchStartX;
            const deltaY = touchEndY - chatTouchStartY;
            
            // Check if it's a horizontal swipe
            if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
                const sidebar = document.getElementById('mobile-chat-sidebar');
                
                if (deltaX < 0 && sidebar && sidebar.classList.contains('translate-x-0')) {
                    // Swipe left to close sidebar
                    closeMobileChatSidebar();
                } else if (deltaX > 0 && sidebar && sidebar.classList.contains('translate-x-full')) {
                    // Swipe right to open sidebar
                    openMobileChatSidebar();
                }
            }
        }

        // Global variables
        let currentChatId = null;
        let currentResponse = null;
        let currentResponseId = null;
        let responseMetadata = null;

async function upvoteResponse(responseId) {
    await submitFeedback(responseId, 'positive', null);
    showNotification('Thanks for the feedback! 👍', 'success');
    disableFeedbackButtons(responseId, 'positive');
}

async function downvoteResponse(responseId) {
    try {
        // Show review modal for bad responses
        const review = await window.ModalHelpers.input({
            title: 'What could be improved?',
            message: 'Please provide feedback on what could be improved in this response:',
            placeholder: 'Enter your feedback...'
        });
        
        if (review && review.trim()) {
            await submitFeedback(responseId, 'negative', review);
            showNotification('Thanks for the feedback! 👎', 'success');
            disableFeedbackButtons(responseId, 'negative');
        } else {
            showNotification('Feedback cancelled', 'info');
        }
    } catch (error) {
        console.error('Downvote error:', error);
        showNotification('Error submitting feedback', 'error');
    }
}

        function copyResponse(responseId) {
            const responseElement = document.getElementById(responseId);
            if (responseElement) {
                // Get only the main content, not the timestamp
                const contentDiv = responseElement.querySelector('.bg-white.border, .message-content, .response-content');
