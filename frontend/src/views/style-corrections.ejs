<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Style Corrections</h1>
            <p class="text-gray-600">Fine-tune your AI twin's communication style based on feedback</p>
        </div>

        <!-- Twin Selection -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4">Select Twin</h2>
            <div class="flex items-center space-x-4">
                <select id="twinSelect" class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Loading twins...</option>
                </select>
                <button id="loadTwins" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600">
                    Load Twins
                </button>
            </div>
        </div>

        <!-- Quick Correction Interface -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4">Quick Style Adjustments</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-medium mb-2">Response Length</h3>
                    <div class="flex items-center space-x-2">
                        <button class="correction-btn bg-red-100 text-red-700 px-3 py-1 rounded text-sm" data-knob="shorter" data-delta="-1">
                            Shorter
                        </button>
                        <button class="correction-btn bg-green-100 text-green-700 px-3 py-1 rounded text-sm" data-knob="shorter" data-delta="1">
                            Longer
                        </button>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-medium mb-2">Formality</h3>
                    <div class="flex items-center space-x-2">
                        <button class="correction-btn bg-red-100 text-red-700 px-3 py-1 rounded text-sm" data-knob="casual" data-delta="-1">
                            More Casual
                        </button>
                        <button class="correction-btn bg-green-100 text-green-700 px-3 py-1 rounded text-sm" data-knob="formal" data-delta="1">
                            More Formal
                        </button>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-medium mb-2">Emoji Usage</h3>
                    <div class="flex items-center space-x-2">
                        <button class="correction-btn bg-red-100 text-red-700 px-3 py-1 rounded text-sm" data-knob="emoji_off" data-delta="-1">
                            Less Emojis
                        </button>
                        <button class="correction-btn bg-green-100 text-green-700 px-3 py-1 rounded text-sm" data-knob="emoji_off" data-delta="1">
                            More Emojis
                        </button>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-medium mb-2">Humor Style</h3>
                    <div class="flex items-center space-x-2">
                        <button class="correction-btn bg-red-100 text-red-700 px-3 py-1 rounded text-sm" data-knob="humor" data-delta="-1">
                            Less Humor
                        </button>
                        <button class="correction-btn bg-green-100 text-green-700 px-3 py-1 rounded text-sm" data-knob="punchline" data-delta="1">
                            More Witty
                        </button>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-medium mb-2">Question Frequency</h3>
                    <div class="flex items-center space-x-2">
                        <button class="correction-btn bg-red-100 text-red-700 px-3 py-1 rounded text-sm" data-knob="question_freq" data-delta="-1">
                            Fewer Questions
                        </button>
                        <button class="correction-btn bg-green-100 text-green-700 px-3 py-1 rounded text-sm" data-knob="question_freq" data-delta="1">
                            More Questions
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Correction History -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold">Correction History</h2>
                <button id="applyCorrections" class="bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600">
                    Apply All Corrections
                </button>
            </div>
            <div id="correctionsList" class="space-y-2">
                <!-- Corrections will be loaded here -->
            </div>
        </div>

        <!-- Correction Statistics -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold mb-4">Correction Statistics</h2>
            <div id="correctionStats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Stats will be loaded here -->
            </div>
        </div>
    </div>

    <script>
        let currentTwinId = null;

        // Load twins on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadTwins();
        });

        // Load twins
        async function loadTwins() {
            try {
                const response = await fetch('/api/twin', {
                    credentials: 'include'
                });
                const twins = await response.json();
                
                const select = document.getElementById('twinSelect');
                select.innerHTML = '<option value="">Select a twin...</option>';
                
                twins.forEach(twin => {
                    const option = document.createElement('option');
                    option.value = twin.id;
                    option.textContent = twin.name || `Twin ${twin.id}`;
                    select.appendChild(option);
                });
            } catch (error) {
                console.error('Error loading twins:', error);
            }
        }

        // Handle twin selection
        document.getElementById('twinSelect').addEventListener('change', function() {
            currentTwinId = this.value;
            if (currentTwinId) {
                loadCorrections();
                loadCorrectionStats();
            }
        });

        // Handle correction buttons
        document.addEventListener('click', async function(e) {
            if (e.target.classList.contains('correction-btn')) {
                if (!currentTwinId) {
                    alert('Please select a twin first');
                    return;
                }

                const knob = e.target.dataset.knob;
                const delta = parseInt(e.target.dataset.delta);
                const source = 'manual_adjustment';

                try {
                    const response = await fetch(`/api/style-corrections/${currentTwinId}/style/corrections`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include',
                        body: JSON.stringify({ knob, delta, source })
                    });

                    if (response.ok) {
                        const correction = await response.json();
                        showNotification('Correction added successfully!', 'success');
                        loadCorrections();
                        loadCorrectionStats();
                    } else {
                        throw new Error('Failed to add correction');
                    }
                } catch (error) {
                    console.error('Error adding correction:', error);
                    showNotification('Failed to add correction', 'error');
                }
            }
        });

        // Load corrections
        async function loadCorrections() {
            if (!currentTwinId) return;

            try {
                const response = await fetch(`/api/style-corrections/${currentTwinId}/style/corrections`, {
                    credentials: 'include'
                });
                const corrections = await response.json();
                
                const container = document.getElementById('correctionsList');
                container.innerHTML = '';

                if (corrections.length === 0) {
                    container.innerHTML = '<p class="text-gray-500 text-center py-4">No corrections yet</p>';
                    return;
                }

                corrections.forEach(correction => {
                    const div = document.createElement('div');
                    div.className = 'flex items-center justify-between p-3 bg-gray-50 rounded-lg';
                    div.innerHTML = `
                        <div>
                            <span class="font-medium">${correction.knob}</span>
                            <span class="text-sm text-gray-600 ml-2">${correction.delta > 0 ? '+' : ''}${correction.delta}</span>
                            ${correction.source ? `<span class="text-xs text-gray-500 ml-2">(${correction.source})</span>` : ''}
                        </div>
                        <div class="text-sm text-gray-500">
                            ${new Date(correction.ts).toLocaleDateString()}
                        </div>
                    `;
                    container.appendChild(div);
                });
            } catch (error) {
                console.error('Error loading corrections:', error);
            }
        }

        // Load correction statistics
        async function loadCorrectionStats() {
            if (!currentTwinId) return;

            try {
                const response = await fetch(`/api/style-corrections/${currentTwinId}/style/corrections/stats`, {
                    credentials: 'include'
                });
                const stats = await response.json();
                
                const container = document.getElementById('correctionStats');
                container.innerHTML = '';

                if (stats.length === 0) {
                    container.innerHTML = '<p class="text-gray-500 text-center py-4">No statistics available</p>';
                    return;
                }

                stats.forEach(stat => {
                    const div = document.createElement('div');
                    div.className = 'bg-gray-50 rounded-lg p-4';
                    div.innerHTML = `
                        <h3 class="font-medium text-gray-900">${stat.knob}</h3>
                        <div class="mt-2 space-y-1">
                            <div class="text-sm text-gray-600">Total: ${stat.count}</div>
                            <div class="text-sm text-gray-600">Avg Delta: ${parseFloat(stat.avg_delta).toFixed(2)}</div>
                            <div class="text-sm text-green-600">Positive: ${stat.positive_count}</div>
                            <div class="text-sm text-red-600">Negative: ${stat.negative_count}</div>
                        </div>
                    `;
                    container.appendChild(div);
                });
            } catch (error) {
                console.error('Error loading correction stats:', error);
            }
        }

        // Apply corrections
        document.getElementById('applyCorrections').addEventListener('click', async function() {
            if (!currentTwinId) {
                alert('Please select a twin first');
                return;
            }

            try {
                const response = await fetch(`/api/style-corrections/${currentTwinId}/style/corrections/apply`, {
                    method: 'POST',
                    credentials: 'include'
                });

                if (response.ok) {
                    const result = await response.json();
                    showNotification('Corrections applied successfully!', 'success');
                    console.log('Updated style vector:', result.updatedStyleVector);
                } else {
                    throw new Error('Failed to apply corrections');
                }
            } catch (error) {
                console.error('Error applying corrections:', error);
                showNotification('Failed to apply corrections', 'error');
            }
        });

        // Show notification
        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-md shadow-lg z-50 ${
                type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
            }`;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }
    </script>
</body>
</html>
