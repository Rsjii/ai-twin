<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .message-card { transition: all 0.3s ease; }
        .message-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        .message-content { max-width: 300px; word-wrap: break-word; }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/analytics" class="text-xl font-bold text-gray-900">← Back to Analytics</a>
                    <span class="ml-4 px-3 py-1 bg-orange-100 text-orange-800 text-sm font-medium rounded-full">Messages</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <img src="<%= user.profileImage || '/uploads/profiles/default.jpg' %>" alt="Profile" class="w-8 h-8 rounded-full">
                        <span class="text-sm font-medium text-gray-700"><%= user.handle || user.email %></span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Messages Analytics</h1>
            <p class="text-gray-600 mt-2">Detailed messages analytics and management</p>
        </div>

        <!-- Summary Cards -->
        <div id="summaryCards" class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow-sm p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-orange-100 rounded-lg">
                        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Messages</p>
                        <p class="text-2xl font-bold text-gray-900" id="totalMessages">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-blue-100 rounded-lg">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">New Today</p>
                        <p class="text-2xl font-bold text-gray-900" id="newToday">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-green-100 rounded-lg">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">New This Week</p>
                        <p class="text-2xl font-bold text-gray-900" id="newThisWeek">-</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-6">
                <div class="flex items-center">
                    <div class="p-2 bg-purple-100 rounded-lg">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Avg Length</p>
                        <p class="text-2xl font-bold text-gray-900" id="avgLength">-</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search and Filters -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                    <input type="text" id="searchInput" placeholder="Search messages by content, user email or handle..." 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                </div>
                <div class="flex gap-2">
                    <select id="sortBy" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500">
                        <option value="createdAt">Sort by Date</option>
                        <option value="content">Sort by Content</option>
                        <option value="role">Sort by Role</option>
                    </select>
                    <select id="sortOrder" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500">
                        <option value="DESC">Newest First</option>
                        <option value="ASC">Oldest First</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Messages List -->
        <div class="bg-white rounded-lg shadow-sm">
            <div class="p-6 border-b">
                <h3 class="text-lg font-semibold text-gray-900">Messages List</h3>
            </div>
            <div id="messagesList" class="divide-y divide-gray-200">
                <div class="p-8 text-center">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-orange-600"></div>
                    <p class="text-gray-600 mt-4">Loading messages...</p>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-8 flex justify-center">
            <!-- Pagination will be loaded here -->
        </div>
    </div>

    <script>
        let currentPage = 1;
        let currentSearch = '';
        let currentSortBy = 'createdAt';
        let currentSortOrder = 'DESC';

        // Load messages data
        async function loadMessagesData() {
            try {
                const params = new URLSearchParams({
                    page: currentPage,
                    limit: 10,
                    search: currentSearch,
                    sortBy: currentSortBy,
                    sortOrder: currentSortOrder
                });

                const response = await fetch(`/api/admin/analytics/page/messages?${params}`);
                const data = await response.json();

                if (data.success) {
                    // Update summary cards
                    document.getElementById('totalMessages').textContent = data.data.summary.totalMessages;
                    document.getElementById('newToday').textContent = data.data.summary.newToday;
                    document.getElementById('newThisWeek').textContent = data.data.summary.newThisWeek;
                    document.getElementById('avgLength').textContent = Math.round(data.data.summary.avgMessageLength || 0);

                    // Update messages list
                    updateMessagesList(data.data.messages);
                    
                    // Update pagination
                    updatePagination(data.data.pagination);
                } else {
                    showError('Failed to load messages data: ' + data.error);
                }
            } catch (error) {
                console.error('Load messages error:', error);
                showError('Error loading messages data');
            }
        }

        // Update messages list
        function updateMessagesList(messages) {
            const messagesList = document.getElementById('messagesList');
            
            if (messages && messages.length > 0) {
                messagesList.innerHTML = messages.map(message => `
                    <div class="message-card p-6 hover:bg-gray-50">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start space-x-4">
                                <div class="w-10 h-10 ${message.role === 'user' ? 'bg-blue-500' : 'bg-orange-500'} rounded-full flex items-center justify-center text-white font-bold text-sm">
                                    ${message.role === 'user' ? 'U' : 'T'}
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center space-x-2 mb-2">
                                        <h4 class="text-sm font-semibold text-gray-900">${message.userHandle || message.userEmail || 'Unknown'}</h4>
                                        <span class="px-2 py-1 text-xs rounded-full ${message.role === 'user' ? 'bg-blue-100 text-blue-800' : 'bg-orange-100 text-orange-800'}">
                                            ${message.role === 'user' ? 'User' : 'Twin'}
                                        </span>
                                    </div>
                                    <div class="message-content">
                                        <p class="text-sm text-gray-700 mb-2">${message.content ? message.content.substring(0, 200) + (message.content.length > 200 ? '...' : '') : 'No content'}</p>
                                        <div class="flex items-center space-x-4 text-xs text-gray-500">
                                            <span>Chat ID: ${message.chatId}</span>
                                            <span>Twin: ${message.twinName || 'N/A'}</span>
                                            <span>${new Date(message.createdAt).toLocaleString()}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex space-x-2">
                                <button onclick="viewMessageDetails('${message.id}')" class="px-3 py-1 bg-orange-100 text-orange-700 rounded text-sm hover:bg-orange-200">
                                    View Full
                                </button>
                                <button onclick="viewChatMessages('${message.chatId}')" class="px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200">
                                    View Chat
                                </button>
                                <button onclick="viewUserProfile('${message.userId}')" class="px-3 py-1 bg-green-100 text-green-700 rounded text-sm hover:bg-green-200">
                                    View User
                                </button>
                            </div>
                        </div>
                    </div>
                `).join('');
            } else {
                messagesList.innerHTML = '<div class="p-8 text-center text-gray-500">No messages found</div>';
            }
        }

        // Update pagination
        function updatePagination(pagination) {
            const paginationDiv = document.getElementById('pagination');
            const { currentPage, totalPages, totalItems } = pagination;
            
            let paginationHTML = '<div class="flex items-center space-x-2">';
            
            // Previous button
            if (currentPage > 1) {
                paginationHTML += `<button onclick="changePage(${currentPage - 1})" class="px-3 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Previous</button>`;
            }
            
            // Page numbers
            for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
                paginationHTML += `<button onclick="changePage(${i})" class="px-3 py-2 ${i === currentPage ? 'bg-orange-600 text-white' : 'bg-white border border-gray-300 hover:bg-gray-50'} rounded-lg">${i}</button>`;
            }
            
            // Next button
            if (currentPage < totalPages) {
                paginationHTML += `<button onclick="changePage(${currentPage + 1})" class="px-3 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Next</button>`;
            }
            
            paginationHTML += '</div>';
            paginationHTML += `<div class="ml-4 text-sm text-gray-600">Showing ${((currentPage - 1) * 10) + 1}-${Math.min(currentPage * 10, totalItems)} of ${totalItems} messages</div>`;
            
            paginationDiv.innerHTML = paginationHTML;
        }

        // Change page
        function changePage(page) {
            currentPage = page;
            loadMessagesData();
        }

        // Search messages
        function searchMessages() {
            currentSearch = document.getElementById('searchInput').value;
            currentPage = 1;
            loadMessagesData();
        }

        // View message details
        async function viewMessageDetails(messageId) {
            try {
                // Open message details in new window
                const messageWindow = window.open('', '_blank', 'width=800,height=600,scrollbars=yes,resizable=yes');
                messageWindow.document.write(`
                    <html>
                    <head>
                        <title>Message Details</title>
                        <style>
                            body { font-family: Arial, sans-serif; padding: 20px; }
                            .message-detail { background: #f5f5f5; padding: 15px; border-radius: 8px; margin: 10px 0; }
                        </style>
                    </head>
                    <body>
                        <h2>Message Details</h2>
                        <p>Message ID: ${messageId}</p>
                        <div class="message-detail">
                            <p>Loading message details...</p>
                        </div>
                    </body>
                    </html>
                `);
            } catch (error) {
                console.error('View message details error:', error);
                alert('Error loading message details');
            }
        }

        // View chat messages
        async function viewChatMessages(chatId) {
            try {
                // Open chat messages in new window
                const chatWindow = window.open('', '_blank', 'width=1000,height=700,scrollbars=yes,resizable=yes');
                chatWindow.document.write(`
                    <html>
                    <head>
                        <title>Chat Messages</title>
                        <style>
                            body { font-family: Arial, sans-serif; padding: 20px; }
                            .chat-container { max-height: 500px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; margin: 10px 0; }
                            .message { margin: 10px 0; padding: 10px; border-radius: 5px; }
                            .user-message { background-color: #e3f2fd; margin-left: 20px; }
                            .twin-message { background-color: #f3e5f5; margin-right: 20px; }
                        </style>
                    </head>
                    <body>
                        <h2>Chat Messages</h2>
                        <p>Chat ID: ${chatId}</p>
                        <div class="chat-container">
                            <p>Loading chat messages...</p>
                        </div>
                    </body>
                    </html>
                `);
            } catch (error) {
                console.error('View chat messages error:', error);
                alert('Error loading chat messages');
            }
        }

        // View user profile
        async function viewUserProfile(userId) {
            try {
                const response = await fetch(`/api/admin/analytics/user/${userId}/detailed`);
                const data = await response.json();
                
                if (data.success) {
                    // Open user details in new window
                    const userWindow = window.open('', '_blank', 'width=800,height=600,scrollbars=yes,resizable=yes');
                    userWindow.document.write(`
                        <html>
                        <head><title>User Profile</title></head>
                        <body style="font-family: Arial, sans-serif; padding: 20px;">
                            <h2>User Profile</h2>
                            <pre>${JSON.stringify(data.data, null, 2)}</pre>
                        </body>
                        </html>
                    `);
                }
            } catch (error) {
                console.error('View user profile error:', error);
                alert('Error loading user profile');
            }
        }

        // Show error
        function showError(message) {
            const messagesList = document.getElementById('messagesList');
            messagesList.innerHTML = `<div class="p-8 text-center text-red-600">${message}</div>`;
        }

        // Event listeners
        document.getElementById('searchInput').addEventListener('input', debounce(searchMessages, 300));
        document.getElementById('sortBy').addEventListener('change', (e) => {
            currentSortBy = e.target.value;
            loadMessagesData();
        });
        document.getElementById('sortOrder').addEventListener('change', (e) => {
            currentSortOrder = e.target.value;
            loadMessagesData();
        });

        // Debounce function
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Load data on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadMessagesData();
        });
    </script>
</body>
</html>
