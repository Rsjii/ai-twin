<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                        success: '#10b981',
                        warning: '#f59e0b',
                        danger: '#ef4444',
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-in-out',
                        'slide-up': 'slideUp 0.3s ease-out',
                        'bounce-gentle': 'bounceGentle 2s infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(10px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        },
                        bounceGentle: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-5px)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 min-h-screen font-inter">
    <!-- Main Content -->
    <main class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl w-full animate-fade-in">
            <div class="glass-effect rounded-3xl shadow-2xl border border-white/20 p-8">
                <!-- Logo Header -->
                <div class="text-center mb-8">
                    <div class="w-16 h-16 bg-gradient-to-r from-primary to-accent rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <h1 class="text-3xl font-bold gradient-text mb-2">Profile Settings</h1>
                    <p class="text-gray-600">Manage your personal information</p>
                </div>
                
                <div class="flex justify-between items-center mb-6">
                    <button type="submit" form="profileForm" class="bg-gradient-to-r from-success to-green-500 text-white px-8 py-4 rounded-xl hover:shadow-lg transition-all duration-300 font-semibold transform hover:scale-[1.02]">
                        Update Profile
                    </button>
                </div>
                
                <form id="profileForm">
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Email</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                                </svg>
                            </div>
                            <input type="email" name="email" value="<%= user.email %>" readonly class="w-full pl-12 pr-4 py-4 bg-white/50 border border-white/30 rounded-xl backdrop-blur-sm">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Name</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <input type="text" name="name" value="<%= user.name || '' %>" class="w-full pl-12 pr-4 py-4 bg-white/80 border border-white/30 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent backdrop-blur-sm transition-all duration-200">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Handle</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                            </div>
                            <input type="text" name="handle" value="<%= user.handle || '' %>" class="w-full pl-12 pr-4 py-4 bg-white/80 border border-white/30 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent backdrop-blur-sm transition-all duration-200">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Date of Birth</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <input type="date" name="dob" value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>" class="w-full pl-12 pr-4 py-4 bg-white/80 border border-white/30 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent backdrop-blur-sm transition-all duration-200">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Phone</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                            </div>
                            <input type="tel" name="phone" value="<%= user.phone || '' %>" class="w-full pl-12 pr-4 py-4 bg-white/80 border border-white/30 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent backdrop-blur-sm transition-all duration-200">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Member Since</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <input type="text" value="<%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A' %>" readonly class="w-full pl-12 pr-4 py-4 bg-white/50 border border-white/30 rounded-xl backdrop-blur-sm">
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Bio</label>
                        <div class="relative">
                            <div class="absolute top-4 left-4 pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                                </svg>
                            </div>
                            <textarea name="bio" rows="4" class="w-full pl-12 pr-4 py-4 bg-white/80 border border-white/30 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent backdrop-blur-sm transition-all duration-200 resize-none"><%= user.bio || '' %></textarea>
                        </div>
                    </div>
                </form>
                
                <div class="text-center mt-6">
                    <a href="/dashboard" class="text-primary hover:text-secondary transition-colors duration-200 font-medium">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </main>

    <!-- Modern Footer -->
    <footer class="mt-20 bg-white/80 backdrop-blur-xl border-t border-white/20">
        <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- Brand -->
                <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-xl flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                        </div>
                        <span class="text-2xl font-bold gradient-text">AI Twin</span>
                    </div>
                    <p class="text-gray-600 mb-4 max-w-md">
                        Create your digital twin with AI technology. Experience the future of personalized AI assistants.
                    </p>
                </div>
                
                <!-- Quick Links -->
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Links</h3>
                    <ul class="space-y-3">
                        <li><a href="/dashboard" class="text-gray-600 hover:text-primary transition-colors duration-200">Dashboard</a></li>
                        <li><a href="/profile" class="text-gray-600 hover:text-primary transition-colors duration-200">Profile</a></li>
                        <li><a href="/change-password" class="text-gray-600 hover:text-primary transition-colors duration-200">Change Password</a></li>
                        <li><a href="/auth" class="text-gray-600 hover:text-primary transition-colors duration-200">Login</a></li>
                    </ul>
                </div>
                
                <!-- Support -->
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Support</h3>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-gray-600 hover:text-primary transition-colors duration-200">Help Center</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-primary transition-colors duration-200">Contact Us</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-primary transition-colors duration-200">Privacy Policy</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-primary transition-colors duration-200">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="border-t border-gray-200/50 mt-12 pt-8">
                <div class="flex flex-col md:flex-row justify-between items-center">
                    <p class="text-gray-500 text-sm">&copy; 2024 AI Twin. All rights reserved.</p>
                    <div class="flex items-center space-x-2 mt-4 md:mt-0">
                        <span class="text-xs text-gray-400">AI-generated content</span>
                        <div class="w-2 h-2 bg-gradient-to-r from-primary to-accent rounded-full animate-bounce-gentle"></div>
                        <span class="text-xs text-gray-400">Private Alpha</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    
    <script>
        // Global variables
        window.csrfToken = '<%= csrfToken %>';
        
        // Debug function
        function debugLog(message) {
            console.log('Profile Debug:', message);
        }
        
        // Wait for DOM to load
        document.addEventListener('DOMContentLoaded', function() {
            debugLog('DOM loaded, setting up form submission');
            
            // Set up form submission
            const profileForm = document.getElementById('profileForm');
            if (profileForm) {
                profileForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    debugLog('Form submitted');
                    
                    const formData = new FormData(e.target);
                    const data = {
                        name: formData.get('name'),
                        handle: formData.get('handle'),
                        dob: formData.get('dob'),
                        phone: formData.get('phone'),
                        bio: formData.get('bio')
                    };
                    
                    debugLog('Form data:', data);
                    
                    try {
                        const token = localStorage.getItem('jwtToken');
                        debugLog('JWT token found:', token ? 'yes' : 'no');
                        
                        const response = await fetch('/api/profile/update', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': window.csrfToken,
                                'Authorization': token ? `Bearer ${token}` : ''
                            },
                            body: JSON.stringify(data)
                        });
                        
                        const result = await response.json();
                        debugLog('Response:', result);
                        
                        if (response.ok) {
                            alert('Profile updated successfully!');
                            // Reload the page to show updated data
                            window.location.reload();
                        } else {
                            alert(result.error || 'Failed to update profile');
                        }
                    } catch (error) {
                        console.error('Profile update error:', error);
                        alert('Network error. Please try again.');
                    }
                });
            } else {
                debugLog('Profile form not found!');
            }
            
            debugLog('All functions loaded and ready');
        });
    </script>
</body>
</html>
