<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .primary { color: #3B82F6; }
        .bg-primary { background-color: #3B82F6; }
        .hover\:bg-secondary:hover { background-color: #1D4ED8; }
        .focus\:ring-primary:focus { --tw-ring-color: #3B82F6; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="px-4 py-6 sm:px-0">
        <div class="max-w-md mx-auto">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <h1 class="text-2xl font-bold text-gray-900 mb-6 text-center">Forgot Password</h1>
                <p class="text-gray-600 text-center mb-6">
                    Enter your email address and we'll send you a verification code to reset your password.
                </p>
                
                <!-- Flash Messages -->
                <div id="flashMessage" class="hidden mb-4 p-3 rounded-lg"></div>
                
                <form id="forgotPasswordForm">
                    <div class="mb-4">
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email address" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required>
                    </div>
                    
                    <button type="submit" class="w-full bg-primary text-white py-3 px-6 rounded-lg hover:bg-secondary transition-colors font-semibold mb-4">Send Reset Code</button>
                    
                    <div class="text-center">
                        <a href="/auth" class="text-sm text-gray-600 hover:text-primary">← Back to Login</a>
                    </div>
                    
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
            </div>
        </div>
    </div>

    <script>
        window.csrfToken = '<%= csrfToken %>';
        
        // Flash message handling
        function showFlashMessage(message, type = 'success') {
            const flashDiv = document.getElementById('flashMessage');
            flashDiv.textContent = message;
            flashDiv.className = `mb-4 p-3 rounded-lg ${type === 'success' ? 'bg-green-100 text-green-700 border border-green-400' : 'bg-red-100 text-red-700 border border-red-400'}`;
            flashDiv.style.display = 'block';
            
            setTimeout(() => {
                flashDiv.style.display = 'none';
            }, 5000);
        }
        
        // Form submission
        document.getElementById('forgotPasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const data = {
                email: formData.get('email')
            };
            
            try {
                const response = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': window.csrfToken
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    showFlashMessage('Reset code sent to your email!', 'success');
                    // Redirect to verification page
                    setTimeout(() => {
                        window.location.href = result.redirect || '/forgot-password/verify?email=' + encodeURIComponent(data.email);
                    }, 1500);
                } else {
                    showFlashMessage(result.error || 'Failed to send reset code', 'error');
                }
            } catch (error) {
                console.error('Forgot password error:', error);
                showFlashMessage('Network error. Please try again.', 'error');
            }
        });
    </script>
</body>
</html>
