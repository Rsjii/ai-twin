<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#4f46e5',
                        accent: '#8b5cf6',
                    },
                }
            }
        }
    </script>
    <script>
        // Immediate theme application to prevent FOUC
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.classList.toggle('dark', theme === 'dark');
        })();
    </script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">AI Runs Analytics</h1>
            <p class="text-gray-600 dark:text-gray-300">Monitor and analyze your AI twin's performance and quality metrics</p>
        </div>

        <!-- Quality Dashboard -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md dark:shadow-gray-900 p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Quality Dashboard</h2>
            <div id="qualityMetrics" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                <!-- Quality metrics will be loaded here -->
            </div>
            
            <!-- Quality Trends Chart -->
            <div class="mb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Quality Trends (Last 7 Days)</h3>
                <canvas id="qualityTrendsChart" width="400" height="200"></canvas>
            </div>

            <!-- Mode Performance Chart -->
            <div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Performance by Mode</h3>
                <canvas id="modePerformanceChart" width="400" height="200"></canvas>
            </div>
        </div>

        <!-- Run Statistics -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md dark:shadow-gray-900 p-6 mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Run Statistics</h2>
                <div class="flex items-center space-x-4">
                    <select id="daysFilter" class="border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-md px-3 py-2">
                        <option value="7">Last 7 days</option>
                        <option value="30" selected>Last 30 days</option>
                        <option value="90">Last 90 days</option>
                    </select>
                    <button id="refreshStats" class="bg-blue-500 dark:bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-600 dark:hover:bg-blue-700">
                        Refresh
                    </button>
                </div>
            </div>
            <div id="runStats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Run stats will be loaded here -->
            </div>
        </div>

        <!-- Recent Runs -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md dark:shadow-gray-900 p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Recent Runs</h2>
                <div class="flex items-center space-x-4">
                    <select id="modeFilter" class="border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-md px-3 py-2">
                        <option value="">All Modes</option>
                        <option value="human">Human</option>
                        <option value="ai2ai">AI to AI</option>
                    </select>
                    <button id="loadRuns" class="bg-blue-500 dark:bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-600 dark:hover:bg-blue-700">
                        Load Runs
                    </button>
                </div>
            </div>
            <div id="runsList" class="space-y-2">
                <!-- Runs will be loaded here -->
            </div>
        </div>
    </div>

    <script>
    // Auto-load data for the current twin
    let currentTwinId = '<%= twinId %>';
    let qualityTrendsChart = null;
    let modePerformanceChart = null;
 
    document.addEventListener('DOMContentLoaded', function() {
        loadQualityDashboard();
        loadRunStats();
        loadRuns();
    });
        // Load quality dashboard
        async function loadQualityDashboard() {
            if (!currentTwinId) return;

            try {
                const response = await fetch(`/api/ai-runs/${currentTwinId}/runs/quality-dashboard`, {
                    credentials: 'include'
                });
                const data = await response.json();
                
                // Display quality metrics
                const container = document.getElementById('qualityMetrics');
                container.innerHTML = '';

                if (data.qualityMetrics) {
                    const metrics = data.qualityMetrics;
                    const metricsData = [
                        { label: 'Average Quality', value: metrics.avg_quality ? parseFloat(metrics.avg_quality).toFixed(2) : 'N/A', color: 'blue' },
                        { label: 'Total Runs', value: metrics.total_runs || '0', color: 'green' },
                        { label: 'High Quality Runs', value: metrics.high_quality_runs || '0', color: 'green' },
                        { label: 'Average Latency', value: metrics.avg_latency ? `${parseFloat(metrics.avg_latency).toFixed(0)}ms` : 'N/A', color: 'purple' }
                    ];

                    metricsData.forEach(metric => {
                        const div = document.createElement('div');
                        const colorMap = {
                            blue: { bg: 'bg-blue-50 dark:bg-blue-900/20', border: 'border-blue-200 dark:border-blue-800', text: 'text-blue-900 dark:text-blue-200', textBold: 'text-blue-700 dark:text-blue-300' },
                            green: { bg: 'bg-green-50 dark:bg-green-900/20', border: 'border-green-200 dark:border-green-800', text: 'text-green-900 dark:text-green-200', textBold: 'text-green-700 dark:text-green-300' },
                            purple: { bg: 'bg-purple-50 dark:bg-purple-900/20', border: 'border-purple-200 dark:border-purple-800', text: 'text-purple-900 dark:text-purple-200', textBold: 'text-purple-700 dark:text-purple-300' }
                        };
                        const colors = colorMap[metric.color] || colorMap.blue;
                        div.className = `${colors.bg} ${colors.border} border rounded-lg p-4`;
                        div.innerHTML = `
                            <h3 class="font-medium ${colors.text}">${metric.label}</h3>
                            <p class="text-2xl font-bold ${colors.textBold}">${metric.value}</p>
                        `;
                        container.appendChild(div);
                    });
                }

                // Create quality trends chart
                if (data.recentTrends && data.recentTrends.length > 0) {
                    createQualityTrendsChart(data.recentTrends);
                }

                // Create mode performance chart
                if (data.modePerformance && data.modePerformance.length > 0) {
                    createModePerformanceChart(data.modePerformance);
                }

            } catch (error) {
                console.error('Error loading quality dashboard:', error);
            }
        }

        // Create quality trends chart
        function createQualityTrendsChart(trends) {
            const ctx = document.getElementById('qualityTrendsChart').getContext('2d');
            
            if (qualityTrendsChart) {
                qualityTrendsChart.destroy();
            }

            const labels = trends.map(t => new Date(t.date).toLocaleDateString()).reverse();
            const scores = trends.map(t => parseFloat(t.avg_score)).reverse();

            qualityTrendsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Average Quality Score',
                        data: scores,
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 10
                        }
                    }
                }
            });
        }

        // Create mode performance chart
        function createModePerformanceChart(performance) {
            const ctx = document.getElementById('modePerformanceChart').getContext('2d');
            
            if (modePerformanceChart) {
                modePerformanceChart.destroy();
            }

            const labels = performance.map(p => p.mode);
            const scores = performance.map(p => parseFloat(p.avg_score));

            modePerformanceChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Average Quality Score',
                        data: scores,
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.8)',
                            'rgba(16, 185, 129, 0.8)'
                        ],
                        borderColor: [
                            'rgb(59, 130, 246)',
                            'rgb(16, 185, 129)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 10
                        }
                    }
                }
            });
        }

        // Load run statistics
        async function loadRunStats() {
            if (!currentTwinId) return;

            const days = document.getElementById('daysFilter').value;

            try {
                const response = await fetch(`/api/ai-runs/${currentTwinId}/runs/stats?days=${days}`, {
                    credentials: 'include'
                });
                const data = await response.json();
                
                const container = document.getElementById('runStats');
                container.innerHTML = '';

                if (data.stats && data.stats.length > 0) {
                    data.stats.forEach(stat => {
                        const div = document.createElement('div');
                        div.className = 'bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700';
                        div.innerHTML = `
                            <h3 class="font-medium text-gray-900 dark:text-white">${stat.mode} Mode</h3>
                            <div class="mt-2 space-y-1">
                                <div class="text-sm text-gray-600 dark:text-gray-300">Total Runs: ${stat.total_runs}</div>
                                <div class="text-sm text-gray-600 dark:text-gray-300">Avg Tokens In: ${parseFloat(stat.avg_tokens_in || 0).toFixed(0)}</div>
                                <div class="text-sm text-gray-600 dark:text-gray-300">Avg Tokens Out: ${parseFloat(stat.avg_tokens_out || 0).toFixed(0)}</div>
                                <div class="text-sm text-gray-600 dark:text-gray-300">Avg Quality: ${parseFloat(stat.avg_critic_score || 0).toFixed(2)}</div>
                                <div class="text-sm text-gray-600 dark:text-gray-300">Avg Latency: ${parseFloat(stat.avg_latency_ms || 0).toFixed(0)}ms</div>
                                <div class="text-sm text-orange-600 dark:text-orange-400">Regens: ${stat.regen_count}</div>
                            </div>
                        `;
                        container.appendChild(div);
                    });
                } else {
                    container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-center py-4">No statistics available</p>';
                }

            } catch (error) {
                console.error('Error loading run stats:', error);
            }
        }

        // Load runs
        async function loadRuns() {
            if (!currentTwinId) return;

            const mode = document.getElementById('modeFilter').value;
            const params = new URLSearchParams();
            if (mode) params.append('mode', mode);

            try {
                const response = await fetch(`/api/ai-runs/${currentTwinId}/runs?${params}`, {
                    credentials: 'include'
                });
                const runs = await response.json();
                
                const container = document.getElementById('runsList');
                container.innerHTML = '';

                if (runs.length === 0) {
                    container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-center py-4">No runs found</p>';
                    return;
                }

                runs.forEach(run => {
                    const div = document.createElement('div');
                    div.className = 'flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700';
                    div.innerHTML = `
                        <div class="flex items-center space-x-4">
                            <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded text-sm">${run.mode}</span>
                            <div class="text-sm">
                                <div class="text-gray-900 dark:text-white">Tokens: ${run.tokens_in || 0} → ${run.tokens_out || 0}</div>
                                <div class="text-gray-500 dark:text-gray-400">${run.latency_ms ? `${run.latency_ms}ms` : 'N/A'}</div>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            ${run.critic_score ? `<span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded text-sm">Score: ${run.critic_score}</span>` : ''}
                            ${run.regen ? '<span class="px-2 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded text-sm">Regen</span>' : ''}
                            <span class="text-sm text-gray-500 dark:text-gray-400">${new Date(run.ts).toLocaleString()}</span>
                        </div>
                    `;
                    container.appendChild(div);
                });
            } catch (error) {
                console.error('Error loading runs:', error);
            }
        }

        // Event listeners
        document.getElementById('daysFilter').addEventListener('change', loadRunStats);
        document.getElementById('modeFilter').addEventListener('change', loadRuns);
        document.getElementById('refreshStats').addEventListener('click', loadRunStats);
        document.getElementById('loadRuns').addEventListener('click', loadRuns);
    </script>
</body>
</html>
