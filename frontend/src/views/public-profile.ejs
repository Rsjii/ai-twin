<script>
    // ✅ Safe defaults for when twin exists
let currentChatId = null;
let currentTwinId = '<%= typeof twinPublicId !== "undefined" ? twinPublicId : (twin.publicId || "") %>';
let visitorId = null;
let isChatting = false;

// Global interaction state
let hasLiked = false;
let hasFollowed = false;

// ✅ All flags as real booleans
const requireLogin   = <%- JSON.stringify(!!twin.requireLogin) %>;
const twinPublicHandle = '<%= twin.publicHandle || "" %>';
const isOwnTwin      = <%- JSON.stringify(!!twin.isOwnTwin) %>;
const likesDisabled  = <%- JSON.stringify(!!twin.likesDisabled) %>;
const followsDisabled= <%- JSON.stringify(!!twin.followsDisabled) %>;
const sharesDisabled = <%- JSON.stringify(!!twin.sharesDisabled) %>;
const serverHasLiked = <%- JSON.stringify(!!twin.hasLiked) %>;
const serverHasFollowed = <%- JSON.stringify(!!twin.hasFollowed) %>;

// Chat button – always go to public chat page, let that page enforce login for sending
document.getElementById('chatNowBtn').addEventListener('click', function() {
    const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
    const twinToken = '<%= twinPublicId %>';

    // If this is your own twin, redirect to enhanced chat (same as discover)
    if (isOwnTwin) {
        showNotification('You cannot chat with your own twin in public chat. Redirecting to Enhanced Chat...', 'info');
        setTimeout(() => {
            window.location.href = '/chat?twinId=' + twinToken;
        }, 800);
        return;
    }

    // ✅ No pre-block for logged‑out; just go to public chat page.
    // public-chat.ejs + /api/public-chat/start already handle LOGIN_REQUIRED.
    window.location.href = '/public-twin/chat/' + twinToken;
});

        document.getElementById('closeChatBtn').addEventListener('click', function() {
            document.getElementById('chatModal').classList.add('hidden');
        });

        // Close modal when clicking outside
        document.getElementById('chatModal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.add('hidden');
            }
        });

// Check initial like/follow status on page load
async function checkInitialStatus() {
    try {
        const response = await fetch(`/api/social/stats/${currentTwinId}`, {
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            console.log('Initial status response:', data); // Debug log
            if (data.success && data.userInteraction) {
                hasLiked = data.userInteraction.hasLiked === true;
                hasFollowed = data.userInteraction.hasFollowed === true;
                
                console.log('Setting status - hasLiked:', hasLiked, 'hasFollowed:', hasFollowed); // Debug log
                
                // Update button states
                updateLikeButton(hasLiked);
                updateFollowButton(hasFollowed);
            } else {
                console.log('No userInteraction in response or not authenticated');
            }
        } else {
            console.error('Failed to fetch initial status:', response.status);
        }
    } catch (error) {
        console.error('Error checking initial status:', error);
    }
}

// Update like button state
function updateLikeButton(liked) {
    const likeBtn = document.getElementById('likeBtn');
    if (!likeBtn) return;
    
    // ✅ FIX: Only update state if button is NOT disabled
    if (likeBtn.disabled || likeBtn.classList.contains('cursor-not-allowed')) {
        return; // Don't change state if disabled
    }
    
    if (liked) {
        likeBtn.innerHTML = `
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
            </svg>
            <span>Liked</span>
        `;
        likeBtn.classList.remove('bg-gradient-to-r', 'from-pink-500', 'to-rose-500', 'text-white');
        likeBtn.classList.add('bg-red-100', 'text-red-600', 'dark:bg-red-900/30', 'dark:text-red-400');
    } else {
        likeBtn.innerHTML = `
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
            </svg>
            <span>Like</span>
        `;
        likeBtn.classList.remove('bg-red-100', 'text-red-600', 'dark:bg-red-900/30', 'dark:text-red-400');
        likeBtn.classList.add('bg-gradient-to-r', 'from-pink-500', 'to-rose-500', 'text-white');
    }
}

// Update follow button state
function updateFollowButton(followed) {
    const followBtn = document.getElementById('followBtn');
    if (!followBtn) return;
    
    // ✅ FIX: Only update state if button is NOT disabled
    if (followBtn.disabled || followBtn.classList.contains('cursor-not-allowed')) {
        return; // Don't change state if disabled
    }
    
    if (followed) {
        followBtn.innerHTML = `
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
            </svg>
            <span>Following</span>
        `;
        followBtn.classList.remove('bg-gradient-to-r', 'from-blue-500', 'to-indigo-500', 'text-white');
        followBtn.classList.add('bg-blue-100', 'text-blue-600', 'dark:bg-blue-900/30', 'dark:text-blue-400');
    } else {
        followBtn.innerHTML = `
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
            </svg>
            <span>Follow</span>
        `;
        followBtn.classList.remove('bg-blue-100', 'text-blue-600', 'dark:bg-blue-900/30', 'dark:text-blue-400');
        followBtn.classList.add('bg-gradient-to-r', 'from-blue-500', 'to-indigo-500', 'text-white');
    }
}

// Initialize visitor ID
function initializeVisitorId() {
    const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;
    
    if (!isLoggedIn) {
        // ✅ Use sessionStorage instead of localStorage for logged out users
        visitorId = sessionStorage.getItem('visitorId');
        if (!visitorId) {
            visitorId = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
            sessionStorage.setItem('visitorId', visitorId);
        }
        // Clear old localStorage if exists
        localStorage.removeItem('visitorId');
    } else {
        visitorId = null;
    }
}

// Load all chats for this twin
async function loadPublicChatHistory() {
    try {
        const response = await fetch(`/api/public-chat/twin/${currentTwinId}/chats?visitorId=${visitorId}`);
        const data = await response.json();
        
        console.log('[loadPublicChatHistory] Response received:', data);
        console.log('[loadPublicChatHistory] data.serverTime:', data.serverTime);
        console.log('[loadPublicChatHistory] window.TimeUtils exists:', !!window.TimeUtils);
        console.log('[loadPublicChatHistory] window.TimeUtils.setServerTime exists:', !!(window.TimeUtils && window.TimeUtils.setServerTime));
        
        // ✅ CRITICAL FIX: Set server time IMMEDIATELY after receiving response
        // Must be done BEFORE any time formatting functions are called
        if (data.serverTime) {
            // Try multiple ways to set server time
            if (window.TimeUtils && typeof window.TimeUtils.setServerTime === 'function') {
                window.TimeUtils.setServerTime(data.serverTime);
                console.log('[loadPublicChatHistory] ✅ Server time set via TimeUtils.setServerTime:', data.serverTime);
            } else if (window.TimeUtils && window.TimeUtils.setServerTime) {
                window.TimeUtils.setServerTime(data.serverTime);
                console.log('[loadPublicChatHistory] ✅ Server time set (fallback method):', data.serverTime);
            } else {
                console.error('[loadPublicChatHistory] ❌ TimeUtils.setServerTime not available!');
                console.error('[loadPublicChatHistory] window.TimeUtils:', window.TimeUtils);
                console.error('[loadPublicChatHistory] typeof window.TimeUtils:', typeof window.TimeUtils);
            }
        } else {
            console.warn('[loadPublicChatHistory] ⚠️ No serverTime in response');
        }
        
        // ✅ Verify server time was set
        if (window.TimeUtils && window.TimeUtils.globalServerTime) {
            console.log('[loadPublicChatHistory] ✅ Verified globalServerTime:', window.TimeUtils.globalServerTime);
        } else {
            console.warn('[loadPublicChatHistory] ⚠️ globalServerTime not accessible after setting');
        }
        
        if (data.success) {
            // ✅ Call display function AFTER setting server time
            displayPublicChatHistory(data.chats);
        }
    } catch (error) {
        console.error('Error loading public chat history:', error);
    }
}

// Display chat history
function displayPublicChatHistory(chats) {
    const container = document.getElementById('publicChatHistoryList');
    
    if (chats.length === 0) {
        container.innerHTML = '<p class="text-gray-500 text-sm">No chats yet</p>';
        return;
    }

    container.innerHTML = chats.map(chat => `
        <div class="chat-item p-3 border-b cursor-pointer hover:bg-gray-50 rounded-lg ${chat.publicId === currentChatId ? 'bg-blue-50 border-blue-200' : ''}" data-chat-id="${chat.publicId}">
            <div class="flex justify-between items-start">
                <div class="flex-1">
                    <h4 class="font-medium text-sm ${chat.publicId === currentChatId ? 'text-blue-700' : ''}">Chat #${chat.publicId.slice(-6)}</h4>
                    <p class="text-xs text-gray-500 truncate">${chat.lastMessage ? chat.lastMessage.content : 'No messages yet'}</p>
                </div>
<div class="text-xs text-gray-400 timestamp-display" data-timestamp="${chat.createdAt}" data-format="smart"></div>                
            </div>
            <div class="flex items-center mt-1">
                <span class="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded">${chat.messageCount || 0} messages</span>
            </div>
        </div>
    `).join('');

    // ✅ Format timestamps client-side after rendering
    if (window.TimeUtils) {
        container.querySelectorAll('.timestamp-display').forEach(el => {
            const timestamp = el.dataset.timestamp;
            const format = el.dataset.format || 'smart';
            if (timestamp) {
                try {
                    let displayTime, fullTime;
                    if (format === 'smart') {
                        displayTime = window.TimeUtils.formatSmartTime(timestamp);
                        fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                    } else {
                        displayTime = window.TimeUtils.formatDateOnly(timestamp);
                        fullTime = window.TimeUtils.formatFullDateTime(timestamp);
                    }
                    el.textContent = displayTime;
                    el.title = fullTime;
                } catch (e) {
                    console.error('Error formatting timestamp:', e);
                }
            }
        });
    }

    // Add click listeners
    container.querySelectorAll('.chat-item').forEach(item => {
        item.addEventListener('click', function() {
            const chatId = this.dataset.chatId;
            if (chatId !== currentChatId) {
                switchToPublicChat(chatId);
            }
        });
    });
}

// Switch to different chat
async function switchToPublicChat(chatId) {
    try {
        currentChatId = chatId;
        
        // Load chat messages
        const response = await fetch(`/api/public-chat/${chatId}/history`);
        const data = await response.json();
        
        // ✅ FIX: Update global server time from API response
        if (data.serverTime && window.TimeUtils && window.TimeUtils.setServerTime) {
            window.TimeUtils.setServerTime(data.serverTime);
        }
        
        if (data.success) {
            displayMessages(data.messages);
            await loadPublicChatHistory(); // Refresh sidebar
        }
    } catch (error) {
        console.error('Error switching to chat:', error);
    }
}

// Create new public chat
async function createNewPublicChat() {
    try {
        const response = await fetch('/api/public-chat/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                twinToken: currentTwinId,
                visitorId: visitorId
            })
        });

        const data = await response.json();
        
        if (data.success) {
            currentChatId = data.chatId;
            document.getElementById('chatMessages').innerHTML = '';
            await loadPublicChatHistory();
        }
    } catch (error) {
        console.error('Error creating new chat:', error);
    }
}

// Updated startPublicChat function
async function startPublicChat() {
    try {
        window.location.href = `/public-chat/<%= twinPublicId %>`;
    } catch (error) {
        console.error('Error starting chat:', error);
    }
}

// Display messages in chat
function displayMessages(messages) {
    const chatMessages = document.getElementById('chatMessages');
    chatMessages.innerHTML = '';
    
    messages.forEach(msg => {
        addMessageToChat(msg.content, msg.sender, msg.createdAt);
    });
}

        // Send message
        document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        async function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message || !currentChatId || isChatting) return;
            
            isChatting = true;
            const sendBtn = document.getElementById('sendMessageBtn');
            sendBtn.disabled = true;
            sendBtn.textContent = 'Sending...';
            
            // Add user message to chat
            addMessageToChat(message, 'human', new Date().toISOString());
            messageInput.value = '';
            
            try {
                const response = await fetch(`/api/public-chat/${currentChatId}/message`, {
                    method: 'POST', // Fix: Add missing HTTP method
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ message })
                });

                const data = await response.json();
                
                // ✅ FIX: Update global server time from API response
                if (data.serverTime && window.TimeUtils && window.TimeUtils.setServerTime) {
                    window.TimeUtils.setServerTime(data.serverTime);
                }
                
                if (data.success && data.messages) {
                    // Add AI response
                    const aiMessage = data.messages.find(m => m.sender === 'twin');
                    if (aiMessage) {
                        addMessageToChat(aiMessage.content, 'twin', aiMessage.createdAt);
                    }
                } else {
                    throw new Error(data.error || 'Failed to send message');
                }
            } catch (error) {
                console.error('Error sending message:', error);
                addMessageToChat('Sorry, I had trouble responding. Please try again.', 'twin', new Date().toISOString());
            } finally {
                isChatting = false;
                sendBtn.disabled = false;
                sendBtn.textContent = 'Send';
            }
        }

        function addMessageToChat(content, sender, timestamp = null) {
            const chatMessages = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            
            // Use provided timestamp or current time
            const messageTime = timestamp || new Date().toISOString();
            const timeDisplay = TimeUtils.formatTimeWithContext(messageTime);
            const timeTooltip = TimeUtils.formatFullDateTime(messageTime);
            
            if (sender === 'human') {
                messageDiv.className = 'flex justify-end mb-4';
                messageDiv.innerHTML = `
                    <div class="bg-blue-600 text-white px-4 py-3 rounded-lg max-w-xs lg:max-w-md shadow-sm">
                        <p class="text-sm">${content}</p>
                        <p class="text-xs opacity-75 mt-1" title="${timeTooltip}">${timeDisplay}</p>
                    </div>
                `;
            } else {
                messageDiv.className = 'flex justify-start mb-4';
                messageDiv.innerHTML = `
                    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 px-4 py-3 rounded-lg max-w-xs lg:max-w-md shadow-sm">
                        <p class="text-sm text-gray-800 dark:text-gray-200">${content}</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" title="${timeTooltip}">${timeDisplay}</p>
                    </div>
                `;
            }
            
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Add form submission handler
        document.getElementById('chatForm').addEventListener('submit', function(e) {
            e.preventDefault();
            sendMessage();
        });

// Toggle like functionality (exactly like discover.ejs)
async function toggleLike(twinToken, button) {
    // ✅ SAFETY: Check if button is disabled before making request
    if (button.disabled || button.classList.contains('cursor-not-allowed')) {
        const disabledReason = button.getAttribute('data-disabled-reason');
        const message = disabledReason === 'own_twin' 
            ? 'You cannot like your own twin' 
            : 'Liking is disabled for this twin';
        showNotification(message, 'info');
        return;
    }
    
    try {        
        const response = await fetch('/api/social/toggle-like', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            credentials: 'include',
            body: JSON.stringify({ twinToken })
        });

        const data = await response.json();
        
        if (data.success) {
            // Update button state
            if (data.action === 'liked') {
                button.classList.remove('bg-gradient-to-r', 'from-pink-500', 'to-rose-500', 'text-white');
                button.classList.add('bg-red-100', 'text-red-600', 'dark:bg-red-900/30', 'dark:text-red-400');
                button.innerHTML = `
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Liked</span>
                `;
                
                // ✅ Show notification
                showNotification(`❤️ You liked @${twinPublicHandle}`, 'success');
            } else {
                button.classList.remove('bg-red-100', 'text-red-600', 'dark:bg-red-900/30', 'dark:text-red-400');
                button.classList.add('bg-gradient-to-r', 'from-pink-500', 'to-rose-500', 'text-white');
                button.innerHTML = `
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Like</span>
                `;
                
                // ✅ Show notification
                showNotification(`💔 You unliked @${twinPublicHandle}`, 'info');
            }
            
            // Update like count
            const likeCountElement = document.querySelector('.like-count');
            if (likeCountElement) {
                likeCountElement.textContent = data.likeCount;
            }
            
            // Update global state
            hasLiked = data.action === 'liked';
        } else {
            if (data.error === 'Authentication required') {
                showNotification('Please log in to like this twin!', 'error');
            } else {
                showNotification('Error: ' + data.error, 'error');
            }
        }
    } catch (error) {
        console.error('Error toggling like:', error);
        showNotification('Please log in to like this twin!', 'error');
    }
}        
        
// Toggle follow functionality (exactly like discover.ejs)
async function toggleFollow(twinToken, button) {
    // ✅ SAFETY: Check if button is disabled before making request
    if (button.disabled || button.classList.contains('cursor-not-allowed')) {
        const disabledReason = button.getAttribute('data-disabled-reason');
        const message = disabledReason === 'own_twin' 
            ? 'You cannot follow your own twin' 
            : 'Following is disabled for this twin';
        showNotification(message, 'info');
        return;
    }
    
    try {        
        const response = await fetch('/api/social/toggle-follow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            credentials: 'include',
            body: JSON.stringify({ twinToken })
        });

        const data = await response.json();
        
        if (data.success) {
            // Update button state
            if (data.action === 'followed') {
                button.classList.remove('bg-gradient-to-r', 'from-blue-500', 'to-indigo-500', 'text-white');
                button.classList.add('bg-blue-100', 'text-blue-600', 'dark:bg-blue-900/30', 'dark:text-blue-400');
                button.innerHTML = `
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>Following</span>
                `;
                
                // ✅ Show notification
                showNotification(`👥 You are now following @${twinPublicHandle}`, 'success');
            } else {
                button.classList.remove('bg-blue-100', 'text-blue-600', 'dark:bg-blue-900/30', 'dark:text-blue-400');
                button.classList.add('bg-gradient-to-r', 'from-blue-500', 'to-indigo-500', 'text-white');
                button.innerHTML = `
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                    </svg>
                    <span>Follow</span>
                `;
                
                // ✅ Show notification
                showNotification(`👋 You unfollowed @${twinPublicHandle}`, 'info');
            }
            
            // Update follow count
            const followCountElement = document.querySelector('.follow-count');
            if (followCountElement) {
                followCountElement.textContent = data.followCount;
            }
            
            // Update global state
            hasFollowed = data.action === 'followed';
        } else {
            if (data.error === 'Authentication required') {
                showNotification('Please log in to follow this twin!', 'error');
            } else {
                showNotification('Error: ' + data.error, 'error');
            }
        }
    } catch (error) {
        console.error('Error toggling follow:', error);
        showNotification('Please log in to follow this twin!', 'error');
    }
}

// ✅ Global Toast / Notification System (for standalone page)
(function () {
    window.UI = window.UI || {};
    if (window.UI.showToast) return; // don't override if layout already defined

    window.UI.showToast = function (message, type = 'success', opts = {}) {
        const duration = typeof opts.duration === 'number' ? opts.duration : 3000;
        const existing = document.getElementById('global-toast');
        if (existing && existing.parentNode) existing.parentNode.removeChild(existing);

        const el = document.createElement('div');
        el.id = 'global-toast';
        el.className =
            'fixed top-4 right-4 z-50 max-w-sm w-[90vw] sm:w-auto px-4 py-3 sm:px-6 sm:py-4 ' +
            'rounded-xl shadow-2xl transition-all duration-300 transform opacity-0 translate-y-2';

        let bgClasses, icon;
        if (type === 'success') {
            bgClasses = 'bg-gradient-to-r from-green-500 to-emerald-500 text-white';
            icon = '✅';
        } else if (type === 'error') {
            bgClasses = 'bg-gradient-to-r from-red-500 to-rose-500 text-white';
            icon = '❌';
        } else {
            bgClasses = 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white';
            icon = 'ℹ️';
        }

        el.className += ' ' + bgClasses;
        el.innerHTML = `
            <div class="flex items-center gap-3">
                <span class="text-xl">${icon}</span>
                <div class="flex flex-col text-left">
                    <span class="font-semibold">${message}</span>
                </div>
            </div>
        `;

        document.body.appendChild(el);

        requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
        });

        setTimeout(() => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(-8px)';
            setTimeout(() => {
                if (el.parentNode) el.parentNode.removeChild(el);
            }, 300);
        }, duration);
    };
})();

// ✅ Unified notification wrapper for public-profile
function showNotification(message, type = 'success') {
    if (window.UI && typeof window.UI.showToast === 'function') {
        window.UI.showToast(message, type);
    }
}        
        // Share functionality
async function shareTwin(platform) {
    try {
        // ✅ FIX: Check allowShares BEFORE making API call
        if (sharesDisabled) {
            showNotification('Shares are disabled for this twin. You cannot share this profile.', 'info');
            return;
        }
        
        // ✅ PHASE 2: Double-check with API (for security)
        const response = await fetch(`/api/share/content/${twinPublicHandle}?platform=${platform}`, {
            credentials: 'include'
        });
        
        const data = await response.json();
        
        if (!data.success) {
            if (data.errorCode === 'SHARES_DISABLED') {
                showNotification('Shares are disabled for this twin. You cannot share this profile.', 'info');
                return;
            }
            showNotification('Error: ' + (data.error || 'Failed to share'), 'error');
            return;
        }

        const shareUrl = window.location.href;
        const title = `Check out @${twinPublicHandle} on Twinverse!`;
        const text = `<%= twin && twin.bio ? twin.bio : 'AI Twin' %> - Chat with this AI twin!`;
        
        let shareWindow = '';
        
        switch (platform) {
            case 'twitter':
                shareWindow = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(shareUrl)}`;
                break;
            case 'facebook':
                shareWindow = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
                break;
            case 'linkedin':
                shareWindow = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
                break;
            case 'whatsapp':
                shareWindow = `https://wa.me/?text=${encodeURIComponent(text + ' ' + shareUrl)}`;
                break;
            case 'telegram':
                shareWindow = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(text)}`;
                break;
        }
        
        if (shareWindow) {
            window.open(shareWindow, '_blank', 'width=600,height=400');
        }
    } catch (error) {
        console.error('Share error:', error);
        showNotification('Failed to share. Please try again.', 'error');
    }
}

        async function copyShareLink() {
            try {

                // ✅ FIX: Check allowShares BEFORE copying
        if (sharesDisabled) {
            showNotification('Shares are disabled for this twin. You cannot share this profile.', 'info');
            return;
        }

                const shareUrl = window.location.href;
                await navigator.clipboard.writeText(shareUrl);
                showNotification('Link copied to clipboard!', 'success');
            } catch (error) {
                console.error('Copy error:', error);
                showNotification('Failed to copy link. Please copy manually: ' + window.location.href, 'error');
            }
        }

