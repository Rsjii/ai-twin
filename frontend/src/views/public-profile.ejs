<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .card-shadow { box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-2xl font-bold text-gray-900">Twinverse</a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/dashboard" class="text-gray-600 hover:text-gray-900">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Twin Profile Card -->
        <div class="bg-white rounded-2xl card-shadow overflow-hidden">
            <!-- Profile Header -->
            <div class="gradient-bg px-8 py-12 text-white">
                <div class="flex items-center space-x-6">
                    <!-- Profile Image -->
                    <div class="w-24 h-24 rounded-full bg-white bg-opacity-20 flex items-center justify-center overflow-hidden">
                        <% if (twin.profileImage) { %>
                            <img src="<%= twin.profileImage %>" alt="<%= twin.publicHandle %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="w-full h-full bg-white bg-opacity-30 flex items-center justify-center">
                                <span class="text-3xl font-bold"><%= twin.publicHandle.charAt(0).toUpperCase() %></span>
                            </div>
                        <% } %>
                    </div>
                    
                    <!-- Profile Info -->
                    <div class="flex-1">
                        <div class="flex items-center space-x-3 mb-2">
                            <h1 class="text-3xl font-bold">@<%= twin.publicHandle %></h1>
                            <% if (twin.verified) { %>
                                <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center">
                                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>
                            <% } %>
                        </div>
                        
                        <p class="text-lg opacity-90 mb-4">
                            Created by <span class="font-semibold"><%= twin.userName || twin.userHandle %></span>
                        </p>
                        
                        <% if (twin.bio) { %>
                            <p class="text-lg opacity-90 max-w-2xl"><%= twin.bio %></p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="px-8 py-6 border-b">
                <div class="grid grid-cols-3 gap-8 text-center">
                    <div>
                        <div class="text-2xl font-bold text-gray-900 like-count"><%= twin.likeCount %></div>
                        <div class="text-sm text-gray-600">Likes</div>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-gray-900 follow-count"><%= twin.followCount %></div>
                        <div class="text-sm text-gray-600">Followers</div>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-gray-900"><%= twin.chatCount %></div>
                        <div class="text-sm text-gray-600">Chats</div>
                    </div>
                </div>
            </div>

            <!-- Sample Reply -->
            <% if (twin.sampleReply) { %>
                <div class="px-8 py-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-3">Sample Response</h3>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <p class="text-gray-700 italic">"<%= twin.sampleReply %>"</p>
                    </div>
                </div>
            <% } %>

            <!-- Action Buttons -->
            <div class="px-8 py-6 bg-gray-50">
                <div class="flex flex-col sm:flex-row gap-4 mb-4">
                    <button id="chatNowBtn" class="flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
                        💬 Chat Now
                    </button>
                    <button id="likeBtn" class="px-6 py-3 border border-gray-300 rounded-lg font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
                        ❤️ Like
                    </button>
                    <button id="followBtn" class="px-6 py-3 border border-gray-300 rounded-lg font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
                        👥 Follow
                    </button>
                </div>
                
                <!-- Share Section -->
                <div class="border-t pt-4">
                    <h4 class="text-sm font-semibold text-gray-700 mb-3">Share this twin</h4>
                    <div class="flex flex-wrap gap-2">
                        <button onclick="shareTwin('twitter')" class="bg-blue-400 text-white px-3 py-2 rounded-lg hover:bg-blue-500 transition-colors text-sm">
                            <i class="fab fa-twitter mr-1"></i>Twitter
                        </button>
                        <button onclick="shareTwin('facebook')" class="bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors text-sm">
                            <i class="fab fa-facebook mr-1"></i>Facebook
                        </button>
                        <button onclick="shareTwin('linkedin')" class="bg-blue-700 text-white px-3 py-2 rounded-lg hover:bg-blue-800 transition-colors text-sm">
                            <i class="fab fa-linkedin mr-1"></i>LinkedIn
                        </button>
                        <button onclick="shareTwin('whatsapp')" class="bg-green-500 text-white px-3 py-2 rounded-lg hover:bg-green-600 transition-colors text-sm">
                            <i class="fab fa-whatsapp mr-1"></i>WhatsApp
                        </button>
                        <button onclick="shareTwin('telegram')" class="bg-blue-500 text-white px-3 py-2 rounded-lg hover:bg-blue-600 transition-colors text-sm">
                            <i class="fab fa-telegram mr-1"></i>Telegram
                        </button>
                        <button onclick="copyShareLink()" class="bg-gray-500 text-white px-3 py-2 rounded-lg hover:bg-gray-600 transition-colors text-sm">
                            <i class="fas fa-copy mr-1"></i>Copy Link
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Modal (Hidden by default) -->
        <div id="chatModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[9999] flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[80vh] overflow-hidden flex flex-col shadow-2xl">
                <div class="p-6 border-b flex items-center justify-between bg-white flex-shrink-0">
                    <h3 class="text-xl font-semibold text-gray-900">Chat with @<%= twin.publicHandle %></h3>
                    <button id="closeChatBtn" class="text-gray-400 hover:text-gray-600 p-2">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                
                <!-- Chat Messages Area -->
                <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4 min-h-[250px] max-h-[350px] bg-gray-50">
                    <!-- Messages will be loaded here -->
                </div>
                
                <!-- Chat Input -->
                <div class="p-6 border-t bg-white flex-shrink-0">
                    <form id="chatForm" class="space-y-4">
                        <div class="flex space-x-4">
                            <input 
                                type="text" 
                                id="messageInput" 
                                placeholder="Type your message..." 
                                class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                maxlength="1000"
                                required
                            >
                            <button type="submit" id="sendMessageBtn" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
                                Send
                            </button>
                        </div>
                        <p class="text-xs text-gray-500">You can chat with this AI twin without logging in!</p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentChatId = null;
        let currentTwinId = '<%= twin.id %>';
        let visitorId = null;
        let isChatting = false;

// Chat modal functionality
document.getElementById('chatNowBtn').addEventListener('click', function() {
    window.location.href = '<% if (twin.isOwner) { %>/chat-enhanced?twinId=<%= twin.id %><% } else { %>/public-twin/chat/<%= twin.id %><% } %>';
});

        document.getElementById('closeChatBtn').addEventListener('click', function() {
            document.getElementById('chatModal').classList.add('hidden');
        });

        // Close modal when clicking outside
        document.getElementById('chatModal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.add('hidden');
            }
        });

// REPLACE lines 202-230 with:
// Initialize visitor ID
function initializeVisitorId() {
    visitorId = localStorage.getItem('visitorId');
    if (!visitorId) {
        visitorId = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
        localStorage.setItem('visitorId', visitorId);
    }
}

// Load all chats for this twin
async function loadPublicChatHistory() {
    try {
        const response = await fetch(`/api/public-chat/twin/${currentTwinId}/chats?visitorId=${visitorId}`);
        const data = await response.json();
        
        if (data.success) {
            displayPublicChatHistory(data.chats);
        }
    } catch (error) {
        console.error('Error loading public chat history:', error);
    }
}

// Display chat history
function displayPublicChatHistory(chats) {
    const container = document.getElementById('publicChatHistoryList');
    
    if (chats.length === 0) {
        container.innerHTML = '<p class="text-gray-500 text-sm">No chats yet</p>';
        return;
    }

    container.innerHTML = chats.map(chat => `
        <div class="chat-item p-3 border-b cursor-pointer hover:bg-gray-50 rounded-lg ${chat.id === currentChatId ? 'bg-blue-50 border-blue-200' : ''}" data-chat-id="${chat.id}">
            <div class="flex justify-between items-start">
                <div class="flex-1">
                    <h4 class="font-medium text-sm ${chat.id === currentChatId ? 'text-blue-700' : ''}">Chat #${chat.id.slice(-6)}</h4>
                    <p class="text-xs text-gray-500 truncate">${chat.lastMessage ? chat.lastMessage.content : 'No messages yet'}</p>
                </div>
                <div class="text-xs text-gray-400">${formatTime(chat.createdAt)}</div>
            </div>
            <div class="flex items-center mt-1">
                <span class="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded">${chat.messageCount || 0} messages</span>
            </div>
        </div>
    `).join('');

    // Add click listeners
    container.querySelectorAll('.chat-item').forEach(item => {
        item.addEventListener('click', function() {
            const chatId = this.dataset.chatId;
            if (chatId !== currentChatId) {
                switchToPublicChat(chatId);
            }
        });
    });
}

// Switch to different chat
async function switchToPublicChat(chatId) {
    try {
        currentChatId = chatId;
        
        // Load chat messages
        const response = await fetch(`/api/public-chat/${chatId}/history`);
        const data = await response.json();
        
        if (data.success) {
            displayMessages(data.messages);
            await loadPublicChatHistory(); // Refresh sidebar
        }
    } catch (error) {
        console.error('Error switching to chat:', error);
    }
}

// Create new public chat
async function createNewPublicChat() {
    try {
        const response = await fetch('/api/public-chat/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                twinId: currentTwinId,
                visitorId: visitorId
            })
        });

        const data = await response.json();
        
        if (data.success) {
            currentChatId = data.chatId;
            document.getElementById('chatMessages').innerHTML = '';
            await loadPublicChatHistory();
        }
    } catch (error) {
        console.error('Error creating new chat:', error);
    }
}

// Updated startPublicChat function
async function startPublicChat() {
    try {
        window.location.href = `/public-chat/<%= twin.id %>`;
    } catch (error) {
        console.error('Error starting chat:', error);
    }
}

// Format time helper
function formatTime(timestamp) {
    const date = new Date(timestamp);
    const now = new Date();
    const diff = now - date;
    
    if (diff < 60000) return 'Just now';
    if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
    if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
    return Math.floor(diff / 86400000) + 'd ago';
}

// Display messages in chat
function displayMessages(messages) {
    const chatMessages = document.getElementById('chatMessages');
    chatMessages.innerHTML = '';
    
    messages.forEach(msg => {
        addMessageToChat(msg.content, msg.sender);
    });
}

        // Send message
        document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        async function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message || !currentChatId || isChatting) return;
            
            isChatting = true;
            const sendBtn = document.getElementById('sendMessageBtn');
            sendBtn.disabled = true;
            sendBtn.textContent = 'Sending...';
            
            // Add user message to chat
            addMessageToChat(message, 'human');
            messageInput.value = '';
            
            try {
                const response = await fetch(`/api/public-chat/${currentChatId}/message`, {
                    method: 'POST', // Fix: Add missing HTTP method
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ message })
                });

                const data = await response.json();
                
                if (data.success && data.messages) {
                    // Add AI response
                    const aiMessage = data.messages.find(m => m.sender === 'twin');
                    if (aiMessage) {
                        addMessageToChat(aiMessage.content, 'twin');
                    }
                } else {
                    throw new Error(data.error || 'Failed to send message');
                }
            } catch (error) {
                console.error('Error sending message:', error);
                addMessageToChat('Sorry, I had trouble responding. Please try again.', 'twin');
            } finally {
                isChatting = false;
                sendBtn.disabled = false;
                sendBtn.textContent = 'Send';
            }
        }

        function addMessageToChat(content, sender) {
            const chatMessages = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            
            if (sender === 'human') {
                messageDiv.className = 'flex justify-end mb-4';
                messageDiv.innerHTML = `
                    <div class="bg-blue-600 text-white px-4 py-3 rounded-lg max-w-xs lg:max-w-md shadow-sm">
                        <p class="text-sm">${content}</p>
                        <p class="text-xs opacity-75 mt-1">${new Date().toLocaleTimeString()}</p>
                    </div>
                `;
            } else {
                messageDiv.className = 'flex justify-start mb-4';
                messageDiv.innerHTML = `
                    <div class="bg-white border border-gray-200 px-4 py-3 rounded-lg max-w-xs lg:max-w-md shadow-sm">
                        <p class="text-sm text-gray-800">${content}</p>
                        <p class="text-xs text-gray-500 mt-1">${new Date().toLocaleTimeString()}</p>
                    </div>
                `;
            }
            
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Add form submission handler
        document.getElementById('chatForm').addEventListener('submit', function(e) {
            e.preventDefault();
            sendMessage();
        });

        // Like and Follow buttons functionality
        document.getElementById('likeBtn').addEventListener('click', function() {
            toggleLike();
        });

        document.getElementById('followBtn').addEventListener('click', function() {
            toggleFollow();
        });

        // Toggle like functionality
        async function toggleLike() {
            try {
                const response = await fetch('/api/social/toggle-like', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        twinId: '<%= twin.id %>'
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    // Update like count display
                    const likeCountElement = document.querySelector('.like-count');
                    if (likeCountElement) {
                        likeCountElement.textContent = data.likeCount;
                    }
                    
                    // Update button text
                    const likeBtn = document.getElementById('likeBtn');
                    if (data.action === 'liked') {
                        likeBtn.textContent = '❤️ Liked';
                        likeBtn.classList.add('bg-red-100', 'text-red-600');
                    } else {
                        likeBtn.textContent = '❤️ Like';
                        likeBtn.classList.remove('bg-red-100', 'text-red-600');
                    }
                } else {
                    if (data.error === 'Authentication required') {
                        alert('Please log in to like this twin!');
                    } else {
                        alert('Error: ' + data.error);
                    }
                }
            } catch (error) {
                console.error('Error toggling like:', error);
                alert('Please log in to like this twin!');
            }
        }

        // Toggle follow functionality
        async function toggleFollow() {
            try {
                const response = await fetch('/api/social/toggle-follow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        twinId: '<%= twin.id %>'
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    // Update follow count display
                    const followCountElement = document.querySelector('.follow-count');
                    if (followCountElement) {
                        followCountElement.textContent = data.followCount;
                    }
                    
                    // Update button text
                    const followBtn = document.getElementById('followBtn');
                    if (data.action === 'followed') {
                        followBtn.textContent = '👥 Following';
                        followBtn.classList.add('bg-blue-100', 'text-blue-600');
                    } else {
                        followBtn.textContent = '👥 Follow';
                        followBtn.classList.remove('bg-blue-100', 'text-blue-600');
                    }
                } else {
                    if (data.error === 'Authentication required') {
                        alert('Please log in to follow this twin!');
                    } else {
                        alert('Error: ' + data.error);
                    }
                }
            } catch (error) {
                console.error('Error toggling follow:', error);
                alert('Please log in to follow this twin!');
            }
        }

        // Share functionality
        async function shareTwin(platform) {
            try {
                const response = await fetch('/api/share/content/<%= twin.publicHandle %>?platform=' + platform);
                const data = await response.json();
                
                if (data.success) {
                    const shareUrl = data.shareUrl;
                    const content = data.content;
                    
                    let shareWindow = '';
                    
                    switch (platform) {
                        case 'twitter':
                            shareWindow = `https://twitter.com/intent/tweet?text=${encodeURIComponent(content.text)}&url=${encodeURIComponent(shareUrl)}`;
                            break;
                        case 'facebook':
                            shareWindow = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}&quote=${encodeURIComponent(content.description)}`;
                            break;
                        case 'linkedin':
                            shareWindow = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(content.title)}&summary=${encodeURIComponent(content.summary)}`;
                            break;
                        case 'whatsapp':
                            shareWindow = `https://wa.me/?text=${encodeURIComponent(content.text)}`;
                            break;
                        case 'telegram':
                            shareWindow = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(content.text)}`;
                            break;
                    }
                    
                    if (shareWindow) {
                        window.open(shareWindow, '_blank', 'width=600,height=400');
                    }
                    
                    // Track share event
                    trackShareEvent(platform);
                } else {
                    alert('Failed to get share content');
                }
            } catch (error) {
                console.error('Share error:', error);
                alert('Failed to share. Please try again.');
            }
        }

        async function copyShareLink() {
            try {
                const shareUrl = window.location.href;
                await navigator.clipboard.writeText(shareUrl);
                alert('Link copied to clipboard!');
                
                // Track copy event
                trackShareEvent('copy');
            } catch (error) {
                console.error('Copy error:', error);
                alert('Failed to copy link. Please copy manually: ' + window.location.href);
            }
        }

        async function trackShareEvent(platform) {
            try {
                await fetch('/api/share/track-click', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        shareId: '<%= twin.id %>',
                        platform: platform,
                        referrer: document.referrer
                    })
                });
            } catch (error) {
                console.error('Track share event error:', error);
            }
        }
    </script>
</body>
</html>
