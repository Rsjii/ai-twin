<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="/utils/timeUtils.js"></script>
    <script>
        // ✅ IMMEDIATE theme application (prevents flash)
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-bg { 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            position: relative;
            overflow: hidden;
        }
        .gradient-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
        }
        .card-shadow { 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
        .stat-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
        }
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 via-blue-50 to-indigo-100 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900">
    <!--Header-->
    <%- include('header') %>

    <!-- Main Content -->
    <div class="max-w-5xl mx-auto px-3 sm:px-4 lg:px-8 py-6 sm:py-8">
        <!-- Twin Profile Card -->
        <div class="bg-white dark:bg-gray-800 rounded-3xl card-shadow dark:shadow-gray-900 overflow-hidden border border-gray-100 dark:border-gray-700">
            <!-- Profile Header - Enhanced Gradient -->
            <div class="gradient-bg px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-white relative">
                <div class="relative z-10">
                    <div class="flex flex-col md:flex-row items-center md:items-start space-y-4 sm:space-y-6 md:space-y-0 md:space-x-6 lg:space-x-8">

                      <% const noTwin = typeof hasNoTwin !== 'undefined' && hasNoTwin; %>

                      <!-- Profile Image - Larger and Better -->
<div class="relative">
    <div class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 rounded-xl bg-white bg-opacity-20 backdrop-blur-lg flex items-center justify-center overflow-hidden border-3 border-white border-opacity-30 shadow-xl transform hover:scale-105 transition-transform duration-300">
        <% 
        // ✅ FIX: Prefer user's profile image, fallback to twin image
        const displayProfileImage = (userInfo && userInfo.profileImage) || (twin && twin.profileImage);
        const displayAlt = (twin && twin.publicHandle) || (userInfo && userInfo.handle) || 'Profile';
        %>
        <% if (displayProfileImage) { %>
            <img src="<%= displayProfileImage %>" alt="<%= displayAlt %>" class="w-full h-full object-cover" loading="lazy">
        <% } else if (twin && twin.publicHandle) { %>
            <!-- Twin exists: show twin initial -->
            <div class="w-full h-full bg-gradient-to-br from-white/40 to-white/20 flex items-center justify-center">
                <span class="text-3xl md:text-4xl font-bold text-white"><%= twin.publicHandle.charAt(0).toUpperCase() %></span>
            </div>
        <% } else if (!noTwin && userInfo && userInfo.handle) { %>
            <!-- Only show user initial here when we are NOT in the no‑twin state -->
            <div class="w-full h-full bg-gradient-to-br from-white/40 to-white/20 flex items-center justify-center">
                <span class="text-3xl md:text-4xl font-bold text-white"><%= userInfo.handle.charAt(0).toUpperCase() %></span>
            </div>
        <% } else { %>
            <!-- No twin + no explicit handle in header: neutral AI icon -->
            <div class="w-full h-full bg-gradient-to-br from-white/40 to-white/20 flex items-center justify-center">
                <span class="text-3xl md:text-4xl font-bold text-white">🤖</span>
            </div>
        <% } %>
    </div>

    <% if (twin && twin.verified) { %>
        <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full flex items-center justify-center border-4 border-white shadow-lg">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
        </div>
    <% } %>
</div>                        
                        
<!-- Profile Info - Enhanced -->
<div class="flex-1 text-center md:text-left">
    <div class="flex flex-col md:flex-row items-center md:items-center space-y-2 md:space-y-0 md:space-x-3 mb-4">
        <% if (!hasNoTwin && twin && twin.publicHandle) { %>
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white drop-shadow-lg">@<%= twin.publicHandle %></h1>
        <% } else if (userInfo && userInfo.handle) { %>
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white drop-shadow-lg">@<%= userInfo.handle %></h1>
        <% } else { %>
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white drop-shadow-lg">Profile</h1>
        <% } %>
    </div>
    
    <% if (typeof hasNoTwin !== 'undefined' && hasNoTwin && userInfo) { %>
        <!-- Clean no‑twin view: single profile card -->
        <div class="text-center py-10">
            <div class="max-w-md mx-auto bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-white/20 dark:border-gray-700 shadow-xl p-6">
              <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-r from-primary to-accent rounded-2xl flex items-center justify-center text-3xl text-white font-bold shadow-lg">
                <%= (userInfo.handle || 'U').charAt(0).toUpperCase() %>
              </div>

              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= userInfo.name || userInfo.handle %></h2>
              <% if (userInfo.bio) { %>
                <p class="text-gray-600 dark:text-gray-400 mb-4"><%= userInfo.bio %></p>
              <% } %>

              <p class="text-xs text-gray-500 dark:text-gray-400 mb-5">
                Joined: 
                <span class="timestamp-display" 
                      data-timestamp="<%= userInfo.createdAt %>" 
                      data-format="date"
                      data-fallback="<%= new Date(userInfo.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %>">
                    <%= new Date(userInfo.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %>
                </span>
            </p>              

              <% if (userInfo.isOwner) { %>
                <div class="text-left mb-5 p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700">
                  <p class="text-sm text-gray-800 dark:text-gray-200 font-medium mb-1">Your Public Twin is not created yet.</p>
                  <p class="text-sm text-gray-600 dark:text-gray-400">Create it to appear in Discover + let others chat with you.</p>
                </div>

                <a href="/twin/create" class="inline-flex items-center justify-center w-full px-5 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:shadow-lg transition-all font-semibold min-h-[44px]">
                  Create my Public Twin
                </a>
              <% } else { %>
                <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 text-sm text-gray-700 dark:text-gray-300">
                  This user hasn't created a public twin yet.
                </div>
              <% } %>
            </div>
        </div>
    <% } else if (twin) { %>
        <!-- ✅ Existing twin profile content -->
        <p class="text-base sm:text-lg md:text-xl opacity-90 mb-3 text-white/90">
            Created by 
            <% if (twin.userName) { %>
                <span class="font-semibold text-white">
                    <%= twin.userName || 'Unknown' %>
                </span>
            <% } %>
        </p>
        <% if (twin.bio) { %>
            <p class="text-lg opacity-90 max-w-2xl text-white/90 leading-relaxed line-clamp-3"><%= twin.bio %></p>                                
        <% } %>
    <% } %>
</div>     
                   
                    </div>
                </div>
            </div>

            <% const showTwinSections = !hasNoTwin && twin; %>

            <% if (showTwinSections) { %>
                <!-- Stats - Enhanced Cards -->
                <div class="px-6 py-6 bg-gradient-to-br from-gray-50 to-white dark:from-gray-800 dark:to-gray-900 border-b border-gray-200 dark:border-gray-700">
                    <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-4">
                        <div class="text-center p-3 sm:p-4 rounded-xl bg-gradient-to-br from-pink-50 to-rose-50 dark:from-pink-900/20 dark:to-rose-900/20 border border-pink-200 dark:border-pink-800 hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                            <div class="w-10 h-10 mx-auto mb-2 bg-gradient-to-br from-pink-500 to-rose-500 rounded-lg flex items-center justify-center shadow-lg">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                            <div class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= twin.likeCount || 0 %></div>
                            <div class="text-xs font-medium text-gray-600 dark:text-gray-400">Likes</div>
                        </div>                    
                        <div class="text-center p-3 sm:p-4 rounded-xl bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                            <div class="w-10 h-10 mx-auto mb-2 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-lg flex items-center justify-center shadow-lg">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                                </svg>
                            </div>
                            <div class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= twin.followCount || 0 %></div>
                            <div class="text-xs font-medium text-gray-600 dark:text-gray-400">Followers</div>
                        </div>                    
                        <div class="text-center p-3 sm:p-4 rounded-xl bg-gradient-to-br from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20 border border-purple-200 dark:border-purple-800 hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                            <div class="w-10 h-10 mx-auto mb-2 bg-gradient-to-br from-purple-500 to-violet-500 rounded-lg flex items-center justify-center shadow-lg">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                            <div class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-1"><%= twin.chatCount %></div>
                            <div class="text-xs font-medium text-gray-600 dark:text-gray-400">Chats</div>
                        </div>
                    </div>
                </div>            

                <!-- Sample Reply - Enhanced -->
                <% if (twin.sampleReply) { %>
                    <div class="px-8 py-8 bg-white dark:bg-gray-800">
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
                            <div class="w-8 h-8 bg-gradient-to-br from-primary to-accent rounded-lg flex items-center justify-center mr-3">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                            Sample Response
                        </h3>
                        <div class="bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-700 dark:to-gray-800 rounded-2xl p-6 border-2 border-gray-200 dark:border-gray-600 shadow-inner">
                            <p class="text-gray-700 dark:text-gray-200 italic text-lg leading-relaxed line-clamp-4" 
                            id="sampleReplyText"
                            data-full="<%= twin.sampleReply %>">"<%= twin.sampleReply %>"</p>
                         <% if (twin.sampleReply && twin.sampleReply.length > 300) { %>
                         <button id="expandSampleReply" 
                                 class="text-primary dark:text-blue-400 hover:underline text-sm mt-2">
                             Show full text
                         </button>
                         <% } %>                        
                        </div>
                    </div>
                <% } %>

                <!-- Action Buttons - Enhanced with Gradients -->
                <div class="px-8 py-8 bg-gradient-to-br from-gray-50 to-white dark:from-gray-800 dark:to-gray-900">
                    <div class="flex flex-col gap-3 md:gap-4 mb-6">
                        <!-- Row 1: Chat -->
                        <button id="chatNowBtn" class="w-full md:flex-1 bg-gradient-to-r from-primary via-indigo-600 to-accent text-white px-6 sm:px-8 py-3 sm:py-4 rounded-xl font-bold text-base sm:text-lg hover:shadow-2xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2 min-h-[48px] sm:min-h-[44px] touch-manipulation">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                            <span>Chat Now</span>
                        </button>
                        
                        <!-- Row 2: Like + Follow -->
                        <div class="flex flex-row flex-wrap gap-3">
                            <button id="likeBtn" class="flex-1 bg-gradient-to-r from-pink-500 to-rose-500 text-white px-4 py-3 rounded-xl font-bold text-base sm:text-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2 min-h-[48px] sm:min-h-[44px] touch-manipulation <%= (twin.likesDisabled || twin.isOwnTwin) ? 'opacity-50 cursor-not-allowed' : '' %>" 
                                <% if (twin.likesDisabled || twin.isOwnTwin) { %>
                                    disabled
                                    title="<%= twin.isOwnTwin ? 'You cannot like your own twin' : 'Liking is disabled for this twin' %>"
                                    data-disabled-reason="<%= twin.isOwnTwin ? 'own_twin' : 'likes_disabled' %>"
                                <% } %>
                            >
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                                </svg>
                                <span>Like</span>
                            </button>
                            <button id="followBtn" class="flex-1 bg-gradient-to-r from-blue-500 to-indigo-500 text-white px-4 py-3 rounded-xl font-bold text-base sm:text-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2 min-h-[48px] sm:min-h-[44px] touch-manipulation <%= (twin.followsDisabled || twin.isOwnTwin) ? 'opacity-50 cursor-not-allowed' : '' %>"
                                <% if (twin.followsDisabled || twin.isOwnTwin) { %>
                                    disabled
                                    title="<%= twin.isOwnTwin ? 'You cannot follow your own twin' : 'Following is disabled for this twin' %>"
                                    data-disabled-reason="<%= twin.isOwnTwin ? 'own_twin' : 'follows_disabled' %>"
                                <% } %>
                            >
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                                </svg>
                                <span>Follow</span>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Share Section - Enhanced -->
                    <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
                        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-primary" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"></path>
                            </svg>
                            Share this twin
                        </h4>
                        <div class="flex flex-wrap gap-2 sm:gap-3">
                            <div class="flex flex-wrap gap-2 sm:gap-3">
                                <!-- Twitter -->
                                <button
                                  data-share-platform="twitter"
                                  class="bg-gradient-to-r from-blue-400 to-blue-500 text-white
                                         w-10 h-10 text-xs
                                         sm:w-auto sm:h-11 sm:px-5 sm:py-2.5 sm:text-sm
                                         rounded-xl hover:shadow-lg transition-all duration-300 transform hover:scale-105
                                         font-medium flex items-center justify-center space-x-2 min-h-[44px] touch-manipulation
                                         <%= twin.sharesDisabled ? 'opacity-50 cursor-not-allowed' : '' %>"
                                  <% if (twin.sharesDisabled) { %>
                                      disabled
                                      title="Sharing is disabled for this twin"
                                      data-disabled-reason="shares_disabled"
                                  <% } %>
                                >
                                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path>
                                  </svg>
                                  <span class="hidden sm:inline">Twitter</span>
                                </button>
                        
                                <!-- Facebook -->
                                <button
                                  data-share-platform="facebook"
                                  class="bg-gradient-to-r from-blue-600 to-blue-700 text-white
                                         w-10 h-10 text-xs
                                         sm:w-auto sm:h-11 sm:px-5 sm:py-2.5 sm:text-sm
                                         rounded-xl hover:shadow-lg transition-all duration-300 transform hover:scale-105
                                         font-medium flex items-center justify-center space-x-2 min-h-[44px] touch-manipulation
                                         <%= twin.sharesDisabled ? 'opacity-50 cursor-not-allowed' : '' %>"
                                  <% if (twin.sharesDisabled) { %>
                                      disabled
                                      title="Sharing is disabled for this twin"
                                      data-disabled-reason="shares_disabled"
                                  <% } %>
                                >
                                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h1z"></path>
                                  </svg>
                                  <span class="hidden sm:inline">Facebook</span>
                                </button>
                        
                                <!-- WhatsApp -->
                                <button
                                  data-share-platform="whatsapp"
                                  class="bg-gradient-to-r from-green-500 to-green-600 text-white
                                         w-10 h-10 text-xs
                                         sm:w-auto sm:h-11 sm:px-5 sm:py-2.5 sm:text-sm
                                         rounded-xl hover:shadow-lg transition-all duration-300 transform hover:scale-105
                                         font-medium flex items-center justify-center space-x-2 min-h-[44px] touch-manipulation
                                         <%= twin.sharesDisabled ? 'opacity-50 cursor-not-allowed' : '' %>"
                                  <% if (twin.sharesDisabled) { %>
                                      disabled
                                      title="Sharing is disabled for this twin"
                                      data-disabled-reason="shares_disabled"
                                  <% } %>
                                >
                                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
