                    })
                });
            } catch (error) {
                console.error('Track share event error:', error);
            }
        }

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    // ✅ FIX: Use server-side initial state (already defined above)
    hasLiked = serverHasLiked === 'true';
    hasFollowed = serverHasFollowed === 'true';
    
    // Update button states immediately
    updateLikeButton(hasLiked);
    updateFollowButton(hasFollowed);
    
    // ✅ NEW: Check and disable buttons if needed (similar to discover.ejs)
    const likeBtn = document.getElementById('likeBtn');
    const followBtn = document.getElementById('followBtn');
    const shareButtons = document.querySelectorAll('[data-share-platform], [data-share-action="copy"]');
    
    // 1) Check if likes are disabled for this twin
    if (likesDisabled || isOwnTwin) {
        if (likeBtn) {
            likeBtn.disabled = true;
            likeBtn.classList.add('opacity-50', 'cursor-not-allowed');
            likeBtn.setAttribute('title', isOwnTwin ? 'You cannot like your own twin' : 'Liking is disabled for this twin');
            likeBtn.setAttribute('aria-label', `Liking disabled for @${twinPublicHandle}`);
            likeBtn.setAttribute('data-disabled-reason', isOwnTwin ? 'own_twin' : 'likes_disabled');
        }
    } else {
        if (likeBtn) {
            likeBtn.disabled = false;
            likeBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            likeBtn.removeAttribute('data-disabled-reason');
        }
    }
    
    // 2) Check if follows are disabled for this twin
    if (followsDisabled || isOwnTwin) {
        if (followBtn) {
            followBtn.disabled = true;
            followBtn.classList.add('opacity-50', 'cursor-not-allowed');
            followBtn.setAttribute('title', isOwnTwin ? 'You cannot follow your own twin' : 'Following is disabled for this twin');
            followBtn.setAttribute('aria-label', `Following disabled for @${twinPublicHandle}`);
            followBtn.setAttribute('data-disabled-reason', isOwnTwin ? 'own_twin' : 'follows_disabled');
        }
    } else {
        if (followBtn) {
            followBtn.disabled = false;
            followBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            followBtn.removeAttribute('data-disabled-reason');
        }
    }
    
    // 3) Check if shares are disabled for this twin (removed isOwnTwin check)
    if (sharesDisabled) {
        shareButtons.forEach(shareBtn => {
            shareBtn.disabled = true;
            shareBtn.classList.add('opacity-50', 'cursor-not-allowed');
            shareBtn.setAttribute('title', 'Sharing is disabled for this twin');
            shareBtn.setAttribute('data-disabled-reason', 'shares_disabled');
        });
    } else {
        shareButtons.forEach(shareBtn => {
            shareBtn.disabled = false;
            shareBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            shareBtn.removeAttribute('data-disabled-reason');
        });
    }
    
    // ✅ OPTIONAL: Verify with API call (for consistency, but not blocking)
    // This ensures state is correct even if there's a race condition
    checkInitialStatus().catch(err => {
        console.warn('Initial status check failed, using server-side state:', err);
    });
    
    // ✅ FIX: Like and Follow buttons functionality (exactly like discover.ejs)
    if (likeBtn) {
        likeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            // ✅ Check if button is disabled BEFORE making request
            if (likeBtn.disabled || likeBtn.classList.contains('cursor-not-allowed')) {
                const disabledReason = likeBtn.getAttribute('data-disabled-reason');
                const message = disabledReason === 'own_twin' 
                    ? 'You cannot like your own twin' 
                    : 'Liking is disabled for this twin';
                showNotification(message, 'info');
                return;
            }
            toggleLike(currentTwinId, likeBtn);
        });
    }
    
    if (followBtn) {
        followBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            // ✅ Check if button is disabled BEFORE making request
            if (followBtn.disabled || followBtn.classList.contains('cursor-not-allowed')) {
                const disabledReason = followBtn.getAttribute('data-disabled-reason');
                const message = disabledReason === 'own_twin' 
                    ? 'You cannot follow your own twin' 
                    : 'Following is disabled for this twin';
                showNotification(message, 'info');
                return;
            }
            toggleFollow(currentTwinId, followBtn);
        });
    }
    
    // Share button event listeners
    document.querySelectorAll('[data-share-platform]').forEach(button => {
        button.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            // ✅ Check if button is disabled BEFORE making request
            if (this.disabled || this.classList.contains('cursor-not-allowed')) {
                const disabledReason = this.getAttribute('data-disabled-reason');
                const message = disabledReason === 'own_twin' 
                    ? 'You cannot share your own twin' 
                    : 'Sharing is disabled for this twin';
                showNotification(message, 'info');
                return;
            }
            const platform = this.getAttribute('data-share-platform');
            shareTwin(platform);
        });
    });
    
    // Copy link button event listener
    const copyBtn = document.querySelector('[data-share-action="copy"]');
    if (copyBtn) {
        copyBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            // ✅ Check if button is disabled BEFORE making request
            if (this.disabled || this.classList.contains('cursor-not-allowed')) {
                const disabledReason = this.getAttribute('data-disabled-reason');
                const message = disabledReason === 'own_twin' 
                    ? 'You cannot share your own twin' 
                    : 'Sharing is disabled for this twin';
                showNotification(message, 'info');
                return;
            }
            copyShareLink();
        });
    }
        // Expand/collapse sample reply functionality
        const expandBtn = document.getElementById('expandSampleReply');
    const sampleText = document.getElementById('sampleReplyText');
    if (expandBtn && sampleText) {
        expandBtn.addEventListener('click', () => {
            if (sampleText.classList.contains('line-clamp-4')) {
                sampleText.classList.remove('line-clamp-4');
                expandBtn.textContent = 'Show less';
            } else {
                sampleText.classList.add('line-clamp-4');
                expandBtn.textContent = 'Show full text';
            }
        });
    }
});
</script>
