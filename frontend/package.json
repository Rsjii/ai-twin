{
  "name": "ai-twin-frontend",
  "version": "1.0.0",
  "description": "AI Twin Frontend Views & Static Assets",
  "scripts": {
    "dev": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/output.css --watch",
    "build": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/output.css --minify",
    "build:dev": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/output.css",
    "clean:css": "rm -f ./src/public/css/output.css",
    "lint": "echo 'Frontend linting'",
    "test": "echo 'Frontend testing'"
  },
  "dependencies": {
    "ejs": "^3.1.9"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.4",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  },
  "keywords": [
    "frontend",
    "views",
    "ejs",
    "static"
  ],
  "author": "AI Twin Team",
  "license": "MIT"
}
